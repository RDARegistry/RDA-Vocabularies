                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50636", "lexicalAlias":"http://rdaregistry.info/Elements/a/modifierPersonOf.en", "label":"is modifier person of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/annotatorOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50128", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/annotatorOf.en", "label":"is annotator of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50128", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/annotatorOf.en", "label":"is annotator of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50425","label":{"ar":"له اختصاص قضائي","ca":"té com a lloc regit","cs":"má ovládané místo","da":"har jurisdiktion underlagt","de":"hat geregelte Gebietskörperschaft","de":"hat durch Verfahrensvorschriften geregeltes Gericht","el":"έχει δικαιοδοσία κυβερνούμενη","en":"has place governed","es":"tiene lugar regido","et":"valitsetav võimkond","fi":"julkishallinnollisen yhteisön hallintoalue","fr":"a pour lieu régi","hu":"joghatósága a következő:","it":"ha come giurisdizione governata","lv":"pārvaldāmā jurisdikcija","nl":"heeft geregeerde plaats","no":"har jurisdiksjon som styres","tr":"yönetilen yargı alanı ile ilişkilidir","zh-Hans-CN":"有所管辖的地点"},"definition":{"ar":["يربط هيئة بمكان يخضع لسلطة قضائية يحكمها قانون أو لائحة تنظيمية، إلخ، سنتها حكومة أخرى."],"ca":["Relaciona una entitat corporativa amb un lloc que és regit per una entitat corporativa que és un govern."],"cs":["Vztahuje korporaci k místu, které je ovládáno korporací, která je vládou."],"da":["Relaterer en korporation til et sted, som er en jurisdiktion, som er underlagt en lov, forordning, etc., som blev vedtaget af en anden myndighed."],"de":["Setzt eine Körperschaft in Beziehung zu einem Geografikum, das durch ein Gesetz, eine Verordnung und so weiter geregelt wird, das/die von einer anderen Regierung erlassen wurde.,Setzt eine Körperschaft in Beziehung zu einem Geografikum, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt, das/die von einer Regierung erlassen wird."],"en":["Relates a corporate body to a place that is governed by a corporate body who is a government."],"es":["Relaciona un organismo corporativo con un lugar que es regido por un organismo corporativo que es un gobierno."],"et":["Seostab asutuse kohaga, mis on teise valitsuse kehtestatud seaduste, määruste vms alusel valitsetav võimkond."],"fi":["Liittää yhteisön hallintoalueeseen, joka on julkishallinnollisen yhteisön hallinnoima."],"fr":["Met une collectivité en relation avec un lieu qui est régi par une collectivité constituant un gouvernement."],"hu":["Hozzákapcsol egy testületet egy helyhez, amely egy másik igazgatási szerv által hozott törvény, rendelet stb. hatálya alá tartozó joghatóság."],"it":["Correla un ente a un luogo che è una giurisdizione governata da una legge, normativa, etc., che è stata adottata da un altro governo."],"lv":["Sasaista institūciju ar vietu, kuru pārvalda institūcija, balstoties likumos, noteikumos u.tml., kurus pieņēmusi cita jurisdikcija."],"nl":["Relateert een corporatie aan een plaats die is geregeerd door een corporatie die een regering is."],"no":["Relaterer en korporasjon til et sted som er en jurisdiksjon som styres ved lov, vedtekt, etc., som ble vedtatt av en annen myndighet."],"tr":["Bir tüzel kişiyi, başka bir hükümet tarafından yürürlüğe girmiş kanun, düzenleme vb. vasıtasıyla yargı yetkisi olan bir yer ile ilişkilendirir."],"zh-Hans-CN":["将一个团体与被作为一个政府的一个团体所管辖的一个地点关联起来。"]},"ToolkitLabel":{"ar":"اختصاص قضائي","ca":"lloc regit","cs":"ovládané místo","da":"jurisdiktion underlagt","de":"Geregelte Gebietskörperschaft","de":"durch Verfahrensvorschriften geregeltes Gericht","el":"δικαιοδοσία κυβερνούμενη","en":"place governed","es":"jurisdicción regulada","et":"valitsetav võimkond","fi":"julkishallinnollisen yhteisön hallintoalue","fr":"lieu régi","hu":"joghatóság:","it":"giurisdizione governata","lv":"pārvaldāmā jurisdikcija","nl":"geregeerde plaats","no":"jurisdiksjon som styres","tr":"Yargı yetkisi","zh-Hans-CN":"所管辖的地点"},"ToolkitDefinition":{"ar":"مكان يخضع لسلطة قضائية يحكمها قانون أو لائحة تنظيمية، إلخ، سنتها حكومة أخرى.","ca":"Un lloc que és regit per una entitat corporativa que és un govern.","cs":"Místo, které je ovládáno korporací, která je vládou.","da":"Sted, som er en jurisdiktion, som er underlagt en lov, forordning, etc., som blev vedtaget af en anden myndighed.","de":"Ein Geografikum, das durch ein Gesetz, eine Verordnung und so weiter geregelt wird, das/die von einer anderen Regierung erlassen wurde.","de":"Ein Geografikum, das durch Gesetze, Verordnungen, Verfassungen, Gerichtsvorschriften oder andere Gesetze geregelt ist, die von einer Körperschaft mit Regierungsbefugnis erlassen werden.","en":"A place that is governed by a corporate body who is a government.","es":"Un lugar que es una jurisdicción regida por una ley, reglamento, etc., que fue promulgada por otro gobierno.","et":"Koht, mis on teise valitsuse kehtestatud seaduste, määruste vms alusel valitsetav võimkond.","fi":"Hallintoalue, joka on julkishallinnollisen yhteisön hallinnoima.","fr":"Lieu qui est régi par une collectivité constituant un gouvernement.","hu":"Egy hely, amely egy másik igazgatási szerv által hozott törvény, rendelet stb. hatálya alá tartozó joghatóság.","it":"Luogo che è una giurisdizione governata da una legge, normativa, etc., promulgata da un altro governo.","lv":"Teritorija, kuru pārvalda institūcija, balstoties likumos, noteikumos u.tml., kurus pieņēmusi cita jurisdikcija.","nl":"Een plaats die is geregeerd door een corporatie die een regering is.","no":"Et sted som er en jurisdiksjon som styres ved lov, vedtekt, etc., som ble vedtatt av en annen myndighet.","tr":"Başka bir hükümet tarafından yürürlüğe girmiş kanun, düzenleme vb. vasıtasıyla yargı alanı olan bir yer.","zh-Hans-CN":"被作为一个政府的一个团体所管辖的一个地点"},"altLabel":{"ca":["jurisdicció regida"],"cs":["jurisdikce spadající pod vládu"],"de":["Geregelte Gebietskörperschaft"],"en":["jurisdiction governed"],"es":["jurisdicción regida"],"fi":["soveltava lainkäyttöalue"],"fr":["juridiction régie"],"nl":["geregeerde jurisdictie"],"tr":["yargı yetkisi"],"zh-Hans-CN":["所管辖的辖区"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
