                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"lexicalAlias":"http://rdaregistry.info/Elements/a/officer.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50334", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPersonOfCorporateBody.en", "label":"has related person of corporate body"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50285", "lexicalAlias":"http://rdaregistry.info/Elements/a/trustee.en", "label":"has trustee"},{"@id":"http://rdaregistry.info/Elements/a/P50284", "lexicalAlias":"http://rdaregistry.info/Elements/a/chiefExecutive.en", "label":"has chief executive"},{"@id":"http://rdaregistry.info/Elements/a/object/P50027", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/officer.en", "label":"has officer"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50027", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/officer.en", "label":"has officer"}]},{"@id":"http://rdaregistry.info/Elements/a/P50234","label":{"ar":"هو مسؤول عن","ca":"és directiu de","cs":"je vedoucím pracovníkem (čeho)","da":"er embedsmand i","de":"ist leitende Angestellte/leitender Angestellter von","de":"ist leitende Angestellte/leitender Angestellter von","el":"είναι υπάλληλος του","en":"is officer of","es":"es funcionario","et":"ametnik asutuses","fi":"toimihenkilönä yhteisössä","fr":"est un dirigeant de","hu":"tisztviselője a következőnek:","it":"è funzionario di","lv":"ir amatpersona","nl":"is functionaris van","no":"er leder for","tr":"kurumsal yetkilisidir","zh-Hans-CN":"是……的任职者"},"definition":{"ar":["يربط شخصا بهيئة يشغل شخص منصبا فيها ."],"ca":["Relaciona una persona amb una entitat corporativa en la qual una persona té un càrrec."],"cs":["Vztahuje osobu ke korporaci, ve které osoba zastává pozici (úřad)."],"da":["Relaterer en person til en korporation, hvor en person har et embede."],"de":["Setzt eine Person in Beziehung zu einer Körperschaft, in der eine Person ein Amt innehat.,Setzt eine Person in Beziehung zu einer Körperschaft, in der eine Person ein Amt innehat."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα συλλογικό όργανο, του οποίου ηγείται ή στο οποίο το φυσικό πρόσωπο κατέχει μια θέση."],"en":["Relates a person to a corporate body in which a person holds an office."],"es":["Relaciona una persona con un organismo corporativo en el que una persona ocupa un cargo."],"et":["Seostab isiku asutusega, kus isik peab ametit."],"fi":["Liittää henkilön yhteisöön, jota henkilö johtaa tai jossa hän on viranhaltijana."],"fr":["Met une personne en relation avec une collectivité au sein de laquelle une personne exerce une fonction de responsabilité."],"hu":["Hozzákapcsol egy személyt egy testülethez, amelyben egy személy hivatalt visel."],"it":["Correla una persona a un ente in cui una persona ha una carica."],"lv":["Sasaista personu ar institūciju, kur persona ieņem amatu."],"nl":["Relateert een persoon aan een corporatie waar een persoon een functie beoefent."],"no":["Relaterer en person til en korporasjon der en person har en ledende stilling."],"tr":["bir kişiyi, bir yer tutan kişiyi tüzel kişilikle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个个人在其中任职的一个团体关联起来。"]},"ToolkitLabel":{"ar":"مسؤول عن","ca":"directiu de","cs":"vedoucí pracovník (čeho)","da":"embedsmand i","de":"Leitende Angestellte/Leitender Angestellter von","de":"Leitende Angestellte/Leitender Angestellter von","el":"υπάλληλος του","en":"officer of","es":"funcionario de","et":"ametnik asutuses","fi":"toimihenkilönä yhteisössä","fr":"dirigeant de","hu":"tisztviselője:","it":"funzionario di","lv":"ir amatpersona","nl":"functionaris van","no":"leder for","tr":"görevli","zh-Hans-CN":"……的任职者"},"ToolkitDefinition":{"ar":"يربط شخصا بهيئة يشغل شخص منصبا فيها.","ca":"Entitat corporativa en la qual una persona té un càrrec.","cs":"Korporace, ve které osoba zastává pozici (úřad).","da":"Korporation, hvor en person har et embede.","de":"Eine Körperschaft, in der eine Person ein Amt innehat.","de":"Eine Körperschaft, in der eine Person ein Amt innehat.","el":"Ένα συλλογικό όργανο του οποίου ηγείται ή στο οποίο το φυσικό πρόσωπο κατέχει μια θέση.","en":"A corporate body in which a person holds an office.","es":"Un organismo corporativo en el que una persona ocupa un cargo.","et":"Asutus, kus isik peab ametit.","fi":"Yhteisö, jota henkilö johtaa tai jossa hän on viranhaltijana.","fr":"Collectivité au sein de laquelle une personne exerce une fonction de responsabilité.","hu":"Egy testület, amelyben egy személy hivatalt visel.","it":"Ente in cui una persona ha una carica.","lv":"Institūcija, kur persona ieņem amatu.","nl":"Een corporatie waar een persoon een functie beoefent.","no":"En korporasjon der en person har en ledende stilling.","tr":"Ofisi bulunan tüzel kişi","zh-Hans-CN":"一个个人在其中任职的一个团体"},"altLabel":{"fi":["virkamiehenä yhteisössä"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/officerOf.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50318", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfPerson.en", "label":"has related corporate body of person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50287", "lexicalAlias":"http://rdaregistry.info/Elements/a/trusteeOf.en", "label":"is trustee of"},{"@id":"http://rdaregistry.info/Elements/a/P50286", "lexicalAlias":"http://rdaregistry.info/Elements/a/chiefExecutiveOf.en", "label":"is chief executive of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50234", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/officerOf.en", "label":"is officer of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50234", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/officerOf.en", "label":"is officer of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50068","label":{"ar":"هي ولاية قضائية مشرِّعة لـ","ca":"és govern promulgador de","cs":"je vládou vydávající vládní nařízení (čeho)","da":"er udøvende jurisdiktion af","de":"ist normerlassende Gebietskörperschaft von","de":"ist normerlassende Gebietskörperschaft von","el":"είναι θεσπισμένη δικαιοδοσία του","en":"is enacting government of","es":"es gobierno promulgante de","et":"kehtestav võimkond teoses","fi":"säätävän hallintoelimen päätös","fr":"est un gouvernement promulgateur de","hu":"rendelkező joghatósága a következőnek:","it":"è la giurisdizione emanante di","lv":"ir ieviesējjurisdikcija","nl":"is vaststellende regering van","no":"er vedtakende jurisdiksjon for","tr":"yasa çıkaran hükümetidir","zh-Hans-CN":"是……的颁布政府"},"definition":{"ar":["يربط هيئة بعمل هو قانون، أو لائحة، أو دستور، أو حكم محكمة، أو أي تشريع آخر تسنه هيئة هي الحكومة."],"ca":["Relaciona una entitat corporativa amb una obra que és una llei, un reglament, una constitució, una regla de funcionament d’un tribunal o qualsevol altra legislació promulgada per una entitat corporativa que és un govern."],"cs":["Vztahuje korporaci k dílu, které je zákonem, nařízením, ústavou, soudním předpisem nebo jinou legislativou uzákoněnou korporací, která je vládou."],"da":["Relaterer en korporation til et værk, som er en lov, forordning, forfatning, retsplejeregel eller anden lovgivning vedtaget af en korporation, som er en myndighed."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt, das/die von einer Regierung erlassen wird.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt, das/die von einer Regierung erlassen wird."],"el":["Συνδέει μια δικαιοδοσία, που θεσπίζει έναν νόμο, κανονισμό, σύνταγμα, κανόνα δικαστηρίου κ.λπ., με ένα έργο."],"en":["Relates a corporate body to a work that is a law, regulation, constitution, court rule, or other legislation enacted by a corporate body who is a government."],"es":["Relaciona un organismo corporativo con una obra que es una ley, regulación, constitución, regla judicial y otra legislación promulgada por un organismo corporativo que es un gobierno."],"et":["Seostab asutuse teosega, mis on seadus, määrus, konstitutsioon, menetluseeskiri või muu õigusakt, mille asutus valitsusena on kehtestanud."],"fi":["Liittää yhteisön lainsäädännölliseen teokseen, kuten lakiin, asetukseen, perustuslakiin, tuomioistuinta koskevaan sääntöön tms., jonka julkishallinnollinen yhteisö on säätänyt."],"fr":["Met une collectivité en relation avec une œuvre qui consiste en une loi, un règlement, une constitution, une règle de pratique de tribunal ou une autre mesure législative promulguée par une collectivité qui constitue un gouvernement."],"hu":["Hozzákapcsol egy testületet egy műhöz, amely egy kormányzati testület által beiktatott törvény, rendelet, alkotmány, bírósági határozat, vagy egyéb jogszabály."],"it":["Correla un organo a un'opera che è una legge, regolamento, costituzione, norme di un tribunale emanata da un organo che è un governo."],"lv":["Sasaista institūciju ar darbu, kas ir likums, noteikumi, konstitūcija, tiesas nolēmumi vai citi tiesību akti, ko ieviesusi institūcija, kas ir valsts pārvaldes iestāde."],"nl":["Relateert een corporatie aan een werk dat is een wet, regeling, grondwet, rechterlijke uitspraak, of andere regelgeving aangenomen door een corporatie die een regering is."],"no":["Relaterer en korporasjon til et verk som er en lov, vedtekt, grunnlov, rettergangsregel etc. eller annen lovgivning som vedtas av en korporasjon som er en regjeringsmakt."],"tr":["Bir tüzel kişiyi, bir devlet organı tarafından çıkarılan kanun, yönetmelik, anayasa, mahkeme kuralı veya yürürlüğe konulan diğer mevzuat niteliğindeki bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与作为政府的一个团体颁布的法律、法规、宪法、法院规则或其他立法的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هي ولاية قضائية مشرِّعة","ca":"govern promulgador de","cs":"vláda vydávající vládní nařízení (čeho)","da":"udøvende jurisdiktion af","de":"Normerlassende Gebietskörperschaft von","de":"Normerlassende Gebietskörperschaft von","el":"θεσπισμένη δικαιοδοσία του","en":"enacting government of","es":"gobierno promulgante de","et":"kehtestav võimkond teoses","fi":"säätävän hallintoelimen päätös","fr":"gouvernement promulgateur de","hu":"rendelkező joghatósága:","it":"giurisdizione emanante di","lv":"ir ieviesējjurisdikcija","nl":"vaststellende regering van","no":"vedtakende jurisdiksjon for","tr":"yargı yetkisini yürürlüğe koyma","zh-Hans-CN":"……的颁布政府"},"ToolkitDefinition":{"ar":"عمل هو قانون، أو لائحة، أو دستور، أو حكم محكمة، أو أي تشريع آخر تسنه هيئة هي الحكومة.","ca":"Obra que és una llei, un reglament, una constitució, una regla de funcionament d’un tribunal o qualsevol altra legislació promulgada per una entitat corporativa que és un govern.","cs":"Dílo, které je zákonem, nařízením, ústavou, soudním předpisem nebo jinou legislativou uzákoněnou korporací, která je vládou.","da":"Værk, som er en lov, forordning, forfatning, retsplejeregel eller anden lovgivning vedtaget af en korporation, som er en myndighed.","de":"Ein Werk, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt, das/die von einer Regierung erlassen wird.","de":"Ein Werk, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt, das/die von einer Regierung erlassen wird.","el":"Ένα έργο που θεσπίζει έναν νόμο, κανονισμό, σύνταγμα, κανονισμό δικαστηρίου κ.λπ.","en":"A work that is a law, regulation, constitution, court rule, or other legislation enacted by a corporate body who is a government.","es":"Una obra que es una ley, regulación, constitución, regla judicial y otra legislación promulgada por un organismo corporativo que es un gobierno.","et":"Teos, mis on seadus, määrus, konstitutsioon, menetluseeskiri või muu õigusakt, mille asutus valitsusena on kehtestanud.","fi":"Lainsäädännöllinen teos kuten laki, asetus, perustuslaki, tuomioistuinta koskeva sääntö tms., jonka julkishallinnollinen yhteisö on säätänyt.","fr":"Œuvre qui consiste en une loi, un règlement, une constitution, une règle de pratique de tribunal ou une autre mesure législative promulguée par une collectivité qui constitue un gouvernement.","hu":"Egy mű, amely egy kormányzati testület által beiktatott törvény, rendelet, alkotmány, bírósági határozat, vagy egyéb jogszabály.","it":"Opera che è una legge, regolamento, costituzione, norma di un tribunale emanata da un organo che è un governo.","lv":"Darbs, kas ir likums, noteikumi, konstitūcija, tiesas nolēmumi vai citi tiesību akti, ko ieviesusi institūcija, kas ir valsts pārvaldes iestāde.","nl":"Een werk dat is een wet, regeling, grondwet, rechterlijke uitspraak, of andere regelgeving aangenomen door een corporatie die een regering is.","no":"Et verk som er en lov, vedtekt, grunnlov, rettergangsregel etc. eller annen lovgivning som vedtas av en korporasjon som er en regjeringsmakt.","tr":"Bir yönetim olan tüzel bir kişi tarafından yürürlüğe konulan yasa, yönetmelik, anayasa, mahkeme kuralı veya diğer mevzuat niteliğindeki bir çalışma.","zh-Hans-CN":"作为政府的一个团体颁布的法律、法规、宪法、法院规则或其他立法的一种作品"},"altLabel":{"ar":["هيئة سن تشريعات"],"fr":["juridiction promulgatrice de,gouvernement édicteur de"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50844", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfWorkOf.en", "label":"is creator corporate body of work of"}],"instructionNumber":"18.5","lexicalAlias":"http://rdaregistry.info/Elements/a/enactingGovernmentOf.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50068", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/enactingGovernmentOf.en", "label":"is enacting government of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50068", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/enactingGovernmentOf.en", "label":"is enacting government of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50142","label":{"ar":"هو وكيل ناسخ لـ","ca":"és agent transcriptor de","cs":"je přepisovatelem (agentem) (čeho)","da":"er agent, som er transskribent af","de":"ist Akteur als Transkribiererin/Transkribierer von","de":"ist Akteur als Transkribiererin/Transkribierer von","el":"είναι μεταγραφέας φορέας του","en":"is transcriber agent of","es":"es agente transcriptor de","et":"transkribeerija (tegija) väljenduses","fi":"transkriboija (toimija) ekspressiossa","fr":"est un agent transcripteur de","hu":"átíró ágense a következőnek:","it":"è trascrittore agente di","lv":"ir transkribētājs (aģents)","nl":"is transcribeerder-actor van","no":"er avskriver for (agent)","tr":"Yazıya aktaran temsilcisidir.","zh-Hans-CN":"是……的转写者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في كتابة أو في تدوين محتوى لم تسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσα από τη δημιουργία σχολίων/σημειώσεων για περιεχόμενο μη σχολιασμένο προηγούμενα ή μέσω της αλλαγής συστήματος σημειογραφίας, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller i form av omskrivning fra ett system til et annet."],"tr":["Bir temsilciyi, daha önce yazılmamış veya belirtilmemiş içeriği yazan veya not eden veya bir gösterim sisteminden diğerine değiştiren temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个行为者的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل ناسخ","ca":"agent transcriptor de","cs":"přepisovatel (agent) (čeho)","da":"agent, som er transskribent af","de":"Akteur als Transkribiererin/Transkribierer von","de":"Akteur als Transkribiererin/Transkribierer von","el":"μεταγραφέας φορέας του","en":"transcriber agent of","es":"agente transcriptor de","et":"transkribeerija (tegija) väljenduses","fi":"transkriboija (toimija) ekspressiossa","fr":"agent transcripteur de","hu":"átíró ágense:","it":"trascrittore agente di","lv":"ir transkribētājs (aģents)","nl":"transcribeerder-actor van","no":"avskriver for (agent)","tr":"yazıya aktaran temsilci","zh-Hans-CN":"……的转写者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في كتابة أو تدوين محتوى لم تسبق كتابته أو تدوينه أو في تغييره من نظام تدوين إلى آخر.","ca":"Expressió que inclou una contribució d’un agent escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Udtryk, som omfatter en agents bidrag ved at nedskrive eller notere tidligere uskrevet eller ikke noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά της δημιουργίας σχολίων/σημειώσεων για περιεχόμενο μη σχολιασμένο προηγούμενα ή [που ενσωματώνει τη συνεισφορά της δημιουργίας] μέσω της αλλαγής σημειογραφίας από ένα σύστημα σε ένα άλλο.","en":"An expression that includes a contribution by an agent of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Una expresión que incluye una contribución de un agente de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro.","et":"Väljendus, millesse tegija on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében.","it":"Espressione che include un contributo da parte di un agente nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een expressie die omvat een bijdrage door een actor door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller i form av omskrivning fra ett system til et annet.","tr":"Daha önce yazılmamış veya not edilmemiş içeriği not eden ya da bir notasyon sisteminden diğerine değiştiren bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个行为者的贡献的内容表达"},"altLabel":{"ar":["ناسخ لـ"],"ca":["transcriptor de"],"cs":["přepisovatel (čeho)"],"da":["transskribent af"],"de":["Transkribierer von,Transkribierer von"],"el":["μεταγραφέας του"],"en":["transcriber of"],"es":["transcriptor de"],"et":["transkribeerija väljenduses"],"fi":["transkriboitu nuotinnos"],"fr":["transcripteur de"],"hu":["átírója:"],"it":["trascrittore di"],"nl":["transcribeerder van"],"no":["avskriver for"],"tr":["yazıya aktaran"],"zh-Hans-CN":["……的转写者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50447", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserAgentOf.en", "label":"is reviser agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberAgentOf.en","See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50137", "lexicalAlias":"http://rdaregistry.info/Elements/a/arrangerAgentOfMusicOf.en", "label":"is arranger agent of music of"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50773", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberCollectiveAgentOf.en", "label":"is transcriber collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50622", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberPersonOf.en", "label":"is transcriber person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50142", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/transcriberAgentOf.en", "label":"is transcriber agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50142", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/transcriberAgentOf.en", "label":"is transcriber agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50773","label":{"ar":"هو وكيل جماعي ناسخ لـ","ca":"és agent col·lectiu transcriptor de","cs":"je přepisovatelem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er transskribent af","de":"ist gemeinschaftlicher Akteur als Transkribiererin/Transkribierer von","de":"ist gemeinschaftlicher Akteur als Transkribiererin/Transkribierer von","el":"είναι μεταγραφέας συλλογικός φορέας του","en":"is transcriber collective agent of","es":"es agente colectivo transcriptor de","et":"transkribeerija (kollektiiv) väljenduses","fi":"transkriboija (yhteistoimija) ekspressiossa","fr":"est un agent collectif transcripteur de","hu":"átíró kollektív ágense a következőnek:","it":"è trascrittore agente collettivo di","lv":"ir transkribētājs (grupa)","nl":"is transcribeerder-collectieve actor van","no":"er avskriver for (kollektiv agent)","tr":"çözümleyici kolektif temsilcisi","zh-Hans-CN":"是……的转写者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في كتابة أو تدوين محتوى لم يسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää yhteistoimijan ekspressioon, jonka tekemisessä yhteistoimija on osallisena kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo da parte di un agente collettivo nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller ved å endre det fra ett notasjonssystem til et annet."],"tr":["Kolektif bir temsilciyi, daha önce yazılmamış veya not edilmemiş içeriği not etmekle ya da bir notasyon sisteminden diğerine değiştirmekle görevli bir kolektif temsilcinin katkısını içeren bir anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个集体行为者的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي ناسخ لـ","ca":"agent col·lectiu transcriptor de","cs":"přepisovatel (kolektivní agent) (čeho)","da":"kollektiv agent, som er transskribent af","de":"Gemeinschaftlicher Akteur als Transkribiererin/Transkribierer von","de":"Gemeinschaftlicher Akteur als Transkribiererin/Transkribierer von","el":"μεταγραφέας συλλογικός φορέας του","en":"transcriber collective agent of","es":"agente colectivo transcriptor de","et":"transkribeerija (kollektiiv) väljenduses","fi":"transkriboija (yhteistoimija) ekspressiossa","fr":"agent collectif transcripteur de","hu":"átíró kollektív ágense:","it":"trascrittore agente collettivo di","lv":"ir transkribētājs (grupa)","nl":"transcribeerder-collectieve actor van","no":"avskriver for (kollektiv agent)","tr":"yazıya aktaran kolektif temsilci","zh-Hans-CN":"……的转写者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في كتابة أو تدوين محتوى لم يسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر.","ca":"Expressió que inclou una contribució d’un agent col·lectiu escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","en":"An expression that includes a contribution by a collective agent of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Una expresión que incluye una contribución de un agente colectivo de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro.","et":"Väljendus, millesse kollektiiv on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Ekspressio, jonka tekemisessä yhteistoimija on osallisena kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében.","it":"Espressione che comprende un contributo da parte di un agente collettivo nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro.","lv":"Izteiksme, kas ietver grupas ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller ved å endre det fra ett notasjonssystem til et annet.","tr":"Daha önce yazılmamış veya not edilmemiş içeriği not eden ya da bir notasyon sisteminden diğerine değiştiren kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个集体行为者的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50744", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en", "label":"is reviser collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50142", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberAgentOf.en", "label":"is transcriber agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50924", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberCorporateBodyOf.en", "label":"is transcriber corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51075", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberFamilyOf.en", "label":"is transcriber family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50773", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/transcriberCollectiveAgentOf.en", "label":"is transcriber collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50773", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/transcriberCollectiveAgentOf.en", "label":"is transcriber collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50924","label":{"ar":"هي هيئة ناسخة لـ","ca":"és entitat corporativa transcriptora de","cs":"je přepisovatelem (korporací) (čeho)","da":"er korporation, som er transskribent af","de":"ist Körperschaft als Transkribiererin/Transkribierer von","de":"ist Körperschaft als Transkribiererin/Transkribierer von","el":"είναι μεταγραφέας συλλογικό όργανο του","en":"is transcriber corporate body of","es":"es organismo corporativo transcriptor de","et":"transkribeerija (asutus) väljenduses","fi":"transkriboija (yhteisö) ekspressiossa","fr":"est une collectivité transcriptrice de","hu":"átíró testülete a következőnek:","it":"è trascrittore ente di","lv":"ir transkribētājs (institūcija)","nl":"is transcribeerder-corporatie van","no":"er avskriver for (korporasjon)","tr":"Yazıya aktaran tüzel kişi","zh-Hans-CN":"是……的转写者团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة في كتابة أو تدوين محتوى لم تسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää yhteisön ekspressioon, jonka tekemisessä yhteisö on osallisena kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller ved å endre det fra ett notasjonssystem til et annet."],"tr":["Bir tüzel kişiyi, daha önce yazılmamış veya not edilmemiş içeriğin yazılması veya not edilmesi veya bir notasyon sisteminden diğerine değiştirilmesi yoluyla bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个团体的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة ناسخة","ca":"entitat corporativa transcriptora de","cs":"přepisovatel (korporace) (čeho)","da":"korporation, som er transskribent af","de":"Körperschaft als Transkribiererin/Transkribierer von","de":"Körperschaft als Transkribiererin/Transkribierer von","el":"μεταγραφέας συλλογικό όργανο του","en":"transcriber corporate body of","es":"organismo corporativo transcriptor de","et":"transkribeerija (asutus) väljenduses","fi":"transkriboija (yhteisö) ekspressiossa","fr":"collectivité transcriptrice de","hu":"átíró testülete:","it":"trascrittore ente di","lv":"ir transkribētājs (institūcija)","nl":"transcribeerder-corporatie van","no":"avskriver for (korporasjon)","tr":"yazıya aktaran tüzel kişi","zh-Hans-CN":"……的转写者团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة في كتابة أو تدوين محتوى لم تسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر.","ca":"Expressió que inclou una contribució d’una entitat corporativa escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Vyjádření, které zahrnuje přispění korporace tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Udtryk, som omfatter en korporations bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","en":"An expression that includes a contribution by a corporate body of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Una expresión que incluye una contribución de un organismo corporativo de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro.","et":"Väljendus, millesse asutus on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Ekspressio, jonka tekemisessä yhteisö on osallisena kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében.","it":"Espressione che comprende un contributo di un ente nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een expressie die omvat een bijdrage door een corporatie door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller ved å endre det fra ett notasjonssystem til et annet.","tr":"Daha önce yazılmamış veya not edilmemiş içeriğin yazılması veya not edilmesi veya bir notasyon sisteminden diğerine değiştirilmesi yoluyla tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个团体的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50895", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCorporateBodyOf.en", "label":"is reviser corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50773", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberCollectiveAgentOf.en", "label":"is transcriber collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50924", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/transcriberCorporateBodyOf.en", "label":"is transcriber corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50924", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/transcriberCorporateBodyOf.en", "label":"is transcriber corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51075","label":{"ar":"هي عائلة ناسخة لـ","ca":"és família transcriptora de","cs":"je přepisovatelem (rodinou) (čeho)","da":"er familie, som er transskribent af","de":"ist Familie als Transkribiererin/Transkribierer von","de":"ist Familie als Transkribiererin/Transkribierer von","el":"είναι μεταγραφέας οικογένεια του","en":"is transcriber family of","es":"es familia transcriptora de","et":"transkribeerija (perekond) väljenduses","fi":"transkriboija (suku) ekspressiossa","fr":"est une famille transcriptrice de","hu":"átíró családja a következőnek:","it":"è trascrittore famiglia di","lv":"ir transkribētājs (dzimta/ģimene)","nl":"is transcribeerder-familie van","no":"er avskriver for (familie)","tr":"transkript ailesi","zh-Hans-CN":"是……的转写者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في كتابة أو تدوين محتوى لم تسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"el":["Συνδέει μια οικογένεια με μια έκφραση που περιλαμβάνει μια συνεισφορά από μια οικογένεια μέσω της συγγραφής ή του σχολιασμού προηγούμενα άγραφου ή ασχολίαστου περιεχομένου, ή μέσω της μεταγραφής του από ένα σύστημα σημειογραφίας σε ένα άλλο."],"en":["Relates a family to an expression that includes a contribution by a family of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää suvun ekspressioon, jonka tekemisessä suku on osallisena kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller ved å endre det fra ett notasjonssystem til et annet."],"tr":["Bir aileyi, daha önce yazılmamış veya not edilmemiş içeriğin yazılması veya not edilmesi veya bir notasyon sisteminden diğerine değiştirilmesi yoluyla bir ailenin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个家族的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة ناسخة","ca":"família transcriptora de","cs":"přepisovatel (rodina) (čeho)","da":"familie, som er transskribent af","de":"Familie als Transkribiererin/Transkribierer von","de":"Familie als Transkribiererin/Transkribierer von","el":"μεταγραφέας οικογένεια του","en":"transcriber family of","es":"familia transcriptora de","et":"transkribeerija (perekond) väljenduses","fi":"transkriboija (suku) ekspressiossa","fr":"famille transcriptrice de","hu":"átíró családja:","it":"trascrittore famiglia di","lv":"ir transkribētājs (dzimta/ģimene)","nl":"transcribeerder-familie van","no":"avskriver for (familie)","tr":"yazıya aktaran aile","zh-Hans-CN":"……的转写者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في كتابة أو تدوين محتوى لم تسبق كتابته أو تدوينه، أو في تغييره من نظام تدوين إلى آخر.","ca":"Expressió que inclou una contribució d’una família escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že zapisuje nebo přepisuje dosud nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Udtryk, som omfatter en families bidrag ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","en":"An expression that includes a contribution by a family of writing down or notating previously unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Una expresión que incluye una contribución de una familia de escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro.","et":"Väljendus, millesse perekond on andnud panuse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Ekspressio, jonka tekemisessä suku on osallisena kirjoittamalla muistiin tai nuotintamalla aiemmin kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen nuotinnusjärjestelmästä toiseen.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à écrire ou à noter un contenu auparavant non écrit ou non noté, ou bien à le transposer d’un système de notation à un autre.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését korábban le nem írt vagy le nem jegyzett tartalom leírásában vagy lejegyzésében, vagy egyik jelölési rendszerről a másikra történő átvitelében.","it":"Espressione che comprende un contributo di una famiglia nella trascrizione o annotazione di contenuti precedentemente non scritti o non annotati, o nella trasformazione da un sistema di notazione a un altro.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, pierakstot iepriekš nepierakstītu mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een expressie die omvat een bijdrage door een familie door opschrijven of noteren van voorheen ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteen naar een ander.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å skrive ned eller notere tidligere uskrevet eller unotert innhold, eller ved å endre det fra ett notasjonssystem til et annet.","tr":"Daha önce yazılmamış veya not edilmemiş içeriği not eden ya da bir notasyon sisteminden diğerine değiştiren bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系的一个家族的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
