                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50202", "lexicalAlias":"http://rdaregistry.info/Elements/a/manufacturerAgentOf.en", "label":"is manufacturer agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/brailleEmbosserAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50649", "lexicalAlias":"http://rdaregistry.info/Elements/a/brailleEmbosserCollectiveAgentOf.en", "label":"is braille embosser collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50498", "lexicalAlias":"http://rdaregistry.info/Elements/a/brailleEmbosserPersonOf.en", "label":"is braille embosser person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50172", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/brailleEmbosserAgentOf.en", "label":"is braille embosser agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50172", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/brailleEmbosserAgentOf.en", "label":"is braille embosser agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50649","label":{"ar":"هو وكيل جماعي نقاش حروف بطريقة برايل لـ","ca":"és agent col·lectiu estampador braille de","cs":"je tiskařem Braillova písma (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er punktskriftspræger af","de":"ist gemeinschaftlicher Akteur als Brailleschriftprägerin/Brailleschriftpräger von","de":"ist gemeinschaftlicher Akteur als Brailleschriftprägerin/Brailleschriftpräger von","el":"είναι μπράιγ τυπογράφος συλλογικός φορέας του","en":"is braille embosser collective agent of","es":"es el agente colectivo de impresoras braille de","et":"punktkirja kirjutaja (kollektiiv) kehastuses","fi":"pistekirjoituksen tekijä (yhteistoimija) manifestaatiossa","fr":"est un agent collectif producteur braille de","hu":"Braille-dombornyomó kollektív ágense a következőnek:","it":"è stampatore braille agente collettivo di","lv":"ir iespiedējs Braila rakstā (grupa)","nl":"is brailleerder-collectieve actor van","no":"er punktskriftspreger for (kollektiv agent)","tr":"braille kabartmacısı kolektif temsilcisidir","zh-Hans-CN":"是……的布莱叶盲文点字制作者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن نقش خلايا برايل باستخدام قلم أو طابعة خاصة للنقش أو أي أداة أخرى."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost kolektivního agenta za vyražení braillských buněk pomocí stylusu, speciální vyrážecí tiskárny nebo jiného zařízení."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for at præge punktskriftsceller vha. en stift, særlig prægeprinter eller anden anordning."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for embossing braille cells using a stylus, special embossing printer, or other device."],"es":["Relaciona un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de grabar celdas braille usando un lápiz óptico, una impresora especial de grabado u otro dispositivo."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega punktkirjamärkide tegemise eest."],"fi":["Liittää yhteistoimijan manifestaatioon, jonka tekemisestä yhteistoimija on vastuussa tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à embosser des cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége braille-cellák dombornyomásáért íróvessző, speciális dombornyomtató vagy más eszköz használatával."],"it":["Correla un agente collettivo a una manifestazione che implica una responsabililtà di un agente collettivo per lo sbalzo di punti braille utilizzando uno stilo, una speciale stampante a sbalzo o altro dispositivo."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par Braila raksta matricas iespiešanu, izmantojot irbuli, īpaša ciļņa iespieduma printeri vai citu ierīci."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het pregen van braille cellen met gebruikmaking van een stylus, speciale preegdrukmachine of ander instrument."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av å prege brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning."],"tr":["Kolektif bir temsilciyi bir kalem, özel kabartma yazıcısı veya başka bir cihaz kullanarak braille hücrelerini kabartmak için kolektif bir temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي نقاش حروف بطريقة برايل","ca":"agent col·lectiu estampador braille de","cs":"tiskař Braillova písma (kolektivní agent) (čeho)","da":"kollektiv agent, som er punktskriftspræger af","de":"Gemeinschaftlicher Akteur als Brailleschriftprägerin/Brailleschriftpräger von","de":"Gemeinschaftlicher Akteur als Brailleschriftprägerin/Brailleschriftpräger von","el":"μπράιγ τυπογράφος συλλογικός φορέας του","en":"braille embosser collective agent of","es":"agente colectivo de impresoras braille de","et":"punktkirja kirjutaja (kollektiiv) kehastuses","fi":"pistekirjoituksen tekijä (yhteistoimija) manifestaatiossa","fr":"agent collectif producteur braille de","hu":"Braille-dombornyomó kollektív ágense:","it":"stampatore braille agente collettivo di","lv":"ir iespiedējs Braila rakstā (grupa)","nl":"brailleerder-collectieve actor van","no":"punktskriftspreger for (kollektiv agent)","tr":"braille kabartmacısı kolektif temsilcisi","zh-Hans-CN":"……的布莱叶盲文点字制作者集体行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل جماعي عن نقش خلايا برايل باستخدام قلم أو طابعة خاصة للنقش أو أي أداة أخرى.","ca":"Manifestació que implica una responsabilitat d’un agent col·lectiu en el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme.","cs":"Provedení, které zahrnuje odpovědnost kolektivního agenta za vyražení braillských buněk pomocí stylusu, speciální vyrážecí tiskárny nebo jiného zařízení.","da":"Manifestation, som involverer en kollektiv agents ansvar for at præge punktskriftsceller vha. en stift, særlig prægeprinter eller anden anordning.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet.","en":"A manifestation that involves a responsibility of a collective agent for embossing braille cells using a stylus, special embossing printer, or other device.","es":"Una manifestación que implica la responsabilidad de un agente colectivo de grabar celdas braille usando un lápiz óptico, una impresora especial de grabado u otro dispositivo.","et":"Kehastus, mis sisaldab kollektiivi vastutust spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega punktkirjamärkide tegemise eest.","fi":"Manifestaatio, jonka tekemisestä yhteistoimija on vastuussa tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à embosser des cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy kollektív ágens felelőssége braille-cellák dombornyomásáért íróvessző, speciális dombornyomtató vagy más eszköz használatával.","it":"Manifestazione che implica una responsabililtà di un agente collettivo per lo sbalzo di punti braille utilizzando uno stilo, una speciale stampante a sbalzo o altro dispositivo.","lv":"Manifestācija, kas ietver grupas atbildību par Braila raksta matricas iespiešanu, izmantojot irbuli, īpaša ciļņa iespieduma printeri vai citu ierīci.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het pregen van braille cellen met gebruikmaking van een stylus, speciale preegdrukmachine of ander instrument.","no":"En manifestasjon som involverer et ansvar for en kollektiv agent i form av å prege brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning.","tr":"Kalem, özel kabartma yazıcı veya başka bir cihaz kullanarak braille hücrelerini kabartmak için kolektif bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文的一个集体行为者的责任的一种载体表现"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
