                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"lexicalAlias":"http://rdaregistry.info/Elements/a/componentOfMerger.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50012", "lexicalAlias":"http://rdaregistry.info/Elements/a/predecessorOfCorporateBody.en", "label":"has predecessor of corporate body"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50232", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/componentOfMerger.en", "label":"has component of merger"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50232", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/componentOfMerger.en", "label":"has component of merger"}]},{"@id":"http://rdaregistry.info/Elements/a/P50011","label":{"ar":"لها هيئة مُدمجة","ca":"té com a entitat corporativa fusionada","cs":"má sloučené","da":"har sammenlagt","de":"hat fusionierte Körperschaft","de":"hat fusionierten Akteur","el":"έχει συγχώνευση","en":"has mergee","es":"tiene fusionado","et":"ühendav asutus","fi":"kanssayhdistyjä","fr":"a pour collectivité fusionnée","hu":"beolvadója a következő:","it":"ha come accorpato","lv":"institūcija apvienota ar","nl":"heeft fusiepartner","no":"har element i sammenslåing","tr":"birleşen kurum ile ilişkilidir","zh-Hans-CN":"有被合并的一方"},"definition":{"ar":["يربط هيئة بهيئة اندمجت مع هيئة أخرى لتشكيل هيئة ثالثة."],"ca":["Relaciona una entitat corporativa amb una entitat corporativa que s’ha fusionat amb una altra entitat corporativa per formar-ne una tercera."],"cs":["Vztahuje korporaci ke korporaci, která se sloučila s jinou právnickou osobou a tím vznikla třetí korporace."],"da":["Relaterer en korporation til en korporation, som blev sammenlagt med en anden korporation for at skabe en tredje."],"de":["Setzt eine Körperschaft in Beziehung zu einer Körperschaft, die mit einer anderen Körperschaft fusioniert hat, um eine neue zu bilden.,Setzt eine Körperschaft in Beziehung zu einer Körperschaft, die mit einer anderen Körperschaft fusioniert hat, um eine neue zu bilden."],"el":["Συνδέει ένα συλλογικό όργανο με ένα συλλογικό όργανο το οποίο συγχωνεύθηκε με κάποιο άλλο συλλογικό όργανο για τη δημιουργία ενός τρίτου."],"en":["Relates a corporate body to a corporate body who merged with another corporate body to form a third."],"es":["Relaciona un organismo corporativo con un organismo corporativo que se fusionó con otro organismo corporativo para formar un tercero."],"et":["Seostab asutuse asutusega, mis on ühendanud teise asutuse ja moodustunud on kolmas asutus."],"fi":["Liittää yhteisön yhteisöön, joka on sulautunut toiseen yhteisöön muodostaakseen kolmannen yhteisön."],"fr":["Met une collectivité en relation avec une collectivité qui a fusionné avec une autre collectivité pour en former une troisième."],"hu":["Hozzákapcsol egy testületet egy testülethez, amely egy harmadikat alkotva összeolvad egy másik testülettel."],"it":["Correla un ente a un ente che si è accorpato con un altro ente per formarne un terzo."],"lv":["Sasaista institūciju ar institūciju, kas apvienota ar citu institūciju, kopā veidojot trešo."],"nl":["Relateert een corporatie aan een corporatie die met een andere corporatie fuseerde om een derde te vormen."],"no":["Relaterer en korporasjon til en korporasjon som er slått sammen med en annen korporasjon for å danne en tredje korporasjon."],"tr":["Bir tüzel kişiyi, üçüncü bir tüzel kişiyi oluşturmak üzere başka bir tüzel kişi ile birleşen bir tüzel kişi ile ilişkilendirir"],"zh-Hans-CN":["将一个团体与一个和另一团体合并后形成第三个团体的团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مُدمجة","ca":"entitat corporativa fusionada","cs":"sloučené","da":"sammenlagt","de":"Fusionierte Körperschaft","de":"Fusionierte Körperschaft","el":"συγχώνευση","en":"mergee","es":"fusionado","et":"ühendav asutus","fi":"kanssayhdistyjä","fr":"collectivité fusionnée","hu":"beolvadó:","it":"accorpato","lv":"institūcija apvienota ar","nl":"fusiepartner","no":"element i sammenslåing","tr":"Birleşme","zh-Hans-CN":"被合并的一方"},"ToolkitDefinition":{"ar":"هيئة اندمجت مع هيئة أخرى لتُشكل هيئة ثالثة.","ca":"Entitat corporativa que s’ha fusionat amb una altra entitat corporativa per formar-ne una tercera.","cs":"Korporace, která se sloučila s jinou právnickou osobou a tím vznikla třetí korporace.","da":"Korporation, som blev sammenlagt med en anden korporation for at skabe en tredje.","de":"Eine Körperschaft, die mit einer anderen Körperschaft fusioniert hat, um eine neue zu bilden.","de":"Eine Körperschaft, die mit einer anderen Körperschaft fusioniert hat, um eine neue zu bilden.","el":"Ένα συλλογικό όργανο το οποίο συγχωνεύθηκε με κάποιο άλλο συλλογικό όργανο για τη δημιουργία ενός τρίτου.","en":"A corporate body who merged with another corporate body to form a third.","es":"Un organismo corporativo que se fusionó con otro organismo corporativo para formar un tercero.","et":"Asutus, mis on ühendanud teise asutuse ja moodustunud on kolmas asutus.","fi":"Yhteisö, joka on sulautunut toiseen yhteisöön muodostaakseen kolmannen yhteisön.","fr":"Collectivité qui a fusionné avec une autre collectivité pour en former une troisième.","hu":"Egy testület, amely egy harmadikat alkotva összeolvad egy másik testülettel.","it":"Ente che si è accorpato con un altro ente per formarne un terzo.","lv":"Ar otru institūciju apvienota institūcija, kopā veidojot trešo.","nl":"Een corporatie die met een andere corporatie fuseerde om een derde te vormen.","no":"En korporasjon som er slått sammen med en annen korporasjon for å danne en tredje korporasjon.","tr":"Üçüncü bir tüzel kişi oluşturmak üzere başka bir tüzel kişiyle birleşen bir tüzel kişi","zh-Hans-CN":"与另一团体合并后形成第三个团体的团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
