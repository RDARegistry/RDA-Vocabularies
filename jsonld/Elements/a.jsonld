                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/judgeOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50126", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/judgeOf.en", "label":"is judge of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50126", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/judgeOf.en", "label":"is judge of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50247","label":{"ar":"هو وكيل رسام كتب لـ","ca":"és agent artista de llibre d’art de","cs":"je knižním výtvarníkem (agentem) (čeho)","da":"er agent, som er bogkunstner af","de":"ist Akteur als Buchkünstlerin/Buchkünstler von","de":"ist Akteur als Buchkünstlerin/Buchkünstler von","el":"είναι βιβλίο του καλλιτέχνη φορέας του","en":"is book artist agent of","es":"es agente artista del libro de","et":"raamatukunstnik (tegija) teoses","fi":"kirjataiteilija (toimija) teoksessa","fr":"est un agent artiste du livre de","hu":"könyvművész ágense a következőnek:","it":"è book artist di","lv":"ir grāmatu mākslinieks (aģents)","nl":"is boekkunstenaar-actor van","no":"er bokkunstner for (agent)","tr":"kitap sanatçısı temsilcisidir","zh-Hans-CN":"是……的图书美术家行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن استغلال شكل الكتاب أو تغيير بنيته المادية."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en l’explotació de la forma llibre o en la modificació de la seva estructura física."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za zpracování podoby knihy nebo změnu její fyzické struktury."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at udnytte bogformen eller ændre dens fysiske struktur."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist."],"el":["Συνδέει έναν καλλιτέχνη, υπεύθυνο για τη δημιουργία έργων τέχνης τα οποία αξιοποιούν τη μορφή του βιβλίου ή μεταβάλλουν τη φυσική του δομή ως μέρος του περιεχομένου, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for exploiting the book form or altering its physical structure."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de explotar la forma del libro o alterar su estructura física."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à exploiter la forme livre ou à modifier sa structure physique."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége a könyvforma kiaknázásáért vagy fizikai szerkezetének megváltoztatásáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per la valorizzazione del formato del libro o l'alterazione della sua struttura fisica."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par grāmatas formas izmantošanu vai tās fiziskās struktūras pārveidošanu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het benutten van de vorm van het boek of veranderen van de fysieke structuur."],"no":["Relaterer en agent til et verk som som involverer ansvar for en agent i form av å utnytte bokformen eller å gjøre endringer i dens fysiske struktur."],"tr":["Bir temsilciyi, kitap biçiminden yararlanmak veya fiziksel yapısını değiştirmekle görevli bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及开发图书外形或改变其物理结构的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل رسّام كتب مصورة لــ","ca":"agent artista de llibre d’art de","cs":"knižní výtvarník (agent) (čeho)","da":"agent, som er bogkunstner af","de":"Akteur als Buchkünstlerin/Buchkünstler von","de":"Akteur als Buchkünstlerin/Buchkünstler von","el":"βιβλίο του καλλιτέχνη φορέας του","en":"book artist agent of","es":"agente artista del libro de","et":"raamatukunstnik (tegija) teoses","fi":"kirjataiteilija (toimija) teoksessa","fr":"agent artiste du livre de","hu":"könyvművész ágense:","it":"book artist di","lv":"ir grāmatu mākslinieks (aģents)","nl":"boekkunstenaar-actor van","no":"bokkunstner for (agent)","tr":"kitap sanatçısı temsilcisi","zh-Hans-CN":"……的图书美术家行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن استغلال شكل الكتاب أو تغيير بنيته المادية.","ca":"Obra que implica una responsabilitat d’un agent en l’explotació de la forma llibre o en la modificació de la seva estructura física.","cs":"Dílo, které zahrnuje odpovědnost agenta za zpracování podoby knihy nebo změnu její fyzické struktury.","da":"Værk, som involverer en agents ansvar for at udnytte bogformen eller ændre dens fysiske struktur.","de":"Ein Werk, bei dem ein Akteur für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την καλλιτεχνική ευθύνη για τη δημιουργία έργων τέχνης, τα οποία αξιοποιούν τη μορφή του βιβλίου ή μεταβάλλουν τη φυσική του δομή ως μέρος του περιεχομένου.","en":"A work that involves a responsibility of an agent for exploiting the book form or altering its physical structure.","es":"Una obra que involucra una responsabilidad de un agente de explotar la forma del libro o alterar su estructura física.","et":"Teos, mis sisaldab tegija vastutust raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.","fi":"Teos, jossa toimija on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à exploiter la forme livre ou à modifier sa structure physique.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége a könyvforma kiaknázásáért vagy fizikai szerkezetének megváltoztatásáért.","it":"Opera che implica la responsabilità di un agente per la valorizzazione del formato del libro o l'alterazione della sua struttura fisica.","lv":"Darbs, kas ietver aģenta atbildību par grāmatas formas izmantošanu vai tās fiziskās struktūras pārveidošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.","no":"Et verk som som involverer ansvar for en agent i form av å utnytte bokformen eller å gjøre endringer i dens fysiske struktur.","tr":"Kitap biçiminden yararlanmak veya fiziksel yapısını değiştirmek için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及开发图书外形或改变其物理结构的一个行为者的责任的一种作品"},"altLabel":{"ar":["رسّام كتب صورة لـ"],"ca":["artista de llibre d’art de"],"cs":["knižní výtvarník (čeho)"],"da":["bogkunstner af"],"de":["Buchkünstlerin/Buchkünstler von,Buchkünstlerin/Buchkünstler von"],"el":["βιβλίο του καλλιτέχνη του"],"en":["book artist of"],"es":["artista del libro de"],"et":["raamatukunstnik teoses"],"fi":["kirjataiteilijana taideteoksessa"],"fr":["artiste du livre de"],"hu":["könyvművésze:"],"it":["grafico di"],"nl":["boekkunstenaar van"],"no":["bokkunstner for"],"tr":["kitap sanatçısı"],"zh-Hans-CN":["……的图书美术家"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
