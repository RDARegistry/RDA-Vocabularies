                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50296", "lexicalAlias":"http://rdaregistry.info/Elements/a/audioEngineerAgentOf.en", "label":"is audio engineer agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50768", "lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerCollectiveAgentOf.en", "label":"is recording engineer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50617", "lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerPersonOf.en", "label":"is recording engineer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50158", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/recordingEngineerAgentOf.en", "label":"is recording engineer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50158", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/recordingEngineerAgentOf.en", "label":"is recording engineer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50768","label":{"ar":"هو وكيل جماعي مهندس تسجيل لـ","ca":"és agent col·lectiu enginyer de so de","cs":"je technikem záznamu (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er indspilningstekniker af","de":"ist gemeinschaftlicher Akteur als Aufnahmetechnikerin/Aufnahmetechniker von","de":"ist gemeinschaftlicher Akteur als Aufnahmetechnikerin/Aufnahmetechniker von","el":"είναι μηχανικός ηχογράφησης συλλογικός φορέας του","en":"is recording engineer collective agent of","es":"es agente colectivo ingeniero de grabación de","et":"salvestusinsener (kollektiiv) väljenduses","fi":"äänittäjä (yhteistoimija) ekspressiossa","fr":"est un agent collectif preneur de son de","hu":"hangrögzítő kollektív ágense a következőnek:","it":"è ingegnere della registrazione agente collettivo di","lv":"ir ierakstu inženieris (grupa)","nl":"is opnametechnicus-collectieve actor van","no":"er innspillingstekniker for (kollektiv agent)","tr":"ses kayıt mühendisi kolektif temsilcisidir","zh-Hans-CN":"是……的录制工程师集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu supervisant els aspectes tècnics del contingut àudio d’una sessió d’enregistrament."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že dohlíží na technické aspekty zvukového obsahu nahrávání."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at føre tilsyn med de tekniske aspekter af lydindholdet til en lyd- eller videooptagelse."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of supervising the technical aspects of the audio content of a recording session."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de supervisar los aspectos técnicos del contenido de audio de una sesión de grabación."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, juhendades helisisu salvestamise tehnilisi aspekte."],"fi":["Liittää yhteistoimijan ekspressioon, jonka äänisisällön tekemiseen yh