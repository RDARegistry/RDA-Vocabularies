                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/donorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50934", "lexicalAlias":"http://rdaregistry.info/Elements/a/formerOwnerCorporateBodyOf.en", "label":"is former owner corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50790", "lexicalAlias":"http://rdaregistry.info/Elements/a/donorCollectiveAgentOf.en", "label":"is donor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50941", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/donorCorporateBodyOf.en", "label":"is donor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50941", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/donorCorporateBodyOf.en", "label":"is donor corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51092","label":{"ar":"هي عائلة متبرعة لـ","ca":"és família donant de","cs":"je dárcem (rodinou) (čeho)","da":"er familie, som er donor af","de":"ist Familie als Stifterin/Stifter von","de":"ist Familie als Stifterin/Stifter von","el":"είναι δωρητής οικογένεια του","en":"is donor family of","es":"es familia donadora de","et":"annetaja (perekond) eksemplarile","fi":"lahjoittaja (suku) kappaleelle","fr":"est une famille donatrice de","hu":"adományozó családja a következőnek:","it":"è donatore famiglia di","lv":"ir ziedotājs (dzimta/ģimene)","nl":"is schenker-familie van","no":"er giver av (familie)","tr":"bağışçı ailesidir","zh-Hans-CN":"是……的捐赠者家族"},"definition":{"ar":["يربط عائلة بمفردة يتم التبرع بها إلى عائلة مالك آخر."],"ca":["Relaciona una família amb un ítem que es dona a un altre propietari que és una família."],"cs":["Vztahuje rodinu k jednotce, která byla darována jinému vlastníkovi, jímž je rodina."],"da":["Relaterer en familie til et eksemplar, som er doneret til en anden ejer, som er en familie."],"de":["Setzt eine Familie in Beziehung zu einem Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Familie) überlassen wird.,Setzt eine Familie in Beziehung zu einem Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Familie) überlassen wird."],"el":["Συνδέει μια οικογένεια με ένα αντίτυπο το οποίο δωρίζεται σε άλλον κάτοχο, ο οποίος είναι μια οικογένεια."],"en":["Relates a family to an item that is donated to another owner who is a family."],"es":["Relaciona una familia con un ítem que es donado a otro propietario que es una familia."],"et":["Seostab perekonna eksemplariga, mille perekond on kinkinud teisele omanikule."],"fi":["Liittää suvun kappaleeseen, jonka suku on lahjoittanut toiselle suvulle."],"fr":["Met une famille en relation avec un item qui est offert en don à un autre propriétaire qui est une famille."],"hu":["Hozzákapcsol egy családot egy példányhoz, amelyet egy másik tulajdonos családnak adományoznak."],"it":["Correla una famiglia a un item donato a un altro proprietario che è una famiglia."],"lv":["Sasaista dzimtu/ģimeni ar vienību, ko dzimta/ģimene ziedojusi citam īpašniekam."],"nl":["Relateert een familie aan een item dat is geschonken aan een andere eigenaar die een familie is."],"no":["Relaterer en familie til et eksemplar som er gitt til en annen eier som er en familie."],"tr":["Bir aileyi, aile olan başka bir sahibine bağışlanan bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个家族与被捐赠给作为一个家族的另一个拥有者的一个单件关联起来。"]},"ToolkitLabel":{"ar":"عائلة متبرعة","ca":"família donant de","cs":"dárce (rodina) (čeho)","da":"familie, som er donor af","de":"Familie als Stifterin/Stifter von","de":"Familie als Stifterin/Stifter von","el":"δωρητής οικογένεια του","en":"donor family of","es":"familia donadora de","et":"annetaja (perekond) eksemplarile","fi":"lahjoittaja (suku) kappaleelle","fr":"famille donatrice de","hu":"adományozó családja","it":"donatore famiglia di","lv":"ir ziedotājs (dzimta/ģimene)","nl":"schenker-familie van","no":"giver av (familie)","tr":"bağışçı aile","zh-Hans-CN":"……的捐赠者家族"},"ToolkitDefinition":{"ar":"مفردة يتم التبرع بها إلى عائلة مالك آخر.","ca":"Ítem que es dona a un altre propietari que és una família.","cs":"Jednotka, která byla darována jinému vlastníkovi, jímž je rodina.","da":"Eksemplar, som er doneret til en anden ejer, som er en familie.","de":"Ein Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Familie) überlassen wird.","de":"Ein Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Familie) überlassen wird.","en":"An item that is donated to another owner who is a family.","es":"Un ítem que es donado a otro propietario que es una familia.","et":"Eksemplar, mille perekond on kinkinud teisele omanikule.","fi":"Kappale, joka on lahjoitettu toiselle suvulle.","fr":"Item qui est offert en don à un autre propriétaire qui est une famille.","hu":"Egy példány, amelyet egy másik tulajdonos családnak adományoznak.","it":"Item donato a un altro proprietario che è una famiglia.","lv":"Vienība, ko dzimta/ģimene ziedojusi citam īpašniekam.","nl":"Een item dat is gedoneerd aan een andere eigenaar die een familie is.","no":"Et eksemplar som er gitt til en annen eier som er en familie.","tr":"Bir aile olan başka bir mülk sahibine bağışlanan bir kopya.","zh-Hans-CN":"被捐赠给作为一个家族的另一个拥有者的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
