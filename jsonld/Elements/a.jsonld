                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/moderatorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50603", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerPersonOf.en", "label":"is performer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50076", "lexicalAlias":"http://rdaregistry.info/Elements/a/moderatorAgentOf.en", "label":"is moderator agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50591", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/moderatorPersonOf.en", "label":"is moderator person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50591", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/moderatorPersonOf.en", "label":"is moderator person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50446","label":{"ar":"هو وكيل مُعدّل لـ","ca":"és agent modificador de","cs":"je upravovatelem (agentem) (čeho)","da":"er agent, som er tilpasser af","de":"ist Akteur als Bearbeiterin/Bearbeiter eines Exemplars von","de":"ist Akteur als Bearbeiterin/Bearbeiter eines Exemplars von","el":"είναι τροποποιητής φορέας του","en":"is modifier agent of","es":"es agente modificador de","et":"muutja (tegija) eksemplaris","fi":"muokkaaja (toimija) kappaleessa","fr":"est un agent modificateur de","hu":"módosító ágense a következőnek:","it":"è modificatore agente di","lv":"ir modificētājs (aģents)","nl":"is aanpasser-actor van","no":"er tilpasser av (agent)","tr":"düzenleyici temsilcisidir","zh-Hans-CN":"是……的修改者行为者"},"definition":{"ar":["يربط وكيلا بمفردة قام الوكيل بتغييرها دون إنشاء تجسيدة جديدة."],"ca":["Relaciona un agent amb un ítem que és canviat per un agent sense crear una nova manifestació."],"cs":["Vztahuje agenta k jednotce, která byla agen