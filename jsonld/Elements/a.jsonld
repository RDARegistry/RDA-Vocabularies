                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/custodianPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50314", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfPerson.en", "label":"has related item of person"},{"@id":"http://rdaregistry.info/Elements/a/P50164", "lexicalAlias":"http://rdaregistry.info/Elements/a/custodianAgentOf.en", "label":"is custodian agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50633", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/custodianPersonOf.en", "label":"is custodian person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50633", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/custodianPersonOf.en", "label":"is custodian person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50073","label":{"ar":"هو وكيل راقص لـ","ca":"és agent ballarí de","cs":"je tanečníkem (agentem) (čeho)","da":"er agent, som er danser af","de":"ist Akteur als Tänzerin/Tänzer von","de":"ist Akteur als Tänzerin/Tänzer von","el":"είναι χορευτής φορέας του","en":"is dancer agent of","es":"es agente bailarín de","et":"tantsija (tegija) väljenduses","fi":"tanssija (toimija) ekspressiossa","fr":"est un agent danseur de","hu":"táncos ágense a következőnek:","it":"è danzatore agente di","lv":"ir dejotājs (aģents)","nl":"is danser-actor van","no":"er danser i (agent)","tr":"dansçı temsilcisidir","zh-Hans-CN":"是……的舞蹈者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بالرقص في عرض موسيقي أو درامي."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent dansant en una representació musical o dramàtica."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že tančí v hudebním nebo dramatickém vystoupení."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at danse i en musikalsk eller dramatisk præsentation."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt."],"el":["Συνδέει έναν εκτελεστή, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω του χορού σε μια μουσική, δραματική κ.λπ. παρουσίαση, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of dancing in a musical or dramatic presentation."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de baila en una presentación musical o dramática."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, tantsides muusika- või draamaetenduses."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu tanssimalla musiikki- tai näyttämöesityksessä."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à danser dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy zenei vagy drámai bemutatóban táncoló ágens közreműködését."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente che danza in una presentazione musicale o teatrale."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, dejojot muzikālā vai dramatiskā uzvedumā."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage van een actor door het dansen in een muziek- of dramapresentatie."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å danse i en musikalsk eller dramatisk forestilling."],"tr":["Bir temsilciyi, müzikal veya dramatik bir sunumda dans eden temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括在音乐或戏剧呈现中的一个舞蹈行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل راقص","ca":"agent ballarí de","cs":"tanečník (agent) (čeho)","da":"agent, som er danser af","de":"Akteur als Tänzerin/Tänzer von","de":"Akteur als Tänzerin/Tänzer von","el":"χορευτής φορέας του","en":"dancer agent of","es":"agente bailarín de","et":"tantsija (tegija) väljenduses","fi":"tanssija (toimija) ekspressiossa","fr":"agent danseur de","hu":"táncos ágense:","it":"danzatore agente di","lv":"ir dejotājs (aģents)","nl":"danser-actor van","no":"danser i (agent)","tr":"dansçı temsilci","zh-Hans-CN":"……的舞蹈者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل الرقص في عرض موسيقي أو مسرحي.","ca":"Expressió que inclou una contribució d’un agent dansant en una representació musical o dramàtica.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že tančí v hudebním nebo dramatickém vystoupení.","da":"Udtryk, som omfatter en agents bidrag ved at danse i en musikalsk eller dramatisk præsentation.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά της χορευτικής ερμηνείας σε μια μουσική, δραματική κ.λπ. παρουσίαση.","en":"An expression that includes a contribution by an agent of dancing in a musical or dramatic presentation.","es":"Una expresión que incluye una contribución de un agente de bailar en una presentación musical o dramática.","et":"Väljendus, millesse tegija on andnud panuse, tantsides muusika- või draamaetenduses.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu tanssimalla musiikki- tai näyttämöesityksessä.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à danser dans une présentation musicale ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy zenei vagy drámai bemutatóban táncoló ágens közreműködését.","it":"Espressione che include un contributo da parte di un agente che danza in una presentazione musicale o drammatica,","lv":"Izteiksme, kas ietver aģenta ieguldījumu, dejojot muzikālā vai dramatiskā uzvedumā.","nl":"Een expressie die omvat een bijdrage van een actor door het dansen in een muziek- of dramapresentatie.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å danse i en musikalsk eller dramatisk forestilling.","tr":"Müzikal veya dramatik bir sunumda dans eden bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括在音乐或戏剧呈现中的一个舞蹈行为者的贡献的一种内容表达"},"altLabel":{"ar":["راقص"],"ca":["ballarí de"],"cs":["tanečník (čeho)"],"da":["danser af"],"de":["Tänzer von,Tänzer von"],"el":["χορευτής του"],"en":["dancer of"],"es":["bailarín de"],"et":["tantsija väljenduses"],"fi":["tanssiesitys"],"fr":["danseur de"],"hu":["táncosa:"],"it":["danzatore di"],"nl":["danser van"],"no":["danser i"],"tr":["dansçı"],"zh-Hans-CN":["……的舞蹈者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
