                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50311", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfPerson.en", "label":"has related work of person"},{"@id":"http://rdaregistry.info/Elements/a/P50130", "lexicalAlias":"http://rdaregistry.info/Elements/a/issuingAgentOf.en", "label":"is issuing agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/issuingPersonOf.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50546", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/issuingPersonOf.en", "label":"is issuing person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50546", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/issuingPersonOf.en", "label":"is issuing person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50128","label":{"ar":"هو مُعلِّق على","ca":"és anotador de","cs":"je anotátorem (čeho)","da":"er annoteringsskriver af","de":"ist annotierende Person von","de":"ist annotierender Akteur von","el":"είναι σχολιαστής του","en":"is annotator of","es":"es glosador de","et":"sissekirjutuste autor eksemplaris","fi":"lisähuomautusten kirjoittaja kappaleessa","fr":"est un annotateur de","hu":"jegyzetekkel ellátója a következőnek:","it":"è annotatore di","lv":"ir anotējis","nl":"is annotator van","no":"er annoterende person for","tr":"yorumlayıcısıdır","zh-Hans-CN":"是……的手写批注者"},"definition":{"ar":["يربط شخصا بمفردة تشتمل على ملاحظات ومعلومات أخرى أضيفت بخط اليد."],"ca":["Relaciona una persona amb un ítem que porta notes i altra informació afegida a mà."],"cs":["Vztahuje osobu k jednotce, která obsahuje poznámky a další informace doplněné rukou."],"da":["Relaterer en person til et eksemplar, som har noter og anden information skrevet i hånden."],"de":["Setzt eine Person in Beziehung zu einem Exemplar, das handschriftlich Anmerkungen und andere Informationen beinhaltet.,Setzt eine Person in Beziehung zu einem Exemplar, das handschriftlich Anmerkungen und andere Informationen beinhaltet."],"el":["Συνδέει ένα φυσικό πρόσωπο, το οποίο δημιουργεί χειρόγραφα σχόλια/σημειώσεις σε ένα αντίτυπο, με ένα αντίτυπο."],"en":["Relates a person to an item that carries notes and other information added by hand."],"es":["Relaciona una persona con un ítem que lleva consigo notas y otra información agregada a mano."],"et":["Seostab isiku eksemplariga, milles on käsitsi kirjutatud märkusi ja muud infot."],"fi":["Liittää henkilön kappaleeseen, joka sisältää käsinkirjoitettuja huomautuksia ja muita selityksiä."],"fr":["Met une personne en relation avec un item qui porte des notes ou d’autres informations ajoutées à la main."],"hu":["Hozzákapcsol egy személyt egy példányhoz, amely jegyzeteket és más, kézzel írott információt hordoz."],"it":["Correla una persona a un item che riporta note e altre informazioni aggiunte a mano."],"lv":["Sasaista personu ar vienību, kurai ir pievienotas ar roku rakstītas piezīmes vai cita informācija."],"nl":["Relateert een persoon aan een item waarop noten en andere informatie met de hand toegevoegd zijn."],"no":["Relaterer en person til et eksemplar som har håndskrevne notater og annen informasjon."],"tr":["Bir kişiyi, el yazısı notlar ve diğer bilgileri içeren bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个个人与载有手加批注和其他信息的单件关联起来。"]},"ToolkitLabel":{"ar":"مُعلِق على","ca":"anotador de","cs":"anotátor (čeho)","da":"annoteringsskriver af","de":"Annotierende Person von","de":"Annotierende Person von","el":"σχολιαστής του","en":"annotator of","es":"glosador de","et":"sissekirjutuste autor eksemplaris","fi":"lisähuomautusten kirjoittaja kappaleessa","fr":"annotateur de","hu":"jegyzetekkel ellátója:","it":"annotatore di","lv":"anotējis","nl":"annotator van","no":"annoterende person for","tr":"yorumlayıcı","zh-Hans