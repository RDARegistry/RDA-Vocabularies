                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/casterCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50653", "lexicalAlias":"http://rdaregistry.info/Elements/a/casterCollectiveAgentOf.en", "label":"is caster collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50796", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfManifestationOf.en", "label":"is creator corporate body of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50804", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/casterCorporateBodyOf.en", "label":"is caster corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50804", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/casterCorporateBodyOf.en", "label":"is caster corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50955","label":{"ar":"هي عائلة مسئولة عن الصب لـ","ca":"és família emmotlladora de","cs":"je litcem (rodinou) (čeho)","da":"er familie, som er støber af","de":"ist Familie als Formgießerin/Formgießer von","de":"ist Familie als Formgießerin/Formgießer von","el":"είναι χυτευτής οικογένεια του","en":"is caster family of","es":"es familia fundidora de","et":"valaja (perekond) kehastuses","fi":"valaja (suku) manifestaatiossa","fr":"est une famille fondeuse de","hu":"öntvénykészítő családja a következőnek:","it":"è fonditore famiglia di","lv":"ir atliešanas meistars (dzimta/ģimene)","nl":"is gieter-familie van","no":"er støper av (familie)","tr":"dökümcü ailesidir","zh-Hans-CN":"是……的铸造者家族"},"definition":{"ar":["يربط عائلة بتجسيدة تنطوي على مسئولية عائلة عن صب مادة سائلة أو مذابة في قالب وتركه ليتصلب ليأخذ شكل القالب."],"ca":["Relaciona una família amb una manifestació que implica una responsabilitat d’una família en l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle."],"cs":["Vztahuje rodinu k provedení, které zahrnuje odpovědnost rodiny za nalití kapalné nebo roztavené látky do formy, aby po ztuhnutí nabyla tvaru formy."],"da":["Relaterer en familie til en manifestation, som involverer en families ansvar for at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen."],"de":["Setzt eine Familie in Beziehung zu einer Manifestation, bei der eine Familie dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzenen Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.,Setzt eine Familie in Beziehung zu einer Manifestation, bei der eine Familie dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzenen Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist."],"en":["Relates a family to a manifestation that involves a responsibility of a family for pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold."],"es":["Relaciona una familia con una manifestación que involucra una responsabilidad de una familia para verter un líquido o sustancia fundida en un molde y dejar que se solidifique para que tome la forma del molde."],"et":["Seostab perekonna kehastusega, mis sisaldab perekonna vastutust vedela või sulatatud materjali valuvormi valamise ja valuvormi kuju võtmiseks tahkuda laskmise eest."],"fi":["Liittää suvun manifestaatioon, jonka valmistamisesta suku on vastuussa muovaamalla sulatettua tai nestemäistä ainetta muotin avulla."],"fr":["Met une famille en relation avec une manifestation qui comporte une responsabilité de la part d’une famille consistant à verser un liquide ou une substance fondue dans un moule et à laisser ce liquide ou cette substance se solidifier pour prendre la forme du moule."],"hu":["Hozzákapcsol egy családot egy megjelenési formához, amelyhez hozzátartozik egy család felelőssége folyékony vagy olvasztott anyag öntőformába öntéséért, hogy az ott megszilárduljon és fölvegye az öntőforma formáját."],"it":["Correla una famiglia a una manifestazione che implica una responsabilità di una famiglia nel versare un liquido o sostanza fusa in uno stampo e lasciarlo solidificare per assumere la forma dello stampo."],"lv":["Sasaista dzimtu/ģimeni ar manifestāciju, kas ietver dzimtas/ģimenes atbildību par šķidruma vai izkausētas vielas ieliešanu veidnē un atstāšanu sacietēt, lai tā saglabātu formu."],"nl":["Relateert een familie aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een familie voor het gieten van een vloeistof of gesmolten substantie in een mal en het laten stollen om de vorm van de mal aan te laten nemen."],"no":["Relaterer en familie til en manifestasjon som involverer et ansvar for en familie i form av framstilling av trykt tekst, nedskrevet musikk eller annet innhold fra typer eller plater."],"tr":["Bir aileyi, ailenin sıvı veya erimiş bir maddeyi bir kalıba dökmek ve kalıbın şeklini almak üzere katılaşmaya bırakmaktaki sorumluluğunu içeren gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及将液体或融化的物质倒入模具中使其按模具固化成型的一个家族的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"عائلة مسئولة عن الصب","ca":"família emmotlladora de","cs":"litec (rodina) (čeho)","da":"familie, som er støber af","de":"Familie als Formgießerin/Formgießer von","de":"Familie als Formgießerin/Formgießer von","el":"χυτευτής οικογένεια του","en":"caster family of","es":"familia fundidora de","et":"valaja (perekond) kehastuses","fi":"valaja (suku) manifestaatiossa","fr":"famille fondeuse de","hu":"öntvénykészítő családja:","it":"fonditore famiglia di","lv":"ir atliešanas meistars (dzimta/ģimene)","nl":"gieter-familie van","no":"støper av (familie)","tr":"dökümcü ailesi","zh-Hans-CN":"……的铸造者家族"},"ToolkitDefinition":{"ar":"