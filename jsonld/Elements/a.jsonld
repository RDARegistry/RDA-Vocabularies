                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorCorporateBodyof.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50844", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfWorkOf.en", "label":"is creator corporate body of work of"},{"@id":"http://rdaregistry.info/Elements/a/P51114", "lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorCollectiveAgentof.en", "label":"is collector collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51115", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/isCollectorCorporateBodyof.en", "label":"is collector corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51115", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/isCollectorCorporateBodyof.en", "label":"is collector corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51116","label":{"ca":"és família col·leccionista de","cs":"je sběratelem (rodinou) (čeho)","de":"ist Familie als Sammlerin/Sammler von","en":"is collector family of","es":"es familia recolectora de","fi":"muodostaja (suku) kokoelmalle","fr":"est une famille collectionneuse de","hu":"összegyűjtő családja a következő:","nl":"is verzamelaar-familie van","tr":"koleksiyoncu ailesidir","zh-Hans-CN":"是……的收藏者家族"},"definition":{"ca":["Relaciona una família amb una obra que implica una responsabilitat d’una família en la col·lecció d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament"],"cs":["Vztahuje rodinu k dílu, které zahrnuje odpovědnost rodiny za vytvoření sbírky (díla) výběrem a uspořádáním jednotek, které exemplifikují ztvárnění dalších děl."],"de":["Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Aggregation verantwortlich ist, indem sie Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates a family to a work that involves a responsibility of a family for collecting by selecting and arranging items that exemplify the embodiment of other works"],"es":["Relaciona una familia con una obra que implica la responsabilidad de una familia de recolectar mediante la selección y disposición de elementos que ejemplifican la encarnación de otras obras."],"fi":["Liittää suvun teokseen, jossa suku vastaa kokoelmateoksen muodostamisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää."],"fr":["Met une famille en relation avec une œuvre de collection de ressources qui comporte une responsabilité de la part d’une famille consistant à sélectionner et arranger des items qui exemplifient la matérialisation d’autres œuvres."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyhez hozzátartozik egy család felelőssége olyan egységek válogatásással és elredendezéssel való összegyűjtéséért, amelyek más művek megtestesüléseinek példányai"],"nl":["Relateert een familie aan een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor verzamelen door het selecteren en ordenen van items die voorstellen de belichaming van andere werken."],"tr":["Bir aileyi, diğer işlerin vücut bulmuş halini örnekleyen öğeleri seçip düzenleyerek toplama sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及通过选择和整理例证其他作品具体化的单件而进行收藏的一个家族的责任的一种作品关联起来。"]},"ToolkitLabel":{"ca":"família col·leccionista de","cs":"sběratel (rodina) (čeho)","de":"Familie als Sammlerin/Sammler von","en":"collector family of","es":"familia recolectora de","fi":"muodostaja (suku) kokoelmalle","fr":"famille collectionneuse de","hu":"összegyűjtő családja a következő:","nl":"verzamelaar-familie van","tr":"koleksiyoncu aile","zh-Hans-CN":"……的收藏者家族"},"ToolkitDefinition":{"ca":"Una obra que implica una responsabilit