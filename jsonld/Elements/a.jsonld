                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50449", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToPerformanceOf.en", "label":"is contributor agent to performance of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/animatorAgentOf.en","See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50192", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistAgentOf.en", "label":"is artist agent of"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50738", "lexicalAlias":"http://rdaregistry.info/Elements/a/animatorCollectiveAgentOf.en", "label":"is animator collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50587", "lexicalAlias":"http://rdaregistry.info/Elements/a/animatorPersonOf.en", "label":"is animator person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50136", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/animatorAgentOf.en", "label":"is animator agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50136", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/animatorAgentOf.en", "label":"is animator agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50738","label":{"ar":"هو وكيل جماعي فنان رسوم متحركة لـ","ca":"és agent col·lectiu animador de","cs":"je animátorem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er animator af","de":"ist gemeinschaftlicher Akteur als Trickfilmzeichnerin/Trickfilmzeichner von","de":"ist gemeinschaftlicher Akteur als Trickfilmzeichnerin/Trickfilmzeichner von","el":"είναι [σχεδιαστής] κινουμένων σχεδίων συλλογικός φορέας του","en":"is animator collective agent of","es":"es agente colectivo animador de","et":"animaator (kollektiiv) väljenduses","fi":"animaattori (yhteistoimija) ekspressiossa","fr":"est un agent collectif animateur de","hu":"animátor kollektív ágense a következőnek:","it":"è animatore agente collettivo di","lv":"ir animators (grupa)","nl":"is animator-collectieve actor van","no":"er animatør for (kollektiv agent)","tr":"animatör kolektif temsilcisidir","zh-Hans-CN":"是……的动画师集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في جعل كائنات أو رسومات جامدة تتحرك حركة واضحة."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu donant l’aparença de moviment a objectes o dibuixos inanimats."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že dodává zdání pohybu neživým předmětům nebo kresbám."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at give en illusion af bevægelse til livløse objekter eller tegninger."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of giving apparent movement to inanimate objects or drawings."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de dar movimiento aparente a objetos o dibujos inanimados."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, pannes näiliselt liikuma elutud esemed või joonistused."],"fi":["Liittää yhteistoimijan ekspressioon, jonka tekemisessä yhteistoimija on osallisena tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à donner l’illusion du mouvement à des objets inanimés ou à des dessins."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését élettelen tárgyak vagy rajzok látszólagos mozgatásában."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nel dare movimento apparente a oggetti inanimati o disegni."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, pieškirot šķietamu kustību nekustīgiem objektiem vai zīmējumiem."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door het geven van schijnbare beweging aan levenloze objecten of tekeningen."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å gi tilsynelatende bevegelse til tegninger eller figurer."],"tr":["Kolektif bir temsilciyi, bir kolektif temsilcinin cansız nesnelere veya çizimlere görsel hareket sağlama katkısını içeren anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括一个集体行为者对给予无生命对象或绘画以貌似运动之贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فنان رسوم متحركة","ca":"agent col·lectiu animador de","cs":"animátor (kolektivní agent) (čeho)","da":"kollektiv agent, som er animator af","de":"Gemeinschaftlicher Akteur als Trickfilmzeichnerin/Trickfilmzeichner von","de":"Gemeinschaftlicher Akteur als Trickfilmzeichnerin/Trickfilmzeichner von","el":"[σχεδιαστής] κινουμένων σχεδίων συλλογικός φορέας του","en":"animator collective agent of","es":"agente colectivo animador de","et":"animaator (kollektiiv) väljenduses","fi":"animaattori (yhteistoimija) ekspressiossa","fr":"agent collectif animateur de","hu":"animátor kollektív ágense:","it":"animatore agente collettivo di","lv":"ir animators (grupa)","nl":"animator-collectieve actor van","no":"animatør for (kollektiv agent)","tr":"animatör kolektif temsilcisi","zh-Hans-CN":"……的动画师集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في جعل كائنات أو رسومات جامدة تتحرك حركة واضحة.","ca":"Expressió que inclou una contribució d’un agent col·lectiu donant l’aparença de moviment a objectes o dibuixos inanimats.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že dodává zdání pohybu neživým předmětům nebo kresbám.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at give en illusion af bevægelse til livløse objekter eller tegninger.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","en":"An expression that includes a contribution by a collective agent of giving apparent movement to inanimate objects or drawings.","es":"Una expresión que incluye una contribución de un agente colectivo de dar movimiento aparente a objetos o dibujos inanimados.","et":"Väljendus, millesse kollektiiv on andnud panuse, pannes näiliselt liikuma elutud esemed või joonistused.","fi":"Ekspressio, jonka tekemisessä yhteistoimija on osallisena tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à donner l’illusion du mouvement à des objets inanimés ou à des dessins.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését élettelen tárgyak vagy rajzok látszólagos mozgatásában.","it":"Espressione che comprende un contributo di un agente collettivo nel dare movimento apparente a oggetti inanimati o disegni.","lv":"Izteiksme, kas ietver grupas ieguldījumu, pieškirot šķietamu kustību nekustīgiem objektiem vai zīmējumiem.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door het geven van schijnbare beweging aan levenloze objecten of tekeningen.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å gi tilsynelatende bevegelse til tegninger eller figurer.","tr":"Cansız nesnelere veya çizimlere görünür hareket sağlanmasında kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括一个集体行为者对给予无生命对象或绘画以貌似运动之贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
