                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/modifierPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50314", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfPerson.en", "label":"has related item of person"},{"@id":"http://rdaregistry.info/Elements/a/P50446", "lexicalAlias":"http://rdaregistry.info/Elements/a/modifierAgentOf.en", "label":"is modifier agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50129", "lexicalAlias":"http://rdaregistry.info/Elements/a/autographerOf.en", "label":"is autographer of"},{"@id":"http://rdaregistry.info/Elements/a/P50125", "lexicalAlias":"http://rdaregistry.info/Elements/a/inscriberOf.en", "label":"is inscriber of"},{"@id":"http://rdaregistry.info/Elements/a/P50128", "lexicalAlias":"http://rdaregistry.info/Elements/a/annotatorOf.en", "label":"is annotator of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50636", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/modifierPersonOf.en", "label":"is modifier person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50636", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/modifierPersonOf.en", "label":"is modifier person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50096","label":{"ar":"له صاحب عمل","ca":"té com a ocupador","cs":"má zaměstnavatele","da":"har arbejdsgiver","de":"hat Arbeitgeberin/Arbeitgeber","de":"hat Arbeitgeberin/Arbeitgeber","el":"έχει εργοδότη","en":"has employer","es":"tiene empleador","et":"tööandja","fi":"työnantaja","fr":"a pour employeur","hu":"munkaadója a következő:","it":"ha come datore di lavoro","lv":"darba devējs","nl":"heeft werkgever","no":"har arbeidsgiver","tr":"işveren ile ilişkilidir","zh-Hans-CN":"有雇主"},"definition":{"ar":["يربط شخصا بهيئة توظف شخصًا."],"ca":["Relaciona una persona amb una entitat corporativa que dona treball a una persona."],"cs":["Vztahuje osobu ke korporaci, která zaměstnává osobu."],"da":["Relaterer en person til en korporation, som beskæftiger en person."],"de":["Setzt eine Person in Beziehung zu einer Körperschaft, die eine Person beschäftigt.,Setzt eine Person in Beziehung zu einer Körperschaft, die eine Person beschäftigt."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα συλλογικό όργανο, το οποίο απασχολεί ένα φυσικό πρόσωπο ως εργοδότης."],"en":["Relates a person to a corporate body who employs a person."],"es":["Relaciona una persona con un organismo corporativo que emplea a una persona."],"et":["Seostab isiku asutusega, kes on isiku tööle palganud."],"fi":["Liittää henkilön yhteisöön, joka työllistää henkilön."],"fr":["Met une personne en relation avec une collectivité qui emploie une personne."],"hu":["Hozzákapcsol egy személyt egy testülethez, amely egy személyt alkalmaz."],"it":["Correla una persona a un ente che impiega una persona."],"lv":["Sasaista personu ar institūciju, kur persona strādā."],"nl":["Relateert een persoon aan een corporatie die een persoon in dienst heeft."],"no":["Relaterer en person til en korporasjon der en person er ansatt."],"tr":["Bir kişiyi istihdam eden bir tüzel kişilikle ilişkilendirir."],"zh-Hans-CN":["将一个个人与雇用一个个人的一个团体关联起来。"]},"ToolkitLabel":{"ar":"صاحب عمل","ca":"ocupador","cs":"zaměstnavatel","da":"arbejdsgiver","de":"Arbeitgeberin/Arbeitgeber","de":"Arbeitgeberin/Arbeitgeber","el":"εργοδότης","en":"employer","es":"empleador","et":"tööandja","fi":"työnantaja","fr":"employeur","hu":"munkaadó:","it":"datore di lavoro","lv":"darba devējs","nl":"werkgever","no":"arbeidsgiver","tr":"işveren","zh-Hans-CN":"雇主"},"ToolkitDefinition":{"ar":"هيئة توظف شخصًا.","ca":"Entitat corporativa que dona treball a una persona.","cs":"Korporace, která zaměstnává osobu.","da":"Korporation, som beskæftiger en person.","de":"Eine Körperschaft, die eine Person beschäftigt.","de":"Eine Körperschaft, die eine Person beschäftigt.","el":"Ένα συλλογικό όργανο το οποίο απασχολεί ένα φυσικό πρόσωπο ως εργοδότης.","en":"A corporate body who employs a person.","es":"Un organismo corporativo que emplea a una persona.","et":"Asutus, kes on isiku tööle palganud.","fi":"Yhteisö, joka työllistää henkilön.","fr":"Collectivité qui emploie une personne.","hu":"Egy testület, amely egy személyt alkalmaz.","it":"Ente che impiega una persona.","lv":"Institūcija, kur persona strādā.","nl":"Een corporatie die een persoon in dienst heeft.","no":"En korporasjon der en person er ansatt.","tr":"Bir kişiyi istihdam eden bir tüzel kişilik","zh-Hans-CN":"雇用一个个人的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/employer.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50095", "lexicalAlias":"http://rdaregistry.info/Elements/a/personMemberOfCorporateBodyOf.en", "label":"is person member of corporate body of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50096", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/employer.en", "label":"has employer"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50096", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/employer.en", "label":"has employer"}]},{"@id":"http://rdaregistry.info/Elements/a/P50277","label":{"ar":"له زميل عمل","ca":"té com a col·laborador","cs":"má spolupracovníka","da":"har arbejdskollega","de":"hat Arbeitskollegin/Arbeitskollegen","de":"hat Arbeitskollegin/Arbeitskollegen","el":"έχει συνεργάτη","en":"has coworker","es":"tiene compañero de trabajo","et":"kaastöötaja","fi":"työtoveri","fr":"a pour collègue de travail","hu":"munkatársa a következő:","it":"ha come collaboratore agente di","lv":"līdzstrādnieks","nl":"heeft naaste collega","no":"har medarbeider","tr":"iş arkadaşı ile ilişkilidir","zh-Hans-CN":"有共事者"},"definition":{"ar":["يربط شخصا بشخص هو زميل يعمل مع شخص آخر أو يشاركه مهمة."],"ca":["Relaciona una persona amb una persona que és un col·lega que treballa en una tasca o la comparteix amb una altra persona."],"cs":["Vztahuje osobu k osobě, která je kolegou, který pracuje nebo sdílí pracovní úkoly s jinou osobou."],"da":["Relaterer en person til en person, der er en kollega, som arbejder sammen med, eller deler en opgave med, en anden person."],"de":["Setzt eine Person in Beziehung zu einer Kollegin/einem Kollegen (Person), die/der mit einer anderen Person zusammenarbeitet oder mit ihr eine Aufgabe teilt.,Setzt eine Person in Beziehung zu einer Kollegin/einem Kollegen (Person), die/der mit einer anderen Person zusammenarbeitet oder mit ihr eine Aufgabe teilt."],"el":["Συνδέει ένα φυσικό πρόσωπο με έναν συνάδελφο που συνεργάζεται ή μοιράζεται μια εργασία με ένα άλλο φυσικό πρόσωπο."],"en":["Relates a person to a person who is a colleague who works with or shares a task with another person."],"es":["Relaciona una persona con una persona que es un colega que trabaja o comparte una tarea con una persona."],"et":["Seostab isiku kolleegiga, kes töötab koos teise isikuga või jagab temaga tööülesannet."],"fi":["Liittää henkilön henkilöön, joka on kollega, joka työskentelee tai jakaa tehtävän toisen henkilön kanssa."],"fr":["Met une personne en relation avec une personne qui est un collègue travaillant ou partageant une tâche avec une autre personne."],"hu":["Hozzákapcsol egy személyt egy kolléga személyhez, aki egy másik személlyel együtt dolgozik vagy egy feladatot oszt meg vele."],"it":["Correla una persona a un collega che lavora con o condivide un compito con un'altra persona."],"lv":["Sasaista personu ar personu, kurš ir kolēģis, kurš strādā vai piedalās uzdevuma izpildē kopā ar citu personu."],"nl":["Relateert een persoon aan een persoon die is een collega die samenwerkt met of een taak deelt met een andere persoon."],"no":["Relaterer en person til en kollega som samarbeider eller deler en oppgave med en annen person."],"tr":["Bir kişiyi, başka bir kişiyle birlikte çalışan veya bir görevi paylaşan bir meslektaş olan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一个个人与作为同事与另一个个人一起工作或分担一个任务的一个个人关联起来。"]},"ToolkitLabel":{"ar":"له زميل عمل","ca":"col·laborador","cs":"spolupracovník","da":"arbejdskollega","de":"Arbeitskollegin/Arbeitskollege","de":"Arbeitskollegin/Arbeitskollege","el":"συνεργάτης","en":"coworker","es":"compañero de trabajo","et":"kaastöötaja","fi":"työtoveri","fr":"collègue de travail","hu":"munkatárs:","it":"collaboratore","lv":"līdzstrādnieks","nl":"naaste collega","no":"medarbeider","tr":"iş arkadaşı","zh-Hans-CN":"共事者"},"ToolkitDefinition":{"ar":"زميل يعمل مع شخص آخر أو يشاركه مهمة.","ca":"Persona que és un col·lega que treballa en una tasca o la comparteix amb una altra persona.","cs":"Osoba, která je kolegou, který pracuje nebo sdílí pracovní úkoly s jinou osobou.","da":"Person, der er en kollega, som arbejder sammen med, eller deler en opgave med, en anden person.","de":"Eine Kollegin/Ein Kollege (Person), die/der mit einer anderen Person zusammenarbeitet oder mit ihr eine Aufgabe teilt.","de":"Eine Kollegin/Ein Kollege (Person), die/der mit einer anderen Person zusammenarbeitet oder mit ihr eine Aufgabe teilt.","el":"Ένας συνάδελφος που συνεργάζεται ή μοιράζεται μια εργασία με ένα άλλο φυσικό πρόσωπο.","en":"A person who is a colleague who works with or shares a task with another person.","es":"Una persona que es un colega que trabaja o comparte una tarea con una persona.","et":"Kolleeg, kes töötab koos teise isikuga või jagab temaga tööülesannet.","fi":"Henkilö, joka on kollega, joka työskentelee tai jakaa tehtävän toisen henkilön kanssa.","fr":"Personne qui est un collègue travaillant ou partageant une tâche avec une autre personne.","hu":"Egy kolléga személy, aki egy másik személlyel együtt dolgozik vagy egy feladatot oszt meg vele.","it":"Collega che lavora con o condivide un compito con un'altra persona.","lv":"Kolēģis, kurš strādā vai piedalās uzdevuma izpildē kopā ar citu personu.","nl":"Een persoon die is een collega die samenwerkt met of een taak deelt met een andere persoon.","no":"En kollega som samarbeider eller deler en oppgave med en annen person.","tr":"Başka bir kişiyle birlikte çalışan veya bir görevi paylaşan bir meslektaş olan kişi.","zh-Hans-CN":"作为同事与另一个个人一起工作或分担一个任务的一个个人"},"altLabel":{"ar":["زميل عمل"],"da":["medarbejder"],"de":["Arbeitskollege"],"el":["συνεργάτης"],"en":["co-worker"],"es":["compañero de trabajo"],"fi":["-"],"hu":["munkatárs:"],"it":["collaboratore"],"nl":["naaste collega"],"tr":["iş arkadaşı"],"zh-Hans-CN":["共事者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/coworker.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50274", "lexicalAlias":"http://rdaregistry.info/Elements/a/colleague.en", "label":"has colleague"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50277", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/coworker.en", "label":"has coworker"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50277", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/coworker.en", "label":"has coworker"}]},{"@id":"http://rdaregistry.info/Elements/a/P50143","label":{"ar":"هو وكيل مدير موسيقي لـ","ca":"és agent director musical de","cs":"je muzikálovým režisérem (agentem) (čeho)","da":"er agent, som er musikdirektør af","de":"ist Akteur als Musikalische Leiterin/Musikalischer Leiter von","de":"ist Akteur als Musikalische Leiterin/Musikalischer Leiter von","el":"είναι μουσικός διευθυντής φορέας του","en":"is musical director agent of","es":"es agente director musical de","et":"muusikajuht (tegija) väljenduses","fi":"musiikillinen johtaja (toimija) ekspressiossa","fr":"est un agent directeur musical de","hu":"zenei rendező ágense a következőnek:","it":"è direttore musicale agente di","lv":"ir muzikālais vadītājs (aģents)","nl":"is muzikaal director-actor van","no":"er musikalregissør for (agent)","tr":"müzik yönetmeni temsilcisidir","zh-Hans-CN":"是……的音乐总监行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في تنسيق أنشطة الملحنين؛ ومحرري الصوت؛ ومازجي الصوت لإنتاج فيلم؛ أو لعرض موسيقي أو درامي أو ترفيهي."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller i underholdning."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonarbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonarbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου συντονίζοντας τις ενέργειες των συνθετών, των επιμελητών ήχου και των ηχοληπτών για μια παραγωγή κινητής εικόνας ή για μια μουσική ή δραματική παράσταση ή άλλη ψυχαγωγία, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage van een actor in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å koordinere aktivitetene til komponister, lydteknikere og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning."],"tr":["Bir temsilciyi, hareketli bir görüntü üretimi veya müzikal veya dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مدير موسيقي","ca":"agent director musical de","cs":"muzikálový režisér (agent) (čeho)","da":"agent, som er musikdirektør af","de":"Akteur als Musikalische Leiterin/Musikalischer Leiter von","de":"Akteur als Musikalische Leiterin/Musikalischer Leiter von","el":"μουσικός διευθυντής φορέας του","en":"musical director agent of","es":"agente director musical de","et":"muusikajuht (tegija) väljenduses","fi":"musiikillinen johtaja","fr":"agent directeur musical de","hu":"zenei rendező ágense:","it":"direttore musicale agente di","lv":"ir muzikālais vadītājs (aģents)","nl":"muzikaal director-actor van","no":"musikalregissør for (agent)","tr":"müzikal yönetmeni temsilcisi","zh-Hans-CN":"……的音乐总监行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في تنسيق أنشطة الملحنين؛ ومحرري الصوت؛ ومازجي الصوت لإنتاج فيلم؛ أو لعرض موسيقي أو درامي أو ترفيهي.","ca":"Expressió que inclou una contribució d’un agent en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Udtryk, som omfatter en agents bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller i underholdning.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά του συντονισμού των ενεργειών των συνθετών, των επιμελητών ήχου και των ηχοληπτών για μια παραγωγή κινητής εικόνας ή για μια μουσική ή δραματική παράσταση ή άλλη ψυχαγωγία.","en":"An expression that includes a contribution by an agent of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Una expresión que incluye una contribución de un agente de coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática.","et":"Väljendus, millesse tegija on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban.","it":"Espressione che include un contributo da parte di un agente nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē.","nl":"Een expressie die omvat een bijdrage van een actor in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å koordinere aktivitetene til komponister, lydteknikere og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning.","tr":"Hareketli bir görüntü prodüksiyonu veya müzikal ya da dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["مدير موسيقي"],"ca":["director musical de"],"cs":["muzikálový režisér (čeho)"],"da":["musikdirektør af"],"de":["Musikalischer Leiter von,Musikalischer Leiter von"],"el":["μουσικός διευθυντής του"],"en":["musical director of"],"es":["director musical de"],"et":["muusikajuht väljenduses"],"fi":["musiikinjohtajana musiikkiesityksessä"],"fr":["directeur musical de"],"hu":["zenei rendezője:"],"it":["direttore musicale di"],"nl":["muzikaal director van"],"no":["musikalregissør for"],"tr":["müzikal yönetmeni"],"zh-Hans-CN":["……的音乐总监"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50449", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToPerformanceOf.en", "label":"is contributor agent to performance of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50727", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorCollectiveAgentOf.en", "label":"is musical director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50576", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorPersonOf.en", "label":"is musical director person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50143", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/musicalDirectorAgentOf.en", "label":"is musical director agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50143", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/musicalDirectorAgentOf.en", "label":"is musical director agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50727","label":{"ar":"هو وكيل جماعي قائد فرقة عزف لـ","ca":"és agent col·lectiu director musical de","cs":"je muzikálovým režisérem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er musikdirektør af","de":"ist gemeinschaftlicher Akteur als musikalische Leiterin/musikalischer Leiter von","de":"ist gemeinschaftlicher Akteur als musikalische Leiterin/musikalischer Leiter von","el":"είναι μουσικός διευθυντής συλλογικός φορέας του","en":"is musical director collective agent of","es":"es agente colectivo director musical de","et":"muusikajuht (kollektiiv) väljenduses","fi":"musiikillinen johtaja (yhteistoimija) ekspressiossa","fr":"est un agent collectif directeur musical de","hu":"zenei rendező kollektív ágense a következőnek:","it":"è direttore musicale agente collettivo di","lv":"ir muzikālais vadītājs (grupa)","nl":"is muzikaal director-collectieve actor van","no":"er musikalregissør for (kollektiv agent)","tr":"müzik yönetmeni kolektif temsilcisidir","zh-Hans-CN":"是……的音乐总监集体行为者"},"definition":{"ar":["تربط وكيل جماعي بتعبيرة تتضمن إسهام وكيل جماعي في تنسيق أنشطة الملحنين؛ ومحرري الصوت؛ ومازجي الصوت لإنتاج صور متحركة، أو لعرض موسيقي، أو درامي، أو ترفيهي."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller underholdning."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo para coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación musical o dramática o entretenimiento."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää yhteistoimijan ekspressioon, jonka tekemisessä yhteistoimija on osallisena koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage van een collectieve actor in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av koordinasjon av aktivitetene til komponist, lydtekniker og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning."],"tr":["Kolektif bir temsilciyi, hareketli bir görüntü üretimi veya müzikal veya dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden kolektif bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هو وكيل جماعي قائد فرقة عزف لـ","ca":"agent col·lectiu director musical de","cs":"muzikálový režisér (kolektivní agent) (čeho)","da":"kollektiv agent, som er musikdirektør af","de":"ist gemeinschaftlicher Akteur als musikalische Leiterin/musikalischer Leiter von","de":"ist gemeinschaftlicher Akteur als musikalische Leiterin/musikalischer Leiter von","el":"μουσικός διευθυντής συλλογικός φορέας του","en":"musical director collective agent of","es":"agente colectivo director musical de","et":"muusikajuht (kollektiiv) väljenduses","fi":"musiikillinen johtaja (yhteistoimija) ekspressiossa","fr":"agent collectif directeur musical de","hu":"zenei rendező kollektív ágense:","it":"direttore musicale agente collettivo di","lv":"ir muzikālais vadītājs (grupa)","nl":"muzikaal director-collectieve actor van","no":"musikalregissør for (kollektiv agent)","tr":"müzikal yönetmeni kolektif temsilcisi","zh-Hans-CN":"……的音乐总监集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي بتنسيق أنشطة الملحنين؛ ومحرري الصوت؛ ومازجي الصوت لإنتاج صور متحركة، أو لعرض موسيقي أو درامي أو ترفيهي.","ca":"Expressió que inclou una contribució d’un agent col·lectiu en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller underholdning.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","en":"An expression that includes a contribution by a collective agent of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Una expresión que incluye una contribución de un agente colectivo para coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación musical o dramática o entretenimiento.","et":"Väljendus, millesse kollektiiv on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Ekspressio, jonka tekemisessä yhteistoimija on osallisena koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban.","it":"Espressione che comprende un contributo di un agente collettivo nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico.","lv":"Izteiksme, kas ietver grupas ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē.","nl":"Een expressie die omvat een bijdrage van een collectieve actor in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av koordinasjon av aktivitetene til komponist, lydtekniker og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning.","tr":"Hareketli bir görüntü üretimi veya müzikal veya dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个集体行为者的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50774", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCollectiveAgentToPerformanceOf.en", "label":"is contributor collective agent to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50143", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorAgentOf.en", "label":"is musical director agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50878", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorCorporateBodyOf.en", "label":"is musical director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51029", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorFamilyOf.en", "label":"is musical director family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50727", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/musicalDirectorCollectiveAgentOf.en", "label":"is musical director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50727", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/musicalDirectorCollectiveAgentOf.en", "label":"is musical director collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50878","label":{"ar":"هي هيئة مسئولة عن الإدارة الموسيقية لـ","ca":"és entitat corporativa directora musical de","cs":"je muzikálovým režisérem (korporací) (čeho)","da":"er korporation, som er musikdirektør af","de":"ist Körperschaft als Musikalische Leiterin/Musikalischer Leiter von","de":"ist Körperschaft als Musikalische Leiterin/Musikalischer Leiter von","el":"είναι μουσικός διευθυντής συλλογικό όργανο του","en":"is musical director corporate body of","es":"es organismo corporativo director musical de","et":"muusikajuht (asutus) väljenduses","fi":"musiikillinen johtaja (yhteisö) ekspressiossa","fr":"est une collectivité directrice musicale de","hu":"zenei rendező testülete a következőnek:","it":"è direttore musicale ente di","lv":"ir muzikālais vadītājs (institūcija)","nl":"is muzikaal director-corporatie van","no":"er musikalregissør for (korporasjon)","tr":"müzik yönetmeni tüzel kişisidir","zh-Hans-CN":"是……的音乐总监团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة بتنسيق أنشطة الملحنين؛ ومحرري الصوت؛ ومازجي الصوت لإنتاج صور متحركة؛ أو لعرض موسيقي أو درامي أو ترفيهي."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje korporaci k vyjádření, což zahrnuje přispění korporace tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller underholdning."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää yhteisön ekspressioon, jonka tekemisessä yhteisö on osallisena koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage van een corporatie in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av koordinasjon av aktivitetene til komponist, lydtekniker og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning."],"tr":["Bir tüzel kişiyi, hareketli bir görüntü üretimi veya müzikal veya dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة مديرة موسيقية","ca":"entitat corporativa directora musical de","cs":"muzikálový režisér (korporace) (čeho)","da":"korporation, som er musikdirektør af","de":"Körperschaft als Musikalische Leiterin/Musikalischer Leiter von","de":"Körperschaft als Musikalische Leiterin/Musikalischer Leiter von","el":"μουσικός διευθυντής συλλογικό όργανο του","en":"musical director corporate body of","es":"organismo corporativo director musical de","et":"muusikajuht (asutus) väljenduses","fi":"musiikillinen johtaja (yhteisö) ekspressiossa","fr":"collectivité directrice musicale de","hu":"zenei rendező testülete a következőnek:","it":"direttore musicale ente di","lv":"ir muzikālais vadītājs (institūcija)","nl":"muzikaal director-corporatie van","no":"musikalregissør for (korporasjon)","tr":"müzikal direktörü tüzel kişisi","zh-Hans-CN":"……的音乐总监团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة في تنسيق أنشطة الملحنين؛ ومحرري الصوت؛ ومازجي الصوت لإنتاج صور متحركة؛ أو لعرض موسيقي أو درامي أو ترفيهي.","ca":"Expressió que inclou una contribució d’una entitat corporativa en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic.","cs":"Vyjádření, což zahrnuje přispění korporace tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Udtryk, som omfatter en korporations bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller underholdning.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","en":"An expression that includes a contribution by a corporate body of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Una expresión que incluye una contribución de un organismo corporativo de coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática.","et":"Väljendus, millesse asutus on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Ekspressio, jonka tekemisessä yhteisö on osallisena koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban.","it":"Espressione che comprende un contributo di un ente per coordinare le attività di compositori, tecnici del suono e specialisti del missaggio nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē.","nl":"Een expressie die omvat een bijdrage van een corporatie in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av koordinasjon av aktivitetene til komponist, lydtekniker og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning.","tr":"Hareketli bir görüntü üretimi veya müzikal veya dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个团体的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50925", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCorporateBodyToPerformanceOf.en", "label":"is contributor corporate body to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50727", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicalDirectorCollectiveAgentOf.en", "label":"is musical director collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50878", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/musicalDirectorCorporateBodyOf.en", "label":"is musical director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50878", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/musicalDirectorCorporateBodyOf.en", "label":"is musical director corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51029","label":{"ar":"هي عائلة مسئولة عن الإدارة الموسيقية لـ","ca":"és família directora musical de","cs":"je muzikálovým režisérem (rodinou) (čeho)","da":"er familie, som er musikdirektør af","de":"ist Familie als Musikalische Leiterin/Musikalischer Leiter von","de":"ist Familie als Musikalische Leiterin/Musikalischer Leiter von","el":"είναι μουσικός διευθυντής οικογένεια του","en":"is musical director family of","es":"es familia directora musical de","et":"muusikajuht (perekond) väljenduses","fi":"musiikillinen johtaja (suku) ekspressiossa","fr":"est une famille directrice musicale de","hu":"zenei rendező családja a következőnek:","it":"è direttore musicale famiglia di","lv":"ir muzikālais vadītājs (dzimta/ģimene)","nl":"is muzikaal director-familie van","no":"er musikalregissør for (familie)","tr":"müzik yönetmeni ailesidir","zh-Hans-CN":"是……的音乐总监家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في تنسيق أنشطة الملحنين؛ ومحرري الصوت؛ و مازجي الصوت لإنتاج صور متحركة؛ أو لعرض موسيقي أو درامي أو ترفيهي."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller underholdning."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert."],"en":["Relates a family to an expression that includes a contribution by a family of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää suvun ekspressioon, jonka tekemisessä suku on osallisena koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage van een familie in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av koordinasjon av aktivitetene til komponist, lydtekniker og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning."],"tr":["Bir aileyi, hareketli bir görüntü prodüksiyonu veya müzikal ya da dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden bir ailenin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة مديرة للموسيقى","ca":"família directora musical de","cs":"muzikálový režisér (rodina) (čeho)","da":"familie, som er musikdirektør af","de":"Familie als Musikalische Leiterin/Musikalischer Leiter von","de":"Familie als Musikalische Leiterin/Musikalischer Leiter von","el":"μουσικός διευθυντής οικογένεια του","en":"musical director family of","es":"familia directora musical de","et":"muusikajuht (perekond) väljenduses","fi":"musiikillinen johtaja (suku) ekspressiossa","fr":"famille directrice musicale de","hu":"zenei rendező családja:","it":"direttore musicale famiglia di","lv":"ir muzikālais vadītājs (dzimta/ģimene)","nl":"muzikaal director-familie van","no":"musikalregissør for (familie)","tr":"müzikal direktörü ailesi","zh-Hans-CN":"……的音乐总监家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في تنسيق أنشطة الملحنين؛ ومحرري الصوت؛ و مازجي الصوت لإنتاج صور متحركة؛ أو لعرض موسيقي أو درامي أو ترفيهي.","ca":"Expressió que inclou una contribució d’una família en la coordinació de les activitats de compositors, editors de so i mescladors de so en el cas d’una producció d’imatge en moviment o d’una representació o un espectacle musical o dramàtic.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že koordinuje činnost skladatelů, editorů zvuku a mixérů zvuku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Udtryk, som omfatter en families bidrag ved at koordinere komponister, tonemestre og lydmixeres aktiviteter til en levende billedproduktion eller en musikalsk eller dramatisk præsentation eller underholdning.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie die Arbeit der Komponistin/des Komponisten, der Tonbearbeiterin/des Tonbearbeiters und der Tonmeisterin/des Tonmeisters für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung koordiniert.","en":"An expression that includes a contribution by a family of coordinating the activities of composers, sound editors, and sound mixers for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Una expresión que incluye una contribución de una familia de coordinar las actividades de compositores, editores de sonido y mezcladores de sonido para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática.","et":"Väljendus, millesse perekond on andnud panuse, koordineerides heliloojate, helimonteerijate ja helimiksijate tegevust filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Ekspressio, jonka tekemisessä suku on osallisena koordinoimalla säveltäjien, äänileikkaajien ja äänimiksaajien toimintaa elokuvatuotannossa tai musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à coordonner les activités des compositeurs, des monteurs son et des mixeurs de son pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését zeneszerzők, hangszerkesztők és hangkeverők feladatainak összehangolásában mozgókép-produkcióban, zenei vagy drámai előadásban vagy szórakoztató műsorban.","it":"Espressione che comprende un contributo di una famiglia nel coordinamento delle attività di compositori, curatori del suono e addetti al missaggio per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, koordinējot komponista, skaņu redaktora un skaņas miksētāja kustīga attēla izveidi, mūzikāla vai dramatiska darba prezentācijā vai izklaidē.","nl":"Een expressie die omvat een bijdrage van een familie in het coördineren van de activiteiten van componisten, geluidseditors en geluidsmixers voor een bewegend beeld-productie of in een muziek- of dramapresentatie of vermaak.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av koordinasjon av aktivitetene til komponist, lydtekniker og lydmiksere for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller annen form for underholdning.","tr":"Hareketli bir görüntü prodüksiyonu veya müzikal ya da dramatik bir sunum veya eğlence için bestecilerin, ses editörlerinin ve ses mikserlerinin faaliyetlerini koordine eden bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为动态图像制作或者为音乐或戏剧呈现或娱乐协调作曲者、音响编辑、音响师活动的一个家族的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
