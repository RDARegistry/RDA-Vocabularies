                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/mixingEngineerCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50746", "lexicalAlias":"http://rdaregistry.info/Elements/a/audioEngineerCollectiveAgentOf.en", "label":"is audio engineer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50297", "lexicalAlias":"http://rdaregistry.info/Elements/a/mixingEngineerAgentOf.en", "label":"is mixing engineer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50899", "lexicalAlias":"http://rdaregistry.info/Elements/a/mixingEngineerCorporateBodyOf.en", "label":"is mixing engineer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51050", "lexicalAlias":"http://rdaregistry.info/Elements/a/mixingEngineerFamilyOf.en", "label":"is mixing engineer family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50748", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/mixingEngineerCollectiveAgentOf.en", "label":"is mixing engineer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50748", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/mixingEngineerCollectiveAgentOf.en", "label":"is mixing engineer collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50899","label":{"ar":"هي هيئة مهندسة للمكساج لـ","ca":"és entitat corporativa enginyera de remescla de","cs":"je mixážním technikem (korporací) (čeho)","da":"er korporation, som er mixingtekniker af","de":"ist Körperschaft als Mischtontechnikerin/Mischtontechniker von","de":"ist Körperschaft als Mischtontechnikerin/Mischtontechniker von","el":"είναι μηχανικός μείξης συλλογικό όργανο του","en":"is mixing engineer corporate body of","es":"es organismo corporativo ingeniero de mezcla de","et":"miksimisinsener (asutus) väljenduses","fi":"miksaaja (yhteisö) ekspressiossa","fr":"est une collectivité mixeuse de son de","hu":"hangkeverő testülete a következőnek:","it":"è ingegnere del missaggio ente di","lv":"ir skaņu miksētājs (institūcija)","nl":"is mixtechnicus-corporaties van","no":"er miksetekniker for (korporasjon)","tr":"ses miksaj mühendisi tüzel kişisidir","zh-Hans-CN":"是……的合成工程师团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة في معالجة المسارات المتعددة لتسجيل صوتي ومزجها وتجميعها."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa en la manipulació, la mescla i el muntatge de les diverses pistes d’un enregistrament àudio."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace manipulací, mixáží a sestavením více stop zvukové nahrávky."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at manipulere, mixe og samle de forskellige lydspor på en optagelse."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of manipulating, mixing and assembling the multiple tracks of an audio recording."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de manipular, mezclar y ensamblar las múltiples pistas de una grabación de audio."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, töödeldes, miksides ja monteerides mitmerealise salvestise heliradasid."],"fi":["Liittää yhteisön ekspressioon, jossa yhteisö on osallisena ekspression äänisisällön tekemisessä käsittelemällä, miksaamalla ja yhdistelemällä useampia äänitteen raitoja."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à manipuler, à mixer et à assembler les différentes pistes d’un enregistrement audio."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését egy hangfelvétel sávjainak manipulálásában, keverésében és összeállításában."],"it":["Correla un'espressione che include un contributo di un ente nella manipolazione, missaggio e assemblaggio delle tracce multiple di una registrazione audio."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, miksējot un montējot audio ieraksta vairākus celiņus."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door manipuleren, mixen en samenstellen van meerdere sporen van een geluidsopname."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å manipulere, mikse og sette sammen de ulike sporene i et lydopptak."],"tr":["Bir tüzel kişiyi, bir ses kaydının birden çok izini manipüle etme, karıştırma ve birleştirme konusunda bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括操纵、合成和聚集一个录音的多个音轨的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة مهندسة للمكساج","ca":"entitat corporativa enginyera de remescla de","cs":"mixážní technik (korporace) (čeho)","da":"korporation, som er mixingtekniker af","de":"Körperschaft als Mischtontechnikerin/Mischtontechniker von","de":"Körperschaft als Mischtontechnikerin/Mischtontechniker von","el":"μηχανικός μείξης συλλογικό όργανο του","en":"mixing engineer corporate body of","es":"organismo corporativo ingeniero de mezcla de","et":"miksimisinsener (asutus) väljenduses","fi":"miksaaja (yhteisö) ekspressiossa","fr":"collectivité mixeuse de son de","hu":"hangkeverő testülete:","it":"ingegnere del missaggio ente di","lv":"ir skaņu miksētājs (institūcija)","nl":"mixtechnicus-corporaties van","no":"miksetekniker for (korporasjon)","tr":"Ses mühendisi tüzel kişisi","zh-Hans-CN":"……的合成工程师团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة في معالجة المسارات المتعددة لتسجيل صوتي ومزجها وتجميعها.","ca":"Expressió que inclou una contribució d’una entitat corporativa en la manipulació, la mescla i el muntatge de les diverses pistes d’un enregistrament àudio.","cs":"Vyjádření, které zahrnuje přispění korporace manipulací, mixáží a sestavením více stop zvukové nahrávky.","da":"Udtryk, som omfatter en korporations bidrag ved at manipulere, mixe og samle de forskellige lydspor på en optagelse.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie mehrere Tonspuren einer Aufnahme bearbeitet, mischt und zusammenlegt.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie mehrere Tonspuren einer Aufnahme bearbeitet, mischt und zusammenlegt.","en":"An expression that includes a contribution by a corporate body of manipulating, mixing and assembling the multiple tracks of an audio recording.","es":"Una expresión que incluye una contribución de un organismo corporativo de manipular, mezclar y ensamblar las múltiples pistas de una grabación de audio.","et":"Väljendus, millesse asutus on andnud panuse, töödeldes, miksides ja monteerides mitmerealise salvestise heliradasid.","fi":"Ekspressio, jossa yhteisö on osallisena ekspression äänisisällön tekemisessä käsittelemällä, miksaamalla ja yhdistelemällä useampia äänitteen raitoja.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à manipuler, à mixer et à assembler les différentes pistes d’un enregistrement audio.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését egy hangfelvétel sávjainak manipulálásában, keverésében és összeállításában.","it":"Espressione che include un contributo di un ente nella manipolazione, missaggio e assemblaggio delle tracce multiple di una registrazione audio.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, miksējot un montējot audio ieraksta vairākus celiņus.","nl":"Een expressie die omvat een bijdrage door een corporatie door manipuleren, mixen en samenstellen van meerdere sporen van een geluidsopname.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å manipulere, mikse og sette sammen de ulike sporene i et lydopptak.","tr":"Bir ses kaydının birden fazla parçasını manipüle eden, karıştıran ve birleştiren tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括操纵、合成和聚集一个录音的多个音轨的一个团体的贡献的一种内容表达"},"note":{"ar":["تُستبعد أنشطة إعادة المزج التي تُحدث تغييرا جوهريا في طبيعة العمل الأصلي ومحتواه، إلى حد ينتج معه عمل جديد."],"ca":["S’exclouen les activitats de remescla que canvien substancialment la natura i el contingut de l’obra original, que donen com a resultat una obra nova."],"cs":["Remixování, které podstatně mění povahu a obsah původního díla, a vede k vytvoření nového díla, je vyloučeno."],"da":["Remixing-aktiviteter, som væsentligt forandrer originalressourcens karakter og indhold og derved resulterer i en nyt ressource, samt mixing og sammensætning af de forskellige spor på en optagelse, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die die Art und den Inhalt des Originalwerks substantiell verändern, so dass ein neues Werk entsteht, sowie das Mischen und Zusammenlegen von mehreren Einzelspuren einer Aufnahme.,Darunter fallen keine Nachbearbeitungen, die die Art und den Inhalt des Originalwerks substantiell verändern, so dass ein neues Werk entsteht."],"el":["Δεν περιλαμβάνονται οι διαδικασίες μείξης, οι οποίες μεταβάλλουν ουσιαστικά τη φύση και το περιεχόμενο του αρχικού έργου καταλήγοντας σε ένα νέο έργο και η μείξη και η ομαδοποίηση πολλαπλών κομματιών μιας ηχογράφησης."],"en":["Remixing activities that substantially change the nature and content of the original work, resulting in a new work, are excluded."],"es":["Actividades de remix que cambian sustancialmente la naturaleza y contenido de la obra original, resultando en una nueva obra, se excluyen."],"et":["Ei hõlma remiksimist, mis muudab oluliselt originaalteose olemust ja sisu, nii et tekib uus teos, ega mitmerealise salvestise heliradade miksimist ja monteerimist."],"fi":["Ei koske uudelleenmiksauksia, jotka olennaisesti muuttavat alkuperäisen teoksen luonnetta ja sisältöä, mikä johtaa uuteen teokseen."],"fr":["Sont exclues les activités de remixage qui changent considérablement la nature et le contenu de l’œuvre originale et entraînent la création d’une nouvelle œuvre."],"hu":["Nem tartoznak ide azok az új forrást eredményező újrakeverési tevékenységek, amelyek jelentősen megváltoztatják az eredeti forrás jellegét és tartalmát, sem a felvétel több sávjának keverése és összeállítása."],"it":["Sono escluse attività di remix che modificano sostanzialmente la natura e il contenuto della risorsa originale dando luogo a una nuova risorsa e il missaggio e assemblaggio delle tracce multiple di una registrazione."],"lv":["Neietver remiksēšanas darbību, kas maina sākotnējā darba būtību un saturu, kā rezultātā tiek radīts jauns darbs, kā arī neietver vairāku ieraksta celiņu miksēšanu un montēšanu."],"nl":["Remixhandelingen die de aard en content van de oorspronkelijke resource substantieel wijzigen, resulterend in een nieuwe resource, en mixen en samenstellen van meerdere sporen van een opname zijn uitgesloten."],"no":["Remiksaktiviteter som i betydelig grad endrer originalverkets særpreg og innhold og som resulterer i et nytt verk, er ikke inkludert."],"tr":["Orijinal eserin niteliğini ve içeriğini önemli ölçüde değiştirerek, yeni bir eser ortaya çıkaran remiks faaliyetleri hariçtir."],"zh-Hans-CN":["不包括实质性改变原作品的性质和内容导致一种新的作品的合成活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
