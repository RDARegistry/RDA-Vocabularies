                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50842", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistCorporateBodyOf.en", "label":"is artist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50687", "lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherCollectiveAgentOf.en", "label":"is calligrapher collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50838", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/calligrapherCorporateBodyOf.en", "label":"is calligrapher corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50838", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/calligrapherCorporateBodyOf.en", "label":"is calligrapher corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50989","label":{"ar":"هي عائلة مسئولة عن الخطاطة","ca":"és família cal·lígrafa de","cs":"je kaligrafem (rodinou) (čeho)","da":"er familie, som er kalligraf af","de":"ist Familie als Kalligrafin/Kalligraf von","de":"ist Familie als Kalligrafin/Kalligraf von","el":"είναι καλλιγράφος οικογένεια του","en":"is calligrapher family of","es":"es familia calígrafa de","et":"kalligraaf (perekond) teoses","fi":"kalligrafi (suku) teoksessa","fr":"est une famille calligraphe de","hu":"kalligráfus családja a következőnek:","it":"è calligrafo famiglia di","lv":"ir kaligrāfs (dzimta/ģimene)","nl":"is kalligraaf-familie van","no":"er kalligraf for (familie)","tr":"kaligraf ailesidir","zh-Hans-CN":"是……的书法者家族"},"definition":{"ar":["يربط عائلة بعمل ينطوي على مسئولية عائلة عن الخطاطة، حيث ينصب الاهتمام على القيمة الجمالية لفن الخط أو الرسم، بغض النظر عما إذا كانت هذه العائلة مسئولة أيضًا عن النص المكتوب."],"ca":["Relaciona una família amb una obra que implica una responsabilitat d’una família en la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa família és també responsable del text inscrit."],"cs":["Vztahuje rodinu k dílu, které zahrnuje odpovědnost rodiny za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tentýž agent je také odpovědný za napsaný text."],"da":["Relaterer en familie til et værk, som involverer en families ansvar for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme familie også har forfattet den indskrevne tekst."],"de":["Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.,Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist."],"en":["Relates a family to a work that involves a responsibility of a family for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same family is also responsible for the inscribed text."],"es":["Relaciona una familia con una obra que involucra una responsabilidad de una familia por caligrafía donde el foco de interés yace en el valor estético de la caligrafía o habilidad artística gráfica, sin importar si la misma familia también es responsable por el texto inscrito."],"et":["Seostab perekonna teosega, mis sisaldab perekonna vastutust ilukirja eest. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama perekond on vastutav ka kirjutatud teksti eest."],"fi":["Liittää suvun teokseen, jossa suku on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une famille en relation avec une œuvre qui comporte une responsabilité de la part d’une famille en ce qui concerne la calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même famille soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyhez hozzátartozik egy család szépírással kapcsolatos felelőssége, ahol az érdeklődés középpontjában a kézírás esztétikai értéke vagy a grafika művészisége áll, tekintet nélkül arra, hogy ugyanaz a család a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla una famiglia a un'opera che implica una responsabilità di una famiglia per la calligrafia dove l'interesse risiede nel valore estetico della scrittura o della perizia grafica, a prescindere che la stessa famiglia sia responsabile anche del testo scritto."],"lv":["Sasaista dzimtu/ģimeni ar darbu, kas ietver dzimtas/ģimenes atbildību par kaligrāfiju, kurā galvenā uzmanība tiek pievērsta mākslinieciskās vai grafiskās meistarības estētiskajai vērtībai, neatkarīgi no tā, vai tā pati grupa ir atbildīgs arī par uzrakstīto tekstu."],"nl":["Relateert een familie aan een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde familie ook verantwoordelijk is voor de inscriptie."],"no":["Relaterer en familie til et verk som involverer et ansvar for en familie i form av kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme familieen også er ansvarlig for tekstinnholdet."],"tr":["Bir aileyi, aynı ailenin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının el yazısının veya grafik sanatının estetik değerinde yattığı hat sanatı için bir ailenin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个家族的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عائلة مسئولة عن الخطاطة لـ","ca":"família cal·lígrafa de","cs":"kaligraf (rodina) (čeho)","da":"familie, som er kalligraf af","de":"Familie als Kalligrafin/Kalligraf von","de":"Familie als Kalligrafin/Kalligraf von","el":"καλλιγράφος οικογένεια του","en":"calligrapher family of","es":"familia calígrafa de","et":"kalligraaf (perekond) teoses","fi":"kalligrafi (suku) teoksessa","fr":"famille calligraphe de","hu":"kalligráfus családja:","it":"calligrafo famiglia di","lv":"ir kaligrāfs (dzimta/ģimene)","nl":"kalligraaf-familie van","no":"kalligraf for (familie)","tr":"kaligraf ailesi","zh-Hans-CN":"……的书法者家族"},"ToolkitDefinition":{"ar":"عمل ينطوي على مسئولية عائلة عن الخطاطة حيث ينصب الاهتمام على القيمة الجمالية لفن الخط أو الرسم، بغض النظر عما إذا كان هذا الشخص مسئول أيضًا عن النص المكتوب.","ca":"Obra que implica una responsabilitat d’una família en la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa família és també responsable del text inscrit.","cs":"Dílo, které zahrnuje odpovědnost rodiny za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tentýž agent je také odpovědný za napsaný text.","da":"Værk, som involverer en families ansvar for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme familie også har forfattet den indskrevne tekst.","de":"Ein Werk, bei dem eine Familie für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.","de":"Ein Werk, bei dem eine Familie für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.","en":"A work that involves a responsibility of a family for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same family is also responsible for the inscribed text.","es":"Una obra que involucra una responsabilidad de una familia por caligrafía donde el foco de interés yace en el valor estético de la caligrafía o habilidad artística gráfica, sin importar si la misma familia también es responsable por el texto inscrito.","et":"Teos, mis sisaldab perekonna vastutust ilukirja eest. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama perekond on vastutav ka kirjutatud teksti eest.","fi":"Teos, jossa suku on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä.","fr":"Œuvre qui comporte une responsabilité de la part d’une famille en ce qui concerne la calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même famille soit aussi responsable du texte calligraphié.","hu":"Egy mű, amelyhez hozzátartozik egy család szépírással kapcsolatos felelőssége, ahol az érdeklődés középpontjában a kézírás esztétikai értéke vagy a grafika művészisége áll, tekintet nélkül arra, hogy ugyanaz a család a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Correla una famiglia a un'opera che implica una responsabilità di una famiglia per la calligrafia dove l'interesse risiede nel valore estetico della scrittura o della perizia grafica, a prescindere che la stessa famiglia sia responsabile anche del testo scritto.","lv":"Darbs, kas ietver dzimtas/ģimenes atbildību par kaligrāfiju, kurā galvenā uzmanība tiek pievērsta mākslinieciskās vai grafiskās meistarības estētiskajai vērtībai, neatkarīgi no tā, vai tā pati grupa ir atbildīgs arī par uzrakstīto tekstu","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde familie ook verantwoordelijk is voor de inscriptie.","no":"Et verk som involverer et ansvar for en familie i form av kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme familieen også er ansvarlig for tekstinnholdet.","tr":"Yazılı metinden aynı ailenin sorumlu olup olmadığına bakılmaksızın, ilgi odağı hattatlığın veya grafik sanatının estetik değerinde olan hat sanatı için bir ailenin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个家族的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50993", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistFamilyOf.en", "label":"is artist family of"},{"@id":"http://rdaregistry.info/Elements/a/P50687", "lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherCollectiveAgentOf.en", "label":"is calligrapher collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50989", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/calligrapherFamilyOf.en", "label":"is calligrapher family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50989", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/calligrapherFamilyOf.en", "label":"is calligrapher family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50536","label":{"ar":"هو شخص خطاط لـ","ca":"és persona cal·lígrafa de","cs":"je kaligrafem (osobou) (čeho)","da":"er person, som er kalligraf af","de":"ist Person als Kalligrafin/Kalligraf von","de":"ist Person als Kalligrafin/Kalligraf von","el":"είναι καλλιγράφος φυσικό πρόσωπο του","en":"is calligrapher person of","es":"es calígrafo de","et":"kalligraaf (isik) teoses","fi":"kalligrafi (henkilö) teoksessa","fr":"est une personne calligraphe de","hu":"kalligráfus személye a következőnek:","it":"è calligrafo persona di","lv":"ir kaligrāfs (persona)","nl":"is kalligraaf-persoon van","no":"er kalligraf for (person)","tr":"kaligraf kişisidir","zh-Hans-CN":"是……的书法者个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن الخطاطة، حيث ينصب الاهتمام على القيمة الجمالية لفن الخط أو الرسم، بغض النظر عن مسئولية هذا الوكيل أيضًا عن النص المكتوب."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa persona és també responsable del text inscrit."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž osoba je také odpovědná za napsaný text."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same person is also responsible for the inscribed text."],"es":["Relaciona a una persona con una obra que implique una responsabilidad de una persona por la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de si la misma persona también es responsable del texto inscrito."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust ilukirja eest. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama isik on vastutav ka kirjutatud teksti eest."],"fi":["Liittää henkilön teokseen, jossa toimija on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne en ce qui concerne la calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même personne soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy szépírással kapcsolatos felelőssége, ahol az érdeklődés középpontjában a kézírás esztétikai értéke vagy a grafika művészisége áll, tekintet nélkül arra, hogy ugyanaz a személy a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona nella calligrafia dove l'interesse risiede nel valore estetico della scrittura o della perizia grafica, a prescindere che la stessa persona sia responsabile anche del testo scritto."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par kaligrāfiju, kurā galvenā uzmanība tiek pievērsta mākslinieciskās vai grafiskās meistarības estētiskajai vērtībai, neatkarīgi no tā, vai tā pati grupa ir atbildīgs arī par uzrakstīto tekstu."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde persoon ook verantwoordelijk is voor de inscriptie."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme personen også er ansvarlig for tekstinnholdet."],"tr":["Bir kişiyi, aynı kişinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlığın veya grafik sanatının estetik değerinde olduğu hat sanatı için bir kişinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一个人是否负责题写文字）的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص خطاط","ca":"persona cal·lígrafa de","cs":"kaligraf (osoba) (čeho)","da":"person, som er kalligraf af","de":"Person als Kalligrafin/Kalligraf von","de":"Person als Kalligrafin/Kalligraf von","el":"καλλιγράφος φυσικό πρόσωπο του","en":"calligrapher person of","es":"calígrafo de","et":"kalligraaf (isik) teoses","fi":"kalligrafi (henkilö) teoksessa","fr":"personne calligraphe de","hu":"kalligráfus személye:","it":"calligrafo persona di","lv":"ir kaligrāfs (persona)","nl":"kalligraaf-persoon van","no":"kalligraf for (person)","tr":"kaligraf","zh-Hans-CN":"……的书法者个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن الخطاطة، حيث ينصب الاهتمام على القيمة الجمالية لفن الخط أو الرسم، عن مسئولية هذا الوكيل أيضًا عن النص المكتوب.","ca":"Obra que implica una responsabilitat d’una persona en la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa persona és també responsable del text inscrit.","cs":"Dílo, které zahrnuje odpovědnost osoby za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž osoba je také odpovědná za napsaný text.","da":"Værk, som involverer en persons ansvar for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.","de":"Ein Werk, bei dem eine Person für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.","de":"Ein Werk, bei dem eine Person für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.","en":"A work that involves a responsibility of a person for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same person is also responsible for the inscribed text.","es":"Una obra que implique una responsabilidad de una persona por la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de si la misma persona también es responsable del texto inscrito.","et":"Teos, mis sisaldab isiku vastutust ilukirja eest. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama isik on vastutav ka kirjutatud teksti eest.","fi":"Teos, jossa toimija on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne en ce qui concerne la calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même personne soit aussi responsable du texte calligraphié.","hu":"Egy mű, amelyhez hozzátartozik egy személy szépírással kapcsolatos felelőssége, ahol az érdeklődés középpontjában a kézírás esztétikai értéke vagy a grafika művészisége áll, tekintet nélkül arra, hogy ugyanaz a személy a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Opera che implica una responsabilità di una persona nella calligrafia dove il focus dell'interesse risiede nel valore estetico della scrittura o della perizia grafica, a prescindere che la stessa persona sia responsabile anche del testo scritto.","lv":"Darbs, kas ietver personas atbildību par kaligrāfiju, kurā galvenā uzmanība tiek pievērsta mākslinieciskās vai grafiskās meistarības estētiskajai vērtībai, neatkarīgi no tā, vai tā pati grupa ir atbildīgs arī par uzrakstīto tekstu","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde persoon ook verantwoordelijk is voor de inscriptie.","no":"Et verk som involverer et ansvar for en person i form av kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme personen også er ansvarlig for tekstinnholdet.","tr":"Yazılı metinden aynı kişinin sorumlu olup olmadığına bakılmaksızın, ilgi odağı hattatlığın veya grafik sanatının estetik değerinde olan hat sanatı için bir kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一个人是否负责题写文字）的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50540", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistPersonOf.en", "label":"is artist person of"},{"@id":"http://rdaregistry.info/Elements/a/P50246", "lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherAgentOf.en", "label":"is calligrapher agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50536", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/calligrapherPersonOf.en", "label":"is calligrapher person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50536", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/calligrapherPersonOf.en", "label":"is calligrapher person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50186","label":{"ar":"هو وكيل رسام خرائط لعمل لـ","ca":"és agent cartògraf d’una obra de","cs":"je kartografem (agentem) (čeho)","da":"er agent, som er kartograf for værk af","de":"ist Akteur als Kartografin/Kartograf eines Werks von","de":"ist Akteur als Kartografin/Kartograf eines Werks von","el":"είναι χαρτογράφος φορέας του έργου του","en":"is cartographer agent of work of","es":"es agente cartógrafo de obra de","et":"teose kartograaf (tegija) teoses","fi":"teoksen kartantekijä (toimija) teoksessa","fr":"est un agent cartographe d’une œuvre de","hu":"térképész ágense a következő műnek:","it":"è cartografo agente di","lv":"ir kartogrāfs (aģents) darbam","nl":"is cartograaf-actor van werk van","no":"er kartograf for (agent)","tr":"eserinin kartograf temsilcisidir","zh-Hans-CN":"是……的作品的地图绘制者行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن أعمال رسم الخرائط."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la creació d’una obra cartogràfica."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za vytvoření kartografického díla."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at skabe et kartografisk værk."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung eines kartografischen Werks verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung eines kartografischen Werks verantwortlich ist."],"el":["Συνδέει έναν φορέα υπεύθυνο για τη δημιουργία ενός χάρτη, ενός άτλαντα, μιας υδρόγειας σφαίρας ή άλλου χαρτογραφικού έργου, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for creating a cartographic work."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de crear una obra cartográfica."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust kartograafilise teose eest."],"fi":["Liittää toimijan teokseen, joka on kartografinen teos, jonka luomisesta toimija on vastuussa."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à créer une œuvre cartographique."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy kartográfiai mű létrehozásáért."],"it":["Correla un agente a un'opera che implica una responsabilità di un agente per un'opera cartografica."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par karti, atlantu, globusu vai citu kartogrāfijas materiālu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het creëren van een cartografisch werk."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av et kartografisk verk."],"tr":["Bir temsilciyi, kartografik bir eser oluşturmaya ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及创作一种地图作品的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل رسام خرائط لعمل","ca":"agent cartògraf d’una obra de","cs":"kartograf (agent) (čeho)","da":"agent, som er kartograf for værk af","de":"Akteur als Kartografin/Kartograf eines Werks von","de":"Akteur als Kartografin/Kartograf eines Werks von","el":"χαρτογράφος φορέας του έργου του","en":"cartographer agent of work of","es":"agente cartógrafo de obra de","et":"teose kartograaf (tegija) teoses","fi":"teoksen kartantekijä (toimija) teoksessa","fr":"agent cartographe d’une œuvre de","hu":"térképész ágense a következő műnek:","it":"cartografo agente di opera di","lv":"ir kartogrāfs (aģents) darbam","nl":"cartograaf-actor van werk van","no":"kartograf for (agent)","tr":"eserin kartograf temsilcisi","zh-Hans-CN":"……的作品的地图绘制者行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن أعمال رسم الخرائط.","ca":"Obra que implica una responsabilitat d’un agent en la creació d’una obra cartogràfica.","cs":"Dílo, které zahrnuje odpovědnost agenta za vytvoření kartografického díla.","da":"Værk, som involverer en agents ansvar for at skabe et kartografisk værk.","de":"Ein Werk, bei dem ein Akteur für die Schaffung eines kartografischen Werks verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für die Schaffung eines kartografischen Werks verantwortlich ist.","el":"Ένα χαρτογραφικό έργο που περιλαμβάνει την ευθύνη της δημιουργίας ενός χάρτη, ενός άτλαντα, μιας υδρόγειας σφαίρας ή άλλου χαρτογραφικού έργου.","en":"A work that involves a responsibility of an agent for creating a cartographic work.","es":"Una obra que involucra una responsabilidad de un agente de crear una obra cartográfica.","et":"Teos, mis sisaldab tegija vastutust kartograafilise teose eest.","fi":"Teos, joka on kartografinen teos, jonka luomisesta toimija on vastuussa.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à créer une œuvre cartographique.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy kartográfiai mű létrehozásáért.","it":"Opera che implica una responsabilità di un agente per un'opera cartografica.","lv":"Darbs, kas ietver aģenta atbildību par karti, atlantu, globusu vai citu kartogrāfijas materiālu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het creëren van een cartografisch werk.","no":"Et verk som involverer ansvar for en agent i form av et kartografisk verk.","tr":"Kartografik bir eser oluşturmak için bir temsilcinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及创作一种地图作品的一个行为者的责任的一种作品"},"altLabel":{"ar":["رسام خرائط لـ"],"ca":["cartògraf de"],"cs":["kartograf (čeho)"],"da":["kartograf af"],"de":["Kartografin/Kartograf von,Kartografin/Kartograf von"],"el":["χαρτογράφος του έργου του"],"en":["cartographer of"],"es":["cartógrafo de"],"et":["teose kartograaf teoses"],"fi":["kartantekijänä kartografisessa teoksessa"],"fr":["cartographe de"],"hu":["térképésze:"],"it":["cartografo di opera di"],"nl":["cartograaf van"],"no":["kartograf for"],"tr":["kartograf"],"zh-Hans-CN":["……的地图绘制者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50204", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfWorkOf.en", "label":"is creator agent of work of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerAgentOfWorkOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50676", "lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerCollectiveAgentOfWorkOf.en", "label":"is cartographer collective agent of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50525", "lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerPersonOfWorkOf.en", "label":"is cartographer person of work of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50186", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/cartographerAgentOfWorkOf.en", "label":"is cartographer agent of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50186", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/cartographerAgentOfWorkOf.en", "label":"is cartographer agent of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50676","label":{"ar":"هو وكيل جماعي رسام خرائط لعمل لـ","ca":"és agent col·lectiu cartògraf d’una obra de","cs":"je kartografem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er kartograf for værk af","de":"ist gemeinschaftlicher Akteur als Kartografin/Kartograf eines Werks von","de":"ist gemeinschaftlicher Akteur als Kartografin/Kartograf eines Werks von","el":"είναι χαρτογράφος συλλογικός φορέας του έργου του","en":"is cartographer collective agent of work of","es":"es agente colectivo de obras cartográficas de","et":"teose kartograaf (kollektiiv) teoses","fi":"teoksen kartantekijä (yhteistoimija) teoksessa","fr":"est un agent collectif cartographe d’une œuvre de","hu":"térképész kollektív ágense a következő műnek:","it":"è cartografo agente collettivo di opera di","lv":"ir kartogrāfs (grupa) darbam","nl":"is cartograaf-collectieve actor van werk van","no":"er kartograf for verk for (kollektiv agent)","tr":"eserinin kartograf kolektif temsilcisidir","zh-Hans-CN":"是……的作品的地图绘制者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن أعمال رسم الخرائط."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la creació d’una obra cartogràfica."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za vytvoření kartografického díla."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at skabe et kartografisk værk."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines kartografischen Werks verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines kartografischen Werks verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for creating a cartographic work."],"es":["Relaciona un agente colectivo con una obra que implica una responsabilidad de un agente colectivo por crear una obra cartográfica."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust kartograafilise teose eest."],"fi":["Liittää yhteistoimijan teokseen, joka on kartografinen teos, jonka luomisesta yhteistoimija on vastuussa."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à créer une œuvre cartographique."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy kartográfiai mű létrehozásáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per un'opera cartografica."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par karti, atlantu, globusu vai citu kartogrāfijas materiālu."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het creëren van een cartografisch werk."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av et kartografisk verk."],"tr":["Kolektif bir temsilciyi, bir kartografik eseri oluşturmak için kolektif bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及创作一种地图作品的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي رسام خرائط لعمل","ca":"agent col·lectiu cartògraf d’una obra de","cs":"kartograf (kolektivní agent) (čeho)","da":"kollektiv agent, som er kartograf for værk af","de":"Gemeinschaftlicher Akteur als Kartografin/Kartograf eines Werks von","de":"Gemeinschaftlicher Akteur als Kartografin/Kartograf eines Werks von","el":"χαρτογράφος συλλογικός φορέας του έργου του","en":"cartographer collective agent of work of","es":"agente colectivo de obras cartográficas de","et":"teose kartograaf (kollektiiv) teoses","fi":"teoksen kartantekijä (yhteistoimija) teoksessa","fr":"agent collectif cartographe d’une œuvre de","hu":"térképész kollektív ágense a következő műnek:","it":"cartografo agente collettivo di opera di","lv":"ir kartogrāfs (grupa) darbam","nl":"cartograaf-collectieve actor van werk van","no":"kartograf for verk for (kollektiv agent)","tr":"eserin kartograf kolektif temsilcisi","zh-Hans-CN":"……的作品的地图绘制者集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن أعمال رسم الخرائط.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en la creació d’una obra cartogràfica.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za vytvoření kartografického díla.","da":"Værk, som involverer en kollektiv agents ansvar for at skabe et kartografisk værk.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines kartografischen Werks verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines kartografischen Werks verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for creating a cartographic work.","es":"Una obra que implica una responsabilidad de un agente colectivo por crear una obra cartográfica.","et":"Teos, mis sisaldab kollektiivi vastutust kartograafilise teose eest.","fi":"Teos, joka on kartografinen teos, jonka luomisesta yhteistoimija on vastuussa.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à créer une œuvre cartographique.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége egy kartográfiai mű létrehozásáért.","it":"Opera che implica una responsabilità di un agente collettivo per un'opera cartografica.","lv":"Darbs, kas ietver grupas atbildību par karti, atlantu, globusu vai citu kartogrāfijas materiālu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het creëren van een cartografisch werk.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av et kartografisk verk.","tr":"Kartografik bir eser oluşturmak için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及创作一种地图作品的一个集体行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
