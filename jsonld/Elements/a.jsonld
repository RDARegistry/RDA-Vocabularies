                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerPersonOfWorkOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50186", "lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerAgentOfWorkOf.en", "label":"is cartographer agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50525", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/cartographerPersonOfWorkOf.en", "label":"is cartographer person of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50525", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/cartographerPersonOfWorkOf.en", "label":"is cartographer person of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50174","label":{"ar":"هو وكيل عامل صب لـ","ca":"és agent emmotllador de","cs":"je litcem (agentem) (čeho)","da":"er agent, som er støber af","de":"ist Akteur als Formgießerin/Formgießer von","de":"ist Akteur als Formgießerin/Formgießer von","el":"είναι αναδευτήρας φορέας του","en":"is caster agent of","es":"es agente fundidor de","et":"valaja (tegija) kehastuses","fi":"valaja (toimija) manifestaatiossa","fr":"est un agent fondeur de","hu":"öntvénykészítő ágense a következőnek:","it":"è fonditore agente di","lv":"ir atliešanas meistars (aģents)","nl":"is gieter-actor van","no":"er støper av (agent)","tr":"dökümcü temsilcisidir","zh-Hans-CN":"是……的铸造者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل لصب مادة سائلة أو منصهرة في قالب وتركها للتصلب لأخذ شكل القالب."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent en l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za nalití kapalné nebo roztavené látky do formy, aby po ztuhnutí nabyla tvaru formy."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist."],"el":["Συνδέει έναν φορέα, ο οποίος εμπλέκεται στην κατασκευή μιας εκδήλωσης μέσω της έκχυσης υγρής ή τηγμένης ουσίας αφήνοντάς την να στερεοποιηθεί για να πάρει το σχήμα του καλουπιού, με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold."],"es":["Relaciona un agente con una manifestación que involucra la responsabilidad de un agente para vaciar un líquido o sustancia fundida en un molde y dejar que se solidifique para que tome la forma del molde."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust vedela või sulatatud materjali valuvormi valamise ja valuvormi kuju võtmiseks tahkuda laskmise eest."],"fi":["Liittää toimijan manifestaatioon, jonka valmistamisesta toimija on vastuussa muovaamalla sulatettua tai nestemäistä ainetta muotin avulla."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent consistant à verser un liquide ou une substance fondue dans un moule et à laisser ce liquide ou cette substance se solidifier pour prendre la forme du moule."],"hu":["Hozzákapcsol egy ágenst egy megjelenési formához, amelyhez hozzátartozik egy ágens felelőssége folyékony vagy olvasztott anyag öntőformába öntéséért, hogy az ott megszilárduljon és fölvegye az öntőforma formáját."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente nel versare un liquido o sostanza fusa in uno stampo e lasciarlo solidificare per assumere la forma dello stampo."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par šķidruma vai izkausētas vielas ieliešanu veidnē un atstāšanu sacietēt, lai tā saglabātu formu."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het gieten van een vloeistof of gesmolten substantie in een mal en het laten stollen om de vorm van de mal aan te laten nemen."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av å å helle et flytende eller smeltet stoff i en støpeform og la det stivne i denne formen."],"tr":["Bir temsilciyi, sıvı veya erimiş bir maddenin bir kalıba dökülmesi ve kalıbın şeklini alması için katılaşmaya bırakılması ile görevli temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及将液体或融化的物质倒入模具中使其按模具固化成型的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل عامل صب","ca":"agent emmotllador de","cs":"litec (agent) (čeho)","da":"agent, som er støber af","de":"Akteur als Formgießerin/Formgießer von","de":"Akteur als Formgießerin/Formgießer von","el":"αναδευτήρας φορέας του","en":"caster agent of","es":"agente fundidor de","et":"valaja (tegija) kehastuses","fi":"valaja (toimija) manifestaatiossa","fr":"agent fondeur de","hu":"öntvénykészítő ágense:","it":"fonditore agente di","lv":"ir atliešanas meistars (aģents)","nl":"gieter-actor van","no":"støper av (agent)","tr":"dökümcü temsilcisi","zh-Hans-CN":"……的铸造者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن صب مادة سائلة أو منصهرة في قالب وتركها للتصلب لأخذ شكل القالب.","ca":"Manifestació que implica una responsabilitat d’un agent en l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle.","cs":"Provedení, které zahrnuje odpovědnost agenta za nalití kapalné nebo roztavené látky do formy, aby po ztuhnutí nabyla tvaru formy.","da":"Manifestation, som involverer en agents ansvar for at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen.","de":"Eine Manifestation, bei der ein Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.","de":"Eine Manifestation, bei der ein Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.","el":"Μια εκδήλωση που κατασκευάζεται από έναν φορέα υπεύθυνο για την έκχυση υγρής ή τηγμένης ουσίας και τη στερεοποίησή της μέχρι να πάρει το σχήμα του καλουπιού.","en":"A manifestation that involves a responsibility of an agent for pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold.","es":"Una manifestación que involucra la responsabilidad de un agente para vaciar un líquido o sustancia fundida en un molde y dejar que se solidifique para que tome la forma del molde.","et":"Kehastus, mis sisaldab tegija vastutust vedela või sulatatud materjali valuvormi valamise ja valuvormi kuju võtmiseks tahkuda laskmise eest.","fi":"Manifestaatio, jonka valmistamisesta toimija on vastuussa muovaamalla sulatettua tai nestemäistä ainetta muotin avulla.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent consistant à verser un liquide ou une substance fondue dans un moule et à laisser ce liquide ou cette substance se solidifier pour prendre la forme du moule.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy ágens felelőssége folyékony vagy olvasztott anyag öntőformába öntéséért, hogy az ott megszilárduljon és fölvegye az öntőforma formáját.","it":"Manifestazione che implica la responsabilità di un agente nel versare un liquido o sostanza fusa in uno stampo e lasciarlo solidificare per assumere la forma dello stampo.","lv":"Manifestācija, kas ietver aģenta atbildību par šķidruma vai izkausētas vielas ieliešanu veidnē un atstāšanu sacietēt, lai tā saglabātu formu.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het gieten van een vloeistof of gesmolten substantie in een mal en het laten stollen om de vorm van de mal aan te laten nemen.","no":"En manifestasjon som involverer ansvar for en agent i form av å å helle et flytende eller smeltet stoff i en støpeform og la det stivne i denne formen.","tr":"Sıvı veya erimiş bir maddenin bir kalıba dökülmesi ve kalıbın şeklini alması için katılaşmaya bırakılması ile görevli temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及将液体或融化的物质倒入模具中使其按模具固化成型的一个行为者的责任的一种载体表现"},"altLabel":{"ar":["عامل صب"],"ca":["emmotllador de"],"cs":["litec (čeho)"],"da":["støber af"],"de":["Formgießer von,Formgießer von"],"el":["αναδευτήρας του"],"en":["caster of"],"es":["fundidor de"],"et":["valaja kehastuses"],"fi":["valajana valoksessa"],"fr":["fondeur de"],"hu":["öntvénykészítője:"],"it":["fonditore di"],"nl":["gieter van"],"no":["støper av"],"tr":["dökümcü"],"zh-Hans-CN":["……的铸造者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/casterAgentOf.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50477", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfManifestationOf.en", "label":"is creator agent of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50653", "lexicalAlias":"http://rdaregistry.info/Elements/a/casterCollectiveAgentOf.en", "label":"is caster collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50502", "lexicalAlias":"http://rdaregistry.info/Elements/a/casterPersonOf.en", "label":"is caster person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50174", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/casterAgentOf.en", "label":"is caster agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50174", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/casterAgentOf.en", "label":"is caster agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50653","label":{"ar":"هو وكيل جماعى عامل صب لـ","ca":"és agent col·lectiu emmotllador de","cs":"je litcem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er støber af","de":"ist gemeinschaftlicher Akteur als Formgießerin/Formgießer von","de":"ist gemeinschaftlicher Akteur als Formgießerin/Formgießer von","el":"είναι χυτευτής συλλογικός φορέας του","en":"is caster collective agent of","es":"es el agente colectivo lanzador de","et":"valaja (kollektiiv) kehastuses","fi":"valaja (yhteistoimija) manifestaatiossa","fr":"est un agent collectif fondeur de","hu":"öntvénykészítő kollektív ágense a következőnek:","it":"è fonditore agente collettivo di","lv":"ir atliešanas meistars (grupa)","nl":"is gieter-collectieve actor van","no":"er støper av (kollektiv agent)","tr":"dökümcü kolektif temsilcisidir","zh-Hans-CN":"是……的铸造者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن صب مادة سائلة أو مذابة في قالب وتركه ليتصلب ليأخذ شكل القالب."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost kolektivního agenta za nalití kapalné nebo roztavené látky do formy, aby po ztuhnutí nabyla tvaru formy."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold."],"es":["Relaciona un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de verter un líquido o sustancia fundida en un molde y dejarlo solidificar para tomar la forma del molde."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust vedela või sulatatud materjali valuvormi valamise ja valuvormi kuju võtmiseks tahkuda laskmise eest."],"fi":["Liittää yhteistoimijan manifestaatioon, jonka valmistamisesta yhteistoimija on vastuussa muovaamalla sulatettua tai nestemäistä ainetta muotin avulla."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à verser un liquide ou une substance fondue dans un moule et à laisser ce liquide ou cette substance se solidifier pour prendre la forme du moule."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége folyékony vagy olvasztott anyag öntőformába öntéséért, hogy az ott megszilárduljon és fölvegye az öntőforma formáját."],"it":["Correla un agente collettivo a una manifestazione che implica una responsabilità di un agente collettivo nel versare un liquido o sostanza fusa in uno stampo e lasciarlo solidificare per assumere la forma dello stampo."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par šķidruma vai izkausētas vielas ieliešanu veidnē un atstāšanu sacietēt, lai tā saglabātu formu."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het gieten van een vloeistof of gesmolten substantie in een mal en het laten stollen om de vorm van de mal aan te laten nemen."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av framstilling av trykt tekst, nedskrevet musikk eller annet innhold fra typer eller plater."],"tr":["Kolektif bir temsilciyi, sıvı veya erimiş bir maddeyi bir kalıba dökme ve kalıbın şeklini alması için katılaşmaya bırakma sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及将液体或融化的物质倒入模具中使其按模具固化成型的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعى عامل صب","ca":"agent col·lectiu emmotllador de","cs":"litec (kolektivní agent) (čeho)","da":"kollektiv agent, som er støber af","de":"Gemeinschaftlicher Akteur als Formgießerin/Formgießer von","de":"Gemeinschaftlicher Akteur als Formgießerin/Formgießer von","el":"χυτευτής συλλογικός φορέας του","en":"caster collective agent of","es":"agente colectivo lanzador de","et":"valaja (kollektiiv) kehastuses","fi":"valaja (yhteistoimija) manifestaatiossa","fr":"agent collectif fondeur de","hu":"öntvénykészítő kollektív ágense:","it":"fonditore agente collettivo di","lv":"ir atliešanas meistars (grupa)","nl":"gieter-collectieve actor van","no":"støper av (kollektiv agent)","tr":"dökümcü kolektif temsilcisi","zh-Hans-CN":"……的铸造者集体行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل جماعي عن صب مادة سائلة أو مذابة في قالب وتركه ليتصلب ليأخذ شكل القالب.","ca":"Manifestació que implica una responsabilitat d’un agent col·lectiu en l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle.","cs":"Provedení, které zahrnuje odpovědnost kolektivního agenta za nalití kapalné nebo roztavené látky do formy, aby po ztuhnutí nabyla tvaru formy.","da":"Manifestation, som involverer en kollektiv agents ansvar for at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur dafür verantwortlich ist, eine Flüssigkeit oder eine geschmolzene Substanz in eine Form zu gießen, die in der Gießform verbleibt, bis sie ausgehärtet ist.","en":"A manifestation that involves a responsibility of a collective agent for pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold.","es":"Una manifestación que implica la responsabilidad de un agente colectivo de verter un líquido o sustancia fundida en un molde y dejarlo solidificar para tomar la forma del molde.","et":"Kehastus, mis sisaldab kollektiivi vastutust vedela või sulatatud materjali valuvormi valamise ja valuvormi kuju võtmiseks tahkuda laskmise eest.","fi":"Manifestaatio, jonka valmistamisesta yhteistoimija on vastuussa muovaamalla sulatettua tai nestemäistä ainetta muotin avulla.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à verser un liquide ou une substance fondue dans un moule et à laisser ce liquide ou cette substance se solidifier pour prendre la forme du moule.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy kollektív ágens felelőssége folyékony vagy olvasztott anyag öntőformába öntéséért, hogy az ott megszilárduljon és fölvegye az öntőforma formáját.","it":"Manifestazione che implica una responsabilità di un agente collettivo nel versare un liquido o sostanza fusa in uno stampo e lasciarlo solidificare per assumere la forma dello stampo.","lv":"Manifestācija, kas ietver grupas atbildību par šķidruma vai izkausētas vielas ieliešanu veidnē un atstāšanu sacietēt, lai tā saglabātu formu.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het gieten van een vloeistof of gesmolten substantie in een mal en het laten stollen om de vorm van de mal aan te laten nemen.","no":"En manifestasjon som involverer et ansvar for en kollektiv agent i form av framstilling av trykt tekst, nedskrevet musikk eller annet innhold fra typer eller plater.","tr":"Sıvı veya erimiş bir maddeyi bir kalıba dökmek ve kalıbın şeklini almak üzere katılaşmaya bırakmak için kolektif bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及将液体或融化的物质倒入模具中使其按模具固化成型的一个集体行为者的责任的一种载体表现"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
