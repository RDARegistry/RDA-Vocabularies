                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50201", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerAgentOf.en", "label":"is producer agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50702", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerCollectiveAgentOf.en", "label":"is film producer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50551", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerPersonOf.en", "label":"is film producer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50213", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/filmProducerAgentOf.en", "label":"is film producer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50213", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/filmProducerAgentOf.en", "label":"is film producer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50702","label":{"ar":"هو وكيل جماعي منتج فيلم لـ","ca":"és agent col·lectiu productor cinematogràfic de","cs":"je filmovým producentem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er filmproducer af","de":"ist gemeinschaftlicher Akteur als Filmproduzentin/Filmproduzent von","de":"ist gemeinschaftlicher Akteur als Filmproduzentin/Filmproduzent von","el":"είναι παραγωγός ταινίας συλλογικός φορέας του","en":"is film producer collective agent of","es":"es agente colectivo productor de cine de","et":"filmiprodutsent (kollektiiv) teoses","fi":"elokuvatuottaja (yhteistoimija) teoksessa","fr":"est un agent collectif producteur de cinéma de","hu":"filmproducer kollektív ágense a következőnek:","it":"è produttore cinematografico agente collettivo di","lv":"ir filmas producents (grupa)","nl":"is filmproducent-collectieve actor van","no":"er filmprodusent for (kollektiv agent)","tr":"film yapımcısı kolektif temsilcisidir","zh-Hans-CN":"是……的电影制作人集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن معظم الجوانب التجارية لإنتاج فيلم."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la majoria dels aspectes comercials de la producció d’una pel·lícula."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za většinu obchodních aspektů výroby filmu."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for størstedelen af de forretningsmæssige aspekter ved en film."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for most of the business aspects of the production of a film."],"es":["Relaciona un agente colectivo con una obra que implica la responsabilidad de un agente colectivo por la mayoría de los aspectos comerciales de la producción de una película."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust enamiku äriliste aspektide eest filmi tootmisel."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa suurimmasta osasta elokuvan liiketoimintaa."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif en ce qui concerne la majeure partie des aspects commerciaux de la production d’un film."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy filmprodukció legtöbb üzleti vonatkozásáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivoper la maggior parte degli aspetti commerciali della produzione di un film."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par filmas uzņemšanas finansiālajiem aspektiem."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het merendeel van de zakelijke aspecten van de productie van een film."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av de fleste forretningsmessige aspektene ved produksjon av en film."],"tr":["Kolektif bir temsilciyi, bir filmin yapımının ticari yönlerinin çoğu için kolektif bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及电影制作的大部分商业运作的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي منتج لفيلم لـ","ca":"agent col·lectiu productor cinematogràfic de","cs":"filmový producent (kolektivní agent) (čeho)","da":"kollektiv agent, som er filmproducer af","de":"Gemeinschaftlicher Akteur als Filmproduzentin/Filmproduzent von","de":"Gemeinschaftlicher Akteur als Filmproduzentin/Filmproduzent von","el":"παραγωγός ταινίας συλλογικός φορέας του","en":"film producer collective agent of","es":"agente colectivo productor de cine de","et":"filmiprodutsent (kollektiiv) teoses","fi":"elokuvatuottaja (yhteistoimija) teoksessa","fr":"agent collectif producteur de cinéma de","hu":"filmproducer kollektív ágense:","it":"produttore cinematografico agente collettivo di","lv":"ir filmas producents (grupa)","nl":"filmproducent-collectieve actor van","no":"filmprodusent for (kollektiv agent)","tr":"film yapımcısı kolektif temsilcisi","zh-Hans-CN":"……的电影制作人集体行为者"},"ToolkitDefinition":{"ar":"عم