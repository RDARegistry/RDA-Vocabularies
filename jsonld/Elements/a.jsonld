                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lettererAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50448", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToAmalgamationOf.en", "label":"is contributor agent to amalgamation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50735", "lexicalAlias":"http://rdaregistry.info/Elements/a/lettererCollectiveAgentOf.en", "label":"is letterer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50584", "lexicalAlias":"http://rdaregistry.info/Elements/a/lettererPersonOf.en", "label":"is letterer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50245", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lettererAgentOf.en", "label":"is letterer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50245", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lettererAgentOf.en", "label":"is letterer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50735","label":{"ar":"هو وكيل جماعي رسّام حروف لـ","ca":"és agent col·lectiu retolista de","cs":"je letrážistou (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er bogstavtegner af","de":"ist gemeinschaftlicher Akteur als Letterer von","de":"ist gemeinschaftlicher Akteur als Letterer von","el":"είναι σχεδιαστής γραμμάτων επιγραφών συλλογικός φορέας του","en":"is letterer collective agent of","es":"es agente colectivo rotulador de","et":"tekstijoonistaja (kollektiiv) väljenduses","fi":"tekstaaja (yhteistoimija) ekspressiossa","fr":"est un agent collectif lettreur de","hu":"betűrajzoló kollektív ágense a következőnek:","it":"è letterista agente collettivo di","lv":"ir komiksa teksta rakstītājs (grupa)","nl":"is letteraar-collectieve actor van","no":"er letterer for (kollektiv agent)","tr":"yazı tasarımcısı kolektif temsilcisidir","zh-Hans-CN":"是……的字母图案画者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في رسم النص والمؤثرات الصوتية لرسومات قصة مصورة أو رواية مصورة، إلخ."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu en el dibuix de text i d’efectes sonors gràfics d’un còmic, una novel·la gràfica, etc."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že kreslí text a grafické zvukové efekty pro komiks, grafický román atd."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at tegne tekst og grafiske lydeffekter til en tegneserie, graphic novel etc."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of drawing text and graphic sound effects for a comic book, graphic novel, etc."],"es":["Relaciona un agente colectivo con una expresión que incluye una aportación por parte de un agente colectivo de dibujo de texto y efectos gráficos de sonido para un cómic, novela gráfica, etc."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, joonistades teksti ja graafilisi helijäljendusi koomiksi, graafilise romaani vms jaoks."],"fi":["Liittää yhteistoimijan ekspressioon, jossa yhteistoimija on osallisena sarjakuvan, sarjakuvaromaanin tms. ekspression tekemisessä piirtämällä tekstin ja graafiset äänitehosteet."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à dessiner le texte et les effets sonores graphiques pour une bande dessinée, un roman graphique, etc."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését képregény, képregényalbum stb. szövegének és grafikai hangeffektusainak rajzolásában."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nel disegno di testo ed effetti sonori grafici per un fumetto, graphic novel, etc."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, zīmējot tekstu un skaņu efektus grafiskā formā komiksu grāmatai, grafiskam romānam u.tml."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door tekenen van tekst en grafische geluidseffecten voor een comic, stripboek etc."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å tegne tekst of grafiske lydeffekter for en tegneserie, grafisk roman etc."],"tr":["Kolektif bir temsilciyi, bir çizgi roman, grafik roman vb. için metin ve grafik ses efektleri çizerek katkıda bulunmasını içeren anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括为漫画书、图解小说等绘制文字和图案声音效果的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي رسّام حروف","ca":"agent col·lectiu retolista de","cs":"letrážista (kolektivní agent) (čeho)","da":"kollektiv agent, som er bogstavtegner af","de":"Gemeinschaftlicher Akteur als Letterer von","de":"Gemeinschaftlicher Akteur als Letterer von","el":"σχεδιαστής γραμμάτων επιγραφών συλλογικός φορέας του","en":"letterer collective agent of","es":"agente colectivo rotulador de","et":"tekstijoonistaja (kollektiiv) väljenduses","fi":"tekstaaja (yhteistoimija) ekspressiossa","fr":"agent collectif lettreur de","hu":"betűrajzoló kollektív ágense:","it":"letterista agente collettivo di","lv":"ir komiksa teksta rakstītājs (grupa)","nl":"letteraar-collectieve actor van","no":"letterer for (kollektiv agent)","tr":"Hat sanatçısı kolekti̇f temsilci̇si","zh-Hans-CN":"……的字母图案画者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في رسم النص والمؤثرات الصوتية لرسومات قصة مصورة أو رواية مصورة، إلخ.","ca":"Expressió que inclou una contribució d’un agent col·lectiu en el dibuix de text i d’efectes sonors gràfics d’un còmic, una novel·la gràfica, etc.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že kreslí text a grafické zvukové efekty pro komiks, grafický román atd.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at tegne tekst og grafiske lydeffekter til en tegneserie, graphic novel etc.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet.","en":"An expression that includes a contribution by a collective agent of drawing text and graphic sound effects for a comic book, graphic novel, etc.","es":"Una expresión que incluye una aportación por parte de un agente colectivo de dibujo de texto y efectos gráficos de sonido para un cómic, novela gráfica, etc.","et":"Väljendus, millesse kollektiiv on andnud panuse, joonistades teksti ja graafilisi helijäljendusi koomiksi, graafilise romaani vms jaoks.","fi":"Ekspressio, jossa yhteistoimija on osallisena sarjakuvan, sarjakuvaromaanin tms. ekspression tekemisessä piirtämällä tekstin ja graafiset äänitehosteet.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à dessiner le texte et les effets sonores graphiques pour une bande dessinée, un roman graphique, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését képregény, képregényalbum stb. szövegének és grafikai hangeffektusainak rajzolásában.","it":"Espressione che comprende un contributo di un agente collettivo nel disegno di testo ed effetti sonori grafici per un fumetto, graphic novel, etc.","lv":"Izteiksme, kas ietver grupas ieguldījumu, zīmējot tekstu un skaņu efektus grafiskā formā komiksu grāmatai, grafiskam romānam u.tml.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door tekenen van tekst en grafische geluidseffecten voor een comic, stripboek etc.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å tegne tekst of grafiske lydeffekter for en tegneserie, grafisk roman etc.","tr":"Bir çizgi roman için metin ve grafik ses efektleri çizilmesinde kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为漫画书、图解小说等绘制文字和图案声音效果的一个集体行为者的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
