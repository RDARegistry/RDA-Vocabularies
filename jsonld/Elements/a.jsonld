                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/animatorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51076", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorFamilyToPerformanceOf.en", "label":"is contributor family to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50738", "lexicalAlias":"http://rdaregistry.info/Elements/a/animatorCollectiveAgentOf.en", "label":"is animator collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51040", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/animatorFamilyOf.en", "label":"is animator family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51040", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/animatorFamilyOf.en", "label":"is animator family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50587","label":{"ar":"هو شخص فنان رسوم متحركة لـ","ca":"és persona animadora de","cs":"je animátorem (osobou) (čeho)","da":"er person, som er animator af","de":"ist Person als Trickfilmzeichnerin/Trickfilmzeichner von","de":"ist Person als Trickfilmzeichnerin/Trickfilmzeichner von","el":"είναι [σχεδιαστής] κινουμένων σχεδίων φυσικό πρόσωπο του","en":"is animator person of","es":"es animador de","et":"animaator (isik) väljenduses","fi":"animaattori (henkilö) ekspressiossa","fr":"est une personne animatrice de","hu":"animátor személye a következőnek:","it":"è animatore persona di","lv":"ir animators (persona)","nl":"is animator-persoon van","no":"er animatør for (person)","tr":"animatör kişisidir","zh-Hans-CN":"是……的动画师个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص لجعل كائنات أو رسومات جامدة تتحرك حركة واضحة."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona donant l’aparença de moviment a objectes o dibuixos inanimats."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že dodává zdání pohybu neživým předmětům nebo kresbám."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at give en illusion af bevægelse til livløse objekter eller tegninger."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt."],"en":["Relates a person to an expression that includes a contribution by a person of giving apparent movement to inanimate objects or drawings."],"es":["Relaciona a una persona con una expresión que incluye la contribución de una persona de dar movimiento aparente a objetos o dibujos inanimados."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, pannes näiliselt liikuma elutud esemed või joonistused."],"fi":["Liittää henkilön ekspressioon, jonka tekemisessä henkilö on osallisena tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à donner l’illusion du mouvement à des objets inanimés ou à des dessins."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését élettelen tárgyak vagy rajzok látszólagos mozgatásában."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nel dare movimento apparente a oggetti inanimati o disegni."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, pieškirot šķietamu kustību nekustīgiem objektiem vai zīmējumiem."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door het geven van schijnbare beweging aan levenloze objecten of tekeningen."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å gi tilsynelatende bevegelse til tegninger eller figurer."],"tr":["Bir kişiyi, bir kişinin cansız nesnelere veya çizimlere görünür hareket verme katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括一个个人对给予无生命对象或绘画以貌似运动之贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص فنان رسوم متحركة","ca":"persona animadora de","cs":"animátor (osoba) (čeho)","da":"person, som er animator af","de":"Person als Trickfilmzeichnerin/Trickfilmzeichner von","de":"Person als Trickfilmzeichnerin/Trickfilmzeichner von","el":"[σχεδιαστής] κινουμένων σχεδίων φυσικό πρόσωπο του","en":"animator person of","es":"animador de","et":"animaator (isik) väljenduses","fi":"animaattori (henkilö) ekspressiossa","fr":"personne animatrice de","hu":"animátor személye:","it":"animatore persona di","lv":"ir animators (persona)","nl":"animator-persoon van","no":"animatør for (person)","tr":"animatör kişi","zh-Hans-CN":"……的动画师个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص لجعل كائنات أو رسومات جامدة تتحرك حركة واضحة.","ca":"Expressió que inclou una contribució d’una persona donant l’aparença de moviment a objectes o dibuixos inanimats.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že dodává zdání pohybu neživým předmětům nebo kresbám.","da":"Udtryk, som omfatter en persons bidrag ved at give en illusion af bevægelse til livløse objekter eller tegninger.","de":"Eine Expression, zu der eine Person beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","en":"An expression that includes a contribution by a person of giving apparent movement to inanimate objects or drawings.","es":"Una expresión que incluye la contribución de una persona de dar movimiento aparente a objetos o dibujos inanimados.","et":"Väljendus, millesse isik on andnud panuse, pannes näiliselt liikuma elutud esemed või joonistused.","fi":"Ekspressio, jonka tekemisessä henkilö on osallisena tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à donner l’illusion du mouvement à des objets inanimés ou à des dessins.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését élettelen tárgyak vagy rajzok látszólagos mozgatásában.","it":"Espressione che comprende un contributo di una persona nel dare movimento apparente a oggetti inanimati o disegni.","lv":"Izteiksme, kas ietver personas ieguldījumu, pieškirot šķietamu kustību nekustīgiem objektiem vai zīmējumiem.","nl":"Een expressie die omvat een bijdrage door een persoon door het geven van schijnbare beweging aan levenloze objecten of tekeningen.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å gi tilsynelatende bevegelse til tegninger eller figurer.","tr":"Cansız nesnelere veya çizimlere görünür hareket veren bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括一个个人对给予无生命对象或绘画以貌似运动之贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/animatorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50136", "lexicalAlias":"http://rdaregistry.info/Elements/a/animatorAgentOf.en", "label":"is animator agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50587", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/animatorPersonOf.en", "label":"is animator person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50587", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/animatorPersonOf.en", "label":"is animator person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50088","label":{"ca":"és apel·lant de","da":"er appellant af","de":"ist Berufungskläger/Revisionskläger von","el":"είναι εκκαλών/αναιρεσείων του","fi":"muutoshakemus","fr":"est un appelant de"},"definition":{"ca":["Relaciona una persona o entitat corporativa, que recorre a un tribunal superior perquè esmeni la sentència d’un tribunal inferior, amb una obra."],"da":["Relaterer en person eller korporation, der appelerer en underrets beslutning, der er registrereret i et juridisk værk fra en højerere retsinstans til et værk."],"de":["Setzt eine Person oder eine Körperschaft, die gegen ein Gerichtsurteil einer unteren Instanz, das in einem juristischen Werk einer höheren Instanz erfasst ist, Rechtsmittel (Berufung/Revision) einlegt, mit einem Werk in Beziehung."],"el":["Συνδέει ένα φυσικό πρόσωπο ή συλλογικό όργανο, που ασκεί έφεση εναντίον απόφασης κατώτερου δικαστηρίου, που καταχωρίστηκε στα πρακτικά ενός ανωτέρου δικαστηρίου, με ένα έργο."],"fi":["Liittää henkilön tai yhteisön hakemukseen, jolla henkilö tai yhteisö hakee muutosta alemman oikeusasteen päätökseen."],"fr":["Met une personne ou collectivité qui en appelle d’une décision d’un tribunal inférieur enregistrée dans une œuvre juridique d’un tribunal supérieur en relation avec une œuvre."]},"ToolkitLabel":{"ca":"apel·lant de","da":"appellant af","de":"Berufungskläger/Revisionskläger von","el":"εκκαλών/αναιρεσείων του","fi":"muutoshakemus","fr":"appelant de","no":"appellant for"},"ToolkitDefinition":{"ca":"Obra jurídica d’un tribunal superior perquè esmeni una sentència d’un tribunal inferior apel·lada per una persona o entitat corporativa.","da":"Juridisk værk fra en højere retsinstans, der har registreret en beslutning fra en underret, der bliver appelleret af en person eller korporation.","de":"Ein juristisches Werk einer höheren Instanz, bei der eine Person oder eine Körperschaft gegen ein Gerichtsurteil einer unteren Instanz, das in einem juristischen Werk einer höheren Instanz erfasst ist, Rechtsmittel (Berufung/Revision) einlegt.","el":"Ένα έργο που καταχωρίστηκε στα πρακτικά ενός ανωτέρου δικαστηρίου,για το οποίο ασκείται έφεση εναντίον απόφασης κατώτερου δικαστηρίου από φυσικό πρόσωπο ή συλλογικό όργανο.","fi":"Hakemus, jolla henkilö tai yhteisö hakee muutosta alemman oikeusasteen päätökseen.","fr":"Œuvre juridique d’un tribunal supérieur qui enregistre une décision d’un tribunal inférieur portée en appel par une personne ou une collectivité.","no":"Et juridisk verk fra en høyere rettsinstans som registrerer en avgjørelse fra en lavere rettsinstans som ankes av en person eller korporasjon."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50131", "lexicalAlias":"http://rdaregistry.info/Elements/a/otherAgentWorkOf.en", "label":"is other agent associated with work of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/appellantOf.en","instructionNumber":"18.5"},{"@id":"http://rdaregistry.info/Elements/a/P50378","label":{"ar":"له اسم تعريفي لوكيل","ca":"té com a apel·lació d’agent","cs":"má pojmenování agenta","da":"har benævnelse på agent","de":"hat Bezeichnung für einen Akteur","de":"hat Bezeichnung für einen Akteur","el":"έχει ονομασία του φορέα","en":"has appellation of agent","es":"tiene denominación de agente","et":"tegija nimetus","fi":"toimijan nimitys","fr":"a pour appellation d’agent","hu":"ágens megnevezése a következő:","it":"ha come denominazione di agente","lv":"aģenta apzīmējums","nl":"heeft benaming van actor","no":"har betegnelse for agent","tr":"temsilcinin unvanı ile ilişkilidir","zh-Hans-CN":"有行为者的称谓"},"definition":{"ar":["يربط وكيلا بتسمية مستخدمة في خطة أو في سياق محدد للإشارة إلى وكيل."],"ca":["Relaciona un agent amb un nomen que s’usa en un esquema o un context determinat per referir-se a un agent."],"cs":["Vztahuje agenta k nomen, které se používá v daném schématu nebo kontextu k odkazování na agenta."],"da":["Relaterer en agent til et nomen, som anvendes inden for et givet skema eller kontekst for at henvise til en agent."],"de":["Setzt einen Akteur in Beziehung zu einem Nomen, das in einem bestimmten Schema oder Kontext verwendet wird, um einen Akteur zu referenzieren.,Setzt einen Akteur in Beziehung zu einem Nomen, das in einem bestimmten Schema oder Kontext verwendet wird, um einen Akteur zu referenzieren."],"en":["Relates an agent to a nomen that is used within a given scheme or context to refer to an agent."],"es":["Relaciona un agente con un nomen que se utiliza dentro de un esquema o contexto determinado para hacer referencia a un agente."],"et":["Seostab tegija nomen'iga, mida antud süsteemis või kontekstis kasutatakse tegijale viitamiseks."],"fi":["Liittää toimijan nomeniin, jota on käytetty tietyssä järjestelmässä tai kontekstissa viittaamaan toimijaan."],"fr":["Met un agent en relation avec un nomen qui est utilisé à l’intérieur d’un schéma ou d’un contexte donnés pour désigner un agent."],"hu":["Hozzákapcsol egy ágenst egy nomenhez, amelyet egy adott sémán vagy kontextuson belül használnak egy ágensre való hivatkozásra."],"it":["Correla un agente a un nomen che è usato all'interno di un dato schema o contesto per far riferimento a un agente."],"lv":["Sasaista aģentu ar nomenu, ko lieto konkrētajā sistēmā vai kontekstā, lai norādītu uz aģentu."],"nl":["Relateert een actor aan een nomen dat wordt gebruikt binnen een bepaald schema of context om een actor aan te duiden."],"no":["Relaterer en agent til et nomen som er brukt i et bestemt skjema eller kontekst for å referere til en agent."],"tr":["Bir temsilciyi, bir şema veya bağlam içinde bir temsilciye atıfta bulunmak için kullanılan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与在一个给定的体系或语境中指称一个行为者所用的一个命名关联起来。"]},"ToolkitLabel":{"ar":"اسم تعريفي لوكيل","ca":"apel·lació d’agent","cs":"pojmenování agenta","da":"benævnelse på agent","de":"Bezeichnung für einen Akteur","de":"Bezeichnung für einen Akteur","el":"ονομασία του φορέα","en":"appellation of agent","es":"denominación de agente","et":"tegija nimetus","fi":"toimijan nimitys","fr":"appellation d’agent","hu":"ágens megnevezése:","it":"denominazione di agente collettivo","lv":"aģenta apzīmējums","nl":"benaming van actor","no":"betegnelse for agent","tr":"temsilcinin unvanı","zh-Hans-CN":"行为者的称谓"},"ToolkitDefinition":{"ar":"تسمية مستخدمة في خطة أو في سياق محدد للإشارة إلى وكيل.","ca":"Nomen que s’usa en un esquema o un context determinat per referir-se a un agent.","cs":"Nomen, které se používá v daném schématu nebo kontextu k odkazování na agenta.","da":"Nomen, som anvendes inden for et givet skema eller kontekst for at henvise til en agent.","de":"Ein Nomen, das in einem bestimmten Schema oder Kontext verwendet wird, um einen Akteur zu referenzieren.","de":"Ein Nomen, das in einem bestimmten Schema oder Kontext verwendet wird, um einen Akteur zu referenzieren.","en":"A nomen that is used within a given scheme or context to refer to an agent.","es":"Un nomen que se utiliza dentro de un esquema o contexto determinado para hacer referencia a un agente.","et":"Nomen, mida antud süsteemis või kontekstis kasutatakse tegijale viitamiseks.","fi":"Nomen, jota on käytetty tietyssä järjestelmässä tai kontekstissa viittaamaan toimijaan.","fr":"Nomen qui est utilisé à l’intérieur d’un schéma ou d’un contexte donnés pour désigner un agent.","hu":"Egy nomen, amelyet egy adott sémán vagy kontextuson belül használnak egy ágensre való hivatkozásra.","it":"Nomen che è usato all'interno di un dato schema o contesto per far riferimento a un agente.","lv":"Nomens, ko lieto konkrētajā sistēmā vai kontekstā, lai norādītu uz aģentu.","nl":"Een nomen dat wordt gebruikt binnen een bepaald schema of context om een actor aan te duiden.","no":"Et nomen som er brukt i et bestemt skjema eller kontekst for å referere til en agent.","tr":"Bir şema veya bağlam içinde bir temsilciye atıfta bulunmak için kullanılan bir nomen","zh-Hans-CN":"在一个给定的体系或语境中指称一个行为者所用的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/appellationOfAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50340", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedNomenOfAgent.en", "label":"has related nomen of agent"},{"@id":"http://rdaregistry.info/Elements/x/P00017", "lexicalAlias":"http://rdaregistry.info/Elements/x/appellationOfRDAEntity.en", "label":"has appellation of RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50373", "lexicalAlias":"http://rdaregistry.info/Elements/a/accessPointForAgent.en", "label":"has access point for agent"},{"@id":"http://rdaregistry.info/Elements/a/P50379", "lexicalAlias":"http://rdaregistry.info/Elements/a/appellationOfCollectiveAgent.en", "label":"has appellation of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50382", "lexicalAlias":"http://rdaregistry.info/Elements/a/appellationOfPerson.en", "label":"has appellation of person"},{"@id":"http://rdaregistry.info/Elements/a/P50383", "lexicalAlias":"http://rdaregistry.info/Elements/a/identifierForAgent.en", "label":"has identifier for agent"},{"@id":"http://rdaregistry.info/Elements/a/P50385", "lexicalAlias":"http://rdaregistry.info/Elements/a/nameOfAgent.en", "label":"has name of agent"},{"@id":"http://rdaregistry.info/Elements/a/object/P50378", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/appellationOfAgent.en", "label":"has appellation of agent"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50378", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/appellationOfAgent.en", "label":"has appellation of agent"}]},{"@id":"http://rdaregistry.info/Elements/a/P50379","label":{"ar":"له اسم تعريفي لوكيل جماعي","ca":"té com a apel·lació d’agent col·lectiu","cs":"má pojmenování kolektivního agenta","da":"har benævnelse på kollektiv agent","de":"hat Bezeichnung für einen gemeinschaftlichen Akteur","de":"hat Bezeichnung für einen gemeinschaftlichen Akteur","el":"έχει ονομασία του συλλογικού φορέα","en":"has appellation of collective agent","es":"tiene denominación de agente colectivo","et":"kollektiivi nimetus","fi":"yhteistoimijan nimitys","fr":"a pour appellation d’agent collectif","hu":"kollektív ágens megnevezése a következő:","it":"ha come denominazione di agente collettivo","lv":"grupas apzīmējums","nl":"heeft benaming van collectieve actor","no":"har betegnelse for kollektiv agent","tr":"kolektif temsilcinin unvanı ile ilişkilidir","zh-Hans-CN":"有集体行为者的称谓"},"definition":{"ar":["يربط وكيلا جماعيا بتسمية مستخدمة في خطة أو في سياق محدد للإشارة إلى وكيل جماعي ."],"ca":["Relaciona un agent col·lectiu amb un nomen que s’usa en un esquema o un context determinat per referir-se a un agent col·lectiu."],"cs":["Vztahuje kolektivního agenta k nomen, které se používá v rámci daného schématu nebo kontextu k odkazování na kolektivního agenta."],"da":["Relaterer en kollektiv agent til et nomen, som anvendes inden for et givet skema eller kontekst for at henvise til en kollektiv agent."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Nomen, das in einem bestimmten Schema oder Kontext verwendet wird, um einen gemeinschaftlichen Akteur zu referenzieren.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Nomen, das in einem bestimmten Schema oder Kontext verwendet wird, um einen gemeinschaftlichen Akteur zu referenzieren."],"en":["Relates a collective agent to a nomen that is used within a given scheme or context to refer to a collective agent."],"es":["Relaciona un agente colectivo con un nomen que se utiliza dentro de un esquema o contexto determinado para hacer referencia a un agente colectivo."],"et":["Seostab kollektiivi nomen'iga, mida antud süsteemis või kontekstis kasutatakse kollektiivile viitamisek