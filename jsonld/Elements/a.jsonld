                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50786", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectorCollectiveAgentof.en", "label":"is collector collective agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/P50635", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectorPersonof.en", "label":"is collector person of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/object/P50045", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collectorAgentOf.en", "label":"is collector agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50045", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collectorAgentOf.en", "label":"is collector agent of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50786","label":{"ar":"هو وكيل جماعي جامع لـ","ca":"és agent col·lectiu col·leccionista de","da":"er kollektiv agent, som er samler af","de":"ist gemeinschaftlicher Akteur als Sammlerin/Sammler von","el":"είναι συλλέκτης συλλογικός φορέας του","en":"is collector collective agent of (Deprecated)","et":"kogu moodustaja (kollektiiv) eksemplarile","fi":"kokoelman muodostaja (yhteistoimija) kappaleessa","fr":"est un agent collectif collectionneur de","hu":"kollektor kollektív ágense a következőnek:","it":"è collezionista agente collettivo di","lv":"ir kolekcionārs (grupa)","nl":"is verzamelaar-collectieve actor van","no":"er samler av (kollektiv agent)"},"definition":{"ar":["يربط وكيلا جامع بمفردة جمعها وكيل جامع مع مفردات من مصادر مختلفة رُتبت وُوصفت وفُهرست كمجموعة."],"ca":["Relaciona un agent col·lectiu amb un ítem que és aplegat per un agent col·lectiu amb ítems de diverses fonts que s’arrangen, es descriuen o es cataloguen com una col·lecció."],"da":["Relaterer en kollektiv agent til et eksemplar, som er sammenført af en kollektiv agent med eksemplarer fra forskellige kilder, som er arrangeret, beskrevet og katalogiseret som en samling."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Exemplar, das von einem gemeinschaftlichen Akteur mit Materialien aus unterschiedlichen Quellen zusammengetragen wird, die dann als Sammlung geordnet, beschrieben oder katalogisiert werden."],"en":["Relates a collective agent to an item that is brought together by a collective agent with items from various sources that are arranged, described, or catalogued as a collection. (Deprecated)"],"et":["Seostab kollektiivi eksemplariga, mille kollektiiv on kokku pannud teiste eri allikatest kogutud eksemplaridega, mis on korrastatud, kirjeldatud ja kataloogitud koguna."],"fi":["Liittää yhteistoimijan kappaleeseen, jonka yhteistoimija on koonnut järjestetyksi, kuvailluksi tai luetteloiduksi kokoelmaksi eri lähteistä olevista kappaleista."],"fr":["Met un agent collectif en relation avec un item qui est regroupé par un agent collectif avec des items de diverses sources qui sont arrangés, décrits ou catalogués comme une collection de ressources."],"hu":["Hozzákapcsol egy kollektív ágenst egy példányhoz, amelyet egy kollektív ágens különböző forrásokból származó, gyűjteményként rendezett, leírt és katalogizált példányokkal fog össze."],"it":["Correla un agente collettivo a un item messo insieme da un agente collettivo con item da varie fonti che sono organizzati, descritti e catalogati come una collezione."],"lv":["Sasaista grupu ar vienību, ko grupa apkopojusi kopā ar citām vienībām no dažādiem avotiem, kas ir sakārtotas, aprakstītas un kataloģizētas kā kolekcija."],"nl":["Relateert een collectieve actor aan een item dat samengebracht is door een collectieve actor met items van diverse bronnen die gearrangeerd, beschreven of gecatalogiseerd zijn als een verzameling."],"no":["Relaterer en kollektiv agent til et eksemplar som av en kollektiv agent er satt sammen med eksemplarer fra ulike kilder og som er arrangert, beskrevet eller katalogisert som en samling."]},"ToolkitLabel":{"ar":"وكيل جماعي جامع","ca":"agent col·lectiu col·leccionista de","da":"kollektiv agent, som er samler af","de":"Gemeinschaftlicher Akteur als Sammlerin/Sammler von","el":"συλλέκτης συλλογικός φορέας του","en":"collector collective agent of (Deprecated)","et":"kogu moodustaja (kollektiiv) eksemplarile","fi":"kokoelman muodostaja (yhteistoimija) kappaleessa","fr":"agent collectif collectionneur de","hu":"kollektor kollektív ágense:","it":"collezionista agente collettivo di","lv":"ir kolekcionārs (grupa)","nl":"verzamelaar-collectieve actor van","no":"samler av (kollektiv agent)"},"ToolkitDefinition":{"ar":"مفردة جمعها وكيل جامع مع مفردات من مصادر مختلفة رُتبت وُوصفت وفُهرست كمجموعة.","ca":"Ítem que és aplegat per un agent col·lectiu amb ítems de diverses fonts que s’arrangen, es descriuen o es cataloguen com una col·lecció.","da":"Eksemplar, som er sammenført af en kollektiv agent med eksemplarer fra forskellige kilder, som er arrangeret, beskrevet og katalogiseret som en samling.","de":"Ein Exemplar, das von einem gemeinschaftlichen Akteur mit Materialien aus unterschiedlichen Quellen zusammengetragen wird, die dann als Sammlung geordnet, beschrieben oder katalogisiert werden.","en":"An item that is brought together by a collective agent with items from various sources that are arranged, described, or catalogued as a collection. (Deprecated)","et":"Eksemplar, mille kollektiiv on kokku pannud teiste eri allikatest kogutud eksemplaridega, mis on korrastatud, kirjeldatud ja kataloogitud koguna.","fi":"Kappale, jonka yhteistoimija on koonnut osaksi järjestettyä, kuvailtua tai luetteloitua kokoelmaa yhdessä muiden eri lähteistä olevien kappaleiden kanssa.","fr":"Item qui est regroupé par un agent collectif avec des items de diverses sources qui sont arrangés, décrits ou catalogués comme une collection de ressources.","hu":"Egy példány, amelyet egy kollektív ágens különböző forrásokból származó, gyűjteményként rendezett, leírt és katalogizált példányokkal fog össze.","it":"Item messo insieme da un agente collettivo con item da varie fonti che sono organizzati, descritti e catalogati come una collezione.","lv":"Vienība, ko grupa apkopojusi kopā ar citām vienībām no dažādiem avotiem, kas ir sakārtotas, aprakstītas un kataloģizētas kā kolekcija.","nl":"Een item dat samengebracht is door een collectieve actor met items van diverse bronnen die gearrangeerd, beschreven of gecatalogiseerd zijn als een verzameling.","no":"Et eksemplar som av en kollektiv agent er satt sammen med eksemplarer fra ulike kilder og som er arrangert, beskrevet eller katalogisert som en samling."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50781", "lexicalAlias":"http://rdaregistry.info/Elements/a/curatorCollectiveAgentOf.en", "label":"is curator collective agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/P50045", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectorAgentOf.en", "label":"is collector agent of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/collectorCollectiveAgentof.en","status": {
