                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50357", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfCollectiveAgent.en", "label":"has related work of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50226", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfAgent.en", "label":"has sponsored work of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P51101", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfCorporateBody.en", "label":"has sponsored work of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/P51102", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfFamily.en", "label":"has sponsored work of family"},{"@id":"http://rdaregistry.info/Elements/a/object/P51100", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/sponsoredWorkOfCollectiveAgent.en", "label":"has sponsored work of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51100", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/sponsoredWorkOfCollectiveAgent.en", "label":"has sponsored work of collective agent"}]},{"@id":"http://rdaregistry.info/Elements/a/P51101","label":{"ar":"لها عمل برعاية هيئة","ca":"té com a obra patrocinada per una entitat corporativa","cs":"má dílo sponzorované korporací","da":"har værk sponsoreret af korporation","de":"hat Körperschaft als Träger eines Werks von","de":"hat Körperschaft als Träger eines Werks von","el":"έχει χορηγούμενο έργο του συλλογικού οργάνου","en":"has sponsored work of corporate body","es":"tiene obra patrocinada de organismo corporativo","et":"asutuse toetatud teos","fi":"yhteisön sponsoroima teos","fr":"a pour œuvre parrainée d’une collectivité","hu":"testület szponzorált műve a következő:","it":"ha come opera sponsorizzata di ente","lv":"sponsors (institūcija) darbam","nl":"heeft gesponsord werk van collectieve actor","no":"har verk sponset av korporasjon","tr":"tüzel kişinin sponsor olduğu eser ile ilişkilidir","zh-Hans-CN":"有团体的被赞助作品"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن رعاية بعض جوانب عمل."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en el patrocini d’algun aspecte d’una obra."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za sponzorování některého aspektu díla."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for at sponsorere et aspekt af et værk."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die finanzielle Unterstützung einzelner Aspekte verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die finanzielle Unterstützung einzelner Aspekte verantwortlich ist."],"el":["Συνδέει ένα συλλογικό όργανο με ένα έργο που περιλαμβάνει μια ευθύνη ενός συλλογικού οργάνου για τη χορηγία κάποιας πτυχής ενός έργου."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for sponsoring some aspect of a work."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad de un organismo corporativo de patrocinar algún aspecto de una obra."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust teose mingil viisil toetamise eest."],"fi":["Liittää yhteisön teokseen, jonka sponsoroimisesta yhteisö on vastuussa."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à parrainer un aspect quelconque d’une œuvre."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége egy mű szponzorálásának valamely vonatkozásáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un ente per la sponsorizzazione di alcuni aspetti di un'opera."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par kāda darba aspekta sponsorēšanu."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het sponsoren van een aspect van een werk."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av å sponse noen aspekter ved et verk."],"tr":["Bir tüzel kişiyi, bir çalışmanın bazı yönlerine sponsor olma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及赞助一种作品某些方面的一个团体的责任的一种作品关联起来。"]},"note":{"ar":["يشمل ذلك تمويل البحوث ورعاية حدث يكون أساس لعمل."],"ca":["Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra."],"cs":["Zahrnuje financování výzkumu a sponzorování akce, která je základem díla."],"da":["Omfatter finansiering af forskning og sponsorering af et arrangement, som danner grundlag for et værk."],"de":["Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.,Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden."],"el":["Περιλαμβάνει τη χρηματοδότηση της έρευνας και της χορηγίας ενός συμβάντος που συνιστά τη βάση ενός έργου."],"en":["Includes funding research and sponsoring an event that is the basis of a work."],"es":["Incluye financiar investigación y patrocinar un evento que es la base de una obra."],"et":["Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist."],"fi":["Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin."],"fr":["Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre."],"hu":["Egy mű alapját képező kutatás finanszírozása és esemény szponzorálása is idetartozik."],"it":["Comprende finanziare una ricerca e sponsorizzare un evento che è la base di un'opera."],"lv":["Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā."],"nl":["Omvat financiering van onderzoek en sponsoren van een gebeurtenis die de basis van een werk is."],"no":["Forskningsmidler og sponsing av et arrangement som gir grunnlag for et verk, er inkludert."],"tr":["tüzel kişinin sponsor olduğu eser ile ilişkilidir"],"zh-Hans-CN":["包括作为一种作品基础的科研资助和活动赞助"]},"ToolkitLabel":{"ar":"عمل برعاية هيئة","ca":"obra patrocinada per una entitat corporativa","cs":"dílo sponzorované korporací","da":"værk sponsoreret af korporation","de":"Körperschaft als Träger eines Werks von","de":"Körperschaft als Träger eines Werks von","el":"χορηγούμενο έργο του συλλογικού οργάνου","en":"sponsored work of corporate body","es":"obra patrocinada de organismo corporativo","et":"asutuse toetatud teos","fi":"yhteisön sponsoroima teos","fr":"œuvre parrainée d’une collectivité","hu":"testület által szponzorált műve:","it":"opera sponsorizzata di ente","lv":"sponsors (institūcija) darbam","nl":"gesponsord werk van collectieve actor","no":"verk sponset av korporasjon","tr":"tüzel kişinin sponsor olduğu eser","zh-Hans-CN":"团体的被赞助作品"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن رعاية بعض جوانب العمل.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en el patrocini d’algun aspecte d’una obra.","cs":"Dílo, které zahrnuje odpovědnost korporace za sponzorování některého aspektu díla.","da":"Værk, som involverer en korporations ansvar for at sponsorere et aspekt af et værk.","de":"Ein Werk, bei dem eine Körperschaft für die finanzielle Unterstützung einzelner Aspekte verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für die finanzielle Unterstützung einzelner Aspekte vera