                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/realIdentityOfPerson.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50348", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedNomenOfPerson.en", "label":"has related nomen of person"}],"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50429", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/realIdentityOfPerson.en", "label":"has real identity of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50429", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/realIdentityOfPerson.en", "label":"has real identity of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50158","label":{"ar":"هو وكيل مهندس تسجيل لـ","ca":"és agent enginyer de so de","cs":"je technikem záznamu (agentem) (čeho)","da":"er agent, som er indspilningstekniker af","de":"ist Akteur als Aufnahmetechnikerin/Aufnahmetechniker von","de":"ist Akteur als Aufnahmetechnikerin/Aufnahmetechniker von","el":"είναι μηχανικός ηχογράφησης φορέας του","en":"is recording engineer agent of","es":"es agente ingeniero de grabación de","et":"salvestusinsener (tegija) väljenduses","fi":"äänittäjä (toimija) ekspressiossa","fr":"est un agent preneur de son de","hu":"hangrögzítő ágense a következőnek:","it":"è ingegnere della registrazione agente di","lv":"ir ierakstu inženieris (aģents)","nl":"is opnametechnicus-actor van","no":"er innspillingstekniker for (agent)","tr":"ses kayıt mühendisi temsilcisidir","zh-Hans-CN":"是……的录制工程师行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent supervisant els aspectes tècnics del contingut àudio d’una sessió d’enregistrament."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že dohlíží na technické aspekty zvukového obsahu nahrávání."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at føre tilsyn med de tekniske aspekter af lydindholdet til en lyd- eller videooptagelse."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht."],"el":["Συνδέει έναν μηχανικό ήχου, ο οποίος συνεισφέρει στο ακουστικό περιεχόμενο μιας έκφρασης μέσω της εποπτείας των τεχνικών πτυχών μιας ηχογράφησης, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of supervising the technical aspects of the audio content of a recording session."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de supervisar los aspectos técnicos del contenido de audio de una sesión de grabación."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, juhendades helisisu salvestamise tehnilisi aspekte."],"fi":["Liittää toimijan ekspressioon, jonka äänisisällön tekemiseen toimija osallistuu valvomalla äänityksen teknistä toteutusta."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à superviser les aspects techniques du contenu audio d’une séance d’enregistrement."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését a hangtartalom rögzítését szolgáló munkamenet műszaki aspektusainak felügyeletében."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nel supervisionare gli aspetti tecnici del contenuto audio di una sessione di registrazione."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, uzraugot audio satura tehniskos parametrus ieraksta laikā."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door toezicht houden op de technische aspecten van de geluidscontent van een opnamesessie."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å styre de tekniske aspektene ved en innspilling."],"tr":["Bir temsilciyi, ses kayıt oturumundaki ses içeriğinin teknik yönlerini denetleyen bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括监督一个录制过程中的音频内容的技术方面的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مهندس تسجيل","ca":"agent enginyer de so de","cs":"technik záznamu (agent) (čeho)","da":"agent, som er indspilningstekniker af","de":"Akteur als Aufnahmetechnikerin/Aufnahmetechniker von","de":"Akteur als Aufnahmetechnikerin/Aufnahmetechniker von","el":"μηχανικός ηχογράφησης φορέας του","en":"recording engineer agent of","es":"agente ingeniero de grabación de","et":"salvestusinsener (tegija) väljenduses","fi":"äänittäjä (toimija) ekspressiossa","fr":"agent preneur de son de","hu":"hangrögzítő ágense:","it":"ingegnere della registrazione agente di","lv":"ir ierakstu inženieris (aģents)","nl":"opnametechnicus-actor van","no":"innspillingstekniker for (agent)","tr":"Kayıt mühendisi","zh-Hans-CN":"……的录制工程师行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل.","ca":"Expressió que inclou una contribució d’un agent supervisant els aspectes tècnics del contingut àudio d’una sessió d’enregistrament.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že dohlíží na technické aspekty zvukového obsahu nahrávání.","da":"Udtryk, som omfatter en agents bidrag ved at føre tilsyn med de tekniske aspekter af lydindholdet til en lyd- eller videooptagelse.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά στο ακουστικό περιεχόμενο μέσω της εποπτείας των τεχνικών πτυχών μιας ηχογράφησης.","en":"An expression that includes a contribution by an agent of supervising the technical aspects of the audio content of a recording session.","es":"Una expresión que incluye una contribución de un agente de supervisar los aspectos técnicos del contenido de audio de una sesión de grabación.","et":"Väljendus, millesse tegija on andnud panuse, juhendades helisisu salvestamise tehnilisi aspekte.","fi":"Ekspressio, jonka äänisisällön tekemiseen toimija osallistuu valvomalla äänityksen teknistä toteutusta.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à superviser les aspects techniques du contenu audio d’une séance d’enregistrement.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését a hangtartalom rögzítését szolgáló munkamenet műszaki aspektusainak felügyeletében.","it":"Espressione che include un contributo da parte di un agente nel supervisionare gli aspetti tecnici del contenuto audio di una sessione di registrazione.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, uzraugot audio satura tehniskos parametrus ieraksta laikā.","nl":"Een expressie die omvat een bijdrage door een actor door toezicht houden op de technische aspecten van de geluidscontent van een opnamesessie.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å styre de tekniske aspektene ved en innspilling.","tr":"Bir kayıt seansının ses içeriğinin teknik yönlerini denetleyen bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括监督一个录制过程中的音频内容的技术方面的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["مهندس تسجيل"],"ca":["enginyer de so de"],"cs":["technik záznamu (čeho)"],"da":["indspilningstekniker af"],"de":["Aufnahmetechniker von,