                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51003", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerFamilyOf.en", "label":"is producer family of"},{"@id":"http://rdaregistry.info/Elements/a/P50704", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerCollectiveAgentOf.en", "label":"is television producer collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51006", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/televisionProducerFamilyOf.en", "label":"is television producer family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51006", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/televisionProducerFamilyOf.en", "label":"is television producer family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50553","label":{"ar":"هو شخص منتج تليفزيوني لـ","ca":"és persona productora de televisió de","cs":"je televizním producentem (osobou) (čeho)","da":"er person, som er tv-producer af","de":"ist Person als Fernsehproduzentin/Fernsehproduzent von","de":"ist Person als Fernsehproduzentin/Fernsehproduzent von","el":"είναι τηλεοπτικός παραγωγός φυσικό πρόσωπο του","en":"is television producer person of","es":"es productor de televisión","et":"teleprodutsent (isik) teoses","fi":"televisiotuottaja (henkilö) teoksessa","fr":"est une personne productrice de télévision de","hu":"televízió-producer személye a következőnek:","it":"è produttore televisivo persona di","lv":"ir televīzijas raidījuma producents (persona)","nl":"is televisieproducent-persoon van","no":"er fjernsynsprodusent for (person)","tr":"televizyon yapımcısıdır","zh-Hans-CN":"是……的电视制作人个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن معظم الجوانب التجارية لإنتاج برنامج تليفزيوني."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la majoria dels aspectes comercials de la producció d’un programa de televisió."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za většinu obchodních aspektů výroby televizního programu."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for størstedelen af de forretningsmæssige aspekter ved et tv-program."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for most of the business aspects of the production of a television program."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona por la mayoría de los aspectos comerciales de la producción de un programa de televisión."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust enamiku äriliste aspektide eest telesaate tootmisel."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa suurimmasta osasta televisio-ohjelman liiketoimintaa."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne en ce qui concerne la majeure partie des aspects commerciaux de la production d’une émission de télévision."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy televízióműsor legtöbb üzleti vonatkozásáért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per la maggior parte degli aspetti commerciali della produzione di un programma televisivo."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par televīzijas raidījuma biznesa aspektiem."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het merendeel van de zakelijke aspecten van de productie van een televisieprogramma."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av de fleste forretningsmessige aspektene ved produksjon av et fjernsynsprogram."],"tr":["Bir kişiyi, bir televizyon programının yapımının ticari yönlerinin çoğu için bir kişinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及电视节目制作的大部分商业运作的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص منتج تليفزيوني","ca":"persona productora de televisió de","cs":"televizní producent (osoba) (čeho)","da":"person, som er tv-producer af","de":"Person als Fernsehproduzentin/Fernsehproduzent von","de":"Person als Fernsehproduzentin/Fernsehproduzent von","el":"τηλεοπτικός παραγωγός φυσικό πρόσωπο του","en":"television producer person of","es":"productor de televisión","et":"teleprodutsent (isik) teoses","fi":"televisiotuottaja (henkilö) teoksessa","fr":"personne productrice de télévision de","hu":"televízió-producer személye:","it":"produttore televisivo persona di","lv":"ir televīzijas raidījuma producents (persona)","nl":"televisieproducent-persoon van","no":"fjernsynsprodusent for (person)","tr":"televizyon yapımcısı olam kişi","zh-Hans-CN":"……的电视制作人个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن معظم الجوانب التجارية لإنتاج برنامج تليفزيوني.","ca":"Obra que implica una responsabilitat d’una persona en la majoria dels aspectes comercials de la producció d’un programa de televisió.","cs":"Dílo, které zahrnuje odpovědnost osoby za většinu obchodních aspektů výroby televizního programu.","da":"Værk, som involverer en persons ansvar for størstedelen af de forretningsmæssige aspekter ved et tv-program.","de":"Ein Werk, bei dem eine Person für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.","de":"Ein Werk, bei dem eine Person für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.","en":"A work that involves a responsibility of a person for most of the business aspects of the production of a television program.","es":"Una obra que implica la responsabilidad de una persona por la mayoría de los aspectos comerciales de la producción de un programa de televisión.","et":"Teos, mis sisaldab isiku vastutust enamiku äriliste aspektide eest telesaate tootmisel.","fi":"Teos, jossa henkilö on vastuussa suurimmasta osasta televisio-ohjelman liiketoimintaa.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne en ce qui concerne la majeure partie des aspects commerciaux de la production d’une émission de télévision.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy televízióműsor legtöbb üzleti vonatkozásáért.","it":"Opera che implica una responsabilità di una persona per la maggior parte degli aspetti commerciali della produzione di un programma televisivo.","lv":"Darbs, kas ietver personas atbildību par televīzijas raidījuma biznesa aspektiem.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het merendeel van de zakelijke aspecten van de productie van een televisieprogramma.","no":"Et verk som involverer et ansvar for en person i form av de fleste forretningsmessige aspektene ved produksjon av et fjernsynsprogram.","tr":"Bir televizyon programının yapımının ticari yönlerinin çoğu için bir kişinin sorumluluğunu içeren bir çalışma","zh-Hans-CN":"涉及电视节目制作的大部分商业运作的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50550", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerPersonOf.en", "label":"is producer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50215", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerAgentOf.en", "label":"is television producer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50553", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/televisionProducerPersonOf.en", "label":"is television producer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50553", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/televisionProducerPersonOf.en", "label":"is television producer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50091","label":{"ar":"هو مشرف على درجة أكاديمية لـ","ca":"és supervisor de grau acadèmic de","cs":"je vedoucím kvalifikační práce (čeho)","da":"er hovedvejleder af","de":"ist Betreuerin/Betreuer einer Hochschulschrift von","de":"ist Betreuerin/Betreuer einer Hochschulschrift von","el":"είναι επόπτης καθηγητής του","en":"is degree supervisor of","es":"es supervisor de grado de","et":"väitekirja juhendaja teoses","fi":"opinnäytteen ohjaaja teoksessa","fr":"est un superviseur de thèse de","hu":"fokozat témavezetője a következőnek:","it":"è relatore di","lv":"ir promocijas darba vadītājs","nl":"is graad-begeleider van","no":"er veileder for","tr":"tez danışmanıdır","zh-Hans-CN":"是……的学位导师"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية كمشرف أكاديمي على أطروحة أو بحث أكاديمي للحصول على درجة أكاديمية تؤدي إلى عمل."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat com a supervisor acadèmic d’una tesi o una dissertació d’una recerca per a l’obtenció d’un grau acadèmic que dona com a resultat una obra."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost ve funkci školitele při výzkumu pro diplomovou práci nebo disertaci k dosažení akademického titulu, jehož výsledkem je dílo."],"da":["Relaterer en person til et værk, som involverer et ansvar som en akademisk vejleder for forskning til en akademisk grads afhandling eller speciale, som resulterer i et værk."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine akademische Betreuerin/ein akademischer Betreuer für die Beratung und Aufsicht von Forschungstätigkeiten im Rahmen einer Hochschularbeit verantwortlich ist, die zur Erlangung eines akademischen Grads und zu einem Werk führen.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine akademische Betreuerin/ein akademischer Betreuer für die Beratung und Aufsicht von Forschungstätigkeiten im Rahmen einer Hochschularbeit verantwortlich ist, die zur Erlangung eines akademischen Grads und zu einem Werk führen."],"el":["Συνδέει ένα φυσικό πρόσωπο, όπως σύμβουλο ή επόπτη μιας διατριβής ή διδακτορικής έρευνας, είτε για την απόκτηση ανώτερου εκπαιδευτικού επιπέδου πτυχίου είτε διδακτορικού, με ένα έργο."],"en":["Relates a person to a work that involves a responsibility as an academic supervisor of thesis or dissertation research for an academic degree that results in a work."],"es":["Relaciona una persona con una obra que involucra una responsabilidad como supervisor académico de investigación de tesis o tesina para un grado académico que resulta en una obra."],"et":["Seostab isiku teosega, mis sisaldab akadeemilise juhendaja vastutust akadeemilise kraadi saamiseks tehtava ja teoses väljenduva uurimistöö eest."],"fi":["Liittää henkilön teokseen, joka sisältää vastuun akateemisen opinnäytteen tai väitöskirjan ohjaamisesta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité en tant que superviseur académique de travaux de thèse ou de mémoire menant à l’obtention d’un grade universitaire et entraînant la création d’une œuvre."],"hu":["Hozzákapcsol egy személyt egy műhöz, amely magában foglalja egy tudományos fokozattal kapcsolatos szakdolgozat vagy egy disszertációs kutatás tudományos témavezetőjének a felelősségét, amely egy művet eredményez."],"it":["Correla una persona a un'opera che implica una responsabilità come supervisore accademico di una tesi o dissertazione di ricerca per una titolo accademico che si concretizza in un'opera."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību, esot par akadēmisko vadītāju promocijas darba pētījumam, kura rezultātā radīts darbs."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid als een academische begeleider van scriptie- of proefschriftonderzoek voor een academische graad dat resulteert in een werk."],"no":["Relaterer en person til et verk som involverer ansvar som en akademisk veileder for avhandlinger eller masteroppgaver for en akademisk grad som resulterer i et verk."],"tr":["Bir kişiyi, bir eserle sonuçlanan akademik bir derece için tez veya tez araştırmasının akademik danışmanı olarak sorumluluk içeren eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及作为学位论文学术主管导致一种作品的责任的作品关联起来。"]},"ToolkitLabel":{"ar":"مشرف على درجة أكاديمية","ca":"supervisor de grau acadèmic de","cs":"vedoucí kvalifikační práce (čeho)","da":"hovedvejleder af","de":"Betreuerin/Betreuer einer Hochschulschrift von","de":"Betreuerin/Betreuer einer Hochschulschrift von","el":"επόπτης καθηγητής του","en":"degree supervisor of","es":"supervisor de grado de","et":"väitekirja juhendaja teoses","fi":"opinnäytteen ohjaaja teoksessa","fr":"superviseur de thèse de","hu":"fokozat témavezetője:","it":"correlatore di","lv":"ir promocijas darba vadītājs","nl":"graad-begeleider van","no":"veileder for","tr":"tez danışmanı","zh-Hans-CN":"……的学位导师"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية مشرف أكاديمي على أطروحة أو بحث أكاديمي للحصول على درجة أكاديميةينشأ عنها عمل.","ca":"Obra que implica una responsabilitat com a supervisor acadèmic d’una tesi o una dissertació d’una recerca per a l’obtenció d’un grau acadèmic que dona com a resultat una obra.","cs":"Dílo, které zahrnuje odpovědnost ve funkci školitele při výzkumu pro diplomovou práci nebo disertaci k dosažení akademického titulu, jehož výsledkem je dílo.","da":"Værk, som involverer et ansvar som akademisk vejleder for forskning til en akademisk grads afhandling eller speciale, som resulterer i et værk.","de":"Ein Werk, bei dem eine akademische Betreuerin/ein akademischer Betreuer für die Beratung und Aufsicht von Forschungstätigkeiten im Rahmen einer Hochschularbeit verantwortlich ist, die zur Erlangung eines akademischen Grads und zu einem Werk führen.","de":"Ein Werk, bei dem eine akademische Betreuerin/ein akademischer Betreuer für die Beratung und Aufsicht von Forschungstätigkeiten im Rahmen einer Hochschularbeit verantwortlich ist, die zur Erlangung eines akademischen Grads und zu einem Werk führen.","el":"Ένα έργο που περιλαμβάνει την ευθύνη για την επίβλεψη μιας διατριβής ή διδακτορικής έρευνας για την απόκτηση είτε ενός ανώτερου εκπαιδευτικού επιπέδου πτυχίου είτε διδακτορικού.","en":"A work that involves a responsibility as an academic supervisor of thesis or dissertation research for an academic degree that results in a work.","es":"Una obra que involucra una responsabilidad como supervisor académico de investigación de tesis o tesina para un grado académico que resulta en una obra.","et":"Teos, mis sisaldab akadeemilise juhendaja vastutust akadeemilise kraadi saamiseks tehtava ja teoses väljenduva uurimistöö eest.","fi":"Teos, joka sisältää vastuun akateemisten opinnäytteen tai väitöskirjan ohjaamisesta.","fr":"Œuvre qui comporte une responsabilité en tant que superviseur académique de travaux de thèse ou de mémoire menant à l’obtention d’un grade universitaire et entraînant la création d’une œuvre.","hu":"Egy mű, amely magában foglalja egy tudományos fokozattal kapcsolatos szakdolgozat vagy egy disszertációs kutatás tudományos témavezetőjének a felelősségét, amely egy művet eredményez.","it":"Opera che implica una responsabilità come supervisore accademico di una tesi o dissertazione di ricerca per una titolo accademico che si concretizza in un'opera.","lv":"Darbs, kas ietver personas atbildību, esot par akadēmisko vadītāju promocijas darba pētījumam, kura rezultātā radīts darbs.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid als een academische begeleider van scriptie- of proefschriftonderzoek voor een academische graad dat resulteert in een werk.","no":"Et verk som involverer ansvar som en akademisk veileder for avhandlinger eller masteroppgaver for en akademisk grad som resulterer i et verk.","tr":"Bir çalışmayla sonuçlanan akademik bir derece için tez araştırmasının akademik danışmanı olarak sorumluluk içeren bir çalışma.","zh-Hans-CN":"涉及作为学位论文学术主管导致一种作品的责任的作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50458", "lexicalAlias":"http://rdaregistry.info/Elements/a/academicSupervisorOf.en", "label":"is academic supervisor of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/degreeSupervisorOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50091", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/degreeSupervisorOf.en", "label":"is degree supervisor of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50091", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/degreeSupervisorOf.en", "label":"is degree supervisor of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50150","label":{"ca":"és cartògraf (expressió) de","da":"er kartograf (udtryk) til","de":"ist Kartograf (Expression) von","el":"είναι χαρτογράφος (έκφραση) του","en":"is cartographer of expression of (Deprecated)","fi":"kartantekijänä kartassa (ekspressio)","fr":"est un cartographe (expression) de","hu":"térképésze (kifejezési forma)"},"definition":{"ca":["Relaciona un agent, que contribueix a una expressió d’una obra o bé proporcionant una cartografia addicional o bé modificant la cartografia anterior, amb una expressió."],"da":["Relaterer en agent, der har bidraget til et udtryk af et værk ved at sørge for ekstra kartografi eller ved at modificere tidligere kartografi til et udtryk"],"de":["Setzt einen Akteur, der zu einer Expression eines Werks beiträgt, indem er zusätzliche Kartografie liefert oder vorhandene Kartografie modifiziert, mit einer Expression in Beziehung."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας πρόσθετη χαρτογράφηση ή τροποποιώντας την προηγούμενη χαρτογράφηση, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution of providing additional cartography or modifying previous cartography. (Deprecated)"],"fi":["Liittää toimijan teoksen ekspressioen, joka sisältää täydennettyä kartta-aineistoa tai joka on syntynyt muokkaamalla aiempaa karttateosta."],"fr":["Met un agent qui contribue à une expression d’une œuvre en fournissant une cartographie additionnelle ou en modifiant une cartographie antérieure en relation avec une expression."],"hu":["Egy ágenst (személyt, családot vagy testületet), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy további kartográfiát nyújt, vagy korábbi kartográfiát módosít, hozzákapcsol egy kifejezési formához."]},"ToolkitLabel":{"ca":"cartògraf (expressió) de","da":"kartograf (udtryk) til","de":"Kartograf (Expression) von","el":"χαρτογράφος (έκφραση) του","en":"cartographer of expression of (Deprecated)","fi":"kartta (ekspressio)","fr":"cartographe (expression) de","hu":"térképésze (kifejezési forma)","no":"kartograf (uttrykk) for"},"ToolkitDefinition":{"ca":"Expressió d’una obra que incorpora una contribució que proporciona o bé una cartografia addicional o bé modificant la cartografia anterior.","da":"Udtryk af et værk der inkorporerer et bidrag ved at tilføje ekstra kartografi, eller ved at modificere tidligere kartografi.","de":"Eine Expression eines Werks, bei der ein Akteur zusätzliche Kartografie liefert oder vorhandene Kartografie modifiziert.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά μέσω της παροχής πρόσθετης χαρτογράφησης ή τροποποίησης της προηγούμενης χαρτογράφησης.","en":"An expression that includes a contribution of providing additional cartography or modifying previous cartography. (Deprecated)","fi":"Teoksen ekspressio, joka sisältää täydennettyä kartta-aineistoa tai joka on syntynyt muokkaamalla aiempaa karttateosta.","fr":"Expression d’une œuvre qui intègre une contribution consistant à fournir une cartographie additionnelle ou à modifier une cartographie antérieure.","hu":"Egy mű kifejezési formája, amely hozzájárulást testesít meg azzal, hogy további kartográfiát ad hozzá vagy módosítja a korábbi kartográfiát.","no":"Et uttrykk av et verk som omfatter et bidrag i form av å tilføre ytterligere kartografi eller ved å endre tidligere kartografi."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
