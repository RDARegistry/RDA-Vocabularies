                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/reviserPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50625", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfExpressionOf.en", "label":"is creator person of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50447", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserAgentOf.en", "label":"is reviser agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50615", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerPersonOf.en", "label":"is abridger person of"},{"@id":"http://rdaregistry.info/Elements/a/P50614", "lexicalAlias":"http://rdaregistry.info/Elements/a/arrangerPersonOfMusicOf.en", "label":"is arranger person of music of"},{"@id":"http://rdaregistry.info/Elements/a/P50613", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorPersonOf.en", "label":"is censor person of"},{"@id":"http://rdaregistry.info/Elements/a/P50612", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistPersonOfExpressionOf.en", "label":"is restorationist person of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50622", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberPersonOf.en", "label":"is transcriber person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50593", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/reviserPersonOf.en", "label":"is reviser person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50593", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/reviserPersonOf.en", "label":"is reviser person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50223","label":{"ar":"هو وكيل كاتب سيناريو لـ","ca":"és agent guionista de","cs":"je scénáristou (agentem) (čeho)","da":"er agent, som er manuskriptforfatter af","de":"ist Akteur als Drehbuchautorin/Drehbuchautor von","de":"ist Akteur als Drehbuchautorin/Drehbuchautor von","el":"είναι σεναριογράφος φορέας του","en":"is screenwriter agent of","es":"es agente guionista de","et":"stsenarist (tegija) teoses","fi":"käsikirjoittaja (toimija) teoksessa","fr":"est un agent scénariste de","hu":"forgatókönyvíró ágense a következőnek:","it":"è sceneggiatore agente di","lv":"ir scenārists (aģents)","nl":"is scenarioschrijver-actor van","no":"er manusforfatter for (agent)","tr":"senarist temsilcisidir","zh-Hans-CN":"是……的影视剧编剧行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن تأليف نص سينمائي، أو سيناريو، أو مشهد."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en l’autoria d’un guió, un argument o una escena."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za scénář nebo scénu."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at forfatte en drejebog, et manuskript eller en scene."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist."],"el":["Συνδέει έναν συγγραφέα ενός σεναρίου, των διαλόγων ή των σκηνών, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for authoring a screenplay, script, or scene."],"es":["Relaciona un agente con una obra que involucra la responsabilidad de un agente de ser el autor de un guion o escena."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust stsenaariumi või stseeni kirjutamise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa käsikirjoituksen tai kohtauksen kirjoittamisesta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à être l’auteur d’un scénario, d’un script ou d’une scène."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy forgatókönyv, szövegkönyv vagy jelenet szerzőségéért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente come autore di una sceneggiatura, copione o scena."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par scenārija, uzveduma plāna vai ainas radīšanu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor schrijven van een scenario, script of scène."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av å forfatte et skuespill, et manus eller en scene."],"tr":["Bir temsilciyi, senaryo, metin veya sahne yazmakla görevli bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及写作影视剧剧本、脚本或场景的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل كاتب سيناريو","ca":"agent guionista de","cs":"scénárista (agent) (čeho)","da":"agent, som er manuskriptforfatter af","de":"Akteur als Drehbuchautorin/Drehbuchautor von","de":"Akteur als Drehbuchautorin/Drehbuchautor von","el":"σεναριογράφος φορέας του","en":"screenwriter agent of","es":"agente guionista de","et":"stsenarist (tegija) teoses","fi":"käsikirjoittaja (toimija) teoksessa","fr":"agent scénariste de","hu":"forgatókönyvíró ágense:","it":"sceneggiatore agente di","lv":"ir scenārists (aģents)","nl":"scenarioschrijver-actor van","no":"manusforfatter for (agent)","tr":"senarist temsilcisi","zh-Hans-CN":"……的影视剧编剧行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن تأليف نص سينمائي، أو سيناريو، أو مشهد.","ca":"Obra que implica una responsabilitat d’un agent en l’autoria d’un guió, un argument o una escena.","cs":"Dílo, které zahrnuje odpovědnost agenta za scénář nebo scénu.","da":"Værk, som involverer en agents ansvar for at forfatte en drejebog, et manuskript eller en scene.","de":"Ein Werk, bei dem ein Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της συγγραφής του σεναρίου, των διαλόγων ή των σκηνών.","en":"A work that involves a responsibility of an agent for authoring a screenplay, script, or scene.","es":"Una obra que involucra una responsabilidad de un agente de ser el autor de un guion o escena.","et":"Teos, mis sisaldab tegija vastutust stsenaariumi või stseeni kirjutamise eest.","fi":"Teos, jossa toimija on vastuussa käsikirjoituksen tai kohtauksen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à être l’auteur d’un scénario, d’un script ou d’une scène.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy forgatókönyv, szövegkönyv vagy jelenet szerzőségéért.","it":"Opera che implica la responsabilità di un agente come autore di una sceneggiatura, copione o scena.","lv":"Darbs, kas ietver aģenta atbildību par scenārija, uzveduma plāna vai ainas radīšanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor schrijven van een scenario, script of scène.","no":"Et verk som involverer ansvar for en agent i form av å forfatte et skuespill, et manus eller en scene.","tr":"Bir senaryo, metin veya sahne yazmak için bir temsilcinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及写作影视剧剧本、脚本或场景的一个行为者的责任的一种作品"},"altLabel":{"ar":["كاتب سيناريو"],"ca":["guionista de"],"cs":["scénárista (čeho)"],"da":["manusforfatter af"],"de":["Drehbuchautor von,Drehbuchautor von"],"el":["σεναριογράφος του"],"en":["screenwriter of"],"es":["guionista de"],"et":["stsenarist teoses"],"fi":["käsikirjoittajana teoksessa"],"fr":["scénariste de"],"hu":["forgatókönyvírója:"],"it":["sceneggiatore di"],"nl":["scenarioschrijver van"],