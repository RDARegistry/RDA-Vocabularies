                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50201", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerAgentOf.en", "label":"is producer agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50704", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerCollectiveAgentOf.en", "label":"is television producer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50553", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionProducerPersonOf.en", "label":"is television producer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50215", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/televisionProducerAgentOf.en", "label":"is television producer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50215", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/televisionProducerAgentOf.en", "label":"is television producer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50704","label":{"ar":"هو وكيل جماعي منتج تليفزيوني لـ","ca":"és agent col·lectiu productor de televisió de","cs":"je televizním producentem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er tv-producer af","de":"ist gemeinschaftlicher Akteur als Fernsehproduzentin/Fernsehproduzent von","de":"ist gemeinschaftlicher Akteur als Fernsehproduzentin/Fernsehproduzent von","el":"είναι τηλεοπτικός παραγωγός συλλογικός φορέας του","en":"is television producer collective agent of","es":"es agente colectivo productor de televisión de","et":"teleprodutsent (kollektiiv) teoses","fi":"televisiotuottaja (yhteistoimija) teoksessa","fr":"est un agent collectif produ