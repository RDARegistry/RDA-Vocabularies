                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/reviserFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51078", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfExpressionOf.en", "label":"is creator family of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50744", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en", "label":"is reviser collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P51068", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerFamilyOf.en", "label":"is abridger family of"},{"@id":"http://rdaregistry.info/Elements/a/P51067", "lexicalAlias":"http://rdaregistry.info/Elements/a/arrangerFamilyOfMusicOf.en", "label":"is arranger family of music of"},{"@id":"http://rdaregistry.info/Elements/a/P51066", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorFamilyOf.en", "label":"is censor family of"},{"@id":"http://rdaregistry.info/Elements/a/P51065", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistFamilyOfExpressionOf.en", "label":"is restorationist family of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P51075", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberFamilyOf.en", "label":"is transcriber family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P51046", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/reviserFamilyOf.en", "label":"is reviser family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51046", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/reviserFamilyOf.en", "label":"is reviser family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50593","label":{"ar":"هو شخص مراجع لـ","ca":"és persona revisora de","cs":"j