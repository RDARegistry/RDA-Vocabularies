                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/singerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50603", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerPersonOf.en", "label":"is performer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50084", "lexicalAlias":"http://rdaregistry.info/Elements/a/singerAgentOf.en", "label":"is singer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50602", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/singerPersonOf.en", "label":"is singer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50602", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/singerPersonOf.en", "label":"is singer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50263","label":{"ar":"هو وكيل مطور برمجيات لـ","ca":"és agent desenvolupador de programari de","cs":"je vývojářem softwaru (agentem) (čeho)","da":"er agent, som er softwareudvikler af","de":"ist Akteur als Softwareentwicklerin/Softwareentwickler von","de":"ist Akteur als Softwareentwicklerin/Softwareentwickler von","el":"είναι εκπονητής λογισμικού φορέας του","en":"is software developer agent of","es":"es agente desarrollador de software de","et":"tarkvaraarendaja (tegija) väljenduses","fi":"ohjelmistokehittäjä (toimija) ekspressiossa","fr":"est un agent développeur de logiciel de","hu":"szoftverfejlesztő ágense a következőnek:","it":"è sviluppatore software agente di","lv":"ir programmatūras izstrādātājs (aģents)","nl":"is softwareontwikkelaar-actor van","no":"er programvareutvikler for (agent)","tr":"Yazılımcı temsilcisidir","zh-Hans-CN":"是……的软件开发者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في البحث عن برمجية، أو تصميمها، أو تنفيذها، أو اختبارها."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent en la recerca, el disseny, la posada en marxa o l’examen de programari."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta výzkumem, navrhováním, implementací nebo testováním softwaru."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at researche, designe, implementere eller teste software."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Software untersucht, konzipiert, implementiert oder testet.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Software untersucht, konzipiert, implementiert oder testet."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της έρευνας, του σχεδιασμού, της εφαρμογής ή της δοκιμής του λογισμικού, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of researching, designing, implementing, or testing software."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de investigar, diseñar, implementar o probar software."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, uurides, kavandades, juurutades või testides tarkvara."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu tutkimalla, suunnittelemalla, toteuttamalla tai testaamalla ohjelmistoa."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à effectuer des travaux de recherche, de conception, de mise en œuvre ou de mise à l’essai d’un logiciel."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését szoftver kutatásában, tervezésében, implementálásában vagy tesztelésében."],"it":["Correla un agente a un'espressione che include il contributo da parte di un agente nell'individuare, progettare, implementare o testare un software."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, pētot, izstrādājot, ieviešot vai testējot programmatūru."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door onderzoeken, ontwerpen, toepassen of testen van software."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å undersøke, designe, implementere eller teste programvare."],"tr":["Bir temsilciyi, yazılımın araştırılması, tasarlanması, uygulanması veya test edilmesinde bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括研究、设计、实施或测试软件的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مطور برمجيات","ca":"agent desenvolupador de programari de","cs":"vývojář softwaru (agent) (čeho)","da":"agent, som er softwareudvikler af","de":"Akteur als Softwareentwicklerin/Softwareentwickler von","de":"Akteur als Softwareentwicklerin/Softwareentwickler von","el":"εκπονητής λογισμικού φορέας του","en":"software developer agent of","es":"agente desarrollador de software de","et":"tarkvaraarendaja (tegija) väljenduses","fi":"ohjelmistokehittäjä (toimija) ekspressiossa","fr":"agent développeur de logiciel de","hu":"szoftverfejlesztő ágense:","it":"sviluppatore di software agente di","lv":"ir programmatūras izstrādātājs (aģents)","nl":"softwareontwikkelaar-actor van","no":"programvareutvikler for (agent)","tr":"yazılım geliştirici temsilci","zh-Hans-CN":"……的软件开发者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في البحث عن برمجية، أو تصميمها، أو تنفيذها، أو اختبارها.","ca":"Expressió que inclou una contribució d’un agent en la recerca, el disseny, la posada en marxa o l’examen de programari.","cs":"Vyjádření, které zahrnuje přispění agenta výzkumem, navrhováním, implementací nebo testováním softwaru","da":"Udtryk, som omfatter en agents bidrag ved at researche, designe, implementere eller teste software.","de":"Eine Expression, zu der ein Akteur beiträgt, in