                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/recordistPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50160", "lexicalAlias":"http://rdaregistry.info/Elements/a/recordistAgentOf.en", "label":"is recordist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50620", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/recordistPersonOf.en", "label":"is recordist person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50620", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/recordistPersonOf.en", "label":"is recordist person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50478","label":{"ar":"له كيان مرتبط بوكيل","ca":"té com a entitat relacionada amb un agent","cs":"má entitu související s agentem","da":"har entitet relateret til agent","de":"hat mit Akteur in Beziehung stehende Entität","de":"hat mit Akteur in Beziehung stehende Entität","el":"έχει σχετική οντότητα του φορέα","en":"has related entity of agent","es":"tiene una entidad relacionada con el agente","et":"tegijaga seotud olem","fi":"toimijaan liittyvä entiteetti","fr":"a pour entité en relation avec un agent","hu":"ágens kapcsolódó entitása a következő:","it":"ha come entità correlata di agente","lv":"ar aģentu saistītā entīte","nl":"heeft gerelateerde entiteit van actor","no":"har relatert entitet av agent","tr":"temsilcinin ilgili varlığı ile ilişkilidir","zh-Hans-CN":"有行为者的关联实体"},"definition":{"ar":["يربط وكيلا بكيان مرتبط بوكيل."],"ca":["Relaciona un agent amb una entitat que s’associa amb un agent."],"cs":["Vztahuje agenta k entitě, která je spojená s agentem."],"da":["Relaterer en agent til en entitet, som er knyttet til en agent."],"de":["Setzt einen Akteur in Beziehung zu einer Entität, die mit einem Akteur in Verbindung steht.,Setzt einen Akteur in Beziehung zu einer Entität, die mit einem Akteur in Verbindung steht."],"en":["Relates an agent to an entity that is associated with an agent."],"es":["Relaciona un agente con una entidad que está asociada a un agente."],"et":["Seostab tegija tegijaga seotud olemiga."],"fi":["Liittää toimijan entiteettiin, joka liittyy toimijaan."],"fr":["Met un agent en relation avec une entité qui est associée à un agent."],"hu":["Hozzákapcsol egy ágenst egy entitáshoz, amelyet egy ágenshez társítanak."],"it":["Correla un agente a un'entità associata a un agente."],"lv":["Sasaista aģentu ar entīti, kas saistīta ar aģentu."],"nl":["Relateert een actor aan een entiteit die is geassocieerd met een actor."],"no":["Relaterer en agent til en entitet som forbindes med en agent."],"tr":["Bir temsilciyi, temsilciyle bağlantılı olan bir varlıkla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与和一个行为者有关的一个实体关联起来。"]},"ToolkitLabel":{"ar":"كيان مرتبط بوكيل","ca":"entitat relacionada amb un agent","cs":"entita související s agentem","da":"entitet relateret til agent","de":"Mit Akteur in Beziehung stehende Entität","de":"Mit Akteur in Beziehung stehende Entität","el":"σχετική οντότητα του φορέα","en":"related entity of agent","es":"Entidad vinculada del agente","et":"tegijaga seotud olem","fi":"toimijaan liittyvä entiteetti","fr":"entité en relation avec un agent","hu":"ágens kapcsolódó entitása:","it":"entità correlata di agente","lv":"ar aģentu saistītā entīte","nl":"gerelateerde entiteit van actor","no":"relatert entitet av agent","tr":"temsilcinin ilişkili olduğu varlık","zh-Hans-CN":"行为者的关联实体"},"ToolkitDefinition":{"ar":"كيان يكون مرتبطا بوكيل.","ca":"Entitat que s’associa amb un agent.","cs":"Entita, která je spojená s agentem.","da":"Entitet, som er knyttet til en agent.","de":"Eine Entität, die mit einem Akteur in Verbindung steht.","de":"Eine Entität, die mit einem Akteur in Verbindung steht.","en":"An entity that is associated with an agent.","es":"Una entidad que está asociada a un agente.","et":"Tegijaga seotud olem.","fi":"Entiteetti, joka liittyy toimijaan.","fr":"Entité qui est associée à un agent.","hu":"Egy entitás, amelyet egy ágenshez társítanak.","it":"Entità associata a un agente.","lv":"Entīte, kas saistīta ar aģentu.","nl":"Een entiteit die is geassocieerd met een actor.","no":"En entitet som forbindes med en agent.","tr":"Bir temsilciyle bağlantılı olan bir varlık.","zh-Hans-CN":"和一个行为者有关的一个实体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
