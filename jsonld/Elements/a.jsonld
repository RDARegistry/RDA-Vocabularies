                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/organizerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50320", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfFamily.en", "label":"has related work of family"},{"@id":"http://rdaregistry.info/Elements/a/P50705", "lexicalAlias":"http://rdaregistry.info/Elements/a/organizerCollectiveAgentOf.en", "label":"is organizer collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51007", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/organizerFamilyOf.en", "label":"is organizer family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51007", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/organizerFamilyOf.en", "label":"is organizer family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50554","label":{"ar":"هو شخص منظم لـ","ca":"és persona organitzadora de","cs":"je organizátorem (osobou) (čeho)","da":"er person, som er arrangør af","de":"ist Person als Veranstalterin/Veranstalter von","de":"ist Person als Veranstalterin/Veranstalter von","el":"είναι οργανωτής φορέας του","en":"is organizer person of","es":"es organizador de","et":"korraldaja (isik) teoses","fi":"järjestäjä (henkilö) teoksessa","fr":"est une personne organisatrice de","hu":"szervező személye a következőnek:","it":"è organizzatore persona di","lv":"ir organizators (persona)","nl":"is organisator-persoon van","no":"er arrangør av (person)","tr":"organizatör kişisidir","zh-Hans-CN":"是……的组织者个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن تنظيم مؤتمر أو معرض أو فعالية أخرى ينشأ عنها عمل."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona organitzant un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za pořádání konference, výstavy nebo jiné akce, která dává vzniknout dílu."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at organisere en konference, udstilling eller anden begivenhed, som giver anledning til et værk."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Organisation beziehungsweise Veranstaltung einer Konferenz, einer Ausstellung oder eines anderen Ereignisses verantwortlich ist, aus der/dem ein Werk hervorgeht.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Organisation beziehungsweise Veranstaltung einer Konferenz, einer Ausstellung oder eines anderen Ereignisses verantwortlich ist, aus der ein Werk hervorgeht."],"en":["Relates a person to a work that involves a responsibility of a person for organizing a conference, exhibition, or other event that gives rise to a work."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona en la organización de una conferencia, exposición u otro evento que dé lugar a una obra."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust teosele aluse pannud konverentsi, näituse vm ürituse korraldamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa konferenssin, näyttelyn tai muun tapahtuman järjestämisestä ja jonka seurauksena syntyy teos."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à organiser un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy mű létrejöttét eredményező konferencia, kiállítás vagy más esemény szervezéséért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona nell'organizzazione di una conferenza, mostra o altro evento che dà origine a un'opera."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par konferences, izstādes vai pasākuma organizēšanu."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het organiseren van een conferentie, tentoonstelling of andere gebeurtenis die aanleiding geeft tot een werk."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å organisere en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk."],"tr":["Bir kişiyi, bir esere yol açan bir konferans, sergi veya başka bir etkinlik düzenleme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及组织产生一种作品的会议、展览或其他事件的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص منظم","ca":"persona organitzadora de","cs":"organizátor (osoba) (čeho)","da":"person, som er arrangør af","de":"Person als Veranstalterin/Veranstalter von","de":"Person als Veranstalterin/Veranstalter von","el":"οργανωτής φορέας του","en":"organizer person of","es":"organizador de","et":"korraldaja (isik) teoses","fi":"järjestäjä (henkilö) teoksessa","fr":"personne organisatrice de","hu":"szervező személye:","it":"organizzatore persona di","lv":"ir organizators (persona)","nl":"organisator-persoon van","no":"arrangør av (person)","tr":"organizatör kişisi","zh-Hans-CN":"……的组织者个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن تنظيم مؤتمر أو معرض أو فعالية أخرى ينشأ عنها عمل.","ca":"Obra que implica una responsabilitat d’una persona organitzant un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.","cs":"Dílo, které zahrnuje odpovědnost osoby za pořádání konference, výstavy nebo jiné akce, která dává vzniknout dílu.","da":"Værk, som involverer en persons ansvar for at organisere en konference, udstilling eller anden begivenhed, som giver anledning til et værk.","de":"Ein Werk, bei dem eine Person für die Organisation beziehungsweise Veranstaltung einer Konferenz, einer Ausstellung oder eines anderen Ereignisses verantwortlich ist, aus der/dem ein Werk hervorgeht.","de":"Ein Werk, bei dem eine Person für die Organisation einer Konferenz, Ausstellung oder anderen Veranstaltung verantwortlich ist, aus der ein Werk hervorgeht.","en":"A work that involves a responsibility of a person for organizing a conference, exhibition, or other event that gives rise to a work.","es":"Una obra que implica la responsabilidad de una persona en la organización de una conferencia, exposición u otro evento que dé lugar a una obra.","et":"Teos, mis sisaldab isiku vastutust teosele aluse pannud konverentsi, näituse vm ürituse korraldamise eest.","fi":"Teos, jossa henkilö on vastuussa konferenssin, näyttelyn tai muun tapahtuman järjestämisestä ja jonka seurauksena syntyy teos.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à organiser un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy mű létrejöttét eredményező konferencia, kiállítás vagy más esemény szervezéséért.","it":"Opera che implica una responsabilità di una persona nell'organizzazione di una conferenza, mostra o altro evento che dà origine a un'opera.","lv":"Darbs, kas ietver personas atbildību par konferences, izstādes vai pasākuma organizēšanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het organiseren van een conferentie, tentoonstelling of andere gebeurtenis die aanleiding geeft tot een werk.","no":"Et verk som involverer et ansvar for en person i form av å organisere en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk.","tr":"Bir konferansı, sergiyi ya da bir çalışmaya yol açan başka bir etkinliği düzenlemek için bir kişinin sorumluluğunu içeren bir çalışma","zh-Hans-CN":"涉及组织产生一种作品的会议、展览或其他事件的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"h