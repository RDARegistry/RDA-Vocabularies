                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50367", "lexicalAlias":"http://rdaregistry.info/Elements/a/subjectCollectiveAgentOf.en", "label":"is subject collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50426", "lexicalAlias":"http://rdaregistry.info/Elements/a/agentDescribedBy.en", "label":"is agent described by"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/collectiveAgentDescribedBy.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50370", "lexicalAlias":"http://rdaregistry.info/Elements/a/familyDescribedBy.en", "label":"is family described by"},{"@id":"http://rdaregistry.info/Elements/a/P50369", "lexicalAlias":"http://rdaregistry.info/Elements/a/corporateBodyDescribedBy.en", "label":"is corporate body described by"},{"@id":"http://rdaregistry.info/Elements/a/P51109", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectiveAgentDescribedWithMetadataBy.en", "label":"is collective agent described with metadata by"},{"@id":"http://rdaregistry.info/Elements/a/object/P50427", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collectiveAgentDescribedBy.en", "label":"is collective agent described by"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50427", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collectiveAgentDescribedBy.en", "label":"is collective agent described by"}]},{"@id":"http://rdaregistry.info/Elements/a/P50045","label":{"ar":"هو وكيل جامع لـ","ca":"és agent col·leccionista de","da":"er agent, som er samler af","de":"ist Akteur als Sammlerin/Sammler von","el":"είναι συλλέκτης φορέας του","en":"is collector agent of (Deprecated)","et":"kogu moodustaja (tegija) eksemplarile","fi":"kokoelman muodostaja (toimija) kappaleessa","fr":"est un agent collectionneur de","hu":"kollektor ágense a következőnek:","it":"è collezionista agente di","lv":"ir kolekcionārs (aģents)","nl":"is verzamelaar-actor van","no":"er samler av (agent)"},"definition":{"ar":["يربط وكيلا بمفردة جمعها وكيل مع مفردات من مصادر مختلفة رُتبت وُوصفت وفُهرست كمجموعة."],"ca":["Relaciona un agent amb un ítem que és aplegat per un agent amb ítems de diverses fonts que s’arrangen, es descriuen o es cataloguen com una col·lecció."],"da":["Relaterer en agent til et eksemplar, som er sammenført af en agent med eksemplarer fra forskellige kilder, som er arrangeret, beskrevet og katalogiseret som en samling."],"de":["Setzt einen Akteur in Beziehung zu einem Exemplar, das von einem Akteur mit Materialien aus unterschiedlichen Quellen zusammengetragen wird, die dann als Sammlung geordnet, beschrieben oder katalogisiert werden."],"el":["Συνδέει έναν έφορο, ο οποίος συγκεντρώνει αντικείμενα από διάφορες πηγές, τα οποία εν συνεχεία οργανώνονται, περιγράφονται και καταλογογραφούνται ως μία συλλογή από αντικείμενα, με ένα αντικείμενο."],"en":["Relates an agent to an item that is brought together by an agent with items from various sources that are arranged, described, or catalogued as a collection. (Deprecated)"],"et":["Seostab tegija eksemplariga, mille tegija on kokku pannud teiste eri allikatest kogutud eksemplaridega, mis on korrastatud, kirjeldatud ja kataloogitud koguna."],"fi":["Liittää toimijan kappaleeseen, jonka toimija on koonnut järjestetyksi, kuvailluksi tai luetteloiduksi kokoelmaksi eri lähteistä olevista kappaleista."],"fr":["Met un agent en relation avec un item qui est regroupé par un agent avec des items de diverses sources qui sont arrangés, décrits ou catalogués comme une collection de ressources."],"hu":["Hozzákapcsol egy ágenst egy példányhoz, amely egy ágens különböző forrásokból származó, gyűjteményként rendezett, leírt és katalogizált példányokkal fog össze."],"it":["Correla un agente a un item che è raccolto insieme da un agente con un item di varie sorgenti che sono organizzati, descritti e catalogati come una raccolta."],"lv":["Sasaista aģentu ar vienību, ko aģents apkopojis kopā ar citām vienībām no dažādiem avotiem, kas ir sakārtotas, aprakstītas un kataloģizētas kā kolekcija."],"nl":["Relateert een actor aan een item dat samengebracht is door een actor met items van diverse bronnen die gearrangeerd, beschreven of gecatalogiseerd zijn als een verzameling."],"no":["Relaterer en agent til et eksemplar som er satt sammen av en agent av eksemplarer fra ulike kilder og som deretter arrangeres, beskrives og katalogiseres som en samling."]},"ToolkitLabel":{"ar":"وكيل جامع","ca":"agent col·leccionista de","da":"agent, som er samler af","de":"Akteur als Sammlerin/Sammler von","el":"συλλέκτης φορέας του","en":"collector agent of (Deprecated)","et":"kogu moodustaja (tegija) eksemplarile","fi":"kokoelman muodostaja (toimija) kappaleessa","fr":"agent collectionneur de","hu":"kollektor ágense:","it":"collezionista agente di","lv":"ir kolekcionārs (aģents)","nl":"verzamelaar-actor van","no":"samler av (agent)"},"ToolkitDefinition":{"ar":"مفردة جمعها وكيل مع مفردات من مصادر مختلفة رُتبت ووُصفت وفُهرست كمجموعة.","ca":"Ítem que és aplegat per un agent amb ítems de diverses fonts que s’arrangen, es descriuen o es cataloguen com una col·lecció.","da":"Eksemplar, som er sammenført af en agent med eksemplarer fra forskellige kilder, som er arrangeret, beskrevet og katalogiseret som en samling.","de":"Ein Exemplar, das von einem Akteur mit Materialien aus unterschiedlichen Quellen zusammengetragen wird, die dann als Sammlung geordnet, beschrieben oder katalogisiert werden.","el":"Ένα τεκμήριο που συνενώνεται με τεκμήρια από διάφορες πηγές τα οποία εν συνεχεία οργανώνονται, περιγράφονται και καταλογογραφούνται ως μία συλλογή.","en":"An item that is brought together by an agent with items from various sources that are arranged, described, or catalogued as a collection. (Deprecated)","et":"Eksemplar, mille tegija on kokku pannud teiste eri allikatest kogutud eksemplaridega, mis on korrastatud, kirjeldatud ja kataloogitud koguna.","fi":"Kappale, jonka toimija on koonnut osaksi järjestettyä, kuvailtua tai luetteloitua kokoelmaa yhdessä muiden eri lähteistä olevien kappaleiden kanssa.","fr":"Item qui est regroupé par un agent avec des items de diverses sources qui sont arrangés, décrits ou catalogués comme une collection de ressources.","hu":"Egy példány, amelyet egy ágens különböző forrásokból származó, gyűjteményként rendezett, leírt és katalogizált példányokkal fog össze.","it":"Item che è raccolto insieme da agente con item di varie sorgenti che sono organizzati, descritti e catalogati come una raccolta","lv":"Vienība, ko aģents apkopojis kopā ar citām vienībām no dažādiem avotiem, kas ir sakārtotas, aprakstītas un kataloģizētas kā kolekcija.","nl":"Een item dat samengebracht is door een actor met items van diverse bronnen die gearrangeerd, beschreven of gecatalogiseerd zijn als een verzameling.","no":"Et eksemplar som er satt sammen av en agent av eksemplarer fra ulike kilder og som deretter arrangeres, beskrives og katalogiseres som en samling."},"altLabel":{"ar":["جامع لـ"],"ca":["col·leccionista de"],"da":["samler af"],"de":["Sammlerin/Sammler von"],"el":["συλλέκτης του"],"en":["collector of"],"et":["kogu moodustaja eksemplarile,koguja eksemplarile"],"fi":["kokoelma"],"fr":["collectionneur de"],"hu":["kollektora:"],"it":["collezionista di"],"no":["samler av"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50133", "lexicalAlias":"http://rdaregistry.info/Elements/a/curatorAgentOf.en", "label":"is curator agent of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/collectorAgentOf.en","instructionNumber":"18.5","status": {
