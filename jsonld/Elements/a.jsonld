                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50205", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOf.en", "label":"is director agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50714", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorCollectiveAgentOf.en", "label":"is radio director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50563", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorPersonOf.en", "label":"is radio director person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50049", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/radioDirectorAgentOf.en", "label":"is radio director agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50049", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/radioDirectorAgentOf.en", "label":"is radio director agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50714","label":{"ar":"هو وكيل جماعي مخرج إذاعي لـ","ca":"és agent col·lectiu realitzador radiofònic de","cs":"je rozhlasovým režisérem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er radioregissør af","de":"ist gemeinschaftlicher Akteur als Hörfunkregisseurin/Hörfunkregisseur von","de":"ist gemeinschaftlicher Akteur als Hörfunkregisseurin/Hörfunkregisseur von","el":"είναι διευθυντής ραδιοφώνου συλλογικός φορέας του","en":"is radio director collective agent of","es":"es agente colectivo director de radio de","et":"raadiorežissöör (kollektiiv) teoses","fi":"radio-ohjaaja (yhteistoimija) teoksessa","fr":"est un agent collectif réalisateur de radio de","hu":"rádiós rendező kollektív ágense a következőnek:","it":"è regista radiofonico agente collettivo di","lv":"ir radio raidījuma direktors (grupa)","nl":"is radioregisseur-collectieve actor van","no":"er radioregissør for (kollektiv agent)","tr":"radyo yönetmeni kolektif temsilcisidir","zh-Hans-CN":"是……的广播导演集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن الإدارة العامة والإشراف على برنامج إذاعي."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la gestió general i la supervisió d’un programa radiofònic."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za obecné řízení a dohled nad rozhlasovým programem."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for den generelle ledelse af- og tilsyn med et radioprogram."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for the general management and supervision of a radio program."],"es":["Relaciona un agente colectivo con una obra que implica una responsabilidad de un agente colectivo para la dirección general y supervisión de un programa de radio."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust raadiosaate üldise juhtimise ja juhendamise eest."],"fi":["Liittää yhteistoimijan teokseen, joka sisältää vastuun radio-ohjelman yleisestä johtamisesta ja valvonnasta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à assurer la gestion et la supervision générales d’une émission de radio."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy rádióműsor általános menedzseléséért és felügyeletéért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per la gestione e supervisione generale di un programma radiofonico."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par radio raidījuma vispārējo vadību un uzraudzību."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het algemeen beheer en toezicht van een radioprogramma."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent for den generelle ledelsen og tilsyn med et radioprogram."],"tr":["Kolektif bir temsilciyi, bir radyo programının genel yönetimi ve denetimi için kolektif bir temsilcinin sorumluluğunu içeren bir eserle ile bir ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及广播节目的总体管理和监督的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مخرج إذاعي","ca":"agent col·lectiu realitzador radiofònic de","cs":"rozhlasový režisér (kolektivní agent) (čeho)","da":"kollektiv agent, som er radioregissør af","de":"Gemeinschaftlicher Akteur als Hörfunkregisseurin/Hörfunkregisseur von","de":"Gemeinschaftlicher Akteur als Hörfunkregisseurin/Hörfunkregisseur von","el":"διευθυντής ραδιοφώνου συλλογικός φορέας του","en":"radio director collective agent of","es":"agente colectivo director de radio de","et":"raadiorežissöör (kollektiiv) teoses","fi":"radio-ohjaaja (yhteistoimija) teoksessa","fr":"agent collectif réalisateur de radio de","hu":"rádiós rendező kollektív ágense:","it":"regista radiofonico agente collettivo di","lv":"ir radio raidījuma direktors (grupa)","nl":"radioregisseur-collectieve actor van","no":"radioregissør for (kollektiv agent)","tr":"radyo yönetmeni kolektif temsilcisi","zh-Hans-CN":"……的广播导演集体行为者"},"ToolkitDefi