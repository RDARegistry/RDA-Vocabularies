                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/choralConductorAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50070", "lexicalAlias":"http://rdaregistry.info/Elements/a/conductorAgentOf.en", "label":"is conductor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50740", "lexicalAlias":"http://rdaregistry.info/Elements/a/choralConductorCollectiveAgentOf.en", "label":"is choral conductor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50589", "lexicalAlias":"http://rdaregistry.info/Elements/a/choralConductorPersonOf.en", "label":"is choral conductor person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50268", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/choralConductorAgentOf.en", "label":"is choral conductor agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50268", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/choralConductorAgentOf.en", "label":"is choral conductor agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50740","label":{"ar":"هو وكيل جماعي قائد كورال لـ","ca":"és agent col·lectiu director de cor de","cs":"je sborovým dirigentem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er kordirigent af","de":"ist gemeinschaftlicher Akteur als Chorleiterin/Chorleiter von","de":"ist gemeinschaftlicher Akteur als Chorleiterin/Chorleiter von","el":"είναι διευθυντής χορωδίας συλλογικός φορέας του","en":"is choral conductor collective agent of","es":"es agente colectivo director coral de","et":"koorijuht (kollektiiv) väljenduses","fi":"kuoronjohtaja (yhteistoimija) ekspressiossa","fr":"est un agent collectif chef de chœur de","hu":"kórusvezető kollektív ágense a következőnek:","it":"è direttore di coro agente collettivo di","lv":"ir kordiriģents (grupa)","nl":"is koordirigent-collectieve actor van","no":"er kordirigent for (kollektiv agent)","tr":"koro şefi kolektif temsilcisidir","zh-Hans-CN":"是……的合唱指挥集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في قيادة فريق كورال في عرض موسيقي أو درامي."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu dirigint una coral en una representació musical o dramàtica."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že řídí pěvecký sbor v hudebním nebo dramatickém vystoupení."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at lede et optrædende kor i en musikalsk eller dramatisk præsentation."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er einen Chor in einer musikalischen oder dramatischen Darbietung leitet."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of leading a choral performing group in a musical or dramatic presentation."],"es":["Relaciona un agente colectivo con una expresión que incluye la contribución de un agente colectivo de liderar un grupo coral en una presentación musical o dramática."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, juhatades koori muusika- või draamaetenduses"],"fi":["Liittää yhteistoimijan ekspressioon, jonka tekemisessä yhteistoimija on osallisena johtamalla kuoroa musiikki- tai näytelmäesityksessä."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à diriger un groupe de choristes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy zenei vagy drámai bemutatóban énekkari előadó csoportot vezető kollektív ágens közreműködését."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nella direzione di un gruppo di esecuzione corale in una presentazione musicale o drammatica."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, diriģējot izpildītājmākslinieku grupu mūzikas vai dramatiskā uzvedumā."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door leiden van een optredende koorgroep in een muzikale of dramatische presentatie."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av ledelse av et kor i en musikalsk eller dramatisk forestilling."],"tr":["Kolektif bir temsilciyi, müzikal veya drama gösteriminde bir koro performans grubuna liderlik eden bir kolektif temsilcinin katkısını içeren anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括在音乐或戏剧呈现中领导一个合唱表演团队的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي قائد كورال","ca":"agent col·lectiu director de cor de","cs":"sborový dirigent (kolektivní agent) (čeho)","da":"kollektiv agent, som er kordirigent af","de":"Gemeinschaftlicher Akteur als Chorleiterin/Chorleiter von","de":"Gemeinschaftlicher Akteur als Chorleiterin/Chorleiter von","el":"διευθυντής χορωδίας συλλογικός φορέας του","en":"choral conductor collective agent of","es":"agente colectivo director coral de","et":"koorijuht (kollektiiv) väljenduses","fi":"kuoronjohtaja (yhteistoimija) ekspressiossa","fr":"agent collectif chef de chœur de","hu":"kórusvezető kollektív ágense:","it":"direttore di coro agente collettivo di","lv":"ir kordiriģents (grupa)","nl":"koordirigent-collectieve actor van","no":"kordirigent for (koll