                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50550", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerPersonOf.en", "label":"is producer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50213", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerAgentOf.en", "label":"is film producer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50551", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/filmProducerPersonOf.en", "label":"is film producer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50551", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/filmProducerPersonOf.en", "label":"is film producer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50104","label":{"ar":"له مهنة أو وظيفة","ca":"té com a professió o ocupació","cs":"má profesi nebo povolání","da":"har profession eller beskæftigelse","de":"hat Beruf oder Tätigkeit","de":"hat Beruf oder Tätigkeit","el":"έχει επάγγελμα ή απασχόληση","en":"has profession or occupation","es":"tiene profesión u ocupación","et":"elukutse või amet","fi":"henkilön ammatti tai tehtävä","fr":"a pour profession ou occupation","hu":"szakterülete vagy foglalkozása a következő:","it":"ha come professione o occupazione","lv":"profesija vai nodarbošanās","nl":"heeft beroep of bezigheid","no":"har profesjon eller yrke","sv":"har yrke eller sysselsättning","tr":"iş veya meslek ile ilişkilidir","zh-Hans-CN":"有职业或工作"},"definition":{"ar":["يربط شخصا بصنعة أو بحرفة."],"ca":["Relaciona una persona amb una vocació o dedicació."],"cs":["Vztahuje osobu k povolání."],"da":["Relaterer en person til et erhverv eller bibeskæftigelse."],"de":["Setzt eine Person in Beziehung zu einer Berufung oder Nebenbeschäftigung.,Setzt eine Person in Beziehung zu einer Berufung oder Nebenbeschäftigung."],"el":["Συνδέει ένα φυσικό πρόσωπο με το επάγγελμα ή την ενασχόληση ενός φυσικού προσώπου."],"en":["Relates a person to a vocation or avocation."],"es":["Relaciona una persona con una vocación o pasatiempo."],"et":["Seostab isiku kutseala või kõrvaltegevusega."],"fi":["Liittää henkilön henkilön ammattiin tai harrastukseen."],"fr":["Met une personne en relation avec une profession ou un passe-temps."],"hu":["Hozzákapcsol egy ágenst egy hivatáshoz vagy kiegészítő tevékenységhez."],"it":["Correla una persona a una professione o occupazione"],"lv":["Sasaista personu ar personas profesiju vai nodarbošanos."],"nl":["Relateert een persoon aan een roeping of nevenwerkzaamheden."],"no":["Relaterer en person til en levevei eller et arbeid."],"tr":["Bir kişiyi, kişinin mesleği ya da hobisiyle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个职业或爱好关联起来。"]},"ToolkitLabel":{"ar":"مهنة أو وظيفة","ca":"professió o ocupació","cs":"profese nebo povolání","da":"profession eller beskæftigelse","de":"Beruf oder Tätigkeit","de":"Beruf oder Tätigkeit","el":"επάγγελμα ή απασχόληση","en":"profession or occupation","es":"Profesión u ocupación","et":"elukutse või amet","fi":"henkilön ammatti tai tehtävä","fr":"profession ou occupation","hu":"szakterülete vagy foglalkozása:","it":"professione o occupazione","lv":"profesija vai nodarbošanās","nl":"beroep of bezigheid","no":"profesjon eller yrke","sv":"yrke eller sysselsättning","tr":"uzmanlığı veya mesleği","zh-Hans-CN":"职业或工作"},"ToolkitDefinition":{"ar":"صنعة أو بحرفة.","ca":"Vocació o dedicació.","cs":"Profese nebo povolání.","da":"Erhverv eller bibeskæftigelse.","de":"Eine Berufung oder Nebenbeschäftigung.","de":"Eine Berufung oder Nebenbeschäftigung.","el":"Το επάγγελμα ή η ενασχόληση ενός φυσικού προσώπου.","en":"A vocation or avocation.","es":"Una vocación o pasatiempo.","et":"Kutseala või kõrvaltegevus.","fi":"Henkilön ammatti tai harrastus.","fr":"Profession ou passe-temps.","hu":"Egy hivatás vagy kiegészítő tevékenység.","it":"Professione o occupazione.","lv":"Personas profesija vai nodarbošanās.","nl":"Een roeping of nevenwerkzaamheden.","no":"En levevei eller et arbeid.","tr":"Bir meslek veya uğraşı.","zh-Hans-CN":"职业或爱好"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/professionOrOccupation.en","instructionNumber":"9.16","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50104", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/professionOrOccupation.en", "label":"has profession or occupation"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50104", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/professionOrOccupation.en", "label":"has profession or occupation"}]},{"@id":"http://rdaregistry.info/Elements/a/P50135","label":{"ca":"és agrimensor de","da":"er landmåler i","de":"ist Landvermesser von","el":"είναι τοπογράφος μηχανικός του","en":"is surveyor of (Deprecated)","fi":"maanmittaus","fr":"est un arpenteur de","hu":"földmérője"},"definition":{"ca":["Relaciona un agent, que contribueix a una expressió d’una obra cartogràfica proporcionant mesuraments o relacions dimensionals d’una àrea geogràfica representada, amb una expressió."],"da":["Relaterer en agent, der har bidraget til et udtryk af et kartografisk værk ved at sørge for opmålinger eller målestoksforhold til et repræsenteret geografisk område til et udtryk."],"de":["Setzt einen Akteur, der an der Expression eines kartografischen Werks mitwirkt, indem er Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt, mit einer Expression in Beziehung."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός χαρτογραφικού έργου παρέχοντας μετρήσεις ή σχέσεις διαστάσεων για τη γεωγραφική περιοχή που παρουσιάζεται, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution of providing measurements or dimensional relationships for a geographic area that is represented in a cartographic work. (Deprecated)"],"fi":["Liittää toimijan kartografisen teoksen ekspressioon, johon sisältyy maantieteellisen alueen mittojen tai mittasuhteiden kuvaaminen."],"fr":["Met un agent qui contribue à une expression d’une œuvre cartographique en fournissant les mesures ou les relations dimensionnelles pour l’aire géographique représentée en relation avec une expression."],"hu":["Egy ágenst (személyt, családot vagy testületet), aki/amely egy kartográfiai mű kifejezési formájához hozzájárul azzal, hogy megadja egy ábrázolt földrajzi terület méreteit vagy dimenzionális kapcsolatait, hozzákapcsolja egy kifejezési formához."]},"ToolkitLabel":{"ca":"agrimensor de","da":"landmåler i","de":"Landvermesser von","el":"τοπογράφος μηχανικός του","en":"surveyor of (Deprecated)","fi":"maanmittaus","fr":"arpenteur de","hu":"földmérője","no":"landmåler for"},"ToolkitDefinition":{"ca":"Expressió d’una obra cartogràfica que incorpora una contribució que proporciona mesuraments o relacions dimensionals d’una àrea geogràfica representada.","da":"Udtryk af et kartografisk værk, der inkorporerer et bidrag der sørger for opmålinger eller målestoksforhold til et repræsenteret geografisk område.","de":"Eine Expression eines kartografischen Werks, bei der ein Akteur Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.","el":"Μια έκφραση ενός χαρτογραφικού έργου που ενσωματώνει τη συνεισφορά της παροχής μετρήσεων ή σχέσεων διαστάσεων για τη γεωγραφική περιοχή που παρουσιάζεται με μια έκφραση.","en":"An expression that includes a contribution of providing measurements or dimensional relationships for a geographic area that is represented in a cartographic work. (Deprecated)","fi":"Kartografisen teoksen ekspressio, johon sisältyy maantieteellisen alueen mittojen tai mittasuhteiden kuvaaminen.","fr":"Expression d’une œuvre cartographique qui intègre une contribution consistant à fournir des mesures ou des relations dimensionnelles pour une aire géographique représentée.","hu":"Egy kartográfiai mű, amely hozzájárulást jelent azzal, hogy mérési értékeket vagy dimenzionális kapcsolatokat közöl a megjelenített földrajzi területre vonatkozóan.","no":"Et uttrykk av et kartografisk verk som omfatter et bidrag i form av å tilføre målinger eller størrelsesforhold for et geografisk område som gjengis."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50451", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorToAggregatedContentOf.en", "label":"is contributor to aggregated content of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/surveyorOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50135", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/surveyorOf.en", "label":"is surveyor of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50135", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/surveyorOf.en", "label":"is surveyor of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50163","label":{"ar":"هو وكيل مالك سابقا","ca":"és agent propietari anterior de","cs":"je bývalým vlastníkem (agentem) (čeho)","da":"er agent, som er tidligere ejer af","de":"Ist Akteur als frühere Eigentümerin/früherer Eigentümer von","de":"Ist Akteur als frühere Eigentümerin/früherer Eigentümer von","el":"είναι προηγούμενος κάτοχος φορέας του","en":"is former owner agent of","es":"es agente dueño anterior de","et":"endine omanik (tegija) eksemplarile","fi":"entinen omistaja (toimija) kappaleessa","fr":"est un ancien agent propriétaire de","hu":"korábbi tulajdonos ágense a következőnek:","it":"è precedente proprietario agente di","lv":"ir agrākais īpašnieks (aģents)","nl":"is voormalige eigenaar-actor van","no":"er tidligere eier av (agent)","tr":"eski sahip temsilcisidir","zh-Hans-CN":"是……的先前拥有者行为者"},"definition":{"ar":["يربط وكيلا بمفردة تنطوي على مسئولية وكيل عن الملكية القانونية السابقة."],"ca":["Relaciona un agent amb un ítem que implica una responsabilitat d’un agent en la possessió legal anterior."],"cs":["Vztahuje agenta k jednotce, která zahrnuje odpovědnost agenta za dřívější zákonné držení."],"da":["Relaterer en agent til et eksemplar, som involverer en agents ansvar for tidligere at have haft lovlig besiddelse."],"de":["Setzt einen Akteur in Beziehung zu einem Exemplar, das früher im rechtmäßigen Besitz eines Akteurs war.,Setzt einen Akteur in Beziehung zu einem Exemplar, das früher im rechtmäßigen Besitz eines Akteurs war."],"el":["Συνδέει έναν φορέα, ο οποίος είχε προηγούμενα τη νόμιμη κατοχή ενός αντιτύπου, με ένα αντίτυπο."],"en":["Relates an agent to an item that involves a responsibility of an agent for former legal possession."],"es":["Relaciona un agente con un ítem que involucra una responsabilidad de un agente de posesión legal anterior."],"et":["Seostab tegija eksemplariga, mis kuulus varem õiguspäraselt tegijale."],"fi":["Liittää toimijan kappaleeseen, jonka toimija on aiemmin laillisesti omistanut."],"fr":["Met un agent en relation avec un item qui comporte une responsabilité de la part d’un agent en ce qui concerne la propriété légale antérieure."],"hu":["Hozzákapcsol egy ágenst egy példányhoz, amelyhez hozzátartozik egy ágens korábbi tulajdonjog iránti felelőssége."],"it":["Correla un agente con itemche implica la responsabilità di un agente nel possesso legale precedente."],"lv":["Sasaista aģentu ar vienību, kas ietver aģenta atbildību par bijušo likumīgo īpašumu."],"nl":["Relateert een actor aan een item dat met zich meebrengt een verantwoordelijkheid van een actor betreffende voormalig wettelijk bezit."],"no":["Relaterer en agent til et eksemplar som involverer ansvar for en agen i form av å være en tidligere rettmessig eier."],"tr":["Bir temsilciyi, önceki yasal mülkiyet için bir temsilcinin sorumluluğunu içeren bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及一个先前法定所有权的一个行为者的责任的一个单件关联起来。"]},"ToolkitLabel":{"ar":"وكيل مالك سابقا","ca":"agent propietari anterior de","cs":"bývalý vlastník (agent) (čeho)","da":"agent, som er tidligere ejer af","de":"Akteur als 