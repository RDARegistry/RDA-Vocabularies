                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50032", "lexicalAlias":"http://rdaregistry.info/Elements/a/nameOfCorporateBody.en", "label":"has name of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/P50414", "lexicalAlias":"http://rdaregistry.info/Elements/a/preferredNameOfCollectiveAgent.en", "label":"has preferred name of collective agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/preferredNameOfCorporateBody.en","instructionNumber":"11.2.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50041", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/preferredNameOfCorporateBody.en", "label":"has preferred name of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50041", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/preferredNameOfCorporateBody.en", "label":"has preferred name of corporate body"}]},{"@id":"http://rdaregistry.info/Elements/a/P50032","label":{"ar":"لها اسم هيئة","ca":"té com a nom d’entitat corporativa","cs":"má jméno korporace","da":"har navn på korporation","de":"hat Namen einer Körperschaft","de":"hat Namen einer Körperschaft","el":"έχει όνομα του συλλογικού οργάνου","en":"has name of corporate body","es":"tiene nombre de organismo corporativo","et":"asutuse nimi","fi":"yhteisön nimi","fr":"a pour nom de collectivité","hu":"testület neve a következő:","lv":"institūcijas vārds/nosaukums","nl":"heeft naam van corporatie","no":"har korporasjonsnavn","sv":"har institutionsnamn","tr":"tüzel kişinin adı ile ilişkilidir","zh-Hans-CN":"有团体的名称"},"definition":{"ar":["يربط هيئة بمسمى هيئة في اللغة الطبيعية وفي العبارات المستخدمة في الخطاب العام"],"ca":["Relaciona una entitat corporativa amb un nomen que és una apel·lació d’entitat corporativa en llenguatge i frases naturals usada en el discurs comú."],"cs":["Vztahuje korporaci k nomen, které je pojmenováním korporace v přirozeném jazyce a frázích používaných v běžném diskurzu."],"da":["Relaterer en korporation til en benævnelse på korporation på normalsprog og med formuleringer, som bruges alment."],"de":["Setzt eine Körperschaft in Beziehung zu einer Bezeichnung für eine Körperschaft in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.,Setzt eine Körperschaft in Beziehung zu einer Bezeichnung für eine Körperschaft in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird."],"el":["Συνδέει ένα συλλογικό όργανο με μια ονομασία ενός συλλογικού οργάνου σε φυσική γλώσσα και διατύπωση χρησιμοποιούμενη στην καθομιλουμένη."],"en":["Relates a corporate body to a nomen that is an appellation of corporate body in natural language and phrasing used in common discourse."],"es":["Relaciona un organismo corporativo con un nomen que es una apelación de un organismo corporativo en lenguaje natural y fraseo usado en el discurso común."],"et":["Seostab asutuse asutuse nimetusega loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses."],"fi":["Liittää yhteisön nomeniin, joka on luonnollisella kielellä ja sanamuodolla oleva, yleisessä diskurssissa käytetty nimitys yhteisöstä."],"fr":["Met une collectivité en relation avec un nomen qui est une appellation de collectivité exprimée dans un langage et une formulation naturels et utilisée dans le langage courant."],"hu":["Hozzákapcsol egy testületet egy nomenhez, amely egy testület megnevezése természetes nyelven és közbeszédben használt kifejezéssel."],"lv":["Sasaista institūciju ar nomenu, kas ir institūcijas apzīmējums dabiskajā valodā, ko izmanto savstarpējā saziņā."],"nl":["Relateert een corporatie aan een nomen dat is een benaming van corporatie in natuurlijke taal en formulering gebruikt in alledaags taalgebruik."],"no":["Relaterer en korporasjon til en betegnelse for korporasjon på et naturlig språk og med frasering brukt i alminnelig diskurs."],"tr":["Bir tüzel kişiyi, doğal dilde ve ortak söylemde kullanılan ifadelerde tüzel kuruluşun bir adı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一个团体与作为用自然语言和普通话语措词表达的团体的称谓的一个命名关联起来。"]},"ToolkitLabel":{"ar":"اسم هيئة","ca":"nom d’entitat corporativa","cs":"jméno korporace","da":"navn på korporation","de":"Name einer Körperschaft","de":"Name einer Körperschaft","el":"όνομα του συλλογικού οργάνου","en":"name of corporate body","es":"nombre de organismo corporativo","et":"asutuse nimi","fi":"yhteisön nimi","fr":"nom de collectivité","hu":"testületnév:","lv":"institūcijas vārds/nosaukums","nl":"naam van corporatie","no":"korporasjonsnavn","sv":"institutionsnamn","tr":"tüzel kişiliğin adı","zh-Hans-CN":"团体的名称"},"ToolkitDefinition":{"ar":"تسمية هيئة في اللغة الطبيعية وفي العبارات المستخدمة في الخطاب العام.","ca":"Nomen que és una apel·lació d’entitat corporativa en llenguatge i frases naturals usada en el discurs comú.","cs":"Nomen, které je pojmenováním korporace v přirozeném jazyce a frázích používaných v běžném diskurzu.","da":"Nomen, som er en benævnelse på korporation på normalsprog og med formuleringer, som bruges alment.","de":"Eine Bezeichnung für eine Körperschaft in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.","de":"Eine Bezeichnung für eine Körperschaft in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.","el":"Μια λέξη, χαρακτήρας ή ομάδα λέξεων ή/και χαρακτήρων με τους οποίους ένα συλλογικό όργανο είναι γνωστό.","en":"A nomen that is an appellation of corporate body in natural language and phrasing used in common discourse.","es":"Un nomen que es una apelación de un organismo corporativo en lenguaje natural y fraseo usado en el discurso común.","et":"Asutuse nimetus loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses.","fi":"Nomen, joka on yhteisöstä yleisessä diskurssissa käytetty nimitys, joka on luonnollisella kielellä ja luonnollisessa sanamuodossa.","fr":"Nomen qui est une appellation de collectivité exprimée dans un langage et une formulation naturels et utilisée dans le langage courant.","hu":"Egy nomen, amely egy testület megnevezése természetes nyelven és közbeszédben használt kifejezéssel.","lv":"Institūcijas apzīmējums dabiskajā valodā, ko izmanto savstarpējā saziņā.","nl":"Een nomen dat is een benaming van corporatie in natuurlijke taal en formulering gebruikt in alledaags taalgebruik.","no":"En betegnelse for korporasjon på et naturlig språk og med frasering brukt i alminnelig diskurs.","tr":"Doğal dilde ve ortak söylemde kullanılan ifadelerde tüzel kişinin unvanı olan bir isim.","zh-Hans-CN":"作为用自然语言和普通话语措词表达的团体的称谓的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
