                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50305", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfAgent.en", "label":"has related work of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/consultantAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50707", "lexicalAlias":"http://rdaregistry.info/Elements/a/consultantCollectiveAgentOf.en", "label":"is consultant collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50556", "lexicalAlias":"http://rdaregistry.info/Elements/a/consultantPersonOf.en", "label":"is consultant person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50211", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/consultantAgentOf.en", "label":"is consultant agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50211", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/consultantAgentOf.en", "label":"is consultant agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50707","label":{"ar":"هو وكيل جماعي استشاري لـ","ca":"és agent col·lectiu consultor de","cs":"je konzultantem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er rådgiver af","de":"ist gemeinschaftlicher Akteur als Beraterin/Berater von","de":"ist gemeinschaftlicher Akteur als Beraterin/Berater von","el":"είναι σύμβουλος συλλογικός φορέας του","en":"is consultant collective agent of","es":"es agente colectivo consultor de","et":"konsultant (kollektiiv) teoses","fi":"asiantuntija (yhteistoimija) teoksessa","fr":"est un agent collectif consultant de","hu":"tanácsadó kollektív ágense a következőnek:","it":"è consulente agente collettivo di","lv":"ir konsultants (grupa)","nl":"is consultant-collectieve actor van","no":"e