                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50994", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorFamilyOf.en", "label":"is author family of"},{"@id":"http://rdaregistry.info/Elements/a/P50684", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistCollectiveAgentOf.en", "label":"is lyricist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50986", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lyricistFamilyOf.en", "label":"is lyricist family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50986", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lyricistFamilyOf.en", "label":"is lyricist family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50533","label":{"ar":"هو شخص كاتب أغاني لـ","ca":"és persona lletrista de","cs":"je textařem (osobou) (čeho)","da":"er person, som er tekstforfatter af","de":"ist Person als Textdichterin/Textdichter von","de":"ist Person als Textdichterin/Textdichter von","el":"είναι στιχουργός φυσικό πρόσωπο του","en":"is lyricist person of","es":"es letrista de","et":"sõnade autor (isik) teoses","fi":"sanoittaja (henkilö) teoksessa","fr":"est une personne parolière de","hu":"dalszövegíró személye a következőnek:","it":"è paroliere persona di","lv":"ir dziesmas teksta autors (persona)","nl":"is liedtekstschrijver-persoon van","no":"er sangtekstforfatter for (person)","tr":"söz yazarı kişisidir","zh-Hans-CN":"是……的歌词作者"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن تأليف كلمات الأغنية الشعبية، بما في ذلك أغنية من مَسرحية موسيقِيّة."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en l’autoria d’una cançó popular, inclosa una cançó d’un musical."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za autorství textu populární písně včetně písně z muzikálu."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at forfatte ordene til en populær sang, inkl. en sang fra en musical."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for authoring the words of a popular song, including a song from a musical."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona por ser la autora de la letra de una canción popular, incluida una canción de un musical."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust levilaulu (k.a laul muusikalist) sõnade kirjutamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa populaarimusiikkiin kuuluvan laulun (mukaan lukien musikaalilaulun) sanojen kirjoittamisesta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à être l’auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy könyűzenei dalszöveg szerzőségéért, musicaldalt is beleértve."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona come autore delle parole di una canzone, inclusa una canzone di un musical."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par dziesmas vārdiem, ieskaitot dziesmas no mūzikla."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor schrijven van de woorden van een populair lied, inclusief een lied uit een musical."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å være forfatter av teksten til en populær sang, inkludert en sang fra en musikal."],"tr":["Bir kişiyi, bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerini yazma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及流行歌曲（包括音乐剧中的歌曲）歌词的写作的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص كاتب أغاني","ca":"persona lletrista de","cs":"textař (osoba) (čeho)","da":"person, som er tekstforfatter af","de":"Person als Textdichterin/Textdichter von","de":"Person als Textdichterin/Textdichter von","el":"στιχουργός φυσικό πρόσωπο του","en":"lyricist person of","es":"letrista de","et":"sõnade autor (isik) teoses","fi":"sanoittaja (henkilö) teoksessa","fr":"personne parolière de","hu":"dalszövegíró személye:","it":"paroliere persona di","lv":"ir dziesmas teksta autors (persona)","nl":"liedtekstschrijver-persoon van","no":"sangtekstforfatter for (person)","tr":"söz yazarı kişisi","zh-Hans-CN":"……的歌词作者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن تأليف كلمات الأغنية الشعبية، بما في ذلك أغنية من مَسرحية موسيقِيّة.","ca":"Obra que implica una responsabilitat d’una persona en l’autoria d’una cançó popular, inclosa una cançó d’un musical.","cs":"Dílo, které zahrnuje odpovědnost osoby za autorství textu populární písně včetně písně z muzikálu.","da":"Værk, som involverer en persons ansvar for at forfatte ordene til en populær sang, inkl. en sang fra en musical.","de":"Ein Werk, bei dem eine Person für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.","de":"Ein Werk, bei dem eine Person für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.","en":"A work that involves a responsibility of a person for authoring the words of a popular song, including a song from a musical.","es":"Una obra que implica la responsabilidad de una persona por ser la autora de la letra de una canción popular, incluida una canción de un musical.","et":"Teos, mis sisaldab isiku vastutust levilaulu (k.a laul muusikalist) sõnade kirjutamise eest.","fi":"Teos, jossa henkilö on vastuussa populaarimusiikkiin kuuluvan laulun (mukaan lukien musikaalilaulun) sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à être l’auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy könyűzenei dalszöveg szerzőségéért, musicaldalt is beleértve.","it":"Opera che implica una responsabilità di una persona come autore delle parole di una canzone, inclusa una canzone di un musical.","lv":"Darbs, kas ietver personas atbildību par dziesmas vārdiem, ieskaitot dziesmas no mūzikla.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor schrijven van de woorden van een populair lied, inclusief een lied uit een musical.","no":"Et verk som involverer et ansvar for en person i form av å være forfatter av teksten til en populær sang, inkludert en sang fra en musikal.","tr":"Bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerini yazmak için bir kişinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及流行歌曲（包括音乐剧中的歌曲）歌词的写作的一个个人的责任的一种作品"},"note":{"ar":["يُستبعد تأليف الحوار فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només el diàleg d’un musical."],"cs":["Autorství pouze dialogu z muzikálu je vyloučeno."],"da":["At forfatte kun dialogen til en musical er ikke omfattet."],"de":["Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.,Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter."],"en":["Authoring of only the dialogue from a musical is excluded."],"es":["Se excluye la autoría de solo los diálogos de un musical."],"et":["Ei hõlma üksnes muusikali dialoogide kirjutamist."],"fi":["Ei kata pelkän musikaalin dialogin kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu."],"hu":["Musical párbeszédeinek szerzősége nem tartozik ide."],"it":["È escluso l'essere autore solo del dialogo di un musical."],"lv":["Neietver mūzikla dialogus."],"nl":["Schrijven van enkel de dialoog van een musical is uitgesloten."],"no":["Det å bare skrive dialogen fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca diyaloglarının yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中仅是对白的写作。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
