                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorAgentOf.en", "label":"is author agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/screenwriterAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50683", "lexicalAlias":"http://rdaregistry.info/Elements/a/screenwriterCollectiveAgentOf.en", "label":"is screenwriter collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50532", "lexicalAlias":"http://rdaregistry.info/Elements/a/screenwriterPersonOf.en", "label":"is screenwriter person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50223", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/screenwriterAgentOf.en", "label":"is screenwriter agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50223", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/screenwriterAgentOf.en", "label":"is screenwriter agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50683","label":{"ar":"هو وكيل جماعي كاتب سيناريو لـ","ca":"és agent col·lectiu guionista de","cs":"je scénáristou (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er manuskriptforfatter af","de":"ist gemeinschaftlicher Akteur als Drehbuchautorin/Drehbuchautor von","de":"ist gemeinschaftlicher Akteur als Drehbuchautorin/Drehbuchautor von","el":"είναι σεναριογράφος συλλογικός φορέας του","en":"is screenwriter collective agent of","es":"es agente colectivo de guionistas de","et":"stsenarist (kollektiiv) teoses","fi":"käsikirjoittaja (yhteistoimija) teoksessa","fr":"est un agent collectif scénariste de","hu":"forgatókönyvíró kollektív ágense a következőnek:","it":"è sceneggiatore agente collettivo di","lv":"ir scenārists (grupa)","nl":"is scenarioschrijver-collectieve actor van","no":"er manusforfatter for (kollektiv agent)","tr":"Senarist kolektif temsilcisidir","zh-Hans-CN":"是……的影视剧编剧集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن تأليف نص سينمائي، أو سيناريو، أو مشهد."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en l’autoria d’un guió, un argument o una escena."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za scénář nebo scénu."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at forfatte en drejebog, et manuskript eller en scene."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for authoring a screenplay, script, or scene."],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo por la autoría de un guión, texto o escena."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust stsenaariumi või stseeni kirjutamise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa käsikirjoituksen tai kohtauksen kirjoittamisesta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à être l’auteur d’un scénario, d’un script ou d’une scène."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy forgatókönyv, szövegkönyv vagy jelenet szerzőségéért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo come autore di una sceneggiatura, copione o scena."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par scenārija, uzveduma plāna vai ainas radīšanu."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor schrijven van een scenario, script of scène."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å være forfatter av et skuespill, et manuskript eller en scene."],"tr":["Kolektif bir temsilciyi, bir senaryo veya sahne yazmak için kolektif bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及写作影视剧剧本、脚本或场景的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي كاتب سيناريو","ca":"agent col·lectiu guionista de","cs":"scénárista (kolektivní agent) (čeho)","da":"kollektiv agent, som er manuskriptforfatter af","de":"Gemeinschaftlicher Akteur als Drehbuchautorin/Drehbuchautor von","de":"Gemeinschaftlicher Akteur als Drehbuchautorin/Drehbuchautor von","el":"σεναριογράφος συλλογικός φορέας του","en":"screenwriter collective agent of","es":"agente colectivo de guionistas de","et":"stsenarist (kollektiiv) teoses","fi":"käsikirjoittaja (yhteistoimija) teoksessa","fr":"agent collectif scénariste de","hu":"forgatókönyvíró kollektív ágense:","it":"sceneggiatore agente collettivo di","lv":"ir scenārists (grupa)","nl":"scenarioschrijver-collectieve actor van","no":"manusforfatter for (kollektiv agent)","tr":"senarist kolektif temsilci","zh-Hans-CN":"……的影视剧编剧集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن تأليف نص سينمائي، أو سيناريو، أو مشهد.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en l’autoria d’un guió, un argument o una escena.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za scénář nebo scénu.","da":"Værk, som involverer en kollektiv agents ansvar for at forfatte en drejebog, et manuskript eller en scene.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen eines Drehbuchs, eines Skripts oder einer Szene verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for authoring a screenplay, script, or scene.","es":"Una obra que implica la responsabilidad de un agente colectivo por la autoría de un guión, texto o escena.","et":"Teos, mis sisaldab kollektiivi vastutust stsenaariumi või stseeni kirjutamise eest.","fi":"Teos, jossa yhteistoimija on vastuussa käsikirjoituksen tai kohtauksen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à être l’auteur d’un scénario, d’un script ou d’une scène.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége egy forgatókönyv, szövegkönyv vagy jelenet szerzőségéért.","it":"Opera che implica una responsabilità di un agente collettivo come autore di una sceneggiatura, copione o scena.","lv":"Darbs, kas ietver grupas atbildību par scenārija, uzveduma plāna vai ainas radīšanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor schrijven van een scenario, script of scène.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av å være forfatter av et skuespill, et manuskript eller en scene.","tr":"Bir senaryo veya sahne yazmak için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及写作影视剧剧本、脚本或场景的一个集体行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
