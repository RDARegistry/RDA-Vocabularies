                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredCorporateBodyOfFamily.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50327", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfFamily.en", "label":"has related corporate body of family"},{"@id":"http://rdaregistry.info/Elements/a/P51099", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredCorporateBodyOfCollectiveAgent.en", "label":"has sponsored corporate body of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50063", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/sponsoredCorporateBodyOfFamily.en", "label":"has sponsored corporate body of family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50063", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/sponsoredCorporateBodyOfFamily.en", "label":"has sponsored corporate body of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50064","label":{"ar":"له تاريخ عائلة","ca":"té com a història d’una família","cs":"má rodinnou historii","da":"har familiehistorie","de":"hat Familiengeschichte","de":"hat Familiengeschichte","el":"έχει οικογενειακή ιστορία","en":"has family history","es":"tiene historia familiar","et":"perekonnalugu","fi":"sukuhistoria","fr":"a pour historique d’une famille","hu":"családtörténete a következő:","it":"ha come storia di famiglia","lv":"dzimtas/ģimenes vēsture","nl":"heeft familiegeschiedenis","no":"har familiehistorie","tr":"aile geçmişi ile ilişkilidir","zh-Hans-CN":"有家族历史"},"definition":{"ar":["يربط عائلة بمعلومات موجزة عن تاريخ عائلة أو عن أفرادها."],"ca":["Relaciona una família amb un resum de la informació sobre la història d’una família o dels seus membres."],"cs":["Vztahuje rodinu k souhrnu informací o historii rodiny nebo jejích členů."],"da":["Relaterer en familie til en opsummering af oplysninger om en families- eller dens medlemmers historie."],"de":["Setzt eine Familie in Beziehung zu Informationen über die Geschichte einer Familie oder ihrer Mitglieder.,Setzt eine Familie in Beziehung zu Informationen über die Geschichte einer Familie oder ihrer Mitglieder."],"el":["Συνδέει μια οικογένεια με μια περίληψη πληροφοριών σχετικών με την ιστορία μιας οικογένειας ή/και των μελών της."],"en":["Relates a family to a summary of information about the history of a family or its members."],"es":["Relaciona una familia con un resumen de información sobre la historia de una familia o sus miembros."],"et":["Seostab perekonna kokkuvõtliku infoga perekonna või selle liikmete aja- või eluloost."],"fi":["Liittää suvun elämäkerralliseen tietoon suvusta ja/tai suvun jäsenistä."],"fr":["Met une famille en relation avec un résumé d’informations sur l’histoire d’une famille ou de ses membres."],"hu":["Hozzákapcsol egy családot egy család vagy a tagjainak történetéről szóló információk összefoglalásához."],"it":["Correla una famiglia a un sommario d'informazioni sulla storia di una famiglia o dei suoi membri."],"lv":["Sasaista dzimtu/ģimeni ar informāciju par dzimtas/ģimenes vai tās piederīgo vēsturi."],"nl":["Relateert een familie aan een samenvatting van informatie over de geschiedenis van een familie of haar leden."],"no":["Relaterer en familie til et sammendrag av informasjon om en families eller familiemedlemmenes historie."],"tr":["Bir aileyi, bir ailenin veya üyelerinin geçmişi hakkındaki bilgilerin bir özetiyle ilişkilendirir."],"zh-Hans-CN":["将一个家族与关于一个家族及其成员历史信息的提要关联起来。"]},"ToolkitLabel":{"ar":"تاريخ عائلة","ca":"història d’una família","cs":"rodinná historie","da":"familiehistorie","de":"Familiengeschichte","de":"Familiengeschichte","el":"οικογενειακή ιστορία","en":"family history","es":"historia de la familia","et":"perekonnalugu","fi":"sukuhistoria","fr":"historique d’une famille","hu":"családtörténet:","it":"storia familiare","lv":"dzimtas/ģimenes vēsture","nl":"familiegeschiedenis","no":"familiehistorie","tr":"aile tarihi","zh-Hans-CN":"家族历史"},"ToolkitDefinition":{"ar":"ملخص للمعلومات المتعلقة بتاريخ العائلة أو أفرادها.","ca":"Resum de la informació sobre la història d’una família o dels seus membres.","cs":"Souhrn informací o historii rodiny nebo jejích členů.","da":"Opsummering af oplysninger om en families- eller dens medlemmers historie.","de":"Informationen über die Geschichte einer Familie oder ihrer Mitglieder.","de":"Informationen über die Geschichte einer Familie oder ihrer Mitglieder.","el":"Μια συνοπτική πληροφόρηση αναφορικά με το ιστορικό της οικογένιας ή/και τα μέλη της.","en":"A summary of information about the history of a family or its members.","es":"Un resumen de información sobre la historia de una familia o sus miembros.","et":"Kokkuvõtlik info perekonna või selle liikmete aja- või eluloost.","fi":"Elämäkerrallista tietoa suvusta tai suvun jäsenistä.","fr":"Résumé d’informations sur l’histoire d’une famille ou de ses membres.","hu":"Egy család vagy a tagjainak történetéről szóló információk összefoglalása.","it":"Sommario d'informazioni sulla storia di una famiglia o dei suoi membri.","lv":"Informācija par dzimtas/ģimenes vai tās piederīgo vēsturi.","nl":"Een samenvatting van informatie over de geschiedenis van een familie of haar leden.","no":"Et sammendrag av informasjon om en families eller familiemedlemmenes historie.","tr":"Bir ailenin veya üyelerinin geçmişi hakkındaki bilgilerin özeti.","zh-Hans-CN":"关于一个家族及其成员历史信息的提要"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
