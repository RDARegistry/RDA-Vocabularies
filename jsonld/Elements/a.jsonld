                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50744", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en", "label":"is reviser collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50273", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistAgentOfExpressionOf.en", "label":"is restorationist agent of expression of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50914", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCorporateBodyOfExpressionOf.en", "label":"is restorationist corporate body of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P51065", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistFamilyOfExpressionOf.en", "label":"is restorationist family of expression of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50763", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistCollectiveAgentOfExpressionOf.en", "label":"is restorationist collective agent of expression of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50763", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistCollectiveAgentOfExpressionOf.en", "label":"is restorationist collective agent of expression of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50780","label":{"ar":"هو وكيل جماعي أخصائي ترميم مفردة لـ","ca":"és agent col·lectiu restaurador d’un ítem de","cs":"je restaurátorem jednotky (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er konservator af eksemplar af","de":"ist gemeinschaftlicher Akteur als Restauratorin/Restaurator eines Exemplars von","de":"ist gemeinschaftlicher Akteur als Restauratorin/Restaurator eines Exemplars von","el":"είναι συντηρητής συλλογικός φορέας του αντιτύπου του","en":"is restorationist collective agent of item of","es":"es agente colectivo restauracionista de ítem de","et":"restaureerija (kollektiiv) eksemplarile","fi":"kappaleen entisöijä (yhteistoimija) kappaleessa","fr":"est un agent collectif restaurateur d’un item de","hu":"restaurátor kollektív ágense a következő példánynak:","it":"è restauratore agente collettivo di item di","lv":"ir restaurators (grupa) vienībai","nl":"is restaurator-collectieve actor van item van","no":"er konservator for eksemplar for (kollektiv agent)","tr":"kopyasının restorasyon uzmanı kolektif temsilcisidir","zh-Hans-CN":"是……的单件的修复者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بمفردة تنطوي على مسئولية وكيل جماعي عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية."],"ca":["Relaciona un agent col·lectiu amb un ítem que implica una responsabilitat d’un agent col·lectiu per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals."],"cs":["Vztahuje kolektivního agenta k jednotce, která zahrnuje odpovědnost kolektivního agenta za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů."],"da":["Relaterer en kollektiv agent til et eksemplar, som involverer en kollektiv agents ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Exemplar, bei dem ein gemeinschaftlicher Akteur für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Exemplar, bei dem ein gemeinschaftlicher Akteur für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt."],"en":["Relates a collective agent to an item that involves a responsibility by a collective agent for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures."],"es":["Relaciona un agente colectivo con un ítem que involucra una responsabilidad de un agente colectivo de compensar la degradación al devolverlo a un estado tan cercano a su condición original como sea posible utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales."],"et":["Seostab kollektiivi eksemplariga, mis sisaldab kollektiivi vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks."],"fi":["Liittää yhteistoimijan kappaleeseen, jossa yhteistoimija on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa."],"fr":["Met un agent collectif en relation avec un item qui comporte une responsabilité de la part d’un agent collectif consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles."],"hu":["Hozzákapcsol egy kollektív ágenst egy példányhoz, amelyhez hozzátartozik egy kollektív ágens felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza egy példány romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza."],"it":["Correla un agente collettivo a un item che implica una responsabilità di un agente collettivo nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali."],"lv":["Sasaista grupu ar vienību, kas ietver grupas atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu."],"nl":["Relateert een collectieve actor aan een item dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures."],"no":["Relaterer en kollektiv agent til et eksemplar som involverer et ansvar for en kollektiv agent i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer."],"tr":["Kolektif bir temsilciyi, bir dizi teknik, editoryal ve entelektüel prosedür kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafisi için kolektif bir temsilcinin sorumluluğunu içeren bir kopya ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个集体行为者的责任的一个单件关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي أخصائي ترميم مفردة","ca":"agent col·lectiu restaurador d’un ítem de","cs":"restaurátor jednotky (kolektivní agent) (čeho)","da":"kollektiv agent, som er konservator af eksemplar af","de":"Gemeinschaftlicher Akteur als Restauratorin/Restaurator eines Exemplars von","de":"Gemeinschaftlicher Akteur als Restauratorin/Restaurator eines Exemplars von","el":"συντηρητής συλλογικός φορέας του αντιτύπου του","en":"restorationist collective agent of item of","es":"agente colectivo restauracionista de ítem de","et":"restaureerija (kollektiiv) eksemplarile","fi":"kappaleen entisöijä (yhteistoimija) kappaleessa","fr":"agent collectif restaurateur d’un item de","hu":"restaurátor kollektív ágense a következő példánynak:","it":"restauratore agente collettivo di item di","lv":"ir restaurators (grupa) vienībai","nl":"restaurator-collectieve actor van item van","no":"konservator for eksemplar for (kollektiv agent)","tr":"kopyanın restorasyon uzmanı kolektif temsilcisi","zh-Hans-CN":"……的单件的修复者集体行为者"},"ToolkitDefinition":{"ar":"مفردة تنطوي على مسئولية وكيل جماعي عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية.","ca":"Ítem que implica una responsabilitat d’un agent col·lectiu per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals.","cs":"Jednotka, která zahrnuje odpovědnost kolektivního agenta za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů.","da":"Eksemplar, som involverer en kollektiv agents ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer.","de":"Ein Exemplar, bei dem ein gemeinschaftlicher Akteur für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","de":"Ein Exemplar, bei dem ein gemeinschaftlicher Akteur für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","en":"An item that involves a responsibility of a collective agent for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures.","es":"Un ítem que involucra una responsabilidad de un agente colectivo de compensar la degradación al devolverlo a un estado tan cercano a su condición original como sea posible utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales.","et":"Eksemplar, mis sisaldab kollektiivi vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks.","fi":"Kappale, jossa yhteistoimija on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa.","fr":"Item qui comporte une responsabilité de la part d’un agent collectif consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles.","hu":"Egy példány, amelyhez hozzátartozik egy kollektív ágens felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza egy példány romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza.","it":"Item che implica una responsabilità di un agente collettivo nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali.","lv":"Vienība, kas ietver grupas atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu.","nl":"Een item dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures.","no":"Et eksemplar som involverer et ansvar for en kollektiv agent i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer.","tr":"Bir takım teknik, editoryal ve entelektüel prosedürler kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafisi için kolektif bir temsilcinin sorumluluğunu içeren bir kopya.","zh-Hans-CN":"涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个集体行为者的责任的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfItemOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50363", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfCollectiveAgent.en", "label":"has related item of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50206", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistAgentOfItemOf.en", "label":"is restorationist agent of item of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50931", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCorporateBodyOfItemOf.en", "label":"is restorationist corporate body of item of"},{"@id":"http://rdaregistry.info/Elements/a/P51082", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistFamilyOfItemOf.en", "label":"is restorationist family of item of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50780", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistCollectiveAgentOfItemOf.en", "label":"is restorationist collective agent of item of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50780", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistCollectiveAgentOfItemOf.en", "label":"is restorationist collective agent of item of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50914","label":{"ar":"هي هيئة أخصائية ترميم تعبيرة لـ","ca":"és entitat corporativa restauradora d’una expressió de","cs":"je restaurátorem vyjádření (korporací) (čeho)","da":"er korporation, som er konservator af udtryk af","de":"ist Körperschaft als Restauratorin/Restaurator einer Expression von","de":"ist Körperschaft als Restauratorin/Restaurator einer Expression von","el":"είναι συντηρητής συλλογικό όργανο της έκφρασης του","en":"is restorationist corporate body of expression of","es":"es organismo corporativo restauracionista de expresión de","et":"rekonstrueerija (asutus) väljenduses","fi":"ekspression entisöijä (yhteisö) ekspressiossa","fr":"est une collectivité restauratrice d’une expression de","hu":"restaurátor testülete a következő kifejezési formának:","it":"è restauratore ente di espressione di","lv":"ir restaurators (institūcija) izteiksmei","nl":"is restaurator-corporatie van expressie van","no":"er konservator for uttrykk for (korporasjon)","tr":"anlatımının restorasyon uzmanı tüzel kişisidir","zh-Hans-CN":"是……的内容表达的修复者团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة في ترميم، أو جمع التعبيرات التالفة أو المجزأة لإنشاء تعبيرة جديدة."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa restaurant o combinant expressions, que poden estar danyades o fragmentades, per crear una expressió nova."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace tím, že restauruje nebo kombinuje dřívější vyjádření, která mohou být poškozená nebo neúplná, za účelem vytvoření nového vyjádření."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at restaurere eller kombinere tidligere udtryk, som kan være beskadigede eller fragmenterede, til at skabe et nyt udtryk."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of restoring or combining expressions, which may be damaged or fragmentary, to create a new expression."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de restaurar o combinar expresiones, las cuales pueden estar dañadas o ser fragmentarias, para crear una nueva expresión."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, taastades või kombineerides varasemaid väljendusi, mis võivad olla kahjustatud või fragmentaarsed, uue väljenduse loomiseks."],"fi":["Liittää yhteisön ekspressioon, jonka tekemisessä yhteisö on osallisena restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à restaurer ou à combiner des expressions, qui peuvent être endommagées ou fragmentaires, pour créer une nouvelle expression."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését sérült vagy töredékes kifejezési formák helyreállításában vagy kombinálásában, amivel új kifejezési formát hoz létre."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nel restauro o combinazione di espressioni, che possono essere danneggiate o frammentarie, per creare una nuova espressione."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, atjaunojot vai apvienojot izteiksmes, kuras bijušas bojātas vai fragmentāras, lai izveidotu jaunu izteiksmi."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door herstellen of combineren van expressies, die beschadigd of fragmentarisch kunnen zijn, met de bedoeling een nieuwe expressie te vormen."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å gjenopprette eller kombinere tidligere uttrykk, som kan være skadede eller fragmentariske, for å skape et nytt uttrykk."],"tr":["Bir tüzel kişiyi, yeni bir ifade oluşturmak için zarar görmüş veya parçalanmış olabilecek ifadeleri geri yükleme veya birleştirme konusunda bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括修复或组合可能被损毁或不完整的内容表达以创建一种新的内容表达的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة أخصائية ترميم تعبيرة","ca":"entitat corporativa restauradora d’una expressió de","cs":"restaurátor vyjádření (korporace) (čeho)","da":"korporation, som er konservator af udtryk af","de":"Körperschaft als Restauratorin/Restaurator einer Expression von","de":"Körperschaft als Restauratorin/Restaurator einer Expression von","el":"συντηρητής συλλογικό όργανο της έκφρασης του","en":"restorationist corporate body of expression of","es":"organismo corporativo restauracionista de expresión de","et":"rekonstrueerija (asutus) väljenduses","fi":"ekspression entisöijä (yhteisö) ekspressiossa","fr":"collectivité restauratrice d’une expression de","hu":"restaurátor testülete a következő kifejezési formának:","it":"restauratore ente di espressione di","lv":"ir restaurators (institūcija) izteiksmei","nl":"restaurator-corporatie van expressie van","no":"konservator for uttrykk for (korporasjon)","tr":"anlatımın restorasyon uzmanı tüzel kişisi","zh-Hans-CN":"……的内容表达的修复者团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة في ترميم، أو جمع التعبيرات التالفة أو المجزأة لإنشاء تعبيرة جديدة.","ca":"Expressió que inclou una contribució d’una entitat corporativa restaurant o combinant expressions, que poden estar danyades o fragmentades, per crear una expressió nova.","cs":"Vyjádření, které zahrnuje přispění korporace tím, že restauruje nebo kombinuje dřívější vyjádření, která mohou být poškozená nebo neúplná, za účelem vytvoření nového vyjádření.","da":"Udtryk, som omfatter en korporations bidrag ved at restaurere eller kombinere tidligere udtryk, som kan være beskadigede eller fragmenterede, til at skabe et nyt udtryk.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.","en":"An expression that includes a contribution by a corporate body of restoring or combining expressions, which may be damaged or fragmentary, to create a new expression.","es":"Una expresión que incluye una contribución de un organismo corporativo de restaurar o combinar expresiones, las cuales pueden estar dañadas o ser fragmentarias, para crear una nueva expresión.","et":"Väljendus, millesse asutus on andnud panuse, taastades või kombineerides varasemaid väljendusi, mis võivad olla kahjustatud või fragmentaarsed, uue väljenduse loomiseks.","fi":"Ekspressio, jonka tekemisessä yhteisö on osallisena restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à restaurer ou à combiner des expressions, qui peuvent être endommagées ou fragmentaires, pour créer une nouvelle expression.","hu":"Egy kifejezési forma, amely hozzátartozik egy testület közreműködéséhez sérült vagy töredékes kifejezési formák helyreállítása vagy kombinálása során, amivel új kifejezési formát hoz létre.","it":"Espressione che comprende un contributo di un ente nel restauro o combinazione di espressioni, che possono essere danneggiate o frammentarie, per creare una nuova espressione.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, atjaunojot vai apvienojot izteiksmes, kuras bijušas bojātas vai fragmentāras, lai izveidotu jaunu izteiksmi.","nl":"Een expressie die omvat een bijdrage door een corporatie door herstellen of combineren van expressies, die beschadigd of fragmentarisch kunnen zijn, met de bedoeling een nieuwe expressie te vormen.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å gjenopprette eller kombinere tidligere uttrykk, som kan være skadede eller fragmentariske, for å skape et nytt uttrykk.","tr":"Yeni bir ifade oluşturmak için zarar görmüş veya parçalanmış olabilecek anlatımları geri yükleme veya birleştirme konusunda tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修复或组合可能被损毁或不完整的内容表达以创建一种新的内容表达的一个团体的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCorporateBodyOfExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50895", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCorporateBodyOf.en", "label":"is reviser corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50763", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfExpressionOf.en", "label":"is restorationist collective agent of expression of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50914", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistCorporateBodyOfExpressionOf.en", "label":"is restorationist corporate body of expression of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50914", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistCorporateBodyOfExpressionOf.en", "label":"is restorationist corporate body of expression of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50931","label":{"ar":"هي هيئة أخصائي ترميم مفردة لـ","ca":"és entitat corporativa restauradora d’un ítem de","cs":"je restaurátorem jednotky (korporací) (čeho)","da":"er korporation, som er konservator af eksemplar af","de":"ist Körperschaft als Restauratorin/Restaurator eines Exemplars von","de":"ist Körperschaft als Restauratorin/Restaurator eines Exemplars von","el":"είναι συντηρητής συλλογικό όργανο του αντιτύπου του","en":"is restorationist corporate body of item of","es":"es organismo corporativo restauracionista de ítem de","et":"restaureerija (asutus) eksemplarile","fi":"kappaleen entisöijä (yhteisö) kappaleessa","fr":"est une collectivité restauratrice d’un item de","hu":"restaurátor testülete a következő tárgynak:","it":"è restauratore ente di item di","lv":"ir restaurators (institūcija) vienībai","nl":"is restaurator-corporatie van item van","no":"er konservator for eksemplar for (korporasjon)","tr":"kopyasının restorasyon uzmanı tüzel kişisidir","zh-Hans-CN":"是……的单件的修复者团体"},"definition":{"ar":["يربط هيئة بمفردة تنطوي على مسئولية هيئة عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية."],"ca":["Relaciona una entitat corporativa amb un ítem que implica una responsabilitat d’una entitat corporativa per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals."],"cs":["Vztahuje korporaci k jednotce, která zahrnuje odpovědnost korporace za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů."],"da":["Relaterer en korporation til et eksemplar, som involverer en korporations ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer."],"de":["Setzt eine Körperschaft in Beziehung zu einem Exemplar, bei dem eine Körperschaft für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.,Setzt eine Körperschaft in Beziehung zu einem Exemplar, bei dem eine Körperschaft für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt."],"en":["Relates a corporate body to an item that involves a responsibility by a corporate body for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures."],"es":["Relaciona un organismo corporativo con un ítem que involucra una responsabilidad de un organismo corporativo de compensar la degradación al devolverlo a un estado tan cercano a su condición original como sea posible utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales."],"et":["Seostab asutuse eksemplariga, mis sisaldab asutuse vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks."],"fi":["Liittää yhteisön kappaleeseen, jossa toimija on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa."],"fr":["Met une collectivité en relation avec un item qui comporte une responsabilité de la part d’une collectivité consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles."],"hu":["Hozzákapcsol egy testületet egy példányhoz, amelyhez hozzátartozik egy testület felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza a forrás romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza."],"it":["Correla un ente a un item che implica una responsabilità di un ente nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali."],"lv":["Sasaista institūciju ar vienību, kas ietver institūcijas atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu."],"nl":["Relateert een corporatie aan een item dat met zich meebrengt een verantwoordelijkheid van een corporatie voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures."],"no":["Relaterer en korporasjon til et eksemplar som involverer et ansvar for en korporasjon i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer."],"tr":["Bir tüzel kişiyi, bir dizi teknik, editoryal ve entelektüel prosedür kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafi edilmesi sorumluluğunu içeren bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个团体的责任的一个单件关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن ترميم مفردة","ca":"entitat corporativa restauradora d’un ítem de","cs":"restaurátor jednotky (korporace) (čeho)","da":"korporation, som er konservator af eksemplar af","de":"Körperschaft als Restauratorin/Restaurator eines Exemplars von","de":"Restauratorin/Restaurator eines Exemplars (Körperschaft) von","el":"συντηρητής συλλογικό όργανο του αντιτύπου του","en":"restorationist corporate body of item of","es":"organismo corporativo restauracionista de ítem de","et":"restaureerija (asutus) eksemplarile","fi":"kappaleen entisöijä (yhteisö) kappaleessa","fr":"collectivité restauratrice d’un item de","hu":"restaurátor testülete a következő példánynak:","it":"restauratore ente di item di","lv":"ir restaurators (institūcija) vienībai","nl":"restaurator-corporatie van item van","no":"konservator for eksemplar for (korporasjon)","tr":"kopyanın restorasyon uzmanı tüzel kişisi","zh-Hans-CN":"……的单件的修复者团体"},"ToolkitDefinition":{"ar":"مفردة تنطوي على مسئولية هيئة عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية.","ca":"Ítem que implica una responsabilitat d’una entitat corporativa per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals.","cs":"Jednotka, která zahrnuje odpovědnost korporace za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů.","da":"Eksemplar, som involverer en korporations ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer.","de":"Ein Exemplar, bei dem eine Körperschaft für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","de":"Ein Exemplar, bei dem eine Körperschaft für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","en":"An item that involves a responsibility of a corporate body for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures.","es":"Un ítem que involucra una responsabilidad de un organismo corporativo de compensar la degradación al devolverlo a un estado tan cercano a su condición original como sea posible utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales.","et":"Eksemplar, mis sisaldab asutuse vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks.","fi":"Kappale, jossa toimija on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa.","fr":"Item qui comporte une responsabilité de la part d’une collectivité consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles.","hu":"Egy példány, amelyhez hozzátartozik egy testület felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza a forrás romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza.","it":"Item che implica una responsabilità di un ente nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali.","lv":"Vienība, kas ietver institūcijas atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu.","nl":"Een item dat met zich meebrengt een verantwoordelijkheid van een corporatie voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures.","no":"Et eksemplar som involverer et ansvar for en korporasjon i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer.","tr":"Bir takım teknik, editoryal ve entelektüel prosedürler kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafisi için tüzel bir kişinin sorumluluğunu içeren bir kopya.","zh-Hans-CN":"涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个团体的责任的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCorporateBodyOfItemOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50332", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfCorporateBody.en", "label":"has related item of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/P50780", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfItemOf.en", "label":"is restorationist collective agent of item of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50931", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistCorporateBodyOfItemOf.en", "label":"is restorationist corporate body of item of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50931", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistCorporateBodyOfItemOf.en", "label":"is restorationist corporate body of item of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51065","label":{"ar":"هي عائلة أخصائية ترميم تعبيرة لـ","ca":"és família restauradora d’una expressió de","cs":"je restaurátorem vyjádření (rodinou) (čeho)","da":"er familie, som er konservator af udtryk af","de":"ist Familie als Restauratorin/Restaurator einer Expression von","de":"ist Familie als Restauratorin/Restaurator einer Expression von","el":"είναι συντηρητής οικογένεια της έκφρασης του","en":"is restorationist family of expression of","es":"es familia restauracionista de expresión de","et":"rekonstrueerija (perekond) väljenduses","fi":"ekspression entisöijä (suku) ekspressiossa","fr":"est une famille restauratrice d’une expression de","hu":"restaurátor családja a következő kifejezési formának:","it":"è restauratore famiglia di espressione di","lv":"ir restaurators (dzimta/ģimene) izteiksmei","nl":"is restaurator-familie van expressie van","no":"er konservator for uttrykk for (familie)","tr":"anlatımının restorasyon uzmanı ailesidir","zh-Hans-CN":"是……的内容表达的修复者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في ترميم، أو جمع التعبيرات التالفة أو المجزأة لإنشاء تعبيرة جديدة."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família restaurant o combinant expressions, que poden estar danyades o fragmentades, per crear una expressió nova."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že restauruje nebo kombinuje dřívější vyjádření, která mohou být poškozená nebo neúplná, za účelem vytvoření nového vyjádření."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at restaurere eller kombinere tidligere udtryk, som kan være beskadigede eller fragmenterede, til at skabe et nyt udtryk."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt."],"en":["Relates a family to an expression that includes a contribution by a family of restoring or combining expressions, which may be damaged or fragmentary, to create a new expression."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de restaurar o combinar expresiones, las cuales pueden estar dañadas o ser fragmentarias, para crear una nueva expresión."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, taastades või kombineerides varasemaid väljendusi, mis võivad olla kahjustatud või fragmentaarsed, uue väljenduse loomiseks."],"fi":["Liittää suvun ekspressioon, jonka tekemisessä suku on osallisena restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à restaurer ou à combiner des expressions, qui peuvent être endommagées ou fragmentaires, pour créer une nouvelle expression."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését sérült vagy töredékes kifejezési formák helyreállításában vagy kombinálásában, amivel új kifejezési formát hoz létre."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nel restauro o combinazione di espressioni, che possono essere danneggiate o frammentarie, per creare una nuova espressione."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, atjaunojot vai apvienojot izteiksmes, kuras bijušas bojātas vai fragmentāras, lai izveidotu jaunu izteiksmi."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door herstellen of combineren van expressies, die beschadigd of fragmentarisch kunnen zijn, met de bedoeling een nieuwe expressie te vormen."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å gjenopprette eller kombinere tidligere uttrykk, som kan være skadede eller fragmentariske, for å skape et nytt uttrykk."],"tr":["Bir aileyi, yeni bir ifade oluşturmak için zarar görmüş veya parçalanmış olabilecek ifadeleri geri yükleme veya birleştirme ailesinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括修复或组合可能被损毁或不完整的内容表达以创建一种新的内容表达的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة أخصائية ترميم تعبيرة","ca":"família restauradora d’una expressió de","cs":"restaurátor vyjádření (rodina) (čeho)","da":"familie, som er konservator af udtryk af","de":"Familie als Restauratorin/Restaurator einer Expression von","de":"Familie als Restauratorin/Restaurator einer Expression von","el":"συντηρητής οικογένεια της έκφρασης του","en":"restorationist family of expression of","es":"familia restauracionista de expresión de","et":"rekonstrueerija (perekond) väljenduses","fi":"ekspression entisöijä (suku) ekspressiossa","fr":"famille restauratrice d’une expression de","hu":"restaurátor családja a következő kifejezési formának:","it":"restauratore famiglia di espressione di","lv":"ir restaurators (dzimta/ģimene) izteiksmei","nl":"restaurator-familie van expressie van","no":"konservator for uttrykk for (familie)","tr":"anlatımın restorasyon uzmanı ailesi","zh-Hans-CN":"……的内容表达的修复者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في ترميم، أو جمع التعبيرات التالفة أو المجزأة لإنشاء تعبيرة جديدة.","ca":"Expressió que inclou una contribució d’una família restaurant o combinant expressions, que poden estar danyades o fragmentades, per crear una expressió nova.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že restauruje nebo kombinuje dřívější vyjádření, která mohou být poškozená nebo neúplná, za účelem vytvoření nového vyjádření.","da":"Udtryk, som omfatter en families bidrag ved at restaurere eller kombinere tidligere udtryk, som kan være beskadigede eller fragmenterede, til at skabe et nyt udtryk.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.","en":"An expression that includes a contribution by a family of restoring or combining expressions, which may be damaged or fragmentary, to create a new expression.","es":"Una expresión que incluye una contribución de una familia de restaurar o combinar expresiones, las cuales pueden estar dañadas o ser fragmentarias, para crear una nueva expresión.","et":"Väljendus, millesse perekond on andnud panuse, taastades või kombineerides varasemaid väljendusi, mis võivad olla kahjustatud või fragmentaarsed, uue väljenduse loomiseks.","fi":"Ekspressio, jonka tekemisessä suku on osallisena restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à restaurer ou à combiner des expressions, qui peuvent être endommagées ou fragmentaires, pour créer une nouvelle expression.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését sérült vagy töredékes kifejezési formák helyreállításában vagy kombinálásában, amivel új kifejezési formát hoz létre.","it":"Espressione che comprende un contributo di una famiglia nel restauro o combinazione di espressioni, che possono essere danneggiate o frammentarie, per creare una nuova espressione.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, atjaunojot vai apvienojot izteiksmes, kuras bijušas bojātas vai fragmentāras, lai izveidotu jaunu izteiksmi.","nl":"Een expressie die omvat een bijdrage door een familie door herstellen of combineren van expressies, die beschadigd of fragmentarisch kunnen zijn, met de bedoeling een nieuwe expressie te vormen.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å gjenopprette eller kombinere tidligere uttrykk, som kan være skadede eller fragmentariske, for å skape et nytt uttrykk.","tr":"Yeni bir anlatım oluşturmak için, tahrip olmuş veya parçalı olabilen anlatımları restore etme veya birleştirmeyle görevli bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修复或组合可能被损毁或不完整的内容表达以创建一种新的内容表达的一个家族的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistFamilyOfExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51046", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserFamilyOf.en", "label":"is reviser family of"},{"@id":"http://rdaregistry.info/Elements/a/P50763", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfExpressionOf.en", "label":"is restorationist collective agent of expression of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51065", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistFamilyOfExpressionOf.en", "label":"is restorationist family of expression of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51065", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistFamilyOfExpressionOf.en", "label":"is restorationist family of expression of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51082","label":{"ar":"هي عائلة أخصائية ترميم مفردة لـ","ca":"és família restauradora d’un ítem de","cs":"je restaurátorem jednotky (rodinou) (čeho)","da":"er familie, som er konservator af eksemplar af","de":"ist Familie als Restauratorin/Restaurator eines Exemplars von","de":"ist Familie als Restauratorin/Restaurator eines Exemplars von","el":"είναι συντηρητής οικογένεια του αντιτύπου του","en":"is restorationist family of item of","es":"es familia restauracionista de ítem de","et":"restaureerija (perekond) eksemplarile","fi":"kappaleen entisöijä (suku) kappaleessa","fr":"est une famille restauratrice d’un item de","hu":"restaurátor családja a következő példánynak:","it":"è restauratore famiglia di item di","lv":"ir restaurators (dzimta/ģimene) vienībai","nl":"is restaurator-familie van item van","no":"er konservator for eksemplar for (familie)","tr":"kopyasının restorasyon uzmanı ailesidir","zh-Hans-CN":"是……的单件的修复者家族"},"definition":{"ar":["يربط عائلة بمفردة تنطوي على مسئولية عائلة عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية."],"ca":["Relaciona una família amb un ítem que implica una responsabilitat d’una família per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals."],"cs":["Vztahuje rodinu k jednotce, která zahrnuje odpovědnost rodiny za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů."],"da":["Relaterer en familie til et eksemplar, som involverer en families ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer."],"de":["Setzt eine Familie in Beziehung zu einem Exemplar, bei dem eine Familie für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.,Setzt eine Familie in Beziehung zu einem Exemplar, bei dem eine Familie für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt."],"el":["Συνδέει μια οικογένεια με ένα αντίτυπο που περιλαμβάνει την ευθύνη μιας οικογένειας για αντιστάθμιση της υποβάθμισης με την επαναφορά του σε μια κατάσταση όσο το δυνατόν εγγύτερα στην αρχική του κατάσταση χρησιμοποιώντας ένα σύνολο τεχνικών, συντακτικών και διανοητικών διαδικασιών."],"en":["Relates a family to an item that involves a responsibility by a family for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures."],"es":["Relaciona una familia con un ítem que involucra una responsabilidad de una familia de compensar la degradación al devolverlo a un estado tan cercano a su condición original como sea posible utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales."],"et":["Seostab perekonna eksemplariga, mis sisaldab perekonna vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks."],"fi":["Liittää suvun kappaleeseen, jossa suku on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä, joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa."],"fr":["Met une famille en relation avec un item qui comporte une responsabilité de la part d’une famille consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles."],"hu":["Hozzákapcsol egy családot egy példányhoz, amelyhez hozzátartozik egy család felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza egy példány romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza."],"it":["Correla una famiglia a un item che implica una responsabilità di una famiglia nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali."],"lv":["Sasaista dzimtu/ģimeni ar vienību, kas ietver dzimtas/ģimenes atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu."],"nl":["Relateert een familie aan een item dat met zich meebrengt een verantwoordelijkheid van een familie voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures."],"no":["Relaterer en familie til et eksemplar som involverer et ansvar for en familie i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer."],"tr":["Bir aileyi, bir dizi teknik, editoryal ve entellektüel prosedür kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafisi için bir ailenin sorumluluğunu içeren bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个家族的责任的一个单件关联起来。"]},"ToolkitLabel":{"ar":"عائلة مسئولة عن ترميم مفردة","ca":"família restauradora d’un ítem de","cs":"restaurátor jednotky (rodina) (čeho)","da":"familie, som er konservator af eksemplar af","de":"Familie als Restauratorin/Restaurator eines Exemplars von","de":"Familie als Restauratorin/Restaurator eines Exemplars von","el":"συντηρητής οικογένεια του αντιτύπου του","en":"restorationist family of item of","es":"familia restauracionista de ítem de","et":"restaureerija (perekond) eksemplarile","fi":"kappaleen entisöijä (suku) kappaleessa","fr":"famille restauratrice d’un item de","hu":"restaurátor családja a következő példánynak:","it":"restauratore famiglia di item di","lv":"ir restaurators (dzimta/ģimene) vienībai","nl":"restaurator-familie van item van","no":"konservator for eksemplar for (familie)","tr":"kopyanın restorasyon uzmanı ailesi","zh-Hans-CN":"……的单件的修复者家族"},"ToolkitDefinition":{"ar":"مفردة تنطوي على مسئولية عائلة عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية.","ca":"Ítem que implica una responsabilitat d’una família per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals.","cs":"Jednotka, která zahrnuje odpovědnost rodiny za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů.","da":"Eksemplar, som involverer en families ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer.","de":"Ein Exemplar, bei dem eine Familie für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","de":"Ein Exemplar, bei dem eine Familie für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","en":"An item that involves a responsibility of a family for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures.","es":"Un ítem que involucra una responsabilidad de una familia de compensar la degradación al devolverlo a un estado tan cercano a su condición original como sea posible utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales.","et":"Eksemplar, mis sisaldab perekonna vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks.","fi":"Kappale, jossa suku on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä, joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa.","fr":"Item qui comporte une responsabilité de la part d’une famille consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles.","hu":"Egy példány, amelyhez hozzátartozik egy család felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza egy példány romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza.","it":"Item che implica una responsabilità di una famiglia nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali.","lv":"Vienība, kas ietver dzimtas/ģimenes atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu.","nl":"Een item dat met zich meebrengt een verantwoordelijkheid van een familie voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures.","no":"Et eksemplar som involverer et ansvar for en familie i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer.","tr":"Bir takım teknik, editoryal ve entelektüel prosedürler kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafisi için bir ailenin sorumluluğunu içeren bir kopya.","zh-Hans-CN":"涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个家族的责任的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistFamilyOfItemOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50323", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfFamily.en", "label":"has related item of family"},{"@id":"http://rdaregistry.info/Elements/a/P50780", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfItemOf.en", "label":"is restorationist collective agent of item of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51082", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistFamilyOfItemOf.en", "label":"is restorationist family of item of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51082", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistFamilyOfItemOf.en", "label":"is restorationist family of item of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50612","label":{"ar":"هو شخص أخصائي ترميم تعبيرة لـ","ca":"és persona restauradora d’una expressió de","cs":"je restaurátorem vyjádření (osobou) (čeho)","da":"er person, som er konservator af udtryk af","de":"ist Person als Restauratorin/Restaurator einer Expression von","de":"ist Person als Restauratorin/Restaurator einer Expression von","el":"είναι συντηρητής φυσικό πρόσωπο της έκφρασης του","en":"is restorationist person of expression of","es":"es persona restauracionista de expresión de","et":"rekonstrueerija (isik) väljenduses","fi":"ekspression entisöijä (henkilö) ekspressiossa","fr":"est une personne restauratrice d’une expression de","hu":"restaurátor személye a következő kifejezési formának:","it":"è restauratore persona di espressione di","lv":"ir restaurators (persona) izteiksmei","nl":"is restaurator-persoon van expressie van","no":"er konservator for uttrykk for (person)","tr":"anlatımının restorasyon uzmanı kişisidir","zh-Hans-CN":"是……的内容表达的修复者个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص في ترميم، أو جمع التعبيرات التالفة أو المجزأة لإنشاء تعبيرة جديدة."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona restaurant o combinant expressions, que poden estar danyades o fragmentades, per crear una expressió nova."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že restauruje nebo kombinuje dřívější vyjádření, která mohou být poškozená nebo neúplná, za účelem vytvoření nového vyjádření."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at restaurere eller kombinere tidligere udtryk, som kan være beskadigede eller fragmenterede, til at skabe et nyt udtryk."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt."],"en":["Relates a person to an expression that includes a contribution by a person of restoring or combining expressions, which may be damaged or fragmentary, to create a new expression."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona para restaurar o combinar expresiones, que pueden estar dañadas o fragmentadas, para crear una nueva expresión."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, taastades või kombineerides varasemaid väljendusi, mis võivad olla kahjustatud või fragmentaarsed, uue väljenduse loomiseks."],"fi":["Liittää henkilön ekspressioon, jonka tekemisessä henkilö on osallisena restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à restaurer ou à combiner des expressions, qui peuvent être endommagées ou fragmentaires, pour créer une nouvelle expression."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését sérült vagy töredékes kifejezési formák helyreállításában vagy kombinálásában, amivel új kifejezési formát hoz létre."],"it":["Correla una persona a un'espressione che comprende il contributo di una persona nel restauro o combinazione di espressioni, che possono essere danneggiate o frammentarie, per creare una nuova espressione."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, atjaunojot vai apvienojot izteiksmes, kuras bijušas bojātas vai fragmentāras, lai izveidotu jaunu izteiksmi."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door herstellen of combineren van expressies, die beschadigd of fragmentarisch kunnen zijn, met de bedoeling een nieuwe expressie te vormen."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å gjenopprette eller kombinere tidligere uttrykk, som kan være skadede eller fragmentariske, for å skape et nytt uttrykk."],"tr":["Bir kişiyi, yeni bir anlatım oluşturmak için zarar görmüş veya parçalanmış olabilecek anlatımları geri yükleme veya birleştirme konusunda bir kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括修复或组合可能被损毁或不完整的内容表达以创建一种新的内容表达的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص أخصائي ترميم تعبيرة .","ca":"persona restauradora d’una expressió de","cs":"restaurátor vyjádření (osoba) (čeho)","da":"person, som er konservator af udtryk af","de":"ist Person als Restauratorin/Restaurator einer Expression von","de":"ist Person als Restauratorin/Restaurator einer Expression von","el":"εσυντηρητής φυσικό πρόσωπο της έκφρασης του","en":"restorationist person of expression of","es":"persona restauracionista de expresión de","et":"rekonstrueerija (isik) väljenduses","fi":"ekspression entisöijä (henkilö) ekspressiossa","fr":"personne restauratrice d’une expression de","hu":"restaurátor személye a következő kifejezési formának:","it":"restauratore persona di espressione di","lv":"ir restaurators (persona) izteiksmei","nl":"restaurator-persoon van expressie van","no":"konservator for uttrykk for (person)","tr":"anlatımın restoraston uzmanı kişisi","zh-Hans-CN":"……的内容表达的修复者个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص في ترميم، أو جمع التعبيرات التالفة أو المجزأة لإنشاء تعبيرة جديدة.","ca":"Expressió que inclou una contribució d’una persona restaurant o combinant expressions, que poden estar danyades o fragmentades, per crear una expressió nova.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že restauruje nebo kombinuje dřívější vyjádření, která mohou být poškozená nebo neúplná, za účelem vytvoření nového vyjádření.","da":"Udtryk, som omfatter en persons bidrag ved at restaurere eller kombinere tidligere udtryk, som kan være beskadigede eller fragmenterede, til at skabe et nyt udtryk.","de":"Eine Expression, zu der eine Person beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie durch die Wiederherstellung oder Zusammenführung früherer Expressionen, die beschädigt oder unvollständig sein können, eine neue Expression erstellt.","en":"An expression that includes a contribution by a person of restoring or combining expressions, which may be damaged or fragmentary, to create a new expression.","es":"Una expresión que incluye una contribución de una persona para restaurar o combinar expresiones, que pueden estar dañadas o fragmentadas, para crear una nueva expresión.","et":"Väljendus, millesse isik on andnud panuse, taastades või kombineerides varasemaid väljendusi, mis võivad olla kahjustatud või fragmentaarsed, uue väljenduse loomiseks.","fi":"Ekspressio, jonka tekemisessä henkilö on osallisena restauroimalla tai yhdistelemällä aikaisempia ekspressioita, jotka voivat olla vaurioituneita tai fragmentaarisia, uuden ekspression luomiseksi.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à restaurer ou à combiner des expressions, qui peuvent être endommagées ou fragmentaires, pour créer une nouvelle expression.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését sérült vagy töredékes kifejezési formák helyreállításában vagy kombinálásában, amivel új kifejezési formát hoz létre.","it":"Espressione che comprende il contributo di una persona nel restauro o combinazione di espressioni, che possono essere danneggiate o frammentarie, per creare una nuova espressione.","lv":"Izteiksme, kas ietver personas ieguldījumu, atjaunojot vai apvienojot izteiksmes, kuras bijušas bojātas vai fragmentāras, lai izveidotu jaunu izteiksmi.","nl":"Een expressie die omvat een bijdrage door een persoon door herstellen of combineren van expressies, die beschadigd of fragmentarisch kunnen zijn, met de bedoeling een nieuwe expressie te vormen.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å gjenopprette eller kombinere tidligere uttrykk, som kan være skadede eller fragmentariske, for å skape et nytt uttrykk.","tr":"Yeni bir anlatım oluşturmak için, tahrip olmuş veya parçalı olabilen anlatımları restore etme veya birleştirmeyle görevli bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修复或组合可能被损毁或不完整的内容表达以创建一种新的内容表达的一个个人的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistPersonOfExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50593", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserPersonOf.en", "label":"is reviser person of"},{"@id":"http://rdaregistry.info/Elements/a/P50273", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistAgentOfExpressionOf.en", "label":"is restorationist agent of expression of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50612", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistPersonOfExpressionOf.en", "label":"is restorationist person of expression of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50612", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistPersonOfExpressionOf.en", "label":"is restorationist person of expression of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50629","label":{"ar":"هو شخص أخصائي ترميم مفردة لـ","ca":"és persona restauradora d’un ítem de","cs":"je restaurátorem jednotky (osobou) (čeho)","da":"er person, som er konservator af eksemplar af","de":"ist Person als Restauratorin/Restaurator eines Exemplars von","de":"ist Person als Restauratorin/Restaurator eines Exemplars von","el":"είναι συντηρητής φυσικό πρόσωπο του αντιτύπου του","en":"is restorationist person of item of","es":"es persona restauracionista de item de","et":"restaureerija (isik) eksemplarile","fi":"kappaleen entisöijä (henkilö) kappaleessa","fr":"est une personne restauratrice d’un item de","hu":"restaurátor személye a következő példánynak:","it":"è restauratore persona di item di","lv":"ir restaurators (persona) vienībai","nl":"is restaurator-persoon van item van","no":"er konservator for eksemplar for (person)","tr":"kopyasının restorasyon uzmanı kişisidir","zh-Hans-CN":"是……的单件的修复者个人"},"definition":{"ar":["يربط شخصا بمفردة تنطوي على مسئولية شخص عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية."],"ca":["Relaciona una persona amb un ítem que implica una responsabilitat d’una persona per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals."],"cs":["Vztahuje osobu k jednotce, která zahrnuje odpovědnost osoby za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů."],"da":["Relaterer en person til et eksemplar, som involverer en persons ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer."],"de":["Setzt eine Person in Beziehung zu einem Exemplar, bei dem eine Person für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.,Setzt eine Person in Beziehung zu einem Exemplar, bei dem eine Person für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt."],"en":["Relates a person to an item that involves a responsibility by a person for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures."],"es":["Relaciona a una persona con un item que implica la responsabilidad de una persona de compensar la degradación devolviéndolo a un estado lo más cercano posible a su condición original utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales."],"et":["Seostab isiku eksemplariga, mis sisaldab isiku vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks."],"fi":["Liittää henkilön kappaleeseen, jossa henkilö on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa."],"fr":["Met une personne en relation avec un item qui comporte une responsabilité de la part d’une personne consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles."],"hu":["Hozzákapcsol egy személyt egy példányhoz, amelyhez hozzátartozik egy személy felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza a példány romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza."],"it":["Correla una persona a un item che implica una responsabilità di una persona nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali."],"lv":["Sasaista personu ar vienību, kas ietver personas atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu."],"nl":["Relateert een persoon aan een item dat met zich meebrengt een verantwoordelijkheid van een persoon voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures."],"no":["Relaterer en person til et eksemplar som involverer et ansvar for en person i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer."],"tr":["Bir kişiyi, bir dizi teknik, editoryal ve fikri işlemleri kullanarak orijinal durumuna en yakın haline getirerek bozulmayı telafi etme sorumluluğunu içeren bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个个人的责任的一个单件关联起来。"]},"ToolkitLabel":{"ar":"شخص أخصائي ترميم مفردة","ca":"persona restauradora d’un ítem de","cs":"restaurátor jednotky (osoba) (čeho)","da":"person, som er konservator af eksemplar af","de":"Person als Restauratorin/Restaurator eines Exemplars von","de":"Person als Restauratorin/Restaurator eines Exemplars von","el":"συντηρητής φυσικό πρόσωπο του αντιτύπου του","en":"restorationist person of item of","es":"persona restauracionista de item de","et":"restaureerija (isik) eksemplarile","fi":"kappaleen entisöijä (henkilö) kappaleessa","fr":"personne restauratrice d’un item de","hu":"restaurátor személye a következő példánynak:","it":"restauratore persona di item di","lv":"ir restaurators (persona) vienībai","nl":"restaurator-persoon van item van","no":"konservator for eksemplar for (person)","tr":"kopyanın restoraston uzmanı kişisi","zh-Hans-CN":"……的单件的修复者个人"},"ToolkitDefinition":{"ar":"مفردة تنطوي على مسئولية شخص عن التعويض عن تدهور حالتها عن طريق إعادتها إلى حالتها الأصلية قدر المستطاع باستخدام مجموعة من الإجراءات الفنية والتحريرية والمتعلقة بالملكية الفكرية.","ca":"Ítem que implica una responsabilitat d’una persona per la compensació de la seva degradació retornant-lo a un estat que s’aproximi al màxim a la seva condició original usant un conjunt de procediments tècnics, editorials i intel·lectuals.","cs":"Jednotka, která zahrnuje odpovědnost osoby za kompenzaci degradace jednotky tím, že ji přivede zpět do stavu co nejbližšího původnímu s použitím souboru technických, editačních a intelektuálních postupů.","da":"Eksemplar, som involverer en persons ansvar for kompensation for nedslidning ved at føre det tilbage til en tilstand, som er så tæt så muligt på sin oprindelige tilstand vha. en række af tekniske, redaktionsmæssige og intellektuelle procedurer.","de":"Ein Exemplar, bei dem eine Person für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","de":"Ein Exemplar, bei dem eine Person für die technischen, redaktionellen und intellektuellen Verfahren verantwortlich ist, die darauf abzielen, die Zersetzung eines Exemplars auszugleichen, indem es in einen Zustand zurückversetzt wird, der seiner ursprünglichen Beschaffenheit möglichst nahe kommt.","en":"An item that involves a responsibility of a person for compensation of degradation by bringing it back to a state as close as possible to its original condition using a set of technical, editorial, and intellectual procedures.","es":"Un item que implica la responsabilidad de una persona de compensar la degradación devolviéndolo a un estado lo más cercano posible a su condición original utilizando un conjunto de procedimientos técnicos, editoriales e intelectuales.","et":"Eksemplar, mis sisaldab isiku vastutust rea tehniliste, toimetuslike ja intellektuaalsete toimingute eest, mille eesmärk on taastada kahjustatud eksemplari seisund võimalikult originaalseisundi lähedaseks.","fi":"Kappale, jossa henkilö on vastuussa teknisistä, toimituksellisista ja tiedollisista toimenpiteistä joiden tarkoitus on palauttaa huonokuntoinen kappale mahdollisimman lähelle sen alkuperäistä kuntoa.","fr":"Item qui comporte une responsabilité de la part d’une personne consistant à compenser sa dégradation en le ramenant à un état aussi près que possible de sa condition originelle au moyen d’un ensemble de procédures techniques, éditoriales et intellectuelles.","hu":"Egy példány, amelyhez hozzátartozik egy személy felelőssége technikai, szerkesztői és intellektuális eljárások alkalmazásáért, amivel ellensúlyozza a példány romlását, hogy az eredeti állapotához a lehető legközelebb állítsa azt vissza.","it":"Item che implica una responsabilità di una persona nel compensare una degradazione riportandolo a uno stato il più possibile vicino alla sua condizione originale usando un insieme di procedure tecniche, editoriali e intellettuali.","lv":"Vienība, kas ietver personas atbildību par vienības bojāejas novēršanu, atgriežot to stāvoklī pēc iespējas tuvāk sākotnējam, izmantojot tehnisko, redakcionālo un intelektuālo procedūru kopumu.","nl":"Een item dat met zich meebrengt een verantwoordelijkheid van een persoon voor compensatie van verval door het terug te brengen in een staat zo dicht mogelijk bij de oorspronkelijke conditie gebruikmakend van een verzameling van technische, redactionele en intellectuele procedures.","no":"Et eksemplar som involverer et ansvar for en person i form av å kompensere for nedbrytningen av et eksemplar ved å restaurere det til en tilstand som er så lik originaltilstanden som mulig ved hjelp av et sett av tekniske, redaksjonelle og intellektuelle prosedyrer.","tr":"Bir takım teknik, editoryal ve entelektüel prosedürler kullanarak orijinal durumuna mümkün olduğunca yakın bir duruma geri getirerek bozulmanın telafisi için bir kişinin sorumluluğunu içeren bir kopya.","zh-Hans-CN":"涉及为弥补单件的损毁而担负一系列技术、编辑和智力操作、使之尽可能恢复到原始状态的一个个人的责任的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistPersonOfItemOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50314", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfPerson.en", "label":"has related item of person"},{"@id":"http://rdaregistry.info/Elements/a/P50206", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistAgentOfItemOf.en", "label":"is restorationist agent of item of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50629", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/restorationistPersonOfItemOf.en", "label":"is restorationist person of item of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50629", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/restorationistPersonOfItemOf.en", "label":"is restorationist person of item of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50447","label":{"ar":"هو وكيل مراجع لـ","ca":"és agent revisor de","cs":"je korektorem (agentem) (čeho)","da":"er agent, som er omarbejder af","de":"ist Akteur als Überarbeiterin/Überarbeiter von","de":"ist Akteur als Überarbeiterin/Überarbeiter von","el":"είναι αναθεωρητής φορέας του","en":"is reviser agent of","es":"es agente revisor de","et":"redigeerija (tegija) väljenduses","fi":"tarkistaja (toimija) ekspressiossa","fr":"est un agent réviseur de","hu":"átdolgozó ágense a következőnek:","it":"è revisore agente di","lv":"ir korektors (aģents)","nl":"is herziener-actor van","no":"er omarbeider av (agent)","tr":"Gözden geçiren temsilci","zh-Hans-CN":"是……的修订者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في إجراء تغييرات على محتوى تعبيرة أخرى."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent fent canvis en el contingut d’una altra expressió."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že provádí změny v obsahu jiného vyjádření."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at foretage ændringer i indholdet af et andet udtryk."],"de":["Setzt einen Akteur in Beziehung zu eine Expression, zu der ein Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt.,Setzt einen Akteur in Beziehung zu eine Expression, zu der ein Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt."],"en":["Relates an agent to an expression that includes a contribution by an agent of making changes to the content of another expression."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente para realizar cambios en el contenido de otra expresión."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, tehes muudatusi teise väljenduse sisusse."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu tekemällä muutoksia toisen ekspression sisältöön."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à apporter des modifications au contenu d’une autre expression."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését egy másik kifejezési forma tartalmának megváltoztatásában."],"it":["Correla un agente a un'espressione che comprende un contributo di un agente nell'apportare cambiamenti al contenuto di un'altra espressione."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, veicot izmaiņas citas izteiksmes saturā."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door wijzigingen te maken in de content van een andere expressie."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent ved å gjøre endringer i innholdet av et annet uttrykk."],"tr":["Bir temsilciyi, başka bir anlatımının içeriğinde değişiklik yapan bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括对另一种内容表达的内容作改动的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مُراجع","ca":"agent revisor de","cs":"korektor (agent) (čeho)","da":"agent, som er omarbejder af","de":"Akteur als Überarbeiterin/Überarbeiter von","de":"Akteur als Überarbeiterin/Überarbeiter von","el":"αναθεωρητής φορέας του","en":"reviser agent of","es":"agente revisor de","et":"redigeerija (tegija) väljenduses","fi":"tarkistaja (toimija) ekspressiossa","fr":"agent réviseur de","hu":"átdolgozó ágense:","it":"revisore agente di","lv":"ir korektors (aģents)","nl":"herziener-actor van","no":"omarbeider av (agent)","tr":"gözden geçiren temsilci","zh-Hans-CN":"……的修订者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في إجراء تغييرات محتوى تعبيرة أخرى.","ca":"Expressió que inclou una contribució d’un agent fent canvis en el contingut d’una altra expressió.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že provádí změny v obsahu jiného vyjádření.","da":"Udtryk, som omfatter en agents bidrag ved at foretage ændringer i indholdet af et andet udtryk.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt.","en":"An expression that includes a contribution by an agent of making changes to the content of another expression.","es":"Expresión que incluye una contribución de un agente para realizar cambios en el contenido de otra expresión.","et":"Väljendus, millesse tegija on andnud panuse, tehes muudatusi teise väljenduse sisusse.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu tekemällä muutoksia toisen ekspression sisältöön.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à apporter des modifications au contenu d’une autre expression.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését egy másik kifejezési forma tartalmának megváltoztatásában.","it":"Espressione che comprende un contributo di un agente nell'apportare cambiamenti al contenuto di un'altra espressione.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, veicot izmaiņas citas izteiksmes saturā.","nl":"Een expressie die omvat een bijdrage door een actor door wijzigingen te maken in de content van een andere expressie.","no":"Et uttrykk som inkluderer et bidrag fra en agent ved å gjøre endringer i innholdet av et annet uttrykk.","tr":"Başka bir ifadenin içeriğinde değişiklik yapan bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括对另一种内容表达的内容作改动的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["مراجع"],"ca":["revisor de"],"cs":["korektor (čeho)"],"da":["reviderer af"],"de":["Überarbeiter von,Überarbeiter von"],"el":["αναθεωρητής του"],"en":["reviser of"],"es":["revisor de"],"et":["redigeerija väljenduses"],"fi":["tarkistajana ekspressiossa"],"fr":["réviseur de"],"hu":["átdolgozója:"],"it":["revisore di"],"nl":["herziener van"],"no":["omarbeider av"],"tr":["gözden geçiren"],"zh-Hans-CN":["……的修订者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
