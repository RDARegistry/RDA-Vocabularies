                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/broaderAffiliatedBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50336", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfCorporateBody.en", "label":"has related corporate body of corporate body"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50240", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/broaderAffiliatedBody.en", "label":"has broader affiliated body"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50240", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/broaderAffiliatedBody.en", "label":"has broader affiliated body"}]},{"@id":"http://rdaregistry.info/Elements/a/P50107","label":{"ca":"té com a data associada amb una persona","da":"har dato knyttet til personen","de":"hat Datum, das mit einer Person in Verbindung steht","el":"έχει χρονολογία συνδεδεμένη με το φυσικό πρόσωπο","en":"has date associated with person (Deprecated)","fi":"henkilöön liittyvä ajankohta","fr":"a pour date associée à une personne","hu":"van személlyel kapcsolatos időpontja","sv":"har tid förknippad med personen"},"definition":{"ca":["Relaciona una persona amb una data significativa associada amb una persona."],"da":["Relaterer en person til en væsentlig dato forbundet med en person."],"de":["Setzt eine Person mit einem wichtigen Datum, das mit der Geschichte einer Person in Verbindung steht, in Beziehung."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια σημαντική χρονολογία συνδεδεμένη με ένα φυσικό πρόσωπο."],"en":["Relates a person to a timespan that has a significant association with a person. (Deprecated)"],"fi":["Liittää henkilön henkilöön liittyvään merkittävään ajankohtaan."],