                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/studentAt.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50318", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfPerson.en", "label":"has related corporate body of person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50288", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/studentAt.en", "label":"is student at"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50288", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/studentAt.en", "label":"is student at"}]},{"@id":"http://rdaregistry.info/Elements/a/P50279","label":{"ar":"له زميل دراسة","ca":"té com a company d’estudis","cs":"má spolužáka","da":"har medstuderende","de":"hat Kommilitonin/Kommilitonen","de":"hat Kommilitonin/Kommilitonen","el":"έχει συμφοιτητή","en":"has fellow student","es":"tiene compañero estudiante","et":"õpingukaaslane","fi":"opiskelutoveri","fr":"a pour compagnon d’études","hu":"tanulótársa a következő:","it":"ha come studente compagno","lv":"studiju biedrs","nl":"heeft medestudent","no":"har medstudent","tr":"okul arkadaşı ile ilişkilidir","zh-Hans-CN":"有同学"},"definition":{"ar":["يربط شخصا بزميل طالب آخر ينخرط أيضًا في التعلم بصورة رسمية."],"ca":["Relaciona una persona amb una persona que és un associat d’un altre estudiant que també es dedica formalment a l’aprenentatge."],"cs":["Vztahuje osobu k osobě, která je spojena s jiným studentem, který je také formálně zapojen do studia (učení)."],"da":["Relaterer en person til en person, der er en anden students arbejdskammerat, som også er formelt beskæftigt med at studere."],"de":["Setzt eine Person in Beziehung zu einer Studienkollegin/einem Studienkollegen (Person) einer anderen Studentin/eines anderen Studenten, die/der sich ebenfalls offiziell mit Studieren befasst.,Setzt eine Person in Beziehung zu einer Studienkollegin/einem Studienkollegen (Person) einer anderen Studentin/eines anderen Studenten, die/der sich ebenfalls offiziell mit Studieren befasst."],"el":["Συνδέει ένα φυσικό πρόσωπο με έναν συμφοιτητή κάποιου άλλου φοιτητή που επίσης εμπλέκεται τυπικά στη μάθηση"],"en":["Relates a person to a person who is an associate of another student who is also formally engaged in learning."],"es":["Relaciona una persona con una persona que es un asociado de una persona que también está formalmente comprometido con el aprendizaje."],"et":["Seostab isiku teise õppuriga, kes samuti vormiliselt õpib."],"fi":["Liittää henkilön henkilöön, joka on toisen opiskelijan kollega, joka myös virallisesti opiskelee."],"fr":["Met une personne en relation avec une personne qui est un associé d’un autre élève qui est aussi engagé dans un processus formel d’apprentissage."],"hu":["Hozzákapcsol egy személyt egy személyhez, aki egy másik, a tanulásban szintén formálisan részt vevő tanulónak a társa."],"it":["Correla una persona a un collega di un altro studente che è anche formalmente impegnato nell'apprendere."],"lv":["Sasaista personu ar personu, kura vienlaicīgi ar citu studentu studēja mācību iestādē."],"nl":["Relateert een persoon aan een persoon die is een geassocieerde van een andere student die ook formeel betrokken is bij leren."],"no":["Relaterer en person til en bekjent av en annen student som også er under formell utdanning."],"tr":["Bir kişiyi, aynı zamanda resmi olarak öğrenmeyle meşgul olan başka bir öğrencinin arkadaşı olan bir kişi ile ilişkilendirir."],"zh-Hans-CN":["将一个个人与作为另一个也是正式参加学习的学生的伙伴的一个个人关联起来。"]},"ToolkitLabel":{"ar":"زميل دراسة","ca":"company d’estudis","cs":"spolužák","da":"medstuderende","de":"Kommilitonin/Kommilitone","de":"Kommilitonin/Kommilitone","el":"συμφοιτητής","en":"fellow student","es":"compañero estudiante","et":"õpingukaaslane","fi":"opiskelutoveri","fr":"compagnon d’études","hu":"tanulótárs:","it":"compagno di studi","lv":"studiju biedrs","nl":"medestudent","no":"medstudent","tr":"okul arkadaşı","zh-Hans-CN":"同学"},"ToolkitDefinition":{"ar":"زمالة طالب آخر يشارك أيضًا بشكل رسمي في التعلم.","ca":"Persona que és un associat d’un altre estudiant que també es dedica formalment a l’aprenentatge.","cs":"Osoba, která je spojena s jiným studentem, který je také formálně zapojen do studia (učení).","da":"Person, der er en anden students arbejdskammerat, som også er formelt beskæftigt med at studere.","de":"Eine Studienkollegin/Ein Studienkollege (Person) einer anderen Studentin/eines anderen Studenten, die/der sich ebenfalls offiziell mit Studieren befasst.","de":"Eine Studienkollegin/Ein Studienkollege (Person) einer anderen Studentin/eines anderen Studenten, die/der sich ebenfalls offiziell mit Studieren befasst.","el":"Ένας συμφοιτητής κάποιου άλλου φοιτητή που επίσης εμπλέκεται τυπικά στη μάθηση.","en":"A person who is an associate of another student who is also formally engaged in learning.","es":"Una persona que es un asociado de una persona que también está formalmente comprometido con el aprendizaje.","et":"Teine õppur, kes samuti vormiliselt õpib.","fi":"Henkilö, joka on toisen opiskelijan kollega, joka myös virallisesti opiskelee.","fr":"Personne qui est un associé d’un autre élève qui est aussi engagé dans un processus formel d’apprentissage.","hu":"Egy személy, aki egy másik, a tanulásban szintén formálisan részt vevő tanulónak a társa.","it":"Collega di un altro studente che è anche formalmente impegnato nell'apprendere.","lv":"Persona, kura vienlaicīgi ar citu studentu studēja mācību iestādē.","nl":"Een persoon die is een geassocieerde van een andere student die ook formeel betrokken is bij leren.","no":"En bekjent av en annen student som også er under formell utdanning.","tr":"Resmi olarak öğrenmeye katılan başka bir öğrencinin arkadaşı olan bir kişi","zh-Hans-CN":"作为另一个也是正式参加学习的学生的伙伴的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/fellowStudent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50316", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPersonOfPerson.en", "label":"has related person of person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50279", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/fellowStudent.en", "label":"has fellow student"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50279", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/fellowStudent.en", "label":"has fellow student"}]},{"@id":"http://rdaregistry.info/Elements/a/P50003","label":{"ar":"هي مؤسسة مانحة درجة لـ","ca":"és institució que concedeix un títol acadèmic de","cs":"je udělovatelem akademické hodnosti (čeho)","da":"er gradtildelende institution af","de":"ist grad-verleihende Institution von","de":"ist grad-verleihende Institution von","el":"είναι ίδρυμα χορήγησης πτυχίου του","en":"is degree granting institution of","es":"es institución que otorga títulos de grado de","et":"kraadi andev asutus teoses","fi":"oppiarvon myöntävä yhteisö teoksessa","fr":"est une institution conférant un grade universitaire de","hu":"tudományos fokozatot adó intézménye a következőnek:","it":"è istituzione che rilascia un titolo accademico di","lv":"ir grāda piešķīrējinstitūcija","nl":"is graadverstrekkende instelling van","no":"er tildelende institusjon for","tr":"tez onaylayan kurumudur","zh-Hans-CN":"是……的学位授予机构"},"definition":{"ar":["يربط هيئة بعمل عبارة عن أطروحة أو رسالة جامعية ذات صلة بدرجة أكاديمية معتمدة من هيئة."],"ca":["Relaciona una entitat corporativa amb una obra que és una tesi o una dissertació associada amb un grau acadèmic i que és aprovada per una entitat corporativa."],"cs":["Vztahuje korporaci k dílu, které je diplomovou nebo disertační prací spojenou s akademickým titulem, který je korporací schválený."],"da":["Relaterer en korporation til et værk, som er en afhandling for en akademisk grad, som er godkendt af en korporation."],"de":["Setzt eine Körperschaft in Beziehung zu einer Hochschulschrift (Werk), die von einer Körperschaft genehmigt wird und mit einem akademischen Grad in Verbindung steht.,Setzt eine Körperschaft in Beziehung zu einer Hochschulschrift (Werk), die von einer Körperschaft genehmigt wird und mit einem akademischen Grad in Verbindung steht."],"el":["Συνδέει ένα συλλογικό όργανο που χορηγεί ένα ανώτερου ακαδημαϊκού επιπέδου πτυχίο, με ένα έργο."],"en":["Relates a corporate body to a work that is a thesis or dissertation associated with an academic degree that is approved by a corporate body."],"es":["Relaciona un organismo corporativo con una obra que es una tesis o tesina asociada con un grado académico que es aprobada por un organismo corporativo."],"et":["Seostab asutuse akadeemilise kraadi taotlemiseks esitatud teosega, mille asutus on heaks kiitnud."],"fi":["Liittää yhteisön teokseen, joka on yhteisön hyväksymä akateemisen oppiarvon opinnäyte tai väitöskirja."],"fr":["Met une collectivité en relation avec une œuvre qui consiste en une thèse ou un mémoire associé à un grade universitaire qui est approuvé par une collectivité."],"hu":["Hozzákapcsol egy testületet egy műhöz, amely egy tudományos fokozat elnyeréséért benyújtott szakdolgozat vagy disszertáció, amelyet a testület jóváhagyott."],"it":["Correla un ente a un'opera che è una tesi per una laura universitaria approvata da un ente."],"lv":["Sasaista institūciju ar darbu, par ko ir saņemts akadēmiskais grāds, ko piešķīrusi institūcija."],"nl":["Relateert een corporatie aan een werk dat een scriptie of proefschrift is voor een academische graad dat is goedgekeurd door een corporatie."],"no":["Relaterer en korporasjon til et verk som er en avhandling for en akademisk grad som tildeles en korporasjon."],"tr":["Bir tüzel kişiyi, tarafından onaylanan ve akademik bir unvanla ilişkili olan yüksek lisans ya da doktora tezi eseri ile ilişkilendirir."],"zh-Hans-CN":["将一个团体与一种作为与被一个团体批准的学位有关之论文的作品关联起来。"]},"ToolkitLabel":{"ar":"مؤسسة مانحة درجة لـ","ca":"institució que concedeix un títol acadèmic de","cs":"udělovatel akademické hodnosti (čeho)","da":"gradtildelende institution af","de":"Grad-verleihende Institution von","de":"Grad-verleihende Institution von","el":"ίδρυμα χορήγησης πτυχίου του","en":"degree granting institution of","es":"institución que otorga títulos de grado de","et":"kraadi andev asutus teoses","fi":"oppiarvon myöntävä yhteisö teoksessa","fr":"institution conférant un grade universitaire de","hu":"tudományos fokozatot adó intézménye a következőnek:","it":"istituzione che rilascia un titolo accademico di","lv":"ir grāda piešķīrējinstitūcija","nl":"graadverstrekkende instelling van","no":"tildelende institusjon for","tr":"diploma veren kurum","zh-Hans-CN":"……的学位授予机构"},"ToolkitDefinition":{"ar":"عمل عبارة عن أطروحة أو رسالة جامعية ذات صلة بدرجة أكاديمية معتمدة من هيئة.","ca":"Obra que és una tesi o una dissertació associada amb un grau acadèmic i que és aprovada per una entitat corporativa.","cs":"Dílo, které je diplomovou nebo disertační prací spojenou s akademickým titulem, který je korporací schválený.","da":"Værk, som er en afhandling for en akademisk grad, som er godkendt af en korporation.","de":"Eine Hochschulschrift (Werk), die von einer Körperschaft genehmigt wird und mit einem akademischen Grad in Verbindung steht.","de":"Eine Hochschulschrift (Werk), die von einer Körperschaft genehmigt wird und mit einem akademischen Grad in Verbindung steht.","el":"Ένα ανώτερου εκπαιδευτικού επιπέδου πτυχίο το οποίο χορηγείται από ένα συλλογικό όργανο.","en":"A work that is a thesis or dissertation associated with an academic degree that is approved by a corporate body.","es":"Una obra que es una tesis o tesina asociada con un grado académico que es aprobada por un organismo corporativo.","et":"Akadeemilise kraadi taotlemiseks esitatud teos, mille asutus on heaks kiitnud.","fi":"Teos, joka on yhteisön hyväksymä akateemisen oppiarvon opinnäyte tai väitöskirja.","fr":"Œuvre qui consiste en une thèse ou un mémoire associé à un grade universitaire qui est approuvé par une collectivité.","hu":"Egy mű, amely egy tudományos fokozat elnyeréséért benyújtott szakdolgozat vagy disszertáció, amelyet a testület jóváhagyott.","it":"Opera che è una tesi per una laurea universitaria approvata da un ente.","lv":"Akadēmiskais grāds, ko piešķīrusi institūcija.","nl":"Een werk dat een scriptie of proefschrift is voor een academische graad dat is goedgekeurd door een corporatie.","no":"Et verk som er en avhandling for en akademisk grad som tildeles en korporasjon.","tr":"Bir tüzel kişi tarafından onaylanan ve akademik derece ile bağlantılı olan yüksek lisans ya da doktora tezi çalışması.","zh-Hans-CN":"一种作为与被一个团体批准的学位有关之论文的作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
