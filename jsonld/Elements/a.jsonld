                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/bookDesignerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50660", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookDesignerCollectiveAgentOf.en", "label":"is book designer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50947", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfManifestationOf.en", "label":"is creator family of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50962", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/bookDesignerFamilyOf.en", "label":"is book designer family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50962", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/bookDesignerFamilyOf.en", "label":"is book designer family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50509","label":{"ar":"هو شخص مصمم كتب لـ","ca":"és persona dissenyadora gràfica de","cs":"je knižním designérem (osobou) (čeho)","da":"er person, som er bogdesigner af","de":"ist Person als Buchgestalterin/Buchgestalter von","de":"ist Person als Buchgestalterin/Buchgestalter von","el":"είναι σχεδιαστής βιβλίου φυσικό πρόσωπο του","en":"is book designer person of","es":"es persona diseñadora de libros de","et":"raamatukujundaja (isik) kehastuses","fi":"graafinen suunnittelija (henkilö) manifestaatiossa","fr":"est une personne maquettiste de livre de","hu":"könyvtervező személye a következőnek:","it":"è book designer persona di","lv":"ir grāmatas dizainers (persona)","nl":"is boekontwerper-persoon van","no":"er bokdesigner for (person)","tr":"kitap tasarımcısı kişisidir","zh-Hans-CN":"是……的图书设计者个人"},"definition":{"ar":["يربط شخصا بتجسيدة تنطوي على مسئولية شخص عن التصميم الجرافيكي لكتاب بالكامل، ويشمل ذلك تنسيق الحروف، والإيضاحيات، واختيار المواد، والعمليات المستخدمة."],"ca":["Relaciona una persona amb una manifestació que implica una responsabilitat d’una persona en tot el disseny gràfic d’un llibre, inclosa la composició tipogràfica i la il·lustració, la tria dels materials i el procés utilitzat."],"cs":["Vztahuje osobu k provedení, které zahrnuje odpovědnost osoby za celkovou grafickou úpravu knihy, včetně uspořádání písma a ilustrací, výběru materiálů a použitého postupu."],"da":["Relaterer en person til en manifestation, som involverer en persons ansvar for hele det grafiske design af en bog, inkl. opsætning af tekst og illustrationer, materialevalg og anvendt proces."],"de":["Setzt eine Person in Beziehung zu einer Manifestation, bei der eine Person für das gesamte grafische Design eines Buchs, einschließlich Schriftbild, Bildgestaltung, Materialwahl und angewandter Verfahren, verantwortlich ist.,Setzt eine Person in Beziehung zu einer Manifestation, bei der eine Person für das gesamte grafische Design eines Buchs, einschließlich Schriftbild, Bildgestaltung, Materialwahl und angewandter Verfahren, verantwortlich ist."],"en":["Relates a person to a manifestation that involves a responsibility of a person for the entire graphic design of a book, including arrangement of type and illustration, choice of materials, and process used."],"es":["Relaciona a una persona con una manifestación que implica la responsabilidad de una persona por todo el diseño gráfico de un libro, incluida la disposición del tipo y la ilustración, la elección de los materiales y el proceso utilizado."],"et":["Seostab isiku kehastusega, mis sisaldab isiku vastutust raamatu graafilise kujunduse eest, sealhulgas trükiteksti ja illustratsioonide paigutuse, materjalide valiku ja valmistamismenetluste eest."],"fi":["Liittää henkilön manifestaatioon, jossa henkilö on vastuussa koko kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä."],"fr":["Met une personne en relation avec une manifestation qui comporte une responsabilité de la part d’une personne en ce qui concerne toute la conception graphique d’un livre, y compris la composition typographique, l’arrangement des illustrations, le choix des matériaux et le procédé utilisé."],"hu":["Hozzákapcsol egy személyt egy megjelenési formához, amelyhez hozzátartozik egy személy felelőssége egy könyv teljes grafikai tervezéséért, beleértve a nyomdai betűtípus és az illusztrációk elrendezését, az anyagválasztást és az alkalmazott eljárást."],"it":["Correla una persona con una manifestazione che implica una responsabilità di una persona nell'intera progettazione grafica di un libro, inclusa la disposizione dei caratteri e dell'illustrazione, la scelta dei materiali e il processo utilizzato."],"lv":["Sasaista personu ar manifestāciju, kas ietver personas atbildību par grāmatas grafisko dizainu, tajā skaitā par izkātojuma veidu un ilustrācijām, materiālu izvēli un izmantoto procesu."],"nl":["Relateert een persoon aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een persoon voor het complete grafische ontwerp van een boek, inclusief indeling van font en illustratie, keuze van materialen en gebruikte methode."],"no":["Relaterer en person til en manifestasjon som involverer et ansvar for en person i form av ansvar for hele den grafiske utformingen av en bok, inkludert oppsett av skrifttype og illustrasjoner, valg av materialer og hvilke prosesser som brukes."],"tr":["Bir kişiyi, kişinin yazı ve illüstrasyon düzenlemesi, malzeme seçimi ve kullanılan süreç dahil olmak üzere bir kitabın tüm grafik tasarımı sorumluluğunu içeren gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及一种图书的整体平面设计（包括字体和插图的设计、材料的选取和工艺流程的使用等）的一个个人的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"شخص مصمم كتب","ca":"persona dissenyadora gràfica de","cs":"knižní designér (osoba) (čeho)","da":"person, som er bogdesigner af","de":"Person als Buchgesta