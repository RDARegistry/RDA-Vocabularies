                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/countryAssociatedWithPerson.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50346", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPlaceOfPerson.en", "label":"has related place of person"}],"instructionNumber":"9.1","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50097", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/countryAssociatedWithPerson.en", "label":"has country associated with person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50097", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/countryAssociatedWithPerson.en", "label":"has country associated with person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50114","label":{"ar":"له عنوان مراسلة شخص","ca":"té com a adreça d’una persona","cs":"má adresu osoby","da":"har adresse på person","de":"hat Adresse einer Person","de":"hat Adresse einer Person","el":"έχει διεύθυνση του φυσικού προσώπου","en":"has address of person","es":"tiene dirección de persona","et":"isiku aadress","fi":"henkilön osoite","fr":"a pour adresse d’une personne","hu":"személy címe a következő:","it":"ha come indirizzo di persona","lv":"personas adrese","nl":"heeft adres van persoon","no":"har adresse for person","tr":"kişinin adresi ile ilişkilidir","zh-Hans-CN":"有个人的地址"},"definition":{"ar":["يربط شخصا بعنوان مراسلة شخص."],"ca":["Relaciona una persona amb una adreça d’una persona."],"cs":["Vztahuje osobu k adrese osoby."],"da":["Relaterer en person til en adresse på en person."],"de":["Setzt eine Person in Beziehung zu einer Adresse einer Person.,Setzt eine Person in Beziehung zu einer Adresse einer Person."],"el":["Συνδέει ένα φυσικό πρόσωπο με τη διεύθυνση ενός φυσικού προσώπου. R"],"en":["Relates a person to an address of a person."],"es":["Relaciona una persona con una dirección de una persona."],"et":["Seostab isiku isiku aadressiga."],"fi":["Liittää henkilön hänen osoitteeseensa."],"fr":["Met une personne en relation avec une adresse d’une personne."],"hu":["Hozzákapcsol egy személyt egy személy címéhez."],"it":["Correla una persona a un indirizzo di una persona."],"lv":["Sasaista personu ar personas adresi."],"nl":["Relateert een persoon aan een adres van een persoon."],"no":["Relaterer en person til en persons adresse."],"tr":["Bir kişiyi, kişinin adresiyle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个个人的一个地址关联起来。"]},"ToolkitLabel":{"ar":"عنوان مراسلة شخص","ca":"adreça d’una persona","cs":"adresa osoby","da":"adresse på person","de":"Adresse einer Person","de":"Adresse einer Person","el":"διεύθυνση του φυσικού προσώπου","en":"address of person","es":"dirección de persona","et":"isiku aadress","fi":"henkilön osoite","fr":"adresse d’une personne","hu":"személy címe:","it":"indirizzo di persona","lv":"personas adrese","nl":"adres van persoon","no":"adresse for person","tr":"Kişinin adresi","zh-Hans-CN":"个人的地址"},"ToolkitDefinition":{"ar":"عنوان مراسلة شخص.","ca":"Adreça d’una persona.","cs":"Adresa osoby.","da":"Adresse på en person.","de":"Eine Adresse einer Person.","de":"Eine Adresse einer Person.","el":"Η διεύθυνση ενός φυσικού προσώπου.","en":"An address of a person.","es":"Una dirección de una persona.","et":"Isiku aadress.","fi":"Henkilön osoite.","fr":"Adresse d’une personne.","hu":"Egy személy címe.","it":"Indirizzo di una persona.","lv":"Personas adrese.","nl":"Een adres van een persoon.","no":"En persons adresse.","tr":"Bir kişinin adresi","zh-Hans-CN":"一个个人的一个地址"},"note":{"ar":["يشمل أيضا البريد الإلكتروني، أو أي عنوان آخر على الإنترنت."],"ca":["Inclou un correu electrònic o qualsevol altra adreça en línia."],"cs":["Zahrnuje e-mail nebo jinou online adresu."],"da":["Omfatter en e-mail eller anden online-adresse."],"de":["Darunter fallen E-Mail-Adressen oder andere Online-Adressen.,Darunter fallen E-Mail-Adressen oder andere Online-Adressen."],"el":["Περιλαμβάνει μια διεύθυνση ηλεκτρονικής αλληλογραφίας ή άλλη επιγραμμική διεύθυνση."],"en":["Includes an email or other online address."],"es":["Incluye un correo u otra dirección electrónica."],"et":["Hõlmab ka e-posti vm võrguaadressi."],"fi":["Sisältää sähköpostin tai muun verkko-osoitteen."],"fr":["Comprend une adresse de courrier électronique ou une autre adresse en ligne."],"hu":["Email vagy más online cím is idetartozik."],"it":["Comprende un indirizzo email o un altro indirizzo online"],"lv":["Ietver e-pastu vai citu tiešsaistes adresi."],"nl":["Omvat tevens een e-mail of ander online adres."],"no":["Inkluderer epost eller annen online adresse."],"tr":["temsilcinin adresi ile ilişkilidir"],"zh-Hans-CN":["包括电子邮件和其他联机地址"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/addressOfPerson.en","instructionNumber":"9.12","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50418", "lexicalAlias":"http://rdaregistry.info/Elements/a/addressOfAgent.en", "label":"has address of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/datatype/P50114", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/addressOfPerson.en", "label":"has address of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50094","label":{"ar":"له مُعرِّف لشخص","ca":"té com a identificador de persona","cs":"má identifikátor osoby","da":"har identifikator for person","de":"hat Identifikator für eine Person","de":"hat Identifikator für eine Person","el":"έχει αναγνωριστικό για το φυσικό πρόσωπο","en":"has identifier for person","es":"tiene identificador para persona","et":"isiku identifikaator","fi":"henkilön tunniste","fr":"a pour identifiant de personne","hu":"személy azonosítója a következő:","it":"ha come identificatore di persona","lv":"personas identifikators","nl":"heeft identificatie voor persoon","no":"har identifikator for person","sv":"har identifikator för personen","tr":"kişinin tanımlayıcısı ile ilişkilidir","zh-Hans-CN":"有个人的标识符"},"definition":{"ar":["يربط شخصا بتسمية هي اسم شخص يتكون من رمز، أو رقم، أو سلسلة تمثيلات أخرى، عادة ما تكون مختلفة عن اللغة الطبيعية وعن التسميات المتعارف عليها اجتماعيا، المستخدمة في تعريف شخص."],"ca":["Relaciona una persona amb un nomen que és una apel·lació de persona que consisteix en un codi, un número o qualsevol altra cadena, habitualment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una persona."],"cs":["Vztahuje osobu k nomen, které je pojmenováním osoby, které se skládá z kódu, čísla nebo jiného řetězce, obvykle nezávislého na přirozeném jazyce a společenských konvencích pojmenování, které se používá k identifikaci osoby."],"da":["Relaterer en person til et nomen, som er en benævnelse på person, som består af en kode, nummer eller anden streng, ofte uafhængig af normalsprog og navngivningskonventioner, brugt til at identificere en person."],"de":["Setzt eine Person in Beziehung zu einer Bezeichnung für eine Person, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Person verwendet wird.,Setzt eine Person in Beziehung zu einer Bezeichnung für eine Person, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Person verwendet wird."],"el":["Συνδέει ένα φυσικό πρόσωπο με έναν αλφαριθμητικό χαρακτήρα μοναδικά συνδεδεμένο με ένα φυσικό πρόσωπο ή με ένα υποκατάστατο, όπως μια καθιερωμένη εγγραφή για το φυσικό πρόσωπο."],"en":["Relates a person to a nomen that is an appellation of person that consists of a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a person."],"es":["Relaciona una persona con un nomen que es un apelativo de persona que consiste en un código, número u otra secuencia, comúnmente independiente del lenguaje natural y de convenciones sociales de nomenclatura, utilizado para identificar a una persona."],"et":["Seostab isiku isiku nimetusega, mis koosneb isikut identifitseerivast koodist, numbrist või muust loomulikust keelest ja üldtuntud nimetamistavadest sõltumatust stringist."],"fi":["Liittää henkilön nomeniin, joka on henkilön nimitys, joka koostuu koodista, luvusta tai muusta tavallisesti luonnollisesta kielestä ja yleisistä nimeämiskäytännöistä riippumattomasta merkkijonosta, jota käytetään henkilön identifiointiin."],"fr":["Met une personne en relation avec un nomen qui est une appellation de personne consistant en un code, un nombre ou une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une personne."],"hu":["Hozzákapcsol egy személyt egy nomenhez, egy személy megnevezéséhez, amely egy kódból, számból, vagy más típusú karakterláncból áll, amely általában független a természetes nyelvektől és társadalmi névkonvencióktól, és egy személy azonosítására használják."],"it":["Correla una persona a una denominazione di persona consistente di un codice, numero o altra stringa, solitamente indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, usati per identificare una persona."],"lv":["Sasaista personu ar nomenu, kas ir personas apzīmējums, kas sastāv no koda, skaitļa vai citas virknes, kas parasti ir neatkarīgs no dabiskas valodas vai sabiedrībā pieņemtām nosaukšanas tradīcijām, ko izmanto, lai identificētu personu."],"nl":["Relateert een persoon aan een nomen dat is een benaming van persoon die bestaat uit een code, nummer of andere tekenreeks, meestal onafhankelijk van natuurlijke taal en gewoonlijke naamgevingsconventies, gebruikt om een persoon te identificeren."],"no":["Relaterer en person til en betegnelse for person som består av en kode, et nummer eller annen streng, vanligvis uavhengig av naturlig språk og sosiale navnekonvensjoner, brukt for å identifisere en person."],"tr":["Bir kişiyi, bir kişiyi tanımlamak için kullanılan, genellikle doğal dilden ve sosyal adlandırma kurallarından bağımsız olarak, bir kod, sayı veya başka bir dizeden oluşan bir kişinin unvanı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个由代码、数字、或其他字符串、通常独立于自然语言和社会命名惯例、用以标识一个个人的个人称谓的命名关联起来。"]},"ToolkitLabel":{"ar":"مُعرِّف لشخص","ca":"identificador de persona","cs":"identifikátor osoby","da":"identifikator for person","de":"Identifikator für eine Person","de":"Identifikator für eine Person","el":"αναγνωριστικό για το φυσικό πρόσωπο","en":"identifier for person","es":"identificador para persona","et":"isiku identifikaator","fi":"henkilön tunniste","fr":"identifiant de personne","hu":"személyazonosító:","it":"identificatore di persona","lv":"personas identifikators","nl":"identificatie voor persoon","no":"identifikator for person","sv":"identifikator för personen","tr":"kişinin tanımlayıcısı ile ilişkilidir","zh-Hans-CN":"个人标识符"},"ToolkitDefinition":{"ar":"تسمية هي اسم شخص يتكون من رمز، أو رقم، أو سلسلة تمثيلات أخرى، عادة ما تكون مختلفة عن اللغة الطبيعية وعن التسميات المتعارف عليها اجتماعيا، المستخدمة في تعريف شخص.","ca":"Nomen que és una apel·lació de persona que consisteix en un codi, un número o qualsevol altra cadena, habitualment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una persona.","cs":"Nomen, které je pojmenováním osoby, které se skládá z kódu, čísla nebo jiného řetězce, obvykle nezávislého na přirozeném jazyce a společenských konvencích pojmenování, které se používá k identifikaci osoby.","da":"Nomen, der er en benævnelse på person, som består af en kode, nummer eller anden streng, ofte uafhængig af normalsprog og navngivningskonventioner, brugt til at identificere en person.","de":"Eine Bezeichnung für eine Person, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Person verwendet wird.","de":"Eine Bezeichnung für eine Person, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Person verwendet wird.","el":"Ένας αλφαριθμητικός χαρακτήρας μοναδικά συνδεδεμένος με ένα φυσικό πρόσωπο ή με ένα υποκατάστατο, όπως μια καθιερωμένη εγγραφή για το φυσικό πρόσωπο.","en":"A nomen that is an appellation of person that consists of a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a person.","es":"Un nomen que es un apelativo de persona que consiste en un código, número u otra secuencia, comúnmente independiente del lenguaje natural y de convenciones sociales de nomenclatura, utilizado para identificar a una persona.","et":"Isiku nimetus, mis koosneb isikut identifitseerivast koodist, numbrist või muust loomulikust keelest ja üldtuntud nimetamistavadest sõltumatust stringist.","fi":"Nomen, joka on henkilön identifioimiseen käytetty nimitys, joka koostuu koodista, luvusta tai muusta merkkijonosta, joka on tavallisesti riippumaton luonnollisesta kielestä tai yleisistä nimeämiskäytännöistä.","fr":"Nomen qui est une appellation de personne consistant en un code, un nombre ou une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une personne.","hu":"Egy nomen, egy személy megnevezése, amely egy kódból, számból, vagy más típusú karakterláncból áll, amely általában független a természetes nyelvektől és társadalmi névkonvencióktól, és egy személy azonosítására használják.","it":"Denominazione di una persona consistente di un codice, numero o altra stringa, solitamente indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, usati per identificare una persona.","lv":"Personas apzīmējums, kas sastāv no koda, skaitļa vai citas virknes, kas parasti ir neatkarīgs no dabiskas valodas vai sabiedrībā pieņemtām nosaukšanas tradīcijām, ko izmanto, lai identificētu personu.","nl":"Een nomen dat is een benaming van persoon die bestaat uit een code, nummer of andere tekenreeks, meestal onafhankelijk van natuurlijke taal en gewoonlijke naamgevingsconventies, gebruikt om een persoon te identificeren.","no":"En betegnelse for person som består av en kode, et nummer eller annen streng, vanligvis uavhengig av naturlig språk og sosiale navnekonvensjoner, brukt for å identifisere en person.","tr":"Bir kişiyi tanımlamak için kullanılan, genellikle doğal dilden ve sosyal adlandırma kurallarından bağımsız olarak, bir kod, sayı veya başka bir dizgiden oluşan, kişinin unvanı olan bir isim.","zh-Hans-CN":"一个由代码、数字、或其他字符串、通常独立于自然语言和社会命名惯例、用以标识一个个人的个人称谓的命名"},"note":{"da":["Identifikatoren tjener til at skelne denne person fra andre personer."],"de":["Der Identifikator dient dazu, diese Person von anderen Personen zu unterscheiden."],"el":["Το αναγνωριστικό χρησιμοποιείται για τη διαφοροποίηση αυτού του φυσικού προσώπου από άλλα φυσικά πρόσωπα."],"fi":["Tunniste erottaa henkilön muista henkilöistä."],"fr":["L’identifiant sert à différencier une personne d’autres personnes."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/identifierForPerson.en","instructionNumber":"9.18","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50382", "lexicalAlias":"http://rdaregistry.info/Elements/a/appellationOfPerson.en", "label":"has appellation of person"},{"@id":"http://rdaregistry.info/Elements/a/P50383", "lexicalAlias":"http://rdaregistry.info/Elements/a/identifierForAgent.en", "label":"has identifier for agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50094", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/identifierForPerson.en", "label":"has identifier for person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50094", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/identifierForPerson.en", "label":"has identifier for person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50110","label":{"ar":"له لقب رتبة، أو شرف، أو منصب","ca":"té com a terme de rang o de distinció o de càrrec","cs":"má hodnost, titul nebo funkci","da":"har titel af rang, æresbevisning eller embede","de":"hat Rang-, Ehren- oder Amtsbezeichnung","de":"hat Rang-, Ehren- oder Amtsbezeichnung","el":"έχει όρο του βαθμού, του τίτλου τιμής ή του αξιώματος","en":"has term of rank or honour or office","es":"tiene término de rango u honorífico o de mandato","et":"isiku tiitel","fi":"henkilön arvonimi tai asema","fr":"a pour terme de rang ou d’honneur ou de fonction","hu":"rangot, hódolatot vagy hivatalt kifejező szava a következő:","it":"ha come titolo di rango, onore o carica","lv":"ranga, goda vai amata apzīmējums","nl":"heeft term van rank of eer of ambt","no":"har betegnelse for rang, utmerkelse eller tjeneste","tr":"rütbe, onur veya makam ile ilişkilidir","zh-Hans-CN":"有等级或荣誉或职位的称号"},"definition":{"ar":["يربط شخصا بكلمة أو عبارة تشير إلى رتبة ملكية، أو نبالة، أو منصب كنسي، أو لقب لشخص له وظيفة دينية."],"ca":["Relaciona una persona amb una paraula o frase indicativa de reialesa, de noblesa, de rang, de distinció o de càrrec, o terme de tractament d’una persona de vocació religiosa."],"cs":["Vztahuje osobu ke slovu nebo frázi označující královskou hodnost, šlechtický titul, čestný titul, úřední funkci nebo příslušnost k církevnímu řádu."],"da":["Relaterer en person til et ord eller udtryk, som indikerer kongeslægt, adelslægt, gejstlig rang eller embede, eller en tiltaleform for en person med religiøst hverv."],"de":["Setzt eine Person in Beziehung zu einem Wort oder einer Phrase, das/die auf die Zugehörigkeit zu einem Fürstentum, zum Adel, auf einen kirchlichen Rang oder ein kirchliches Amt hinweist, oder zu einer Anrede für eine Person mit religiöser Berufung.,Setzt eine Person in Beziehung zu einem Wort oder einer Phrase, das/die auf die Zugehörigkeit zu einem Fürstentum, zum Adel, auf einen kirchlichen Rang oder ein kirchliches Amt hinweist, oder zu einer Anrede für eine Person mit religiöser Berufung."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια λέξη ή φράση που υποδηλώνει βασιλεία, ευγένεια, εκκλησιαστικό αξίωμα ή έναν όρο προσφώνησης για ένα φυσικό πρόσωπο θρησκευτικού λειτουργήματος."],"en":["Relates a person to a word or phrase indicative of royalty, nobility, rank, honour, or office, or a term of address for a person of religious vocation."],"es":["Relaciona una persona con una palabra o frase indicativa de la realeza, nobleza, rango, distinción o cargo o un término para dirigirse a una persona de vocación religiosa."],"et":["Seostab isiku sõna või väljendiga, mis näitab kuninglikku seisust, aadliseisust, kiriklikku ametiastet või ametit, samuti kõnetlussõnaga, millega pöördutakse religioosse kutsumusega isiku poole."],"fi":["Liittää henkilön sanaan tai ilmaukseen, joka osoittaa kuninkaallista tai aatelisarvoa, kirkollista virkaa tai asemaa tai uskonnolliseen tehtävään liittyvää puhuttelua."],"fr":["Met une personne en relation avec un mot ou une locution qui indique la royauté, la noblesse, le rang, un honneur ou une fonction, ou un terme de politesse pour une personne à vocation religieuse."],"hu":["Hozzákapcsol egy személyt egy királyi, nemesi, egyházi rangot vagy hivatalt jelentő szóhoz vagy kifejezéshez, vagy egy személynek szóló vallási megszólítási formához, vagy egyéb rangot, hódolatot vagy hivatalt kifejező szóhoz."],"it":["Correla una persona a una parola o frase indicativa di regalità, nobiltà, rango ecclesiastico o di posizione lavorativa, o un titolo per una persona di vocazione religiosa."],"lv":["Sasaista personu ar vārdu vai frāzi, kas norāda uz karalisku vai aristokrātisku titulu, garīdznieka pakāpi vai amatu, vai uzrunas formu reliģiskas profesijas personai."],"nl":["Relateert een persoon aan een woord of uitdrukking wijzend op koningschap, adel, rang, eer of ambt, of een aanspreektitel voor een persoon met religieuze roeping."],"no":["Relaterer en person til Et ord eller en frase som viser en persons tilknytning til kongehus, adel eller religiøse institusjoner, tiltaleform for en person med et religiøst virke."],"tr":["Bir kişiyi, kraliyet, asalet, dini rütbe veya makama işaret eden bir kelime veya ifadeyle veya dini mesleği olan bir kişi için kullanılan bir hitap terimiyle ilişkilendirir."],"zh-Hans-CN":["将一个个人与表示皇室、贵族、教会级别或职位、或者一个宗教职业个人的称谓的一个单词或短语关联起来。"]},"note":{"ar":["مصطلح يدل على مكانة، أو شرف، أو منصب يتضمن الأحرف الأولى أو الاختصارات التي تمثل درجة أكاديمية، أو عضوية في مؤسسة ما، ولا يشمل الألقاب التي تشير إلى نوع الجنس أو الحالة الاجتماعية فقط مثل السيد أو السيدة."],"ca":["Un terme de rang o distinció o càrrec inclou inicials o abreviacions que representen un grau acadèmic o la pertinença a una organització."],"cs":["Výraz označující hodnost, titul nebo funkci zahrnuje iniciály či zkratky označující akademický titul nebo členství v organizaci."],"da":["Titel, som angiver rang, æresbevisning eller embede, inklusive initialer eller forkortelser, som repræsenterer en akademisk grad eller medlemskab i en organisation, og omfatter ikke tiltaleformer, der kun indikerer køn eller civilstand, som fx Hr. eller Fru."],"de":["Darunter fallen sonstige Termini, die den Rang, eine Ehre oder ein Amt anzeigen, einschließlich Initialen oder Abkürzungen, die einen akademischen Grad oder die Mitgliedschaft in einer Organisation anzeigen und schließt Termini der Anrede aus, die lediglich das Geschlecht oder den Familienstand angeben, wie Hr. oder Fr.,Zum Titel der Person gehören sonstige Termini, die den Rang, eine Ehre oder ein Amt anzeigen, einschließlich Initialen und/oder Abkürzungen, die einen akademischen Grad oder die Mitgliedschaft in einer Organisation anzeigen und schließt Termini der Anrede aus, die lediglich das Geschlecht oder den Familienstand angeben, wie Hr. oder Fr."],"el":["Ένας τίτλος ιεραρχίας, τιμής ή αξιώματος, ο οποίος περιλαμβάνει αρχικά ή συντομογραφίες που αναπαριστούν ένα ακαδημαϊκό πτυχίο ή ιδιότητα μέλους σε έναν οργανισμό, και δεν περιλαμβάνονται όροι προσφώνησης που απλώς υποδηλώνουν φύλο ή οικογενειακή κατάσταση, όπως Mr ή Mrs."],"en":["A term of rank or honour or office includes initials or abbreviations representing an academic degree, or membership in an organization."],"es":["Un término de rango, honorífico o de mandato que incluye siglas o abreviaturas que representan un grado académico, o una membresía en una organización, y excluye términos que simplemente indican género o estado civil tal como Sr. o Sra."],"et":["Termin, mis näitab auastet, austust või ametit. Hõlmab lühendeid, mis näitavad akadeemilist kraadi või organisatsiooni liikmelisust. Ei hõlma kõnetlussõnu, mis näitavad ainult sugu või abielustaatust, nt härra või proua."],"fi":["Henkilön arvonimellä tarkoitetaan myös muuta arvoa, kunnioitusta tai virka-asemaa osoittavaa termiä, sekä alkukirjaimia tai lyhenteitä, jotka ilmaisevat akateemista oppiarvoa tai järjestön jäsenyyttä. Henkilön arvonimellä ei tarkoiteta puhuttelusanaa, joka ainoastaan ilmaisee sukupuolta tai siviilisäätyä (esim. Mr., Mrs.)."],"fr":["Un terme de rang ou d’honneur ou de fonction comprend les initiales ou les abréviations représentant un grade universitaire ou l’appartenance à une organisation."],"hu":["A rang, megbecsülés vagy hivatali cím magában foglal tudományos fokozatot vagy szervezeti tagságot jelentő kezdőbetűket vagy rövidítéseket, és kizárja azokat a megszólító címeket, amelyek csak nemre vagy házassági státuszra utalnak, mint a Mr. vagy Mrs."],"it":["Un titolo di rango, onore, o carica, comprende iniziali o abbreviazioni che rappresentano un grado accademico, o l'appartenenza in una organizzazione, e esclude titoli che semplicemente indicano genere o lo stato civile come Sig. o Sig.ra"],"lv":["Ranga, goda vai amata apzīmējums ietver iniciāļus vai saīsinājumus, kas apzīmē akadēmisko grādu vai dalību organizācijā, un neietver uzrunas frāzes, kas vienkārši norāda dzimumu vai ģimenes stāvokli, piemēram, “kungs” vai “kundze”."],"nl":["Een term van rang of eer of ambt omvat initialen of afkortingen die een academische graad weergeven of lidmaatschap van een organisatie."],"no":["En betegnelse for rang, utmerkelse eller tjeneste inkluderer initialer eller forkortelser som representerer en akademisk grad eller medlemsskap i en organisasjon, men utelukker betegnelser som kun angir kjønn eller sivilstatus som for eksempel Mr. eller Mrs."],"tr":["Bir rütbe, onur veya makam terimi, akademik bir dereceyi veya bir kuruluştaki üyeliği temsil eden baş harfleri veya kısaltmaları içerir ve cinsiyet veya medeni durumu belirten bay veya bayan gibi hitap terimlerini hariç tutar."],"zh-Hans-CN":["等级、荣誉或职位的称号包括表示学位、组织成员等的缩略语。"]},"ToolkitLabel":{"ar":"مصطلح يدل على مكانة، أو شرف، أو منصب","ca":"terme de rang o de distinció o de càrrec","cs":"hodnost, titul nebo funkce","da":"titel af rang, æresbevisning eller embede","de":"Rang-, Ehren- oder Amtsbezeichnung","de":"Rang-, Ehren- oder Amtsbezeichnung","el":"όρος του βαθμού, του τίτλου τιμής ή του αξιώματος","en":"term of rank or honour or office","es":"término de rango u honorífico o de mandato","et":"isiku tiitel","fi":"henkilön arvonimi tai asema","fr":"terme de rang ou d’honneur ou de fonction","hu":"rangot, hódolatot vagy hivatalt kifejező szava:","it":"titolo di rango, onore, o carica","lv":"ranga, goda vai amata apzīmējums","nl":"term van rank of eer of ambt","no":"betegnelse for rang, utmerkelse eller tjeneste","tr":"rütbe, onur veya görev unvanı","zh-Hans-CN":"等级或荣誉或职位的称号"},"ToolkitDefinition":{"ar":"كلمة أو عبارة تشير إلى رتبة ملكية أو نبالة أو منصب كنسي أو مصطلح يُخاطب به شخص له وظيفة دينية.","ca":"Paraula o frase indicativa de reialesa, de noblesa, de rang, de distinció o de càrrec, o terme de tractament d’una persona de vocació religiosa.","cs":"Slovo nebo fráze označující královskou hodnost, šlechtický titul, čestný titul, úřední funkci nebo příslušnost k církevnímu řádu.","da":"Ord eller udtryk, som indikerer kongeslægt, adelslægt, gejstlig rang eller embede, eller en tiltaleform for en person med religiøst hverv.","de":"Ein Wort oder eine Phrase, das/die auf die Zugehörigkeit zu einem Fürstentum, zum Adel, auf einen kirchlichen Rang oder ein kirchliches Amt hinweist, oder eine Anrede für eine Person mit religiöser Berufung.","de":"Ein Wort oder eine Phrase, das/die auf die Zugehörigkeit zu einem Fürstentum, zum Adel, auf einen kirchlichen Rang oder ein kirchliches Amt hinweist, oder eine Anrede für eine Person mit religiöser Berufung.","el":"Μια λέξη ή φράση που υποδηλώνει βασιλεία, ευγένεια, εκκλησιαστικό αξίωμα ή ένας όρος προσφώνησης για ένα φυσικό πρόσωπο θρησκευτικού λειτουργήματος.","en":"A word or phrase indicative of royalty, nobility, rank, honour, or office, or a term of address for a person of religious vocation.","es":"Una palabra o frase indicativa de la realeza, nobleza, rango, distinción o cargo o un término para dirigirse a una persona de vocación religiosa.","et":"Sõna või väljend, mis näitab kuninglikku seisust, aadliseisust, kiriklikku ametiastet või ametit, samuti kõnetlussõna, millega pöördutakse religioosse kutsumusega isiku poole.","fi":"Sana tai ilmaus, joka osoittaa kuninkaallista tai aatelisarvoa, kirkollista virkaa tai asemaa tai uskonnolliseen tehtävään liittyvää puhuttelua.","fr":"Mot ou locution qui indique la royauté, la noblesse, le rang, un honneur ou une fonction, ou terme de politesse pour une personne à vocation religieuse.","hu":"Egy királyi, nemesi, egyházi rangot vagy hivatalt jelentő szó vagy kifejezés, vagy egy személynek szóló vallási megszólítási forma.","it":"Parola o frase indicativa di regalità, nobiltà, rango ecclesiastico o di posizione lavorativa, o un titolo per una persona di vocazione religiosa.","lv":"Vārds vai frāze, kas norāda uz karalisku vai aristokrātisku titulu, garīdznieka pakāpi vai amatu, vai uzrunas formu reliģiskas profesijas personai.","nl":"Een woord of uitdrukking wijzend op koningschap, adel, rang, eer of ambt, of een aanspreektitel voor een persoon met religieuze roeping.","no":"Et ord eller en frase som viser en persons tilknytning til kongehus, adel eller religiøse institusjoner, tiltaleform for en person med et religiøst virke.","tr":"Kraliyet, asalet, dini rütbe veya makamı belirten bir kelime veya ifadeyi veya dini mesleği olan bir kişi için bir hitap terimi.","zh-Hans-CN":"表示皇室、贵族、教会级别或职位、或者一个宗教职业个人的称谓的一个单词或短语"},"altLabel":{"ar":["لقب الشخص"],"ca":["títol d’una persona"],"cs":["titul osoby"],"da":["titel af person"],"de":["Titel einer Person,Titel einer Person"],"el":["τίτλος του φυσικού προσώπου"],"en":["title of person"],"es":["título de persona"],"fi":["henkilön arvonimi"],"fr":["titre d’une personne,terme de rang, d’honneur ou de fonction"],"hu":["személy titulusa:"],"it":["titolo di persona"],"nl":["titel van persoon"],"no":["tittel på person"],"tr":["kişinin unvanı"],"zh-Hans-CN":["个人的头衔"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"9.4","lexicalAlias":"http://rdaregistry.info/Elements/a/termOfRankOrHonourOrOffice.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50110", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/termOfRankOrHonourOrOffice.en", "label":"has term of rank or honour or office"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50110", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/termOfRankOrHonourOrOffice.en", "label":"has term of rank or honour or office"}]},{"@id":"http://rdaregistry.info/Elements/a/P50117","label":{"ar":"له اسم مفضل لشخص","ca":"té com a nom preferit de persona","cs":"má preferované jméno osoby","da":"har foretrukket navn på person","de":"hat bevorzugten Namen einer Person","de":"hat bevorzugten Namen einer Person","el":"έχει προτιμώμενο όνομα του φυσικού προσώπου","en":"has preferred name of person","es":"tiene nombre preferido de persona","et":"isiku eelisnimi","fi":"henkilön ensisijainen nimi","fr":"a pour nom privilégié d’une personne","hu":"személy előnyben részesített neve a következő:","it":"ha come nome preferito di persona","lv":"personas prioritārais vārds","nl":"heeft geprefereerde naam van persoon","no":"har foretrukket personnavn","tr":"tercih edilen kişi adı ile ilişkilidir","zh-Hans-CN":"有个人的首选名称"},"definition":{"ar":["يربط شخصا باسم شخص اختير للتفضيل في تطبيق أو في سياق محدد."],"ca":["Relaciona una persona amb un nomen que és un nom de persona que se selecciona com a preferent en una aplicació o un context específic."],"cs":["Vztahuje osobu k nomen, které je jménem osoby, které je vybráno jako preferovanéve specifické aplikaci nebo kontextu."],"da":["Relaterer en person til et nomen, som er et navn på person, som er valgt som foretrukken i en specifik anvendelse eller kontekst."],"de":["Setzt eine Person in Beziehung zu einem Namen einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.,Setzt eine Person in Beziehung zu einem Namen einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα όνομα ή τη μορφή ονόματος που έχει επιλεγεί για την ταύτιση ενός φυσικού προσώπου."],"en":["Relates a person to a nomen that is a name of person that is selected for preference in a specific application or context."],"es":["Relaciona una persona con un nomen que es un nombre de persona que es seleccionado para preferencia en una aplicación o un contexto específico."],"et":["Seostab isiku isiku nimega, mis kindlas rakenduses või kontekstis on valitud eelistatuks."],"fi":["Liittää henkilön nomeniin, joka on henkilön nimi, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa."],"fr":["Met une personne en relation avec un nomen qui est un nom de personne faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques."],"hu":["Hozzákapcsol egy személyt egy személynév nomenhez, amelyet egy bizonyos alkalmazásban vagy kontextusban előnyben részesítenek."],"it":["Correla una persona a un nome scelto come preferito in una specifica applicazione o contesto."],"lv":["Sasaista personu ar nomenu, kas ir personas vārds, kurš ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā."],"nl":["Relateert een persoon aan een nomen dat is een naam van persoon die de voorkeur heeft gekregen in een specifieke applicatie of context."],"no":["Relaterer en person til et navn på person som er valgt som preferanse i en bestemt applikasjon eller kontekst."],"tr":["Bir kişiyi, özel uygulama veya bağlamda tercih edilmek üzere seçilen bir kişi ismiyle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个作为个人名称并在特定应用或语境下优先选用的命名关联起来。"]},"ToolkitLabel":{"ar":"اسم مفضل لشخص","ca":"nom preferit de persona","cs":"preferované jméno osoby","da":"foretrukket navn på person","de":"Bevorzugter Name einer Person","de":"Bevorzugter Name einer Person","el":"προτιμώμενο όνομα του φυσικού προσώπου","en":"preferred name of person","es":"nombre preferido de persona","et":"isiku eelisnimi","fi":"henkilön ensisijainen nimi","fr":"nom privilégié d’une personne","hu":"személy előnyben részesített neve:","it":"nome preferito di persona","lv":"personas prioritārais vārds","nl":"geprefereerde naam van persoon","no":"foretrukket personnavn","tr":"kişinin tercih ettiği isim","zh-Hans-CN":"个人的首选名称"},"ToolkitDefinition":{"ar":"يربط شخصا باسم اختير كاسم مفضل في تطبيق أو في سياق محدد.","ca":"Nomen que és un nom de persona que se selecciona com a preferent en una aplicació o un context específic.","cs":"Nomen, které je jménem osoby, které je vybráno jako preferovanéve specifické aplikaci nebo kontextu.","da":"Nomen, som er et navn på person, som er valgt som foretrukken i en specifik anvendelse eller kontekst.","de":"Ein Name einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.","de":"Ein Name einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.","el":"Ένα όνομα ή μορφή ονόματος που επιλέγεται για την ταύτιση ενός φυσικού προσώπου.","en":"A nomen that is a name of person that is selected for preference in a specific application or context.","es":"Un nomen que es un nombre de persona que es seleccionado para preferencia en una aplicación o un contexto específico.","et":"Isiku nimi, mis kindlas rakenduses või kontekstis on valitud eelistatuks.","fi":"Nomen, joka on henkilön nimi, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.","fr":"Nomen qui est un nom de personne faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques.","hu":"Egy személynév nomen, amelyet egy bizonyos alkalmazásban vagy kontextusban előnyben részesítenek.","it":"Nome scelto come preferito in una specifica applicazione o contesto.","lv":"Personas vārds, kurš ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā.","nl":"Een nomen dat is een naam van persoon die de voorkeur heeft gekregen in een specifieke applicatie of context.","no":"Et navn på person som er valgt som preferanse i en bestemt applikasjon eller kontekst.","tr":"Belirli bir uygulamada veya bağlamda tercih için seçilen kişi adı olan bir isim.","zh-Hans-CN":"一个作为个人名称并在特定应用或语境下优先选用的命名"},"altLabel":{"ar":["اسم مفضل لشخص"],"cs":["preferované jméno pro osobu"],"da":["foretrukket navn på person"],"de":["Bevorzugter Name für eine Person,Bevorzugter Name für eine Person"],"en":["preferred name for person"],"es":["nombre preferido para persona"],"fi":["-"],"hu":["előnyben részesített személynév:"],"nl":["geprefereerde naam voor persoon"],"tr":["kişinin tercih ettiği isim"],"zh-Hans-CN":["给个人的首选名称"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
