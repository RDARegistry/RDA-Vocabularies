                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/specialEffectsProviderCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50774", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCollectiveAgentToPerformanceOf.en", "label":"is contributor collective agent to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50244", "lexicalAlias":"http://rdaregistry.info/Elements/a/specialEffectsProviderAgentOf.en", "label":"is special effects provider agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50882", "lexicalAlias":"http://rdaregistry.info/Elements/a/specialEffectsProviderCorporateBodyOf.en", "label":"is special effects provider corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51033", "lexicalAlias":"http://rdaregistry.info/Elements/a/specialEffectsProviderFamilyOf.en", "label":"is special effects provider family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50731", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/specialEffectsProviderCollectiveAgentOf.en", "label":"is special effects provider collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50731", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/specialEffectsProviderCollectiveAgentOf.en", "label":"is special effects provider collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50882","label":{"ar":"هي هيئة موردة للمؤثرات الخاصة لـ","ca":"és entitat corporativa proveïdora d’efectes especials de","cs":"je poskytovatelem speciálních efektů (korporací) (čeho)","da":"er korporation, som er leverandør af specialeffekter af","de":"ist Körperschaft als Special-effects-Provider von","de":"ist Körperschaft als Special-effects-Provider von","el":"είναι παροχέας ειδικών αποτελεσμάτων συλλογικό όργανο του","en":"is special effects provider corporate body of","es":"es organismo corporativo proveedor de efectos especiales de","et":"eriefektide tootja (asutus) väljenduses","fi":"erikoistehosteiden tekijä (yhteisö) ekspressiossa","fr":"est une collectivité fournisseuse d’effets spéciaux de","hu":"speciális effektusokat szolgáltató testülete a következőnek:","it":"è curatore degli effetti speciali ente di","lv":"ir specefektu mākslinieks (institūcija)","nl":"is aanbieder speciale effecten-corporatie van","no":"er leverandør av spesialeffekter for (korporasjon)","tr":"özel efekt sağlayıcısı tüzel kişisidir.","zh-Hans-CN":"是……的特殊效果提供者团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة لتصميم وإنشاء مؤثرات خاصة مدمجة، مثل المؤثرات الميكانيكية المضبوطة والمؤثرات البصرية في الكاميرا."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa en el disseny i la creació d’efectes especials de plató, com ara efectes mecànics de plató i efectes òptics de càmera."],"cs":["Vztahuje korporaci k vyjádření, což zahrnuje přispění korporace tím, že navrhuje a vytváří speciální efekty při natáčení, jako jsou mechanické efekty a kamerové optické efekty."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at designe og skabe specialeffekter på stedet, såsom mekaniske effekter og optiske kameraeffekter."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie am Set Spezialeffekte, wie zum Beispiel mechanische Effekte am Set und optische Effekte in der Kamera, entwirft und erstellt.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie am Set Spezialeffekte, wie zum Beispiel mechanische Effekte am Set und optische Effekte in der Kamera, entwirft und erstellt."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of designing and creating on-set special effects, such as on-set mechanical effects and in-camera optical effects."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de diseñar y crear efectos especiales en el set, tal como efectos mecánicos en el set y efectos ópticos en cámara."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, kavandades ja luues salvestusaegsed eriefektid, nt salvestusaegsed mehaanilised efektid ja kaameraga tehtavad optilised efektid."],"fi":["Liittää yhteisön ekspressioon, jossa yhteisö on osallisena liikkuvan kuvan tai ääniteoksen ekspression tekemisessä suunnittelemalla ja luomalla taltioinnin aikana tapahtuvat erikoistehosteet, kuten mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à concevoir et à créer des effets spéciaux de plateau tels que des effets mécaniques de plateau et des effets d’optique dans la caméra."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését olyan helyszíni speciális effektusok tervezésében és létrehozásában, mint a mechanikai és kamerán belüli optikai hatások."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nella progettazione e creazione di effetti speciali sul set, quali effetti meccanici sul set ed effetti ottici della telecamera."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, izstrādājot un radot scēnu specefektus, piemēram, radot scēnas mehāniskos efektus un kameras specifiskos optiskos efektus."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door ontwerpen en creëren van op-de-set speciale effecten, zoals op-de-set mechanische effecten en in-camera optische effecten."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å utforme og skape spesialeffekter under innspilling, for eksempel mekaniske effekter på settet eller optiske effekter i kameraet."],"tr":["Bir tüzel kişiyi, sette mekanik efektler ve kamera içi optik efektler gibi sette özel efektlerin tasarlanması ve oluşturulmasında bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括设计并创作现场特殊效果（例如现场机械效果和相机光学效果）的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة موردة للمؤثرات الخاصة","ca":"entitat corporativa proveïdora d’efectes especials de","cs":"poskytovatel speciálních efektů (korporace) (čeho)","da":"korporation, som er leverandør af specialeffekter af","de":"Körperschaft als Special-effects-Provider von","de":"Körperschaft als Special-effects-Provider von","el":"παροχέας ειδικών αποτελεσμάτων συλλογικό όργανο του","en":"special effects provider corporate body of","es":"organismo corporativo proveedor de efectos especiales de","et":"eriefektide tootja (asutus) väljenduses","fi":"erikoistehosteiden tekijä (yhteisö) ekspressiossa","fr":"collectivité fournisseuse d’effets spéciaux de","hu":"speciális effektusokat szolgáltató testülete:","it":"curatore degli effetti speciali ente di","lv":"ir specefektu mākslinieks (institūcija)","nl":"aanbieder speciale effecten-corporatie van","no":"leverandør av spesialeffekter for (korporasjon)","tr":"özel efekt sağlayıcı tüzel kişi","zh-Hans-CN":"……的特殊效果提供者团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة لتصميم وإنشاء مؤثرات خاصة مدمجة، مثل المؤثرات الميكانيكية المضبوطة والمؤثرات البصرية في الكاميرا.","ca":"Expressió que inclou una contribució d’una entitat corporativa en el disseny i la creació d’efectes especials de plató, com ara efectes mecànics de plató i efectes òptics de càmera.","cs":"Vyjádření, což zahrnuje přispění korporace tím, že navrhuje a vytváří speciální efekty při natáčení, jako jsou mechanické efekty a kamerové optické efekty.","da":"Udtryk, som omfatter en korporations bidrag ved at designe og skabe specialeffekter på stedet, såsom mekaniske effekter og optiske kameraeffekter.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie am Set Spezialeffekte, wie zum Beispiel mechanische Effekte am Set und optische Effekte in der Kamera, entwirft und erstellt.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie am Set Spezialeffekte, wie zum Beispiel mechanische Effekte am Set und optische Effekte in der Kamera, entwirft und erstellt.","en":"An expression that includes a contribution by a corporate body of designing and creating on-set special effects, such as on-set mechanical effects and in-camera optical effects.","es":"Una expresión que incluye una contribución de un organismo corporativo de diseñar y crear efectos especiales en el set, tal como efectos mecánicos en el set y efectos ópticos en cámara.","et":"Väljendus, millesse asutus on andnud panuse, kavandades ja luues salvestusaegsed eriefektid, nt salvestusaegsed mehaanilised efektid ja kaameraga tehtavad optilised efektid.","fi":"Ekspressio, jossa yhteisö on osallisena liikkuvan kuvan tai ääniteoksen ekspression tekemisessä suunnittelemalla ja luomalla taltioinnin aikana tapahtuvat erikoistehosteet, kuten mekaaniset tehosteet ja kameralla toteutettavat optiset tehosteet.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à concevoir et à créer des effets spéciaux de plateau tels que des effets mécaniques de plateau et des effets d’optique dans la caméra.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését olyan helyszíni speciális effektusok tervezésében és létrehozásában, mint a mechanikai és kamerán belüli optikai hatások.","it":"Espressione che comprende un contributo di un ente nella progettazione e creazione di effetti speciali sul set, quali effetti meccanici sul set ed effetti ottici della telecamera.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, izstrādājot un radot scēnu specefektus, piemēram, radot scēnas mehāniskos efektus un kameras specifiskos optiskos efektus.","nl":"Een expressie die omvat een bijdrage door een corporatie door ontwerpen en creëren van op-de-set speciale effecten, zoals op-de-set mechanische effecten en in-camera optische effecten.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å utforme og skape spesialeffekter under innspilling, for eksempel mekaniske effekter på settet eller optiske effekter i kameraet.","tr":"Sette mekanik efektler ve kamera içi optik efektler gibi sette özel efektler tasarlama ve oluşturmada tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括设计并创作现场特殊效果（例如现场机械效果和相机光学效果）的一个团体的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
