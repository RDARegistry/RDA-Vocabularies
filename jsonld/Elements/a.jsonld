                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50203", "lexicalAlias":"http://rdaregistry.info/Elements/a/publisherAgentOf.en", "label":"is publisher agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/broadcasterAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50644", "lexicalAlias":"http://rdaregistry.info/Elements/a/broadcasterCollectiveAgentOf.en", "label":"is broadcaster collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50493", "lexicalAlias":"http://rdaregistry.info/Elements/a/broadcasterPersonOf.en", "label":"is broadcaster person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50168", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/broadcasterAgentOf.en", "label":"is broadcaster agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50168", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/broadcasterAgentOf.en", "label":"is broadcaster agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50644","label":{"ar":"هو وكيل جماعي مذيع لـ","ca":"és agent col·lectiu difusor audiovisual de","cs":"je vysílatelem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er broadcaster af","de":"ist gemeinschaftlicher Akteur als Sender von","de":"ist gemeinschaftlicher Akteur als Sender von","el":"είναι ευρυεκπομπέας συλλογικός φορέας του","en":"is broadcaster collective agent of","es":"es agente colectivo de radiodifusores de","et":"leviedastaja (kollektiiv) kehastuses","fi":"lähetyksestä vastaava yhteistoimija manifestaatiossa","fr":"est un agent collectif diffuseur audiovisuel de","hu":"műsorszolgáltató kollektív ágense a következőnek:","it":"è emittente agente collettivo di","lv":"ir raidorganizācija (grupa)","nl":