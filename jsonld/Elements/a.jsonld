ggeber von"],"el":["αναθέτον όργανο του"],"en":["commissioning body of"],"es":["organismo comisionador de"],"et":["tellija teoses"],"fi":["teettäjänä teokselle"],"fr":["commanditaire de"],"hu":["megrendelője:"],"it":["committente di"],"nl":["opdrachtgever van"],"no":["oppdragsgiver for"],"tr":["görevlendiren kuruluş"],"zh-Hans-CN":["……的委托团体"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50305", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfAgent.en", "label":"has related work of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/commissioningAgentOf.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50689", "lexicalAlias":"http://rdaregistry.info/Elements/a/commissioningCollectiveAgentOf.en", "label":"is commissioning collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50538", "lexicalAlias":"http://rdaregistry.info/Elements/a/commissioningPersonOf.en", "label":"is commissioning person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50262", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/commissioningAgentOf.en", "label":"is commissioning agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50262", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/commissioningAgentOf.en", "label":"is commissioning agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50689","label":{"ar":"هو وكيل جماعي جهة تكليف لـ","ca":"és agent col·lectiu comitent de","cs":"je zadavatelem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er opgavestiller af","de":"ist gemeinschaftlicher Akteur als Auftraggeberin/Auftraggeber von","de":"ist gemeinschaftlicher Akteur als Auftraggeberin/Auftraggeber von","el":"είναι προσληφθέν όργανο συλλογικός φορέας του","en":"is commissioning collective agent of","es":"es agente colectivo comisionado de","et":"tellija (kollektiiv) teoses","fi":"toimeksiantaja (yhteistoimija) teoksessa","fr":"est un agent collectif commanditaire de","hu":"megrendelő kollektív ágense a következőnek:","it":"è ente committente agente collettivo di","lv":"ir pasūtītājs (grupa)","nl":"is opdrachtgever-collectieve actor van","no":"er oppdragsgiver for (kollektiv agent)","tr":"görevlendiren kolektif temsilcisidir","zh-Hans-CN":"是……的委托集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل ينطوي على مسئوليته عن إصدار التكليف بعمل."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu d’encarregar una obra."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za zadání díla."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at bestille et værk."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur dafür verantwortlich ist, ein Werk in Auftrag zu geben.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur dafür verantwortlich ist, ein Werk in Auftrag zu geben."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for commissioning a work."],"es":["Relaciona a un agente colectivo con una obra que implica una responsabilidad de un agente colectivo por encargar una obra."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust teose tellimise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa teoksen teettämisestä."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à commander une œuvre."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy mű megrendeléséért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo nella committenza di un'opera."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par darba pasūtīšanu."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een ve