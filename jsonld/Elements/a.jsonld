                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/descendantFamilyOfPerson.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50233", "lexicalAlias":"http://rdaregistry.info/Elements/a/personMemberOfFamilyOf.en", "label":"is person member of family of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50099", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/descendantFamilyOfPerson.en", "label":"has descendant family of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50099", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/descendantFamilyOfPerson.en", "label":"has descendant family of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50245","label":{"ar":"هو وكيل رسّام حروف لـ","ca":"és agent retolista de","cs":"je letrážistou (agentem) (čeho)","da":"er agent, som er bogstavtegner af","de":"ist Akteur als Letterer von","de":"ist Akteur als Letterer von","el":"είναι σχεδιαστής γραμμάτων επιγραφών φορέας του","en":"is letterer agent of","es":"es agente rotulista de","et":"tekstijoonistaja (tegija) väljenduses","fi":"tekstaaja (toimija) ekspressiossa","fr":"est un agent lettreur de","hu":"betűrajzoló ágense a következőnek:","it":"è compilatore di dialoghi per fumetti agente di","lv":"ir komiksa teksta rakstītājs (aģents)","nl":"is letteraar-actor van","no":"er letterer for (agent)","tr":"yazı tasarımcısı temsilcisidir","zh-Hans-CN":"是……的字母图案画者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل برسم النص وتصميم المؤثرات الصوتية المصاحبة لرسومات قصة مصورة أو رواية مصورة، إلخ."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent en el dibuix de text i d’efectes sonors gràfics d’un còmic, una novel·la gràfica, etc."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že kreslí text a grafické zvukové efekty pro komiks, grafický román atd."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at tegne tekst og grafiske lydeffekter til en tegneserie, graphic novel etc."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet."],"el":["Συνδέει έναν εικονογράφο που συνεισφέρει σε μια έκφραση ενός κόμικ, νουβέλας με γραφικά κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of drawing text and graphic sound effects for a comic book, graphic novel, etc."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de dibujar texto y efectos de sonido gráficos para un libro de comics, novela gráfica, etc."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, joonistades teksti ja graafilisi helijäljendusi koomiksi, graafilise romaani vms jaoks."],"fi":["Liittää toimijan ekspressioon, jossa toimija osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à dessiner le texte et les effets sonores graphiques pour une bande dessinée, un roman graphique, etc."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését képregény, képregényalbum stb. szövegének és grafikai hangeffektusainak rajzolásában."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nel disegno di testo ed effetti sonori grafici per un fumetto, graphic novel, etc."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, zīmējot tekstu un skaņu efektus grafiskā formā komiksu grāmatai, grafiskam romānam u.tml."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door tekenen van tekst en grafische geluidseffecten voor een comic, stripboek etc."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å tegne tekst og grafiske lydeffekter for en tegneserie, tegneserieroman, etc."],"tr":["Bir temsilciyi, bir çizgi roman, grafik roman vb. için metin ve grafik ses efektleri çizen bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括一个为漫画书、图解小说等绘制文字和图案声音效果的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل رسّام حروف لـ","ca":"agent retolista de","cs":"letrážista (agent) (čeho)","da":"agent, som er bogstavstegner af","de":"Akteur als Letterer von","de":"Akteur als Letterer von","el":"σχεδιαστής γραμμάτων επιγραφών φορέας του","en":"letterer agent of","es":"agente rotulista de","et":"tekstijoonistaja (tegija) väljenduses","fi":"tekstaaja (toimija) ekspressiossa","fr":"agent lettreur de","hu":"betűrajzoló ágense:","it":"compilatore di dialoghi per fumetti agente du","lv":"ir komiksa teksta rakstītājs (aģents)","nl":"letteraar-actor van","no":"letterer for (agent)","tr":"Hat sanatçısı temsilcisi","zh-Hans-CN":"……的字母图案画者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل برسم النص وتصميم المؤثرات الصوتية المصاحبة لرسومات قصة مصورة أو رواية مصورة، إلخ.","ca":"Expressió que inclou una contribució d’un agent en el dibuix de text i d’efectes sonors gràfics d’un còmic, una novel·la gràfica, etc.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že kreslí text a grafické zvukové efekty pro komiks, grafický román atd.","da":"Udtryk, som omfatter en agents bidrag ved at tegne tekst og grafiske lydeffekter til en tegneserie, graphic novel etc.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er für ein Comicbuch, eine Graphic Novel und so weiter Text und grafische Toneffekte zeichnet.","el":"Μια έκφραση ενός κόμικ, νουβέλας με γραφικά κ.λπ., η οποία ενσωματώνει τη συνεισφορά της εικονογράφησης.","en":"An expression that includes a contribution by an agent of drawing text and graphic sound effects for a comic book, graphic novel, etc.","es":"Una expresión que incluye una contribución de un agente de dibujar texto y efectos de sonido gráficos para un libro de comics, novela gráfica, etc.","et":"Väljendus, millesse tegija on andnud panuse, joonistades teksti ja graafilisi helijäljendusi koomiksi, graafilise romaani vms jaoks.","fi":"Ekspressio, jossa toimija osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à dessiner le texte et les effets sonores graphiques pour une bande dessinée, un roman graphique, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését képregény, képregényalbum stb. szövegének és grafikai hangeffektusainak rajzolásában.","it":"Espressione che include un contributo da parte di un agente nel disegno di testo ed effetti sonori grafici per un fumetto, graphic novel, etc.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, zīmējot tekstu un skaņu efektus grafiskā formā komiksu grāmatai, grafiskam romānam u.tml.","nl":"Een expressie die omvat een bijdrage door een actor door tekenen van tekst en grafische geluidseffecten voor een comic, stripboek etc.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å tegne tekst og grafiske lydeffekter for en tegneserie, tegneserieroman, etc.","tr":"Bir çizgi roman için metin ve grafik ses efektleri çizen bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括一个为漫画书、图解小说等绘制文字和图案声音效果的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["رسّام حروف"],"ca":["retolista de"],"cs":["letrážista (čeho)"],"da":["bogstavstegner af"],"de":["Letterer von,Letterer von"],"el":["σχεδιαστής γραμμάτων επιγραφών του"],"en":["letterer of"],"es":["rotulista de"],"et":["tekstijoonistaja väljenduses"],"fi":["tekstaajana ekspressiossa"],"fr":["lettreur de"],"hu":["betűrajzolója:"],"it":["compilatore di dialoghi per fumetti di"],"nl":["letteraar van"],"no":["letterer for"],"tr":["Hat sanatçısı"],"zh-Hans-CN":["……的字母图案画者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
