                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"lexicalAlias":"http://rdaregistry.info/Elements/a/languageOfCorporateBody.en","instructionNumber":"11.8","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50402", "lexicalAlias":"http://rdaregistry.info/Elements/a/languageOfCollectiveAgent.en", "label":"has language of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50023", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/languageOfCorporateBody.en", "label":"has language of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50023", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/languageOfCorporateBody.en", "label":"has language of corporate body"}]},{"@id":"http://rdaregistry.info/Elements/a/P50231","label":{"ar":"لها هيئة عضو في هيئة","ca":"té com a entitat corporativa membre d’una entitat corporativa","cs":"má korporativního člena korporace","da":"har korporation, som er medlem af korporation","de":"ist Mitglied einer Körperschaft (Körperschaft)","de":"ist Mitglied einer Körperschaft (Körperschaft)","el":"έχει εταιρικό μέλος του συλλογικού οργάνου","en":"has corporate body member of corporate body","es":"tiene organismo corporativo miembro de organismo corporativo","et":"asutuse liige (asutus)","fi":"yhteisön yhteisöjäsen","fr":"a pour collectivité membre d’une collectivité","hu":"testület testületi tagja a következő:","it":"ha come ente membro di ente","lv":"institūcijas dalībnieks (institūcija)","nl":"heeft corporatief lid van corporatie","no":"har medlemskorporasjon","tr":"tüzel kişinin tüzel kişi üyesi ile ilişkilidir","zh-Hans-CN":"有团体的团体成员"},"definition":{"ar":["يربط هيئة بهيئة هي عضو في هيئة."],"ca":["Relaciona una entitat corporativa amb una entitat corporativa que és un membre d’una entitat corporativa."],"cs":["Vztahuje korporaci ke korporaci, která je členem korporace."],"da":["Relaterer en korporation til en korporation, som er et medlem af en korporation."],"de":["Setzt eine Körperschaft in Beziehung zu einer Körperschaft, die Mitglied einer Körperschaft ist.,Setzt eine Körperschaft in Beziehung zu einer Körperschaft, die Mitglied einer Körperschaft ist."],"el":["Συνδέει ένα συλλογικό όργανο με ένα συλλογικό όργανο το οποίο είναι μέλος κάποιου άλλου συλλογικού οργάνου."],"en":["Relates a corporate body to a corporate body who is a member of a corporate body."],"es":["Relaciona un organismo corporativo con un organismo corporativo que es miembro de un organismo corporativo."],"et":["Seostab asutuse asutusega, mis on asutuse liige."],"fi":["Liittää yhteisön yhteisöön, joka on toisen yhteisön jäsenyhteisö."],"fr":["Met une collectivité en relation avec une collectivité qui est membre d’une collectivité."],"hu":["Hozzákapcsol egy testületet egy testülethez, amely egy testület tagja."],"it":["Correla un ente a un ente che è membro di un ente."],"lv":["Sasaista institūciju ar institūciju, kas ir institūcijas dalībniece."],"nl":["Relateert een corporatie aan een corporatie die een lid is van een corporatie."],"no":["Relaterer en korporasjon til en korporasjon som er medlem av en korporasjon."],"tr":["Bir tüzel kişiyi, bir tüzel kişiliğin üyesi olan bir tüzel kişilikle ilişkilendirir."],"zh-Hans-CN":["将一个团体与是一个团体之成员的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة عضو في هيئة","ca":"membre corporatiu d’una entitat corporativa","cs":"korporativní člen korporace","da":"korporation, som er medlem af korporation","de":"Mitglied einer Körperschaft (Körperschaft)","de":"Mitglied einer Körperschaft (Körperschaft)","el":"εταιρικό μέλος του συλλογικού οργάνου","en":"corporate body member of corporate body","es":"organismo corporativo miembro de organismo corporativo","et":"asutuse liige (asutus)","fi":"yhteisön yhteisöjäsen","fr":"collectivité membre d’une collectivité","hu":"testület testületi tagja:","it":"ente membro di ente","lv":"institūcijas dalībnieks (institūcija)","nl":"corporatief lid van corporatie","no":"medlemskorporasjon","tr":"tüzel kişinin tüzel kişi üyesi","zh-Hans-CN":"团体的团体成员"},"ToolkitDefinition":{"ar":"هيئة هي عضو في هيئة.","ca":"Entitat corporativa que és un membre d’una entitat corporativa.","cs":"Korporace, která je členem korporace.","da":"Korporation, som er et medlem af en korporation.","de":"Eine Körperschaft, die Mitglied einer Körperschaft ist.","de":"Eine Körperschaft, die Mitglied einer Körperschaft ist.","el":"Ένα συλλογικό όργανο το οποίο είναι μέλος κάποιου άλλου συλλογικού οργάνου.","en":"A corporate body who is a member of a corporate body.","es":"Un organismo corporativo que es miembro de un organismo corporativo.","et":"Asutus, mis on asutuse liige.","fi":"Yhteisö, joka on toisen yhteisön jäsenyhteisö.","fr":"Collectivité qui est membre d’une collectivité.","hu":"Egy testület, amely egy testület tagja.","it":"Ente che è membro di un ente.","lv":"Institūcija, kas ir institūcijas dalībniece.","nl":"Een corporatie die een lid is van een corporatie.","no":"En korporasjon som er medlem av en korporasjon.","tr":"bir tüzel kişinin bir üyesi olan bir tüzel kişi.","zh-Hans-CN":"是一个团体之成员的一个团体"},"altLabel":{"ar":["عضو هيئة"],"ca":["membre corporatiu"],"cs":["korporativní člen"],"da":["korporationsmedlem"],"de":["Körperschaftliches Mitglied,Körperschaftliches Mitglied"],"el":["εταιρικό μέλος"],"en":["corporate member"],"es":["miembro corporativo"],"et":["liige (asutus)"],"fi":["yhteisöjäsen,yhteisöjäsen"],"fr":["collectivité membre"],"hu":["testületi tag:"],"it":["ente componente"],"nl":["corporatief lid"],"no":["korporasjonsmedlem"],"tr":["tüzel üye"],"zh-Hans-CN":["团体成员"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
