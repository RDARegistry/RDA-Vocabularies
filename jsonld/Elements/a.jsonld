                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51003", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerFamilyOf.en", "label":"is producer family of"},{"@id":"http://rdaregistry.info/Elements/a/P50702", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmProducerCollectiveAgentOf.en", "label":"is film producer collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51004", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/filmProducerFamilyOf.en", "label":"is film producer family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51004", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/filmProducerFamilyOf.en", "label":"is film producer family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50551","label":{"ar":"هو شخص منتج لفيلم لـ","ca":"és persona productora cinematogràfica de","cs":"je filmovým producentem (osobou) (čeho)","da":"er person, som er filmproducer af","de":"ist Person als Filmproduzentin/Filmproduzent von","de":"ist Person als Filmproduzentin/Filmproduzent von","el":"είναι παραγωγός ταινίας φυσικό πρόσωπο του","en":"is film producer person of","es":"es productor de cine de","et":"filmiprodutsent (isik) teoses","fi":"elokuvatuottaja (henkilö) teoksessa","fr":"est une personne productrice de cinéma de","hu":"filmproducer személye a következőnek:","it":"è produttore cinematografico persona di","lv":"ir filmas producents (persona)","nl":"is filmproducent-persoon van","no":"er filmprodusent for (person)","tr":"film yapımcısı kişisidir","zh-Hans-CN":"是……的电影制作人个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية وكيل عن معظم الجوانب التجارية لإنتاج فيلم."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la majoria dels aspectes comercials de la producció d’una pel·lícula."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za většinu obchodních aspektů výroby filmu."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for størstedelen af de forretningsmæssige aspekter ved en film."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for most of the business aspects of the production of a film."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona por la mayoría de los aspectos comerciales de la producción de una película."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust enamiku äriliste aspektide eest filmi tootmisel."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa suurimmasta osasta elokuvan liiketoimintaa."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne en ce qui concerne la majeure partie des aspects commerciaux de la production d’un film."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy filmprodukció legtöbb üzleti vonatkozásáért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per la maggior parte degli aspetti commerciali della produzione di un film."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par filmas uzņemšanas finansiālajiem aspektiem."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het merendeel van de zakelijke aspecten van de productie van een film."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av de fleste forretningsmessige aspektene ved produksjon av en film."],"tr":["Bir kişiyi, bir filmin yapımının ticari yönlerinin çoğundan bir kişinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及电影制作的大部分商业运作的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص منتج الفيلم","ca":"persona productora cinematogràfica de","cs":"filmový producent (osoba) (čeho)","da":"person, som er filmproducer af","de":"Person als Filmproduzentin/Filmproduzent von","de":"Person als Filmproduzentin/Filmproduzent von","el":"παραγωγός ταινίας φυσικό πρόσωπο του","en":"film producer person of","es":"productor de cine de","et":"filmiprodutsent (isik) teoses","fi":"elokuvatuottaja (henkilö) teoksessa","fr":"personne productrice de cinéma de","hu":"filmproducer személye:","it":"produttore cinematografico persona di","lv":"ir filmas producents (persona)","nl":"filmproducent-persoon van","no":"filmprodusent for (person)","tr":"film yapımcısı","zh-Hans-CN":"……的电影制作人个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن معظم الجوانب التجارية لإنتاج فيلم.","ca":"Obra que implica una responsabilitat d’una persona en la majoria dels aspectes comercials de la producció d’una pel·lícula.","cs":"Dílo, které zahrnuje odpovědnost osoby za většinu obchodních aspektů výroby filmu.","da":"Værk, som involverer en persons ansvar for størstedelen af de forretningsmæssige aspekter ved en film.","de":"Ein Werk, bei dem eine Person für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.","de":"Ein Werk, bei dem eine Person für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.","en":"A work that involves a responsibility of a person for most of the business aspects of the production of a film.","es":"Una obra que implica la responsabilidad de una persona por la mayoría de los aspectos comerciales de la producción de una película.","et":"Teos, mis sisaldab isiku vastutust enamiku äriliste aspektide eest filmi tootmisel.","fi":"Teos, jossa henkilö on vastuussa suurimmasta osasta elokuvan liiketoimintaa.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne en ce qui concerne la majeure partie des aspects commerciaux de la production d’un film.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy filmprodukció legtöbb üzleti vonatkozásáért.","it":"Opera che implica una responsabilità di una persona per la maggior parte degli aspetti commerciali della produzione di un film.","lv":"Darbs, kas ietver personas atbildību par filmas uzņemšanas finansiālajiem aspektiem.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het merendeel van de zakelijke aspecten van de productie van een film.","no":"Et verk som involverer et ansvar for en person i form av de fleste forretningsmessige aspektene ved produksjon av en film.","tr":"Bir filmin yapımının ticari yönlerinin çoğu için bir kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及电影制作的大部分商业运作的一个个人的责任的一种作品"},"altLabel":{"fr":["personne productrice de film de"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
