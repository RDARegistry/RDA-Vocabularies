                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/successorOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50326", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedFamilyOfFamily.en", "label":"has related family of family"},{"@id":"http://rdaregistry.info/Elements/a/P50423", "lexicalAlias":"http://rdaregistry.info/Elements/a/successorOfCollectiveAgent.en", "label":"has successor of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50424", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/successorOfFamily.en", "label":"has successor of family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50424", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/successorOfFamily.en", "label":"has successor of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50460","label":{"ar":"هو وكيل مسّاح لـ","ca":"és agent agrimensor de","cs":"je zeměměřičem (agentem) (čeho)","da":"er agent, som er landinspektør af","de":"ist Akteur als Landvermesserin/Landvermesser von","de":"ist Akteur als Landvermesserin/Landvermesser von","el":"είναι τοπογράφος μηχανικός φορέας του","en":"is surveyor agent of","es":"es agente agrimensor de","et":"maamõõtja (tegija) kehastuses","fi":"maanmittari (toimija) manifestaatiossa","fr":"est un agent arpenteur de","hu":"földmérő ágense a következőnek:","it":"è agrimensore agente di","lv":"ir topogrāfs (aģents)","nl":"is landmeter-actor van","no":"er landmåler for (agent)","tr":"Topograf temsilcisi","zh-Hans-CN":"是……的测绘者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة عبارة عن تجميعة تتضمن إسهام وكيلفي قياس الأبعاد أو العلاقات المكانية لمنطقة جغرافية."],"ca":["Relaciona un agent amb una manifestació que és un agregat que inclou una contribució d’un agent proporcionant mesuraments o relacions dimensionals d’una àrea geogràfica."],"cs":["Vztahuje agenta k provedení, které je agregátem, který zahrnuje přispění agenta, který poskytuje měření nebo rozměrové vztahy pro geografickou oblast."],"da":["Relaterer en agent til en manifestation, som er en samling, som omfatter en agents bidrag ved at angive målinger eller dimensionelle forhold for et geografisk område."],"de":["Setzt einen Akteur in Beziehung zu einem Aggregat (Manifestation), zu dem ein Akteur beiträgt, indem er Messwerte oder Abmessungsverhältnisse für einen dargestellten geografischen Bereich zur Verfügung stellt.,Setzt einen Akteur in Beziehung zu einem Aggregat (Manifestation), zu dem ein Akteur beiträgt, indem er Messwerte oder Abmessungsverhältnisse für einen dargestellten geografischen Bereich zur Verfügung stellt."],"en":["Relates an agent to a manifestation that is an aggregate that includes a contribution by an agent of providing measurements or dimensional relationships for a geographic area."],"es":["Relaciona un agente con una manifestación que es un agregado que incluye una contribución de un agente al proporcionar mediciones o relaciones dimensionales para un área geográfica."],"et":["Seostab tegija kehastusega, mis on liitum, millesse tegija on andnud panuse, hankides geograafilise piirkonna mõõdud või mõõdusuhted."],"fi":["Liittää toimijan manifestaatioon, joka on aggregaatti, jossa toimija on osallisena kartantekijänä maantieteellisen alueen mittojen tai mittasuhteiden tuottamisessa."],"fr":["Met un agent en relation avec une manifestation qui consiste en un agrégat qui intègre une contribution par un agent consistant à fournir des mesures ou des relations dimensionnelles pour une aire géographique."],"hu":["Hozzákapcsol egy ágenst egy aggregátum megjelenési formához, amely magában foglalja egy ágens közreműködését egy földrajzi terület mérésében vagy dimenziós összefüggéseinek szolgáltatásában."],"it":["Correla un agente a una manifestazione che è un aggregato che comprende un contributo di un agente nel fornire misure o rapporti dimensionali per un'area geografica."],"lv":["Sasaista aģentu ar manifestāciju, kas ir apkopojums, kas ietver aģenta ieguldījumu, nodrošinot ģeogrāfisko apgabalu mērījumus vai dimensiju attiecības."],"nl":["Relateert een actor aan een manifestatie die een aggregaat is die omvat een bijdrage door een actor die levert maten of dimensionale verhoudingen voor een geografisch gebied."],"no":["Relaterer en agent til en manifestasjon som er et aggregat som inkluderer et bidrag fra en agent i form av å tilføre målinger eller størrelsesforhold for et geografisk område."],"tr":["Bir temsilciyi, bir coğrafi alan için ölçümler veya boyutsal ilişkiler sağlayan bir temsilcinin katkısını içeren bir topluluğun bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与作为一种合集、包括为一个地理区域提供测量或尺寸关系的一个行为者的贡献的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل مساح","ca":"agent agrimensor de","cs":"zeměměřič (agent) (čeho)","da":"agent, som er landinspektør af","de":"Akteur als Landvermesserin/Landvermesser von","de":"Akteur als Landvermesserin/Landvermesser von","el":"τοπογράφος μηχανικός φορέας του","en":"surveyor agent of","es":"agente agrimensor de","et":"maamõõtja (tegija) kehastuses","fi":"maanmittari (toimija) manifestaatiossa","fr":"agent arpenteur de","hu":"földmérő ágense:","it":"agrimensore agente di","lv":"ir topogrāfs (aģents)","nl":"landmeter-actor van","no":"landmåler for (agent)","tr":"topograf temsilci","zh-Hans-CN":"……的测绘者行为者"},"ToolkitDefinition":{"ar":"تجسيدة عبارة عن تجميعة تتضمن إسهام وكيل في قياس الأبعاد أو العلاقات المكانية لمنطقة جغرافية.","ca":"Manifestació que és un agregat que inclou una contribució d’un agent proporcionant mesuraments o relacions dimensionals d’una àrea geogràfica.","cs":"Provedení, které je agregátem, který zahrnuje přispění agenta, který poskytuje měření nebo rozměrové vztahy pro geografickou oblast","da":"Manifestation, som er en samling, som omfatter en agents bidrag ved at angive målinger eller dimensionelle forhold for et geografisk område.","de":"Ein Aggregat (Manifestation), zu dem ein Akteur beiträgt, indem er Messwerte oder Abmessungsverhältnisse für einen dargestellten geografischen Bereich zur Verfügung stellt.","de":"Ein Aggregat (Manifestation), zu dem ein Akteur beiträgt, indem er Messwerte oder Abmessungsverhältnisse für einen dargestellten geografischen Bereich zur Verfügung stellt.","en":"A manifestation that is an aggregate that includes a contribution by an agent of providing measurements or dimensional relationships for a geographic area.","es":"Una manifestación que es un agregado que incluye una contribución de un agente al proporcionar mediciones o relaciones dimensionales para un área geográfica.","et":"Kehastus, mis on liitum, millesse tegija on andnud panuse, hankides geograafilise piirkonna mõõdud või mõõdusuhted.","fi":"Manifestaatio, joka on aggregaatti, jossa toimija on osallisena kartantekijänä maantieteellisen alueen mittojen tai mittasuhteiden tuottamisessa.","fr":"Manifestation qui consiste en un agrégat qui intègre une contribution par un agent consistant à fournir des mesures ou des relations dimensionnelles pour une aire géographique.","hu":"Egy aggregátum megjelenési forma, amely magában foglalja egy ágens közreműködését egy földrajzi terület mérésében vagy dimenziós összefüggéseinek szolgáltatásában.","it":"Manifestazione che è un aggregato che comprende un contributo di un agente nel fornire misurazioni o rapporti dimensionali per un'area geografica.","lv":"Manifestācija, kas ir apkopojums, kas ietver aģenta ieguldījumu, nodrošinot ģeogrāfisko apgabalu mērījumus vai dimensiju attiecības.","nl":"Een manifestatie die een aggregaat is die omvat een bijdrage door een actor die levert maten of dimensionale verhoudingen voor een geografisch gebied.","no":"En manifestasjon som er et aggregat som inkluderer et bidrag fra en agent i form av å tilføre målinger eller størrelsesforhold for et geografisk område.","tr":"Bir coğrafi alan için ölçümler veya boyutsal ilişkiler sağlayan bir temsilcinin katkısını içeren topluluk olan bir gösterim.","zh-Hans-CN":"作为一种合集、包括为一个地理区域提供测量或尺寸关系的一个行为者的贡献的一种载体表现"},"altLabel":{"ar":["مسّاح لـ"],"ca":["agrimensor de"],"cs":["zeměměřič (čeho)"],"da":["landmåler af"],"de":["Landvermesser von,Landvermesser von"],"el":["τοπογράφος μηχανικός του"],"en":["surveyor of"],"es":["agrimensor de"],"et":["maamõõtja kehastuses"],"fi":["maanmittarina manifestaatiossa"],"fr":["arpenteur de"],"hu":["földmérője:"],"it":["agrimensore di"],"nl":["landmeter van"],"no":["landmåler av"],"tr":["topograf"],"zh-Hans-CN":["……的测绘者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
