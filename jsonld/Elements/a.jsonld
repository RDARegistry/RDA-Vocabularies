                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50204", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfWorkOf.en", "label":"is creator agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50679", "lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorCollectiveAgentOf.en", "label":"is aggregator collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50528", "lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorPersonOf.en", "label":"is aggregator person of"},{"@id":"http://rdaregistry.info/Elements/a/P50189", "lexicalAlias":"http://rdaregistry.info/Elements/a/compilerAgentOf.en", "label":"is compiler agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50453", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/aggregatorAgentOf.en", "label":"is aggregator agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50453", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/aggregatorAgentOf.en", "label":"is aggregator agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50679","label":{"ar":"هو وكيل جماعي مجمع لـ","ca":"és agent col·lectiu agregador de","cs":"je agregátorem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er samler af","de":"ist gemeinschaftlicher Akteur als Aggregatorin/Aggregator von","de":"ist gemeinschaftlicher Akteur als Aggregatorin/Aggregator von","el":"είναι ερανιστής συλλογικός φορέας του ?","en":"is aggregator collective agent of","es":"es agente colectivo agregador de","et":"liitja (kollektiiv) teoses","fi":"aggregaattori (yhteistoimija) teoksessa","fr":"est un agent collectif agrégateur de","hu":"aggregátor kollektív ágense a következőnek:","it":"è aggregatore agente collettivo di","lv":"ir apkopotājs (grupa)","nl":"is aggregator-collectieve actor van","no":"er aggregator av (kollektiv agent)","tr":"toplayıcı kolektif temsilcisidir","zh-Hans-CN":"是……的合集编者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن التجميع من خلال اختيار تعبيرات أعمال أخرى وترتيبها."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en l’agregació mitjançant la selecció i l’arranjament d’expressions d’altres obres."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za agregaci výběrem a uspořádáním vyjádření jiných děl."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for sammenlægning ved at udvælge og arrangere udtryk af andre værk."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for aggregation by selecting and arranging expressions of other works."],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de agregación mediante la selección y disposición de expresiones de otras obras."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust liitumi loomise eest, valides ja korrastades teiste teoste väljendused."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif en ce qui concerne l’agrégation par la sélection et l’arrangement d’expressions d’autres œuvres."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége más művek kifejezési formáinak kiválasztásával és elrendezésével járó aggregálásért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo nell'aggregazione selezionando e organizzando espressioni di altre opere."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par apkopošanu, atlasot un sakārtojot citu darbu izteiksmes."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor aggregeren door middel van selectie en arrangeren van expressies van andere werken."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av aggregering gjennom å velge ut og arrangere uttrykk av andre verk."],"tr":["Kolektif bir temsilciyi, diğer eserlerin ifadelerini seçerek ve düzenleyerek bir araya getirme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及把其他作品的内容表达选择和整理后编制合集的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مجمّع","ca":"agent col·lectiu agregador de","cs":"agregátor (kolektivní agent) (čeho)","da":"kollektiv agent, som er samler af","de":"Gemeinschaftlicher Akteur als Aggregatorin/Aggregator von","de":"Gemeinschaftlicher Akteur als Aggregatorin/Aggregator von","el":"συναθροιστής συλλογικός φορέας του ?","en":"aggregator collective agent of","es":"agente colectivo agregador de","et":"liitja (kollektiiv) teoses","fi":"aggregaattori (yhteistoimija) teoksessa","fr":"agent collectif agrégateur de","hu":"aggregátor kollektív ágense:","it":"aggregatore agente collettivo di","lv":"ir apkopotājs (grupa)","nl":"aggregator-collectieve actor van","no":"aggregator av (kollektiv agent)","tr":"Toplayıcı kolektif temsilci","zh-Hans-CN":"……的合集编者集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن التجميع عن طريق اختيار وترتيب تعبيرات الأعمال الأخرى.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en l’agregació mitjançant la selecció i l’arranjament d’expressions d’altres obres.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za agregaci výběrem a uspořádáním vyjádření jiných děl.","da":"Værk, som involverer en kollektiv agents ansvar for sammenlægning ved at udvælge og arrangere udtryk af andre værk.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","en":"A work that involves a responsibility of a collective agent for aggregation by selecting and arranging expressions of other works.","es":"Una obra que implica la responsabilidad de un agente colectivo de agregación mediante la selección y disposición de expresiones de otras obras.","et":"Teos, mis sisaldab kollektiivi vastutust liitumi loomise eest, valides ja korrastades teiste teoste väljendused.","fi":"Teos, jossa yhteistoimija on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif en ce qui concerne l’agrégation par la sélection et l’arrangement d’expressions d’autres œuvres.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége más művek kifejezési formáinak kiválasztásával és elrendezésével járó aggregálásért.","it":"Opera che implica una responsabilità di un agente collettivo nell'aggregazione selezionando e organizzando espressioni di altre opere.","lv":"Darbs, kas ietver grupas atbildību par apkopošanu, atlasot un sakārtojot citu darbu izteiksmes.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor aggregeren door middel van selectie en arrangeren van expressies van andere werken.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av aggregering gjennom å velge ut og arrangere uttrykk av andre verk.","tr":"Diğer eserlerin ifadelerini seçerek ve düzenleyerek bir araya getirmek için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及把其他作品的内容表达选择和整理后编制合集的一个集体行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
