                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/storytellerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51056", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerFamilyOf.en", "label":"is performer family of"},{"@id":"http://rdaregistry.info/Elements/a/P50752", "lexicalAlias":"http://rdaregistry.info/Elements/a/storytellerCollectiveAgentOf.en", "label":"is storyteller collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51054", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/storytellerFamilyOf.en", "label":"is storyteller family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51054", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/storytellerFamilyOf.en", "label":"is storyteller family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50601","label":{"ar":"هو شخص راوي قصص لـ","ca":"és persona rondallaire de","cs":"je vypravěčem příběhů (osobou) (čeho)","da":"er person, som er historiefortæller af","de":"ist Person als Geschichtenerzählerin/Geschichtenerzähler von","de":"ist Person als Geschichtenerzählerin/Geschichtenerzähler von","el":"είναι αφηγητής ιστοριών φυσικό πρόσωπο του","en":"is storyteller person of","es":"es la persona narradora de","et":"jutuvestja (isik) väljenduses","fi":"tarinankertoja (henkilö) ekspressiossa","fr":"est une personne conteuse de","hu":"történetmesélő személye a következőnek:","it":"è storyteller persona di","lv":"ir stāstnieks (persona)","nl":"is verhalenverteller-persoon van","no":"er historieforteller for (person)","tr":"hikaye anlatıcısı kişisidir","zh-Hans-CN":"是……的说书人个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص بنقل قصة أصلية ووصفها بصورة درامية أو مسرحية."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona explicant un conte amb una interpretació dramàtica o teatral."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že podává příběh s dramatickou nebo divadelní interpretací."],"da":["Relaterer en person til et udtryk, som omfatter bidrag af en person, som er optrædende, ved at give en oprindelig historie dramatisk eller teatralsk fortolkning."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Ausführende/ein Ausführender (Person) beiträgt, indem sie/er eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt."],"en":["Relates a person to an expression that includes a contribution by a person of relaying a story with dramatic or theatrical interpretation."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona de transmitir una historia con interpretación dramática o teatral."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, esitades originaallugu draama- või teatritõlgenduses."],"fi":["Liittää henkilön ekspressioon, jonka tekemiseen henkilö osallistuu välittämällä tarinan draamallisella tai teatraalisella tulkinnalla."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à raconter une histoire au moyen d’une interprétation dramatique ou théâtrale."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését egy történet dramatizált vagy színházi interpretációjában."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona in un'esibizione che riporta una storia originale con un'interpretazione drammatica o teatrale."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, pasniedzot radītāja oriģinālo stāstu ar dramatisku vai teatrālu interpretāciju."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon die een uitvoerder is door het doorvertellen van een oorspronkelijk verhaal met dramatische of theatrale vertolking."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å lese forfatterens originalhistorie med innlevelse eller dramatisk tolkning."],"tr":["Bir kişiyi, dramatik veya teatral yorumlama ile bir hikayeyi aktarmaya katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括有用戏剧化解释转达故事的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص راوي قصص","ca":"persona rondallaire de","cs":"vypravěč příběhů (osoba) (čeho)","da":"person, som er historiefortæller af","de":"Person als Geschichtenerzählerin/Geschichtenerzähler von","de":"Person als Geschichtenerzählerin/Geschichtenerzähler von","el":"αφηγητής ιστοριών φυσικό πρόσωπο του","en":"storyteller person of","es":"persona narradora de","et":"jutuvestja (isik) väljenduses","fi":"tarinankertoja (henkilö) ekspressiossa","fr":"personne conteuse de","hu":"történetmesélő személye:","it":"storyteller persona di","lv":"ir stāstnieks (persona)","nl":"verhalenverteller-persoon van","no":"historieforteller for (person)","tr":"hikaye anlatıcı kişi","zh-Hans-CN":"……是说书人个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص بنقل قصة أصلية ووصفها بصورة درامية أو مسرحية.","ca":"Expressió que inclou una contribució d’una persona explicant un conte amb una interpretació dramàtica o teatral.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že podává příběh s dramatickou nebo divadelní interpretací.","da":"Udtryk, som omfatter et bidrag af en person, som er optrædende, ved at give en oprindelig historie dramatisk eller teatralsk fortolkning.","de":"Eine Expression, zu der eine Ausführende/ein Ausführender (Person) beiträgt, indem sie/er eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt.","en":"An expression that includes a contribution by a person of relaying a story with dramatic or theatrical interpretation.","es":"Una expresión que incluye una contribución de una persona de transmitir una historia con interpretación dramática o teatral.","et":"Väljendus, millesse isik on andnud panuse, esitades originaallugu draama- või teatritõlgenduses.","fi":"Ekspressio, jonka tekemiseen henkilö osallistuu välittämällä tarinan draamallisella tai teatraalisella tulkinnalla.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à raconter une histoire au moyen d’une interprétation dramatique ou théâtrale.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését egy történet dramatizált vagy színházi interpretációjában.","it":"Espressione che comprende un contributo di una persona in un'esibizione che riporta una storia originale con un'interpretazione drammatica o teatrale.","lv":"Izteiksme, kas ietver personas ieguldījumu, pasniedzot radītāja oriģinālo stāstu ar dramatisku vai teatrālu interpretāciju.","nl":"Een expressie die omvat een bijdrage door een persoon die een uitvoerder is door het doorvertellen van een oorspronkelijk verhaal met dramatische of theatrale vertolking.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å lese forfatterens originalhistorie med innlevelse eller dramatisk tolkning.","tr":"Dramatik veya teatral bir yorumla bir hikayeyi aktaran bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括有用戏剧化解释转达故事的一个个人的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
