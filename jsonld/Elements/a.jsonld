                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/onscreenParticipantPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50261", "lexicalAlias":"http://rdaregistry.info/Elements/a/onscreenParticipantAgentOf.en", "label":"is onscreen participant agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50618", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/onscreenParticipantPersonOf.en", "label":"is onscreen participant person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50618", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/onscreenParticipantPersonOf.en", "label":"is onscreen participant person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50072","label":{"ar":"هو وكيل مقدم برامج على الشاشة لـ","ca":"és agent presentador en pantalla de","cs":"je onscreen prezentátorem (agentem) (čeho)","da":"er agent, som er programvært af","de":"ist Akteur als On-Screen-Präsentatorin/On-Screen-Präsentator von","de":"ist Akteur als On-Screen-Präsentatorin/On-Screen-Präsentator von","el":"είναι οθονικός παρουσιαστής φορέας του","en":"is onscreen presenter agent of","es":"es agente presentador en pantalla de","et":"ekraanil esineja (tegija) väljenduses","fi":"esittelijä (toimija) ekspressiossa","fr":"est un agent présentateur à l’écran de","hu":"képernyőn megjelenő előadó ágense a következőnek:","it":"è presentatore video agente di","lv":"ir ekrānā redzamais vadītājs (aģents)","nl":"is presentator in beeld-actor van","no":"er programleder for (agent)","tr":"ekran sunucusu temsilcisidir","zh-Hans-CN":"是……的屏幕主持人行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بالظهور على الشاشة لتقديم معلومات سياقية أو معلومات أساسية."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent apareixent en pantalla per proporcionar informació contextual o dels antecedents."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že vystupuje na obrazovce a poskytuje související nebo základní informace."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at optræde på en skærm for at give kontekstuel- eller baggrundsinformation."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er auf dem Bildschirm erscheint, um Kontext- und Hintergrundinformationen zu liefern.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er auf dem Bildschirm erscheint, um Kontext- und Hintergrundinformationen zu liefern."],"el":["Συνδέει έναν εκτελεστή, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου εμφανιζόμενος επί της οθόνης για την παροχή πληροφοριών αναφορικά με το πλαίσιο ή το υπόβαθρο, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of appearing on screen to provide contextual or background information."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de aparecer en pantalla para proveer información contextual o de fondo."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, pakkudes ekraanil kontekstilist ja taustinfot."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu esiintymällä televisiossa tai elokuvassa taustatiedon antajana."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à apparaître à l’écran pour fournir de l’information contextuelle ou complémentaire."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy képernyőn megjelenő ágens közreműködését szövegösszefüggésre vonatkozó vagy háttérinformáció szolgáltatásában."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente che compare sullo schermo per fornire informazioni contestuali o di base."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, parādoties ekrānā, lai nodrošinātu konteksta vai fona informāciju."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door in beeld te verschijnen om contextuele of achtergrondinformatie te geven."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å vises på skjermen for å gi kontekst eller bakgrunnsinformasjon."],"tr":["Bir temsilciyi, bağlamsal veya arka plan bilgileri sağlamak için ekranda görünen bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括有出现在屏幕上提供语境或背景信息的一个行为者的贡献的一种内容表达关联起来。"]},"note":{"ar":["قد يظهر مقدم عرض على الشاشة في صور متحركة غير خيالية أو أثناء تقديم مواد لصور متحركة خيالية."],"ca":["Un presentador en pantalla pot aparèixer en els materials d’imatge en moviment de no ficció o en les introduccions de materials d’imatge en moviment de ficció."],"cs":["Onscreen prezentátor se může objevit v naučných filmových materiálech nebo v úvodech k beletristickým filmovým materiálům."],"da":["En programvært kan optræde i levende billedmaterialer af faktuel karakter eller i introduktioner til levende billedmaterialer af fiktiv karakter."],"de":["Darunter fallen Auftritte in nicht-fiktionalen Bewegtbildmaterialien oder in Einführungen zu fiktionalen Bewegtbildmaterialien.,Darunter fallen Auftritte in nicht-fiktionalen Bewegtbildmaterialien oder in Einführungen zu fiktionalen Bewegtbildmaterialien."],"el":["Ένας οθονικός παρουσιαστής μπορεί να εμφανίζεται σε υλικό μη μυθιστορηματικής κινητής εικόνας ή σε εισαγωγές υλικού μυθιστορηματικής κινητής εικόνας."],"en":["An on-screen presenter may appear in nonfiction moving image materials or in introductions to fiction moving image materials."],"es":["Un presentador en pantalla puede aparecer en materiales de no ficción de imágenes en movimiento o en introducciones para materiales de ficción de imágenes en movimiento."],"et":["Ekraanil esineja võib esineda mittefiktsioonilistes filmides ja fiktsioonfilmide sissejuhatavates osades."],"fi":["Esittelijä voi esiintyä ei-fiktiivisessä ohjelmassa tai fiktiivisen elokuvan johdannossa."],"fr":["Un présentateur à l’écran peut apparaître dans des images animées de non fiction ou dans des introductions à des images animées de fiction."],"hu":["Egy kifejezési forma, amely magában foglalja egy képernyőn megjelenő ágens közreműködését szövegösszefüggésre vonatkozó vagy háttérinformáció szolgáltatásában."],"it":["Un presentatore video può apparire in materiale video non di narrativa o in introduzioni di materiali video di tipo narrativa."],"lv":["Ekrānā redzamais vadītājs var parādīties dokumentālās filmas materiālos, vai spēlfilmas pieteikumos."],"nl":["Een presentator in beeld kan voorkomen in non-fictie bewegend beeldmaterialen of in inleidingen op fictie bewegend beeldmaterialen."],"no":["En programleder kan opptre i dokumentarmateriale i form av levende bilder eller innledninger til ikke-dokumentarisk materiale i form av levende bilder."],"tr":["Bir ekran sunucusu, kurgusal olmayan hareketli görüntü materyallerinde veya kurgusal hareketli görüntü materyallerine girişlerde görünebilir."],"zh-Hans-CN":["屏幕主持人可以出现在非虚构动态图像资料中或者在虚构动态图像资料的介绍中。"]},"ToolkitLabel":{"ar":"وكيل مقدم برامج على الشاشة","ca":"agent presentador en pantalla de","cs":"onscreen prezentátor (agent) (čeho)","da":"programvært på skærmen af","de":"Akteur als On-Screen-Präsentatorin/On-Screen-Präsentator von","de":"Akteur als On-Screen-Präsentatorin/On-Screen-Präsentator von","el":"οθονικός παρουσιαστής φορέας του","en":"onscreen presenter agent of","es":"agente presentador en pantalla de","et":"ekraanil esineja (tegija) väljenduses","fi":"esittelijä (toimija) ekspressiossa","fr":"agent présentateur à l’écran de","hu":"képernyőn megjelenő előadó ágense:","it":"presentatore video agente di","lv":"ir ekrānā redzamais vadītājs (aģents)","nl":"presentator in beeld-actor van","no":"programleder for (agent)","tr":"ekran sunucu temsilcisi","zh-Hans-CN":"……的屏幕主持人行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل بظهوره على الشاشة لتقديم معلومات سياقية أو معلومات أساسية.","ca":"Expressió que inclou una contribució d’un agent apareixent en pantalla per proporcionar informació contextual o dels antecedents.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že vystupuje na obrazovce a poskytuje související nebo základní informace.","da":"Udtryk, som omfatter en agents bidrag ved at optræde på en skærm for at give kontekstuel- eller baggrundsinformation.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er auf dem Bildschirm erscheint, um Kontext- und Hintergrundinformationen zu liefern.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er auf dem Bildschirm erscheint, um Kontext- und Hintergrundinformationen zu liefern.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά της εμφάνισης επί της οθόνης για την παροχή πληροφοριών αναφορικά με το πλαίσιο ή το υποβάθρο.","en":"An expression that includes a contribution by an agent of appearing on-screen to provide contextual or background information.","es":"Una expresión que incluye una contribución de un agente de aparecer en pantalla para proveer información contextual o de fondo.","et":"Väljendus, millesse tegija on andnud panuse, pakkudes ekraanil kontekstilist ja taustinfot.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu esiintymällä televisiossa tai elokuvassa taustatiedon antajana.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à apparaître à l’écran pour fournir de l’information contextuelle ou complémentaire.","hu":"Egy képernyőn megjelenő előadó tényszerű mozgóképanyagokban vagy fikciós mozgóképanyagok bevezetőiben is látható.","it":"Espressione che include un contributo da parte di un agente che compare sullo schermo per fornire informazioni contestuali o di base.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, parādoties ekrānā, lai nodrošinātu konteksta vai fona informāciju.","nl":"Een expressie die omvat een bijdrage door een actor door in beeld te verschijnen om contextuele of achtergrondinformatie te geven.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å vises på skjermen for å gi kontekst eller bakgrunnsinformasjon.","tr":"Bağlamsal veya arka plan bilgisi vermek amacı ile ekranda görünen bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括有出现在屏幕上提供语境或背景信息的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["مقدم برامج على الشاشة"],"ca":["presentador en pantalla de"],"cs":["onscreen prezentátor (čeho)"],"da":["studievært af"],"de":["On-Screen-Präsentator von,On-Screen-Präsentator von"],"el":["οθονικός παρουσιαστής του"],"en":["on-screen presenter of"],"es":["presentador en pantalla de"],"et":["ekraanil esineja väljenduses"],"fi":["esittelijänä ohjelmassa"],"fr":["présentateur à l’écran de"],"hu":["képernyőn megjelenő előadója:"],"it":["presentatore video di"],"nl":["presentator in beeld van"],"no":["programleder for (agent)"],"tr":["ekran sunucusu"],"zh-Hans-CN":["……的屏幕主持人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
