                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/illuminatorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50323", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfFamily.en", "label":"has related item of family"},{"@id":"http://rdaregistry.info/Elements/a/P50788", "lexicalAlias":"http://rdaregistry.info/Elements/a/illuminatorCollectiveAgentOf.en", "label":"is illuminator collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51090", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/illuminatorFamilyOf.en", "label":"is illuminator family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51090", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/illuminatorFamilyOf.en", "label":"is illuminator family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50637","label":{"ar":"هو شخص مزخرف لـ","ca":"és persona il·luminadora de","cs":"je iluminátorem (osobou) (čeho)","da":"er person, som er illuminator af","de":"ist Person als Illuminatorin/Illuminator von","de":"ist Person als Illuminatorin/Illuminator von","el":"είναι φωτιστής φυσικό πρόσωπο του","en":"is illuminator person of","es":"es persona iluminadora de","et":"illumineerija (isik) eksemplaris","fi":"illuminoinnin tekijä (henkilö) kappaleessa","fr":"est une personne enlumineuse de","hu":"illuminátor személye a következőnek:","it":"è miniatore persona di","lv":"ir iluminātors (persona)","nl":"is verluchter-persoon van","no":"er illuminator for (person)","tr":"tezhip sanatçısı kişisidir","zh-Hans-CN":"是……的彩饰者个人"},"definition":{"ar":["يربط شخصا بمفردة يزينها شخص بمعادن ثمينة أو بألوان، غالبًا بتصاميم وزخارف منمقة."],"ca":["Relaciona una persona amb un ítem que és decorat per una persona usant metalls preciosos o amb color, sovint amb dissenys i motius elaborats."],"cs":["Vztahuje osobu k jednotce, která je osobou ozdobena s použitím drahých kovů nebo barev, často s propracovanými vzory a motivy."],"da":["Relaterer en person til et eksemplar, som er udsmykket af en person med ædelmetal eller farve, ofte med detaljerige mønstre og motiver."],"de":["Setzt eine Person in Beziehung zu einem Exemplar, das von einer Person durch Edelmetalle und Farben, häufig mit kunstvollen Mustern und Motiven, (aus-)gestaltet wird.,Setzt eine Person in Beziehung zu einem Exemplar, das von einer Person durch Edelmetalle und Farben, häufig mit kunstvollen Mustern und Motiven, (aus-)gestaltet wird."],"en":["Relates a person to an item that is decorated by a person using precious metals or colour, often with elaborate designs and motifs."],"es":["Relaciona a una persona con un item decorado por una persona utilizando metales o colores preciosos, a menudo con diseños y motivos elaborados."],"et":["Seostab isiku eksemplariga, mille isik on kaunistanud väärismetallide ja värvidega, kasutades sageli keerulisi kujundeid ja motiive."],"fi":["Liittää henkilön kappaleeseen, jonka henkilö koristelee usein yksityiskohtaisin kuvioin tai motiivein käyttäen jalometalleja tai värejä."],"fr":["Met une personne en relation avec un item qui est orné par une personne avec des métaux précieux ou de la couleur, souvent avec des dessins et des motifs élaborés."],"hu":["Hozzákapcsol egy személyt egy példányhoz, amelyet egy személy nemesfémeket vagy színeket használva díszít, gyakran kidolgozott rajzokkal és motívumokkal."],"it":["Correla una persona a un item decorato da una persona utilizzando metalli preziosi o colore, spesso con disegni e motivi elaborati."],"lv":["Sasaista personu ar vienību, ko persona izgreznojusi, izmantojot krāsu un/vai dārgmetālus, bieži ar izsmalcinātiem un filigrāniem zīmējumiem, burtiem un motīviem."],"nl":["Relateert een persoon aan een item dat is versierd door een persoon met gebruikmaking van edelmetalen of kleur, vaak met uitgebreide patronen en motieven."],"no":["Relaterer en person til et eksemplar som er dekorert av person ved hjelp av edle metaller eller farger, gjerne med intrikate former og motiver."],"tr":["Bir kişiyi, kişi tarafından değerli metaller veya renk kullanılarak, çoğunlukla detaylı tasarımlar ve motiflerle süslenmiş bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个个人与被用贵重的金属或颜色（通常有精心的设计和图案）的一个个人进行装饰的一个单件关联起来。"]},"ToolkitLabel":{"ar":"شخص مزخرف","ca":"persona il·luminadora de","cs":"iluminátor (osoba) (čeho)","da":"person, som er illuminator af","de":"Person als Illuminatorin/Illuminator von","de":"Person als Illuminatorin/Illuminator von","el":"φωτιστής φυσικό πρόσωπο του","en":"illuminator person of","es":"persona iluminadora de","et":"illumineerija (isik) eksemplaris","fi":"illuminoinnin tekijä (henkilö) kappaleessa","fr":"personne enlumineuse de","hu":"illuminátor személye:","it":"miniatore persona di","lv":"ir iluminātors (persona)","nl":"verluchter-persoon van","no":"illuminator for (person)","tr":"tezhip sanatçısı kişisidir","zh-Hans-CN":"……的彩饰者个人"},"ToolkitDefinition":{"ar":"مفردة يزينها شخص بمعادن ثمينة أو بألوان، غالبًا بتصاميم وزخارف منمقة.","ca":"Ítem que és decorat per una persona usant metalls preciosos o amb color, sovint amb dissenys i motius elaborats.","cs":"Jednotka, která je osobou ozdobena s použitím drahých kovů nebo barev, často s propracovanými vzory a motivy","da":"Eksemplar, som er udsmykket af en person med ædelmetal eller farve, ofte med detaljerige mønstre og motiver.","de":"Ein Exemplar, das von einer Person durch Edelmetalle und Farben, häufig mit kunstvollen Mustern und Motiven, (aus-)gestaltet wird.","de":"Ein Exemplar, das von einer Person durch Edelmetalle und Farben, häufig mit kunstvollen Mustern und Motiven, (aus-)gestaltet wird.","en":"An item that is decorated by a person using precious metals or colour, often with elaborate designs and motifs.","es":"Un item decorado por una persona utilizando metales o colores preciosos, a menudo con diseños y motivos elaborados.","et":"Eksemplar, mille isik on kaunistanud väärismetallide ja värvidega, kasutades sageli keerulisi kujundeid ja motiive.","fi":"Kappale, jonka henkilö koristelee usein yksityiskohtaisin kuvioin tai motiivein käyttäen jalometalleja tai värejä.","fr":"Item qui est orné par une personne avec des métaux précieux ou de la couleur, souvent avec des dessins et des motifs élaborés.","hu":"Egy példány, amelyet egy személy nemesfémeket vagy színeket használva díszít, gyakran kidolgozott rajzokkal és motívumokkal.","it":"Item decorato da una persona utilizzando metalli preziosi o colore, spesso con disegni e motivi elaborati.","lv":"Vienība, ko persona izgreznojusi, izmantojot krāsu un/vai dārgmetālus, bieži ar izsmalcinātiem un filigrāniem zīmējumiem, burtiem un motīviem.","nl":"Een item dat is versierd door een persoon met gebruikmaking van edelmetalen of kleur, vaak met uitgebreide patronen en motieven.","no":"Et eksemplar som er dekorert av person ved hjelp av edle metaller eller farger, gjerne med intrikate former og motiver.","tr":"Değerli metaller veya renkler kullanılarak, genellikle özenle hazırlanmış desenler ve motiflerle bir kişi tarafından süslenen bir kopya.","zh-Hans-CN":"被用贵重的金属或颜色（通常有精心的设计和图案）的一个个人进行装饰的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/illuminatorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50314", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfPerson.en", "label":"has related item of person"},{"@id":"http://rdaregistry.info/Elements/a/P50092", "lexicalAlias":"http://rdaregistry.info/Elements/a/illuminatorAgentOf.en", "label":"is illuminator agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50637", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/illuminatorPersonOf.en", "label":"is illuminator person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50637", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/illuminatorPersonOf.en", "label":"is illuminator person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50159","label":{"ca":"és il·lustrador de","da":"er illustrator til","de":"ist Illustrator von","el":"είναι εικονογράφος του","en":"is illustrator of (Deprecated)","fi":"kuvittajana kuvituksessa","fr":"est un illustrateur de","hu":"illusztrátora"},"definition":{"ca":["Relaciona un agent, que contribueix amb una expressió d’una obra complementant el contingut principal amb dibuixos, diagrames, fotografies, etc., amb una expressió."],"da":["Relaterer en agent, der har bidraget til et udtryk af et værk ved at supplere hovedindholdet med tegninger, diagrammer, fotos etc. til et udtryk."],"de":["Setzt einen Akteur, der an einer Expression eines Werks mitwirkt, indem er den primären Inhalt mit Zeichnungen, Diagrammen, Fotografien usw. ergänzt, mit einer Expression in Beziehung."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου συμπληρώνοντας το κύριο περιεχόμενο με σχέδια, σκίτσα, διαγράμματα, φωτογραφίες κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution of supplementing the content with drawings, diagrams, photographs, etc. (Deprecated)"],"fi":["Liittää toimijan teoksen ekspressioon, jonka pääasiallista sisältöä on täydennetty piirroksilla, valokuvilla, kaavioilla tms."],"fr":["Met un agent qui contribue à une expression d’une œuvre en complétant le contenu principal avec des dessins, des diagrammes, des photographies, etc. en relation avec une expression."],"hu":["Egy ágenst (személyt, családot vagy testületet), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy az elsődleges tartalmat rajzokkal, ábrákkal, fotókkal stb. egészíti ki, hozzákapcsol egy kifejezési formához."]},"ToolkitLabel":{"ca":"il·lustrador de","da":"illustrator til","de":"Illustrator von","el":"εικονογράφος του","en":"illustrator of (Deprecated)","fi":"kuvittajana kuvituksessa","fr":"illustrateur de","hu":"illusztrátora","no":"illustratør av"},"ToolkitDefinition":{"ca":"Expressió d’una obra que incorpora una contribució que complementa el contingut principal amb dibuixos, diagrames, fotografies, etc.","da":"Udtryk af et værk der inkorporerer et bidrag ved at supplere hovedindholdet med tegninger, diagrammer, fotos, etc.","de":"Eine Expression eines Werks, bei der ein Akteur den primären Inhalt mit Zeichnungen, Diagrammen, Fotografien usw. ergänzt.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά της συμπλήρωσης του κύριου περιεχομένου με σχέδια, σκίτσα, διαγράμματα, φωτογραφίες κ.λπ.","en":"An expression that includes a contribution of supplementing the content with drawings, diagrams, photographs, etc. (Deprecated)","fi":"Teoksen ekspressio, jonka pääasiallista sisältöä on täydennetty piirroksilla, valokuvilla, kaavioilla tms.","fr":"Expression d’une œuvre qui intègre une contribution consistant à compléter le contenu principal avec des dessins, des diagrammes, des photographies, etc.","hu":"Egy mű kifejezési formája, amely hozzájárulást jelent azzal, hogy az elsődleges tartalmat kiegészíti rajzokkal, ábrákkal, fényképekkel stb.","no":"Et uttrykk av et verk som omfatter et bidrag i form av å tilføye tegninger, diagrammer, fotografier, etc. til hovedinnholdet."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50451", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorToAggregatedContentOf.en", "label":"is contributor to aggregated content of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/illustratorOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50159", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/illustratorOf.en", "label":"is illustrator of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50159", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/illustratorOf.en", "label":"is illustrator of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50074","label":{"ar":"هو وكيل محاضر لـ","ca":"és agent instructor de","cs":"je instruktorem (agentem) (čeho)","da":"er agent, som er instruktør af","de":"ist Akteur als Ausbilderin/Ausbilder von","de":"ist Akteur als Ausbilderin/Ausbilder von","el":"είναι εκπαιδευτής φορέας του","en":"is instructor agent of","es":"es agente instructor de","et":"instruktor (tegija) väljenduses","fi":"opettaja (toimija) ekspressiossa","fr":"est un agent enseignant de","hu":"oktató ágense a következőnek:","it":"è istruttore agente di","lv":"ir instruktors (aģents)","nl":"is instructeur-actor van","no":"er instruktør for (agent)","tr":"eğitmen temsilcisidir","zh-Hans-CN":"是……的授课者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بالتدريس أو تقديم عرض توضيحي."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent ensenyant o proporcionant una demostració."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že učí nebo provádí ukázku."],"da":["Relaterer en agent til et udtryk, som