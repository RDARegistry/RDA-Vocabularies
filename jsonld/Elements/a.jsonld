                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/personMemberOfFamilyOf.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50317", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedFamilyOfPerson.en", "label":"has related family of person"},{"@id":"http://rdaregistry.info/Elements/a/P50444", "lexicalAlias":"http://rdaregistry.info/Elements/a/personMemberOfCollectiveAgentOf.en", "label":"is person member of collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50099", "lexicalAlias":"http://rdaregistry.info/Elements/a/descendantFamilyOfPerson.en", "label":"has descendant family of person"},{"@id":"http://rdaregistry.info/Elements/a/P50417", "lexicalAlias":"http://rdaregistry.info/Elements/a/prominentMemberOfFamilyOf.en", "label":"is prominent member of family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50233", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/personMemberOfFamilyOf.en", "label":"is person member of family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50233", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/personMemberOfFamilyOf.en", "label":"is person member of family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50052","label":{"ar":"له معرِّف لعائلة","ca":"té com a identificador de família","cs":"má identifikátor rodiny","da":"har identifikator for familie","de":"hat Identifikator für eine Familie","de":"hat Identifikator für eine Familie","el":"έχει αναγνωριστικό για την οικογένεια","en":"has identifier for family","es":"tiene identificador para familia","et":"perekonna identifikaator","fi":"suvun tunniste","fr":"a pour identifiant de famille","hu":"család azonosítója a következő:","it":"ha come identificatore di famiglia","lv":"dzimtas/ģimenes identifikators","nl":"heeft identificatie voor familie","no":"har identifikator for familie","sv":"har identifikator för familjen/släkten","tr":"ailenin tanımlayıcısı ile ilişkilidir","zh-Hans-CN":"有给家族的标识符"},"definition":{"ar":["يربط عائلة بتسمية هي اسم عائلة يتكون من رمز، أو رقم، أو سلسلة تمثيلات أخرى، عادة ما تكون مختلفة عن اللغة الطبيعية وعن التسميات المتعارف عليها اجتماعيا، المستخدمة في تعريف عائلة."],"ca":["Relaciona una família amb un nomen que és una apel·lació d’una família que consisteix en un codi, un número o qualsevol altra cadena, normalment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una família."],"cs":["Vztahuje rodinu k nomen, které je pojmenováním rodiny, které se skládá z kódu, čísla nebo jiného řetězce, obvykle nezávislého na přirozeném jazyce a společenských konvencích pojmenování, které se používá k identifikaci rodiny."],"da":["Relaterer en familie til et nomen, som er en benævnelse på familie, som består af en kode, nummer eller anden streng, sædvanligvis upåvirket af normalsprog og sociale navngivningskonventioner, brugt til at identificere en familie."],"de":["Setzt eine Familie in Beziehung zu einer Bezeichnung für eine Familie, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Familie verwendet wird.,Setzt eine Familie in Beziehung zu einer Bezeichnung für eine Familie, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Familie verwendet wird."],"el":["Συνδέει μια οικογένεια με έναν αλφαριθμητικό χαρακτήρα μοναδικά συνδεδεμένο με μία οικογένεια ή με ένα υποκατάστατο, όπως μία καθιερωμένη εγγραφή για μια οικογένεια."],"en":["Relates a family to a nomen that is an appellation of family that consists of a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a family."],"es":["Relaciona una familia con un nomen que es un apelativo de familia que consiste en un código, número u otra secuencia, comúnmente independiente del lenguaje natural y de convenciones sociales de nomenclatura, utilizado para identificar a una familia."],"et":["Seostab perekonna perekonna nimetusega, mis koosneb perekonda identifitseerivast koodist, numbrist või muust loomulikust keelest ja üldtuntud nimetamistavadest sõltumatust stringist."],"fi":["Liittää suvun nomeniin, joka on suvun nimitys, joka koostuu koodista, luvusta tai muusta tavallisesti luonnollisesta kielestä ja yleisistä nimeämiskäytännöistä riippumattomasta merkkijonosta, jota käytetään suvun identifiointiin."],"fr":["Met une famille en relation avec un nomen qui est une appellation de famille consistant en un code, un nombre ou une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une famille."],"hu":["Hozzákapcsol egy családot egy nomenhez, egy család megnevezéséhez, amely kódból, számból vagy egyéb karakterláncból áll, általában a természetes nyelvtől és társadalmi elnevezési konvencióktól független, és egy család azonosítására használják."],"it":["Correla una famiglia a una denominazione di famiglia appartiene che consiste di un codice, numero o altra sequenza di caratteri, solitamente indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, usati per identificare una famiglia."],"lv":["Sasaista dzimtu/ģimeni ar nomenu, kas ir dzimtas/ģimenes apzīmējums, kas sastāv no koda, skaitļa vai citas virknes, kas parasti ir neatkarīgs no dabiskas valodas vai sabiedrībā pieņemtām nosaukšanas tradīcijām, ko izmanto, lai identificētu dzimti/ģimenei."],"nl":["Relateert een familie aan een nomen dat is een benaming van familie die bestaat uit een code, nummer of andere tekenreeks, meestal onafhankelijk van natuurlijke taal en gewoonlijke naamgevingsconventies, gebruikt om een familie te identificeren."],"no":["Relaterer en famile til en betegnelse for familie som består av en kode, et nummer eller annen streng, vanligvis uavhengig av naturlig språk og sosiale navnekonvensjoner, brukt for å identifisere en familie."],"tr":["Bir aileyi, bir aileyi tanımlamak için kullanılan, genellikle doğal dil ve sosyal adlandırma kurallarından bağımsız bir kod, sayı veya başka bir dizeden oluşan bir aile adı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一个家族与一个作为家族的称谓、由代码、数字或其他字符串构成、通常独立于自然语言和社会命名惯例、用以标识一个家族的命名关联起来。"]},"ToolkitLabel":{"ar":"معرِّف لعائلة","ca":"identificador de família","cs":"identifikátor rodiny","da":"identifikator for familie","de":"Identifikator für eine Familie","de":"Identifikator für eine Familie","el":"αναγνωριστικό για την οικογένεια","en":"identifier for family","es":"identificador para familia","et":"perekonna identifikaator","fi":"suvun tunniste","fr":"identifiant de famille","hu":"családazonosító:","it":"identificatore di famiglia","lv":"dzimtas/ģimenes identifikators","nl":"identificatie voor familie","no":"identifikator for familie","sv":"identifikator för familjen/släkten","tr":"ailenin tanımlayıcısı ile ilişkilidir","zh-Hans-CN":"给家族的标识符"},"ToolkitDefinition":{"ar":"تسمية هي اسم عائلة يتكون من رمز، أو رقم، أو سلسلة تمثيلات أخرى، عادة ما تكون مختلفة عن اللغة الطبيعية وعن التسميات المتعارف عليها اجتماعيا، المستخدمة في تعريف عائلة.","ca":"Nomen que és una apel·lació d’una família que consisteix en un codi, un número o qualsevol altra cadena, normalment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una família.","cs":"Nomen, které je pojmenováním rodiny, které se skládá z kódu, čísla nebo jiného řetězce, obvykle nezávislého na přirozeném jazyce a společenských konvencích pojmenování, které se používá k identifikaci rodiny.","da":"Nomen, som er en benævnelse på familie, som består af en kode, nummer eller anden streng, sædvanligvis upåvirket af normalsprog og sociale navngivningskonventioner, brugt til at identificere en familie.","de":"Eine Bezeichnung für eine Familie, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Familie verwendet wird.","de":"Eine Bezeichnung für eine Familie, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung einer Familie verwendet wird.","el":"Ένας αλφαριθμητικός χαρακτήρας μοναδικά συνδεδεμένος με μια οικογένεια ή με ένα υποκατάστατο, όπως μία καθιερωμένη εγγραφή για μια οικογένεια.","en":"A nomen that is an appellation of family that consists of a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a family.","es":"Un nomen que es un apelativo de familia que consiste en un código, número u otra secuencia, comúnmente independiente del lenguaje natural y de convenciones sociales de nomenclatura, utilizado para identificar a una familia.","et":"Perekonna nimetus, mis koosneb perekonda identifitseerivast koodist, numbrist või muust loomulikust keelest ja üldtuntud nimetamistavadest sõltumatust stringist.","fi":"Suvun identifioimiseen käytetty nomen, joka on nimitys, joka koostuu koodista, luvusta tai muusta merkkijonosta, joka on tavallisesti riippumaton luonnollisesta kielestä tai yleisistä nimeämiskäytännöistä.","fr":"Nomen qui est une appellation de famille consistant en un code, un nombre ou une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une famille.","hu":"Egy nomen, amely egy család megnevezése, kódból, számból vagy egyéb karakterláncból áll, általában a természetes nyelvtől és társadalmi elnevezési konvencióktól független, és egy család azonosítására használják.","it":"Denominazione di famiglia che consiste di un codice, numero o altra sequenza di caratteri, solitamente indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, usati per identificare una famiglia.","lv":"Dzimtas/ģimenes apzīmējums, kas sastāv no koda, skaitļa vai citas virknes, kas parasti ir neatkarīgs no dabiskas valodas vai sabiedrībā pieņemtām nosaukšanas tradīcijām, ko izmanto, lai identificētu dzimti/ģimenei.","nl":"Een nomen dat is een benaming van familie die bestaat uit een code, nummer of andere tekenreeks, meestal onafhankelijk van natuurlijke taal en gewoonlijke naamgevingsconventies, gebruikt om een familie te identificeren.","no":"En betegnelse for familie som består av en kode, et nummer eller annen streng, vanligvis uavhengig av naturlig språk og sosiale navnekonvensjoner, brukt for å identifisere en familie.","tr":"Bir aileyi tanımlamak için kullanılan, genellikle doğal dil ve sosyal adlandırma kurallarından bağımsız bir kod, sayı veya başka bir dizeden oluşan bir aile unvanı olan isim.","zh-Hans-CN":"一个作为家族的称谓、由代码、数字或其他字符串构成、通常独立于自然语言和社会命名惯例、用以标识一个家族的命名"},"note":{"da":["Identifikatoren tjener til at skelne en familie fra andre familier."],"de":["Der Identifikator dient dazu, diese Familie von anderen Familien zu unterscheiden."],"el":["Το αναγνωριστικό χρησιμοποιείται για τη διαφοροποίηση μιας οικογένειας από άλλες οικογένειες."],"fi":["Tunniste erottaa suvun muista suvuista."],"fr":["L’identifiant sert à différencier une famille d’autres familles."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"lexicalAlias":"http://rdaregistry.info/Elements/a/identifierForFamily.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50381", "lexicalAlias":"http://rdaregistry.info/Elements/a/appellationOfFamily.en", "label":"has appellation of family"},{"@id":"http://rdaregistry.info/Elements/a/P50384", "lexicalAlias":"http://rdaregistry.info/Elements/a/identifierForCollectiveAgent.en", "label":"has identifier for collective agent"}],"instructionNumber":"10.1","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50052", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/identifierForFamily.en", "label":"has identifier for family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50052", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/identifierForFamily.en", "label":"has identifier for family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50057","label":{"ca":"té com a lloc associat amb una família","da":"har sted forbundet med familien","de":"hat Ort, der mit einer Familie in Verbindung steht","el":"έχει τόπο συνδεδεμένο με την οικογένεια","en":"has place associated with family (Deprecated)","fi":"sukuun liittyvä paikka","fr":"a pour lieu associé à une famille","hu":"van családdal kapcsolatos helye","sv":"har ort förknippad med familjen/släkten"},"definition":{"ca":["Relaciona una família amb un lloc on una família resideix o ha residit o amb el qual té algun tipus de relació."],"da":["Relaterer til et sted, hvor en familie bor eller har boet, eller som familien har en forbindelse til."],"de":["Setzt eine Familie mit einem Ort, an dem eine Familie wohnt, gewohnt hat oder zu dem sie eine Verbindung hat, in Beziehung."],"el":["Συνδέει μια οικογένεια με έναν τόπο όπου η οικογένεια κατοικεί ή έχει κατοικήσει ή έχει κάποια σύνδεση."],"en":["Relates a family to a place that is associated with a family. (Deprecated)"],"fi":["Liittää suvun paikkaan, jossa suku asuu tai on asunut, tai johon sillä on jokin muu yhteys."],"fr":["Met une famille en relation avec un lieu où une famille réside ou a résidé ou avec lequel elle a une relation quelconque."],"hu":["Egy családot hozzákapcsol egy helyhez, ahol egy család lakik vagy lakott vagy valami kapcsolata van vele."]},"ToolkitLabel":{"ca":"lloc associat amb una família","da":"sted forbundet med familien","de":"Ort, der mit einer Familie in Verbindung steht","el":"τόπος συνδεδεμένος με την οικογένεια","en":"place associated with family (Deprecated)","es":"lugar asociado con la familia","fi":"sukuun liittyvä paikka","fr":"lieu associé à une famille","hu":"családhoz kötődő hely","no":"sted som forbindes med familien","sv":"ort förknippad med familjen/släkten"},"ToolkitDefinition":{"ca":"Lloc on una família resideix o ha residit o amb el qual té algun tipus de relació.","da":"Sted, hvor en familie bor eller har boet, eller som familien har en forbindelse til.","de":"Ein Ort, an dem eine Familie wohnt, gewohnt hat oder zu dem sie eine Verbindung hat.","el":"Ένας τόπος, όπου η οικογένεια κατοικεί ή κατοίκησε ή με τον οποίο διατηρεί κάποια σχέση.","en":"A place that is associated with a family. (Deprecated)","es":"Un lugar donde reside la familia, o donde ha residido o que tiene alguna conexión.","fi":"Paikka, jossa suku asuu tai on asunut, tai johon sillä on jokin muu yhteys.","fr":"Lieu où une famille réside ou a résidé ou avec lequel elle a une relation quelconque.","hu":"Egy hely, ahol egy család lakik vagy lakott, vagy amellyel bizonyos kapcsolata van.","no":"Et sted hvor familien bor, har bodd, eller har tilknytning til."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"lexicalAlias":"http://rdaregistry.info/Elements/a/placeAssociatedWithFamily.en","instructionNumber":"10.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50354", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPlaceOfFamily.en", "label":"has related place of family"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50057", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/placeAssociatedWithFamily.en", "label":"has place associated with family (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50057", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/placeAssociatedWithFamily.en", "label":"has place associated with family (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50058","label":{"ca":"té com a data associada amb una família","da":"har dato knyttet til familien","de":"hat Datum, das mit einer Familie in Verbindung steht","el":"έχει χρονολογία συνδεδεμένη με την οικογένεια","en":"has date associated with family (Deprecated)","fi":"sukuun liittyvä ajankohta","fr":"a pour date associée à une famille","hu":"van családdal kapcsolatos időpontja","sv":"har tid förknippad med famliljen/släkten"},"definition":{"ca":["Relaciona una família amb una data significativa associada amb una família."],"da":["Relaterer en familie til et væsentlig dato forbundet med en familie."],"de":["Setzt eine Familie mit einem wichtigen Datum, das mit der Geschichte einer Familie in Verbindung steht, in Beziehung."],"el":["Συνδέει μια οικογένεια με μια σημαντική χρονολογία συνδεδεμένη με την οικογένεια."],"en":["Relates a family to a timespan that has a significant association with a family. (Deprecated)"],"fi":["Liittää suvun sukuun liittyvän merkittävän ajankohdan."],"fr":["Met une famille en relation avec une date importante associée à une famille."],"hu":["Egy családot hozzákapcsol egy családhoz kötődő fontos időponthoz."]},"ToolkitLabel":{"ca":"data associada amb una família","da":"dato knyttet til familien","de":"Datum, das mit einer Familie in Verbindung steht","el":"χρονολογία συνδεδεμένη με την οικογένεια","en":"date associated with family (Deprecated)","es":"fecha asociada con la familia","fi":"sukuun liittyvä ajankohta","fr":"date associée à une famille","hu":"családhoz kötődő időpont","no":"tidspunkt som forbindes med familien","sv":"tid förknippad med famliljen/släkten"},"ToolkitDefinition":{"ca":"Data significativa associada amb una família.","da":"Væsentlig dato forbundet med en familie.","de":"Ein wichtiges Datum, das mit der Geschichte einer Familie in Verbindung steht.","el":"Μια σημαντική χρονολογία συνδεδεμένη με μια οικογένεια.","en":"A timespan that has a significant association with a family. (Deprecated)","es":"Una fecha significativa asociada con la familia.","fi":"Sukuun liittyvä merkittävä ajankohta.","fr":"Date importante associée à une famille.","hu":"Egy fontos időpont, amely kötődik egy családhoz.","no":"Et viktig tidspunkt som kan forbindes med en familie."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"lexicalAlias":"http://rdaregistry.info/Elements/a/dateAssociatedWithFamily.en","instructionNumber":"10.4","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50355", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedTimespanOfFamily.en", "label":"has related timespan of family"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50058", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/dateAssociatedWithFamily.en", "label":"has date associated with family (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50058", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/dateAssociatedWithFamily.en", "label":"has date associated with family (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50065","label":{"ar":"له اسم مفضل لعائلة","ca":"té com a nom preferit de família","cs":"má preferované jméno rodiny","da":"har foretrukket navn på familie","de":"hat bevorzugten Namen einer Familie","de":"hat bevorzugten Namen einer Familie","el":"έχει προτιμώμενο όνομα της οικογένειας","en":"has preferred name of family","es":"tiene nombre preferido de familia","et":"perekonna eelisnimi","fi":"suvun ensisijainen nimi","fr":"a pour nom privilégié d’une famille","hu":"család előnyben részesített neve a következő:","it":"ha come nome preferito di famiglia","lv":"dzimtas/ģimenes prioritārais vārds","nl":"heeft geprefereerde naam van familie","no":"har foretrukket familienavn","sv":"har föredraget namn för familjen/släkten","tr":"tercih edilen aile adı ile ilişkilidir","zh-Hans-CN":"有家族的首选名称"},"definition":{"ar":["يربط عائلة بتسمية لعائلة اختيرت كاسم مفضل في تطبيق أو في سياق محدد."],"ca":["Relaciona una família amb un nomen que és un nom de família que se selecciona com a preferent en una apl