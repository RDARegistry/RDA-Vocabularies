                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/narratorCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50754", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerCollectiveAgentOf.en", "label":"is performer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50081", "lexicalAlias":"http://rdaregistry.info/Elements/a/narratorAgentOf.en", "label":"is narrator agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50910", "lexicalAlias":"http://rdaregistry.info/Elements/a/narratorCorporateBodyOf.en", "label":"is narrator corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51061", "lexicalAlias":"http://rdaregistry.info/Elements/a/narratorFamilyOf.en", "label":"is narrator family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50759", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/narratorCollectiveAgentOf.en", "label":"is narrator collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50759", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/narratorCollectiveAgentOf.en", "label":"is narrator collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50910","label":{"ar":"هي هيئة مسئولة عن رواية لـ","ca":"és entitat corporativa narradora de","cs":"je vypravěčem-komentátorem (korporací) (čeho)","da":"er korporation, som er fortæller af","de":"ist Körperschaft als Erzählerin/Erzähler von","de":"ist Körperschaft als Erzählerin/Erzähler von","el":"είναι αφηγητής συλλογικό όργανο του","en":"is narrator corporate body of","es":"es organismo corporativo narrador de","et":"jutustaja (asutus) väljenduses","fi":"kertoja (yhteisö) ekspressiossa","fr":"est une collectivité narratrice de","hu":"narrátor testülete a következőnek:","it":"è narratore ente di","lv":"ir teicējs (institūcija)","nl":"is verteller-corporatie van","no":"er forteller for (korporasjon)","tr":"anlatıcı tüzel kişisidir","zh-Hans-CN":"是……的旁白者团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة بالقراءة بصوت مرتفع أو بسرد فصل من مسرحية، أو واقعة، أو حدث آخر."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa llegint en veu alta o explicant una acció, una situació o qualsevol altre esdeveniment."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace tím, že nahlas předčítá nebo slovně popisuje činnost, děj nebo jinou událost."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at læse højt eller berette om en handling, en hændelse, et begivenhedsforløb etc."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of reading aloud or giving an account of an act, occurrence, or other event."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de leer en voz alta o dar un reporte de un acto, acontecimiento u otro evento."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, valjusti lugedes või jutustades mingist tegevusest, juhtumist, sündmuste käigust vms."],"fi":["Liittää yhteisön ekspressioon, jonka tekemisessä yhteisö on osallisena lukemalla ääneen tai kertomalla toiminnasta, tapahtumasta, tapahtumien kulusta tms."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à lire à voix haute ou à rendre compte d’une action, d’une situation ou d’un autre événement."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését egy cselekményről, történésről vagy más eseményről szóló beszámoló hangos felolvasásában."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nella lettura ad alta voce o racconto di un fatto, avvenimento o altro evento."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, skaļi nolasot tekstu vai sniedzot ziņojumu par kādu darbību, notikumu, notikumu gaitu u.tml."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door hardop lezen of verslag geven van een daad, voorval of andere gebeurtenis."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å lese høyt eller fortelle om en handling, hendelse eller annen begivenhet."],"tr":["Bir tüzel kişiyi, bir tüzel kişiliğin yüksek sesle okuma veya bir eylem, olay veya başka bir olayın hesabını verme katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括有朗读或描述行为、事情或其他事件的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن رواية","ca":"entitat corporativa narradora de","cs":"vypravěč-komentátor (korporace) (čeho)","da":"korporation, som er fortæller af","de":"Körperschaft als Erzählerin/Erzähler von","de":"Körperschaft als Erzählerin/Erzähler von","el":"αφηγητής συλλογικό όργανο του","en":"narrator corporate body of","es":"organismo corporativo narrador de","et":"jutustaja (asutus) väljenduses","fi":"kertoja (yhteisö) ekspressiossa","fr":"collectivité narratrice de","hu":"narrátor testülete:","it":"narratore ente di","lv":"ir teicējs (institūcija)","nl":"verteller-corporatie van","no":"forteller for (korporasjon)","tr":"anlatıcı tüzel kişisi","zh-Hans-CN":"……的旁白者团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة بالقراءة بصوت مرتفع أو بسرد فصل من مسرحية، أو واقعة، أو حدث آخر.","ca":"Expressió que inclou una contribució d’una entitat corporativa llegint en veu alta o explicant una acció, una situació o qualsevol altre esdeveniment.","cs":"Vyjádření, které zahrnuje přispění korporace tím, že nahlas předčítá nebo slovně popisuje činnost, děj nebo jinou událost.","da":"Udtryk, som omfatter en korporations bidrag ved at læse højt eller berette om en handling, en hændelse, et begivenhedsforløb etc.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.","en":"An expression that includes a contribution by a corporate body of reading aloud or giving an account of an act, occurrence, or other event.","es":"Una expresión que incluye una contribución de un organismo corporativo de leer en voz alta o dar un reporte de un acto, acontecimiento u otro evento.","et":"Väljendus, millesse asutus on andnud panuse, valjusti lugedes või jutustades mingist tegevusest, juhtumist, sündmuste käigust vms.","fi":"Ekspressio, jonka tekemisessä yhteisö on osallisena lukemalla ääneen tai kertomalla toiminnasta, tapahtumasta, tapahtumien kulusta tms.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à lire à voix haute ou à rendre compte d’une action, d’une situation ou d’un autre événement.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését egy cselekményről, történésről vagy más eseményről szóló beszámoló hangos felolvasásában.","it":"Espressione che comprende un contributo di un ente nella lettura ad alta voce o racconto di un fatto, avvenimento o altro evento.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, skaļi nolasot tekstu vai sniedzot ziņojumu par kādu darbību, notikumu, notikumu gaitu u.tml.","nl":"Een expressie die omvat een bijdrage door een corporatie door hardop lezen of verslag geven van een daad, voorval of andere gebeurtenis.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å lese høyt eller fortelle om en handling, hendelse eller annen begivenhet.","tr":"Yüksek sesle okuma veya bir eylem, olay veya başka bir olayın hesabını veren tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括有朗读或描述行为、事情或其他事件的一个团体的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
