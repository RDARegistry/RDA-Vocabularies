                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51088", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collectorFamilyof.en", "label":"is collector family of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51088", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collectorFamilyof.en", "label":"is collector family of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50635","label":{"ar":"هو شخص جامع لـ","ca":"és persona col·leccionista de","da":"er person, som er samler af","de":"ist Person als Sammlerin/Sammler von","el":"είναι συλλέκτης φυσικό πρόσωπο του","en":"is collector person of (Deprecated)","et":"kogu moodustaja (isik) eksemplarile","fi":"kokoelman muodostaja (henkilö) kappaleessa","fr":"est une personne collectionneuse de","hu":"kollektor személye a következőnek:","it":"è collezionista persona di","lv":"ir kolekcionārs (persona)","nl":"is verzamelaar-persoon van","no":"er samler av (person)"},"definition":{"ar":["يربط شخصا بمفردة جمعها وكيل مع مفردات من مصادر مختلفة رُتبت وُوصفت وفُهرست كمجموعة."],"ca":["Relaciona una persona amb un ítem que és aplegat per una persona amb ítems de diverses fonts que s’arrangen, es descriuen o es cataloguen com una col·lecció."],"da":["Relaterer en person til et eksemplar, som er sammenført af en person med eksemplarer fra forskellige kilder, som er arrangeret, beskrevet og katalogiseret som en samling."],"de":["Setzt eine Person in Beziehung zu einem Exemplar, das von einer Person mit Materialien aus unterschiedlichen Quellen zusammengetragen wird, die dann als Sammlung geordnet, beschrieben oder katalogisiert werden."],"en":["Relates a person to an item that is brought together by a person with items from various sources that are arranged, described, or catalogued as a collection. (Deprecated)"],"et":["Seostab isiku eksemplariga, mille isik on kokku pannud teiste eri allikatest kogutud eksemplaridega, mis on korrastatud, kirjeldatud ja kataloogitud koguna."],"fi":["Liittää henkilön kappaleeseen, jonka henkilö on koonnut järjestetyksi, kuvailluksi tai luetteloiduksi kokoelmaksi eri lähteistä olevista kappaleista."],"fr":["Met une personne en relation avec un item qui est regroupé par une personne avec des items de diverses sources qui sont arrangés, décrits ou catalogués comme une collection de ressources."],"hu":["Hozzákapcsol egy személyt egy példányhoz, amelyet egy személy különböző forrásokból származó, gyűjteményként rendezett, leírt és katalogizált példányokkal fog össze."],"it":["Correla una persona a un item messo insieme da una persona con item da varie fonti che sono organizzati, descritti e catalogati come una collezione."],"lv":["Sasaista personu ar vienību, ko persona apkopojusi kopā ar citām vienībām no dažādiem avotiem, kas ir sakārtotas, aprakstītas un kataloģizētas kā kolekcija."],"nl":["Relateert een persoon aan een item dat samengebracht is door een persoon met items van diverse bronnen die gearrangeerd, beschreven of gecatalogiseerd zijn als een verzameling."],"no":["Relaterer en person til et eksemplar som av en person er satt sammen med eksemplarer fra ulike kilder og som er arrangert, beskrevet eller katalogisert som en samling."]},"ToolkitLabel":{"ar":"شخص جامع","ca":"persona col·leccionista de","da":"person, som er samler af","de":"Person als Sammlerin/Sammler von","el":"συλλέκτης φυσικό πρόσωπο του","en":"collector person of (Deprecated)","et":"kogu moodustaja (isik) eksemplarile","fi":"kokoelman muodostaja (henkilö) kappaleessa","fr":"personne collectionneuse de","hu":"kollektor személye:","it":"collezionista persona di","lv":"ir kolekcionārs (persona)","nl":"verzamelaar-persoon van","no":"samler av (person)"},"ToolkitDefinition":{"ar":"مفردة جمعها شخص مع مفردات من مصادر مختلفة رُتبت وُوصفت وفُهرست كمجموعة.","ca":"Ítem que és aplegat per una persona amb ítems de diverses fonts que s’arrangen, es descriuen o es cataloguen com una col·lecció.","da":"Eksemplar, som er sammenført af en person med eksemplarer fra forskellige kilder, som er arrangeret, beskrevet og katalogiseret som en samling.","de":"Ein Exemplar, das von einer Person mit Materialien aus unterschiedlichen Quellen zusammengetragen wird, die dann als Sammlung geordnet, beschrieben oder katalogisiert werden.","en":"An item that is brought together by a person with items from various sources that are arranged, described, or catalogued as a collection. (Deprecated)","et":"Eksemplar, mille isik on kokku pannud teiste eri allikatest kogutud eksemplaridega, mis on korrastatud, kirjeldatud ja kataloogitud koguna.","fi":"Kappale, jonka henkilö on koonnut osaksi järjestettyä, kuvailtua tai luetteloitua kokoelmaa yhdessä muiden eri lähteistä olevien kappaleiden kanssa.","fr":"Item qui est regroupé par une personne avec des items de diverses sources qui sont arrangés, décrits ou catalogués comme une collection de ressources.","hu":"Egy példány, amelyet egy személy különböző forrásokból származó, gyűjteményként rendezett, leírt és katalogizált példányokkal fog össze.","it":"Item messo insieme da una persona con item da varie fonti che sono organizzati, descritti e catalogati come una collezione.","lv":"Vienība, ko persona apkopojusi kopā ar citām vienībām no dažādiem avotiem, kas ir sakārtotas, aprakstītas un kataloģizētas kā kolekcija.","nl":"Een item dat samengebracht is door een persoon met items van diverse bronnen die gearrangeerd, beschreven of gecatalogiseerd zijn als een verzameling.","no":"Et eksemplar som av en person er satt sammen med eksemplarer fra ulike kilder og som er arrangert, beskrevet eller katalogisert som en samling."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50630", "lexicalAlias":"http://rdaregistry.info/Elements/a/curatorPersonOf.en", "label":"is curator person of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/P50045", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectorAgentOf.en", "label":"is collector agent of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/collectorPersonof.en","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50635", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collectorPersonof.en", "label":"is collector person of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50635", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collectorPersonof.en", "label":"is collector person of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50178","label":{"ar":"هو وكيل طبّاع صور فوتوغرافية","ca":"és agent fototipista de","cs":"je kolotypérem (agentem) (čeho)","da":"er agent, som er lystrykker af","de":"ist Akteur als Lichtdruckerin/Lichtdrucker von","de":"ist Akteur als Lichtdruckerin/Lichtdrucker von","el":"είναι κατασκευαστής κολλοτυπίας φορέας του","en":"is collotyper agent of","es":"es agente colotipiador de","et":"kollotüübi valmistaja (tegija) kehastuses","fi":"kollotypian valmistaja (toimija) manifestaatiossa","fr":"est un agent phototypeur de","hu":"fénynyomatkészítő ágense a következőnek:","it":"è collotipista agente di","lv":"ir fotogravieris (aģents)","nl":"is lichtdrukker-actor van","no":"er lystrykker av (agent)","tr":"kolotip baskıcı temsilcisidir","zh-Hans-CN":"是……的珂罗版制作者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو من غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird."],"el":["Συνδέει έναν φορέα, ο οποίος εμπλέκεται στην κατασκευή μιας εκδήλωσης μέσω της χρήσης μιας φωτομηχανικής διαδικασίας για τη δημιουργία εκτυπώσεων κατευθείαν από ένα σκληρυμένο φιλμ ζελατίνης ή άλλο κολλοειδές, το οποίο έχει μελανο-δεκτικές και μελανο-απωθητικές επιφάνειες, με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process."],"es":["Relaciona un agente con una manifestación que involucra la responsabilidad de un agente de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo."],"fi":["Liittää toimijan manifestaatioon, jonka valmistamisesta toimija on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique."],"hu":["Hozzákapcsol egy ágenst egy megjelenési formához, amelyhez hozzátartozik egy ágens felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente per l'utilizzo di un processo fotomeccanico per ottenere stampe direttamente da una pellicola indurita di gelatina o altro colloide che abbia superfici recettive e repellenti all'inchiostro."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av å bruke en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk."],"tr":["Bir temsilciyi, bir fotomekanik işlem kullanarak baskı yapmak için kullanılan, mürekkep alıcı ve mürekkep itici yüzeylere sahip sertleştirilmiş bir jelatin veya diğer kolloid filmi hazırlamakla görevli bir temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل طبّاع صور فوتوغرافية","ca":"agent fototipista de","cs":"kolotypér (agent) (čeho)","da":"agent, som er lystrykker af","de":"Akteur als Lichtdruckerin/Lichtdrucker von","de":"Akteur als Lichtdruckerin/Lichtdrucker von","el":"κατασκευαστής κολλοτυπίας φορέας του","en":"collotyper agent of","es":"agente colotipiador de","et":"kollotüübi valmistaja (tegija) kehastuses","fi":"kollotypian valmistaja (toimija) manifestaatiossa","fr":"agent phototypeur de","hu":"fénynyomatkészítő ágense:","it":"collotipista agente di","lv":"ir fotogravieris (aģents)","nl":"lichtdrukker-actor van","no":"lystrykker av (agent)","tr":"taş baskıcı temsilcisi","zh-Hans-CN":"……的珂罗版制作者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر.","ca":"Manifestació que implica una responsabilitat d’un agent en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.","cs":"Provedení, které zahrnuje odpovědnost agenta za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu.","da":"Manifestation, som involverer en agents ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.","de":"Eine Manifestation, bei der ein Akteur für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.","de":"Eine Manifestation, bei der ein Akteur für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird.","el":"Μια εκδήλωση που κατασκευάζεται από έναν φορέα υπεύθυνο για τη χρήση μιας φωτομηχανικής διαδικασίας για τη δημιουργία εκτυπώσεων κατευθείαν από ένα σκληρυμένο φιλμ ζελατίνης ή άλλο κολλοειδές, το οποίο έχει μελανο-δεκτικές και μελανο-απωθητικές επιφάνειες.","en":"A manifestation that involves a responsibility of an agent for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.","es":"Una manifestación que involucra la responsabilidad de un agente de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico.","et":"Kehastus, mis sisaldab tegija vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo.","fi":"Manifestaatio, jonka valmistamisesta toimija on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy ágens felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja.","it":"Manifestazione che implica la responsabilità di un agente per l'utilizzo di un processo fotomeccanico per ottenere stampe direttamente da una pellicola indurita di gelatina o altro colloide che abbia superfici recettive e repellenti all'inchiostro.","lv":"Manifestācija, kas ietver aģenta atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.","no":"En manifestasjon som involverer ansvar for en agent i form av å bruke en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.","tr":"Mürekkep alıcı ve mürekkep tutmayan yüzeylere sahip olan ve bir fotomekanik süreç kullanarak baskı yapmak için kullanılan sertleştirilmiş bir jelatin filmi veya diğer jelleri hazırlamakla görevli temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个行为者的责任的一种载体表现"},"altLabel":{"ar":["طبّاع صور فوتوغرافية لـ"],"ca":["fototipista de"],"cs":["kolotypér (čeho)"],"da":["lystrykker af"],"de":["Lichtdrucker von,Lichtdrucker von"],"el":["κατασκευαστής κολλοτυπίας του"],"en":["collotyper of"],"es":["colotipiador de"],"et":["kollotüübi valmistaja kehastuses"],"fi":["valmistajana kollotypioinnissa"],"fr":["phototypeur de,agent collotypiste de"],"hu":["fénynyomatkészítője:"],"it":["fototipografo di"],"nl":["lichtdrukker van"],"no":["lystrykker av"],"tr":["taş baskıcı"],"zh-Hans-CN":["……的珂罗版制作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperAgentOf.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50173", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerAgentOf.en", "label":"is printmaker agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50661", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperCollectiveAgentOf.en", "label":"is collotyper collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50510", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperPersonOf.en", "label":"is collotyper person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50178", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collotyperAgentOf.en", "label":"is collotyper agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50178", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collotyperAgentOf.en", "label":"is collotyper agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50661","label":{"ar":"هو وكيل جماعي طبّاع صور فوتوغرافية لـ","ca":"és agent col·lectiu fototipista de","cs":"je kolotypérem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er lystrykker af","de":"ist gemeinschaftlicher Akteur als Lichtdruckerin/Lichtdrucker von","de":"ist gemeinschaftlicher Akteur als Lichtdruckerin/Lichtdrucker von","el":"είναι κατασκευαστής κολλοτυπίας συλλογικός φορέας του","en":"is collotyper collective agent of","es":"Es agente colectivo calotipador de","et":"kollotüübi valmistaja (kollektiiv) kehastuses","fi":"kollotypian valmistaja (yhteistoimija) manifestaatiossa","fr":"est un agent collectif phototypeur de","hu":"fénynyomatkészítő kollektív ágense a következőnek:","lv":"ir fotogravieris (grupa)","nl":"is lichtdrukker-collectieve actor van","no":"er lystrykker for (kollektiv agent)","tr":"kolotip baskıcı kolektif temsilcisidir","zh-Hans-CN":"是……的珂罗版制作者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost kolektivního agenta za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process."],"es":["Relaciona un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que se utilice para realizar impresiones mediante un proceso fotomecánico."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo."],"fi":["Liittää yhteistoimijan manifestaatioon, jonka valmistamisesta yhteistoimija on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk."],"tr":["Kolektif bir temsilciyi, mürekkep alıcı ve mürekkep itici yüzeylere sahip ve bir fotomekanik işlem kullanarak baskı yapmak için kullanılan sertleştirilmiş bir jelatin veya diğer kolloid filmini hazırlamak için kolektif bir temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي طبّاع صور فوتوغرافية","ca":"agent col·lectiu fototipista de","cs":"kolotypér (kolektivní agent) (čeho)","da":"kollektiv agent, som er lystrykker af","de":"Gemeinschaftlicher Akteur als Lichtdruckerin/Lichtdrucker von","de":"Gemeinschaftlicher Akteur als Lichtdruckerin/Lichtdrucker von","el":"κατασκευαστής κολλοτυπίας συλλογικός φορέας του","en":"collotyper collective agent of","es":"agente colectivo calotipador de","et":"kollotüübi valmistaja (kollektiiv) kehastuses","fi":"kollotypian valmistaja (yhteistoimija) manifestaatiossa","fr":"agent collectif phototypeur de","hu":"fénynyomatkészítő kollektív ágense:","lv":"ir fotogravieris (grupa)","nl":"lichtdrukker-collectieve actor van","no":"lystrykker for (kollektiv agent)","tr":"taş baskıcı kolektif temsilcisi","zh-Hans-CN":"……的珂罗版制作者集体行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل جماعي عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر.","ca":"Manifestació que implica una responsabilitat d’un agent col·lectiu en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.","cs":"Provedení, které zahrnuje odpovědnost kolektivního agenta za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu.","da":"Manifestation, som involverer en kollektiv agents ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird.","en":"A manifestation that involves a responsibility of a collective agent for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.","es":"Una manifestación que implica la responsabilidad de un agente colectivo de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que se utilice para realizar impresiones mediante un proceso fotomecánico.","et":"Kehastus, mis sisaldab kollektiivi vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo.","fi":"Manifestaatio, jonka valmistamisesta yhteistoimija on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy kollektív ágens felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja.","lv":"Manifestācija, kas ietver grupas atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.","no":"En manifestasjon som involverer et ansvar for en kollektiv agent i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.","tr":"Mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskı yapmak için kullanılan sertleştirilmiş bir jelatin veya diğer kolloid filmini hazırlamak için kolektif bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个集体行为者的责任的一种载体表现"},"altLabel":{"de":["Gemeinschaftlicher Akteur als Koloristin/Kolorist von"],"en":["collotypist collective agent of"],"es":["agente colectivo calotipista de"],"fi":["-"],"fr":["agent collectif collotypiste de"],"nl":["lichtdrukker-collectieve actor van"],"tr":["taş baskı uzmanı kolektif temsilcisi"],"zh-Hans-CN":["……的珂罗版制作者集体行为者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50178", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperAgentOf.en", "label":"is collotyper agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50651", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerCollectiveAgentOf.en", "label":"is printmaker collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50812", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperCorporateBodyOf.en", "label":"is collotyper corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50963", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperFamilyOf.en", "label":"is collotyper family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50661", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collotyperCollectiveAgentOf.en", "label":"is collotyper collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50661", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collotyperCollectiveAgentOf.en", "label":"is collotyper collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50812","label":{"ar":"هي هيئة طبّاعة صور فوتوغرافية لـ","ca":"és entitat corporativa fototipista de","cs":"je kolotypérem (korporací) (čeho)","da":"er korporation, som er lystrykker af","de":"ist Körperschaft als Lichtdruckerin/Lichtdrucker von","de":"ist Körperschaft als Lichtdruckerin/Lichtdrucker von","el":"είναι κατασκευαστής κολλοτυπίας συλλογικό όργανο του","en":"is collotyper corporate body of","es":"es organismo corporativo colotipiador de","et":"kollotüübi valmistaja (asutus) kehastuses","fi":"kollotypian valmistaja (yhteisö) manifestaatiossa","fr":"est une collectivité phototypeuse de","hu":"fénynynomatkészítő testülete a következőnek:","it":"è collotipista ente di","lv":"ir fotogravieris (institūcija)","nl":"is lichtdrukker-corporatie van","no":"er lystrykker for (korporasjon)","tr":"kolotip baskıcı tüzel kişisidir","zh-Hans-CN":"是……的珂罗版制作者团体"},"definition":{"ar":["يربط هيئة بتجسيدة تنطوي على مسئولية هيئة عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر."],"ca":["Relaciona una entitat corporativa amb una manifestació que implica una responsabilitat d’una entitat corporativa en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic."],"cs":["Vztahuje korporaci k provedení, které zahrnuje odpovědnost korrporace za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu."],"da":["Relaterer en korporation til en manifestation, som involverer en korporations ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader."],"de":["Setzt eine Körperschaft in Beziehung zu einer Manifestation, bei der eine Körperschaft für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einer Manifestation, bei der eine Körperschaft für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird."],"en":["Relates a corporate body to a manifestation that involves a responsibility of a corporate body for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process."],"es":["Relaciona un organismo corporativo con una manifestación que involucra la responsabilidad de un organismo corporativo de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico."],"et":["Seostab asutuse kehastusega, mis sisaldab asutuse vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo."],"fi":["Liittää yhteisön manifestaatioon, jonka valmistamisesta yhteisö on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja."],"fr":["Met une collectivité en relation avec une manifestation qui comporte une responsabilité de la part d’une collectivité consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique."],"hu":["Hozzákapcsol egy testületet egy megjelenési formához, amelyhez hozzátartozik egy testület felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja."],"it":["Correla un ente a una manifestazione che implica una responsabilità di un ente per l'utilizzo di un processo fotomeccanico per ottenere stampe direttamente da una pellicola indurita di gelatina o altro colloide che abbia superfici recettive e repellenti all'inchiostro."],"lv":["Sasaista institūciju ar manifestāciju, kas ietver institūcijas atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas."],"nl":["Relateert een corporatie aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een corporatie voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces."],"no":["Relaterer en korporasjon til en manifestasjon som involverer et ansvar for en korporasjon i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk."],"tr":["Bir tüzel kişiyi, bir fotomekanik işlem kullanarak baskı yapmak için kullanılan, mürekkep alıcı ve mürekkep itici yüzeylere sahip sertleştirilmiş bir jelatin veya diğer kolloid filmini hazırlama sorumluluğunu içeren bir gösterim ile ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个团体的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"هيئة طبّاعة لصور فوتوغرافية","ca":"entitat corporativa fototipista de","cs":"kolotypér (korporace) (čeho)","da":"korporation, som er lystrykker af","de":"Körperschaft als Lichtdruckerin/Lichtdrucker von","de":"Körperschaft als Lichtdruckerin/Lichtdrucker von","el":"κατασκευαστής κολλοτυπίας συλλογικό όργανο του","en":"collotyper corporate body of","es":"organismo corporativo colotipiador de","et":"kollotüübi valmistaja (asutus) kehastuses","fi":"kollotypian valmistaja (yhteisö) manifestaatiossa","fr":"collectivité phototypeuse de","hu":"fénynyomatkészítő testülete:","it":"collotipista ente di","lv":"ir fotogravieris (institūcija)","nl":"lichtdrukker-corporatie van","no":"lystrykker for (korporasjon)","tr":"taş baskıcı tüzel kişisi","zh-Hans-CN":"……的珂罗版制作者团体"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية هيئة عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر.","ca":"Manifestació que implica una responsabilitat d’una entitat corporativa en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.","cs":"Provedení, které zahrnuje odpovědnost korrporace za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu.","da":"Manifestation, som involverer en korporations ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.","de":"Eine Manifestation, bei der eine Körperschaft für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.","de":"Eine Manifestation, bei der eine Körperschaft für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird.","en":"A manifestation that involves a responsibility of a corporate body for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.","es":"Una manifestación que involucra la responsabilidad de un organismo corporativo de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico.","et":"Kehastus, mis sisaldab asutuse vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo.","fi":"Manifestaatio, jonka valmistamisesta yhteisö on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.","fr":"Manifestation qui comporte une responsabilité de la part d’une collectivité consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy testület felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja.","it":"Manifestazione che implica una responsabilità di un ente per l'utilizzo di un processo fotomeccanico per ottenere stampe direttamente da una pellicola indurita di gelatina o altro colloide che abbia superfici recettive e repellenti all'inchiostro.","lv":"Manifestācija, kas ietver institūcijas atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een corporatie voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.","no":"En manifestasjon som involverer et ansvar for en korporasjon i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.","tr":"Mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskılar yapmak için kullanılan sertleştirilmiş bir jelatin veya diğer kolloid filmi hazırlamak için tüzel bir kişinin sorumluluğunu içeren bir gösteriö.","zh-Hans-CN":"涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个团体的责任的一种载体表现"},"altLabel":{"de":["Körperschaft als Koloristin/Kolorist von"],"en":["collotypist corporate body of"],"es":["organismo corporativo colotipista de"],"fi":["-"],"fr":["collectivité collotypiste de"],"nl":["lichtdrukker-corporatie van"],"tr":["taş baskı uzmanı tüzel kişisi"],"zh-Hans-CN":["……的珂罗版制作者团体"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50661", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperCollectiveAgentOf.en", "label":"is collotyper collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50802", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerCorporateBodyOf.en", "label":"is printmaker corporate body of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50812", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collotyperCorporateBodyOf.en", "label":"is collotyper corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50812", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collotyperCorporateBodyOf.en", "label":"is collotyper corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50963","label":{"ar":"هي عائلة طبّاعة صور فوتوغرافية لـ","ca":"és família fototipista de","cs":"je kolotypérem (rodinou) (čeho)","da":"er familie, som er lystrykker af","de":"ist Familie als Lichtdruckerin/Lichtdrucker von","de":"ist Familie als Lichtdruckerin/Lichtdrucker von","el":"είναι κατασκευαστής κολλοτυπίας οικογένεια του","en":"is collotyper family of","es":"es familia colotipiadora de","et":"kollotüübi valmistaja (perekond) kehastuses","fi":"kollotypian valmistaja (suku) manifestaatiossa","fr":"est une famille phototypeuse de","hu":"fénynyomatkészítő családja a következőnek:","it":"è collotipista famiglia di","lv":"ir fotogravieris (dzimta/ģimene)","nl":"is lichtdrukker-familie van","no":"er lystrykker for (familie)","tr":"kolotip baskıcı ailesidir","zh-Hans-CN":"是……的珂罗版制作者家族"},"definition":{"ar":["يربط عائلة بتجسيدة تنطوي على مسئولية عائلة عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر."],"ca":["Relaciona una família amb una manifestació que implica una responsabilitat d’una família en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic."],"cs":["Vztahuje rodinu k provedení, které zahrnuje odpovědnost rodiny za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu."],"da":["Relaterer en familie til en manifestation, som involverer en families ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader."],"de":["Setzt eine Familie in Beziehung zu einer Manifestation, bei der eine Familie für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.,Setzt eine Familie in Beziehung zu einer Manifestation, bei der eine Familie für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittel eines fotomechanischen Verfahrens verwendet wird."],"en":["Relates a family to a manifestation that involves a responsibility of a family for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process."],"es":["Relaciona una familia con una manifestación que involucra la responsabilidad de una familia de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico."],"et":["Seostab perekonna kehastusega, mis sisaldab perekonna vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo."],"fi":["Liittää suvun manifestaatioon, jonka valmistamisesta suku on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja."],"fr":["Met une famille en relation avec une manifestation qui comporte une responsabilité de la part d’une famille consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique."],"hu":["Hozzákapcsol egy családot egy megjelenési formához, amelyhez hozzátartozik egy család felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja."],"it":["Correla una famiglia a una manifestazione che implica una responsabilità di una famiglia per l'utilizzo di un processo fotomeccanico per ottenere stampe direttamente da una pellicola indurita di gelatina o altro colloide che abbia superfici recettive e repellenti all'inchiostro."],"lv":["Sasaista dzimtu/ģimeni ar manifestāciju, kas ietver dzimtas/ģimenes atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas."],"nl":["Relateert een familie aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een familie voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces."],"no":["Relaterer en familie til en manifestasjon som involverer et ansvar for en familie i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk."],"tr":["Bir aileyi, ailenin mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskı yapmak için kullanılan sertleştirilmiş jelatin veya başka bir kolloid filmin hazırlanması sorumluluğunu içeren gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个家族的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"عائلة طبّاعة صور فوتوغرافية","ca":"família fototipista de","cs":"kolotypér (rodina) (čeho)","da":"familie, som er lystrykker af","de":"Familie als Lichtdruckerin/Lichtdrucker von","de":"Familie als Lichtdruckerin/Lichtdrucker von","el":"κατασκευαστής κολλοτυπίας οικογένεια του","en":"collotyper family of","es":"familia colotipiadora de","et":"kollotüübi valmistaja (perekond) kehastuses","fi":"kollotypian valmistaja (suku) manifestaatiossa","fr":"famille phototypeuse de","hu":"fénynyomatkészítő családja:","it":"collotipista famiglia di","lv":"ir fotogravieris (dzimta/ģimene)","nl":"lichtdrukker-familie van","no":"lystrykker for (familie)","tr":"taş baskıcı aile","zh-Hans-CN":"……的珂罗版制作者家族"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية عائلة عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر.","ca":"Manifestació que implica una responsabilitat d’una família en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.","cs":"Provedení, které zahrnuje odpovědnost rodiny za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu.","da":"Manifestation, som involverer en families ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.","de":"Eine Manifestation, bei der eine Familie für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.","de":"Eine Manifestation, bei der eine Familie für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird.","en":"A manifestation that involves a responsibility of a family for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.","es":"Una manifestación que involucra la responsabilidad de una familia de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico.","et":"Kehastus, mis sisaldab perekonna vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo.","fi":"Manifestaatio, jonka valmistamisesta suku on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.","fr":"Manifestation qui comporte une responsabilité de la part d’une famille consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy család felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja.","it":"Manifestazione che implica una responsabilità di una famiglia per l'utilizzo di un processo fotomeccanico per ottenere stampe direttamente da una pellicola indurita di gelatina o altro colloide che abbia superfici recettive e repellenti all'inchiostro.","lv":"Manifestācija, kas ietver dzimtas/ģimenes atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een familie voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.","no":"En manifestasjon som involverer et ansvar for en familie i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.","tr":"Bir ailenin mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskı yapmak için kullanılan sertleştirilmiş jelatin veya başka bir kolloid filmin hazırlanması sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个家族的责任的一种载体表现"},"altLabel":{"de":["Familie als Coloristin/Colorist von"],"en":["collotypist family of"],"es":["familia colotipista de"],"fi":["-"],"fr":["famille collotypiste de"],"nl":["lichtdrukker-familie van"],"tr":["taş baskı uzmanı ailesi"],"zh-Hans-CN":["……的珂罗版制作者家族"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
