                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51014", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorFamilyOf.en", "label":"is director family of"},{"@id":"http://rdaregistry.info/Elements/a/P50714", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorCollectiveAgentOf.en", "label":"is radio director collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51016", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/radioDirectorFamilyOf.en", "label":"is radio director family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51016", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/radioDirectorFamilyOf.en", "label":"is radio director family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50563","label":{"ar":"هو شخص مخرج إذاعي لـ","ca":"és persona realitzadora radiofònica de","cs":"je rozhlasovým režisérem (osobou) (čeho)","da":"er person, som er radioregissør af","de":"ist Person als Hörfunkregisseurin/Hörfunkregisseur von","de":"ist Person als Hörfunkregisseurin/Hörfunkregisseur von","el":"είναι διευθυντής ραδιοφώνου φυσικό πρόσωπο του","en":"is radio director person of","es":"es director de radio de","et":"raadiorežissöör (isik) teoses","fi":"radio-ohjaaja (henkilö) teoksessa","fr":"est une personne réalisatrice de radio de","hu":"rádiós rendező személye a következőnek:","it":"è regista radiofonico persona di","lv":"ir radio raidījuma direktors (persona)","nl":"is radioregisseur-persoon van","no":"er radioregissør for (person)","tr":"radyo yönetmeni kişisidir","zh-Hans-CN":"是……的广播导演个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن الإدارة العامة والإشراف على برنامج إذاعي."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la gestió general i la supervisió d’un programa radiofònic."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za obecné řízení a dohled nad rozhlasovým programem."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for den generelle ledelse af- og tilsyn med et radioprogram."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for the general management and supervision of a radio program."],"es":["Relaciona a una persona con una obra que implica una responsabilidad de una persona para la dirección general y supervisión de un programa de radio."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust raadiosaate üldise juhtimise ja juhendamise eest."],"fi":["Liittää henkilön teokseen, joka sisältää vastuun radio-ohjelman yleisestä johtamisesta ja valvonnasta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à assurer la gestion et la supervision générales d’une émission de radio."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy rádióműsor általános menedzseléséért és felügyeletéért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per la gestione e supervisione generale di un programma radiofonico."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par radio raidījuma vispārējo vadību un uzraudzību."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het algemeen beheer en toezicht van een radioprogramma."],"no":["Relaterer en person til et verk som involverer et ansvar for en person for den generelle ledelsen og tilsyn med et radioprogram."],"tr":["Bir kişiyi, bir radyo programının genel yönetim ve denetim sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及广播节目的总体管理和监督的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص مخرج إذاعي","ca":"persona realitzadora radiofònica de","cs":"rozhlasový režisér (osoba) (čeho)","da":"person, som er radioregissør af","de":"Person als Hörfunkregisseurin/Hörfunkregisseur von","de":"Person als Hörfunkregisseurin/Hörfunkregisseur von","el":"διευθυντής ραδιοφώνου φυσικό πρόσωπο του","en":"radio director person of","es":"director de radio de","et":"raadiorežissöör (isik) teoses","fi":"radio-ohjaaja (henkilö) teoksessa","fr":"personne réalisatrice de radio de","hu":"rádiós rendező személye:","it":"regista radiofonico persona di","lv":"ir radio raidījuma direktors (persona)","nl":"radioregisseur-persoon van","no":"radioregissør for (person)","tr":"radyo yönetmeni olan kişi","zh-Hans-CN":"……的广播导演个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن الإدارة العامة والإشراف على برنامج إذاعي.","ca":"Obra que implica una responsabilitat d’una persona en la gestió general i la supervisió d’un programa radiofònic.","cs":"Dílo, které zahrnuje odpovědnost osoby za obecné řízení a dohled nad rozhlasovým programem.","da":"Værk, som involverer en persons ansvar for den generelle ledelse af- og tilsyn med et radioprogram.","de":"Ein Werk, bei dem eine Person für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.","de":"Ein Werk, bei dem eine Person für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.","en":"A work that involves a responsibility of a person for the general management and supervision of a radio program.","es":"Una obra que implica una responsabilidad de una persona para la dirección general y supervisión de un programa de radio.","et":"Teos, mis sisaldab isiku vastutust raadiosaate üldise juhtimise ja juhendamise eest.","fi":"Teos, joka sisältää vastuun radio-ohjelman yleisestä johtamisesta ja valvonnasta.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à assurer la gestion et la supervision générales d’une émission de radio.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy rádióműsor általános menedzseléséért és felügyeletéért.","it":"Opera che implica una responsabilità di una persona per la gestione e supervisione generale di un programma radiofonico.","lv":"Darbs, kas ietver personas atbildību par radio raidījuma vispārējo vadību un uzraudzību.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het algemeen beheer en toezicht van een radioprogramma.","no":"Et verk som involverer et ansvar for en person for den generelle ledelsen og tilsyn med et radioprogram.","tr":"Bir radyo programının genel yönetimi ve denetimi için bir kişinin sorumluluğunu içeren bir çalışma","zh-Hans-CN":"涉及广播节目的总体管理和监督的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
