                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/brailleEmbosserPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50505", "lexicalAlias":"http://rdaregistry.info/Elements/a/manufacturerPersonOf.en", "label":"is manufacturer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50172", "lexicalAlias":"http://rdaregistry.info/Elements/a/brailleEmbosserAgentOf.en", "label":"is braille embosser agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50498", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/brailleEmbosserPersonOf.en", "label":"is braille embosser person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50498", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/brailleEmbosserPersonOf.en", "label":"is braille embosser person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50168","label":{"ar":"هو وكيل مذيع لـ","ca":"és agent difusor audiovisual de","cs":"je vysílatelem (agentem) (čeho)","da":"er agent, som er broadcaster af","de":"ist Akteur als Sender von","de":"ist Akteur als Sender von","el":"είναι ευρυεκπομπέας φορέας του","en":"is broadcaster agent of","es":"es agente transmisor de","et":"leviedastaja (tegija) kehastuses","fi":"lähetyksestä vastaava toimija manifestaatiossa","fr":"est un agent diffuseur audiovisuel de","hu":"műsorszolgáltató ágense a következőnek:","it":"è diffusore agente di","lv":"ir raidorganizācija (aģents)","nl":"is uitzender-actor van","no":"er kringkaster av (agent)","tr":"yayıncı temsilcisidir","zh-Hans-CN":"是……的广播者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل عن البث إلى جمهور عبر الإذاعة والتلفزيون والإنترنت، الخ."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent per la difusió a uns destinataris mitjançant la ràdio, la televisió, el web, etc."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za vysílání publiku prostřednictvím rozhlasu, televize, webového vysílání atd."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for at transmittere til et publikum via radio, tv, webcast etc."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für die Ausstrahlung über Hörfunk, Fernsehen oder Webcast und so weiter verantwortlich ist.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für die Ausstrahlung über Hörfunk, Fernsehen oder Webcast und so weiter verantwortlich ist."],"el":["Συνδέει έναν φορέα, ο οποίος εμπλέκεται στην εκπομπή μιας εκδήλωσης προς ένα ακροατήριο μέσω ραδιοφώνου, τηλεόρασης, web εκπομπής κ.λπ., με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for broadcasting to an audience via radio, television, webcast, etc."],"es":["Relaciona un agente con una manifestación que involucra una responsabilidad de un agente para transmitir a una audiencia vía radio, televisión, webcast, etc."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust avalikkusele levitamise eest raadio, televisiooni, veebi vms kaudu."],"fi":["Liittää toimijan manifestaatioon, jossa toimija on vastuussa radio-, televisio-, suoratoisto- tms. lähetyksen toteuttamisesta yleisölle."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent en ce qui concerne la diffusion à un public par la radio, la télévision, la webdiffusion, etc."],"hu":["Hozzákapcsol egy ágenst egy megjelenési formához, amelyhez hozzátartozik egy ágens felelőssége műsorszórásért, amely a közönség felé rádión, televízión, webes közvetítésen stb. keresztül történik."],"it":["Correla un agente a una manifestazione che implica una responsabilità di un agente nella trasmissione a un pubblico via radio, televisione, web, etc."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par pārraidi, izmantojot radio, televīziju, tīmekļa apraidi u.tml."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor uitzending naar een publiek via radio, televisie, webcast etc."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av kringkasting til et publikum via radio, fjernsyn, webcast, etc."],"tr":["Bir temsilciyi, bir kitleye radyo, televizyon, genel ağ yayını aracılığıyla yayın yapma sorumluluğunu içeren bir gösterimle ilişkilendirir"],"zh-Hans-CN":["将一个行为者与涉及一个通过广播、电视、网络直播等向听众播音的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل مذيع","ca":"agent difusor audiovisual de","cs":"vysílatel (agent) (čeho)","da":"agent, som er broadcaster af","de":"Akteur als Sender von","de":"Akteur als Sender von","el":"ευρυεκπομπέας φορέας του","en":"broadcaster agent of","es":"agente transmisor de","et":"leviedastaja (tegija) kehastuses","fi":"lähetyksestä vastaava toimija manifestaatiossa","fr":"agent diffuseur audiovisuel de","hu":"műsorszolgáltató ágense:","it":"diffusore agente di","lv":"ir raidorganizācija (aģents)","nl":"uitzender-actor van","no":"kringkaster av (agent)","tr":"yayıncı temsilcisi","zh-Hans-CN":"……的广播者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن البث إلى جمهور عبر الإذاعة والتلفزيون والإنترنت، الخ.","ca":"Manifestació que implica una responsabilitat d’un agent per la difusió a uns destinataris mitjançant la ràdio, la televisió, el web, etc.","cs":"Provedení, které zahrnuje odpovědnost agenta za vysílání publiku prostřednictvím rozhlasu, televize, webového vysílání atd.","da":"Manifestation, som involverer en agents ansvar for at transmittere til et publikum via radio, tv, webcast etc.","de":"Eine Manifestation, bei der ein Akteur für die Ausstrahlung über Hörfunk, Fernsehen oder Webcast und so weiter verantwortlich ist.","de":"Eine Manifestation, bei der ein Akteur für die Ausstrahlung über Hörfunk, Fernsehen oder Webcast und so weiter verantwortlich ist.","el":"Μια εκδήλωση που εκπέμπεται προς ένα ακροατήριο μέσω ραδιοφώνου, τηλεόρασης, web εκπομπής κ.λπ. .","en":"A manifestation that involves a responsibility of an agent for broadcasting to an audience via radio, television, webcast, etc.","es":"Una manifestación que involucra una responsabilidad de un agente para transmitir a una audiencia vía radio, televisión, webcast, etc.","et":"Kehastus, mis sisaldab tegija vastutust avalikkusele levitamise eest raadio, televisiooni, veebi vms kaudu.","fi":"Manifestaatio, jossa toimija on vastuussa radio-, televisio-, suoratoisto- tms. lähetyksen toteuttamisesta yleisölle.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent en ce qui concerne la diffusion à un public par la radio, la télévision, la webdiffusion, etc.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy ágens felelőssége műsorszórásért, amely a közönség felé rádión, televízión, webes közvetítésen stb. keresztül történik.","it":"Manifestazione che implica una responsabilità di un agente nella trasmissione a un pubblico via radio, televisione, web, etc.","lv":"Manifestācija, kas ietver aģenta atbildību par pārraidi, izmantojot radio, televīziju, tīmekļa apraidi u.tml.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor uitzending naar een publiek via radio, televisie, webcast etc.","no":"En manifestasjon som involverer ansvar for en agent i form av kringkasting til et publikum via radio, fjernsyn, webcast, etc.","tr":"Bir temsilcinin radyo, televizyon, web yayını vb. yoluyla bir izleyici kitlesine yayın yapma sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及一个通过广播、电视、网络直播等向听众播音的一个行为者的责任的一种载体表现"},"altLabel":{"ar":["مذيع"],"ca":["entitat de difusió de"],"cs":["vysílatel (čeho)"],"da":["broadcaster af"],"de":["Sender von,Sender von"],"el