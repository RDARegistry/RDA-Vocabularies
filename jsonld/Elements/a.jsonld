                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50366", "lexicalAlias":"http://rdaregistry.info/Elements/a/subjectAgentOf.en", "label":"is subject agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/agentDescribedBy.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50427", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectiveAgentDescribedBy.en", "label":"is collective agent described by"},{"@id":"http://rdaregistry.info/Elements/a/P50368", "lexicalAlias":"http://rdaregistry.info/Elements/a/personDescribedBy.en", "label":"is person described by"},{"@id":"http://rdaregistry.info/Elements/a/P51108", "lexicalAlias":"http://rdaregistry.info/Elements/a/agentDescribedWithMetadataBy.en", "label":"is agent described with metadata by"},{"@id":"http://rdaregistry.info/Elements/a/object/P50426", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/agentDescribedBy.en", "label":"is agent described by"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50426", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/agentDescribedBy.en", "label":"is agent described by"}]},{"@id":"http://rdaregistry.info/Elements/a/P50453","label":{"ar":"هو وكيل مجمع لـ","ca":"és agent agregador de","cs":"je agregátorem (agentem) (čeho)","da":"er agent, som er samler af","de":"ist Akteur als Aggregatorin/Aggregator von","de":"ist Akteur als Aggregatorin/Aggregator von","el":"είναι ερανιστής φορέας του","en":"is aggregator agent of","es":"es agente agregador de","et":"liitja (tegija) teoses","fi":"aggregaattori (toimija) teoksessa","fr":"est un agent agrégateur de","hu":"aggregátor ágense a következőnek:","it":"è aggregatore agente di","lv":"ir apkopotājs (aģents)","nl":"is aggregator-actor van","no":"er aggregator for (agent)","tr":"toplayıcı temsilcisidir","zh-Hans-CN":"是……的合集编者行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن التجميع عن طريق اختيار تعبيرات الأعمال الأخرى وترتيبها."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en l’agregació mitjançant la selecció i l’arranjament d’expressions d’altres obres."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za agregaci výběrem a uspořádáním vyjádření jiných děl."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for sammenlægning ved at udvælge og arrangere udtryk af andre værk."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates an agent to a work that involves a responsibility of an agent for aggregation by selecting and arranging expressions of other works."],"es":["Relaciona a un agente con una obra que implica la responsabilidad de un agente por la agregación mediante la selección y organización de expresiones de otras obras."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust liitumi loomise eest, valides ja korrastades teiste teoste väljendused."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne l’agrégation par la sélection et l’arrangement d’expressions d’autres œuvres."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége más művek kifejezési formáinak kiválasztásával és elrendezésével járó aggregálásáért."],"it":["Correla un agente con un'opera che implica una responsabilità di un agente nell'aggregazione tramite selezione e sistemazione di espressioni di altre opere."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par apkopošanu, atlasot un sakārtojot citu darbu izteiksmes."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor aggregeren door middel van selectie en arrangeren van expressies van andere werken."],"no":["Relaterer en agent til et verk som involverer ansvar fra en agent for aggregering ved å velge ut og arrangere uttrykk av andre verk."],"tr":["Bir temsilciyi, diğer eserlerin anlatımlarını seçerek ve düzenleyerek toplamakla sorumlu bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及把其他作品的内容表达选择和整理后编制合集的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل مجمع","ca":"agent agregador de","cs":"agregátor (agent) (čeho)","da":"agent, som er samler af","de":"Akteur als Aggregatorin/Aggregator von","de":"Akteur als Aggregatorin/Aggregator von","el":"συναθροιστής φορέας του","en":"aggregator agent of","es":"agente agregador de","et":"liitja (tegija) teoses","fi":"aggregaattori (toimija) teoksessa","fr":"agent agrégateur de","hu":"aggregátor ágense:","it":"aggregatore agente di","lv":"ir apkopotājs (aģents)","nl":"aggregator-actor van","no":"aggregator for (agent)","tr":"Toplayıcı temsilci","zh-Hans-CN":"……的合集编者行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن التجميع عن طريق اختيار وترتيب تعبيرات الأعمال الأخرى.","ca":"Obra que implica una responsabilitat d’un agent en l’agregació mitjançant la selecció i l’arranjament d’expressions d’altres obres.","cs":"Dílo, které zahrnuje odpovědnost agenta za agregaci výběrem a uspořádáním vyjádření jiných děl.","da":"Værk, som involverer en agents ansvar for sammenlægning ved at udvælge og arrangere udtryk af andre værk.","de":"Ein Werk, bei dem ein Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","de":"Ein Werk, bei dem ein Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","en":"A work that involves a responsibility of an agent for aggregation by selecting and arranging expressions of other works.","es":"Una obra que implica la responsabilidad de un agente por la agregación mediante la selección y organización de expresiones de otras obras.","et":"Teos, mis sisaldab tegija vastutust liitumi loomise eest, valides ja korrastades teiste teoste väljendused.","fi":"Teos, jossa toimija on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne l’agrégation par la sélection et l’arrangement d’expressions d’autres œuvres.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége más művek kifejezési formáinak kiválasztásával és elrendezésével járó aggregálásáért.","it":"Opera che implica una responsabilità di un agente nell'aggregazione tramite selezione e sistemazione di espressioni di altre opere.","lv":"Darbs, kas ietver aģenta atbildību par apkopošanu, atlasot un sakārtojot citu darbu izteiksmes.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor aggregeren door middel van selectie en arrangeren van expressies van andere werken.","no":"Et verk som involverer ansvar fra en agent for aggregering ved å velge ut og arrangere uttrykk av andre verk.","tr":"Diğer eserlerin anlatımlarını seçip düzenleyerek bir araya getirmek için bir temsilcinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及把其他作品的内容表达选择和整理后编制合集的一个行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
