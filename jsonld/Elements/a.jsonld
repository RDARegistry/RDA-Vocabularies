                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/partner.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50274", "lexicalAlias":"http://rdaregistry.info/Elements/a/colleague.en", "label":"has colleague"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50278", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/partner.en", "label":"has partner"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50278", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/partner.en", "label":"has partner"}]},{"@id":"http://rdaregistry.info/Elements/a/P50147","label":{"ar":"هو وكيل مؤدٍ لـ","ca":"és agent intèrpret de","cs":"je účinkujícím (agentem) (čeho)","da":"er agent, som er udøver af","de":"ist Akteur als Ausführende/Ausführender von","de":"ist Akteur als Ausführende/Ausführender von","el":"είναι εκτελεστής φορέας του","en":"is performer agent of","es":"es agente intérprete de","et":"esitaja (tegija) väljenduses","fi":"esittäjä (toimija) ekspressiossa","fr":"est un agent interprète de","hu":"előadó ágense a következőnek:","it":"è esecutore agente di","lv":"ir izpildītājs (aģents)","nl":"is uitvoerder-actor van","no":"er utøver av (agent)","tr":"sanatçı temsilcisidir","zh-Hans-CN":"是……的表演者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في أداء موسيقى، تمثيل، رقص، حوار، إلخ."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent executant la música, actuant, dansant, parlant, etc."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že prezentuje hudební, herecké, taneční, řečnické a další role."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at opføre musik, spille skuespil, danse, tale etc."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Musik aufführt, schauspielt, tanzt oder spricht und so weiter.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Musik aufführt, schauspielt, tanzt oder spricht und so weiter."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της μουσικής ερμηνείας, της υποκριτικής, του χορού, της ομιλίας κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of performing music, acting, dancing, speaking, etc."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de interpretar música, una actuación, un baile, discurso, etc."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, esitades muusikat, näideldes, tantsides, kõneldes vms."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla tms."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à exécuter de la musique, à jouer, à danser, à parler, etc."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését zene, színjátszás, tánc, élőbeszéd, stb. előadásában."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nell'eseguire musica, recitare, danzare, parlare, etc.."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, izpildot mūziku, tēlojumu, deju, runu u.tml."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door uitvoering van muziek, acteren, dansen, spreken etc."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å spille musikk, spille skuespill, danse, tale, etc."],"tr":["Bir temsilciyi, müzik yapan, oynayan, dans eden, konuşan vb. temsilcinin katkılarını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括表演音乐、扮演、舞蹈、说话等的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مؤدِ","ca":"agent intèrpret de","cs":"účinkující (agent) (čeho)","da":"agent, som er udøver af","de":"Akteur als Ausführende/Ausführender von","de":"Akteur als Ausführende/Ausführender von","el":"εκτελεστής φορέας του","en":"performer agent of","es":"agente intérprete de","et":"esitaja (tegija) väljenduses","fi":"esittäjä (toimija) ekspressiossa","fr":"agent interprète de","hu":"előadó ágense:","it":"esecutore agente di","lv":"ir izpildītājs (aģents)","nl":"uitvoerder-actor van","no":"utøver av (agent)","tr":"sanatçı temsilcisi","zh-Hans-CN":"……的表演者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام من وكيل في أداء موسيقى، تمثيل، رقص، حوار، إلخ.","ca":"Expressió que inclou una contribució d’un agent executant la música, actuant, dansant, parlant, etc.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že prezentuje hudební, herecké, taneční, řečnické a další role.","da":"Udtryk, som omfatter en agents bidrag ved at opføre musik, spille skuespil, danse, tale, etc.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er Musik aufführt, schauspielt, tanzt oder spricht und so weiter.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er Musik aufführt, schauspielt, tanzt oder spricht und so weiter.","el":"Mια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά της μουσικής ερμηνείας, της ηθοποιίας, του χορού, της ομιλίας κ.λπ.","en":"An expression that includes a contribution by an agent of performing music, acting, dancing, speaking, etc.","es":"Una expresión que incluye una contribución de un agente de interpretar música, una actuación, un baile, discurso, etc.","et":"Väljendus, millesse tegija on andnud panuse, esitades muusikat, näideldes, tantsides, kõneldes vms.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla tms.","fr":"Expressio