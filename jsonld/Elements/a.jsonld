                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50111", "lexicalAlias":"http://rdaregistry.info/Elements/a/nameOfPerson.en", "label":"has name of person"},{"@id":"http://rdaregistry.info/Elements/a/P50413", "lexicalAlias":"http://rdaregistry.info/Elements/a/preferredNameOfAgent.en", "label":"has preferred name of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/preferredNameOfPerson.en","instructionNumber":"9.2.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50117", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/preferredNameOfPerson.en", "label":"has preferred name of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50117", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/preferredNameOfPerson.en", "label":"has preferred name of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50111","label":{"ar":"له اسم شخص","ca":"té com a nom de persona","cs":"má jméno osoby","da":"har navn på person","de":"hat Namen einer Person","de":"hat Namen einer Person","el":"έχει όνομα του φυσικού προσώπου","en":"has name of person","es":"tiene nombre de persona","et":"isiku nimi","fi":"henkilön nimi","fr":"a pour nom de personne","hu":"személy neve a következő:","it":"ha come nome di persona","lv":"personas vārds","nl":"heeft naam van persoon","no":"har personnavn","sv":"har personnamn","tr":"kişinin adı ile ilişkilidir","zh-Hans-CN":"有个人的名称"},"definition":{"ar":["يربط شخصا بتسمية شخص في اللغة الطبيعية وفي العبارات المستخدمة في الخطاب العام."],"ca":["Relaciona una persona amb un nomen que és una apel·lació de persona en llenguatge i frases naturals usada en el discurs comú."],"cs":["Vztahuje osobu k nomen, které je pojmenováním osoby v přirozeném jazyce a frázích používaných v běžném diskurzu."],"da":["Relaterer en person til et nomen, som er en benævnelse på person på normalsprog og med formuleringer, som bruges alment."],"de":["Setzt eine Person in Beziehung zu einer Bezeichnung für eine Person in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.,Setzt eine Person in Beziehung zu einer Bezeichnung für eine Person in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια ονομασία του φυσικού προσώπου σε φυσική γλώσσα και διατύπωση που χρησιμοποιείται στον καθημερινό διάλογο."],"en":["Relates a person to a nomen that is an appellation of person in natural language and phrasing used in common discourse."],"es":["Relaciona una persona con"],"et":["Seostab isiku isiku nimetusega loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses."],"fi":["Liittää henkilön nomeniin, joka on luonnollisella kielellä ja sanamuodolla oleva, yleisessä diskurssissa käytetty nimitys henkilöstä."],"fr":["Met une personne en relation avec un nomen qui est une appellation de personne exprimée dans un langage et une formulation naturels et utilisée dans le langage courant."],"hu":["Hozzákapcsol egy személyt egy nomenhez, amely egy személy megnevezése természetes nyelven és közbeszédben használt kifejezéssel."],"it":["Correla una persona a una denominazione di persona in linguaggio naturale e frasi usate nel discorso comune."],"lv":["Sasaista personu ar nomenu, kas ir personas apzīmējums dabiskajā valodā, ko izmanto savstarpējā saziņā."],"nl":["Relateert een persoon aan een nomen dat is een benaming van persoon in natuurlijke taal en formulering gebruikt in alledaags taalgebruik."],"no":["Relaterer en person til en betegnelse for person på et naturlig språk og med frasering brukt i alminnelig diskurs."],"tr":["Bir kişiyi, doğal dilde ve ortak söylemde kullanılan ifadelerde bir kişi unvanı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一个个人与作为用自然语言和普通话语措词表达的个人的称谓的一个命名关联起来。"]},"ToolkitLabel":{"ar":"اسم شخص","ca":"nom de persona","cs":"jméno osoby","da":"navn på person","de":"Name einer Person","de":"Name einer Person","el":"όνομα του φυσικού προσώπου","en":"name of person","es":"nombre de persona","et":"isiku nimi","fi":"henkilön nimi","fr":"nom de personne","hu":"személynév:","it":"nome di persona","lv":"personas vārds","nl":"naam van persoon","no":"personnavn","sv":"personnamn","tr":"kişinin adı","zh-Hans-CN":"个人的名称"},"ToolkitDefinition":{"ar":"تسمية شخص في اللغة الطبيعية وفي العبارات المستخدمة في الخطاب العام.","ca":"Nomen que és una apel·lació de persona en llenguatge i frases naturals usada en el discurs comú.","cs":"Nomen, které je pojmenováním osoby v přirozeném jazyce a frázích používaných v běžném diskurzu.","da":"Nomen, som er en benævnelse på person på normalsprog og med formuleringer, som bruges alment.","de":"Eine Bezeichnung für eine Person in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.","de":"Eine Bezeichnung für eine Person in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.","el":"Μια λέξη, φράση, χαρακτήρας ή ομάδα λέξεων ή/και χαρακτήρων με τους οποίους είναι γνωστό ένα φυσικό πρόσωπο.","en":"A nomen that is an appellation of person in natural language and phrasing used in common discourse.","es":"Un nomen que es un apelativo de persona en lenguaje natural y fraseo utilizado en el discurso común.","et":"Isiku nimetus loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses.","fi":"Nomen, joka on henkilöstä yleisessä diskurssissa käytetty nimitys, joka on luonnollisella kielellä ja luonnollisessa sanamuodossa.","fr":"Nomen qui est une appellation de personne exprimée dans un langage et une formulation naturels et utilisée dans le langage courant.","hu":"Egy nomen, amely egy személy megnevezése természetes nyelven és közbeszédben használt kifejezéssel.","it":"Denominazione di persona in linguaggio naturale e frasi usate nel discorso comune.","lv":"Personas apzīmējums dabiskajā valodā, ko izmanto savstarpējā saziņā.","nl":"Een nomen dat is een benaming van persoon in natuurlijke taal en formulering gebruikt in alledaags taalgebruik.","no":"En betegnelse for person på et naturlig språk og med frasering brukt i alminnelig diskurs.","tr":"Doğal dilde ve ortak söylemde kullanılan ifadelerde bir kişinin unvanı olan bir isim.","zh-Hans-CN":"作为用自然语言和普通话语措词表达的个人的称谓的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
