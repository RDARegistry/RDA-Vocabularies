                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/photographerOfExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50190", "lexicalAlias":"http://rdaregistry.info/Elements/a/photographerAgentOfWorkOf.en", "label":"is photographer agent of work of"}],"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50451", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorToAggregatedContentOf.en", "label":"is contributor to aggregated content of (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50272", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/photographerOfExpressionOf.en", "label":"is photographer of expression of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50272", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/photographerOfExpressionOf.en", "label":"is photographer of expression of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50387","label":{"ar":"له مجال نشاط وكيل","ca":"té com a camp d’activitat d’un agent","cs":"má oblast působnosti agenta","da":"har virkefelt for agent","de":"hat Betätigungsfeld eines Akteurs","de":"hat Betätigungsfeld eines Akteurs","el":"έχει πεδίο δραστηριοποίησης του φορέα","en":"has field of activity of agent","es":"tiene campo de actividad del agente","et":"tegija tegevusala","fi":"toimijan toiminta-ala","fr":"a pour domaine d’activité d’un agent","hu":"ágens tevékenységi köre a következő:","it":"ha come campo di attività di agente","lv":"aģenta darbības joma","nl":"heeft veld van activiteit van actor","no":"har virksomhetsområde for agent","tr":"temsilcinin faaliyet alanı ile ilişkilidir","zh-Hans-CN":"有行为者的活跃领域"},"definition":{"ar":["يربط وكيلا بمجال العمل والخبرة، الخ، الذي يمارسه الوكيل"],"ca":["Relaciona un agent amb un camp d’acció, àrea d’experiència, etc., al qual es dedica un agent."],"cs":["Vztahuje agenta k oblasti činnosti, oboru odbornosti atd., ve kterých agent působí."],"da":["Relaterer en agent til et indsatsområde, ekspertiseområde osv., inden for hvilket en agent er engageret."],"de":["Setzt einen Akteur in Beziehung zu einem Tätigkeitsfeld, einem Wissensgebiet und so weiter, in dem ein Akteur aktiv ist.,Setzt einen Akteur in Beziehung zu einem Tätigkeitsfeld, einem Wissensgebiet und so weiter, in dem ein Akteur aktiv ist."],"en":["Relates an agent to a field of endeavor, area of expertise, etc., in which an agent is engaged."],"es":["Relaciona a un agente con un campo de actividad, área de especialización, etc., en la que un agente está involucrado."],"et":["Seostab tegija tegevus- või erialaga, millega tegija tegeleb või on tegelnud."],"fi":["Liittää toimijan alaan, jolla toimija toimii tai on toiminut, tai jonka asiantuntija tms. hän on."],"fr":["Met un agent en relation avec un champ d’activité, domaine d’expertise, etc. dans lequel un agent évolue."],"hu":["Hozzákapcsol egy ágenst egy tevékenységhez, szakterülethez, illetékességi, stb. területhez, amely iránt az ágens elkötelezett."],"it":["Correla un agente a un campo di impegno, area di competenza, etc. in cui un agente è impegnato."],"lv":["Sasaista aģentu ar aģenta darbības jomu, kurā tas iesaistīts."],"nl":["Relateert een actor aan een veld van inspanning, vakgebied etc. waarbij een actor betrokken is."],"no":["Relaterer en agent til et arbeidsfelt, et ekspertiseområde, etc., som en agent er involvert i."],"tr":["Bir temsilciyi, bir temsilcinin dahil olduğu bir uğraş, çalışma alanı vb. ile ilişkilendirir."],"zh-Hans-CN":["将一个行为者与一个行为者所从事的努力领域、专业范围等关联起来。"]},"ToolkitLabel":{"ar":"له مجال نشاط وكيل","ca":"camp d’activitat d’un agent","cs":"oblast působnosti agenta","da":"virkefelt for agent","de":"Betätigungsfeld eines Akteurs","de":"Betätigungsf