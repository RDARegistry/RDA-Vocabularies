                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/donorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51085", "lexicalAlias":"http://rdaregistry.info/Elements/a/formerOwnerFamilyOf.en", "label":"is former owner family of"},{"@id":"http://rdaregistry.info/Elements/a/P50790", "lexicalAlias":"http://rdaregistry.info/Elements/a/donorCollectiveAgentOf.en", "label":"is donor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51092", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/donorFamilyOf.en", "label":"is donor family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51092", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/donorFamilyOf.en", "label":"is donor family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50639","label":{"ar":"هو شخص متبرع بـ","ca":"és persona donant de","cs":"je dárcem (osobou) (čeho)","da":"er person, som er donor af","de":"ist Person als Stifterin/Stifter von","de":"ist Person als Stifterin/Stifter von","el":"είναι δωρητής φυσικό πρόσωπο του","en":"is donor person of","es":"es persona donante de","et":"annetaja (isik) eksemplarile","fi":"lahjoittaja (henkilö) kappaleelle","fr":"est une personne donatrice de","hu":"adományozó személye a következőnek:","it":"è donatore persona di","lv":"ir ziedotājs (persona)","nl":"is schenker-persoon van","no":"er giver av (person)","tr":"bağışçı kişisidir","zh-Hans-CN":"是……的捐赠者个人"},"definition":{"ar":["يربط شخصا بمفردة يتم التبرع بها إلى مالك آخر شخص."],"ca":["Relaciona una persona amb un ítem que es dona a un altre propietari que és una persona."],"cs":["Vztahuje osobu k jednotce, která byla darována jinému vlastníkovi, jímž je osoba."],"da":["Relaterer en person til et eksemplar, som er doneret til en anden ejer, som er en person."],"de":["Setzt eine Person in Beziehung zu einem Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Person) überlassen wird.,Setzt eine Person in Beziehung zu einem Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Person) überlassen wird."],"en":["Relates a person to an item that is donated to another owner who is a person."],"es":["Relaciona a una persona con un item que es donado a otro propietario el cual es una persona."],"et":["Seostab isiku eksemplariga, mille isik on kinkinud teisele omanikule."],"fi":["Liittää henkilön kappaleeseen, jonka henkilö on lahjoittanut toiselle omistajalle."],"fr":["Met une personne en relation avec un item qui est offert en don à un autre propriétaire qui est une personne."],"hu":["Hozzákapcsol egy személyt egy példányhoz, amelyet egy másik tulajdonos személynek adományoznak."],"it":["Correla una persona a un item donato a un altro proprietario che è una persona."],"lv":["Sasaista personu ar vienību, ko persona ziedojusi citam īpašniekam."],"nl":["Relateert een persoon aan een item dat is geschonken aan een andere eigenaar die een persoon is."],"no":["Relaterer en person til et eksemplar som er gitt til en annen eier som er en person."],"tr":["Bir kişiyi, başka bir şahıs olan sahibine bağışlanmış bir kopyayla ilişkilendirir."],"zh-Hans-CN":["将一个个人与被捐赠给作为个人的另一个拥有者的一个单件关联起来。"]},"ToolkitLabel":{"ar":"شخص متبرع","ca":"persona donant de","cs":"dárce (osoba) (čeho)","da":"person, som er donor af","de":"Person als Stifterin/Stifter von","de":"Person als Stifterin/Stifter von","el":"δωρητής φυσικό πρόσωπο του","en":"donor person of","es":"persona donante de","et":"annetaja (isik) eksemplarile","fi":"lahjoittaja (henkilö) kappaleelle","fr":"personne donatrice de","hu":"adományozó személye:","it":"donatore persona di","lv":"ir ziedotājs (persona)","nl":"schenker-persoon van","no":"giver av (person)","tr":"bağışçı","zh-Hans-CN":"……的捐赠者个人"},"ToolkitDefinition":{"ar":"مفردة يتم التبرع بها إلى مالك آخر شخص.","ca":"Ítem que es dona a un altre propietari que és una persona.","cs":"Jednotka, která byla darována jinému vlastníkovi, jímž je osoba.","da":"Eksemplar, som er doneret til en anden ejer, som er en person.","de":"Ein Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Person) überlassen wird.","de":"Ein Exemplar, das einer anderen Eigentümerin/einem anderen Eigentümer (Person) überlassen wird.","en":"An item that is donated to another owner who is a person.","es":"Un item que es donado a otro propietario el cual es una persona.","et":"Eksemplar, mille isik on kinkinud teisele omanikule.","fi":"Kappale, jonka henkilö on lahjoittanut toiselle omistajalle.","fr":"Item qui est offert en don à un autre propriétaire qui est une personne.","hu":"Egy példány, amelyet egy másik tulajdonos személynek adományoznak.","it":"Item donato a un altro proprietario che è una persona.","lv":"Vienība, ko persona ziedojusi citam īpašniekam.","nl":"Een item dat is gedoneerd aan een andere eigenaar die een persoon is.","no":"Et eksemplar som er gitt til en annen eier som er en person.","tr":"Bir kişi olan başka bir mülk sahibine bağışlanan bir kopya.","zh-Hans-CN":"被捐赠给作为个人的另一个拥有者的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/donorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50632", "lexicalAlias":"http://rdaregistry.info/Elements/a/formerOwnerPersonOf.en", "label":"is former owner person of"},{"@id":"http://rdaregistry.info/Elements/a/P50066", "lexicalAlias":"http://rdaregistry.info/Elements/a/donorAgentOf.en", "label":"is donor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50639", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/donorPersonOf.en", "label":"is donor person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50639", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/donorPersonOf.en", "label":"is donor person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50141","label":{"ar":"هو وكيل رسام هندسي لـ","ca":"és agent delineant de","cs":"je technickým kresličem (agentem) (čeho)","da":"er agent, som er teknisk tegner af","de":"ist Akteur als Technische Zeichnerin/Technischer Zeichner von","de":"ist Akteur als Technische Zeichnerin/Technischer Zeichner von","el":"είναι σχεδιαστής φορέας του","en":"is draftsman agent of","es":"es agente delineante de","et":"joonestaja (tegija) väljenduses","fi":"piirtäjä (toimija) ekspressiossa","fr":"est un agent dessinateur industriel de","hu":"műszaki rajzoló ágense a következőnek:","it":"è disegnatore industriale agente di","lv":"ir rasētājs (aģents)","nl":"is technisch tekenaar-actor van","no":"er teknisk tegner av (agent)","tr":"teknik ressam temsilcisidir","zh-Hans-CN":"是……的绘图者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في وضع خطط أو رسومات مفصلة للمباني والسفن والطائرات والآلات والأشياء، إلخ."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent elaborant plànols o dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes, etc."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů atd."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου ενός αρχιτέκτονα, εφευρέτη κ.λπ. δημιουργώντας λεπτομερή σχέδια ή σκίτσα κτηρίων, πλοίων, αεροσκαφών, μηχανών, αντικειμένων κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de realizar planos o dibujos detallados para edificios, barcos, aviones, máquinas, objetos, etc."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tms."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à effectuer des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets, etc."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését épületek, hajók, repülőgépek, gépek, objektumok, stb. részletes terveinek vagy rajzainak elkészítésében."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nel fare progetti o disegni dettagliati per edifici, navi, aerei, macchine, oggetti, etc."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, izstrādājot ēku, kuģu, lidmašīnu, mašīnu, objektu utt. detalizētus plānus vai rasējumus."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen etc."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc."],"tr":["Bir temsilciyi, binalar, gemiler, uçaklar, makineler, nesneler vb. için ayrıntılı planlar veya çizimler yapan bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括为建筑物、船舶、飞行器、机械装置、物体等制作详细平面图或绘制草图的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل رسام هندسي","ca":"agent delineant de","cs":"technický kreslič (agent) (čeho)","da":"agent, som er teknisk tegner af","de":"Akteur als Technische Zeichnerin/Technischer Zeichner von","de":"Akteur als Technische Zeichnerin/Technischer Zeichner von","el":"σχεδιαστής φορέας του","en":"draftsman agent of","es":"agente delineante de","et":"joonestaja (tegija) väljenduses","fi":"piirtäjä (toimija) ekspressiossa","fr":"agent dessinateur industriel de","hu":"műszaki rajzoló ágense:","it":"disegnatore industriale agente di","lv":"ir rasētājs (aģents)","nl":"technisch tekenaar-actor van","no":"teknisk tegner av (agent)","tr":"tasarımcı temsilci","zh-Hans-CN":"……的绘图者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في وضع خطط أو رسومات مفصلة للمباني والسفن والطائرات والآلات والأشياء، إلخ.","ca":"Expressió que inclou una contribució d’un agent elaborant plànols o dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes, etc.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů atd.","da":"Udtryk, som omfatter en agents bidrag ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.","el":"Mια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά ενός αρχιτέκτονα, εφευρέτη κ.λπ. μέσω της δημιουργίας λεπτομερών σχεδίων ή σκίτσων κτηρίων, πλοίων, αεροσκαφών, μηχανών, αντικειμένων κ.λπ.","en":"An expression that includes a contribution by an agent of making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc.","es":"Una expresión que incluye una contribución de un agente de realizar planos o dibujos detallados para edificios, barcos, aviones, máquinas, objetos, etc.","et":"Väljendus, millesse tegija on andnud panuse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tms.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à effectuer des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését épületek, hajók, repülőgépek, gépek, objektumok, stb. részletes terveinek vagy rajzainak elkészítésében.","it":"Espressione che include un contributo da parte di un agente nel fare progetti o disegni dettagliati per edifici, navi, aerei, macchine, oggetti, etc.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, izstrādājot ēku, kuģu, lidmašīnu, mašīnu, objektu utt. detalizētus plānus vai rasējumus.","nl":"Een expressie die omvat een bijdrage door een actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen etc.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc.","tr":"Binalar, gemiler, uçaklar, makineler, nesneler vb. için ayrıntılı planlar veya çizimler yapan bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为建筑物、船舶、飞行器、机械装置、物体等制作详细平面图或绘制草图的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["رسام هندسي لـ"],"ca":["delineant de"],"cs":["technický kreslič (čeho)"],"da":["teknisk tegner af"],"de":["Technischer Zeichner von,Technischer Zeichner von"],"el":["σχεδιαστής του"],"en":["draftsman of"],"es":["delineante de"],"et":["joonestaja väljenduses"],"fi":["tekninen piirros"],"fr":["dessinateur industriel de"],"hu":["műszaki rajzolója a következő:"],"it":["disegnatore industriale di"],"nl":["technisch tekenaar van"],"no":["teknisk tegner av"],"tr":["tasarımcı"],"zh-Hans-CN":["……的绘图者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50448", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToAmalgamationOf.en", "label":"is contributor agent to amalgamation of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/draftsmanAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50745", "lexicalAlias":"http://rdaregistry.info/Elements/a/draftsmanCollectiveAgentOf.en", "label":"is draftsman collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50594", "lexicalAlias":"http://rdaregistry.info/Elements/a/draftsmanPersonOf.en", "label":"is draftsman person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50141", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/draftsmanAgentOf.en", "label":"is draftsman agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50141", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/draftsmanAgentOf.en", "label":"is draftsman agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50745","label":{"ar":"هو وكيل جماعي رسام هندسي لـ","ca":"és agent col·lectiu delineant de","cs":"je technickým kresličem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er teknisk tegner af","de":"ist gemeinschaftlicher Akteur als Technische Zeichnerin/Technischer Zeichner von","de":"ist gemeinschaftlicher Akteur als Technische Zeichnerin/Technischer Zeichner von","el":"είναι σχεδιαστής συλλογικός φορέας του","en":"is draftsman collective agent of","es":"es agente colectivo delineante de","et":"joonestaja (kollektiiv) väljenduses","fi":"piirtäjä (yhteistoimija) ekspressiossa","fr":"est un agent collectif dessinateur industriel de","hu":"műszaki rajzoló kollektív ágense a következőnek:","it":"è disegnatore industriale agente collettivo di","lv":"ir rasētājs (grupa)","nl":"is technisch tekenaar-collectieve actor van","no":"er teknisk tegner for (kollektiv agent)","tr":"teknik ressam kolektif temsilcisidir","zh-Hans-CN":"是……的绘图者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في وضع خطط أو رسومات مفصلة للمباني والسفن والطائرات والآلات والأشياء، إلخ."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu elaborant plànols o dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes, etc."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů atd."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de realizar planos o dibujos detallados para edificios, barcos, aviones, máquinas, objetos, etc."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele."],"fi":["Liittää yhteistoimijan ekspressioon, jonka tekemisessä yhteistoimija on osallisena tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tms."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à effectuer des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets, etc."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését épületek, hajók, repülőgépek, gépek, objektumok, stb. részletes terveinek vagy rajzainak elkészítésében."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nel fare progetti o disegni dettagliati per edifici, navi, aerei, macchine, oggetti, etc."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, izstrādājot ēku, kuģu, lidmašīnu, mašīnu, objektu utt. detalizētus plānus vai rasējumus."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen etc."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc."],"tr":["Kolektif bir temsilciyi, binalar, gemiler, uçaklar, makineler, nesneler vb. için ayrıntılı planlar veya çizimler yapmaya kolektif bir temsilcinin katkısını içeren bir anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括为建筑物、船舶、飞行器、机械装置、物体等制作详细平面图或绘制草图的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي رسام هندسي","ca":"agent col·lectiu delineant de","cs":"technický kreslič (kolektivní agent) (čeho)","da":"kollektiv agent, som er teknisk tegner af","de":"Gemeinschaftlicher Akteur als Technische Zeichnerin/Technischer Zeichner von","de":"Gemeinschaftlicher Akteur als Technische Zeichnerin/Technischer Zeichner von","el":"σχεδιαστής συλλογικός φορέας του","en":"draftsman collective agent of","es":"agente colectivo delineante de","et":"joonestaja (kollektiiv) väljenduses","fi":"piirtäjä (yhteistoimija) ekspressiossa","fr":"agent collectif dessinateur industriel de","hu":"műszaki rajzoló kollektív ágense:","it":"disegnatore industriale agente collettivo di","lv":"ir rasētājs (grupa)","nl":"technisch tekenaar-collectieve actor van","no":"teknisk tegner for (kollektiv agent)","tr":"tasarımcı kolektif temsilci","zh-Hans-CN":"……的绘图者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في وضع خطط أو رسومات مفصلة للمباني والسفن والطائرات والآلات والأشياء، إلخ.","ca":"Expressió que inclou una contribució d’un agent col·lectiu elaborant plànols o dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes, etc.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů atd.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.","en":"An expression that includes a contribution by a collective agent of making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc.","es":"Una expresión que incluye una contribución de un agente colectivo de realizar planos o dibujos detallados para edificios, barcos, aviones, máquinas, objetos, etc.","et":"Väljendus, millesse kollektiiv on andnud panuse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele.","fi":"Ekspressio, jonka tekemisessä yhteistoimija on osallisena tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tms.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à effectuer des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését épületek, hajók, repülőgépek, gépek, objektumok, stb. részletes terveinek vagy rajzainak elkészítésében.","it":"Espressione che comprende un contributo di un agente collettivo nel fare progetti o disegni dettagliati per edifici, navi, aerei, macchine, oggetti, etc.","lv":"Izteiksme, kas ietver grupas ieguldījumu, izstrādājot ēku, kuģu, lidmašīnu, mašīnu, objektu utt. detalizētus plānus vai rasējumus.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen etc.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc.","tr":"Binalar, gemiler, uçaklar, makineler, nesneler vb. için ayrıntılı plan veya çizimler yapan kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为建筑物、船舶、飞行器、机械装置、物体等制作详细平面图或绘制草图的一个集体行为者的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
