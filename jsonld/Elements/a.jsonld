                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50204", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfWorkOf.en", "label":"is creator agent of work of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/authorAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50692", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorCollectiveAgentOf.en", "label":"is author collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50541", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorPersonOf.en", "label":"is author person of"},{"@id":"http://rdaregistry.info/Elements/a/P50225", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistAgentOf.en", "label":"is librettist agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50224", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistAgentOf.en", "label":"is lyricist agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50248", "lexicalAlias":"http://rdaregistry.info/Elements/a/rapporteurAgentOf.en", "label":"is rapporteur agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50223", "lexicalAlias":"http://rdaregistry.info/Elements/a/screenwriterAgentOf.en", "label":"is screenwriter agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/authorAgentOf.en", "label":"is author agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/authorAgentOf.en", "label":"is author agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50692","label":{"ar":"هو وكيل جماعي مؤلف لـ","ca":"és agent col·lectiu autor de","cs":"je autorem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er forfatter af","de":"ist gemeinschaftlicher Akteur als Verfasserin/Verfasser von","de":"ist gemeinschaftlicher Akteur als Verfasserin/Verfasser von","el":"είναι συγγραφέας συλλογικός φορέας του","en":"is author collective agent of","es":"es agente colectivo autor de","fi":"kirjoittaja (yhteistoimija) teoksessa","fr":"est un agent collectif auteur de","hu":"szerző kollektív ágense a következőnek:","it":"è autore agente collettivo di","lv":"ir autors (grupa)","nl":"is auteur-collectieve actor van","no":"er forfatter av (kollektiv agent)","tr":"yazar kolektif temsilcisidir","zh-Hans-CN":"是……的著者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن إنشاء عمل نصي."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la creació d’una obra textual."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za vytvoření textového díla."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at skabe et tekstværk."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines textlichen Werks verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines textlichen Werks verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for creating a textual work."],"es":["Relaciona un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de crear una obra textual."],"fi":["Liittää yhteistoimijan tekstiteokseen, jonka luomisesta yhteistoimija on vastuussa."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à créer une œuvre textuelle."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy szöveges mű létrehozásáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per la creazione di un'opera testuale."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par tekstuāla darba radīšanu."],"nl":["Relateert een collectieve actor aan een werk met zich meebrengt een verantwoordelijkheid van een collectieve actor voor creëren van een tekstwerk."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å skape et tekstlig verk."],"tr":["Kolektif bir temsilciyi, bir metinsel çalışma yapmakla görevli kolektif temsilcinin sorumluluğunu içeren bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及创作一种文字作品的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مؤلف","ca":"agent col·lectiu autor de","cs":"autor (kolektivní agent) (čeho)","da":"kollektiv agent, som er forfatter af","de":"Gemeinschaftlicher Akteur als Verfasserin/Verfasser von","de":"Gemeinschaftlicher Akteur als Verfasserin/Verfasser von","el":"συγγραφέας συλλογικός φορέας του","en":"author collective agent of","es":"agente colectivo autor de","fi":"kirjoittaja (yhteistoimija) teoksessa","fr":"agent collectif auteur de","hu":"szerző kollektív ágense:","it":"autore agente collettivo di","lv":"ir autors (grupa)","nl":"auteur-collectieve actor van","no":"forfatter av (kollektiv agent)","tr":"yazar kolektif temsilcisi","zh-Hans-CN":"……的著者集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن إنشاء عمل نصي.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en la creació d’una obra textual.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za vytvoření textového díla.","da":"Værk, som involverer en kollektiv agents ansvar for at skabe et tekstværk.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Schaffung eines textlichen Werks verantwortlich ist.","de":"