                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50693", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCollectiveAgentOfWorkOf.en", "label":"is creator collective agent of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50453", "lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorAgentOf.en", "label":"is aggregator agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50830", "lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorCorporateBodyOf.en", "label":"is aggregator corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50981", "lexicalAlias":"http://rdaregistry.info/Elements/a/aggregatorFamilyOf.en", "label":"is aggregator family of"},{"@id":"http://rdaregistry.info/Elements/a/P50711", "lexicalAlias":"http://rdaregistry.info/Elements/a/compilerCollectiveAgentOf.en", "label":"is compiler collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50679", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/aggregatorCollectiveAgentOf.en", "label":"is aggregator collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50679", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/aggregatorCollectiveAgentOf.en", "label":"is aggregator collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50830","label":{"ar":"هي هيئة مُجمعة لـ","ca":"és entitat corporativa agregadora de","cs":"je agregátorem (korporací) (čeho)","da":"er korporation, som er samler af","de":"ist Körperschaft als Aggregatorin/Aggregator von","de":"ist Körperschaft als Aggregatorin/Aggregator von","el":"είναι ερανιστής συλλογικό όργανο του","en":"is aggregator corporate body of","es":"es organismo corporativo agregador de","et":"liitja (asutus) teoses","fi":"aggregaattori (yhteisö) teoksessa","fr":"est une collectivité agrégatrice de","hu":"aggregátor testülete a következőnek:","it":"è aggregatore ente di","lv":"ir apkopotājs (institūcija)","nl":"is aggregator-corporatie van","no":"er aggregator av (korporasjon)","tr":"toplayıcı tüzel kişisidir","zh-Hans-CN":"是……的合集编者团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن التجميع من خلال اختيار تعبيرات الأعمال الأخرى وترتيبها."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en l’agregació mitjançant la selecció i l’arranjament d’expressions d’altres obres."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za agregaci výběrem a uspořádáním vyjádření jiných děl."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for sammenlægning ved at udvælge og arrangere udtryk af andre værk."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Aggregation verantwortlich ist, indem sie Expressionen von anderen Werken auswählt und zusammenstellt.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Aggregation verantwortlich ist, indem sie Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for aggregation by selecting and arranging expressions of other works."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad de un organismo corporativo de agregado al seleccionar y organizar expresiones de otras obras."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust liitumi loomise eest, valides ja korrastades teiste teoste väljendused."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité en ce qui concerne l’agrégation par la sélection et l’arrangement d’expressions d’autres œuvres."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége más művek kifejezési formáinak kiválasztásával és elrendezésével járó aggregálásáért."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente per l'aggregazione selezionando e organizzando espressioni di altre opere."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par apkopošanu, atlasot un sakārtojot citu darbu izteiksmes."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor aggregeren door middel van selectie en arrangeren van expressies van andere werken."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av aggregering gjennom å velge ut og arrangere uttrykk av andre verk."],"tr":["Bir tüzel kişiyi, diğer işlerin ifadelerini seçerek ve düzenleyerek birleştirme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及把其他作品的内容表达选择和整理后编制合集的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة مُجمعة لـ","ca":"entitat corporativa agregadora de","cs":"agregátor (korporace) (čeho)","da":"korporation, som er samler af","de":"Körperschaft als Aggregatorin/Aggregator von","de":"Körperschaft als Aggregatorin/Aggregator von","el":"ερανιστής συλλογικό όργανο του ?","en":"aggregator corporate body of","es":"Una obra que involucra una responsabilidad de un organismo corporativo de agregado al seleccionar y organizar expresiones de otras obras.","et":"liitja (asutus) teoses","fi":"aggregaattori (yhteisö) teoksessa","fr":"collectivité agrégatrice de","hu":"aggregátor testülete:","it":"aggregatore ente di","lv":"ir apkopotājs (institūcija)","nl":"ag