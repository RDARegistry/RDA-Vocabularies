                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/instructorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50905", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerCorporateBodyOf.en", "label":"is performer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50770", "lexicalAlias":"http://rdaregistry.info/Elements/a/instructorCollectiveAgentOf.en", "label":"is instructor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50921", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/instructorCorporateBodyOf.en", "label":"is instructor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50921", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/instructorCorporateBodyOf.en", "label":"is instructor corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51072","label":{"ar":"هي عائلة محاضِرة لـ","ca":"és família instructora de","cs":"je instruktorem (rodinou) (čeho)","da":"er familie, som er instruktør af","de":"ist Familie als Ausbilderin/Ausbilder von","de":"ist Familie als Ausbilderin/Ausbilder von","el":"είναι εκπαιδευτής οικογένεια του","en":"is instructor family of","es":"es familia instructora de","et":"instruktor (perekond) väljenduses","fi":"opettaja (suku) ekspressiossa","fr":"est une famille enseignante de","hu":"oktató családja a következőnek:","it":"è istruttore famiglia di","lv":"ir instruktors (dzimta/ģimene)","nl":"is instructeur-familie van","no":"er instruktør for (familie)","tr":"eğitmen ailesidir","zh-Hans-CN":"是……的授课者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة التدريس أو تقديم عرض توضيحي."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família ensenyant o proporcionant una demostració."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že učí nebo provádí demonstraci."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at undervise eller ved at give en demonstration."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie unterrichtet oder etwas demonstriert.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie unterrichtet oder etwas demonstriert."],"en":["Relates a family to an expression that includes a contribution by a family of teaching or providing a demonstration."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de enseñar o proveer una demostración."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, õpetades või ette näidates."],"fi":["Liittää suvun ekspressioon, jonka tekemisessä suku on osallisena opettamalla tai esittelemällä."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à enseigner ou à faire une démonstration."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy tanító vagy szemléltetést tartó család közreműködését."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nell'insegnamento o offerta di una dimostrazione."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, mācot vai demonstrējot."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door onderwijzen of verschaffen van een demonstratie."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å gi instruksjoner eller en demonstrasjon."],"tr":["Bir aileyi, bir ailenin öğretme veya gösteri yapma katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括有教学或提供演示的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة محاضِرة","ca":"família instructora de","cs":"instruktor (rodina) (čeho)","da":"familie, som er instruktør af","de":"Familie als Ausbilderin/Ausbilder von","de":"Familie als Ausbilderin/Ausbilder von","el":"εκπαιδευτής οικογένεια του","en":"instructor family of","es":"familia instructora de","et":"instruktor (perekond) väljenduses","fi":"opettaja (suku) ekspressiossa","fr":"famille enseignante de","hu":"oktató családja:","it":"istruttore famiglia di","lv":"ir instruktors (dzimta/ģimene)","nl":"instructeur-familie van","no":"instruktør for (familie)","tr":"eğitmen ailesidir","zh-Hans-CN":"……的授课者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة التدريس أو تقديم عرض توضيحي.","ca":"Expressió que inclou una contribució d’una família ensenyant o proporcionant una demostració.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že učí nebo provádí demonstraci.","da":"Udtryk, som omfatter en families bidrag ved at undervise eller ved at give en demonstration.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie unterrichtet oder etwas demonstriert.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie unterrichtet oder etwas demonstriert.","en":"An expression that includes a contribution by a family of teaching or providing a demonstration.","es":"Una expresión que incluye una contribución de una familia de enseñar o proveer una demostración.","et":"Väljendus, millesse perekond on andnud panuse, õpetades või ette näidates.","fi":"Ekspressio, jonka tekemisessä suku on osallisena opettamalla tai esittelemällä.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à enseigner ou à faire une démonstration.","hu":"Egy kifejezési forma, amely magában foglalja egy tanító vagy szemléltetést tartó család közreműködését.","it":"Espressione che comprende un contributo di una famiglia nell'insegnamento o offerta di una dimostrazione.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, mācot vai demonstrējot.","nl":"Een expressie die omvat een bijdrage door een familie door onderwijzen of verschaffen van een demonstratie.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å gi instruksjoner eller en demonstrasjon.","tr":"Bir gösteriyi öğreten ya da temin eden bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括有教学或提供演示的一个家族的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
