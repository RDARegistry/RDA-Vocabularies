                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/dateAssociatedWithPerson.en","instructionNumber":"9.3","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50347", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedTimespanOfPerson.en", "label":"has related timespan of person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50107", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/dateAssociatedWithPerson.en", "label":"has date associated with person (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50107", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/dateAssociatedWithPerson.en", "label":"has date associated with person (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50108","label":{"ca":"té com a altra designació associada amb una persona","da":"har forklarende tilføjelse til person","de":"hat sonstige zur Person gehörende Kennzeichnung","el":"έχει άλλον προσδιορισμό συνδεδεμένο με το φυσικό πρόσωπο","en":"has other designation associated with person (Deprecated)","fi":"muu henkilöön liittyvä määrite","fr":"a pour autre désignation associée à une personne","hu":"van személlyel kapcsolatos másik elnevezése","sv":"har övrig beteckning förknippad med personen"},"definition":{"ca":["Relaciona una persona amb un terme, diferent d’un títol, que s’associa amb el nom d’una persona."],"da":["Relaterer en person til en tilføjelse, bortset fra en titel, der er knyttet til en persons navn."],"de":["Setzt eine Person mit einem Terminus, der kein Titel ist, der mit dem Namen einer Person in Verbindung steht, in Beziehung."],"el":["Συνδέει ένα φυσικό πρόσωπο με έναν όρο άλλον από τον τίτλο, ο οποίος συνδέεται με το όνομα ενός φυσικού προσώπου."],"en":["Relates a person to a term other than a term of rank, honour, or office that is associated with a person. (Deprecated)"],"fi":["Liittää henkilön henkilöön liitettyyn muuhun määritteeseen kuin arvonimeen."],"fr":["Met une personne en relation avec un terme, autre qu’un titre, associé à une personne."],"hu":["Egy személyt hozzákapcsol egy kifejezéshez, ami nem cím, amely kötődik egy személy nevéhez."]},"ToolkitLabel":{"ca":"altra designació associada amb una persona","da":"forklarende tilføjelse til person","de":"Sonstige zur Person gehörende Kennzeichnung","el":"άλλος προσδιορισμός συνδεδεμένος με το φυσικό πρόσωπο","en":"other designation associated with person (Deprecated)","es":"otra designación asociada con la persona","fi":"muu henkilöön liittyvä määrite","fr":"autre désignation associée à une personne","hu":"személlyel kapcsolatos másik megjelölés","no":"annen betegnelse som forbindes med person","sv":"övrig beteckning förknippad med personen"},"ToolkitDefinition":{"ca":"Terme, diferent d’un títol, que s’associa amb una persona.","da":"Tilføjelse, bortset fra en titel, der er knyttet til en persons navn.","de":"Ein Terminus, der kein Titel ist, der mit dem Namen einer Person in Verbindung steht.","el":"Ένας όρος άλλος από τον τίτλο, ο οποίος συνδέεται με τον όνομα ενός φυσικού προσώπου.","en":"A term other than a term of rank, honour, or office that is associated with a person. (Deprecated)","es":"Un término diferente de un título que está asociado con el nombre de la persona.","fi":"Henkilöön liitetty muu määrite kuin arvonimi.","fr":"Terme, autre qu’un titre, associé à une personne.","hu":"Egy személyhez kötődő kifejezés, amely más, mint egy cím.","no":"En annen type betegnelse enn tittel som forbindes med en person."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/otherDesignationAssociatedWithPerson.en","instructionNumber":"9.6","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/datatype/P50108", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/otherDesignationAssociatedWithPerson.en", "label":"has other designation associated with person (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50097","label":{"ar":"له بلد مرتبط بشخص","ca":"té com a país associat amb una persona","cs":"má zemi související s osobou","da":"har land knyttet til person","de":"hat Land, das mit einer Person in Verbindung steht","de":"hat Land, das mit einer Person in Verbindung steht","el":"έχει χώρα σχετική με το φυσικό πρόσωπο","en":"has country associated with person","es":"tiene país asociado con persona","et":"isikuga seotud maa","fi":"henkilöön liittyvä maa","fr":"a pour pays associé à une personne","hu":"személyhez kapcsolódó ország a következő:","it":"ha come paese associato a persona","lv":"ar personu saistītā valsts","nl":"heeft land geassocieerd met persoon","no":"har land som forbindes med person","sv":"har land förknippat med personen","tr":"kişiyle bağlantılı olan ülke ile ilişkilidir","zh-Hans-CN":"有与个人相关的国家"},"definition":{"ar":["يربط شخصا ببلد يُستدل به على شخص"],"ca":["Relaciona una persona amb un lloc que és un país amb el qual s’identifica una persona."],"cs":["Vztahuje osobu k místu, které je zemí, se kterou je osoba identifikována."],"da":["Relaterer en person til et land, som en person forbindes med."],"de":["Setzt eine Person in Beziehung zu einem Land, mit dem eine Person identifiziert wird.,Setzt eine Person in Beziehung zu einem Land, mit dem eine Person identifiziert wird."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια χώρα με την οποία ένα φυσικό πρόσωπο ταυτίζεται."],"en":["Relates a person to a place that is a country with which a person is identified."],"es":["Relaciona una persona con un lugar que es un país con el que se identifica a una persona."],"et":["Seostab isiku maaga, millega isik on lahutamatult seotud."],"fi":["Liittää henkilön maahan, joka yhdistetään henkilöön."],"fr":["Met une personne en relation avec un lieu qui consiste en un pays auquel une personne est associée."],"hu":["Hozzákapcsol egy személyt egy országhoz, amellyel egy személyt azonosítanak."],"it":["Correla una persona a un paese con il quale una persona è identificata."],"lv":["Sasaista personu ar valsti, ar kuru persona saistīta."],"nl":["Relateert een persoon aan een land waarmee een persoon geïdentificeerd wordt."],"no":["Relaterer en person til et land som en person identifiseres med."],"tr":["Bir kişiyi, o kişinin özdeşleştiği bir ülke olan bir yerle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个作为一个个人标识的国家的地点关联起来。"]},"ToolkitLabel":{"ar":"بلد مرتبط بشخص","ca":"país associat amb una persona","cs":"země související s osobou","da":"land knyttet til personen","de":"Land, das mit einer Person in Verbindung steht","de":"Land, das mit einer Person in Verbindung steht","el":"χώρα σχετική με το φυσικό πρόσωπο","en":"country associated with person","es":"país asociado con persona","et":"isikuga seotud maa","fi":"henkilöön liittyvä maa","fr":"pays associé à une personne","hu":"személyhez kapcsolódó ország:","it":"nazione associata a una persona","lv":"ar personu saistītā valsts","nl":"land geassocieerd met persoon","no":"land som forbindes med person","sv":"land förknippat med personen","tr":"kişiyle bağlantılı ülke","zh-Hans-CN":"与个人相关的国家"},"ToolkitDefinition":{"ar":"بلد يُستدل به على شخص.","ca":"Lloc que és un país amb el qual s’identifica una persona.","cs":"Místo, které je zemí, se kterou je osoba identifikována.","da":"Land, som en person forbindes med.","de":"Ein Land, mit dem eine Person identifiziert wird.","de":"Ein Land, mit dem eine Person identifiziert wird.","el":"Μια χώρα με την οποία ένα φυσικό πρόσωπο ταυτίζεται.","en":"A place that is a country with which a person is identified.","es":"Un lugar que es un país con el que se identifica a una persona.","et":"Maa, millega isik on lahutamatult seotud.","fi":"Maa, joka yhdistetään henkilöön.","fr":"Lieu qui consiste en un pays auquel une personne est associée.","hu":"Egy ország, amellyel egy személyt azonosítanak.","it":"Paese con il quale una persona è identificata.","lv":"Valsts, ar kuru persona saistīta.","nl":"Een land waarmee een persoon geïdentificeerd wordt.","no":"Et land som en person identifiseres med.","tr":"Bir kişinin özdeşleştiği bir ülke olan bir yer.","zh-Hans-CN":"作为一个个人标识的国家的地点"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
