                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/makeupArtistCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50925", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCorporateBodyToPerformanceOf.en", "label":"is contributor corporate body to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50723", "lexicalAlias":"http://rdaregistry.info/Elements/a/makeupArtistCollectiveAgentOf.en", "label":"is makeup artist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50874", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/makeupArtistCorporateBodyOf.en", "label":"is makeup artist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50874", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/makeupArtistCorporateBodyOf.en", "label":"is makeup artist corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51025","label":{"ar":"هي عائلة فنانة مكياج لـ","ca":"és família maquilladora de","cs":"je maskérem (rodinou) (čeho)","da":"er familie, som er sminkør af","de":"ist Familie als Maskenbildnerin/Maskenbildner von","de":"ist Familie als Maskenbildnerin/Maskenbildner von","el":"είναι ψιμυθιολόγος οικογένεια του","en":"is makeup artist family of","es":"es familia maquillista de","et":"grimmikunstnik (perekond) väljenduses","fi":"maskeeraaja (suku) ekspressiossa","fr":"est une famille maquilleuse de","hu":"sminkmester családja a következőnek:","it":"è truccatore famiglia di","lv":"ir grima mākslinieks (dzimta/ģimene)","nl":"is make-upartiest-familie van","no":"er sminkør for (familie)","tr":"makyaj sanatçısı ailesidir","zh-Hans-CN":"是……的化妆艺术家家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في وضع مكياج أو أطراف صناعية في إنتاج صور متحركة أو في عرض موسيقي أو درامي أو ترفيهي."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família aplicant maquillatge i pròtesis en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že aplikuje make-up a protetiku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at lægge makeup og påsætte proteser til en levende billedproduktion eller til en musikalsk eller dramatisk præsentation eller til underholdning."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie Schminke und Prothetik für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung aufträgt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie Schminke und Prothetik für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung aufträgt."],"en":["Relates a family to an expression that includes a contribution by a family of applying makeup and prosthetics for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de aplicar maquillaje y prótesis para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramático."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, tehes grimmi ja proteesgrimmi filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää suvun ekspressioon, jossa suku on osallisena vastaamalla elokuvan, musikaalin tai näyttämöteoksen maskeerauksesta."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à appliquer du maquillage et des prothèses pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését makeup és protézisek alkalmazásában mozgókép-produkcióhoz, zenei vagy drámai előadáshoz vagy szórakoztató műsorhoz."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nell'applicazione di trucco e protesi per una produzione di immagini in movimento o per una presentazione o spettacolo musicale o drammatico."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, pielietojot dekoratīvo kosmētiku un protezēšanu filmu veidošanā, mūzikas vai dramatiskā uzvedumā vai izklaides pasākumā."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door aanbrengen van make-up en protheses voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å bruke sminke og proteser for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning."],"tr":["Bir aileyi, hareketli bir görüntü prodüksiyonu veya müzikal ya da dramatik bir sunum veya eğlence için makyaj ve protez uygulama katkısını içeren bir anlayımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括为动态图像制作或者为音乐或戏剧呈现或娱乐施加化妆品或假体的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة فنانة مكياج","ca":"família maquilladora de","cs":"maskér (rodina) (čeho)","da":"familie, som er sminkør af","de":"Familie als Maskenbildnerin/Maskenbildner von","de":"Familie als Maskenbildnerin/Maskenbildner von","el":"ψιμυθιολόγος οικογένεια του","en":"makeup artist family of","es":"familia maquillista de","et":"grimmikunstnik (perekond) väljenduses","f