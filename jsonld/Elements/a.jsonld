                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50870", "lexicalAlias":"http://rdaregistry.info/Elements/a/actorCorporateBodyOf.en", "label":"is actor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50758", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCollectiveAgentOf.en", "label":"is voice actor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50909", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/voiceActorCorporateBodyOf.en", "label":"is voice actor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50909", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/voiceActorCorporateBodyOf.en", "label":"is voice actor corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51060","label":{"ar":"هي عائلة ممثلة صوتية لـ","ca":"és família actriu de veu de","cs":"je hlasovým hercem (rodinou) (čeho)","da":"er familie, som er dubber af","de":"ist Familie als Sprecherin/Sprecher einer Rolle von","de":"ist Familie als Sprecherin/Sprecher einer Rolle von","el":"είναι ηθοποιός φωνής οικογένεια του","en":"is voice actor family of","es":"es familia actriz de voz de","et":"hääle esitaja (perekond) väljenduses","fi":"ääninäyttelijä (suku) ekspressiossa","fr":"est une famille actrice vocale de","hu":"szinkronszínész családja a következőnek:","it":"è doppiatore famiglia di","lv":"ir balss aktieris (dzimta/ģimene)","nl":"is stemacteur-familie van","no":"er stemmeskuespiller for (familie)","tr":"seslendirme sanatçısı ailesidir","zh-Hans-CN":"是……的声音演员家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd"],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht."],"en":["Relates a family to an expression that includes a contribution by a family of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms."],"fi":["Liittää suvun ekspressioon, jossa suku on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc."],"tr":["Bir aileyi, radyo ve televizyon yapımlarındaki karakterlerin ve hareketli görüntü eserlerindeki animasyon karakterlerinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. için bir ailenin seslendirme katkısını anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة ممثلة صوتية","ca":"família actriu de veu de","cs":"hlasový herec (rodina) (čeho)","da":"familie, som er dubber af","de":"Familie als Sprecherin/Sprecher einer Rolle von","de":"Familie als Sprecherin/Sprecher einer Rolle von","el":"ηθοποιός φωνής οικογένεια του","en":"voice actor family of","es":"familia actriz de voz de","et":"hääle esitaja (perekond) väljenduses","fi":"ääninäyttelijä (suku) ekspressiossa","fr":"famille actrice vocale de","hu":"szinkronszínész családja:","it":"doppiatore famiglia di","lv":"ir balss aktieris (dzimta/ģimene)","nl":"stemacteur-familie van","no":"stemmeskuespiller for (familie)","tr":"seslendirme sanatçısı ailesi","zh-Hans-CN":"……的声音演员家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ.","ca":"Expressió que inclou una contribució d’una família prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd","da":"Udtryk, som omfatter en families bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht.","en":"An expression that includes a contribution by a family of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc.","es":"Una expresión que incluye una contribución de una familia de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc.","et":"Väljendus, millesse perekond on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms.","fi":"Ekspressio, jossa suku on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat.","it":"Espressione che comprende un contributo di una famiglia nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml.","nl":"Een expressie die omvat een bijdrage door een familie in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc.","tr":"Radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü işlerindeki animasyon karakterlerinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. için bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个家族的贡献的一种内容表达"},"altLabel":{"de":["Familie als Synchronsprecherin/Synchronsprecher von"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51021", "lexicalAlias":"http://rdaregistry.info/Elements/a/actorFamilyOf.en", "label":"is actor family of"},{"@id":"http://rdaregistry.info/Elements/a/P50758", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCollectiveAgentOf.en", "label":"is voice actor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51060", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/voiceActorFamilyOf.en", "label":"is voice actor family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51060", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/voiceActorFamilyOf.en", "label":"is voice actor family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50607","label":{"ar":"هو شخص ممثل صوتي لـ","ca":"és persona actriu de veu de","cs":"je hlasovým hercem (osobou) (čeho)","da":"er person, som er dubber af","de":"ist Person als Sprecherin/Sprecher einer Rolle von","de":"ist Person als Sprecherin/Sprecher einer Rolle von","el":"είναι ηθοποιός φωνής φυσικό πρόσωπο του","en":"is voice actor person of","es":"es actor de doblaje de","et":"hääle esitaja (isik) väljenduses","fi":"ääninäyttelijä (henkilö) ekspressiossa","fr":"est une personne actrice vocale de","hu":"szinkronszínész személye a következőnek:","it":"è doppiatore persona di","lv":"ir balss aktieris (persona)","nl":"is stemacteur-persoon van","no":"er stemmeskuespiller for (person)","tr":"Seslendirme sanatçısıdır","zh-Hans-CN":"是……的声音演员个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd"],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht."],"en":["Relates a person to an expression that includes a contribution by a person of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc."],"es":["Relaciona a una persona con una expresión que incluye la contribución de una persona de proporcionar la voz a personajes en producciones de radio y audio y a personajes animados en obras de imágenes en movimiento, así como locuciones en comerciales de radio y televisión, expresiones dobladas, etc."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms."],"fi":["Liittää henkilön ekspressioon, jossa henkilö on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált kifejezési formákban stb. hangalámondást szolgáltat."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc."],"tr":["Bir kişiyi, radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü eserlerindeki animasyon karakterlerinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. için bir kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص ممثل صوتي","ca":"persona actriu de veu de","cs":"hlasový herec (osoba) (čeho)","da":"person, som er dubber af","de":"Person als Sprecherin/Sprecher einer Rolle von","de":"Person als Sprecherin/Sprecher einer Rolle von","el":"ηθοποιός φωνής φυσικό πρόσωπο του","en":"voice actor person of","es":"actor de doblaje de","et":"hääle esitaja (isik) väljenduses","fi":"ääninäyttelijä (henkilö) ekspressiossa","fr":"personne actrice vocale de","hu":"szinkronszínész személye:","it":"doppiatore persona di","lv":"ir balss aktieris (persona)","nl":"stemacteur-persoon van","no":"stemmeskuespiller for (person)","tr":"seslendirme sanatçısı kişisi","zh-Hans-CN":"……的声音演员个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ.","ca":"Expressió que inclou una contribució d’una persona prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd","da":"Udtryk, som omfatter en persons bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc.","de":"Eine Expression, zu der eine Person beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht.","en":"An expression that includes a contribution by a person of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc.","es":"Una expresión que incluye la contribución de una persona de proporcionar la voz a personajes en producciones de radio y audio y a personajes animados en obras de imágenes en movimiento, así como locuciones en comerciales de radio y televisión, expresiones dobladas, etc.","et":"Väljendus, millesse isik on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms.","fi":"Ekspressio, jossa henkilö on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált kifejezési formákban stb. hangalámondást szolgáltat.","it":"Espressione che comprende un contributo di una persona nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc.","lv":"Izteiksme, kas ietver personas ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml.","nl":"Een expressie die omvat een bijdrage door een persoon in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc.","tr":"Radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü işlerindeki animasyon karakterlerinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. için bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个个人的贡献的一种内容表达"},"altLabel":{"de":["Person als Synchronsprecherin/Synchronsprecher von"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50568", "lexicalAlias":"http://rdaregistry.info/Elements/a/actorPersonOf.en", "label":"is actor person of"},{"@id":"http://rdaregistry.info/Elements/a/P50217", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorAgentOf.en", "label":"is voice actor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50607", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/voiceActorPersonOf.en", "label":"is voice actor person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50607", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/voiceActorPersonOf.en", "label":"is voice actor person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50134","label":{"ca":"és compositor (expressió) de","da":"er komponist (udtryk) til","de":"ist Komponist (Expression) von","el":"είναι συνθέτης (έκφραση) του","en":"is composer of expression of (Deprecated)","fi":"sävellys (ekspressio)","fr":"est un compositeur (expression) de","hu":"zeneszerzője (kifejezési forma)"},"definition":{"ca":["Relaciona un agent, que contribueix a una expressió afegint música a una obra que originalment no en tenia, composant música nova per substituir la música original, o composant música nova per complementar la música existent, amb una expressió."],"da":["Relaterer en agent, der har bidraget til et udtryk ved at tilføje musik til et værk, der oprindeligt manglede det, ved at komponere ny musik som erstatning for den oprindelige musik, eller ved at komponere ny musik som supplement til eksisterende musik til et udtryk."],"de":["Setzt einen Akteur, der zu einer Expression eines Werks beiträgt, indem er Musik zu einem Werk hinzufügt, das im Original keine hatte, neue Musik als Ersatz für die Originalmusik komponiert oder neue Musik komponiert, die eine existierende Musik ergänzt, mit einer Expression in Beziehung."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση μέσω της προσθήκης μουσικής σε ένα έργο που αρχικά δεν διέθετε [μουσική], μέσω της σύνθεσης νέας μουσικής προς αντικατάσταση της πρωτότυπης μουσικής ή μέσω της σύνθεσης νέας μουσικής ως συμπλήρωμα της ήδη υπάρχουσας μουσικής, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution of adding music to a work that originally lacked it, by composing new music to substitute for original music, or by composing new music to supplement existing music. (Deprecated)"],"fi":["Liittää toimijan ekspressioon, johon on lisätty musiikkia, joka ei aikaisemmin sisältynyt teokseen, tai johon on sävelletty uutta musiikkia korvaamaan teoksen aikaisemman musiikin tai täydentämään olemassa olevaa musiikkia."],"fr":["Met un agent qui contribue à une expression en ajoutant de la musique à une œuvre qui n’en avait pas à l’origine, en composant une nouvelle musique pour remplacer la musique originale ou en composant une nouvelle musique pour compléter la musique existante en relation avec une expression."],"hu":["Egy ágenst (személyt, családot vagy testületet), aki/amely hozzájárul egy kifejezési formához azzal, hogy zenét ad hozzá egy műhöz, amely eredetileg annak híján volt, új zenét komponál, hogy helyettesítse az eredeti zenét, vagy új zenét komponál, hogy kiegészítse a meglévő zenét, hozzákapcsol egy kifejezési formához."]},"ToolkitLabel":{"ca":"compositor (expressió) de","da":"komponist (udtryk) til","de":"Komponist (Expression) von","el":"συνθέτης (έκφραση) του","en":"composer of expression of (Deprecated)","fi":"sävellys (ekspressio)","fr":"compositeur (expression) de","hu":"zeneszerzője (kifejezési forma)","no":"komponist (uttrykk) av"},"ToolkitDefinition":{"ca":"Expressió d’una obra que incorpora una contribució que afegeix música a una obra que originalment no en tenia, composant música nova per substituir la música original, o composant música nova per complementar la música existent.","da":"Udtryk, der inkorporerer et bidrag ved at tilføje musik til et værk der oprindelig manglede musik, ved at komponere ny musik, som erstatning for den oprindelige musik eller ved at komponere ny musik som supplement til den eksisterende musik.","de":"Eine Expression, bei der ein Akteur Musik zu einem Werk hinzufügt, das im Original keine hatte, neue Musik als Ersatz für die Originalmusik komponiert oder neue Musik komponiert, die eine existierende Musik ergänzt.","el":"Μια έκφραση που ενσωματώνει τη συνεισφορά της προσθήκης μουσικής σε ένα έργο που αρχικά δεν διέθετε [μουσική], μέσω της σύνθεσης νέας μουσικής προς αντικατάσταση της πρωτότυπης μουσικής ή μέσω της σύνθεσης νέας μουσικής ως συμπλήρωμα της ήδη υπάρχουσας μουσικής.","en":"An expression that includes a contribution of adding music to a work that originally lacked it, by composing new music to substitute for original music, or by composing new music to supplement existing music. (Deprecated)","fi":"Ekspressio, johon on lisätty musiikkia, joka ei aikaisemmin sisältynyt teokseen, tai johon on sävelletty uutta musiikkia korvaamaan teoksen aikaisemman musiikin tai täydentämään olemassa olevaa musiikkia.","fr":"Expression qui intègre une contribution consistant à ajouter de la musique à une œuvre qui n’en avait pas à l’origine, en composant une nouvelle musique pour remplacer une musique originale ou en composant une nouvelle musique pour compléter une musique existante.","hu":"Egy kifejezési forma, amely hozzájárulást jelent azzal, hogy zenét ad hozzá egy műhöz, amelyben az eredetileg nem volt, új zene komponálásával az eredeti zene helyettesítésére, vagy új zene komponálásával a meglévő zene kiegészítésére.","no":"Et uttrykk som omfatter et bidrag i form av å sette musikk til et verk som opprinnelig var uten musikk, ved å komponere musikk som erstatning for originalmusikken, eller ved å komponere ny musikk i tillegg til den eksisterende musikken."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50451", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorToAggregatedContentOf.en", "label":"is contributor to aggregated content of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/composerOfExpressionOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50134", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/composerOfExpressionOf.en", "label":"is composer of expression of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50134", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/composerOfExpressionOf.en", "label":"is composer of expression of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P51108","label":{"ca":"és agent descrit amb metadades per","cs":"je agentem popisovaným metadaty v","de":"ist Akteur beschrieben durch Metadaten","en":"is agent described with metadata by","es":"es agente descrito con metadatos por","fi":"toimijaa metatiedoilla kuvaileva teos","fr":"est un agent décrit avec des métadonnées par","hu":"a következő metaadatokkal leírt ágens:","nl":"is actor beschreven met metadata door","tr":"tarafından üstveri ile tanımlanmış temsilcidir","zh-Hans-CN":"是被……用元数据描述的行为者"},"definition":{"ca":["Relaciona un agent amb una obra que és una obra de metadades per a un agent."],"cs":["Vztahuje agenta k dílu, které je metadatovým dílem pro agenta."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem es sich um ein Metadatenwerk für einen Akteur handelt."],"en":["Relates an agent to a work that is a metadata work for an agent."],"es":["Relaciona un agente con una obra que es una obra de metadatos para un agente."],"fi":["Liittää toimijan teokseen, joka on toimijan metatietoteos."],"fr":["Met un agent en relation avec une œuvre qui consiste en une œuvre de métadonnées pour un agent."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amely egy metaadatmű egy ágensre vonatkozóan."],"nl":["Relateert een actor aan werk dat is een metadatawerk voor een actor."],"tr":["Bir temsilciyi, temsilci için bir üstveri eseri olan bir eserle ilişkilendirir"],"zh-Hans-CN":["将一个行为者与作为描述一个行为者的一种元数据作品的一种作品关联起来。"]},"ToolkitLabel":{"ca":"agent descrit amb metadades per","cs":"agent popisovaný metadaty","de":"ist Akteur beschrieben durch Metadaten","en":"agent described with metadata by","es":"agente descrito con metadatos por","fi":"toimijaa metatiedoilla kuvaileva teos","fr":"agent décrit avec des métadonnées par","hu":"a következő metaadatokkal leírt ágens:","nl":"actor beschreven met metadata door","tr":"Tarafından üstveri ile tanımlanan temsilci","zh-Hans-CN":"被……用元数据描述的行为者"},"ToolkitDefinition":{"ca":"Una obra que és una obra de metadades per a un agent.","cs":"Dílo, které je metadatovým dílem pro agenta.","de":"Ein fotografisches Werk, bei dem ein Akteur für die Fotografie verantwortlich ist.","en":"A work that is a metadata work for an agent.","es":"Una obra que es una obra de metadatos para un agente.","fi":"Teos, joka on toimijan metatietoteos.","fr":"Œuvre qui consiste en une œuvre de métadonnées pour un agent.","hu":"Egy mű, amely egy metaadatmű egy ágensre vonatkozóan.","nl":"Een werk dat is een metadatawerk voor een actor.","tr":"Bir temsilci için üstveri çalışması olan bir eser.","zh-Hans-CN":"作为描述一个行为者的一种元数据作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/agentDescribedWithMetadataBy.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50426", "lexicalAlias":"http://rdaregistry.info/Elements/a/agentDescribedBy.en", "label":"is agent described by"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P51109", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectiveAgentDescribedWithMetadataBy.en", "label":"is collective agent described with metadata by"},{"@id":"http://rdaregistry.info/Elements/a/P51112", "lexicalAlias":"http://rdaregistry.info/Elements/a/personDescribedWithMetadataBy.en", "label":"is person described with metadata by"},{"@id":"http://rdaregistry.info/Elements/a/object/P51108", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/agentDescribedWithMetadataBy.en", "label":"is agent described with metadata by"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51108", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/agentDescribedWithMetadataBy.en", "label":"is agent described with metadata by"}]},{"@id":"http://rdaregistry.info/Elements/a/P51109","label":{"ca":"és agent col·lectiu descrit amb metadades per","cs":"je kolektivním agentem popisovaným metadaty v","de":"ist gemeinschaftlicher Akteur beschrieben in","en":"is collective agent described with metadata by","es":"es agente colectivo descrito con metadatos por","fi":"yhteistoimijaa metatiedoilla kuvaileva teos","fr":"est un agent collectif décrit avec des métadonnées par","hu":"a következő metaadatokkal leírt kollektív ágens:","nl":"is collectieve actor beschreven met metadata door","tr":"tarafından üstveri ile tanımlanmış kolektif temsilcidir","zh-Hans-CN":"是被……用元数据描述的集体行为者"},"definition":{"ca":["Relaciona un agent col·lectiu amb una obra que és una obra de metadades per a un agent col·lectiu."],"cs":["Vztahuje kolektivního agenta k dílu, které je metadatovým dílem pro kolektivního agenta."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem fotografischen Werk, bei dem ein gemeinschaftlicher Akteur für die Fotografie verantwortlich ist."],"en":["Relates a collective agent to a work that is a metadata work for a collective agent."],"es":["Relaciona un agente colectivo con una obra que es una obra de metadatos para un agente colectivo."],"fi":["Liittää yhteistoimijan teokseen, joka on yhteistoimijan metatietoteos."],"fr":["Met un agent collectif en relation avec une œuvre qui consiste en une œuvre de métadonnées pour un agent collectif."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amely egy metaadatmű egy kollektív ágensre vonatkozóan."],"nl":["Relateert een collectieve actor aan een werk dat is een metadatawerk voor een collectieve actor."],"tr":["Kolektif bir temsilciyi, kendisi için oluşturulan bir tanımlayıcı bilgi eseri ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与作为描述一个集体行为者的一种元数据作品的一种作品关联起来。"]},"ToolkitLabel":{"ca":"agent col·lectiu descrit amb metadades per","cs":"kolektivní agent popisovaný metadaty","de":"Gemeinschaftlicher Akteur, der mit einer RDA-Entität in Verbindung steht.","en":"collective agent described with metadata by","es":"agente colectivo descrito con metadatos por","fi":"yhteistoimijaa metatiedoilla kuvaileva teos","fr":"agent collectif décrit avec des métadonnées par","hu":"a következő metaadatokkal leírt kollektív ágens:","nl":"collectieve actor beschreven met metadata door","tr":"üstveriyle tanımlanan kolektif temsilci","zh-Hans-CN":"被……用元数据描述的集体行为者"},"ToolkitDefinition":{"ca":"Una obra que és una obra de metadades per a un agent col·lectiu.","cs":"Dílo, které je metadatovým dílem pro kolektivního agenta.","de":"Ein fotografisches Werk, bei dem ein gemeinschaftlicher Akteur für die Fotografie verantwortlich ist.","en":"A work that is a metadata