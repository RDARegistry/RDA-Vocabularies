                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50744", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en", "label":"is reviser collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50157", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerAgentOf.en", "label":"is abridger agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50917", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerCorporateBodyOf.en", "label":"is abridger corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51068", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerFamilyOf.en", "label":"is abridger family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50766", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/abridgerCollectiveAgentOf.en", "label":"is abridger collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50766", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/abridgerCollectiveAgentOf.en", "label":"is abridger collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50917","label":{"ar":"هي هيئة مسئولة عن التلخيص لـ","ca":"és entitat corporativa abreujadora de","cs":"je autorem zkrácené verze (korporací) (čeho)","da":"er korporation, som er forkorter af","de":"ist Körperschaft als Kürzende/Kürzender von","de":"ist Körperschaft als Kürzende/Kürzender von","el":"είναι συντμητής συλλογικό όργανο του","en":"is abridger corporate body of","es":"es organismo corporativo abreviador de","et":"lühendaja (asutus) väljenduses","fi":"lyhentäjä (yhteisö) ekspressiossa","fr":"est une collectivité abréviatrice de","hu":"rövidítő testülete a következőnek:","it":"è compendiatore ente di","lv":"ir saīsinātājs (institūcija)","nl":"is inkorter-corporatie van","no":"er forkorter for (korporasjon)","tr":"özetleyen tüzel kişisidir","zh-Hans-CN":"是……的缩编者团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة في تلخيص تعبيرة لعمل آخر دون تغيير المعنى العام أو طريقة العرض."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa escurçant una expressió d’una altra obra sense canviar-ne el significat general o la forma de presentació."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace tím, že zkrátil vyjádření jiného díla, aniž by změnila obecný význam nebo způsob prezentace."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at forkorte udtrykket af et andet værk, uden at ændre den overordnede betydning eller præsentationsmåde."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie eine Expression eines anderen Werks kürzt, ohne die allgemeine Bedeutung oder Art der Darstellung zu verändern.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie eine Expression eines anderen Werks kürzt, ohne die allgemeine Bedeutung oder Art der Darstellung zu verändern."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of shortening an expression of another work without changing the general meaning or manner of presentation."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de acortar una expresión de otra obra sin cambiar el sentido general o la forma de presentación."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, lühendades teise teose väljendust, muutmata üldist tähendust ja esitusviisi."],"fi":["Liittää yhteisön ekspressioon, jonka tekemisessä yhteisö on osallisena lyhentämällä toisen teoksen ekspressiota muuttamatta esityksen yleistä sisältöä tai tyyliä."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à raccourcir une expression d’une autre œuvre sans en changer le sens général ou le mode de présentation."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését egy másik mű kifejezési formájának lerövidítésével úgy, hogy a prezentáció általános jelentése vagy módja nem változik."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nell'abbreviazione di un'espressione di un'altra opera senza modificare il significato generale o la modalità di presentazione."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, saīsinot cita darba izteiksmi, nemainot darba nozīmi vai pasniegšanas veidu."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door inkorten van een expressie of ander werk zonder de algemene betekenis of manier van uiteenzetting te wijzigen."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å forkorte et uttrykk av et relatert verk uten å endre meningen eller presentasjonsformen."],"tr":["Bir tüzel kişiyi, genel anlamı veya sunum biçimini değiştirmeden başka bir çalışmanın ifadesinin kısaltılmasına bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括缩短另一种作品的一种内容表达而不改变其总体意义或呈现方式的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن التلخيص","ca":"entitat corporativa abreujadora de","cs":"autor zkrácené verze (korporace) (čeho)","da":"korporation, som er forkorter af","de":"Körperschaft als Kürzende/Kürzender von","de":"Körperschaft als Kürzende/Kürzender von","el":"συντμητής συλλογικό όργανο του","en":"abridger corporate body of","es":"organismo corporativo abreviador de","et":"lühendaja (asutus) väljenduses","fi":"lyhentäjä (yhteisö) ekspressiossa","fr":"collectivité abréviatrice de","hu":"rövidítő testülete:","it":"compendiatore ente di","lv":"ir saīsinātājs (institūcija)","nl":"inkorter-corporatie van","no":"forkorter for (korporasjon)","tr":"özetleyen tüzel kişi","zh-Hans-CN":"……的缩编者团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة في تلخيص تعبيرة لعمل آخر دون تغيير المعنى العام أو طريقة العرض.","ca":"Expressió que inclou una contribució d’una entitat corporativa escurçant una expressió d’una altra obra sense canviar-ne el significat general o la forma de presentació.","cs":"Vyjádření, které zahrnuje přispění korporace tím, že zkrátil vyjádření jiného díla, aniž by změnila obecný význam nebo způsob prezentace.","da":"Udtryk, som omfatter en korporations bidrag ved at forkorte udtrykket af et andet værk, uden at ændre den overordnede betydning eller præsentationsmåde.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie eine Expression eines anderen Werks kürzt, ohne die allgemeine Bedeutung oder Art der Darstellung zu verändern.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie eine Expression eines anderen Werks kürzt, ohne die allgemeine Bedeutung oder Art der Darstellung zu verändern.","en":"An expression that includes a contribution by a corporate body of shortening an expression of another work without changing the general meaning or manner of presentation.","es":"Una expresión que incluye una contribución de un organismo corporativo de acortar una expresión de otra obra sin cambiar el sentido general o la forma de presentación.","et":"Väljendus, millesse asutus on andnud panuse, lühendades teise teose väljendust, muutmata üldist tähendust ja esitusviisi.","fi":"Ekspressio, jonka tekemisessä yhteisö on osallisena lyhentämällä toisen teoksen ekspressiota muuttamatta esityksen yleistä sisältöä tai tyyliä.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à raccourcir une expression d’une autre œuvre sans en changer le sens général ou le mode de présentation.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését egy másik mű kifejezési formájának lerövidítésével úgy, hogy a prezentáció általános jelentése vagy módja nem változik.","it":"Espressione che comprende un contributo di un ente nell'abbreviazione di un'espressione di un'altra opera senza modificare il significato generale o la modalità di presentazione.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, saīsinot cita darba izteiksmi, nemainot darba nozīmi vai pasniegšanas veidu.","nl":"Een expressie die omvat een bijdrage door een corporatie door inkorten van een expressie of ander werk zonder de algemene betekenis of manier van uiteenzetting te wijzigen.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å forkorte et uttrykk av et relatert verk uten å endre meningen eller presentasjonsformen.","tr":"Genel anlamı veya sunum biçimini değiştirmeden başka bir çalışmanın anlatımının kısaltılması için tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括缩短另一种作品的一种内容表达而不改变其总体意义或呈现方式的一个团体的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
