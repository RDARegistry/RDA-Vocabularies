                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/predecessorOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50326", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedFamilyOfFamily.en", "label":"has related family of family"},{"@id":"http://rdaregistry.info/Elements/a/P50421", "lexicalAlias":"http://rdaregistry.info/Elements/a/predecessorOfCollectiveAgent.en", "label":"has predecessor of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50422", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/predecessorOfFamily.en", "label":"has predecessor of family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50422", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/predecessorOfFamily.en", "label":"has predecessor of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50413","label":{"ar":"له اسم مفضل لوكيل","ca":"té com a nom preferit d’agent","cs":"má preferované jméno agenta","da":"har foretrukket navn på agent","de":"hat bevorzugten Namen eines Akteurs","de":"hat bevorzugten Namen eines Akteurs","el":"έχει προτιμώμενο όνομα του φορέα","en":"has preferred name of agent","es":"tiene el nombre preferido del agente","et":"tegija eelisnimi","fi":"toimijan ensisijainen nimi","fr":"a pour nom privilégié d’un agent","hu":"ágens előnyben részesített neve a következő:","it":"ha come nome preferito di agente","lv":"aģenta prioritārais vārds/nosaukums","nl":"heeft geprefereerde naam van actor","no":"har foretrukket navn på agent","tr":"tercih edilen temsilci adı ile ilişkilidir","zh-Hans-CN":"有行为者的首选名称"},"definition":{"ar":["يربط وكيلا باسم وكيل اختير كاسم مفضل في تطبيق أو في سياق محدد."],"ca":["Relaciona un agent amb un nomen que és un nom d’agent que se selecciona com a preferent en una aplicació o context específic."],"cs":["Vztahuje agenta k nomen, které je jménem agenta, které je preferováno ve specifické aplikaci nebo kontextu."],"da":["Relaterer en agent til et nomen, som er et navn på agent, som er valgt som præference i en specifik anvendelse eller kontekst."],"de":["Setzt einen Akteur in Beziehung zu einem Namen eines Akteurs, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.,Setzt einen Akteur in Beziehung zu einem Namen eines Akteurs, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird."],"en":["Relates an agent to a nomen that is a name of agent that is selected for preference in a specific application or context."],"es":["Relaciona un agente con un nomen que es un nombre de agente que se selecciona por preferencia en una aplicación o contexto específico."],"et":["Seostab tegija tegija nimega, mis kindlas rakenduses või kontekstis on valitud eelistatuks."],"fi":["Liittää toimijan nomeniin, joka on toimijan nimi, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa."],"fr":["Met un agent en relation avec un nomen qui est un nom d’agent faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques."],"hu":["Hozzákapcsol egy ágenst egy nomenhez, egy ágens nevéhez, amelyet egy adott szótárkódolási sémából választanak ki előnyben részesítettként."],"it":["Correla un agente a un nome di agente scelto come preferito in una specifica applicazione o contesto."],"lv":["Sasaista aģentu ar nomenu, kas ir aģenta vārds/nosaukums, kurš ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā."],"nl":["Relateert een actor aan een nomen dat is een naam van actor die de voorkeur heeft gekregen in een specifieke applicatie of context."],"no":["Relaterer en agent til et navn for agent som er valgt som preferanse i en bestemt applikasjon eller kontekst."],"tr":["Bir temsilciyi, özel uygulama veya içerikte kullanılması tercih için seçilen diğer temsilcinin ismi olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与作为一个行为者的名称并在一个特定的应用或语境中被优先选用的一个命名关联起来。"]},"ToolkitLabel":{"ar":"اسم مفضل لوكيل","ca":"nom preferit d’agent","cs":"preferované jméno agenta","da":"foretrukket navn på agent","de":"Bevorzugter Name eines Akteurs","de":"Bevorzugter Name eines Akteurs","el":"προτιμώμενο όνομα του φορέα","en":"preferred name of agent","es":"nombre preferido del agente","et":"tegija eelisnimi","fi":"toimijan ensisijainen nimi","fr":"nom privilégié d’un agent","hu":"ágens előnyben részesített neve:","it":"nome preferito di agente","lv":"aģenta prioritārais vārds/nosaukums","nl":"geprefereerde naam van actor","no":"foretrukket navn på agent","tr":"Temsilcinin tercih edilen ismi","zh-Hans-CN":"行为者的首选名称"},"ToolkitDefinition":{"ar":"اسم وكيل اختير كاسم مفضل في تطبيق أو في سياق محدد.","ca":"Nomen que és un nom d’agent que se selecciona com a preferent en una aplicació o context específic.","cs":"Nomen, které je jménem agenta, které je preferováno ve specifické aplikaci nebo kontextu.","da":"Nomen, som er et navn på agent, som er valgt som præference i en specifik anvendelse eller kontekst.","de":"Ein Name eines Akteur, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.","de":"Ein Name eines Akteur, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.","en":"A nomen that is a name of agent that is selected for preference in a specific application or context.","es":"Un nomen que es un nombre de agente que se selecciona por preferencia en una aplicación o contexto específico.","et":"Tegija nimi, mis kindlas rakenduses või kontekstis on valitud eelistatuks.","fi":"Nomen, joka on toimijan nimi, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.","fr":"Nomen qui est un nom d’agent faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques.","hu":"Egy nomen, egy ágens neve, amelyet egy bizonyos alkalmazásban vagy kontextusban választanak ki előnyben részesítettként.","it":"Nome di agente scelto come preferito in una specifica applicazione o contesto.","lv":"Aģenta vārds/nosaukums, kurš ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā.","nl":"Een nomen dat is een naam van actor die de voorkeur heeft gekregen in een specifieke applicatie of context.","no":"Et navn for agent som er valgt som preferanse i en bestemt applikasjon eller kontekst.","tr":"Belirli bir uygulamada veya bağlamda tercih için seçilen temsilcinin adı olan bir isim.","zh-Hans-CN":"作为一个行为者的名称并在一个特定的应用或语境中被优先选用的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
