                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/binderPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50314", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfPerson.en", "label":"has related item of person"},{"@id":"http://rdaregistry.info/Elements/a/P50123", "lexicalAlias":"http://rdaregistry.info/Elements/a/binderAgentOf.en", "label":"is binder agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50628", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/binderPersonOf.en", "label":"is binder person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50628", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/binderPersonOf.en", "label":"is binder person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50126","label":{"ar":"هو قاضٍ لـ","ca":"és jutge de","cs":"je soudcem (čeho)","da":"er dommer af","de":"ist Richterin/Richter von","de":"ist Richterin/Richter von","el":"είναι κριτής του","en":"is judge of","es":"es juez de","et":"kohtunik teoses","fi":"tuomari teoksessa","fr":"est un juge de","hu":"bírája a következőnek:","it":"è giudice di","lv":"ir tiesnesis","nl":"is rechter van","no":"er dommer over","tr":"yargıcıdır","zh-Hans-CN":"是……的法官"},"definition":{"ar":["يربط الشخص بعمل يترتب عليه مسئولية الاستماع إلى المسائل القانونية في محكمة والبت فيها."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’escolta i decisió en les causes jurídiques en un tribunal."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost za slyšení a rozhodnutí o právních záležitostech u soudu."],"da":["Relaterer en person til et værk, som involverer et ansvar for at høre og afgøre juridiske anliggender i retten."],"de":["Setzte eine Person in Beziehung zu einem Werk, bei dem eine Person dafür verantwortlich ist, sich bei Gericht juristische Angelegenheiten anzuhören und darüber zu entscheiden.,Setzte eine Person in Beziehung zu einem Werk, bei dem eine Person dafür verantwortlich ist, sich bei Gericht juristische Angelegenheiten anzuhören und darüber zu entscheiden."],"el":["Συνδέει ένα φυσικό πρόσωπο, το οποίο ακούει και αποφασίζει αναφορικά με ζητήματα νομικής φύσης στο δικαστήριο, με ένα έργο."],"en":["Relates a person to a work that involves a responsibility for hearing and decision on legal matters in court."],"es":["Relaciona una persona con una obra que involucra una responsabilidad de auditar y de decisión sobre asuntos legales en un tribunal."],"et":["Seostab isiku teosega, mis sisaldab vastutust õigusasjade ärakuulamise ja otsustamise eest kohtus."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa oikeusasioiden kuulemisesta ja päättämisestä tuomioistuimessa."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité consistant à entendre des causes juridiques et à rendre jugement dans un tribunal."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik a felelősség bírósági jogi ügyek tárgyalásával és döntésével kapcsolatban."],"it":["Correla una persona a un'opera che implica la responsabilità di dibattere e di decidere su affari legali in un tribunale."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par lietas izskatīšanu un lēmumu pieņemšanu tiesā."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid voor horen en besluiten over wettelijke zaken in rechtbank."],"no":["Relaterer en person til et verk som involverer ansvar i form av å høre og ta avgjørelser i saker i en rettsinstans."],"tr":["Bir kişiyi, mahkemede hukuki konular hakkında duruşma ve karar verme sorumluluğu içeren eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及法院中关于法律事务审理和决定责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"قاض","ca":"jutge de","cs":"soudce (čeho)","da":"dommer af","de":"Richterin/Richter von","de":"Richterin/Richter von","el":"κριτής του","en":"judge of","es":"juez de","et":"kohtunik teoses","fi":"tuomari teoksessa","fr":"juge de","hu":"bírája:","it":"giudice di","lv":"ir tiesnesis","nl":"rechter van","no":"dommer over","tr":"yargıç","zh-Hans-CN":"……的法官"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية الاستماع إلى المسائل القانونية في محكمة والبت فيها.","ca":"Obra que implica una responsabilitat d’escolta i decisió en les causes jurídiques en un tribunal.","cs":"Dílo, které zahrnuje odpovědnost za slyšení a rozhodnutí o právních záležitostech u soudu.","da":"Værk, som involverer et ansvar for at høre og afgøre juridiske anliggender i retten.","de":"Ein Werk, bei dem eine Person dafür verantwortlich ist, sich bei Gericht juristische Angelegenheiten anzuhören und darüber zu entscheiden.","de":"Ein Werk, bei dem eine Person dafür verantwortlich ist, sich bei Gericht juristische Angelegenheiten anzuhören und darüber zu entscheiden.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της ακρόασης και της λήψης απόφασης αναφορικά με ζητήματα νομικής φύσης στο δικαστήριο.","en":"A work that involves a responsibility for hearing and decision on legal matters in court.","es":"Una obra que involucra una responsabilidad de auditar y de decisión sobre asuntos legales en un tribunal.","et":"Teos, mis sisaldab vastutust õigusasjade ärakuulamise ja otsustamise eest kohtus.","fi":"Teos, jossa henkilö on vastuussa oikeusasioiden kuulemisesta ja päättämisestä tuomioistuimessa.","fr":"Œuvre qui comporte une responsabilité consistant à entendre des causes juridiques et à rendre jugement dans un tribunal.","hu":"Egy mű, amelyhez hozzátartozik a felelősség bírósági jogi ügyek tárgyalásával és döntésével kapcsolatban.","it":"Opera che implica la responsabilità di dibattere e di decidere su affari legali in un tribunale.","lv":"Darbs, kas ietver personas atbildību par lietas izskatīšanu un lēmumu pieņemšanu tiesā.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid voor horen en besluiten over wettelijke zaken in rechtbank.","no":"Et verk som involverer ansvar i form av å høre og ta avgjørelser i saker i en rettsinstans.","tr":"Hukuki konularda, mahkemede duruşma ve karar verme sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及法院中关于法律事务审理和决定责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
