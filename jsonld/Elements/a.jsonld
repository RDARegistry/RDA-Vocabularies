                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/costumeDesignerCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50774", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCollectiveAgentToPerformanceOf.en", "label":"is contributor collective agent to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50144", "lexicalAlias":"http://rdaregistry.info/Elements/a/costumeDesignerAgentOf.en", "label":"is costume designer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50884", "lexicalAlias":"http://rdaregistry.info/Elements/a/costumeDesignerCorporateBodyOf.en", "label":"is costume designer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51035", "lexicalAlias":"http://rdaregistry.info/Elements/a/costumeDesignerFamilyOf.en", "label":"is costume designer family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50733", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/costumeDesignerCollectiveAgentOf.en", "label":"is costume designer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50733", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/costumeDesignerCollectiveAgentOf.en", "label":"is costume designer collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50884","label":{"ar":"هي هيئة مصممة أزياء لـ","ca":"és entitat corporativa dissenyadora de vestuari de","cs":"je kostýmním výtvarníkem (korporací) (čeho)","da":"er korporation, som er kostumedesigner af","de":"ist Körperschaft als Kostümbildnerin/Kostümbildner von","de":"ist Körperschaft als Kostümbildnerin/Kostümbildner von","el":"είναι ενδυματολόγος συλλογικό όργανο του","en":"is costume designer corporate body of","es":"e