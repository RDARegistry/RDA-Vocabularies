                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/radioProducerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50550", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerPersonOf.en", "label":"is producer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50214", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioProducerAgentOf.en", "label":"is radio producer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50552", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/radioProducerPersonOf.en", "label":"is radio producer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50552", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/radioProducerPersonOf.en", "label":"is radio producer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50248","label":{"ar":"هو وكيل مقرر لـ","ca":"és agent relator de","cs":"je reportérem (agentem) (čeho)","da":"er agent, som er rapportør af","de":"ist Akteur als Berichterstatterin/Berichterstatter von","de":"ist Akteur als Berichterstatterin/Berichterstatter von","el":"είναι εισηγητής φορέας του","en":"is rapporteur agent of","es":"es agente relator de","et":"aruande koostaja (tegija) teoses","fi":"kokousten raportoija (toimija) teoksessa","fr":"est un agent rapporteur de","hu":"raportőr ágense a következőnek:","it":"è relatore agente di","lv":"ir ziņotājs (aģents)","nl":"is rapporteur-actor van","no":"er rapportør for (agent)","tr":"raportör temsilcisidir","zh-Hans-CN":"是……的会务报告人行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن إعداد تقرير عن وقائع اجتماعات مؤسسة."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la redacció de les actes de les reunions d’una organització."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za podávání zprávy o průběhu jednání organizace."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at rapportere om udviklingerne ved en organisations møder."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Berichten über den Ablauf von Sitzungen einer Organisation verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Berichten über den Ablauf von Sitzungen einer Organisation verantwortlich ist."],"el":["Συνδέει έναν συγγραφέα, στον οποίο έχει ανατεθεί από έναν οργανισμό η αναφορά των πρακτικών των συναντήσεων, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for reporting on the proceedings of meetings of an organization."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de reportar sobre los procedimientos de reuniones de una organización."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust organisatsiooni koosolekute toimingutest aruande kirjutamise eest."],"fi":["Liittää toimijan teokseen, jossa toimijan vastuulla on raportoida organisaation kokousmenettelyistä."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à rédiger les comptes rendus des réunions d’une organisation."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy szervezet üléseinek lefolyásáról szóló jelentésért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per la redazione dei verbali degli incontri di un'organizzazione."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par ziņošanu par organizācijas sanāksmju norisi."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het rapporteren van handelingen van bijeenkomsten van een organisatie."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i fom av å rapportere fra møter i en organisasjon."],"tr":["Bir temsilciyi, bir kuruluşun toplantılarının tutanaklarını raporlamak için bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及一个组织的会议文集报告的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل مقرر لـ","ca":"agent relator de","cs":"reportér (agent) (čeho)","da":"rapportør af","de":"Akteur als Berichterstatterin/Berichterstatter von","de":"Akteur als Berichterstatterin/Berichterstatter von","el":"εισηγητής φορέας του","en":"rapporteur agent of","es":"agente relator de","et":"aruande koostaja (tegija) teoses","fi":"kokousten raportoija (toimija) teoksessa","fr":"agent rapporteur de","hu":"raportőr ágense:","it":"agente relatore di","lv":"ir ziņotājs (aģents)","nl":"rapporteur-actor van","no":"rapportør for (agent)","tr":"Raportör temsilcisi","zh-Hans-CN":"……的会务报告人行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن إعداد تقرير عن وقائع اجتماعات مؤسسة.","ca":"Obra que implica una responsabilitat d’un agent en la redacció de les actes de les reunions d’una organització.","cs":"Dílo, které zahrnuje odpovědnost agenta za podávání zprávy o průběhu jednání organizace.","da":"Værk, som involverer en agents ansvar for at rapportere om udviklingerne ved en organisations møder.","de":"Ein Werk, bei dem ein Akteur für das Berichten über den Ablauf von Sitzungen einer Organisation verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für das Berichten über den Ablauf von Sitzungen einer Organisation verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της σύνταξης των πρακτικών των συναντήσεων ενός οργανισμού.","en":"A work that involves a responsibility of an agent for reporting on the proceedings of meetings of an organization.","es":"Una obra que involucra una responsabilidad de un agente de reportar sobre los procedimientos de reuniones de una organización.","et":"Teos, mis sisaldab tegija vastutust organisatsiooni koosolekute toimingutest aruande kirjutamise eest.","fi":"Teos, jossa toimijan vastuulla on raportoida organisaation kokousmenettelyistä.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à rédiger les comptes rendus des réunions d’une organisation.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy szervezet üléseinek lefolyásáról szóló jelentésért.","it":"Opera che implica la responsabilità di un agente per la redazione dei verbali degli incontri di un'organizzazione.","lv":"Darbs, kas ietver aģenta atbildību par ziņošanu par organizācijas sanāksmju norisi.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het rapporteren van handelingen van bijeenkomsten van een organisatie.","no":"Et verk som involverer ansvar for en agent i fom av å rapportere fra møter i en organisasjon.","tr":"Bir organizasyonun toplantılarının bildirilerini raporlamak için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及一个组织的会议文集报告的一个行为者的责任的一种作品"},"altLabel":{"ar":["مقرر لـ"],"ca":["relator de"],"cs":["reportér (čeho)"],"da":["rapportør af"],"de":["Berichterstatter von,Berichtserstatter von"],"el":["εισηγητής του"],"en":["rapporteur of"],"es":["relator de"],"et":["aruande koostaja teoses"],"fi":["raportoijana kokouksessa"],"fr":["rapporteur de"],"hu":["raportőre:"],"it":["relatore di"],"nl":["rapporteur van"],"no":["rapportør for"],"tr":["Raportör"],"zh-Hans-CN":["……的会务报告人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
