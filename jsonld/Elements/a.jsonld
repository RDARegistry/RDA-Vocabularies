                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50305", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfAgent.en", "label":"has related work of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P51100", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfCollectiveAgent.en", "label":"has sponsored work of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P51103", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfPerson.en", "label":"has sponsored work of person"},{"@id":"http://rdaregistry.info/Elements/a/object/P50226", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/sponsoredWorkOfAgent.en", "label":"has sponsored work of agent"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50226", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/sponsoredWorkOfAgent.en", "label":"has sponsored work of agent"}]},{"@id":"http://rdaregistry.info/Elements/a/P51100","label":{"ar":"له عمل برعاية وكيل جماعي","ca":"té com a obra patrocinada per un agent col·lectiu","cs":"má dílo sponzorované kolektivním agentem","da":"har værk sponsoreret af kollektiv agent","de":"hat gemeinschaftlichen Akteur als Träger eines Werks von","de":"hat gemeinschaftlichen Akteur als Träger eines Werks von","el":"έχει χορηγούμενο έργο του συλλογικού φορέα","en":"has sponsored work of collective agent","es":"tiene obra patrocinada de agente colectivo","et":"kollektiivi toetatud teos","fi":"yhteistoimijan sponsoroima teos","fr":"a pour œuvre parrainée d’un agent collectif","hu":"kollektív ágens szponzorált műve a következő:","it":"ha come opera sponsorizzata di agente colletti