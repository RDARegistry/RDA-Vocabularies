                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lettererPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50624", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToAmalgamationOf.en", "label":"is contributor person to amalgamation of"},{"@id":"http://rdaregistry.info/Elements/a/P50245", "lexicalAlias":"http://rdaregistry.info/Elements/a/lettererAgentOf.en", "label":"is letterer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50584", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lettererPersonOf.en", "label":"is letterer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50584", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lettererPersonOf.en", "label":"is letterer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50225","label":{"ar":"هو وكيل واضع كلمات الأوبر لـ","ca":"és agent llibretista de","cs":"je libretistou (agentem) (čeho)","da":"er agent, som er librettist af","de":"ist Akteur als Librettistin/Librettist von","de":"ist Akteur als Librettistin/Librettist von","el":"είναι λιμπρετίστας φορέας του","en":"is librettist agent of","es":"es agente libretista de","et":"libretist (tegija) teoses","fi":"libretisti (toimija) teoksessa","fr":"est un agent librettiste de","hu":"librettista ágense a következőnek:","it":"è librettista agente di","lv":"ir libretists (aģents)","nl":"is librettist-actor van","no":"er librettist for (agent)","tr":"libretto yazarı temsilcisidir","zh-Hans-CN":"是……的台本作者行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن تأليف أوبرا أو عمل مسرحي موسيقي، أو موسيقى دينية."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist."],"el":["Συνδέει έναν συγγραφέα των στίχων μιας όπερας ή κάποιου άλλου μουσικού σκηνικού έργου ή ενός ορατορίου, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for authoring the words of an opera or other musical stage work, or an oratorio."],"es":["Relaciona un agente con una obra que involucra la responsabilidad de un agente de ser el autor de las palabras de una ópera u otra obra musical en escena o un oratorio."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av å forfatte ordene i operaer, operetter, musikalske sceneverk eller oratorier."],"tr":["Bir temsilciyi, bir operanın veya başka bir müzikal sahne eserinin veya bir oratoryonun sözlerini yazmakla görevli bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل واضع كلمات الأوبرا","ca":"agent llibretista de","cs":"libretista (agent) (čeho)","da":"agent, som er librettist af","de":"Akteur als Librettistin/Librettist von","de":"Akteur als Librettistin/Librettist von","el":"λιμπρετίστας φορέας του","en":"librettist agent of","es":"agente libretista de","et":"libretist (tegija) teoses","fi":"libretisti (toimija) teoksessa","fr":"agent librettiste de","hu":"librettista ágense:","it":"librettista agente di","lv":"ir libretists (aģents)","nl":"librettist-actor van","no":"librettist for (agent)","tr":"opera metni yazarı temsilcisi","zh-Hans-CN":"……的台本作者行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن تأليف أوبرا أو عمل مسرحي موسيقي، أو موسيقى دينية.","ca":"Obra que implica una responsabilitat d’un agent en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori.","cs":"Dílo, které zahrnuje odpovědnost agenta za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria.","da":"Værk, som involverer an agents ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller oratorium.","de":"Ein Werk, bei dem ein Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της συγγραφής των στίχων μιας όπερας ή κάποιου άλλου μουσικού σκηνικού έργου ή ενός ορατορίου.","en":"A work that involves a responsibility of an agent for authoring the words of an opera or other musical stage work, or an oratorio.","es":"Una obra que involucra la responsabilidad de un agente de ser el autor de las palabras de una ópera u otra obra musical en escena o un oratorio.","et":"Teos, mis sisaldab tegija vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest.","fi":"Teos, jossa toimija on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért.","it":"Opera che implica la responsabilità di un agente come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio.","lv":"Darbs, kas ietver aģenta atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium.","no":"Et verk som involverer ansvar for en agent i form av å forfatte ordene i operaer, operetter, musikalske sceneverk eller oratorier.","tr":"Bir opera veya diğer müzikal sahne eserinin veya bir oratoryonun sözlerinin yazılmasında bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个行为者的责任的一种作品"},"altLabel":{"ar":["واضع كلمات الأوبرا"],"ca":["llibretista de"],"cs":["libretista (čeho)"],"da":["librettist af"],"de":["Librettist von,Librettist von"],"el":["λιμπρετίστας του"],"en":["librettist of"],"es":["libretista de"],"et":["libretist teoses"],"fi":["libretistinä musiikkiteoksessa"],"fr":["librettiste de"],"hu":["librettistája:"],"it":["librettista di"],"nl":["librettist van"],"no":["librettist for"],"tr":["Opera metni yazarı"],"zh-Hans-CN":["……的台本作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorAgentOf.en", "label":"is author agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/librettistAgentOf.en","See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50224", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistAgentOf.en", "label":"is lyricist agent of"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50685", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistCollectiveAgentOf.en", "label":"is librettist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50534", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistPersonOf.en", "label":"is librettist person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50225", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/librettistAgentOf.en", "label":"is librettist agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50225", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/librettistAgentOf.en", "label":"is librettist agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50685","label":{"ar":"هو وكيل جماعي واضع كلمات الأوبرا لـ","ca":"és agent col·lectiu llibretista de","cs":"je libretistou (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er librettist af","de":"ist gemeinschaftlicher Akteur als Librettistin/Librettist von","de":"ist gemeinschaftlicher Akteur als Librettistin/Librettist von","el":"είναι λιμπρετίστας συλλογικός φορέας του","en":"is librettist collective agent of","es":"es agente colectivo libretista de","et":"libretist (kollektiiv) teoses","fi":"libretisti (yhteistoimija) teoksessa","fr":"est un agent collectif librettiste de","hu":"librettista kollektív ágense a következőnek:","it":"è librettista agente collettivo di","lv":"ir libretists (grupa)","nl":"is librettist-collectieve actor van","no":"er librettist for (kollektiv agent)","tr":"libretto yazarı kolektif temsilcisidir","zh-Hans-CN":"是……的台本作者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن تأليف كلمات الأوبرا أو غيرها من أعمال المسرح الموسيقي، أو موسيقى دينية."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for authoring the words of an opera or other musical stage work, or an oratorio."],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de ser autor de la letra de una ópera u otra obra musical escénica, o un oratorio."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å være forfatter av ordene i en opera eller annet verk for en musikalsk scene, eller et oriatorium."],"tr":["Kolektif bir temsilciyi, bir operanın veya başka bir müzikal sahne eserinin ya da bir oratoryonun sözlerini yazma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي واضع كلمات الأوبرا","ca":"agent col·lectiu llibretista de","cs":"libretista (kolektivní agent) (čeho)","da":"kollektiv agent, som er librettist af","de":"Gemeinschaftlicher Akteur als Librettistin/Librettist von","de":"Gemeinschaftlicher Akteur als Librettistin/Librettist von","el":"λιμπρετίστας συλλογικός φορέας του","en":"librettist collective agent of","es":"agente colectivo libretista de","et":"libretist (kollektiiv) teoses","fi":"libretisti (yhteistoimija) teoksessa","fr":"agent collectif librettiste de","hu":"librettista kollektív ágense:","it":"librettista agente collettivo di","lv":"ir libretists (grupa)","nl":"librettist-collectieve actor van","no":"librettist for (kollektiv agent)","tr":"Opera metni yazarı kolektif temsilcisi","zh-Hans-CN":"……的台本作者集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن تأليف كلمات الأوبرا أو غيرها من أعمال المسرح الموسيقي، أو موسيقى دينية.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria.","da":"Værk, som involverer en kollektiv agents ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for authoring the words of an opera or other musical stage work, or an oratorio.","es":"Una obra que implica la responsabilidad de un agente colectivo de ser autor de la letra de una ópera u otra obra musical escénica, o un oratorio.","et":"Teos, mis sisaldab kollektiivi vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest.","fi":"Teos, jossa yhteistoimija on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért.","it":"Opera che implica una responsabilità di un agente collettivo come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio.","lv":"Darbs, kas ietver grupas atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av å være forfatter av ordene i en opera eller annet verk for en musikalsk scene, eller et oriatorium.","tr":"Bir operanın veya başka bir müzikal sahne eserinin ya da bir oratoryonun sözlerini yazmak için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个集体行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/librettistCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50692", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorCollectiveAgentOf.en", "label":"is author collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50225", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistAgentOf.en", "label":"is librettist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50836", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistCorporateBodyOf.en", "label":"is librettist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50987", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistFamilyOf.en", "label":"is librettist family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50685", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/librettistCollectiveAgentOf.en", "label":"is librettist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50685", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/librettistCollectiveAgentOf.en", "label":"is librettist collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50836","label":{"ar":"هي هيئة مسئولة عن وضع كلمات الأوبرا لـ","ca":"és entitat corporativa llibretista de","cs":"je libretistou (korporací) (čeho)","da":"er korporation, som er librettist af","de":"ist Körperschaft als Librettistin/Librettist von","de":"ist Körperschaft als Librettistin/Librettist von","el":"είναι λιμπρετίστας συλλογικό όργανο του","en":"is librettist corporate body of","es":"es organismo corporativo libretista de","et":"libretist (asutus) teoses","fi":"libretisti (yhteisö) teoksessa","fr":"est une collectivité librettiste de","hu":"librettista testülete a következőnek:","it":"è librettista ente di","lv":"ir libretists (institūcija)","nl":"is librettist-corporatie van","no":"er librettist for (korporasjon)","tr":"libretto yazarı tüzel kişisidir","zh-Hans-CN":"是……的台本作者团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن تأليف كلمات الأوبرا أو غيرها من أعمال المسرح الموسيقي، أو موشحات دينية."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for authoring the words of an opera or other musical stage work, or an oratorio."],"es":["Relaciona un organismo corporativo con una obra que involucra la responsabilidad de un organismo corporativo de ser el autor de las palabras de una ópera u otra obra musical en escena o un oratorio."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av å være forfatter av ordene i en opera eller annet verk for en musikalsk scene, eller et oriatorium."],"tr":["Bir tüzel kişiyi, Bir opera veya diğer müzikal sahne eserinin veya bir oratoryonun sözlerinin yazılmasında bir tüzel kişinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن وضع لكلمات الأوبرا","ca":"entitat corporativa llibretista de","cs":"libretista (korporace) (čeho)","da":"korporation, som er librettist af","de":"Körperschaft als Librettistin/Librettist von","de":"Körperschaft als Librettistin/Librettist von","el":"λιμπρετίστας συλλογικό όργανο του","en":"librettist corporate body of","es":"organismo corporativo libretista de","et":"libretist (asutus) teoses","fi":"libretisti (yhteisö) teoksessa","fr":"collectivité librettiste de","hu":"librettista testülete:","it":"librettista ente di","lv":"ir libretists (institūcija)","nl":"librettist-corporatie van","no":"librettist for (korporasjon)","tr":"Opera metni yazarı tüzel kişisi","zh-Hans-CN":"……的台本作者团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن تأليف كلمات الأوبرا أو غيرها من أعمال المسرح الموسيقي، أو موشحات دينية.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori.","cs":"Dílo, které zahrnuje odpovědnost korporace za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria.","da":"Værk, som involverer en korporations ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium.","de":"Ein Werk, bei dem eine Körperschaft für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","en":"A work that involves a responsibility of a corporate body for authoring the words of an opera or other musical stage work, or an oratorio.","es":"Una obra que involucra la responsabilidad de un organismo corporativo de ser el autor de las palabras de una ópera u otra obra musical en escena o un oratorio.","et":"Teos, mis sisaldab asutuse vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest.","fi":"Teos, jossa yhteisö on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért.","it":"Opera che implica una responsabilità di un ente come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio.","lv":"Darbs, kas ietver institūcijas atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium.","no":"Et verk som involverer et ansvar for en korporasjon i form av å være forfatter av ordene i en opera eller annet verk for en musikalsk scene, eller et oriatorium.","tr":"Bir opera veya diğer müzikal sahne eserinin veya bir oratoryonun sözlerinin yazılmasında bir tüzel kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个团体的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
