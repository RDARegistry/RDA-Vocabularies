                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/student.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50316", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPersonOfPerson.en", "label":"has related person of person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50281", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/student.en", "label":"has student"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50281", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/student.en", "label":"has student"}]},{"@id":"http://rdaregistry.info/Elements/a/P50288","label":{"ar":"هو طالب لـ","ca":"és estudiant a","cs":"je studentem na","da":"er studerende på","de":"ist Studentin/Student an","de":"ist Studentin/Student an","el":"είναι φοιτητής σε","en":"is student at","es":"es estudiante en","et":"õppur asutuses","fi":"oppilaitos","fr":"est un élève à","hu":"tanulója a következőnek:","it":"è studente presso","lv":"ir izglītojies","nl":"is student aan","no":"er student ved","tr":"… de/da öğrencidir","zh-Hans-CN":"是……处的学生"},"definition":{"ar":["يربط شخصا بهيئة هي مؤسسة تعليمية تقدم التعليم لشخص."],"ca":["Relaciona una persona amb una entitat corporativa que és una institució educativa que proporciona instrucció a una persona."],"cs":["Vztahuje osobu ke korporaci, která je vzdělávací institucí, která poskytuje instrukce osobě."],"da":["Relaterer en person til en korporation, som er en uddannelsesinstitution, som giver undervisning til en person."],"de":["Setzt eine Person in Beziehung zu einer Bildungseinrichtung (Körperschaft), die einer Person Unterricht erteilt.,Setzt eine Person in Beziehung zu einer Bildungseinrichtung (Körperschaft), die einer Person Unterricht erteilt."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα εκπαιδευτικό ίδρυμα, το οποίο παρέχει οδηγίες σε ένα φυσικό πρόσωπο."],"en":["Relates a person to a corporate body who is an educational institution that provides instruction to a person."],"es":["Relaciona una persona con un organismo corporativo que es una institución educativa que provee instrucción a una persona."],"et":["Seostab isiku haridusasutusega, kes pakub isikule õpetust."],"fi":["Liittää henkilön oppilaitokseen, joka antaa opetusta henkilölle."],"fr":["Met une personne en relation avec une collectivité qui consiste en un établissement d’enseignement fournissant un enseignement à une personne."],"hu":["Hozzákapcsol egy személyt egy oktatási intézmény testülethez, amely oktatást nyújt egy személy számára."],"it":["Correla una persona a un ente che è un'istituzione scolastica che fornisce istruzione a una persona."],"lv":["Sasaista personu ar institūciju, kur persona studē."],"nl":["Relateert een persoon aan een corporatie die een onderwijsinstelling is die onderricht geeft aan een persoon."],"no":["Relaterer en person til en korporasjon som er en utdanningsinstitusjon som gir en person opplæring."],"tr":["Bir kişiyi, bir kişiye eğitim veren bir eğitim kurumu olan bir tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一个个人与作为教育机构为一个个人提供教学的一个团体关联起来。"]},"ToolkitLabel":{"ar":"طالب في","ca":"estudiant a","cs":"student na","da":"studerende på","de":"Studentin/Student an","de":"Studentin/Student an","el":"φοιτητής σε","en":"student at","es":"estudiante en","et":"õppur asutuses","fi":"oppilaitos","fr":"élève à","hu":"tanulója:","it":"studente presso","lv":"ir izglītojies","nl":"student aan","no":"student ved","tr":"… de/da öğrenci","zh-Hans-CN":"……处的学生"},"ToolkitDefinition":{"ar":"هيئة هي مؤسسة تعليمية توفر التعليم لشخص.","ca":"Entitat corporativa que és una institució educativa que proporciona instrucció a una persona.","cs":"Korporace, která je vzdělávací institucí, která poskytuje instrukce osobě.","da":"Kor