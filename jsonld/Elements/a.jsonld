                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50192", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistAgentOf.en", "label":"is artist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50695", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistCollectiveAgentOf.en", "label":"is book artist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50544", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistPersonOf.en", "label":"is book artist person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50247", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/bookArtistAgentOf.en", "label":"is book artist agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50247", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/bookArtistAgentOf.en", "label":"is book artist agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50695","label":{"ar":"هو وكيل جماعي رسام كتب مصورة لـ","ca":"és agent col·lectiu artista de llibre d’art de","cs":"je knižním výtvarníkem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er bogkunstner af","de":"ist gemeinschaftlicher Akteur als Buchkünstlerin/Buchkünstler von","de":"ist gemeinschaftlicher Akteur als Buchkünstlerin/Buchkünstler von","el":"είναι βιβλίο του καλλιτέχνη συλλογικός φορέας του ?","en":"is book artist collective agent of","es":"es agente colectivo artista de libros de","et":"raamatukunstnik (kollektiiv) teoses","fi":"kirjataiteilija (yhteistoimija) teoksessa","fr":"est un agent collectif artiste du livre de","hu":"könyvművész kollektív ágense a következőnek:","it":"è book artist agente collettivo di","lv":"ir grāmatu mākslinieks (grupa)","nl":"is boekkunstenaar-collectieve actor van","no":"er bokkunstner for (kollektiv agent)","tr":"kitap sanatçısı kollektif temsilcisidir","zh-Hans-CN":"是……的图书美术家集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن استغلال شكل الكتاب أو تغيير بنيته المادية."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en l’explotació de la forma llibre o en la modificació de la seva estructura física."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za zpracování podoby knihy nebo změnu její fyzické struktury."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at udnytte bogformen eller ændre dens fysiske struktur."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for exploiting the book form or altering its physical structure."],"es":["Relaciona un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de explotar la forma del libro o alterar su estructura física."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à exploiter la forme livre ou à modifier sa structure physique."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége a könyvforma kiaknázásáért vagy fizikai szerkezetének megváltoztatásáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per la valorizzazione del formato del libro o l'alterazione della sua struttura fisica."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par grāmatas formas izmantošanu vai tās fiziskās struktūras pārveidošanu."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het benutten van de vorm van het boek of veranderen van de fysieke structuur."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å utnytte bokformatet eller endre dets fysiske struktur."],"tr":["Kollektif bir temsilciyi, kitap formunu kullanmak veya bu formun fiziksel yapısını değiştirmek için kolektif bir temsilcinin sorumluluğunu gerektiren bir eseri ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及开发图书外形或改变其物理结构的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي رسام كتب مصورة","ca":"agent col·lectiu artista de llibre d’art de","cs":"knižní výtvarník (kolektivní agent) (čeho)","da":"kollektiv agent, som er bogkunstner af","de":"Gemeinschaftlicher Akteur als Buchkünstlerin/Buchkünstler von","de":"Gemeinschaftlicher Akteur als Buchkünstlerin/Buchkünstler von","el":"βιβλίο του καλλιτέχνη συλλογικός φορέας του ?","en":"book artist collective agent of","es":"agente colectivo artista de libros de","et":"raamatukunstnik (kollektiiv) teoses","fi":"kirjataiteilija (yhteistoimija) teoksessa","fr":"agent collectif artiste du livre de","hu":"könyvművész kollektív ágense:","it":"book artist agente collettivo di","lv":"ir grāmatu mākslinieks (grupa)","nl":"boekkunstenaar-collectieve actor van","no":"bokkunstner for