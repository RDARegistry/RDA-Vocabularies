                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/conductorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50603", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerPersonOf.en", "label":"is performer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50070", "lexicalAlias":"http://rdaregistry.info/Elements/a/conductorAgentOf.en", "label":"is conductor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50589", "lexicalAlias":"http://rdaregistry.info/Elements/a/choralConductorPersonOf.en", "label":"is choral conductor person of"},{"@id":"http://rdaregistry.info/Elements/a/P50575", "lexicalAlias":"http://rdaregistry.info/Elements/a/instrumentalConductorPersonOf.en", "label":"is instrumental conductor person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50592", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/conductorPersonOf.en", "label":"is conductor person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50592", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/conductorPersonOf.en", "label":"is conductor person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50211","label":{"ar":"هو وكيل مرسل إليه لـ","ca":"és agent consultor de","cs":"je konzultantem (agentem) (čeho)","da":"er agent, som er rådgiver af","de":"ist Akteur als Beraterin/Berater von","de":"ist Akteur als Beraterin/Berater von","el":"είναι σύμβουλος φορέας του","en":"is consultant agent of","es":"es agente consultor de","et":"konsultant (tegija) teoses","fi":"asiantuntija (toimija) teoksessa","fr":"est un agent consultant de","hu":"tanácsadó ágense a következőnek:","it":"è consulente agente di","lv":"ir konsultants (aģents)","nl":"is consultant-actor van","no":"er konsulent for (agent)","tr":"danışman temsilcisidir","zh-Hans-CN":"是……的顾问行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن تقديم خدمات استشارية، وغالبا ما يقدم مقترحات إلى منشئ عمل."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent proporcionant serveis d’assessorament, i que sovint fa recomanacions, a un creador d’una obra."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za poskytování konzultačních služeb a často též doporučení tvůrci díla."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at yde rådgivning og ofte komme med anbefalinger til et ophav til et værk."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur einer geistigen Schöpferin/einem geistigen Schöpfer eines Werks Beratungsdienste anbietet und Empfehlungen macht.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur einer geistigen Schöpferin/einem geistigen Schöpfer eines Werks Beratungsdienste anbietet und Empfehlungen macht."],"el":["Συνδέει έναν φορέα που παρέχει υπηρεσίες συμβουλευτικής και συχνά κάνει συστάσεις σε κάποιον άλλον φορέα, ο οποίος αναπαρίσταται ως ο δημιουργός ενός έργου, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for providing consultation services, and often making recommendations, to a creator of a work."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de proveer servicios de consultoría, y frecuentemente hacer recomendaciones, a un creador de una obra."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust konsultatsiooni ja sageli ka soovituste andmise eest teose autorile."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa asiantuntijapalveluiden tarjoamisesta ja suositusten antamisesta teoksen tekijälle."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à fournir des services de consultation et souvent à faire des recommandations à un créateur d’une œuvre."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége tanácsadó szolgáltatásért és gyakran egy mű létrehozójának tett javaslatokért is."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente nel fornire servizi di consulenza, spesso facendo raccomandazioni, al creatore dell'opera."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par konsultāciju pakalpojumu un ieteikumu sniegšanu citam aģentam, kas ir darba radītājs."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het leveren van diensten van raadgeving, en vaak het doen van aanbevelingen, aan een maker van een werk."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av å levere konsulenttjenester og ofte å gi anbefalinger til en opphaver av et verk."],"tr":["Bir temsilciyi, bir eserin yaratıcısına danışmanlık hizmeti sağlama ve genellikle tavsiyelerde bulunmaya ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及向作品创作者提供咨询服务并经常提供建议的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هو وكيل مرسل إليه لـ","ca":"agent consultor de","cs":"konzultant (agent) (čeho)","da":"agent, som er rådgiver af","de":"Akteur als Beraterin/Berater von","de":"Akteur als Beraterin/Berater von","el":"σύμβουλος φορέας του","en":"consultant agent of","es":"agente consultor de","et":"konsultant (tegija) teoses","fi":"asiantuntija (toimija) teoksessa","fr":"agent consultant de","hu":"tanácsadó ágense:","it":"consulenteagente di","lv":"ir konsultants (aģents)","nl":"consultant-actor van","no":"konsulent for (agent)","tr":"danışman temsilcisi","zh-Hans-CN":"……的顾问行为者"},"ToolkitDefinition":{"ar":"يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن تقديم خدمات استشارية، وغالبا ما يقدم مقترحات إلى منشئ عمل.","ca":"Obra que implica una responsabilitat d’un agent proporcionant serveis d’assessorament, i que sovint fa recomanacions, a un creador d’una obra.","cs":"Dílo, které zahrnuje odpovědnost agenta za poskytování konzultačních služeb a často též doporučení tvůrci díla.","da":"Værk, som involverer en agents ansvar for at yde rådgivning og ofte komme med anbefalinger til et ophav til et værk.","de":"Ein Werk, bei dem ein Akteur einer geistigen Schöpferin/einem geistigen Schöpfer Beratungsdienste anbietet und häufig Empfehlungen macht.","de":"Ein Werk, bei dem ein Akteur einer geistigen Schöpferin/einem geistigen Schöpfer Beratungsdienste anbietet und häufig Empfehlungen macht.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της παροχής υπηρεσιών συμβουλευτικής και συχνά κάνει συστάσεις σε κάποιον άλλον φορέα, ο οποίος αναπαρίσταται ως ο δημιουργός ενός έργου.","en":"A work that involves a responsibility of an agent for providing consultation services, and often making recommendations, to a creator of a work.","es":"Una obra que involucra una responsabilidad de un agente de proveer servicios de consultoría, y frecuentemente hacer recomendaciones, a un creador de una obra.","et":"Teos, mis sisaldab tegija vastutust konsultatsiooni ja sageli ka soovituste andmise eest teose autorile.","fi":"Teos, jossa toimija on vastuussa asiantuntijapalveluiden tarjoamisesta ja suositusten antamisesta teoksen tekijälle.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à fournir des services de consultation et souvent à faire des recommandations à un créateur d’une œuvre.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége tanácsadó szolgáltatásért és gyakran egy mű létrehozójának tett javaslatokért is.","it":"Opera che implica la responsabilità di un agente nel fornire servizi di consulenza, spesso facendo raccomandazioni, al creatore dell'opera.","lv":"Darbs, kas ietver aģenta atbildību par konsultāciju pakalpojumu un ieteikumu sniegšanu citam aģentam, kas ir darba radītājs.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het leveren van diensten van raadgeving, en vaak het doen van aanbevelingen, aan een maker van een werk.","no":"Et verk som involverer ansvar for en agent i form av å levere konsulenttjenester og ofte å gi anbefalinger til en opphaver av et verk.","tr":"Bir eserin yaratıcısına danışmanlık hizmetleri sağlama ve genellikle tavsiyelerde bulunma konusunda bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及向作品创作者提供咨询服务并经常提供建议的一个行为者的责任的一种作品"},"altLabel":{"ar":["استشاري"],"ca":["consultor de"],"cs":["konzultant (čeho)"],"da":["rådgiver af"],"de":["Berater von,Berater von"],"el":["σύμβουλος του"],"en":["consultant of"],"es":["consultor de"],"et":["konsultant teoses"],"fi":["asiantuntijana teoksessa"],"fr":["consultant de"],"hu":["tanácsadója:"],"it":["consulente di"],"nl":["consultant van"],"no":["konsulent for"],"tr":["danışman"],"zh-Hans-CN":["……的顾问"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
