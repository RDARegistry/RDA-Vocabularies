                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/visualEffectsProviderCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50925", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCorporateBodyToPerformanceOf.en", "label":"is contributor corporate body to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50732", "lexicalAlias":"http://rdaregistry.info/Elements/a/visualEffectsProviderCollectiveAgentOf.en", "label":"is visual effects provider collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50883", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/visualEffectsProviderCorporateBodyOf.en", "label":"is visual effects provider corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50883", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/visualEffectsProviderCorporateBodyOf.en", "label":"is visual effects provider corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51034","label":{"ar":"هي عائلة موردة للمؤثرات المرئية لـ","ca":"és família proveïdora d’efectes visuals de","cs":"je poskytovatelem vizuálních efektů (rodinou) (čeho)","da":"er familie, som er leverandør af visuelle effekter af","de":"ist Familie als Visual-effects-Provider von","de":"ist Familie als Visual-effects-Provider von","el":"είναι παροχέας οπτικών αποτελεσμάτων οικογένεια του","en":"is visual effects provider family of","es":"es familia proveedora de efectos visuales de","et":"visuaalefektide tootja (perekond) väljenduses","fi":"visuaalisten tehosteiden tekijä (suku) ekspressiossa","fr":"est une famille fournisseuse d’effets visuels de","hu":"vizuális effektusokat szolgáltató családja a következőnek:","it":"è curatore degli effetti visivi famiglia di","lv":"ir vizuālo efektu mākslinieks (dzimta/ģimene)","nl":"is aanbieder visuele effecten-familie van","no":"er leverandør av visuelle effekter for (familie)","tr":"görsel efektler sağlayıcı ailesidir","zh-Hans-CN":"是……的视觉效果提供者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في تصميم وإنشاء مؤثرات مرئية لما بعد الإنتاج."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família en el disseny i la creació dels efectes visuals de postproducció."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny za návrh a tvorbu postprodukčních vizuálních efektů."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at designe og skabe visuelle effekter efter produktionen."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt."],"en":["Relates a family to an expression that includes a contribution by a family of designing and creating post-production visual effects."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de diseñar y crear efectos visuales en postproducción."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, kavandades ja luues järelproduktsiooni ajal visuaalseid efekte."],"fi":["Liittää suvun ekspressioon, jossa suku on osallisena liikkuvan kuvan teoksen ekspression tekemisessä suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à concevoir et à créer des effets visuels en postproduction."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését utómunkálati vizuális effektusok tervezésében és létrehozásában."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nella progettazione e creazione di effetti visivi in post-produzione."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, izstrādājot un radot kustīga attēla pēcapstrādes vizuālos efektus."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door ontwerpen en creëren van post-productie visuele effecten."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å utforme og skape visuelle effekter i etterproduksjon."],"tr":["Bir aileyi, post prodüksiyon görsel efektleri tasarlayan ve yaratan bir ailenin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括设计并创作制作后视觉效果的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة موردة للمؤثرات المرئية","ca":"família proveïdora d’efectes visuals de","cs":"poskytovatel vizuálních efektů (rodina) (čeho)","da":"familie, som er leverandør af visuelle effekter af","de":"Familie als Visual-effects-Provider von","de":"Familie als Visual-effects-Provider von","el":"παροχέας οπτικών αποτελεσμάτων οικογένεια του","en":"visual effects provider family of","es":"familia proveedora de efectos visuales de","et":"visuaalefektide tootja (perekond) väljenduses","fi":"visuaalisten tehosteiden tekijä (suku) ekspressiossa","fr":"famille fournisseuse d’effets visuels de","hu":"vizuális effektusokat szolgáltató családja:","it":"curatore degli effetti visivi famiglia di","lv":"ir vizuālo efektu mākslinieks (dzimta/ģimene)","nl":"aanbieder visuele effecten-familie van","no":"leverandør av visuelle effekter for (familie)","tr":"görsel efekt sağlayıcı aile","zh-Hans-CN":"……的视觉效果提供者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في تصميم وإنشاء مؤثرات مرئية لما بعد الإنتاج.","ca":"Expressió que inclou una contribució d’una família en el disseny i la creació dels efectes visuals de postproducció.","cs":"Vyjádření, které zahrnuje přispění rodiny za návrh a tvorbu postprodukčních vizuálních efektů.","da":"Udtryk, som omfatter en families bidrag ved at designe og skabe visuelle effekter efter produktionen.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt.","en":"An expression that includes a contribution by a family of designing and creating post-production visual effects.","es":"Una expresión que incluye una contribución de una familia de diseñar y crear efectos visuales en postproducción.","et":"Väljendus, millesse perekond on andnud panuse, kavandades ja luues järelproduktsiooni ajal visuaalseid efekte.","fi":"Ekspressio, jossa suku on osallisena liikkuvan kuvan teoksen ekspression tekemisessä suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à concevoir et à créer des effets visuels en postproduction.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését utómunkálati vizuális effektusok tervezésében és létrehozásában.","it":"Espressione che comprende un contributo di una famiglia nella progettazione e creazione di effetti visivi in post-produzione.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, izstrādājot un radot kustīga attēla pēcapstrādes vizuālos efektus.","nl":"Een expressie die omvat een bijdrage door een familie door ontwerpen en creëren van post-productie visuele effecten.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å utforme og skape visuelle effekter i etterproduksjon.","tr":"Prodüksiyon sonrası görsel efektleri tasarlayan ve yaratan bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括设计并创作制作后视觉效果的一个家族的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/visualEffectsProviderFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51076", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorFamilyToPerformanceOf.en", "label":"is contributor family to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50732", "lexicalAlias":"http://rdaregistry.info/Elements/a/visualEffectsProviderCollectiveAgentOf.en", "label":"is visual effects provider collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51034", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/visualEffectsProviderFamilyOf.en", "label":"is visual effects provider family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51034", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/visualEffectsProviderFamilyOf.en", "label":"is visual effects provider family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50581","label":{"ar":"هو شخص مورد مؤثرات مرئية لـ","ca":"és persona proveïdora d’efectes visuals de","cs":"je poskytovatelem vizuálních efektů (osobou) (čeho)","da":"er person, som er leverandør af visuelle effekter af","de":"ist Person als Visual-effects-Provider von","de":"ist Person als Visual-effects-Provider von","el":"είναι παροχέας οπτικών αποτελεσμάτων φυσικό πρόσωπο του","en":"is visual effects provider person of","es":"es proveedor de efectos visuales de","et":"visuaalefektide tootja (isik) väljenduses","fi":"visuaalisten tehosteiden tekijä (henkilö) ekspressiossa","fr":"est une personne fournisseuse d’effets visuels de","hu":"vizuális effektusokat szolgáltató személye a következőnek:","it":"è curatore degli effetti visivi persona di","lv":"ir vizuālo efektu mākslinieks (persona)","nl":"is aanbieder visuele effecten-persoon van","no":"er leverandør av visuelle effekter for (person)","tr":"görsel efektler sağlayan kişidir","zh-Hans-CN":"是……的视觉效果提供者个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص في تصميم وإنشاء مؤثرات مرئية لما بعد الإنتاج."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona en el disseny i la creació dels efectes visuals de postproducció."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby za návrh a tvorbu postprodukčních vizuálních efektů."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at designe og skabe visuelle effekter efter produktionen."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt."],"en":["Relates a person to an expression that includes a contribution by a person of designing and creating post-production visual effects."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona en el diseño y creación de efectos visuales de postproducción."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, kavandades ja luues järelproduktsiooni ajal visuaalseid efekte."],"fi":["Liittää henkilön ekspressioon, jossa henkilö on osallisena liikkuvan kuvan teoksen ekspression tekemisessä suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à concevoir et à créer des effets visuels en postproduction."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését utómunkálati vizuális effektusok tervezésében és létrehozásában."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nella progettazione e creazione di effetti visivi in post-produzione."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, izstrādājot un radot kustīga attēla pēcapstrādes vizuālos efektus."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door ontwerpen en creëren van post-productie visuele effecten."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å utforme og skape visuelle effekter i etterproduksjon."],"tr":["Bir kişiyi, bir kişinin post prodüksiyon görsel efektleri tasarlama ve oluşturma katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括设计并创作制作后视觉效果的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص مورد مؤثرات مرئية","ca":"persona proveïdora d’efectes visuals de","cs":"poskytovatel vizuálních efektů (osoba) (čeho)","da":"person, som er leverandør af visuelle effekter af","de":"Person als Visual-effects-Provider von","de":"Person als Visual-effects-Provider von","el":"παροχέας οπτικών αποτελεσμάτων φυσικό πρόσωπο του","en":"visual effects provider person of","es":"proveedor de efectos visuales de","et":"visuaalefektide tootja (isik) väljenduses","fi":"visuaalisten tehosteiden tekijä (henkilö) ekspressiossa","fr":"personne fournisseuse d’effets visuels de","hu":"vizuális effektusokat szolgáltató személye:","it":"curatore degli effetti visivi persona di","lv":"ir vizuālo efektu mākslinieks (persona)","nl":"aanbieder visuele effecten-persoon van","no":"leverandør av visuelle effekter for (person)","tr":"görsel efekt sağlayıcı kişi","zh-Hans-CN":"……的视觉效果提供者个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص في تصميم وإنشاء مؤثرات مرئية لما بعد الإنتاج.","ca":"Expressió que inclou una contribució d’una persona en el disseny i la creació dels efectes visuals de postproducció.","cs":"Vyjádření, které zahrnuje přispění osoby za návrh a tvorbu postprodukčních vizuálních efektů.","da":"Udtryk, som omfatter en persons bidrag ved at designe og skabe visuelle effekter efter produktionen.","de":"Eine Expression, zu der eine Person beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie in der Postproduktion visuelle Effekte entwirft und erstellt.","en":"An expression that includes a contribution by a person of designing and creating post-production visual effects.","es":"Una expresión que incluye una contribución de una persona en el diseño y creación de efectos visuales de postproducción.","et":"Väljendus, millesse isik on andnud panuse, kavandades ja luues järelproduktsiooni ajal visuaalseid efekte.","fi":"Ekspressio, jossa henkilö on osallisena liikkuvan kuvan teoksen ekspression tekemisessä suunnittelemalla ja luomalla visuaaliset tehosteet jälkituotantovaiheessa.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à concevoir et à créer des effets visuels en postproduction.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését utómunkálati vizuális effektusok tervezésében és létrehozásában.","it":"Espressione che comprende un contributo di una persona nella progettazione e creazione di effetti visivi in post-produzione.","lv":"Izteiksme, kas ietver personas ieguldījumu, izstrādājot un radot kustīga attēla pēcapstrādes vizuālos efektus.","nl":"Een expressie die omvat een bijdrage door een persoon door ontwerpen en creëren van post-productie visuele effecten.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å utforme og skape visuelle effekter i etterproduksjon.","tr":"Prodüksiyon sonrası görsel efektleri tasarlayan ve yaratan bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括设计并创作制作后视觉效果的一个个人的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/visualEffectsProviderPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50243", "lexicalAlias":"http://rdaregistry.info/Elements/a/visualEffectsProviderAgentOf.en", "label":"is visual effects provider agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50581", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/visualEffectsProviderPersonOf.en", "label":"is visual effects provider person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50581", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/visualEffectsProviderPersonOf.en", "label":"is visual effects provider person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50217","label":{"ar":"هو وكيل ممثل صوتي لـ","ca":"és agent actor de veu de","cs":"je hlasovým hercem (agentem) (čeho)","da":"er agent, som er dubber af","de":"ist Akteur als Sprecherin/Sprecher einer Rolle von","de":"ist Akteur als Sprecherin/Sprecher einer Rolle von","el":"είναι ηθοποιός φωνής φορέας του","en":"is voice actor agent of","es":"es agente actor de voz de","et":"hääle esitaja (tegija) väljenduses","fi":"ääninäyttelijä (toimija) ekspressiossa","fr":"est un agent acteur vocal de","hu":"szinkronszínész ágense a következőnek:","lv":"ir balss aktieris (aģents)","nl":"is stemacteur-actor van","no":"er stemmeskuespiller for (agent)","tr":"seslendirme sanatçısı temsilcisidir","zh-Hans-CN":"是……的声音演员行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht."],"el":["Συνδέει έναν ηθοποιό, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου δανείζοντας τη φωνή του για τους χαρακτήρες ραδιοφωνικών και ακουστικών παραγωγών και για έργα κινουμένων σχεδίων, καθώς επίσης για αφηγήσεις σε ραδιοτηλεοπτικές διαφημίσεις, μεταγλωττισμένες εκφράσεις κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede uttrykk, etc."],"tr":["Bir temsilciyi, radyo ve ses yapımlarındaki karakterler ve hareketli görüntü eserlerindeki animasyon karakterlerini seslendirmenin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. konusunda ses veren bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل ممثل صوتي","ca":"agent actor de veu de","cs":"hlasový herec (agent) (čeho)","da":"agent, som er dubber af","de":"Akteur als Sprecherin/Sprecher einer Rolle von","de":"Akteur als Sprecherin/Sprecher einer Rolle von","el":"ηθοποιός φωνής φορέας του","en":"voice actor agent of","es":"agente actor de voz de","et":"hääle esitaja (tegija) väljenduses","fi":"ääninäyttelijä (toimija) ekspressiossa","fr":"agent acteur vocal de","hu":"szinkronszínész ágense:","lv":"ir balss aktieris (aģents)","nl":"stemacteur-actor van","no":"stemmeskuespiller for (agent)","tr":"seslendirme sanatçısı temsilcisi","zh-Hans-CN":"……的声音演员行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ.","ca":"Expressió que inclou una contribució d’un agent prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd","da":"Udtryk, som omfatter en agents bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","el":"Μια έκφραση που ενσωματώνει τη συνεισφορά της υποκριτικής μέσω του δανεισμού φωνής για χαρακτήρες ραδιοφωνικών και ακουστικών παραγωγών και για έργα κινουμένων σχεδίων, καθώς επίσης για αφηγήσεις σε ραδιοτηλεοπτικές διαφημίσεις, μεταγλωττισμένες εκφράσεις κ.λπ.","en":"An expression that includes a contribution by an agent of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc.","es":"Una expresión que incluye una contribución de un agente de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc.","et":"Väljendus, millesse tegija on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml.","nl":"Een expressie die omvat een bijdrage door een actor in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede uttrykk, etc.","tr":"Radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü işlerindeki animasyon karakterlerinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. için bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["ممثل صوتي"],"ca":["intèrpret de veu de"],"cs":["hlasový herec (čeho)"],"da":["dubber af"],"de":["Synchronsprecher von,Synchronsprecher von"],"el":["ηθοποιός φωνής του"],"en":["voice actor of"],"es":["actor de voz de"],"et":["hääle esitaja väljenduses"],"fi":["ääninäyttelijänä tallenteessa"],"fr":["voix de"],"hu":["szinkronszínésze:"],"nl":["stemacteur van"],"no":["stemmeskuespiller for"],"tr":["seslendirme sanatçısı"],"zh-Hans-CN":["……的声音演员"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50071", "lexicalAlias":"http://rdaregistry.info/Elements/a/actorAgentOf.en", "label":"is actor agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50758", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCollectiveAgentOf.en", "label":"is voice actor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50607", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorPersonOf.en", "label":"is voice actor person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50217", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/voiceActorAgentOf.en", "label":"is voice actor agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50217", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/voiceActorAgentOf.en", "label":"is voice actor agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50758","label":{"ar":"هو وكيل جماعي ممثل صوتي لـ","ca":"és agent col·lectiu actor de veu de","cs":"je hlasovým hercem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er dubber af","de":"ist gemeinschaftlicher Akteur als Synchronsprecherin/Synchronsprecher von","de":"ist gemeinschaftlicher Akteur als Synchronsprecherin/Synchronsprecher von","el":"είναι ηθοποιός φωνής συλλογικός φορέας του","en":"is voice actor collective agent of","es":"es agente colectivo actor de voz de","et":"hääle esitaja (kollektiiv) väljenduses","fi":"ääninäyttelijä (yhteistoimija) ekspressiossa","fr":"est un agent collectif acteur vocal de","hu":"szinkronszínész kollektív ágense a következőnek:","it":"è doppiatore agente collettivo di","lv":"ir balss aktieris (grupa)","nl":"is stemacteur-collectieve actor van","no":"er stemmeskuespiller for (kollektiv agent)","tr":"seslendirme sanatçısı kolektif temsilcisidir","zh-Hans-CN":"是……的声音演员集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام شخص بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd"],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms."],"fi":["Liittää yhteistoimijan ekspressioon, jossa yhteistoimija on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat."],"it":["Correla un agente collettivo a un'espressione che comprende il contributo di un agente collettivo nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc."],"tr":["Kolektif bir temsilciyi, radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü çalışmalarındaki animasyon karakterlerin yanı sıra radyo ve televizyon reklamlarındaki seslendirmelerin, dublajlı ifadeler vb. için kolektif bir temsilcinin katkısını içeren bir anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括为在广和音频播制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي ممثل صوتي","ca":"agent col·lectiu actor de veu de","cs":"hlasový herec (kolektivní agent) (čeho)","da":"kollektiv agent, som er dubber af","de":"Gemeinschaftlicher Akteur als Synchronsprecherin/Synchronsprecher von","de":"Gemeinschaftlicher Akteur als Synchronsprecherin/Synchronsprecher von","el":"ηθοποιός φωνής συλλογικός φορέας του","en":"voice actor collective agent of","es":"agente colectivo actor de voz de","et":"hääle esitaja (kollektiiv) väljenduses","fi":"ääninäyttelijä (yhteistoimija) ekspressiossa","fr":"agent collectif acteur vocal de","hu":"szinkronszínész kollektív ágense:","it":"doppiatore agente collettivo di","lv":"ir balss aktieris (grupa)","nl":"stemacteur-collectieve actor van","no":"stemmeskuespiller for (kollektiv agent)","tr":"seslendirme sanatçısı kolektif temsilcisi","zh-Hans-CN":"……的声音演员集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ.","ca":"Expressió que inclou una contribució d’un agent col·lectiu prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er seine Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","en":"An expression that includes a contribution by a collective agent of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc.","es":"Una expresión que incluye una contribución de un agente colectivo de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc.","et":"Väljendus, millesse kollektiiv on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms.","fi":"Ekspressio, jossa yhteistoimija on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat.","it":"Espressione che comprende un contributo di un agente collettivo nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc.","lv":"Izteiksme, kas ietver grupas ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml.","nl":"Een expressie die omvat een bijdrage door een collectieve actor in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc.","tr":"Radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü işlerindeki animasyon karakterlerinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı ifadeler vb. için kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个集体行为者的贡献的一种内容表达"},"altLabel":{"de":["Gemeinschaftlicher Akteur als Synchronsprecherin/Synchronsprecher von"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50719", "lexicalAlias":"http://rdaregistry.info/Elements/a/actorCollectiveAgentOf.en", "label":"is actor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50217", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorAgentOf.en", "label":"is voice actor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50909", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCorporateBodyOf.en", "label":"is voice actor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51060", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorFamilyOf.en", "label":"is voice actor family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50758", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/voiceActorCollectiveAgentOf.en", "label":"is voice actor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50758", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/voiceActorCollectiveAgentOf.en", "label":"is voice actor collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50909","label":{"ar":"هي هيئة ممثلة صوتية لـ","ca":"és entitat corporativa actriu de veu de","cs":"je hlasovým hercem (korporací) (čeho)","da":"er korporation, som er dubber af","de":"ist Körperschaft als Sprecherin/Sprecher einer Rolle von","de":"ist Körperschaft als Sprecherin/Sprecher einer Rolle von","el":"είναι ηθοποιός φωνής συλλογικό όργανο του","en":"is voice actor corporate body of","es":"es organismo corporativo actor de voz de","et":"hääle esitaja (asutus) väljenduses","fi":"ääninäyttelijä (yhteisö) ekspressiossa","fr":"est une collectivité actrice vocale de","hu":"szinkronszínész testülete a következőnek:","it":"è doppiatore ente di","lv":"ir balss aktieris (institūcija)","nl":"is stemacteur-corporatie van","no":"er stemmeskuespiller for (korporasjon)","tr":"Seslendirme sanatçısı tüzel kişisidir","zh-Hans-CN":"是……的声音演员团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms."],"fi":["Liittää yhteisön ekspressioon, jossa yhteisö on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc."],"tr":["Bir tüzel kişiyi, radyo ve seslendirme yapımlarında, hareketli görüntü çalışmalarında animasyon karakterlerini seslendirme, radyo ve televizyon reklamlarında seslendirme, dublajlı anlatımlar gibi bir tüzel kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة ممثلة صوتية","ca":"entitat corporativa actriu de veu de","cs":"hlasový herec (korporace) (čeho)","da":"korporation, som er dubber af","de":"Körperschaft als Sprecherin/Sprecher einer Rolle von","de":"Körperschaft als Sprecherin/Sprecher einer Rolle von","el":"ηθοποιός φωνής συλλογικό όργανο του","en":"voice actor corporate body of","es":"organismo corporativo actor de voz de","et":"hääle esitaja (asutus) väljenduses","fi":"ääninäyttelijä (yhteisö) ekspressiossa","fr":"collectivité actrice vocale de","hu":"szinkronszínész testülete:","it":"doppiatore ente di","lv":"ir balss aktieris (institūcija)","nl":"stemacteur-corporatie van","no":"stemmeskuespiller for (korporasjon)","tr":"seslendirme sanatçısı tüzel kişisi","zh-Hans-CN":"……的声音演员团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة بالتمثيل الصوتي لشخصيات في إنتاج إذاعي وسمعي، وشخصيات كرتونية في أعمال الصور المتحركة، إضافة إلى التعليق الصوتي في إعلانات الإذاعة والتليفزيون، والتعبيرات المدبلجة، إلخ.","ca":"Expressió que inclou una contribució d’una entitat corporativa prestant la seva veu als personatges de les produccions radiofòniques i d’àudio i als personatges animats de les obres d’imatge en moviment, així com les veus en off en els anuncis publicitaris de ràdio i televisió, les expressions doblades, etc.","cs":"Vyjádření, které zahrnuje přispění korporace tím, že propůjčuje hlas postavám v rozhlasové a zvukové produkci a animovaným postavám v pohyblivém obrazu (dílech) a rovněž poskytuje voice-over v rozhlasových a televizních reklamách, dabovaných vyjádřeních atd.","da":"Udtryk, som omfatter en korporations bidrag ved at lægge stemme til figurer i radio- og audioproduktioner og til animerede figurer i levende billedværker, og tillige ved at indtale voice-overs i radio- og tv-reklamer, eftersynkroniserede udtryk etc.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht und Begleitkommentare in Hörfunk- oder Fernsehwerbung, untertitelten Expressionen und so weiter zur Verfügung stellt.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie ihre Stimme Charakteren in Hörfunk- und Audioproduktionen und animierten Charakteren in Bewegtbildwerken leiht, sowie Stimmen in Hörfunk- und Fernsehwerbung, in synchronisierten Ressourcen und so weiter spricht.","en":"An expression that includes a contribution by a corporate body of providing the voice for characters in radio and audio productions and for animated characters in moving image works, as well as voice-overs in radio and television commercials, dubbed expressions, etc.","es":"Una expresión que incluye una contribución de un organismo corporativo de proveer la voz para personajes en producciones de radio y televisión y para personajes animados en obras de imágenes en movimiento, así como voces superpuestas en comerciales de televisión y radio, expresiones dobladas, etc.","et":"Väljendus, millesse asutus on andnud panuse, andes hääle raadio- ja audioproduktsiooni tegelastele ning liikuvast pildist koosnevate teoste animategelastele, samuti esinedes häälega raadio- ja telereklaamis, dubleeritud väljendustes vms.","fi":"Ekspressio, jossa yhteisö on osallisena ekspression tekemisessä antamalla äänen hahmoille radio- ja äänituotannoissa ja animoiduille hahmoille elokuvateoksissa sekä esiintymällä radio- ja TV-mainoksissa, dubatuissa ekspressioissa tms.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à prêter sa voix à des personnages dans des productions radiophoniques et audio et à des personnages animés dans des œuvres d’images animées, de même qu’à prêter sa voix hors champ dans des messages publicitaires à la radio et à la télévision, du doublage, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését azzal, hogy rádió- és audió-produkciók szereplőinek, mozgóképművek animált karaktereinek adja hangját, valamint rádiós és televíziós reklámokban, szinkronizált forrásokban stb. hangalámondást szolgáltat.","it":"Espressione che comprende un contributo di un ente nel fornire la voce a personaggi in produzioni radiofoniche e audio e a personaggi animati in immagini in movimento e a voci narranti in spot radiofonici e televisivi, espressioni doppiate, etc.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, ierunājot tēlus radio un audio uzvedumos un animācijas filmās, kā arī nodrošinot aizkadra balsi radio un televīzijas reklāmās, dublētajās izteiksmēs u.tml.","nl":"Een expressie die omvat een bijdrage door een corporatie in het leveren van een stem aan personages in radio- en geluidsproducties en aan animatiepersonages in bewegend beeld-werken, alsook voice-overs in radio- en televisiereclames, nagesynchroniseerde expressies etc.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å gi stemme til rollefigurer i radio- og lydproduksjoner og for animerte rollefigurer i filmverk, levere fortellerstemme til radio- og fjernsynsreklamer, dubbede ressurser, etc.","tr":"Radyo ve ses yapımlarındaki karakterlerin ve hareketli görüntü çalışmalarındaki animasyon karakterlerin seslendirilmesinin yanı sıra radyo ve televizyon reklamlarındaki seslendirmeler, dublajlı anlatımlar vb. için tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括为在广播和音频制作中的角色和为动态图像作品中的动画角色提供人声以及为广播和电视广告提供画外音、配音等的一个团体的贡献的一种内容表达"},"altLabel":{"de":["Körperschaft als als Synchronsprecherin/Synchronsprecher von"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
