                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/onscreenPresenterFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51056", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerFamilyOf.en", "label":"is performer family of"},{"@id":"http://rdaregistry.info/Elements/a/P50721", "lexicalAlias":"http://rdaregistry.info/Elements/a/onscreenPresenterCollectiveAgentOf.en", "label":"is onscreen presenter collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51023", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/onscreenPresenterFamilyOf.en", "label":"is onscreen presenter family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51023", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/onscreenPresenterFamilyOf.en", "label":"is onscreen presenter family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50570","label":{"ar":"هو شخص مقدم برامج على الشاشة لـ","ca":"és persona presentadora en pantalla de","cs":"je onscreen prezentátorem (osobou) (čeho)","da":"er person, som er programvært af","de":"ist Person als On-Screen-Präsentatorin/On-Screen-Präsentator von","de":"ist Person als On-Screen-Präsentatorin/On-Screen-Präsentator von","el":"είναι οθονικός παρουσιαστής φυσικό πρόσωπο του","en":"is onscreen presenter person of","es":"es presentador en pantalla de","et":"ekraanil esineja (isik) väljenduses","fi":"esittelijä (henkilö) ekspressiossa","fr":"est une personne présentatrice à l’écran de","hu":"képernyőn megjelenő előadó személye a következőnek:","it":"è presentatore video persona di","lv":"ir ekrānā redzamais vadītājs (persona)","nl":"is presentator in beeld-persoon van","no":"er programleder for (person)","tr":"ekran sunucusu kişisidir","zh-Hans-CN":"是……的屏幕主持人个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص بظهوره على الشاشة لتقديم معلومات سياقية أو معلومات أساسية."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona apareixent en pantalla per proporcionar informació contextual o dels antecedents."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že vystupuje na obrazovce a poskytuje související nebo základní informace."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at optræde på en skærm for at give kontekstuel- eller baggrundsinformation."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie auf dem Bildschirm erscheint, um Kontext- und Hintergrundinformationen zu liefern.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie auf dem Bildschirm erscheint, um Kontext- und Hintergrundinformationen zu liefern."],"en":["Relates a person to an expression that includes a contribution by a person of appearing on screen to provide contextual or background information."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona a aparecer en la pantalla para proporcionar información contextual o de fondo."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, pakkudes ekraanil kontekstilist ja taustinfot."],"fi":["Liittää henkilön ekspressioon, jonka tekemisessä henkilö on osallisena esiintymällä televisiossa tai elokuvassa taustatiedon antajana."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à apparaître à l’écran pour fournir de l’information contextuelle ou complémentaire."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy képernyőn megjelenő személy közreműködését szövegösszefüggésre vonatkozó vagy háttérinformáció szolgáltatásában."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nell'apparire sullo schermo per fornire informazioni contestuali o in sottofondo."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, parādoties ekrānā, lai nodrošinātu konteksta vai fona informāciju."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door in beeld te verschijnen om contextuele of achtergrondinformatie te geven."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å vises på skjermen for å gi kontekst eller bakgrunnsinformasjon."],"tr":["Bir kişiyi, bağlamsal veya arka plan bilgisi sağlamak için ekranda görünen bir kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括有出现在屏幕上提供语境或背景信息的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص مقدم برامج على الشاشة","ca":"persona presentadora en pantalla de","cs":"onscreen prezentátor (osoba) (čeho)","da":"person, som er programvært af","de":"Person als On-Screen-Präsentatorin/On-Screen-Präsentator von","de":"Person als On-Screen-Präsentatorin/On-Screen-Präsentator von","el":"οθονικός παρουσιαστής φυσικό πρόσωπο του","en":"onscreen presenter person of","es":"presentador en pantalla de","et":"ekraanil esineja (isik) väljenduses","fi":"esittelijä (henkilö) ekspressiossa","fr":"personne présentatrice à l’écran de","hu":"képernyőn megjelenő előadó személye:","it":"presentatore video persona di","lv":"ir ekrānā redzamais vadītājs (persona)","nl":"presentator in beeld-persoon van","no":"programleder for (person)","tr":"ekrandaki sunucu kişi","zh-Hans-CN":"……的屏幕主持人个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص بظهوره على الشاشة لتقديم معلومات سياقية أو معلومات أساسية.","ca":"Expressió que inclou una contribució d’una persona apareixent en pantalla per proporcionar informació contextual o dels antecedents.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že vystupuje na obrazovce a poskytuje související nebo základní informace.","da":"Udtr