                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/actorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50905", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerCorporateBodyOf.en", "label":"is performer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50719", "lexicalAlias":"http://rdaregistry.info/Elements/a/actorCollectiveAgentOf.en", "label":"is actor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50909", "lexicalAlias":"http://rdaregistry.info/Elements/a/voiceActorCorporateBodyOf.en", "label":"is voice actor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50870", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/actorCorporateBodyOf.en", "label":"is actor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50870", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/actorCorporateBodyOf.en", "label":"is actor corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51021","label":{"ar":"هي عائلة ممثلة لـ","ca":"és família actriu de","cs":"je hercem (rodinou) (čeho)","da":"er familie, som er skuespiller af","de":"ist Familie als Schauspielerin/Schauspieler von","de":"ist Familie als Schauspielerin/Schauspieler von","el":"είναι ηθοποιός οικογένεια του","en":"is actor family of","es":"es familia actriz de","et":"näitleja (perekond) väljenduses","fi":"näyttelijä (suku) ekspressiossa","fr":"est une famille actrice de","hu":"színész családja a következőnek:","it":"è attore famiglia di","lv":"ir aktieris (dzimta/ģimene)","nl":"is acteur-familie van","no":"er skuepiller for (familie)","tr":"aktör ailesidir","zh-Hans-CN":"是……的演员家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة تعمل كعضو فريق تمثيل أو عازف في عرض موسيقي أو درامي."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família actuant com un membre del repartiment o com un comediant d’una representació musical o dramàtica."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že působí jako člen souboru nebo hráč v hudebním nebo dramatickém vystoupení."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at være skuespiller eller musiker i en musikalsk eller dramatisk præsentation."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie als Ensemble-Mitglied oder Darstellerin/Darsteller in einer musikalischen oder dramatischen Darbietung fungiert.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie als Ensemble-Mitglied oder Darstellerin/Darsteller in einer musikalischen oder dramatischen Darbietung fungiert."],"en":["Relates a family to an expression that includes a contribution by a family of acting as a cast member or player in a musical or dramatic presentation."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de actuar como miembro del elenco o intérprete en una presentación musical o dramática."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, osaledes trupiliikme või näitlejana muusika- või draamaetenduses."],"fi":["Liittää suvun ekspressioon, jonka tekemisessä suku on osallisena näyttelemällä musiikki- tai näytelmäesityksessä."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à agir à titre de membre d’une distribution artistique ou de comédien dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy családnak, mint a szereposztás egy tagjának vagy előadójának a közreműködését egy zenei vagy drámai bemutatóban."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nella recitazione come membro del cast o musicista in una presentazione musicale o drammatica."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, izpildot lomu dramatiskā uzvedumā vai spēlējot mūzikas uzvedumā."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie die optreedt als een lid van een gezelschap of speler in een muziek- of dramapresentatie."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å spille en rolle eller som utøver i en musikalsk eller dramatisk forestilling."],"tr":["Bir aileyi, müzikal veya dramatik bir sunumda oyuncu olarak yer alarak katkıda bulunan bir aileyi içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括在音乐或戏剧呈现中扮演角色或演奏（唱）的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة ممثلة","ca":"família actriu de","cs":"herec (rodina) (čeho)","da":"familie, som er skuespiller af","de":"Familie als Schauspielerin/Schauspieler von","de":"Familie als Schauspielerin/Schauspieler von","el":"ηθοποιός οικογένεια του","en":"actor family of","es":"familia actriz de","et":"näitleja (perekond) väljenduses","fi":"näyttelijä (suku) ekspressiossa","fr":"famille actrice de","hu":"színész családja:","it":"attore famiglia di","lv":"ir aktieris (dzimta/ģimene)","nl":"acteur-familie van","no":"skuepiller for (familie)","tr":"Oyuncu aile","zh-Hans-CN":"……的演员家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة تعمل كعضو فريق تمثيل أو عازف في عرض موسيقي أو درامي.","ca":"Expressió que inclou una contribució d’una família actuant com un membre del repartiment o com un comediant d’una representació musical o dramàtica.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že působí jako člen souboru nebo hráč v hudebním nebo dramatickém vystoupení.","da":"Udtryk, som omfatter en families bidrag ved at være skuespiller eller musiker i en musikalsk eller dramatisk præsentation.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie als Ensemble-Mitglied oder Darstellerin/Darsteller in einer musikalischen oder dramatischen Darbietung fungiert.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie als Ensemble-Mitglied oder Darstellerin/Darsteller in einer musikalischen oder dramatischen Darbietung fungiert.","en":"An expression that includes a contribution by a family of acting as a cast member or player in a musical or dramatic presentation.","es":"Una expresión que incluye una contribución de una familia de actuar como miembro del elenco o intérprete en una presentación musical o dramática.","et":"Väljendus, millesse perekond on andnud panuse, osaledes trupiliikme või näitlejana muusika- või draamaetenduses.","fi":"Ekspressio, jonka tekemisessä suku on osallisena näyttelemällä musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à agir à titre de membre d’une distribution artistique ou de comédien dans une présentation musicale ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy családnak, mint a szereposztás egy tagjának vagy előadójának a közreműködését egy zenei vagy drámai bemutatóban.","it":"Espressione che comprende un contributo di una famiglia nella recitazione come membro del cast o musicista in una presentazione musicale o drammatica.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, izpildot lomu dramatiskā uzvedumā vai spēlējot mūzikas uzvedumā.","nl":"Een expressie die omvat een bijdrage door een familie die optreedt als een lid van een gezelschap of speler in een muziek- of dramapresentatie.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å spille en rolle eller som utøver i en musikalsk eller dramatisk forestilling.","tr":"Bir müzikal veya dramatik sunumda oyuncu veya oyuncu kadrosu üyesi olarak hareket eden bir ailenin katkısını içere