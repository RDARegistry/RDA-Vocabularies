                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50293", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistAgentOf.en", "label":"is remix artist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50548", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/remixArtistPersonOf.en", "label":"is remix artist person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50548", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/remixArtistPersonOf.en", "label":"is remix artist person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50265","label":{"ar":"هو وكيل باحث لـ","ca":"és agent investigador de","cs":"je výzkumníkem (agentem) (čeho)","da":"er agent, som er researcher af","de":"ist Akteur als Forscherin/Forscher von","de":"ist Akteur als Forscherin/Forscher von","el":"είναι ερευνητής φορέας του","en":"is researcher agent of","es":"es agente investigador de","et":"uurija (tegija) teoses","fi":"tutkija (toimija) teoksessa","fr":"est un agent recherchiste de","hu":"kutató ágense a következőnek:","it":"è ricercatore agente di","lv":"ir pētnieks (aģents)","nl":"is onderzoeker-actor van","no":"er forsker for (agent)","tr":"araştırmacı temsilcisidir","zh-Hans-CN":"是……的研究者行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن البحث لدعم عمل."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la recerca per donar suport a una obra."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost a