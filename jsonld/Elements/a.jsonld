                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50692", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorCollectiveAgentOf.en", "label":"is author collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50224", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistAgentOf.en", "label":"is lyricist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50835", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistCorporateBodyOf.en", "label":"is lyricist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50986", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistFamilyOf.en", "label":"is lyricist family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50684", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lyricistCollectiveAgentOf.en", "label":"is lyricist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50684", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lyricistCollectiveAgentOf.en", "label":"is lyricist collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50835","label":{"ar":"هي هيئة مسئولة عن كتابة أغاني لـ","ca":"és entitat corporativa lletrista de","cs":"je textařem (korporací) (čeho)","da":"er korporation, som er tekstforfatter af","de":"ist Körperschaft als Textdichterin/Textdichter von","de":"ist Körperschaft als Textdichterin/Textdichter von","el":"είναι στιχουργός συλλογικό όργανο του","en":"is lyricist corporate body of","es":"es organismo corporativo letrista de","et":"sõnade autor (asutus) teoses","fi":"sanoittaja (yhteisö) teoksessa","fr":"est une collectivité parolière de","hu":"dalszövegíró testülete a következőnek:","it":"è paroliere ente di","lv":"ir dziesmas teksta autors (institūcija)","nl":"is liedtekstschrijver-corporatie van","no":"er sangtekstforfatter for (korporasjon)","tr":"söz yazarı tüzel kişisidir","zh-Hans-CN":"是……的作词者团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن تأليف كلمات أغنية شعبية، مثل أغنية من مَسرحية موسيقِيّة."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en l’autoria d’una cançó popular, inclosa una cançó d’un musical."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za autorství textu populární písně včetně písně z muzikálu."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for at forfatte ordene til en populær sang, inkl. en sang fra en musical."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for authoring the words of a popular song, including a song from a musical."],"es":["Relaciona un organismo corporativo con una obra que involucra la responsabilidad de un organismo corporativo de ser el autor de las palabras en una canción popular, incluyendo una canción de un musical."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust levilaulu (k.a laul muusikalist) sõnade kirjutamise eest."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa populaarimusiikkiin kuuluvan laulun (mukaan lukien musikaalilaulun) sanojen kirjoittamisesta."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à être l’auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége egy könyűzenei dalszöveg szerzőségéhez, musicaldalt is beleértve."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente come autore delle parole di una canzone, inclusa una canzone di un musical."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par dziesmas vārdiem, ieskaitot dziesmas no mūzikla."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor schrijven van de woorden van een populair lied, inclusief een lied uit een musical."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av å være forfatter av teksten til en populær sang, inkludert en sang fra en musikal."],"tr":["Bir tüzel kişiyi, bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerini yazma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及流行歌曲（包括音乐剧中的歌曲）歌词的写作的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن كتابة أغاني","ca":"entitat corporativa lletrista de","cs":"textař (korporace) (čeho)","da":"korporation, som er tekstforfatter af","de":"Körperschaft als Textdichterin/Textdichter von","de":"Körperschaft als Textdichterin/Textdichter von","el":"στιχουργός συλλογικό όργανο του","en":"lyricist corporate body of","es":"organismo corporativo letrista de","et":"sõnade autor (asutus) teoses","fi":"sanoittaja (yhteisö) teoksessa","fr":"collectivité parolière de","hu":"dalszövegíró testülete:","it":"paroliere ente di","lv":"ir dziesmas teksta autors (institūcija)","nl":"liedtekstschrijver-corporatie van","no":"sangtekstforfatter for (korporasjon)","tr":"Söz yazarı tüzel kişiliği","zh-Hans-CN":"……的作词者团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن تأليف كلمات أغنية شعبية، مثل أغنية من مَسرحية موسيقِيّة.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en l’autoria d’una cançó popular, inclosa una cançó d’un musical.","cs":"Dílo, které zahrnuje odpovědnost korporace za autorství textu populární písně včetně písně z muzikálu.","da":"Værk, som involverer en korporations ansvar for at forfatte ordene til en populær sang, inkl. en sang fra en musical.","de":"Ein Werk, bei dem eine Körperschaft für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.","en":"A work that involves a responsibility of a corporate body for authoring the words of a popular song, including a song from a musical.","es":"Una obra que involucra una responsabilidad de un organismo corporativo de ser el autor de las palabras en una canción popular, incluyendo una canción de un musical.","et":"Teos, mis sisaldab asutuse vastutust levilaulu (k.a laul muusikalist) sõnade kirjutamise eest.","fi":"Teos, jossa yhteisö on vastuussa populaarimusiikkiin kuuluvan laulun (mukaan lukien musikaalilaulun) sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à être l’auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége egy könyűzenei dalszöveg szerzőségéhez, musicaldalt is beleértve.","it":"Opera che implica una responsabilità di un ente come autore delle parole di una canzone, inclusa una canzone di un musical.","lv":"Darbs, kas ietver institūcijas atbildību par dziesmas vārdiem, ieskaitot dziesmas no mūzikla.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor schrijven van de woorden van een populair lied, inclusief een lied uit een musical.","no":"Et verk som involverer et ansvar for en korporasjon i form av å være forfatter av teksten til en populær sang, inkludert en sang fra en musikal.","tr":"Bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerini yazmak için bir tüzel kişinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及流行歌曲（包括音乐剧中的歌曲）歌词的写作的一个团体的责任的一种作品"},"note":{"ar":["يُستبعد تأليف الحوار فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només el diàleg d’un musical."],"cs":["Autorství pouze dialogu z muzikálu je vyloučeno."],"da":["At forfatte kun dialogen til en musical er ikke omfattet."],"de":["Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.,Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter."],"el":["Δεν περιλαμβάνεται μόνο η συγγραφή του διαλόγου ενός μιούζικαλ."],"en":["Authoring of only the dialogue from a musical is excluded."],"es":["Se excluye ser el autor de solo el dialogo de un musical."],"et":["Ei hõlma üksnes muusikali dialoogide kirjutamist."],"fi":["Ei kata pelkän musikaalin dialogin kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu."],"hu":["Musical párbeszédeinek szerzősége nem tartozik ide."],"it":["È escluso l'essere autore solo del dialogo di un musical."],"lv":["Neietver mūzikla dialogus."],"nl":["Schrijven van enkel de dialoog van een musical is uitgesloten."],"no":["Det å bare skrive dialogen fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca diyaloglarının yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中仅是对白的写作。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
