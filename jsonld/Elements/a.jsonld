                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51076", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorFamilyToPerformanceOf.en", "label":"is contributor family to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50730", "lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerCollectiveAgentOf.en", "label":"is lighting designer collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51032", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lightingDesignerFamilyOf.en", "label":"is lighting designer family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51032", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lightingDesignerFamilyOf.en", "label":"is lighting designer family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50579","label":{"ar":"هو شخص مصمم إضاءة لـ","ca":"és persona dissenyadora d’il·luminació de","cs":"je designérem osvětlení (osobou) (čeho)","da":"er person, som er belysningsdesigner af","de":"ist Person als Lichtgestalterin/Lichtgestalter von","de":"ist Person als Lichtgestalterin/Lichtgestalter von","el":"είναι σχεδιαστής φωτισμού φυσικό πρόσωπο του","en":"is lighting designer person of","es":"es diseñador de iluminación de","et":"valguskujundaja (isik) väljenduses","fi":"valosuunnittelija (henkilö) ekspressiossa","fr":"est une personne éclairagiste de","hu":"világítástervező személye a következőnek:","it":"è progettista dell'illuminazione persona di","lv":"ir gaismu mākslinieks (persona)","nl":"is lichtontwerper-persoon van","no":"er lysdesigner for (person)","tr":"ışık tasarımcısı kişisidir","zh-Hans-CN":"是……的灯光设计者个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص في تصميم عناصرالإضاءة وإنشائها."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona en el disseny i creació de components luminotècnics."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že navrhuje a vytváří světelnou složku."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at designe og skabe belysningsdele."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie Lichtelemente entwirft und erstellt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie Lichtelemente entwirft und erstellt."],"en":["Relates a person to an expression that includes a contribution by a person of designing and creating lighting components."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona en el diseño y creación de componentes de iluminación."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, kavandades ja luues selle valguskomponendid."],"fi":["Liittää henkilön ekspressioon, jossa henkilö on osallisena suunnittelemalla ja luomalla valokomponentteja."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à concevoir et à créer des effets de lumière."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését világítási összetevők tervezésében és létrehozásában."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nella progettazione e creazione di componenti per l'illuminazione."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, izstrādājot un radot apgaismojuma efektus."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door ontwerpen en creëren van lichteffecten."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å utforme og skape lyssettingskomponenter."],"tr":["Bir kişiyi, bir kişinin aydınlatma bileşenleri tasarlama ve oluşturma katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括设计并创作灯光组成部分的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص مصمم إضاءة","ca":"persona dissenyadora d’il·luminació de","cs":"designér osvětlení (osoba) (čeho)","da":"person, som er belysningsdesigner af","de":"Person als Lichtgestalterin/Lichtgestalter von","de":"Person als Lichtgestalterin/Lichtgestalter von","el":"σχεδιαστής φωτισμού φυσικό πρόσωπο του","en":"lighting designer person of","es":"diseñador de iluminación de","et":"valguskujundaja (isik) väljenduses","fi":"valosuunnittelija (henkilö) ekspressiossa","fr":"personne éclairagiste de","hu":"világítástervező személye:","it":"progettista dell'illuminazione persona di","lv":"ir gaismu mākslinieks (persona)","nl":"lichtontwerper-persoon van","no":"lysdesigner for (person)","tr":"Işık tasarımcısı kişisi","zh-Hans-CN":"……的灯光设计者个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص في تصميم عناصرالإضاءة وإنشائها.","ca":"Expressió que inclou una contribució d’una persona en el disseny i creació de components luminotècnics.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že navrhuje a vytváří světelnou složku.","da":"Udtryk, som omfatter en persons bidrag ved at designe og skabe belysningsdele.","de":"Eine Expression, zu der eine Person beiträgt, indem sie Lichtelemente entwirft und erstellt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie Lichtelemente entwirft und erstellt.","en":"An expression that includes a contribution by a person of designing and creating lighting components.","es":"Una expresión que incluye una contribución de una persona en el diseño y creación de componentes de iluminación.","et":"Väljendus, millesse isik on andnud panuse, kavandades ja luues selle valguskomponendid.","fi":"Ekspressio, jossa henkilö on osallisena suunnittelemalla ja luomalla valokomponentteja.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à concevoir et à créer des effets de lumière.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését világítási összetevők tervezésében és létrehozásában.","it":"Espressione che comprende un contributo di una persona nella progettazione e creazione di componenti per l'illuminazione.","lv":"Izteiksme, kas ietver personas ieguldījumu, izstrādājot un radot apgaismojuma efektus.","nl":"Een expressie die omvat een bijdrage door een persoon door ontwerpen en creëren van lichteffecten.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å utforme og skape lyssettingskomponenter.","tr":"Aydınlatma bileşenleri tasarlayan ve yaratan bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括设计并创作灯光组成部分的一个个人的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50256", "lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerAgentOf.en", "label":"is lighting designer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50579", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lightingDesignerPersonOf.en", "label":"is lighting designer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50579", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lightingDesignerPersonOf.en", "label":"is lighting designer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50175","label":{"ar":"هو وكيل طبّاع على حجر لـ","ca":"és agent litògraf de","cs":"je litografem (agentem) (čeho)","da":"er agent, som er litograf af","de":"ist Akteur als Lithografin/Lithograf von","de":"ist Akteur als Lithografin/Lithograf von","el":"είναι λιθογράφος φορέας του","en":"is lithographer agent of","es":"es agente litógrafo de","et":"litograaf (tegija) kehastuses","fi":"litografi (toimija) manifestaatiossa","fr":"est un agent lithographe de","hu":"kőnyomatkészítő ágense a következőnek:","it":"è litografo agente di","lv":"ir litogrāfs (aģents)","nl":"is lithograaf-actor van","no":"er litograf av (agent)","tr":"taş baskı sanatçısı temsilcisidir","zh-Hans-CN":"是……的平版制作者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل عن تجهيز حجر أو لوح للطباعة الحجرية."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent en la preparació d’una pedra o una planxa per a la impressió litogràfica."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za přípravu kamene nebo desky pro litografický tisk."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for at klargøre en sten eller plade til litografisk trykning."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist."],"el":["Συνδέει έναν φορέα, ο οποίος εμπλέκεται στην κατασκευή μιας εκδήλωσης μέσω της προετοιμασίας ενός λίθου ή πλάκας για λιθογραφική εκτύπωση, περιλαμβανομένου ενός γραφίστα ο οποίος δημιουργεί κατευθείαν πάνω στην επιφάνεια ένα σχέδιο από το οποίο θα γίνει η εκτύπωση, με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for preparing a stone or plate for lithographic printing."],"es":["Relaciona un agente con una manifestación que involucra una responsabilidad de un agente de preparar una piedra o placa para impresión litográfica."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust kivi või plaadi litograafiliste tõmmiste jaoks ettevalmistamise eest."],"fi":["Liittää toimijan manifestaatioon, jossa toimija on vastuussa litografiassa käytetyn kivilaatan tai muun painolaatan valmistamisesta."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent consistant à préparer une pierre ou une plaque pour l’impression lithographique."],"hu":["Hozzákapcsol egy ágenst egy megjelenési formához, amelyhez hozzátartozik egy ágens felelőssége egy kő vagy lemez litográfiai nyomtatáshoz történő előkészítéséért."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente nel preparare una pietra o lastra per la stampa litografica."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par akmens vai iespiedplates sagatavošanu drukāšanai litogrāfijas tehnikā."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het prepareren van een steen of plaat voor lithografisch drukken."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av å klargjøre en stein eller plate for litografisk trykk."],"tr":["Bir temsilciyi, taş baskı için bir taş veya plaka hazırlamakla görevli bir temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及制作用于平版印刷的石头或平版的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل طبَّاع على احجر","ca":"agent litògraf de","cs":"litograf (agent) (čeho)","da":"agent, som er litograf af","de":"Akteur als Lithografin/Lithograf von","de":"Akteur als Lithografin/Lithograf von","el":"λιθογράφος φορέας του","en":"lithographer agent of","es":"agente litógrafo de","et":"litograaf (tegija) kehastuses","fi":"litografi (toimija) manifestaatiossa","fr":"agent lithographe de","hu":"kőnyomatkészítő ágense:","it":"litografo agente di","lv":"ir litogrāfs (aģents)","nl":"lithograaf-actor van","no":"litograf av (agent)","tr":"Taş basmacı temsilcisi","zh-Hans-CN":"……的平版制作者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن تجهيز حجر أو لوح للطباعة الحجرية.","ca":"Manifestació que implica una responsabilitat d’un agent en la preparació d’una pedra o una planxa per a la impressió litogràfica.","cs":"Provedení, které zahrnuje odpovědnost agenta za přípravu kamene nebo desky pro litografický tisk.","da":"Manifestation, som involverer en agents ansvar for at klargøre en sten eller plade til litografisk trykning.","de":"Eine Manifestation, bei der ein Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist.","de":"Eine Manifestation, bei der ein Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist.","el":"Μια εκδήλωση που κατασκευάζεται από έναν φορέα υπεύθυνο για την προετοιμασία ενός λίθου ή πλάκας για λιθογραφική εκτύπωση, περιλαμβανομένου ενός γραφίστα ο οποίος δημιουργεί κατευθείαν πάνω στην επιφάνεια ένα σχέδιο από το οποίο θα γίνει η εκτύπωση.","en":"A manifestation that involves a responsibility of an agent for preparing a stone or plate for lithographic printing.","es":"Una manifestación que involucra una responsabilidad de un agente de preparar una piedra o placa para impresión litográfica.","et":"Kehastus, mis sisaldab tegija vastutust kivi või plaadi litograafiliste tõmmiste jaoks ettevalmistamise eest.","fi":"Manifestaatio, jossa toimija on vastuussa litografiassa käytetyn kivilaatan tai muun painolaatan valmistamisesta.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent consistant à préparer une pierre ou une plaque pour l’impression lithographique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy ágens felelőssége egy kő vagy lemez litográfiai nyomtatáshoz történő előkészítéséért.","it":"Manifestazione che implica la responsabilità di un agente nel preparare una pietra o lastra per la stampa litografica.","lv":"Manifestācija, kas ietver aģenta atbildību par akmens vai iespiedplates sagatavošanu drukāšanai litogrāfijas tehnikā.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het prepareren van een steen of plaat voor lithografisch drukken.","no":"En manifestasjon som involverer ansvar for en agent i form av å klargjøre en stein eller plate for litografisk trykk.","tr":"Litografik baskı için bir taş veya plaka hazırlamakla görevli temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及制作用于平版印刷的石头或平版的一个行为者的责任的一种载体表现"},"note":{"ar":["يشير مصطلح طبّاع على الحجر كذلك إلى فنان الجرافيك الذي ينشئ تصميما مباشرة على السطح الذي ستتم الطباعة منه."],"ca":["Un litògraf inclou un artista gràfic que crea un disseny directament sobre la superfície a partir de la qual es farà la impressió."],"cs":["Litograf zahrnuje grafického umělce, který vytváří design přímo na ploše, ze které bude zhotoven tisk."],"da":["En litograf omfatter en grafiker, som skaber et design direkte på overfladen, hvorfra trykning vil blive udført."],"de":["Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll.,Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll."],"el":["Ένας λιθογράφος περιλαμβάνει έναν καλλιτέχνη γραφικών που σχεδιάζει κατευθείαν πάνω στην επιφάνεια από την οποία θα γίνει η εκτύπωση."],"en":["A lithographer includes a graphic artist creating a design directly on the surface from which printing will be done."],"es":["Un litógrafo incluye un artista gráfico que está creando un diseño directamente sobre la superficie desde la cual se realizará la impresión."],"et":["Litograaf hõlmab ka graafikut, kes loob kujutise otse pinnale, millelt toimub trükkimine."],"fi":["Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle."],"fr":["Un lithographe comprend un artiste graphique créant un dessin directement sur la surface à partir de laquelle l’impression sera effectuée."],"hu":["A litográfus egy grafikusművész, aki közvetlenül azon a felületen készít tervet, amelyről a nyomtatás történik."],"it":["Un litografo comprende un artista grafico che crea un disegno direttamente sulla superficie dalla quale viene effettuata la stampa."],"lv":["Litogrāfs ir arī grafiķis, kas veido dizainu tieši uz virsmas, no kuras materiāls tiks drukāts."],"nl":["Een lithograaf omvat een grafisch kunstenaar die een ontwerp creëert direct op het oppervlak vanaf welke het drukken gedaan zal worden."],"no":["En litograf inkluderer en grafiker som skaper en form direkte på platen det senere trykkes fra."],"tr":["Bir taş baskı sanatçısı, baskının yapılacağı yüzey üzerinde doğrudan bir tasarım yaratan bir grafik sanatçısı içerir."],"zh-Hans-CN":["平版制作者包括直接在用于印刷的表面进行设计创作的平面美术家"]},"altLabel":{"ar":["طبّاع على الحجر"],"ca":["litògraf de"],"cs":["litograf (čeho)"],"da":["litograf af"],"de":["Lithograf von,Lithograf von"],"el":["λιθογράφος του"],"en":["lithographer of"],"es":["litógrafo de"],"et":["litograaf kehastuses"],"fi":["litografina painotuotteessa"],"fr":["lithographe de"],"hu":["kőnyomatkészítője:"],"it":["litografo di"],"nl":["lithograaf van"],"no":["litograf av"],"tr":["taş basmacı"],"zh-Hans-CN":["……的平版制作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/lithographerAgentOf.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50173", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerAgentOf.en", "label":"is printmaker agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50654", "lexicalAlias":"http://rdaregistry.info/Elements/a/lithographerCollectiveAgentOf.en", "label":"is lithographer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50503", "lexicalAlias":"http://rdaregistry.info/Elements/a/lithographerPersonOf.en", "label":"is lithographer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50175", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lithographerAgentOf.en", "label":"is lithographer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50175", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lithographerAgentOf.en", "label":"is lithographer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50654","label":{"ar":"هو وكيل جماعي طبّاع على الحجر لـ","ca":"és agent col·lectiu litògraf de","cs":"je litografem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er litograf af","de":"ist gemeinschaftlicher Akteur als Lithografin/Lithograf von","de":"ist gemeinschaftlicher Akteur als Lithografin/Lithograf von","el":"είναι λιθογράφος συλλογικός φορέας του","en":"is lithographer collective agent of","es":"es agente colectivo litográfico de","et":"litograaf (kollektiiv) kehastuses","fi":"litografi (yhteistoimija) manifestaatiossa","fr":"est un agent collectif lithographe de","hu":"kőnyomatkészítő kollektív ágense a következőnek:","it":"è litografo agente collettivo di","lv":"ir litogrāfs (grupa)","nl":"is lithograaf-collectieve actor van","no":"er litograf for (kollektiv agent)","tr":"taş baskı sanatçısı kolektif temsilcisidir","zh-Hans-CN":"是……的平版制作者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن تجهيز حجر أو لوح للطباعة الحجرية."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en la preparació d’una pedra o una planxa per a la impressió litogràfica."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost kolektivního agenta za přípravu kamene nebo desky pro litografický tisk."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for at klargøre en sten eller plade til litografisk trykning."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for preparing a stone or plate for lithographic printing."],"es":["Relaciona un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de preparar una piedra o placa para impresión litográfica."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust kivi või plaadi litograafiliste tõmmiste jaoks ettevalmistamise eest."],"fi":["Liittää yhteistoimijan manifestaatioon, jossa yhteistoimija on vastuussa litografiassa käytetyn kivilaatan tai muun painolaatan valmistamisesta."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à préparer une pierre ou une plaque pour l’impression lithographique."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége egy kő vagy lemez litográfiai nyomtatáshoz történő előkészítéséért."],"it":["Correla un agente collettivo a una manifestazione che implica una responsabilità di un agente collettivo nel preparare una pietra o lastra per la stampa litografica."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par akmens vai iespiedplates sagatavošanu drukāšanai litogrāfijas tehnikā."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het prepareren van een steen of plaat voor lithografisch drukken."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av å klargjøre en stein eller plate for litografisk trykk."],"tr":["Kolektif bir temsilciyi, litografik baskı için bir taş veya plaka hazırlama sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及制作用于平版印刷的石头或平版的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي طبّاع على الحجر","ca":"agent col·lectiu litògraf de","cs":"litograf (kolektivní agent) (čeho)","da":"kollektiv agent, som er litograf af","de":"Gemeinschaftlicher Akteur als Lithografin/Lithograf von","de":"Gemeinschaftlicher Akteur als Lithografin/Lithograf von","el":"λιθογράφος συλλογικός φορέας του","en":"lithographer collective agent of","es":"agente colectivo litográfico de","et":"litograaf (kollektiiv) kehastuses","fi":"litografi (yhteistoimija) manifestaatiossa","fr":"agent collectif lithographe de","hu":"kőnyomatkészítő kollektív ágense:","it":"litografo agente collettivo di","lv":"ir litogrāfs (grupa)","nl":"lithograaf-collectieve actor van","no":"litograf for (kollektiv agent)","tr":"Taş basmacı kolektif temsilcisi","zh-Hans-CN":"……的平版制作者集体行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل جماعي عن تجهيز حجر أو لوح للطباعة الحجرية.","ca":"Manifestació que implica una responsabilitat d’un agent col·lectiu en la preparació d’una pedra o una planxa per a la impressió litogràfica.","cs":"Provedení, které zahrnuje odpovědnost kolektivního agenta za přípravu kamene nebo desky pro litografický tisk.","da":"Manifestation, som involverer en kollektiv agents ansvar for at klargøre en sten eller plade til litografisk trykning.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für die Vorbereitung eines Steins oder einer Platte für lithografischen Druck verantwortlich ist.","en":"A manifestation that involves a responsibility of a collective agent for preparing a stone or plate for lithographic printing.","es":"Una manifestación que implica la responsabilidad de un agente colectivo de preparar una piedra o placa para impresión litográfica.","et":"Kehastus, mis sisaldab kollektiivi vastutust kivi või plaadi litograafiliste tõmmiste jaoks ettevalmistamise eest.","fi":"Manifestaatio, jossa yhteistoimija on vastuussa litografiassa käytetyn kivilaatan tai muun painolaatan valmistamisesta.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à préparer une pierre ou une plaque pour l’impression lithographique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy kollektív ágens felelőssége egy kő vagy lemez litográfiai nyomtatáshoz történő előkészítéséért.","it":"Manifestazione che implica una responsabilità di un agente collettivo nel preparare una pietra o lastra per la stampa litografica.","lv":"Manifestācija, kas ietver grupas atbildību par akmens vai iespiedplates sagatavošanu drukāšanai litogrāfijas tehnikā.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het prepareren van een steen of plaat voor lithografisch drukken.","no":"En manifestasjon som involverer et ansvar for en kollektiv agent i form av å klargjøre en stein eller plate for litografisk trykk.","tr":"Litografik baskı için bir taş veya plaka hazırlamak için kolektif bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及制作用于平版印刷的石头或平版的一个集体行为者的责任的一种载体表现"},"note":{"ar":["يشير مصطلح طبّاع على الحجر أيضا إلى فنان الجرافيك الذي ينشيء تصميما مباشرة على السطح الذي ستتم الطباعة منه"],"ca":["Un litògraf inclou un artista gràfic que crea un disseny directament sobre la superfície a partir de la qual es farà la impressió."],"cs":["Litograf zahrnuje grafického umělce, který vytváří design přímo na ploše, ze které bude zhotoven tisk."],"da":["En litograf omfatter en grafiker, som skaber et design direkte på overfladen, hvorfra trykning vil blive udført."],"de":["Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll.,Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll."],"en":["A lithographer includes a graphic artist creating a design directly on the surface from which printing will be done."],"es":["Un litógrafo incluye un artista gráfico que crea un diseño directamente sobre la superficie desde la cual se realizará la impresión."],"et":["Litograaf hõlmab ka graafikut, kes loob kujutise otse pinnale, millelt toimub trükkimine."],"fi":["Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle."],"fr":["Un lithographe comprend un artiste graphique créant un dessin directement sur la surface à partir de laquelle l’impression sera effectuée."],"hu":["A litográfus egy grafikusművész, aki közvetlenül azon a felületen készít tervet, amelyről a nyomtatás történik."],"it":["Litografo comprende un artista grafico che crea un disegno direttamente sulla superficie da cui verrà eseguita la stampa."],"lv":["Litogrāfs ir arī grafiķis, kas veido dizainu tieši uz virsmas, no kuras materiāls tiks drukāts."],"nl":["Een lithograaf omvat een grafisch kunstenaar die een ontwerp creëert direct op het oppervlak vanaf welke het drukken gedaan zal worden."],"no":["En litograf inkluderer en grafiker som skaper et design direkte på overflaten som trykkingen vil bli gjort."],"tr":["Bir taş baskı sanatçısı, baskının yapılacağı yüzey üzerinde doğrudan bir tasarım yaratan bir grafik sanatçısını da içerir."],"zh-Hans-CN":["平版制作者包括直接在用于印刷的表面进行设计创作的平面美术家"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
