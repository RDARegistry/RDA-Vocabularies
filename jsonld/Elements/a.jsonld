                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorFamilyof.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50995", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfWorkOf.en", "label":"is creator family of work of"},{"@id":"http://rdaregistry.info/Elements/a/P51114", "lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorCollectiveAgentof.en", "label":"is collector collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51116", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/isCollectorFamilyof.en", "label":"is collector family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51116", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/isCollectorFamilyof.en", "label":"is collector family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51117","label":{"ca":"és persona col·leccionista de","cs":"je sběratelem (osobou) (čeho)","de":"ist Person als Sammlerin/Sammler von","en":"is collector person of","es":"es persona recolectora de","fi":"muodostaja (henkilö) kokoelmalle","fr":"est une personne collectionneuse de","hu":"összegyűjtő személye a következő:","nl":"is verzamelaar-persoon van","tr":"koleksiyoncu kişisidir","zh-Hans-CN":"是……的收藏者个人"},"definition":{"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la col·lecció d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament"],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za vytvoření sbírky (díla) výběrem a uspořádáním jednotek, které exemplifikují ztvárnění dalších děl."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Aggregation verantwortlich ist, indem sie Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates a person to a work that involves a responsibility of a person for collecting by selecting and arranging items that exemplify the embodiment of other works"],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona de recolectar mediante la selección y disposición de elementos que ejemplifiquen la encarnación de otras obras."],"fi":["Liittää henkilön teokseen, jossa henkilö vastaa kokoelmateoksen muodostamisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää."],"fr":["Met une personne en relation avec une œuvre de collection de ressources qui comporte une responsabilité de la part d’une personne consistant à sélectionner et arranger des items qui exemplifient la matérialisation d’autres œuvres."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége olyan egységek válogatásással és elredendezéssel való összegyűjtéséért, amelyek más művek megtestesüléseinek példányai"],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor verzamelen door het selecteren en ordenen van items die voorstellen de belichaming van andere werken."],"tr":["Bir kişiyi, diğer işlerin somutlaşmış halini örnekleyen öğeleri seçerek ve düzenleyerek, toplama sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及通过选择和整理例证其他作品具体化的单件而进行收藏的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ca":"persona col·leccionista de","cs":"sběratel (osoba) (čeho)","de":"Person als Sammlerin/Sammler von","en":"collector person of","es":"persona recolectora de","fi":"muodostaja (henkilö) kokoelmalle","fr":"personne collectionneuse de","hu":"összegyűjtő személye a következő:","nl":"verzamelaar-familie van","tr":"koleksiyoncu","zh-Hans-CN":"……的收藏者个人"},"ToolkitDefinition":{"ca":"Una obra que implica una responsabilitat d’una persona en la col·lecció d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament","cs":"Dílo, které zahrnuje odpovědnost osoby za vytvoření sbírky (díla) výběrem a uspořádáním jednotek, které exemplifikují ztvárnění dalších děl.","de":"Ein Werk, bei dem eine Person für die Aggregation verantwortlich ist, indem sie Expressionen von anderen Werken auswählt und zusammenstellt.","en":"A work that involves a responsibility of a person for collecting by selecting and arranging items that exemplify the embodiment of other works","es":"Una obra que implica la responsabilidad de una persona de recolectar mediante la selección y disposición de elementos que ejemplifiquen la encarnación de otras obras.","fi":"Teos, jossa henkilö vastaa kokoelmateoksen luomisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää.","fr":"Œuvre de collection de ressources qui comporte une responsabilité de la part d’une personne consistant à sélectionner et arranger des items qui exemplifient la matérialisation d’autres œuvres.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége olyan egységek válogatásással és elredendezéssel való összegyűjtéséért, amelyek más művek megtestesüléseinek példányai","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor verzamelen door het selecteren en ordenen van items die voorstellen de belichaming van andere werken.","tr":"Diğer eserlerin somutlaşmış halini örnekleyen kopyaları seçip düzenleyerek toplama sorumluluğunu üstlenen bir kişiyi içeren bir eser.","zh-Hans-CN":"涉及通过选择和整理例证其他作品具体化的单件而进行收藏的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
