                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50046", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectionRegistrarAgentOf.en", "label":"is collection registrar agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/P50045", "lexicalAlias":"http://rdaregistry.info/Elements/a/collectorAgentOf.en", "label":"is collector agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/P50781", "lexicalAlias":"http://rdaregistry.info/Elements/a/curatorCollectiveAgentOf.en", "label":"is curator collective agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/P50630", "lexicalAlias":"http://rdaregistry.info/Elements/a/curatorPersonOf.en", "label":"is curator person of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/object/P50133", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/curatorAgentOf.en", "label":"is curator agent of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50133", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/curatorAgentOf.en", "label":"is curator agent of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50781","label":{"ar":"هو وكيل جماعي أمين معرض لـ","ca":"és agent col·lectiu conservador de","da":"er kollektiv agent, som er kurator af","de":"ist gemeinschaftlicher Akteur als Kuratorin/Kurator von","el":"είναι έφορος συλλογικός φορέας του","en":"is curator collective agent of (Deprecated)","et":"kuraator (kollektiiv) eksemplarile","fi":"kuraattori (yhteistoimija) kappaleessa","fr":"est un agent collectif conservateur de","hu":"kurátor kollektív ágense a következőnek:","it":"è un curatore agente collettivo di","lv":"ir kurators (grupa)","nl":"is curator collectieve actor van","no":"er kurator for (kollektiv agent)"},"definition":{"ar":["يربط وكيلا جماعيا بمفردة تنطوي على مسئولية وكيل جماعي عن تصور أو إدارة التجميع لمفردة في معرض أو في مجموعة."],"ca":["Relaciona un agent col·lectiu amb un ítem que implica una responsabilitat d’un agent col·lectiu de concebre o gestionar l’agregació d’un ítem en una exposició o una col·lecció."],"da":["Relaterer en kollektiv agent til et eksemplar, som involverer en kollektiv agents ansvar for at udtænke eller administrere samlingen af et eksemplar til en udstilling eller samling."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Exemplar, bei dem ein gemeinschaftlicher Akteur die Aggregation eines Exemplars in einer Ausstellung oder Sammlung konzipiert oder organisiert."],"en":["Relates a collective agent to an item that involves a responsibility of a collective agent for conceiving or managing the aggregation of an item in an exhibition or collection. (Deprecated)"],"et":["Seostab kollektiivi eksemplariga, mis sisaldab kollektiivi vastutust eksemplari näituse või koguga liitmise kavandamise või korraldamise eest."],"fi":["Liittää yhteistoimijan kappaleeseen, jonka näyttelyyn tai kokoelmaan kuuluvan kappaleaggregaation aikaansaamisessa tai hallinnoimisessa yhteistoimija on osallisena."],"fr":["Met un agent collectif en relation avec un item qui comporte une responsabilité de la part d’un agent collectif consistant à concevoir ou à gérer l’agrégation d’un item dans une exposition ou une collection de ressources."],"hu":["Hozzákapcsol egy kollektív ágenst egy példányhoz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy példány kiállítás vagy gyűjtemény keretében történő összegyűjtésének elgondolásáért vagy kezeléséért."],"it":["Correla un agente collettivo a un item che implica una responsabilità di un agente collettivo nella concezione o gestione dell'aggregazione di un item a una mostra o collezione."],"lv":["Sasaista grupu ar vienību, kas ietver grupas atbildību par tās iekļaušanu izstādē vai kolekcijā ."],"nl":["Relateert een collectieve actor aan een item dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het bedenken of beheren van het aggregeren van een item in een tentoonstelling of collectie."],"no":["Relaterer en kollektiv agent til et eksemplar som involverer et ansvar for en kollektiv agent i form av å ha idéen til eller håndtere innsamlingen av et eksemplar i en utstilling eller samling."]},"ToolkitLabel":{"ar":"وكيل جماعي أمين معرض","ca":"agent col·lectiu conservador de","da":"kollektiv agent, som er kurator af","de":"Gemeinschaftlicher Akteur als Kuratorin/Kurator von","el":"έφορος συλλογικός φορέας του","en":"curator collective agent of (Deprecated)","et":"kuraator (kollektiiv) eksemplarile","fi":"kuraattori (yhteistoimija) kappaleessa","fr":"agent collectif conservateur de","hu":"kurátor kollektív ágense:","it":"curatore agente collettivo di","lv":"ir kurators (grupa)","nl":"curator collectieve actor van","no":"kurator for (kollektiv agent)"},"ToolkitDefinition":{"ar":"مفردة تنطوي على مسئولية وكيل جماعي عن فهم أو إدارة تجميع مفردة في معرض أو في مجموعة.","ca":"Ítem que implica una responsabilitat d’un agent col·lectiu de concebre o gestionar l’agregació d’un ítem en una exposició o una col·lecció.","da":"Eksemplar, som involverer en kollektiv agents ansvar for at udtænke eller administrere samlingen af et eksemplar til en udstilling eller samling.","de":"Ein Exemplar, bei dem ein gemeinschaftlicher Akteur die Aggregation eines Exemplars in einer Ausstellung oder Sammlung konzipiert oder organisiert.","en":"An item that involves a responsibility of a collective agent for conceiving or managing the aggregation of an item in an exhibition or collection. (Deprecated)","et":"Eksemplar, mis sisaldab kollektiivi vastutust eksemplari näituse või koguga liitmise kavandamise või korraldamise eest.","fi":"Kappale, jonka näyttelyyn tai kokoelmaan kuuluvan kappaleaggregaation aikaansaamisessa tai hallinnoimisessa yhteistoimija on osallisena.","fr":"Item qui comporte une responsabilité de la part d’un agent collectif consistant à concevoir ou à gérer l’agrégation d’un item dans une expositi