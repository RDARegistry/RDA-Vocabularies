                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/trusteeOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50234", "lexicalAlias":"http://rdaregistry.info/Elements/a/officerOf.en", "label":"is officer of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50287", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/trusteeOf.en", "label":"is trustee of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50287", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/trusteeOf.en", "label":"is trustee of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50221","label":{"ar":"هو وكيل مهندس معماري لـ","ca":"és agent arquitecte paisatgista de","cs":"je krajinným architektem (agentem) (čeho)","da":"er agent, som er landskabsarkitekt af","de":"ist Akteur als Landschaftsarchitektin/Landschaftsarchitekt von","de":"ist Akteur als Landschaftsarchitektin/Landschaftsarchitekt von","el":"είναι αρχιτέκτων τοπίου φορέας του","en":"is landscape architect agent of","es":"es agente arquitecto paisajista de","et":"maastikuarhitekt (tegija) teoses","fi":"maisema-arkkitehti (toimija) teoksessa","fr":"est un agent architecte paysagiste de","hu":"tájépítész ágense a következőnek:","it":"è architetto paesaggista agente di","lv":"ir ainavu arhitekts (aģents)","nl":"is landschapsarchitect-actor van","no":"er landskapsarkitekt for (agent)","tr":"peyzaj mimarı temsilcisidir","zh-Hans-CN":"是……的景观设计师行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن تنسيق المواقع الخارجية."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la creació de paisatges."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za vytvoření krajinářských děl."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at skabe landskaber."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung von Landschaften verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung von Landschaften verantwortlich ist."],"el":["Συνδέει έναν αρχιτέκτονα, υπεύθυνο για τη δημιουργία τοπίων, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for creating landscapes."],"es":["Relaciona un agente con una obra que involucra la responsabilidad de un agente de crear paisajes."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust maastikukujunduse arhitektuursete aspektide eest."],"fi":["Liittää toimijan teokseen, jonka maisemoinnin luomisesta toimija on vastuussa."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à créer des paysages."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége a tájépítészet építészeti vonatkozásaiért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per gli aspetti architettonici del paesaggio."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par ainavu arhitektūras aspektiem."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het creëren van landschappen."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av landskapsarkitektoniske aspekter."],"tr":["Bir temsilciyi, bir temsilcinin peyzaj yaratmaya ilişkin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及创作景观的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل مهندس تنسيق المواقع الخارجية","ca":"agent arquitecte paisatgista de","cs":"krajinný architekt (agent) (čeho)","da":"agent, som er landskabsarkitekt af","de":"Akteur als Landschaftsarchitektin/Landschaftsarchitekt 