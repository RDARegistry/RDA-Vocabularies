                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50746", "lexicalAlias":"http://rdaregistry.info/Elements/a/audioEngineerCollectiveAgentOf.en", "label":"is audio engineer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50158", "lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerAgentOf.en", "label":"is recording engineer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50919", "lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerCorporateBodyOf.en", "label":"is recording engineer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51070", "lexicalAlias":"http://rdaregistry.info/Elements/a/recordingEngineerFamilyOf.en", "label":"is recording engineer family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50768", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/recordingEngineerCollectiveAgentOf.en", "label":"is recording engineer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50768", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/recordingEngineerCollectiveAgentOf.en", "label":"is recording engineer collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50919","label":{"ar":"هي هيئة مسئولة عن هندسة التسجيل لـ","ca":"és entitat corporativa enginyera de so de","cs":"je technikem záznamu (korporací) (čeho)","da":"er korporation, som er indspilningstekniker af","de":"ist Körperschaft als Aufnahmetechnikerin/Aufnahmetechniker von","de":"ist Körperschaft als Aufnahmetechnikerin/Aufnahmetechniker von","el":"είναι μηχανικός ηχογράφησης συλλογικό όργανο του","en":"is recording engineer corporate body of","es":"es organismo corporativo ingeniero de grabación de","et":"salvestusinsener (asutus) väljenduses","fi":"äänittäjä (yhteisö) ekspressiossa","fr":"est une collectivité preneuse de son de","hu":"hangrögzítő testülete a következőnek:","it":"è ingegnere della registrazione ente di","lv":"ir ierakstu inženieris (institūcija)","nl":"is opnametechnicus-corporatie van","no":"er innspillingstekniker for (korporasjon)","tr":"ses kayıt mühendisi tüzel kişisidir","zh-Hans-CN":"是……的录制工程师团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa supervisant els aspectes tècnics del contingut àudio d’una sessió d’enregistrament."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispěníkorporace tím, že dohlíží na technické aspekty zvukového obsahu nahrávání."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at føre tilsyn med de tekniske aspekter af lydindholdet til en lyd- eller videooptagelse."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie die technischen Aspekte des Audio-Inhalts einer Aufnahme überwacht."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of supervising the technical aspects of the audio content of a recording session."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de supervisar los aspectos técnicos del contenido de audio de una sesión de grabación."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, juhendades helisisu salvestamise tehnilisi aspekte."],"fi":["Liittää yhteisön ekspressioon, jonka äänisisällön tekemiseen yhteisö osallistuu valvomalla äänityksen teknistä toteutusta."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à superviser les aspects techniques du contenu audio d’une séance d’enregistrement."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését a hangtartalom rögzítését szolgáló munkamenet műszaki aspektusainak felügyeletében."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nella supervisione degli aspetti tecnici del contenuto audio di una sessione di registrazione."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, uzraugot audio satura tehniskos parametrus ieraksta laikā."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door toezicht houden op de technische aspecten van de geluidscontent van een opnamesessie."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å lede de tekniske aspektene av lydinnholdet under en innspilling."],"tr":["Bir tüzel kişiyi, bir kayıt oturumunun ses içeriğinin teknik yönlerini denetlemek üzere bir tüzel kişinin yaptığı katkıyı içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括监督一个录制过程中的音频内容的技术方面的一个团体的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن هندسة التسجيل","ca":"entitat corporativa enginyera de so de","cs":"technik záznamu (korporace) (čeho)","da":"korporation, som er indspilningstekniker af","de":"Körperschaft als Aufnahmetechnikerin/Aufnahmetechniker von","de":"Körperschaft als Aufnahmetechnikerin/Aufnahmetechniker von","el":"μηχανικός ηχογράφησης συλλογικό όργανο του","en":"recording engineer corporate body of","es":"organismo corporativo ingeniero de grabación de","et":"salvestusinsener (asutus) väljenduses","fi":"äänittäjä (yhteisö) ekspr