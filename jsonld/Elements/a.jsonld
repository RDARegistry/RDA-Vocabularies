                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/filmmakerFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50995", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfWorkOf.en", "label":"is creator family of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50681", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmmakerCollectiveAgentOf.en", "label":"is filmmaker collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50983", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/filmmakerFamilyOf.en", "label":"is filmmaker family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50983", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/filmmakerFamilyOf.en", "label":"is filmmaker family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50530","label":{"ar":"هو شخص صانع أفلام لـ","ca":"és persona cineasta de","cs":"je filmařem (osobou) (čeho)","da":"er person, som er filmskaber af","de":"ist Person als Filmemacherin/Filmemacher von","de":"ist Person als Filmemacherin/Filmemacher von","el":"είναι σκηνοθέτης φυσικό πρόσωπο του","en":"is filmmaker person of","es":"es persona cineasta de","et":"filmitegija (isik) teoses","fi":"elokuvantekijä (henkilö) teoksessa","fr":"est une personne cinéaste de","hu":"filmkészítő személye a következőnek:","it":"è regista cinematografico persona di","lv":"ir filmas veidotājs (persona)","nl":"is filmmaker-persoon van","no":"er filmskaper av (person)","tr":"film üreticisi kişisidir","zh-Hans-CN":"是……的制片人个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن فيلم مستقل أو شخصي."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la creació d’una pel·lícula cinematogràfica independent o personal."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za vytvoření nezávislého nebo autorského filmu."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at skabe en indiefilm eller personlig film."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for creating an independent or personal film."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona en la creación de una película independiente o personal."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust sõltumatu või autorifilmi eest."],"fi":["Liittää henkilön teokseen, jossa hennkilö on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à créer un film indépendant ou personnel."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy független- vagy magánfilm létrehozásáért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per un film indipendente o personale."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos."],"nl":["Relateert een persoon aan een werk met zich meebrengt een verantwoordelijkheid van een persoon voor het creëren van een zelfstandige of persoonlijke film."],"no":["Relaterer en person til et verk som involverer et ansvar for en person for en uavhengig eller personlig film."],"tr":["Bir kişiyi, bağımsız veya kişisel bir film yaratma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及创作一部独立或个人电影的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص صانع أفلام","ca":"persona cineasta de","cs":"filmař (osoba) (čeho)","da":"person, som er filmskaber af","de":"ist Person als Filmemacherin/Filmemacher von","de":"ist Person als Filmemacherin/Filmemacher von","el":"σκηνοθέτης φυσικό πρόσωπο του","en":"filmmaker person of","es":"persona cineasta de","et":"filmitegija (isik) teoses","fi":"elokuvantekijä (henkilö) teoksessa","fr":"personne cinéaste de","hu":"filmkészítő személye:","it":"regista cinematografico persona di","lv":"ir filmas veidotājs (persona)","nl":"filmmaker-persoon van","no":"filmskaper av (person)","tr":"film üreticisi","zh-Hans-CN":"……的制片人个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن فيلم مستقل أو شخصي.","ca":"Obra que implica una responsabilitat d’una persona en la creació d’una pel·lícula cinematogràfica independent o personal.","cs":"Dílo, které zahrnuje odpovědnost osoby za vytvoření nezávislého nebo autorského filmu.","da":"Værk, som involverer en persons ansvar for at skabe en indiefilm eller personlig film.","de":"Ein Werk, bei dem eine Person für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.","de":"Ein Werk, bei dem eine Person für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.","en":"A work that involves a responsibility of a person for creating an independent or personal film.","es":"Una obra que implica la responsabilidad de una persona en la creación de una película independiente o personal.","et":"Teos, mis sisaldab isiku vastutust sõltumatu või autorifilmi eest.","fi":"Teos, jossa hennkilö on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à créer un film indépendant ou personnel.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy független- vagy magánfilm létrehozásáért.","it":"Opera che implica una responsabilità di una persona per un film indipendente o personale.","lv":"Darbs, kas ietver personas atbildību par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos.","nl":"Een werk met zich meebrengt een verantwoordelijkheid van een persoon voor het creëren van een zelfstandige of persoonlijke film.","no":"Et verk som involverer et ansvar for en person for en uavhengig eller personlig film.","tr":"Bağımsız veya kişisel bir film yaratmak için bir kişinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及创作一部独立或个人电影的一个个人的责任的一种作品"},"note":{"ar":["صانع الفيلم هو المسئول بصورة فردية عن تصور جميع جوانب الفيلم وتنفيذها."],"ca":["Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula."],"cs":["Filmař je individuálně zodpovědný za koncepci a provedení všech aspektů filmu."],"da":["Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter."],"de":["Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.,Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich."],"en":["A filmmaker is individually responsible for the conception and execution of all aspects of the film."],"es":["Un cineasta es individualmente responsable de la concepción y ejecución de todos los aspectos de la película."],"et":["Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest."],"fi":["Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta."],"fr":["Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film."],"hu":["Egy filmkészítő egyénileg felelős egy film koncepciójáért és összes aspektusának végrehajtásáért."],"it":["Un regista è individualmente responsabile dell'ideazione ed esecuzione di tutti gli aspetti del film."],"lv":["Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem."],"nl":["Een filmmaker is zelf verantwoordelijk voor het idee en de uitvoering van alle aspecten van de film."],"no":["En filmskaper har personlig ansvar for planen med og gjennomføringen av alle aspektene ved filmen."],"tr":["Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur."],"zh-Hans-CN":["制片人对电影所有方面的构思和执行负有个人责任"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/filmmakerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50197", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmmakerAgentOf.en", "label":"is filmmaker agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50530", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/filmmakerPersonOf.en", "label":"is filmmaker person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50530", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/filmmakerPersonOf.en", "label":"is filmmaker person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50213","label":{"ar":"هو وكيل منتج لفيلم لـ","ca":"és agent productor cinematogràfic de","cs":"je filmovým producentem (agentem) (čeho)","da":"er agent, som er filmproducer af","de":"ist Akteur als Filmproduzentin/Filmproduzent von","de":"ist Akteur als Filmproduzentin/Filmproduzent von","el":"είναι παραγωγός ταινίας φορέας του","en":"is film producer agent of","es":"es agente productor fílmico de","et":"filmiprodutsent (tegija) teoses","fi":"elokuvatuottaja (toimija) teoksessa","fr":"est un agent producteur de cinéma de","hu":"filmproducer ágense a következőnek:","it":"è produttore cinematografico agente di","lv":"ir filmas producents (aģents)","nl":"is filmproducent-actor van","no":"er filmprodusent av (agent)","tr":"film yapımcısı temsilcisidir","zh-Hans-CN":"是……的电影制作人行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن معظم الجوانب التجارية لإنتاج فيلم."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la majoria dels aspectes comercials de la producció d’una pel·lícula."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za většinu obchodních aspektů výroby filmu."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for størstedelen af de forretningsmæssige aspekter ved en film."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist."],"el":["Συνδέει έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές ενός φιλμ, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for most of the business aspects of the production of a film."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente para la mayoría de los aspectos comerciales de la producción de un film."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust enamiku äriliste aspektide eest filmi tootmisel."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa suurimmasta osasta elokuvan liiketoimintaa."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne la majeure partie des aspects commerciaux de la production d’un film."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy filmprodukció legtöbb üzleti vonatkozásáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per la maggior parte degli aspetti commerciali della produzione di un film."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par filmas uzņemšanas finansiālajiem aspektiem."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het merendeel van de zakelijke aspecten van de productie van een film."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av de fleste forretningsmessige aspektene ved produksjon av en film."],"tr":["Bir temsilciyi, bir filmin yapımının çoğu ticari yönüne ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及电影制作的大部分商业运作的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل منتج لفيلم لـ","ca":"agent productor cinematogràfic de","cs":"filmový producent (agent) (čeho)","da":"agent, som er filmproducer af","de":"Akteur als Filmproduzentin/Filmproduzent von","de":"Akteur als Filmproduzentin/Filmproduzent von","el":"παραγωγός ταινίας φορέας του","en":"film producer agent of","es":"agente productor fílmico de","et":"filmiprodutsent (tegija) teoses","fi":"elokuvatuottaja (toimija) teoksessa","fr":"agent producteur de cinéma de","hu":"filmproducer ágense:","it":"produttore cinematografico agente di","lv":"ir filmas producents (aģents)","nl":"filmproducent-actor van","no":"filmprodusent av (agent)","tr":"film yapımcısı temsilcisi","zh-Hans-CN":"……的电影制作人行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن معظم الجوانب التجارية لإنتاج فيلم.","ca":"Obra que implica una responsabilitat d’un agent en la majoria dels aspectes comercials de la producció d’una pel·lícula.","cs":"Dílo, které zahrnuje odpovědnost agenta za většinu obchodních aspektů výroby filmu.","da":"Værk, som involverer en agents ansvar for størstedelen af de forretningsmæssige aspekter ved en film.","de":"Ein Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της παραγωγής για τις περισσότερες επιχειρηματικές πτυχές ενός φιλμ.","en":"A work that involves a responsibility of an agent for most of the business aspects of the production of a film.","es":"Una obra que involucra una responsabilidad de un agente para la mayoría de los aspectos comerciales de la producción de un film.","et":"Teos, mis sisaldab tegija vastutust enamiku äriliste aspektide eest filmi tootmisel.","fi":"Teos, jossa toimija on vastuussa suurimmasta osasta elokuvan liiketoimintaa.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne la majeure partie des aspects commerciaux de la production d’un film.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy filmprodukció legtöbb üzleti vonatkozásáért.","it":"Opera che implica la responsabilità di un agente per la maggior parte degli aspetti commerciali della produzione di un film.","lv":"Darbs, kas ietver aģenta atbildību par filmas uzņemšanas finansiālajiem aspektiem.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het merendeel van de zakelijke aspecten van de productie van een film.","no":"Et verk som involverer ansvar for en agent i form av de fleste forretningsmessige aspektene ved produksjon av en film.","tr":"Bir filmin yapımının ticari yönlerinin çoğu için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及电影制作的大部分商业运作的一个行为者的责任的一种作品"},"altLabel":{"ar":["منتج الفيلم"],"ca":["productor cinematogràfic de"],"cs":["filmový producent (čeho)"],"da":["filmproducer af"],"de":["Filmproduzent von,Filmproduzent von"],"el":["παραγωγός ταινίας του"],"en":["film producer of"],"es":["productor fílmico de"],"et":["filmiprodutsent teoses"],"fi":["tuottajana elokuvassa"],"fr":["producteur de cinéma de,agent producteur de film de"],"hu":["filmproducere:"],"it":["produttore cinematografico di"],"nl":["filmproducent van"],"no":["filmprodusent av"],"tr":["film yapımcısı"],"zh-Hans-CN":["……的电影制作人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
