                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50449", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToPerformanceOf.en", "label":"is contributor agent to performance of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50730", "lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerCollectiveAgentOf.en", "label":"is lighting designer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50579", "lexicalAlias":"http://rdaregistry.info/Elements/a/lightingDesignerPersonOf.en", "label":"is lighting designer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50256", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lightingDesignerAgentOf.en", "label":"is lighting designer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50256", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lightingDesignerAgentOf.en", "label":"is lighting designer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50730","label":{"ar":"هو وكيل جماعي قائد فرقة عزف لـ","ca":"és agent col·lectiu dissenyador d’il·luminació de","cs":"je designérem osvětlení (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er belysningsdesigner af","de":"ist gemeinschaftlicher Akteur als Lichtgestalterin/Lichtgestalter von","de":"ist gemeinschaftlicher Akteur als Lichtgestalterin/Lichtgestalter von","el":"είναι σχεδιαστής φωτισμού συλλογικός φορέας του","en":"is lighting designer collective agent of","es":"es agente colectivo de diseñadores de iluminación de","et":"valguskujundaja (kollektiiv) väljenduses","fi":"valosuunnittelija (yhteistoimija) ekspressiossa","fr":"est un agent collectif éclairagiste de","hu":"világítástervező kollektív ágense a következőnek:","it":"è progettista dell'illuminazione agente collettivo di","lv":"ir gaismu mākslinieks (grupa)","nl":"is lichtontwerper-collectieve actor van","no":"er lysdesigner for (kollektiv agent)","tr":"ışık tasarımcısı kolektif temsilcisidir","zh-Hans-CN":"是……的灯光设计者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في إدارة فرقة عزف وقيادتها في عرض موسيقي أو درامي."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu en el disseny i creació de components luminotècnics."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispěn kolektivníhoí agenta tím, že navrhuje a vytváří světelnou složku."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at designe og skabe belysningsdele."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er Lichtelemente entwirft und erstellt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er Lichtelemente entwirft und erstellt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of designing and creating lighting components."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo del diseño y creación de componentes de iluminación."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, kavandades ja luues selle valguskomponendid."],"fi":["Liittää yhteistoimijan ekspressioon, jossa yhteistoimija on osallisena suunnittelemalla ja luomalla valokomponentteja."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à concevoir et à créer des effets de lumière."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését világítási összetevők tervezésében és létrehozásában."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nella progettazione e creazione di componenti per l'illuminazione."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, izstrādājot un radot apgaismojuma efektus."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door ontwerpen en creëren van lichteffecten."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å utforme og skape lyssettingskomponenter."],"tr":["Kolektif bir temsilciyi, aydınlatma bileşenlerini tasarlamak ve oluşturmak için kolektif bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括设计并创作灯光组成部分的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هو وكيل جماعي قائد فرقة عزف لـ","ca":"agent col·lectiu dissenyador d’il·luminació de","cs":"designér osvětlení (kolektivní agent) (čeho)","da":"kollektiv agent, som er belysningsdesigner af","de":"Gemeinschaftlicher Akteur als Lichtgestalterin/Lichtgestalter von","de":"Gemeinschaftlicher Akteur als Lichtgestalterin/Lichtgestalter von","el":"σχεδιαστής φωτισμού συλλογικός φορέας του","en":"lighting designer collective agent of","es":"agente colectivo de diseñadores de iluminación de","et":"valguskujundaja (kollektiiv) väljenduses","fi":"valosuunnittelija (yhteistoimija) ekspressiossa","fr":"agent collectif éclairagiste de","hu":"világítástervező kollektív ágense:","it":"progettista dell'illuminazione agente collettivo di","lv":"ir gaismu mākslinieks (grupa)","nl":"lichtontwerper-collectieve actor van","no":"lysdesigner for (kollektiv agent)","tr":"Işık tasarımcısı kollektif temsilci","zh-Hans-CN":"……的灯光设计者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام 