                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50311", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfPerson.en", "label":"has related work of person"},{"@id":"http://rdaregistry.info/Elements/a/P50205", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOf.en", "label":"is director agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50562", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDirectorPersonOf.en", "label":"is film director person of"},{"@id":"http://rdaregistry.info/Elements/a/P50563", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorPersonOf.en", "label":"is radio director person of"},{"@id":"http://rdaregistry.info/Elements/a/P50564", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionDirectorPersonOf.en", "label":"is television director person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50561", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorPersonOf.en", "label":"is director person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50561", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorPersonOf.en", "label":"is director person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50537","label":{"ar":"هو شخص مدير تصوير لـ","ca":"és persona directora de fotografia de","cs":"je hlavním kameramanem (osobou) (čeho)","da":"er person, som er filmfotograf af","de":"ist Person als Kamerafrau/Kameramann von","de":"ist Person als Kamerafrau/Kameramann von","el":"είναι διευθυντής φωτογραφίας φυσικό πρόσωπο του","en":"is director person of photography of","es":"es director de fotografía de","et":"operaator-lavastaja (isik) teoses","fi":"kuvaaja (henkilö) teoksessa","fr":"est une personne directrice de la photographie de","hu":"operatőr személye a következőnek:","it":"è direttore persona della fotografia di","lv":"ir kinooperators (persona)","nl":"is cameraregisseur-persoon van","no":"er filmfotograf for (person)","tr":"görüntü yönetmeni kişisidir","zh-Hans-CN":"是……的摄影指导个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن التقاط الصور، إما إلكترونيًا أو في فيلم أو في مقاطع فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a person to a work that involves a responsibility of a person for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona de capturar imágenes, ya sea electrónicamente o en película o video, y a menudo seleccionar y organizar la iluminación."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting."],"tr":["Bir kişiyi, elektronik olarak veya film veya video stoku üzerinde fotoğraf çekme ve genellikle aydınlatmayı seçme ve düzenleme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص مدير التصوير","ca":"persona directora de fotografia de","cs":"hlavní kameraman (osoba) (čeho)","da":"person, som er filmfotograf af","de":"Person als Kamerafrau/Kameramann von","de":"Person als Kamerafrau/Kameramann von","el":"διευθυντής φωτογραφίας φυσικό πρόσωπο του","en":"director person of photography of","es":"director de fotografía de","et":"operaator-lavastaja (isik) teoses","fi":"kuvaaja (henkilö) teoksessa","fr":"personne directrice de la photographie de","hu":"operatőr személye:","it":"direttore della fotografia persona di","lv":"ir kinooperators (persona)","nl":"cameraregisseur-persoon van","no":"filmfotograf for (person)","tr":"görüntü yönetmeni","zh-Hans-CN":"……的摄影指导个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن التقاط الصور، إما إلكترونيًا أو في فيلم أو في مقاطع فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها.","ca":"Obra que implica una responsabilitat d’una persona en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació.","cs":"Dílo, které zahrnuje odpovědnost osoby za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení.","da":"Værk, som involverer en persons ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen.","de":"Ein Werk, bei dem eine Person für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","de":"Ein Werk, bei dem eine Person für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","en":"A work that involves a responsibility of a person for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting.","es":"Una obra que implica la responsabilidad de una persona de capturar imágenes, ya sea electrónicamente o en película o video, y a menudo seleccionar y organizar la iluminación.","et":"Teos, mis sisaldab isiku vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest.","fi":"Teos, jossa henkilö on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is.","it":"Opera che implica una responsabilità di una persona per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione.","lv":"Darbs, kas ietver personas atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting.","no":"Et verk som involverer et ansvar for en person i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting.","tr":"Elektronik olarak veya film veya video stoğunda görüntü yakalamak ve genellikle aydınlatmayı seçmek ve düzenlemek için bir kişinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个个人的责任的一种作品"},"note":{"ar":["ويطلق أيضًا على مدير تصوير الفيلم كبير المصورين السينمائيين ."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Un director de fotografía de una película también se denomina jefe de fotografía."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia di un film è anche definito capo cameraman."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur bij een film wordt ook director of photography of hoofdcinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorPersonOfPhotographyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50311", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfPerson.en", "label":"has related work of person"},{"@id":"http://rdaregistry.info/Elements/a/P50207", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOfPhotographyOf.en", "label":"is director agent of photography of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50537", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorPersonOfPhotographyOf.en", "label":"is director person of photography of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50537", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorPersonOfPhotographyOf.en", "label":"is director person of photography of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50199","label":{"ar":"هو وكيل موزع لـ","ca":"és agent distribuïdor de","cs":"je distributorem (agentem) (čeho)","da":"er agent, som er distributør af","de":"ist Akteur als Vertrieb von","de":"ist Akteur als Vertrieb von","el":"είναι διανομέας φορέας του","en":"is distributor agent of","es":"es agente distribuidor de","et":"levitaja (tegija) kehastuses","fi":"jakelija (toimija) manifestaatiossa","fr":"est un agent diffuseur ou distributeur de","hu":"terjesztő ágense a következőnek:","it":"è distributore agente di","lv":"ir izplatītājs (aģents)","nl":"is distributeur-actor van","no":"er distributør av (agent)","tr":"dağıtımcı temsilcisidir","zh-Hans-CN":"是……的发行者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل عن التوزيع."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent en la distribució."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za distribuci."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for distribution."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für den Vertrieb verantwortlich ist.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für den Vertrieb verantwortlich ist."],"el":["Συνδέει έναν φορέα υπεύθυνο για τη διανομή μιας εκδήλωσης, με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for distribution."],"es":["Relaciona un agente con una manifestación que involucra una responsabilidad de un agente para la distribución."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust levitamise eest."],"fi":["Liittää toimijan manifestaatioon, jonka jakelusta toimija on vastuussa."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent en ce qui concerne la diffusion ou la distribution."],"hu":["Hozzákapcsol egy ágenst egy megjelenési formához, amelyhez hozzátartozik egy ágens felelőssége a terjesztésért."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente nella distribuzione."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par izplatīšanu."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor distributie."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av distribusjon."],"tr":["Bir temsilciyi, dağıtma için sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及发行的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل موزع","ca":"agent distribuïdor de","cs":"distributor (agent) (čeho)","da":"agent, som er distributør af","de":"Akteur als Vertrieb von","de":"Akteur als Vertrieb von","el":"διανομέας φορέας του","en":"distributor agent of","es":"agente distribuidor de","et":"levitaja (tegija) kehastuses","fi":"jakelija (toimija) manifestaatiossa","fr":"agent diffuseur ou distributeur de","hu":"terjesztő ágense:","it":"distributore agente di","lv":"ir izplatītājs (aģents)","nl":"distributeur-actor van","no":"distributør av (agent)","tr":"dağıtıcı temsilci","zh-Hans-CN":"……的发行者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن التوزيع.","ca":"Manifestació que implica una responsabilitat d’un agent en la distribució.","cs":"Provedení, které zahrnuje odpovědnost agenta za distribuci.","da":"Manifestation, som involverer en agents ansvar for distribution.","de":"Eine Manifestation, bei der ein Akteur für den Vertrieb verantwortlich ist.","de":"Eine Manifestation, bei der ein Akteur für den Vertrieb verantwortlich ist.","el":"Μια εκδήλωση η οποία διανέμεται.","en":"A manifestation that involves a responsibility of an agent for distribution.","es":"Una manifestación que involucra una responsabilidad de un agente para la distribución.","et":"Kehastus, mis sisaldab tegija vastutust levitamise eest.","fi":"Manifestaatio, jonka jakelusta toimija on vastuussa.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent en ce qui concerne la diffusion ou la distribution.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy ágens felelőssége a terjesztésért.","it":"Manifestazione che implica la responsabilità di un agente nella distribuzione.","lv":"Manifestācija, kas ietver aģenta atbildību par izplatīšanu.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor distributie.","no":"En manifestasjon som involverer ansvar for en agent i form av distribusjon.","tr":"Dağıtım için bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及发行的一个行为者的责任的一种载体表现"},"altLabel":{"ar":["موزع"],"ca":["distribuïdor de"],"cs":["distributor (čeho)"],"da":["distributør af"],"de":["Vertrieb von,Vertrieb von"],"el":["διαθέτης του"],"en":["distributor of"],"es":["agente distribuidor de"],"et":["levitaja kehastuses"],"fi":["jakelija aineistossa"],"fr":["diffuseur ou distributeur de"],"hu":["terjesztője:"],"it":["distributore di"],"nl":["distributeur van"],"no":["distributør av"],"tr":["dağıtıcı"],"zh-Hans-CN":["……的发行者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/distributorAgentOf.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50307", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedManifestationOfAgent.en", "label":"has related manifestation of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50648", "lexicalAlias":"http://rdaregistry.info/Elements/a/distributorCollectiveAgentOf.en", "label":"is distributor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50497", "lexicalAlias":"http://rdaregistry.info/Elements/a/distributorPersonOf.en", "label":"is distributor person of"},{"@id":"http://rdaregistry.info/Elements/a/P50169", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDistributorAgentOf.en", "label":"is film distributor agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50199", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/distributorAgentOf.en", "label":"is distributor agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50199", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/distributorAgentOf.en", "label":"is distributor agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50648","label":{"ar":"هو وكيل جماعي موزع لـ","ca":"és agent col·lectiu distribuïdor de","cs":"je distributorem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er distributør af","de":"ist gemeinschaftlicher Akteur als Vertrieb von","de":"ist gemeinschaftlicher Akteur als Vertrieb von","el":"είναι διανομέας συλλογικός φορέας του","en":"is distributor collective agent of","es":"es agente colectivo distribuidor de","et":"levitaja (kollektiiv) kehastuses","fi":"jakelija (yhteistoimija) manifestaatiossa","fr":"est un agent collectif diffuseur ou distrib