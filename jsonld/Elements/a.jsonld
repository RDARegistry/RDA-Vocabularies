                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/reviserAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50161", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfExpressionOf.en", "label":"is creator agent of expression of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50157", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerAgentOf.en", "label":"is abridger agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50137", "lexicalAlias":"http://rdaregistry.info/Elements/a/arrangerAgentOfMusicOf.en", "label":"is arranger agent of music of"},{"@id":"http://rdaregistry.info/Elements/a/P50271", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorAgentOf.en", "label":"is censor agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50273", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistAgentOfExpressionOf.en", "label":"is restorationist agent of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50744", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en", "label":"is reviser collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50593", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserPersonOf.en", "label":"is reviser person of"},{"@id":"http://rdaregistry.info/Elements/a/P50142", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberAgentOf.en", "label":"is transcriber agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50447", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/reviserAgentOf.en", "label":"is reviser agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50447", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/reviserAgentOf.en", "label":"is reviser agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50744","label":{"ar":"هو وكيل جماعي مراجع لـ","ca":"és agent col·lectiu revisor de","cs":"je korektorem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er omarbejder af","de":"ist gemeinschaftlicher Akteur als Überarbeiterin/Überarbeiter von","de":"ist gemeinschaftlicher Akteur als Überarbeiterin/Überarbeiter von","el":"είναι αναθεωρητής συλλογικός φορέας του","en":"is reviser collective agent of","es":"es agente colectivo revisor de","et":"redigeerija (kollektiiv) väljenduses","fi":"tarkistaja (yhteistoimija) ekspressiossa","fr":"est un agent collectif réviseur de","hu":"átdolgozó kollektív ágense a következőnek:","it":"è revisore agente collettivo di","lv":"ir korektors (grupa)","nl":"is herziener-collectieve actor van","no":"er omarbeider av (kollektiv agent)","tr":"gözden geçiren kolektif temsilcisidir","zh-Hans-CN":"是……的修订者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي لإجراء تغييرات على محتوى تعبيرة أخرى."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu fent canvis en el contingut d’una altra expressió."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že provádí změny v obsahu jiného vyjádření."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at foretage ændringer i indholdet af et andet udtryk."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of making changes to the content of another expression."],"es":["Relaciona un agente colectivo con un expresión que incluye una contribución de un agente colectivo de hacer cambios al contenido de otra expresión."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, tehes muudatusi teise väljenduse sisusse."],"fi":["Liittää yhteistoimijan ekspressioon, jossa yhteistoimija on osallisena ekspression tekemisessä tekemällä muutoksia toisen ekspression sisältöön."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à apporter des modifications au contenu d’une autre expression."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését egy másik kifejezési forma tartalmának megváltoztatásában."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nell'apportare modifiche al contenuto di un'altra espressione."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, veicot izmaiņas citas izteiksmes saturā."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door wijzigingen te maken in de content van een andere expressie."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å gjøre endringer i innholdet av et annet uttrykk."],"tr":["Kolektif bir temsilciyi, başka bir ifadenin içeriğinde değişiklik yapmak için kolektif bir temsilcinin katkısını içeren bir anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括对另一种内容表达的内容作改动的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مراجع","ca":"agent col·lectiu revisor de","cs":"korektor (kolektivní agent) (čeho)","da":"kollektiv agent, som er omarbejder af","de":"Gemeinschaftlicher Akteur als Überarbeiterin/Überarbeiter von","de":"Gemeinschaftlicher Akteur als Überarbeiterin/Überarbeiter von","el":"αναθεωρητής συλλογικός φορέας του","en":"reviser collective agent of","es":"agente colectivo revisor de","et":"redigeerija (kollektiiv) väljenduses","fi":"tarkistaja (yhteistoimija) ekspressiossa","fr":"agent collectif réviseur de","hu":"átdolgozó kollektív ágense:","it":"revisore agente collettivo di","lv":"ir korektors (grupa)","nl":"herziener-collectieve actor van","no":"omarbeider av (kollektiv agent)","tr":"gözden geçiren kolektif temsilci","zh-Hans-CN":"……的修订者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي لإجراء تغييرات على محتوى تعبيرة أخرى.","ca":"Expressió que inclou una contribució d’un agent col·lectiu fent canvis en el contingut d’una altra expressió.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že provádí změny v obsahu jiného vyjádření.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at foretage ændringer i indholdet af et andet udtryk.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er am Inhalt einer anderen Expression Veränderungen vornimmt.","en":"An expression that includes a contribution by a collective agent of making changes to the content of another expression.","es":"Una expresión que incluye una contribución de un agente colectivo de hacer cambios al contenido de otra expresión.","et":"Väljendus, millesse kollektiiv on andnud panuse, tehes muudatusi teise väljenduse sisusse.","fi":"Ekspressio, jonka tekemiseen yhteistoimija osallistuu tekemällä muutoksia toisen ekspression sisältöön.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à apporter des modifications au contenu d’une autre expression.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését egy másik kifejezési forma tartalmának megváltoztatásában.","it":"Espressione che comprende un contributo di un agente collettivo nell'apportare modifiche al contenuto di un'altra espressione.","lv":"Izteiksme, kas ietver grupas ieguldījumu, veicot izmaiņas citas izteiksmes saturā.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door wijzigingen te maken in de content van een andere expressie.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å gjøre endringer i innholdet av et annet uttrykk.","tr":"Başka bir anlatımın içeriğinde değişiklik yapan kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括对另一种内容表达的内容作改动的一个集体行为者的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
