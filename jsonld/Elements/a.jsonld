                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/commentatorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50603", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerPersonOf.en", "label":"is performer person of"},{"@id":"http://rdaregistry.info/Elements/a/P50080", "lexicalAlias":"http://rdaregistry.info/Elements/a/commentatorAgentOf.en", "label":"is commentator agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50606", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/commentatorPersonOf.en", "label":"is commentator person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50606", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/commentatorPersonOf.en", "label":"is commentator person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50262","label":{"ar":"هو وكيل جهة تكليف بـ","ca":"és agent comitent de","cs":"je zadavatelem (agentem) (čeho)","da":"er agent, som er opgavestiller af","de":"ist Akteur als Auftraggeberin/Auftraggeber von","de":"ist Auftraggeberin/Auftraggeber von","el":"είναι αναθέτον όργανο φορέας του","en":"is commissioning agent of","es":"es agente comisionante de","et":"tellija (tegija) teoses","fi":"toimeksiantaja (toimija) teoksessa","fr":"est un agent commanditaire de","hu":"megrendelő ágense a következőnek:","it":"è committente agente di","lv":"ir pasūtītājs (aģents)","nl":"is opdrachtgever-actor van","no":"er oppdragsgiver for (agent)","tr":"görevlendiren temsilcisidir","zh-Hans-CN":"是……的委托行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن إصدار تكليف بعمل."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent d’encarregar una obra."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za zadání díla."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at bestille et værk."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur dafür verantwortlich ist, ein Werk in Auftrag zu geben.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur dafür verantwortlich ist, ein Werk in Auftrag zu geben."],"el":["Συνδέει έναν φορέα υπεύθυνο για την ανάθεση ενός έργου, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for commissioning a work."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de comisionar una obra."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust teose tellimise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa teoksen teettämisestä."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à commander une œuvre."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy mű megrendeléséért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente nella committenza di un'opera."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par darba pasūtīšanu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor opdracht geven tot een werk."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av å gi et verk som oppdrag."],"tr":["Bir temsilciyi, bir eserin görevlendirilmesine ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及委托一种作品的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جهة تكليف بـ","ca":"agent comitent de","cs":"zadavatel (agent) (čeho)","da":"agent, som er opgavestiller af","de":"Akteur als Auftraggeberin/Auftraggeber von","de":"Akteur als Auftraggeberin/Auftraggeber von","el":"αναθέτον όργανο φορέας του",