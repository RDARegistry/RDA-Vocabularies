                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/translatorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50927", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfExpressionOf.en", "label":"is creator corporate body of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50736", "lexicalAlias":"http://rdaregistry.info/Elements/a/translatorCollectiveAgentOf.en", "label":"is translator collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50887", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/translatorCorporateBodyOf.en", "label":"is translator corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50887", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/translatorCorporateBodyOf.en", "label":"is translator corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51038","label":{"ar":"هي عائلة مترجمة لـ","ca":"és família traductora de","cs":"je překladatelem (rodinou) (čeho)","da":"er familie, som er oversætter af","de":"ist Familie als Übersetzerin/Übersetzer von","de":"ist Familie als Übersetzerin/Übersetzer von","el":"είναι μεταφραστής οικογένεια του","en":"is translator family of","es":"es familia traductora de","et":"tõlkija (perekond) väljenduses","fi":"kääntäjä (suku) ekspressiossa","fr":"est une famille traductrice de","hu":"fordító családja a következőnek:","it":"è traduttore famiglia di","lv":"ir tulkotājs (dzimta/ģimene)","nl":"is vertaler-familie van","no":"er oversetter for (familie)","tr":"tercüman ailesidir","zh-Hans-CN":"是……的译者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في التعبير عن المحتوى اللغوي لعمل بلغة مختلفة."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família expressant el contingut lingüístic de l’obra en una llengua diferent."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že vyjadřuje jazykový obsah díla jiným jazykem."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at udtrykke værkets sproglige indhold på et andet sprog."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie den sprachlichen Inhalt des Werks in einer anderen Sprache ausdrückt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie den sprachlichen Inhalt des Werks in einer anderen Sprache ausdrückt."],"en":["Relates a family to an expression that includes a contribution by a family of expressing the linguistic content of the work in a different language."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de expresar el contenido lingüístico de la obra en un lenguaje diferente."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, väljendades teose keelesisu teises keeles."],"fi":["Liittää suvun ekspressioon, jonka tekemisessä suku on osallisena ilmaisemalla teoksen kielellisen sisällön toisella kielellä."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à exprimer le contenu linguistique de l’œuvre dans une langue différente."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését egy mű nyelvi tartalmának más nyelven történő kifejezésével."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nell'esprimere il contenuto linguistico dell'opera in una lingua differente."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, izsakot darba saturu valodā, kas atšķiras no sākotnējās darba valodas."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie van uitdrukken van de taalkundige content van het werk in een andere taal."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å uttrykke det språklige innholdet av et verk på et annet språk."],"tr":["Bir aileyi, eserin dilsel içeriğini farklı bir dilde ifade eden bir ailenin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括用另一种语言表达作品语言内容的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة مترجمة","ca":"família traductora de","cs":"překladatel (rodina) (čeho)","da":"familie, som er oversætter af","de":"Familie als Übersetzerin/Übersetzer von","de":"Familie als Übersetzerin/Übersetzer von","el":"μεταφραστής οικογένεια του","en":"translator family of","es":"familia traductora de","et":"tõlkija (perekond) väljenduses","fi":"kääntäjä (suku) ekspressiossa","fr":"famille traductrice de","hu":"fordító családja:","it":"traduttore famiglia di","lv":"ir tulkotājs (dzimta/ģimene)","nl":"vertaler-familie van","no":"oversetter for (familie)","tr":"tercüman ailesi","zh-Hans-CN":"……的译者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في التعبير عن المحتوى اللغوي لعمل بلغة مختلفة.","ca":"Expressió que inclou una contribució d’una família expressant el contingut lingüístic de l’obra en una llengua diferent.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že vyjadřuje jazykový obsah díla jiným jazykem.","da":"Udtryk, som omfatter en families bidrag ved at udtrykke værkets sproglige indhold på et andet sprog.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie den sprachlichen Inhalt des Werks in einer anderen Sprache ausdrückt.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie den sprachlichen Inhalt des Werks in einer anderen Sprache ausdrückt.","en":"An expression that includes a contribution by a family of expressing the linguistic content of the work in a different language.","es":"Una expresión que incluye una contribución de una familia de expresar el contenido lingüístico de la obra en un lenguaje diferente.","et":"Väljendus, millesse perekond on andnud panuse, väljendades teose keelesisu teises keeles.","fi":"Ekspressio, jonka tekemisessä suku on osallisena ilmaisemalla teoksen kielellisen sisällön toisella kielellä.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à exprimer le contenu linguistique de l’œuvre dans une langue différente.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését egy mű nyelvi tartalmának más nyelven történő kifejezésével.","it":"Espressione che comprende un contributo di una famiglia nell'esprimere il contenuto linguistico dell'opera in una lingua differente.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, izsakot darba saturu valodā, kas atšķiras no sākotnējās darba valodas.","nl":"Een expressie die omvat een bijdrage door een familie van uitdrukken van de taalkundige content van het werk in een andere taal.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å uttrykke det språklige innholdet av et verk på et annet språk.","tr":"Eserin dilsel içeriğini farklı bir dilde ifade eden bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括用另一种语言表达作品语言内容的一个家族的贡献的一种内容表达"},"note":{"ar":["يمكن للمترجم أيضًا ترجمة المحتوى اللغوي بين أشكال اللغة نفسها خلال فترات زمنية مختلفة."],"ca":["Un traductor també pot traduir un contingut lingüístic entre formes de la mateixa llengua de diferents períodes de temps."],"cs":["Překladatel může také překládat jazykový obsah mezi formami téhož jazyka z různých časových období."],"da":["En oversætter kan også oversætte sprogligt indhold mellem former af samme sprog fra forskellige tidsperioder."],"de":["Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden.,Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden."],"el":["Ένας μεταφραστής μπορεί επίσης να μεταφράσει γλωσσικό περιεχόμενο μεταξύ μορφών της ίδιας γλώσσας από διαφορετικές χρονικές περιόδους."],"en":["A translator may also translate linguistic content between forms of the same language from different time periods."],"es":["Un traductor también puede traducir contenido lingüístico entre formas del mismo lenguaje desde diferentes periodos de tiempo."],"et":["Tõlkija võib keelesisu tõlkida ka sama keele eri ajaperioodidel kasutatud vormide vahel."],"fi":["Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien kielimuotojen välillä."],"fr":["Un traducteur peut également traduire un contenu linguistique dans une même langue depuis une forme datant d’une période donnée vers une forme datant d’une autre période."],"hu":["Egy fordító ugyanannak a nyelvnek a különböző időszakokból származó formái közötti nyelvi tartalmat is fordíthatja."],"it":["Un traduttore può anche tradurre un contenuto linguistico tra forme della stessa lingua di periodi di tempo diversi."],"lv":["Tulkotājs var tulkot saturu no senākas valodas formas mūsdienu valodas formā vienas valodas ietvaros."],"nl":["Een vertaler kan ook taalkundige content vertalen tussen vormen van dezelfde taal uit verschillende tijdperiodes."],"no":["En oversetter kan også oversette språklig innhold mellom ulike former av det samme språket fra ulike tidsperioder."],"tr":["Bir çevirmen, aynı dilin farklı zaman dilimlerindeki biçimleri arasında da dilsel içerik çevirisi yapabilir."],"zh-Hans-CN":["译者还可以在同一种语言的不同时期的形式之间翻译语言内容。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
