                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"lexicalAlias":"http://rdaregistry.info/Elements/a/descendantFamilyOfPersonOf.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50056", "lexicalAlias":"http://rdaregistry.info/Elements/a/personMemberOfFamily.en", "label":"has person member of family"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50055", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/descendantFamilyOfPersonOf.en", "label":"is descendant family of person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50055", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/descendantFamilyOfPersonOf.en", "label":"is descendant family of person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50013","label":{"ar":"لها نتاج دمج","ca":"té com a resultat de fusió","cs":"má produkt sloučení","da":"har produkt af sammenlægning","de":"hat Ergebnis einer Fusion","de":"hat Ergebnis einer Fusion","el":"έχει προϊόν της συγχώνευσης","en":"has product of merger","es":"tiene producto de fusión","et":"ühinemisel moodustunud asutus","fi":"yhdistymisestä muodostunut yhteisö","fr":"a pour résultat de fusion","hu":"beolvadás eredménye a következő:","it":"ha come risultato di accorpamento","lv":"apvienotā institūcija","nl":"heeft resultaat van fusie","no":"har resultat av sammenslåing","tr":"birleşme sonucu oluşan tüzel kişi ile ilişkilidir","zh-Hans-CN":"有合并而成的团体"},"definition":{"ar":["يربط هيئة بهيئة نتجت عن اندماج هيئتين أو أكثر من الهيئات الأخرى."],"ca":["Relaciona una entitat corporativa amb una entitat corporativa que és el resultat d’una fusió de dues o més entitats corporatives."],"cs":["Vztahuje korporaci ke korporaci, která vznikla sloučením dvou nebo více jiných korporací."],"da":["Relaterer en korporation til en korporation, som er resultatet af en sammenlægning af to eller flere andre korporationer."],"de":["Setzte eine Körperschaft in Beziehung zu einer Körperschaft, die aus einer Fusion von zwei oder mehreren Körperschaften entstanden ist.,Setzte eine Körperschaft in Beziehung zu einer Körperschaft, die aus einer Fusion von zwei oder mehreren Körperschaften entstanden ist."],"el":["Συνδέει ένα συλλογικό όργανο με ένα συλλογικό όργανο το οποίο προέκυψε από τη συγχώνευση δύο ή περισσότερων συλλογικών οργάνων."],"en":["Relates a corporate body to a corporate body who resulted from a merger of two or more other corporate bodies."],"es":["Relaciona un organismo corporativo con un organismo corporativo que resultó de una fusión de dos o más órganos corporativos."],"et":["Seostab asutuse asutusega, mis on kahe või enama asutuse ühinemise tulemus."],"fi":["Liittää yhteisön kahden tai useamman yhteisön yhdistymisestä muodostuneeseen yhteisöön."],"fr":["Met une collectivité en relation avec une collectivité qui a résulté d’une fusion entre deux ou plusieurs autres collectivités."],"hu":["Hozzákapcsol egy testületet egy testülethez, amelyet két vagy több másik testület összeolvadása eredményezett."],"it":["Correla un ente a un ente che è il risultato dell'accorpamento di due o più altri enti."],"lv":["Sasaista institūciju ar institūciju, kas izveidojās, apvienojoties divām vai vairākām institūcijām."],"nl":["Relateert een corporatie aan een corporatie die resulteerde uit een fusie van twee of meer andere corporaties."],"no":["Relaterer en korporasjon til en korporasjon som er resultat av en fusjon av to eller flere andre korporasjoner."],"tr":["Bir tüzel kişiyi, iki veya daha fazla başka tüzel kişinin birleşmesi sonucu ortaya çıkan bir tüzel kişiyle ilişkilendirir"],"zh-Hans-CN":["将一个团体与两个或多个其他团体合并后产生的团体关联起来。"]},"ToolkitLabel":{"ar":"نتاج دمج","ca":"resultat de fusió","cs":"produkt sloučení","da":"produkt af sammenlægning","de":"Ergebnis einer Fusion","de":"Ergebnis einer Fusion","el":"προϊόν της συγχώνευσης","en":"product of merger","es":"producto de fusión","et":"ühinemisel moodustunud asutus","fi":"yhdistymisestä muodostunut yhteisö","fr":"résultat de fusion","hu":"beolvadás eredménye:","it":"risultato di un accorpamento","lv":"apvienotā institūcija","nl":"resultaat van fusie","no":"resultat av sammenslåing","tr":"birleşme ürünü","zh-Hans-CN":"合并而成的团体"},"ToolkitDefinition":{"ar":"هيئة نتجت عن اندماج هيئتين أو أكثر من الهيئات الأخرى.","ca":"Entitat corporativa que és el resultat d’una fusió de dues o més entitats corporatives.","cs":"Korporace, která vznikla sloučením dvou nebo více jiných korporací.","da":"Korporation, som er resultatet af en sammenlægning af to eller flere andre korporationer.","de":"Eine Körperschaft, die aus einer Fusion von zwei oder mehreren Körperschaften entstanden ist.","de":"Eine Körperschaft, die aus einer Fusion von zwei oder mehreren Körperschaften entstanden ist.","el":"Ένα συλλογικό όργανο το οποίο προέκυψε από τη συγχώνευση δύο ή περισσότερων συλλογικών οργάνων. .","en":"A corporate body who resulted from a merger of two or more other corporate bodies.","es":"Un organismo corporativo que resultó de una fusión de dos o más organismo corporativo.","et":"Asutus, mis on kahe või enama asutuse ühinemise tulemus.","fi":"Kahden tai useamman yhteisön yhdistymisestä muodostunut yhteisö.","fr":"Collectivité qui a résulté d’une fusion entre deux ou plusieurs autres collectivités.","hu":"Egy testület, amelyet két vagy több másik testület összeolvadása eredményezett.","it":"Ente che è il risultato dell'accorpamento di due o più altri enti.","lv":"Institūcija, kas izveidojās, apvienojoties divām vai vairākām institūcijām.","nl":"Een corporatie die resulteerde uit een fusie van twee of meer andere corporaties.","no":"En korporasjon som er resultat av en fusjon av to eller flere andre korporasjoner.","tr":"İki veya daha fazla tüzel kişilerin birleşmesi sonucu ortaya çıkan bir tüzel kişilik.","zh-Hans-CN":"两个或多个其他团体合并后产生的团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
