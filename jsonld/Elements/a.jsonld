                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/degreeCommitteeMemberOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50257", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/degreeCommitteeMemberOf.en", "label":"is degree committee member of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50257", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/degreeCommitteeMemberOf.en", "label":"is degree committee member of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50252","label":{"ar":"لها خريج","ca":"té com a titulat","cs":"má absolventa","da":"har dimittend","de":"hat Graduierte/Graduierten","de":"hat Graduierte/Graduierten","el":"έχει πτυχιούχο","en":"has graduate","es":"tiene graduado","et":"kraadi saanud isik","fi":"loppututkinnon suorittanut","fr":"a pour diplômé","hu":"diplomása a következő:","it":"ha come laureato","lv":"absolvents","nl":"heeft afgestudeerde","no":"har akademiker","tr":"mezun ile ilişkilidir","zh-Hans-CN":"有毕业生"},"definition":{"ar":["يربط هيئة بشخص يحصل على درجة أكاديمية من مؤسسة أو كلية مانحة."],"ca":["Relaciona una entitat corporativa amb una persona que rep una titulació acadèmica d’una institució que concedeix un títol acadèmic."],"cs":["Vztahuje korporaci k osobě, která získala akademický titul z instituce nebo fakulty, která titul uděluje."],"da":["Relaterer en korporation til en person, som modtager en akademsk grad fra en tildelende institution eller fakultet."],"de":["Setzt eine Körperschaft in Beziehung zu einer Person, die einen akademischen Grad von einer verleihenden Institution oder Fakultät erhält.,Setzt eine Körperschaft in Beziehung zu einer Person, die einen akademischen Grad von einer verleihenden Institution oder Fakultät erhält."],"el":["Συνδέει ένα συλλογικό όργανο με ένα φυσικό πρόσωπο που λαμβάνει ένα ανώτερου εκπαιδευτικού επιπέδου πτυχίο από ένα ίδρυμα ή σχολή."],"en":["Relates a corporate body to a person who receives an academic degree from a granting institution or faculty."],"es":["Relaciona un organismo corporativo con una persona que recibe un grado académico de una institución o facultad otorgante."],"et":["Seostab asutuse isikuga, kes on saanud akadeemilise kraadi kraadi andvalt asutuselt või teaduskonnalt."],"fi":["Liittää yhteisön henkilöön, jolle laitos tai tiedekunta on myöntänyt akateemisen loppututkinnon."],"fr":["Met une collectivité en relation avec une personne qui reçoit un grade universitaire d’une institution ou d’une faculté conférant un grade universitaire."],"hu":["Hozzákapcsol egy testületet egy személyhez, aki tudományos fokozatot kap egy annak odaítélésére jogosult intézménytől vagy egyetemi kartól."],"it":["Collega un ente a una persona che riceve un grado accademico da un'istituzione o facoltà che lo conferisce."],"lv":["Sasaista institūciju ar personu, kura ieguvusi akadēmisko grādu augstskolā."],"nl":["Relateert een corporatie aan een persoon die een academische graad ontvangt van een verstrekkende instelling of faculteit."],"no":["Relaterer en korporasjon til en person som mottar en akademisk grad ved en utdanningsinstitusjon."],"tr":["Bir tüzel kişiyi, bir enstitü veya fakülteden akademik derece alan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一个团体与从一个授予机构或院系获得学位的一个个人关联起来。"]},"ToolkitLabel":{"ar":"خريج","ca":"titulat","cs":"absolvent","da":"dimittend","de":"Graduierte/Graduierter","de":"Graduierte/Graduierter","el":"πτυχιούχος","en":"graduate","es":"graduado","et":"kraadi saanud isik","fi":"loppututkinnon suorittanut","fr":"diplômé","hu":"diplomás:","it":"laureato","lv":"absolvents","nl":"afgestudeerde","no":"akademiker","tr":"mezun","zh-Hans-CN":"毕业生"},"ToolkitDefinition":{"ar":"شخص يحصل على درجة أكاديمية من مؤسسة أو كلية مانحة.","ca":"Persona que rep una titulació acadèmica d’una institució que concedeix un títol acadèmic.","cs":"Osoba, která získala akademický titul z instituce nebo fakulty, která titul uděluje.","da":"Person, som modtager en akademisk grad fra en tildelende institution eller fakultet.","de":"Eine Person, die einen akademischen Grad von einer verleihenden Institution oder Fakultät erhält.","de":"Eine Person, die einen akademischen Grad von einer verleihenden Institution oder Fakultät erhält.","el":"Ένα φυσικό πρόσωπο που λαμβάνει ένα ανώτερου εκπαιδευτικού επιπέδου πτυχίο από ένα ίδρυμα ή σχολή.","en":"A person who receives an academic degree from a granting institution or faculty.","es":"Una persona que recibe un grado académico de una institución o facultad otorgante.","et":"Isik, kes on saanud akadeemilise kraadi kraadi andvalt asutuselt või teaduskonnalt.","fi":"Henkilö, jolle laitos tai tiedekunta on myöntänyt akateemisen loppututkinnon.","fr":"Personne qui reçoit un grade universitaire d’une institution ou d’une faculté conférant un grade universitaire.","hu":"Egy személy, aki tudományos fokozatot kap egy annak odaítélésére jogosult intézménytől vagy egyetemi kartól.","it":"Persona che riceve un grado accademico da un'istituzione o facoltà che lo conferisce.","lv":"Persona, kura ieguvusi akadēmisko grādu augstskolā.","nl":"Een persoon die een academische graad ontvangt van een verstrekkende instelling of faculteit.","no":"En person som mottar en akademisk grad ved en utdanningsinstitusjon.","tr":"Bir enstitü veya fakülteden akademik derece alan bir kişi.","zh-Hans-CN":"从一个授予机构或院系获得学位的一个个人"},"altLabel":{"el":["απόφοιτος"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/graduate.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50334", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPersonOfCorporateBody.en", "label":"has related person of corporate body"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50252", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/graduate.en", "label":"has graduate"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50252", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/graduate.en", "label":"has graduate"}]},{"@id":"http://rdaregistry.info/Elements/a/P50205","label":{"ar":"هو وكيل مخرج لـ","ca":"és agent realitzador de","cs":"je režisérem (agentem) (čeho)","da":"er agent, som er instruktør af","de":"ist Akteur als Regisseurin/Regisseur von","de":"ist Akteur als Regisseurin/Regisseur von","el":"είναι σκηνοθέτης φορέας του","en":"is director agent of","es":"es agente director de","et":"režissöör (tegija) teoses","fi":"ohjaaja (toimija) teoksessa","fr":"est un agent réalisateur de","hu":"rendező ágense a következőnek:","it":"è direttore agente di","lv":"ir režisors (aģents)","nl":"is regisseur-actor van","no":"er regissør av (agent)","tr":"yönetmen temsilcisidir","zh-Hans-CN":"是……的导演行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"el":["Συνδέει έναν φορέα υπεύθυνο για τη γενική διαχείριση και εποπτεία μιας κινηματογραφικής παράστασης, ενός ραδιοφωνικού ή τηλεοπτικού προγράμματος κ.λπ., με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona un agente con una obra que involucra una responsabilidad del agente para la gestión general y supervisión de una presentación filmada, un programa de radio o televisión, etc."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente per la gestione e supervisione generale di un'interpretazione filmata, programma radio o televisivo, etc."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc."],"tr":["Bir temsilciyi, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetimine ilişkin bir temsilcinin sorumluluğunu içeren eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及摄制表演、广播或电视节目等的全面管理和监督的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل مخرج","ca":"agent realitzador de","cs":"režisér (agent) (čeho)","da":"agent, som er instruktør af","de":"Akteur als Regisseurin/Regisseur von","de":"Akteur als Regisseurin/Regisseur von","el":"σκηνοθέτης φορέας του","en":"director agent of","es":"agente director de","et":"režissöör (tegija) teoses","fi":"ohjaaja (toimija) teoksessa","fr":"agent réalisateur de","hu":"rendező ágense:","it":"direttore agente di","lv":"ir režisors (aģents)","nl":"regisseur-actor van","no":"regissør av (agent)","tr":"yönetmen temsilcisi","zh-Hans-CN":"……的导演行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Obra que implica una responsabilitat d’un agent en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Dílo, které zahrnuje odpovědnost agenta za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Værk, som involverer en agents ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη για τη γενική διαχείριση και εποπτεία μιας κινηματογραφικής παράστασης, ενός ραδιοφωνικού ή τηλεοπτικού προγράμματος κ.λπ.","en":"A work that involves a responsibility of an agent for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una obra que involucra una responsabilidad del agente para la gestión general y supervisión de una presentación filmada, un programa de radio o televisión, etc.","et":"Teos, mis sisaldab tegija vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Teos, jossa toimija on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért.","it":"Manifestazione che implica la responsabilità di un agente per la gestione e supervisione generale di un'interpretazione filmata, programma radio o televisivo, etc.","lv":"Darbs, kas ietver aģenta atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc.","no":"Et verk som involverer ansvar for en agent i form av generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programı vb. genel yönetimi ve denetimi için bir temsilcinin sorumluluğunda olan bir eser.","zh-Hans-CN":"涉及摄制表演、广播或电视节目等的全面管理和监督的一个行为者的责任的一种作品"},"altLabel":{"ar":["مخرج"],"ca":["realitzador de"],"cs":["režisér (čeho)"],"da":["instruktør af"],"de":["Regisseur von,Regisseur von"],"el":["σκηνοθέτης του"],"en":["director of"],"es":["director de"],"et":["režissöör teoses"],"fi":["ohjaajana taltioinnissa"],"fr":["réalisateur de"],"hu":["rendezője:"],"it":["direttore di"],"nl":["regisseur van"],"no":["regissør av"],"tr":["yönetmeni"],"zh-Hans-CN":["……的导演"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50305", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfAgent.en", "label":"has related work of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50712", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOf.en", "label":"is director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50561", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorPersonOf.en", "label":"is director person of"},{"@id":"http://rdaregistry.info/Elements/a/P50048", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDirectorAgentOf.en", "label":"is film director agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50049", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorAgentOf.en", "label":"is radio director agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50050", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionDirectorAgentOf.en", "label":"is television director agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50205", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorAgentOf.en", "label":"is director agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50205", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorAgentOf.en", "label":"is director agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50207","label":{"ar":"هو وكيل مدير التصوير لـ","ca":"és agent director de fotografia de","cs":"je hlavním kameramanem (agentem) (čeho)","da":"er agent, som er filmfotograf af","de":"ist Akteur als Kamerafrau/Kameramann von","de":"ist Akteur als Kamerafrau/Kameramann von","el":"είναι διευθυντής φωτογραφίας φορέας του","en":"is director agent of photography of","es":"es agente director de fotografía de","et":"operaator-lavastaja (tegija) teoses","fi":"kuvaaja (toimija) teoksessa","fr":"est un agent directeur de la photographie de","hu":"operatőr ágense a következőnek:","it":"è direttore della fotografia agente di","lv":"ir kinooperators (aģents)","nl":"is cameraregisseur-actor van","no":"er filmfotograf for (agent)","tr":"görüntü yönetmeni temsilcisidir","zh-Hans-CN":"是……的摄影指导行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن التقاط الصور، إما إلكترونيًا أو في فيلم أو في مقاطع فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert."],"el":["Συνδέει έναν φορέα ο οποίος συλλαμβάνει τις εικόνες είτε ηλεκτρονικά είτε με φιλμ είτε με βίντεο και συχνά επιλέγει και οργανώνει τον φωτισμό, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de capturar imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente de elegir y organizar la iluminación."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av å filme levende bilder, enten elektronisk eller på film, og ofte valg og arrangement av lyssetting."],"tr":["Bir temsilciyi, elektronik olarak veya film ya da video stoğunda görüntü yakalama ve genellikle ışıklandırma seçme ve düzenlemekle görevli bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个行为者的责任的一种作品关联起来。"]},"note":{"ar":["ويطلق أيضًا على مدير تصوير الفيلم كبير المصورين السينمائيين ."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"el":["Ένας διευθυντής φωτογραφίας για μια ταινία ονομάζεται επίσης επικεφαλής κινηματογραφιστής."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Un director de fotografía para una película también es llamado un primer cinematógrafo."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia di un film è anche definito capo cameraman."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur bij een film wordt ook director of photography of hoofdcinematograaf genoemd."],"no":["En filmfotograf for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"ToolkitLabel":{"ar":"هو وكيل مدير التصوير لـ","ca":"agent director de fotografia de","cs":"hlavní kameraman (agent) (čeho)","da":"agent, som er filmfotograf af","de":"Akteur als Kamerafrau/Kameramann von","de":"Akteur als Kamerafrau/Kameramann von","el":"διευθυντής φωτογραφίας φορέας του","en":"director agent of photography of","es":"agente director de fotografía de","et":"operaator-lavastaja (tegija) teoses","fi":"kuvaaja (toimija) teoksessa","fr":"agent directeur de la photographie de","hu":"operatőr ágense:","it":"agente direttore di fotografia di","lv":"ir kinooperators (aģents)","nl":"cameraregisseur-actor van","no":"filmfotograf for (agent)","tr":"görüntü yönetmeni temsilcisi","zh-Hans-CN":"……的摄影指导行为者"},"ToolkitDefinition":{"ar":"يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن التقاط الصور، إما إلكترونيًا أو في فيلم أو في مقاطع فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها.","ca":"Obra que implica una responsabilitat d’un agent en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació.","cs":"Dílo, které zahrnuje odpovědnost agenta za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení.","da":"Værk, som involverer en agents ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen.","de":"Ein Werk, bei dem ein Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","de":"Ein Werk, bei dem ein Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της σύλληψης των εικόνων, είτε ηλεκτρονικά είτε με φιλμ είτε με βίντεο και συχνά της επιλογής και οργάνωσης του φωτισμού.","en":"A work that involves a responsibility of an agent for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting.","es":"Una obra que involucra una responsabilidad de un agente de capturar imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente de elegir y organizar la iluminación.","et":"Teos, mis sisaldab tegija vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest.","fi":"Teos, jossa toimija on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is.","it":"Opera che implica la responsabilità di un agente per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione.","lv":"Darbs, kas ietver aģenta atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting.","no":"Et verk som involverer ansvar for en agent i form av å filme levende bilder, enten elektronisk eller på film, og ofte valg og arrangement av lyssetting.","tr":"Elektronik olarak veya film veya video stoğunda görüntü yakalamak ve genellikle aydınlatmayı seçmek ve düzenlemek için bir temsilcinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个行为者的责任的一种作品"},"altLabel":{"ar":["هو وكيل مدير التصوير لـ"],"ca":["director de fotografia de"],"cs":["hlavní kameraman (čeho)"],"da":["filmfotograf af"],"de":["Kameramann von,Kameramann von"],"el":["διευθυντής φωτογραφίας του"],"en":["director of photography of"],"es":["director de fotografía de"],"et":["operaator-lavastaja teoses"],"fi":["kuvaajana teoksessa"],"fr":["directeur de la photographie de"],"hu":["operatőre:"],"it":["direttore di fotografia di"],"nl":["cameraregisseur van"],"no":["filmfotograf for"],"tr":["görüntü yönetmeni"],"zh-Hans-CN":["……的摄影指导"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50305", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfAgent.en", "label":"has related work of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOfPhotographyOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50688", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOfPhotographyOf.en", "label":"is director collective agent of photography of"},{"@id":"http://rdaregistry.info/Elements/a/P50537", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorPersonOfPhotographyOf.en", "label":"is director person of photography of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50207", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorAgentOfPhotographyOf.en", "label":"is director agent of photography of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50207", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorAgentOfPhotographyOf.en", "label":"is director agent of photography of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50712","label":{"ar":"هو وكيل جماعي مخرج لـ","ca":"és agent col·lectiu realitzador de","cs":"je režisérem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er instruktør af","de":"ist gemeinschaftlicher Akteur als Regisseurin/Regisseur von","de":"ist gemeinschaftlicher Akteur als Regisseurin/Regisseur von","el":"είναι διευθυντής συλλογικός φορέας του","en":"is director collective agent of","es":"es agente colectivo director de","et":"režissöör (kollektiiv) teoses","fi":"ohjaaja (yhteistoimija) teoksessa","fr":"est un agent collectif réalisateur de","hu":"rendező kollektív ágense a következőnek:","it":"è direttore agente collettivo di","lv":"ir režisors (grupa)","nl":"is regisseur-collectieve actor van","no":"er regissør av (kollektiv agent)","tr":"yönetmen kolektif temsilisidir","zh-Hans-CN":"是……的导演集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona un agente colectivo con una obra que implica una responsabilidad de un agente colectivo para la dirección y supervisión general de una actuación filmada, un programa de radio o televisión, etc."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc."],"tr":["Kolektif bir temsilciyi, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetimi için bir kolektif temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及摄制表演、广播或电视节目等的全面管理和监督的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مخرج","ca":"agent col·lectiu realitzador de","cs":"režisér (kolektivní agent) (čeho)","da":"kollektiv agent, som er instruktør af","de":"Gemeinschaftlicher Akteur als Regisseurin/Regisseur von","de":"Gemeinschaftlicher Akteur als Regisseurin/Regisseur von","el":"διευθυντής συλλογικός φορέας του","en":"director collective agent of","es":"agente colectivo director de","et":"režissöör (kollektiiv) teoses","fi":"ohjaaja (yhteistoimija) teoksessa","fr":"agent collectif réalisateur de","hu":"rendező kollektív ágense:","it":"direttore agente collettivo di","lv":"ir režisors (grupa)","nl":"regisseur-collectieve actor van","no":"regissør av (kollektiv agent)","tr":"yönetmen kolektif temsilcisi","zh-Hans-CN":"……的导演集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Værk, som involverer en kollektiv agents ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una obra que implica una responsabilidad de un agente colectivo para la dirección y supervisión general de una actuación filmada, un programa de radio o televisión, etc.","et":"Teos, mis sisaldab kollektiivi vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Teos, jossa yhteistoimija on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért.","it":"Opera che implica una responsabilità di un agente collettivo per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc.","lv":"Darbs, kas ietver grupas atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc.","no":"Et verk som involverer et ansvar for en kollektiv agent for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetimi için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及摄制表演、广播或电视节目等的全面管理和监督的一个集体行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50357", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfCollectiveAgent.en", "label":"has related work of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50205", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOf.en", "label":"is director agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50863", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCorporateBodyOf.en", "label":"is director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51014", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorFamilyOf.en", "label":"is director family of"},{"@id":"http://rdaregistry.info/Elements/a/P50713", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDirectorCollectiveAgentOf.en", "label":"is film director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50714", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorCollectiveAgentOf.en", "label":"is radio director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50715", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionDirectorCollectiveAgentOf.en", "label":"is television director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50712", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorCollectiveAgentOf.en", "label":"is director collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50712", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorCollectiveAgentOf.en", "label":"is director collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50688","label":{"ar":"هو وكيل جماعي مدير التصوير لـ","ca":"és agent col·lectiu director de fotografia de","cs":"je hlavním kameramanem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er filmfotograf af","de":"ist gemeinschaftlicher Akteur als Kamerafrau/Kameramann von","de":"ist gemeinschaftlicher Akteur als Kamerafrau/Kameramann von","el":"είναι διευθυντής φωτογραφίας συλλογικός φορέας του","en":"is director collective agent of photography of","es":"es agente colectivo director de fotografía de","et":"operaator-lavastaja (kollektiiv) teoses","fi":"kuvaaja (yhteistoimija) teoksessa","fr":"est un agent collectif directeur de la photographie de","hu":"operatőr kollektív ágense a következőnek:","it":"è direttore agente collettivo della fotografia di","lv":"ir kinooperators (grupa)","nl":"is cameraregisseur-collectieve actor van","no":"er filmfotograf for (kollektiv agent)","tr":"görüntü yönetmeni kolektif temsilcisidir","zh-Hans-CN":"是……的摄影指导集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن التقاط الصور، إما إلكترونيًا أو في فيلم أو في مقاطع فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting."],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de capturar imágenes, ya sea electrónicamente o en películas o videos, y a menudo seleccionar y organizar la iluminación."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting."],"tr":["Kolektif bir temsilciyi, elektronik olarak veya film ya da video stoğunda görüntüleri yakalama, genellikle aydınlatma gibi koşulları belirlemek ve düzenlemekle görevli kolektif temsilcinin sorumluluğunu içeren bir eseri ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مدير التصوير لـ","ca":"agent col·lectiu director de fotografia de","cs":"hlavní kameraman (kolektivní agent) (čeho)","da":"kollektiv agent, som er filmfotograf af","de":"Gemeinschaftlicher Akteur als Kamerafrau/Kameramann von","de":"Gemeinschaftlicher Akteur als Kamerafrau/Kameramann von","el":"διευθυντής φωτογραφίας συλλογικός φορέας του","en":"director collective agent of photography of","es":"agente colectivo director de fotografía de","et":"operaator-lavastaja (kollektiiv) teoses","fi":"kuvaaja (yhteistoimija) teoksessa","fr":"agent collectif directeur de la photographie de","hu":"operatőr kollektív ágense:","it":"direttore agente collettivo della fotografia di","lv":"ir kinooperators (grupa)","nl":"cameraregisseur-collectieve actor van","no":"filmfotograf for (kollektiv agent)","tr":"görüntü yönetmeni kolektif temsilcisi","zh-Hans-CN":"……的摄影指导集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن التقاط الصور، إما إلكترونيًا أو في فيلم أو في مقاطع فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení.","da":"Værk, som involverer en kollektiv agents ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","en":"A work that involves a responsibility of a collective agent for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting.","es":"Una obra que implica la responsabilidad de un agente colectivo de capturar imágenes, ya sea electrónicamente o en películas o videos, y a menudo seleccionar y organizar la iluminación.","et":"Teos, mis sisaldab kollektiivi vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest.","fi":"Teos, jossa yhteistoimija on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is.","it":"Opera che implica una responsabilità di un agente collettivo per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione.","lv":"Darbs, kas ietver grupas atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting.","tr":"Elektronik olarak veya film veya video stoku üzerinde görüntüleri yakalamak ve genellikle aydınlatmayı seçmek ve düzenlemekle görevli kolektif temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个集体行为者的责任的一种作品"},"note":{"ar":["ويطلق أيضًا على مدير تصوير الفيلم كبير المصورين السينمائيين ."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Al director de fotografía de una película también se le llama jefe de fotografía."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia di un film è anche definito capo cameraman."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur bij een film wordt ook director of photography of hoofdcinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOfPhotographyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50357", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfCollectiveAgent.en", "label":"has related work of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50207", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorAgentOfPhotographyOf.en", "label":"is director agent of photography of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50839", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCorporateBodyOfPhotographyOf.en", "label":"is director corporate body of photography of"},{"@id":"http://rdaregistry.info/Elements/a/P50990", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorFamilyOfPhotographyOf.en", "label":"is director family of photography of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50688", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorCollectiveAgentOfPhotographyOf.en", "label":"is director collective agent of photography of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50688", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorCollectiveAgentOfPhotographyOf.en", "label":"is director collective agent of photography of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50863","label":{"ar":"هي هيئة مخرجة لـ","ca":"és entitat corporativa realitzadora de","cs":"je režisérem (korporací) (čeho)","da":"er korporation, som er instruktør af","de":"ist Körperschaft als Regisseurin/Regisseur von","de":"ist Körperschaft als Regisseurin/Regisseur von","el":"είναι διευθυντής συλλογικό όργανο του","en":"is director corporate body of","es":"es organismo corporativo director de","et":"režissöör (asutus) teoses","fi":"ohjaaja (yhteisö) teoksessa","fr":"est une collectivité réalisatrice de","hu":"rendező testülete a következőnek:","it":"è direttore ente di","lv":"ir režisors (institūcija)","nl":"is regisseur-corporatie van","no":"er regissør av (korporasjon)","tr":"yönetmen tüzel kişisidir","zh-Hans-CN":"是……的导演团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad del organismo corporativo para la gestión general y supervisión de una presentación filmada, un programa de radio o televisión, etc."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc."],"tr":["Bir tüzel kişiyi, filme alınmış bir performansın, bir radyo veya televizyon programı vb. genel yönetimi ve denetimi için bir tüzel kişinin sorumluluğunu içeren bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及摄制表演、广播或电视节目等的全面管理和监督的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة مخرجة","ca":"entitat corporativa realitzadora de","cs":"režisér (korporace) (čeho)","da":"korporation, som er instruktør af","de":"Körperschaft als Regisseurin/Regisseur von","de":"Körperschaft als Regisseurin/Regisseur von","el":"διευθυντής συλλογικό όργανο του","en":"director corporate body of","es":"organismo corporativo director de","et":"režissöör (asutus) teoses","fi":"ohjaaja (yhteisö) teoksessa","fr":"collectivité réalisatrice de","hu":"rendező testülete:","it":"direttore ente di","lv":"ir režisors (institūcija)","nl":"regisseur-corporatie van","no":"regissør av (korporasjon)","tr":"yönetmen tüzel kişisi","zh-Hans-CN":"……的导演团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Dílo, které zahrnuje odpovědnost korporace za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Værk, som involverer en korporations ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein Werk, bei dem eine Körperschaft für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A work that involves a responsibility of a corporate body for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una obra que involucra una responsabilidad del organismo corporativo para la gestión general y supervisión de una presentación filmada, un programa de radio o televisión, etc.","et":"Teos, mis sisaldab asutuse vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Teos, jossa yhteisö on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért.","it":"Opera che implica una responsabilità di un ente per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc.","lv":"Darbs, kas ietver institūcijas atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc.","no":"Et verk som involverer et ansvar for en korporasjon for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programı vb. genel yönetimi ve denetimi için bir tüzel kişinin sorumluluğunda olan bir eser.","zh-Hans-CN":"涉及摄制表演、广播或电视节目等的全面管理和监督的一个团体的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50844", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfWorkOf.en", "label":"is creator corporate body of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50712", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOf.en", "label":"is director collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50864", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDirectorCorporateBodyOf.en", "label":"is film director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50865", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorCorporateBodyOf.en", "label":"is radio director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50866", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionDirectorCorporateBodyOf.en", "label":"is television director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50863", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorCorporateBodyOf.en", "label":"is director corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50863", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorCorporateBodyOf.en", "label":"is director corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50839","label":{"ar":"هي هيئة مديرة التصوير لـ","ca":"és entitat corporativa directora de fotografia de","cs":"je hlavním kameramanem (korporací) (čeho)","da":"er korporation, som er filmfotograf af","de":"ist Körperschaft als Kamerafrau/Kameramann von","de":"ist Körperschaft als Kamerafrau/Kameramann von","el":"είναι διευθυντής φωτογραφίας συλλογικό όργανο του","en":"is director corporate body of photography of","es":"es organismo corporativo director de fotografía de","et":"operaator-lavastaja (asutus) teoses","fi":"kuvaaja (yhteisö) teoksessa","fr":"est une collectivité directrice de la photographie de","hu":"operatőr testülete a következőnek:","it":"è direttore ente della fotografia di","lv":"ir kinooperators (institūcija)","nl":"is cameraregisseur-corporatie van","no":"er filmfotograf for (korporasjon)","tr":"görüntü yönetmeni tüzel kişisidir","zh-Hans-CN":"是……的摄影指导团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن التقاط الصور، إما إلكترونيًا أو في فيلم أو فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad de un organismo corporativo de capturar imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente de elegir y organizar la iluminación."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting."],"tr":["Bir tüzel kişiyi, elektronik olarak veya film veya video stoku üzerinde görüntüleri yakalama ve genellikle aydınlatmayı seçme ve düzenleme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة مديرة التصوير","ca":"entitat corporativa directora de fotografia de","cs":"hlavní kameraman (korporace) (čeho)","da":"korporation, som er filmfotograf af","de":"Körperschaft als Kamerafrau/Kameramann von","de":"Körperschaft als Kamerafrau/Kameramann von","el":"διευθυντής φωτογραφίας συλλογικό όργανο του","en":"director corporate body of photography of","es":"organismo corporativo director de fotografía de","et":"operaator-lavastaja (asutus) teoses","fi":"kuvaaja (yhteisö) teoksessa","fr":"collectivité directrice de la photographie de","hu":"operatőr testülete:","it":"direttore ente della fotografia di","lv":"ir kinooperators (institūcija)","nl":"cameraregisseur-corporatie van","no":"filmfotograf for (korporasjon)","tr":"görüntü yönetmeni tüzel kişisi","zh-Hans-CN":"……的摄影指导团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن التقاط الصور، إما إلكترونيًا أو في فيلم أو فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació.","cs":"Dílo, které zahrnuje odpovědnost korporace za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení.","da":"Værk, som involverer en korporations ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen.","de":"Ein Werk, bei dem eine Körperschaft für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","de":"Ein Werk, bei dem eine Körperschaft für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","en":"A work that involves a responsibility of a corporate body for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting.","es":"Una obra que involucra una responsabilidad de un organismo corporativo de capturar imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente de elegir y organizar la iluminación.","et":"Teos, mis sisaldab asutuse vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest.","fi":"Teos, jossa yhteisö on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is.","it":"Opera che implica una responsabilità di un ente per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione.","lv":"Darbs, kas ietver institūcijas atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting.","no":"Et verk som involverer et ansvar for en korporasjon i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting.","tr":"Elektronik olarak veya film veya video stoğunda görüntü yakalamak ve genellikle aydınlatmayı seçmek ve düzenlemek için bir tüzel kişinin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个团体的责任的一种作品"},"note":{"ar":["ويطلق أيضًا على مدير التصوير لفيلم كبير المصورين السينمائيين ."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"el":["Ένας διευθυντής φωτογραφίας για μια ταινία ονομάζεται επίσης επικεφαλής κινηματογραφιστής."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Un director de fotografía para una película también es llamado un primer cinematógrafo."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia di un film è anche definito capo cameraman."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur bij een film wordt ook director of photography of hoofdcinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorCorporateBodyOfPhotographyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50329", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfCorporateBody.en", "label":"has related work of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/P50688", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOfPhotographyOf.en", "label":"is director collective agent of photography of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50839", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorCorporateBodyOfPhotographyOf.en", "label":"is director corporate body of photography of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50839", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorCorporateBodyOfPhotographyOf.en", "label":"is director corporate body of photography of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51014","label":{"ar":"هي عائلة مخرجة لـ","ca":"és família realitzadora de","cs":"je režisérem (rodinou) (čeho)","da":"er familie, som er instruktør af","de":"ist Familie als Regisseurin/Regisseur von","de":"ist Familie als Regisseurin/Regisseur von","el":"είναι διευθυντής οικογένεια του","en":"is director family of","es":"es familia directora de","et":"režissöör (perekond) teoses","fi":"ohjaaja (suku) teoksessa","fr":"est une famille réalisatrice de","hu":"rendező családja a következőnek:","it":"è direttore famiglia di","lv":"ir režisors (dzimta/ģimene)","nl":"is regisseur-actor van","no":"er regissør av (familie)","tr":"yönetmen ailesidir","zh-Hans-CN":"是……的导演家族"},"definition":{"ar":["يربط عائلة بعمل يترتب عليه مسئولية عائلة عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una família amb una obra que implica una responsabilitat d’una família en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje rodinu k dílu, které zahrnuje odpovědnost agenta za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer en familie til et værk, som involverer en families ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a family to a work that involves a responsibility of a family for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona una familia con una obra que involucra una responsabilidad de una familia para la gestión general y supervisión de una presentación filmada, un programa de radio o televisión, etc."],"et":["Seostab perekonna teosega, mis sisaldab perekonna vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää suvun teokseen, jossa suku on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une famille en relation avec une œuvre qui comporte une responsabilité de la part d’une famille consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyhez hozzátartozik egy család felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért."],"it":["Correla una famiglia a un'opera che implica una responsabilità di una famiglia per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc."],"lv":["Sasaista dzimtu/ģimeni ar darbu, kas ietver dzimtas/ģimenes atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību."],"nl":["Relateert een familie aan een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc."],"no":["Relaterer en familie til et verk som involverer et ansvar for en familie for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc."],"tr":["Bir aileyi, bir film performansının, bir radyo veya televizyon programının genel yönetim ve denetim sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及摄制表演、广播或电视节目等的全面管理和监督的一个家族的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عائلة مخرجة","ca":"família realitzadora de","cs":"režisér (rodina) (čeho)","da":"familie, som er instruktør af","de":"Familie als Regisseurin/Regisseur von","de":"Familie als Regisseurin/Regisseur von","el":"διευθυντής οικογένεια του","en":"director family of","es":"familia directora de","et":"režissöör (perekond) teoses","fi":"ohjaaja (suku) teoksessa","fr":"famille réalisatrice de","hu":"rendező családja:","it":"direttore famiglia di","lv":"ir režisors (dzimta/ģimene)","nl":"regisseur-actor van","no":"regissør av (familie)","tr":"yönetmen ailesi","zh-Hans-CN":"……的导演家族"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية عائلة عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Obra que implica una responsabilitat d’una família en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Dílo, které zahrnuje odpovědnost agenta za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Værk, som involverer en families ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein Werk, bei dem eine Familie für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein Werk, bei dem eine Familie für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A work that involves a responsibility of a family for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una obra que involucra una responsabilidad de una familia para la gestión general y supervisión de una presentación filmada, un programa de radio o televisión, etc.","et":"Teos, mis sisaldab perekonna vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Teos, jossa suku on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une famille consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy mű, amelyhez hozzátartozik egy család felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért.","it":"Opera che implica una responsabilità di una famiglia per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc.","lv":"Darbs, kas ietver dzimtas/ģimenes atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc.","no":"Et verk som involverer et ansvar for en familie for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programı vb. genel yönetimi ve denetimi için bir ailenin sorumluluğunda olan bir eser.","zh-Hans-CN":"涉及摄制表演、广播或电视节目等的全面管理和监督的一个家族的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50320", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfFamily.en", "label":"has related work of family"},{"@id":"http://rdaregistry.info/Elements/a/P50712", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOf.en", "label":"is director collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P51015", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDirectorFamilyOf.en", "label":"is film director family of"},{"@id":"http://rdaregistry.info/Elements/a/P51016", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorFamilyOf.en", "label":"is radio director family of"},{"@id":"http://rdaregistry.info/Elements/a/P51017", "lexicalAlias":"http://rdaregistry.info/Elements/a/televisionDirectorFamilyOf.en", "label":"is television director family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P51014", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorFamilyOf.en", "label":"is director family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51014", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorFamilyOf.en", "label":"is director family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50990","label":{"ar":"هي عائلة مديرة تصوير لـ","ca":"és família directora de fotografia de","cs":"je hlavním kameramanem (rodinou) (čeho)","da":"er familie, som er filmfotograf af","de":"ist Familie als Kamerafrau/Kameramann von","de":"ist Familie als Kamerafrau/Kameramann von","el":"είναι διευθυντής φωτογραφίας οικογένεια του","en":"is director family of photography of","es":"es familia directora de fotografía de","et":"operaator-lavastaja (perekond) teoses","fi":"kuvaaja (suku) teoksessa","fr":"est une famille directrice de la photographie de","hu":"operatőr családja a következőnek:","it":"è direttore famiglia della fotografia di","lv":"ir kinooperators (dzimta/ģimene)","nl":"is cameraregisseur-familie van","no":"er filmfotograf for (familie)","tr":"görüntü yönetmeni ailesidir","zh-Hans-CN":"是……的摄影指导家族"},"definition":{"ar":["يربط عائلة بعمل يترتب عليه مسئولية عائلة عن التقاط الصور، إما إلكترونيًا أو في فيلم أو فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها."],"ca":["Relaciona una família amb una obra que implica una responsabilitat d’una família en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació."],"cs":["Vztahuje rodinu k dílu, které zahrnuje odpovědnost rodiny za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení."],"da":["Relaterer en familie til et værk, som involverer en families ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen."],"de":["Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.,Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a family to a work that involves a responsibility of a family for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting."],"es":["Relaciona una familia con una obra que involucra una responsabilidad de una familia de capturar imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente de elegir y organizar la iluminación."],"et":["Seostab perekonna teosega, mis sisaldab perekonna vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest."],"fi":["Liittää suvun teokseen, jossa suku on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä."],"fr":["Met une famille en relation avec une œuvre qui comporte une responsabilité de la part d’une famille consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyhez hozzátartozik egy család felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is."],"it":["Correla una famiglia a un'opera che implica la responsabilità di una famiglia per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione."],"lv":["Sasaista dzimtu/ģimeni ar darbu, kas ietver dzimtas/ģimenes atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu."],"nl":["Relateert een familie aan een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting."],"no":["Relaterer en familie til et verk som involverer et ansvar for en familie i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting."],"tr":["Bir aileyi, bir ailenin elektronik olarak veya film veya video stoku üzerinde görüntü yakalama ve genellikle aydınlatmayı seçme ve düzenleme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个家族的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عائلة مديرة للتصوير","ca":"família directora de fotografia de","cs":"hlavní kameraman (rodina) (čeho)","da":"familie, som er filmfotograf af","de":"Familie als Kamerafrau/Kameramann von","de":"Familie als Kamerafrau/Kameramann von","el":"διευθυντής φωτογραφίας οικογένεια του","en":"director family of photography of","es":"familia directora de fotografía de","et":"operaator-lavastaja (perekond) teoses","fi":"kuvaaja (suku) teoksessa","fr":"famille directrice de la photographie de","hu":"operatőr családja:","it":"direttore famiglia della fotografia di","lv":"ir kinooperators (dzimta/ģimene)","nl":"cameraregisseur-familie van","no":"filmfotograf for (familie)","tr":"görüntü yönetmeni ailesi","zh-Hans-CN":"……的摄影指导家族"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية عائلة عن التقاط الصور، إما إلكترونيًا أو في فيلم أو فيديو، وغالبا ما يكون مسئولا عن اختيار الإضاءة وتوزيعها.","ca":"Obra que implica una responsabilitat d’una família en la captura d’imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i organitza la il·luminació.","cs":"Dílo, které zahrnuje odpovědnost rodiny za zaznamenání obrazů, ať už elektronicky nebo na film či video, a často výběrem a úpravou osvětlení.","da":"Værk, som involverer en families ansvar for at optage billeder, enten elektronisk eller på film eller video, og ofte også for at udvælge og arrangere lyssætningen.","de":"Ein Werk, bei dem eine Familie für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","de":"Ein Werk, bei dem eine Familie für die Aufzeichnung von Bildern, entweder elektronisch oder auf Film- oder Videomaterial, verantwortlich ist und häufig die Belichtung auswählt und arrangiert.","en":"A work that involves a responsibility of a family for capturing images, either electronically or on film or video stock, and often selecting and arranging the lighting.","es":"Una obra que involucra una responsabilidad de una familia de capturar imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente de elegir y organizar la iluminación.","et":"Teos, mis sisaldab perekonna vastutust pildi jäädvustamise eest kas elektrooniliselt või filmi- või videolindile ning sageli valgustuse valimise ja ülesseadmise eest.","fi":"Teos, jossa suku on vastuussa kuvien tallentamisesta joko sähköisesti tai filmille tai videolle, usein myös valaistuksen valitsemisesta ja järjestämisestä.","fr":"Œuvre qui comporte une responsabilité de la part d’une famille consistant à capter des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy mű, amelyhez hozzátartozik egy család felelőssége képek elektronikusan, filmen vagy videoállományon történő rögzítéséért, gyakran a világítás kiválasztásáért és elrendezéséért is.","it":"Opera che implica una responsabilità di una famiglia per l'acquisizione di immagini, elettronicamente o su pellicola o video, e spesso nella scelta e organizzazione dell'illuminazione.","lv":"Darbs, kas ietver dzimtas/ģimenes atbildību par attēlu uzņemšanu elektroniski vai uz filmas, vai video un bieži izvēlas, un izvieto apgaismojumu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor het vastleggen van beelden, elektronisch of op film- of videomateriaal, en vaak het selecteren en arrangeren van de belichting.","no":"Et verk som involverer et ansvar for en familie i form av å ta bilder, enten elektronisk eller på film eller video, og som ofte velger og arrangerer lyssetting.","tr":"Elektronik olarak veya film veya video stoğunda görüntü yakalamak ve genellikle aydınlatmayı seçmek ve düzenlemek için bir ailenin sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个家族的责任的一种作品"},"note":{"ar":["ويطلق أيضًا على مدير تصوير الفيلم كبير المصورين السينمائيين ."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"el":["Ένας διευθυντής φωτογραφίας για μια ταινία ονομάζεται επίσης επικεφαλής κινηματογραφιστής."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Un director de fotografía para una película también es llamado un primer cinematógrafo."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia di un film è anche definito capo cameraman."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur bij een film wordt ook director of photography of hoofdcinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/directorFamilyOfPhotographyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50320", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfFamily.en", "label":"has related work of family"},{"@id":"http://rdaregistry.info/Elements/a/P50688", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorCollectiveAgentOfPhotographyOf.en", "label":"is director collective agent of photography of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50990", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/directorFamilyOfPhotographyOf.en", "label":"is director family of photography of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50990", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/directorFamilyOfPhotographyOf.en", "label":"is director family of photography of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50561","label":{"ar":"هو شخص مخرج لـ","ca":"és persona realitzadora de","cs":"je režisérem (osobou) (čeho)","da":"er person, som er instruktør af","de":"ist Person als Regisseurin/Regisseur von","de":"ist Person als Regisseurin/Regisseur von","el":"είναι διευθυντής φυσικό πρόσωπο του","en":"is director person of","es":"es persona directora de","et":"režissöör (isik) teoses","fi":"ohjaaja (henkilö) teoksessa","fr":"est une personne réalisatrice de","hu":"rendező személye a következőnek:","it":"è direttore persona di","lv":"ir režisors (persona)","nl":"is regisseur-person van","no":"er regissør av (person)","tr":"yönetmen kişisidir","zh-Hans-CN":"是……的导演个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن الإدارة العامة، والإشراف على أداء مصور، أو على برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona a una persona con una obra que implica una responsabilidad de una persona para la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per la gestione e supervisione generale di un'interpretazione filmata, programma radiofonico o televisivo, etc."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc."],"no":["Relaterer en person til et verk som involverer et ansvar for en person for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc."],"tr":["Bir kişiyi, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetimi sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及摄制表演、广播或电视节目等的全面管理和监督的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص مخرج","ca":"persona realitzadora de","cs":"režisér (osoba) (čeho)","da":"person, som er instruktør af","de":"Person als Regisseurin/Regisseur von","de":"Person als Regisseurin/Regisseur von","el":"διευθυντής φυσικό πρόσωπο του","en":"director person of","es":"persona directora de","et":"režissöör (isik) teoses","fi":"ohjaaja (henkilö) teoksessa","fr":"personne réalisatrice de","hu":"rendező személye:","it":"direttore persona di","lv":"ir režisors (persona)","nl":"regisseur-person van","no":"regissør av (person)","tr":"yönetmen","zh-Hans-CN":"……的导演个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن الإدارة العامة، والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Obra que implica una responsabilitat d’una persona en la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Dílo, které zahrnuje odpovědnost osoby za obecné řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Værk, som involverer en persons ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein Werk, bei dem eine Person für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein Werk, bei dem eine Person für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A work that involves a responsibility of a person for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una obra que implica una responsabilidad de una persona para la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc.","et":"Teos, mis sisaldab isiku vastutust filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Teos, jossa henkilö on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à assurer la gestion et la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy filmforgatás, egy rádió- vagy televízióműsor, stb. általános menedzseléséért és felügyeletéért.","it":"Opera che implica una responsabilità di una persona per la gestione generale e supervisione di un'interpretazione filmata, programma radiofonico o televisivo, etc.","lv":"Darbs, kas ietver personas atbildību par vispārējo vadību un par filmētā materiāla, radio vai televīzijas raidījuma, u.tml. uzraudzību.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het algemene beheer en toezicht van een gefilmde uitvoering, een radio- of televisieprogramma etc.","no":"Et verk som involverer et ansvar for en person for den generelle ledelsen og tilsyn med en filmet forestilling, et radio- eller fjernsynsprogram etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programı vb. genel yönetimi ve denetimi için bir kişinin sorumluluğunda olan bir eser.","zh-Hans-CN":"涉及摄制表演、广播或电视节目等的全面管理和监督的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
