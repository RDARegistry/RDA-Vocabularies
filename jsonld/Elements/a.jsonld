                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/soundDesignerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50255", "lexicalAlias":"http://rdaregistry.info/Elements/a/soundDesignerAgentOf.en", "label":"is sound designer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50578", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/soundDesignerPersonOf.en", "label":"is sound designer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50578", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/soundDesignerPersonOf.en", "label":"is sound designer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50083","label":{"ar":"هو وكيل متحدث لـ","ca":"és agent orador de","cs":"je spíkrem (agentem) (čeho)","da":"er agent, som er forelæser/taler af","de":"ist Akteur als Rednerin/Redner von","de":"ist Akteur als Rednerin/Redner von","el":"είναι ομιλητής φορέας του","en":"is speaker agent of","es":"es agente orador de","et":"kõneleja (tegija) väljenduses","fi":"puhuja (toimija) ekspressiossa","fr":"est un agent orateur de","hu":"élőszavas előadó ágense a következőnek:","it":"è oratore agente di","lv":"ir orators (aģents)","nl":"is spreker-actor van","no":"er taler for (agent)","tr":"konuşmacı temsilcisidir.","zh-Hans-CN":"是……的演说者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بالتحدث بكلمات، كما في محاضرة أو خطبة، إلخ."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent pronunciant paraules, com ara una conferència, un discurs, etc."],