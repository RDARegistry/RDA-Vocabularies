                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/artistFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50995", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfWorkOf.en", "label":"is creator family of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50691", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistCollectiveAgentOf.en", "label":"is artist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50997", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistFamilyOf.en", "label":"is book artist family of"},{"@id":"http://rdaregistry.info/Elements/a/P50989", "lexicalAlias":"http://rdaregistry.info/Elements/a/calligrapherFamilyOf.en", "label":"is calligrapher family of"},{"@id":"http://rdaregistry.info/Elements/a/P51018", "lexicalAlias":"http://rdaregistry.info/Elements/a/sculptorFamilyOf.en", "label":"is sculptor family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50993", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/artistFamilyOf.en", "label":"is artist family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50993", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/artistFamilyOf.en", "label":"is artist family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50540","label":{"ar":"هو شخص فنان لـ","ca":"és persona artista de","cs":"je výtvarníkem (osobou) (čeho)","da":"er person, som er kunstner af","de":"ist Person als Künstlerin/Künstler von","de":"ist Person als Künstlerin/Künstler von","el":"είναι καλλιτέχνης φυσικό πρόσωπο του","en":"is artist person of","es":"es persona artista de","et":"kunstnik (isik) teoses","fi":"taiteilija (henkilö) teoksessa","fr":"est une personne artiste de","hu":"művész személye a következőnek:","it":"è artista persona di","lv":"ir mākslinieks (persona)","nl":"is kunstenaar-persoon van","no":"er kunstner av (person)","tr":"sanatçı kişisidir","zh-Hans-CN":"是……的美术家个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن وضع تصور لتصميم جرافيكي، أو لرسم، أو للوحة زيتية أصلية، إلخ وغالبا تنفيذه."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona concebent, i sovint realitzant, un disseny gràfic, un dibuix, una pintura, original etc."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za koncipování a často také implementaci originálního grafického návrhu, kresby, malby atd."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at udtænke, og ofte udføre, et originalt grafisk design, en original tegning, et originalt maleri etc."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Konzeption und oft auch Umsetzung einer originalen grafischen Gestaltung, einer Zeichnung oder eines Gemäldes und so weiter verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Konzeption und oft auch Umsetzung einer originalen grafischen Gestaltung, einer Zeichnung oder eines Gemäldes und so weiter verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for conceiving, and often implementing, an original graphic design, drawing, painting, etc."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de esa persona por concebirlo y a menudo implementar, un diseño gráfico original, dibujo, pintura, etc."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust originaalse graafilise kujunduse, joonistuse, maali vms kavandamise ja sageli ka teostamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à concevoir et souvent à réaliser un graphisme, une peinture, un dessin, etc. original."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy eredeti grafikai terv, rajz, festmény stb. elgondolásáért és gyakran kivitelezéséért is."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per la concezione, e spesso per lo sviluppo, di un progetto grafico, disegno, dipinto, etc. originale."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par oriģinālu estampa, zīmējuma, gleznas u.tml. radīšanu un īstenošanu."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor bedenken, en vaak uitvoeren, van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å skape, og ofte implementere, et originalt grafisk design, en tegning, et maleri etc."],"tr":["Bir kişiyi, özgün bir grafik tasarım, çizim, resim vb. tasarlama ve sıklıkla uygulama sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及构思并经常是完成原创图形设计、绘图、绘画等的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص فنان","ca":"persona artista de","cs":"výtvarník (osoba) (čeho)","da":"person, som er kunstner af","de":"Person als Künstlerin/Künstler von","de":"Person als Künstlerin/Künstler von","el":"καλλιτέχνης φυσικό πρόσωπο του","en":"artist person of","es":"persona artista de","et":"kunstnik (isik) teoses","fi":"taiteilija (henkilö) teoksessa","fr":"personne artiste de","hu":"művész személye:","it":"artista persona di","lv":"ir mākslinieks (persona)","nl":"kunstenaar-persoon van","no":"kunstner av (person)","tr":"sanatçı","zh-Hans-CN":"……的美术家个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن وضع تصور لتصميم جرافيكي، أو لرسم، أو للوحة زيتية أصلية، إلخ وغالبا تنفيذها.","ca":"Obra que implica una responsabilitat d’una persona concebent, i sovint realitzant, un disseny gràfic, un dibuix, una pintura, original etc.","cs":"Dílo, které zahrnuje odpovědnost osoby za koncipování a často také implementaci originálního grafického návrhu, kresby, malby atd.","da":"Værk, som involverer en persons ansvar for at udtænke, og ofte udføre, et originalt grafisk design, en original tegning, et originalt maleri etc.","de":"Ein Werk, bei dem eine Person für die Konzeption und oft auch Umsetzung einer originalen grafischen Gestaltung, einer Zeichnung oder eines Gemäldes und so weiter verantwortlich ist.","de":"Ein Werk, bei dem eine Person für die Konzeption und oft auch Umsetzung einer originalen grafischen Gestaltung, einer Zeichnung oder eines Gemäldes und so weiter verantwortlich ist.","en":"A work that involves a responsibility of a person for conceiving, and often implementing, an original graphic design, drawing, painting, etc.","es":"Una obra que implica la responsabilidad de una persona por concebir, y a menudo implementar, un diseño gráfico original, dibujo, pintura, etc.","et":"Teos, mis sisaldab isiku vastutust originaalse graafilise kujunduse, joonistuse, maali vms kavandamise ja sageli ka teostamise eest.","fi":"Teos, jossa henkilö on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à concevoir et souvent à réaliser un graphisme, une peinture, un dessin, etc. original.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy eredeti grafikai terv, rajz, festmény stb. elgondolásáért és gyakran kivitelezéséért is.","it":"Opera che implica una responsabilità di una persona per la concezione, e spesso per lo sviluppo, di un progetto grafico, disegno, dipinto, etc. originale.","lv":"Darbs, kas ietver personas atbildību par oriģinālu estampa, zīmējuma, gleznas u.tml. radīšanu un īstenošanu.","nl":"Een werk dat met zich meebrengt een verantwoor