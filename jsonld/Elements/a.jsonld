                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50661", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperCollectiveAgentOf.en", "label":"is collotyper collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50953", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerFamilyOf.en", "label":"is printmaker family of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50963", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collotyperFamilyOf.en", "label":"is collotyper family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50963", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collotyperFamilyOf.en", "label":"is collotyper family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50510","label":{"ar":"هو وكيل طبّاع صور فوتوغرافية لـ","ca":"és persona fototipista de","cs":"je kolotypérem (osobou) (čeho)","da":"er person, som er lystrykker af","de":"ist Person als Lichtdruckerin/Lichtdrucker von","de":"ist Person als Lichtdruckerin/Lichtdrucker von","el":"είναι κατασκευαστής κολλοτυπίας φυσικό πρόσωπο του","en":"is collotyper person of","es":"es la persona calotipadora de","et":"kollotüübi valmistaja (isik) kehastuses","fi":"kollotypian valmistaja (henkilö) manifestaatiossa","fr":"est une personne phototypeuse de","hu":"fénynyomatkészítő személye a következőnek:","lv":"ir fotogravieris (persona)","nl":"is lichtdrukker-persoon van","no":"er lystrykker for (person)","tr":"kolotip baskıcı kişisidir","zh-Hans-CN":"是……的珂罗版制作者个人"},"definition":{"ar":["يربط شخصا بتجسيدة تنطوي على مسئولية شخص عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر."],"ca":["Relaciona una persona amb una manifestació que implica una responsabilitat d’una persona en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic."],"cs":["Vztahuje osobu k provedení, které zahrnuje odpovědnost osoby za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu."],"da":["Relaterer en person til en manifestation, som involverer en persons ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader."],"de":["Setzt eine Person in Beziehung zu einer Manifestation, bei der eine Person für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.,Setzt eine Person in Beziehung zu einer Manifestation, bei der eine Person für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittel eines fotomechanischen Verfahrens verwendet wird."],"en":["Relates a person to a manifestation that involves a responsibility of a person for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process."],"es":["Relaciona a una persona con una manifestación que implica la responsabilidad de una persona de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptivas y repelentes a la tinta y que se utilice para hacer impresiones mediante un proceso fotomecánico."],"et":["Seostab isiku kehastusega, mis sisaldab isiku vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo."],"fi":["Liittää henkilön manifestaatioon, jonka valmistamisesta henkilö on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja."],"fr":["Met une personne en relation avec une manifestation qui comporte une responsabilité de la part d’une personne consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique."],"hu":["Hozzákapcsol egy személyt egy megjelenési formához, amelyhez hozzátartozik egy személy felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja."],"lv":["Sasaista personu ar manifestāciju, kas ietver personas atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas."],"nl":["Relateert een persoon aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een persoon voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces."],"no":["Relaterer en person til en manifestasjon som involverer et ansvar for en person i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk."],"tr":["Bir kişiyi, kişinin mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskı yapmak için kullanılan sertleştirilmiş jelatin veya başka bir kolloid filmin hazırlanması sorumluluğunu içeren gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个个人的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل طبّاع صور فوتوغرافية","ca":"persona fototipista de","cs":"kolotypér (osoba) (čeho)","da":"person, som er lystrykker af","de":"Person als Lichtdruckerin/Lichtdrucker von","de":"Person als Lichtdruckerin/Lichtdrucker von","el":"κατασκευαστής κολλοτυπίας φυσικό πρόσωπο του","en":"collotyper person of","es":"persona calotipadora de","et":"kollotüübi valmistaja (isik) kehastuses","fi":"kollotypian valmistaja (henkilö) manifestaatiossa","fr":"personne phototypeuse de","hu":"fénynyomatkészítő személye:","lv":"ir fotogravieris (persona)","nl":"lichtdrukker-persoon van","no":"lystrykker for (person)","tr":"taş baskıcı","zh-Hans-CN":"……的珂罗版制作者个人"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية شخص عن استخدام عمليات ميكانيكية ضوئية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التي تحتوي على أسطح مستقبلة أو طاردة للحبر.","ca":"Manifestació que implica una responsabilitat d’una persona en la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.","cs":"Provedení, které zahrnuje odpovědnost osoby za přípravu vytvrzeného filmu ze želatiny nebo jiného koloidu, který má povrchy přijímající a odpuzující inkoust, a který se používá k vytváření tisků pomocí fotomechanického procesu.","da":"Manifestation, som involverer en persons ansvar for en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.","de":"Eine Manifestation, bei der eine Person für die Verwendung eines fotomechanischen Verfahrens zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist, verantwortlich ist.","de":"Eine Manifestation, bei der eine Person für die Herstellung eines gehärteten Films aus Gelatine oder einem anderen Kolloid verantwortlich ist, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist und zur Herstellung von Abzügen mittels eines fotomechanischen Verfahrens verwendet wird.","en":"A manifestation that involves a responsibility of a person for preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.","es":"Una manifestación que implica la responsabilidad de una persona de preparar una película endurecida de gelatina u otro coloide que tenga superficies receptivas y repelentes a la tinta y que se utilice para hacer impresiones mediante un proceso fotomecánico.","et":"Kehastus, mis sisaldab isiku vastutust fotomehaanilises protsessis tõmmiste tegemise eest otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo.","fi":"Manifestaatio, jonka valmistamisesta henkilö on vastuussa tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.","fr":"Manifestation qui comporte une responsabilité de la part d’une personne consistant à préparer un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy személy felelőssége nyomtatványok fotómechanikai eljárással történő közvetlen előállításáért, amihez festékfelvevő és festéktaszító felülettel rendelkező zselatin vagy más kolloid megkeményedett filmjét használja.","lv":"Manifestācija, kas ietver personas atbildību par fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een persoon voor het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.","no":"En manifestasjon som involverer et ansvar for en person i form av bruk av en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.","tr":"Bir kişinin mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskı yapmak için kullanılan sertleştirilmiş jelatin veya başka bir kolloid filmin hazırlanması sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印的一个个人的责任的一种载体表现"},"altLabel":{"de":["Person als Koloristin/Kolorist von"],"en":["collotypist person of"],"es":["persona calotipista de"],"fi":["-"],"fr":["personne collotypiste de"],"nl":["lichtdrukker-persoon van"],"tr":["taş baskı uzmanı"],"zh-Hans-CN":["……的珂罗版制作者个人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50178", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperAgentOf.en", "label":"is collotyper agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50500", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerPersonOf.en", "label":"is printmaker person of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50510", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/collotyperPersonOf.en", "label":"is collotyper person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50510", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/collotyperPersonOf.en", "label":"is collotyper person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50266","label":{"ar":"هو وكيل فني تلوين لـ","ca":"és agent colorista de","cs":"je koloristou (agentem) (čeho)","da":"er agent, som er farvelægger af","de":"ist Akteur als Koloristin/Kolorist von","de":"ist Akteur als Koloristin/Kolorist von","el":"είναι επιχρωματιστής φορέας του","en":"is colourist agent of","es":"es agente colorista de","et":"koloreerija (tegija) väljenduses","fi":"värittäjä (toimija) ekspressiossa","fr":"est un agent coloriste de","hu":"colorist ágense a következőnek:","it":"è colorista agente di","lv":"ir kolorists (aģents)","nl":"is inkleurder-actor van","no":"er fargelegger av (agent)","tr":"renklendirici temsilcisidir","zh-Hans-CN":"是……的着色者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بتلوين الرسومات، والمطبوعات، والصور الفوتوغرافية، والخرائط، والصور المتحركة، وأي محتوى مرئي آخر."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment i a qualsevol altre contingut visual."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že nanáší barvy na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at farvelægge tegninger, tryk, fotos, kort, levende billeder og andet visuelt indhold."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της εφαρμογής χρωμάτων στα σχέδια, τα σκίτσα, τις εκτυπώσεις, τις φωτογραφίες, τους χάρτες, τις κινητές εικόνες κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of applying colour to drawings, prints, photographs, maps, moving images, and other visual content."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de aplicar color a dibujos, impresiones, fotografías, mapas, imágenes en movimiento y otro contenido visual."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte ja muud visuaalset sisu."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tms."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à appliquer de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées et d’autres contenus visuels."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését szín felhordásában rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más vizuális tartalmakra."],"it":["Correla un agente a un'espressione che comprende un contributo da parte di un agente nell'applicare colore a disegni, stampe, fotografie, mappe, immagini in movimento e altri contenuti visivi."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, izkrāsojot zīmējumu, gravīru, fotogrāfiju, karšu, kustīgo attēlu, u. tml."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden en andere visuele content."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å fargelegge tegninger, trykk, fotografier, kart, levende bilder og annet visuelt innhold."],"tr":["Bir temcilsiciyi, çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere ve diğer görsel içeriklere renk uygulayan bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括将颜色施加于图画、印刷品、照片、地图、动态图像和其他视觉内容上的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل فني تلوين","ca":"agent colorista de","cs":"kolorista (agent) (čeho)","da":"agent, som er farvelægger af","de":"Akteur als Koloristin/Kolorist von","de":"Akteur als Koloristin/Kolorist von","el":"επιχρωματιστής φορέας του","en":"colourist agent of","es":"agente colorista de","et":"koloreerija (tegija) väljenduses","fi":"värittäjä (toimija) ekspressiossa","fr":"agent coloriste de","hu":"colorist ágense a következőnek:","it":"colorista agente di","lv":"ir kolorists (aģents)","nl":"inkleurder-actor van","no":"fargelegger av (agent)","tr":"renklendirici temsilcisi","zh-Hans-CN":"……的着色者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في تلوين رسومات، ومطبوعات، وصور فوتوغرافية، وخرائط، وصور متحركة، وأي محتوى مرئي آخر.","ca":"Expressió que inclou una contribució d’un agent aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment i a qualsevol altre contingut visual.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že nanáší barvy na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah.","da":"Udtryk, som omfatter en agents bidrag ved at farvelægge tegninger, tryk, fotos, kort, levende billeder og andet visuelt indhold.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά της εφαρμογής χρωμάτων στα σχέδια, τα σκίτσα, τις εκτυπώσεις, τις φωτογραφίες, τους χάρτες, τις κινητές εικόνες κ.λπ.","en":"An expression that includes a contribution by an agent of applying colour to drawings, prints, photographs, maps, moving images, and other visual content.","es":"Una expresión que incluye una contribución de un agente de aplicar color a dibujos, impresiones, fotografías, mapas, imágenes en movimiento y otro contenido visual.","et":"Väljendus, millesse tegija on andnud panuse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte ja muud visuaalset sisu.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tms.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à appliquer de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées et d’autres contenus visuels.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését szín felhordásában rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más vizuális tartalmakra.","it":"Espressione che comprende un contributo da parte di un agente nell'applicare colore a disegni, stampe, fotografie, mappe, immagini in movimento e altri contenuti visivi.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, izkrāsojot zīmējumu, gravīru, fotogrāfiju, karšu, kustīgo attēlu, u. tml.","nl":"Een expressie die omvat een bijdrage door een actor door toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden en andere visuele content.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å fargelegge tegninger, trykk, fotografier, kart, levende bilder og annet visuelt innhold.","tr":"Çizimlere, baskılara, fotoğraflara, haritalara, hareketli resimlere ve diğer görsel içeriğe renk uygulamaları yapan bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括将颜色施加于图画、印刷品、照片、地图、动态图像和其他视觉内容上的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["وكيل فني تلوين لـ"],"ca":[",,"],"cs":["kolorista (čeho),,"],"da":["farvelægger af"],"de":["Colorist von,Koloristin/Kolorist von,Akteur als Coloristin/Colorist von"],"el":["επιχρωματιστής του,κολορίστας του"],"en":["colorist of,colourist of,colorist agent of"],"es":["colorista de,colorista de,agente colorista de"],"et":["koloreerija väljenduses"],"fi":[",,"],"fr":["coloriste de"],"hu":[",,"],"it":["colorista di"],"nl":["inkleurder van,inkleurder van,inkleurder-actor van"],"no":["fargelegger av"],"tr":["renklendiren,renklendiren,renklendirme temsilcisi"],"zh-Hans-CN":["……的着色者,……的着色者,……的着色者行为者"],"zh-Hant-TW":[",,"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/colouristAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50448", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToAmalgamationOf.en", "label":"is contributor agent to amalgamation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50722", "lexicalAlias":"http://rdaregistry.info/Elements/a/colouristCollectiveAgentOf.en", "label":"is colourist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50571", "lexicalAlias":"http://rdaregistry.info/Elements/a/colouristPersonOf.en", "label":"is colourist person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50266", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/colouristAgentOf.en", "label":"is colourist agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50266", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/colouristAgentOf.en", "label":"is colourist agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50722","label":{"ar":"هو وكيل جماعي فني تلوين لـ","ca":"és agent col·lectiu colorista de","cs":"je koloristou (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er farvelægger af","de":"ist gemeinschaftlicher Akteur als Koloristin/Kolorist von","de":"ist gemeinschaftlicher Akteur als Koloristin/Kolorist von","el":"είναι επιχρωματιστής συλλογικός φορέας του","en":"is colourist collective agent of","es":"es agente colectivo colorista de","et":"koloreerija (kollektiiv) väljenduses","fi":"värittäjä (yhteistoimija) ekspressiossa","fr":"est un agent collectif coloriste de","hu":"colorist kollektív ágense a következőnek:","it":"è colorista agente collettivo di","lv":"ir kolorists (grupa)","nl":"is inkleurder-collectieve actor van","no":"er fargelegger for (kollektiv agent)","tr":"renklendirici kolektif temsilcisidir","zh-Hans-CN":"是……的着色者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في تلوين رسومات، ومطبوعات، وصور فوتوغرافية، وخرائط، وصور متحركة، وأي محتوى مرئي آخر."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment i a qualsevol altre contingut visual."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že nanáší barvy na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at farvelægge tegninger, tryk, fotos, kort, levende billeder og andet visuelt indhold."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of applying colour to drawings, prints, photographs, maps, moving images, and other visual content."],"es":["Relaciona un agente colectivo con una expresión que incluye la contribución de un agente colectivo de aplicar color a dibujos, grabados, fotografías, mapas, imágenes en movimiento y otros contenidos visuales."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte ja muud visuaalset sisu."],"fi":["Liittää yhteistoimijan ekspressioon, jossa yhteistoimija on osallisena värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tms."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à appliquer de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées et d’autres contenus visuels."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését szín felhordásában rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más vizuális tartalmakra."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nell'applicazione di colore a disegni, stampe, fotografie, mappe, immagini in movimento e altri contenuti visivi."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, izkrāsojot zīmējumu, gravīru, fotogrāfiju, karšu, kustīgo attēlu, u. tml."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden en andere visuele content."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av fargelegge tegninger, trykk, fotografier, kart, levende bilder og annet visuelt materiale."],"tr":["Kolektif bir temsilciyi, kollektif bir temsilcinin çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere ve diğer görsel içeriğe renk uygulama katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括将颜色施加于图画、印刷品、照片、地图、动态图像和其他视觉内容上的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فني تلوين لـ","ca":"agent col·lectiu colorista de","cs":"kolorista (kolektivní agent) (čeho)","da":"kollektiv agent, som er farvelægger af","de":"Gemeinschaftlicher Akteur als Koloristin/Kolorist von","de":"Gemeinschaftlicher Akteur als Koloristin/Kolorist von","el":"επιχρωματιστής συλλογικός φορέας του","en":"colourist collective agent of","es":"agente colectivo colorista de","et":"koloreerija (kollektiiv) väljenduses","fi":"värittäjä (yhteistoimija) ekspressiossa","fr":"agent collectif coloriste de","hu":"colorist kollektív ágense:","it":"colorista agente collettivo di","lv":"ir kolorists (grupa)","nl":"inkleurder-collectieve actor van","no":"fargelegger for (kollektiv agent)","tr":"renklendirici kolektif temsilcisi","zh-Hans-CN":"……的着色者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في تلوين رسومات، ومطبوعات، وصور فوتوغرافية، وخرائط، وصور متحركة، وأي محتوى مرئي آخر.","ca":"Expressió que inclou una contribució d’un agent col·lectiu aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment i a qualsevol altre contingut visual.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že nanáší barvy na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at farvelægge tegninger, tryk, fotos, kort, levende billeder og andet visuelt indhold.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder und so weiter aufbringt.","en":"An expression that includes a contribution by a collective agent of applying colour to drawings, prints, photographs, maps, moving images, and other visual content.","es":"Una expresión que incluye la contribución de un agente colectivo de aplicar color a dibujos, grabados, fotografías, mapas, imágenes en movimiento y otros contenidos visuales.","et":"Väljendus, millesse kollektiiv on andnud panuse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte ja muud visuaalset sisu.","fi":"Ekspressio, jossa yhteistoimija on osallisena värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tms.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à appliquer de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées et d’autres contenus visuels.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését szín felhordásában rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más vizuális tartalmakra.","it":"Espressione che comprende un contributo di un agente collettivo nell'applicazione di colore a disegni, stampe, fotografie, mappe, immagini in movimento e altri contenuti visivi.","lv":"Izteiksme, kas ietver grupas ieguldījumu, izkrāsojot zīmējumu, gravīru, fotogrāfiju, karšu, kustīgo attēlu, u. tml.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden en andere visuele content.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av fargelegge tegninger, trykk, fotografier, kart, levende bilder og annet visuelt materiale.","tr":"Çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere ve diğer görsel içeriğe kolektif bir temsilcinin renk uygulama katkısını içeren bir anlatım.","zh-Hans-CN":"包括将颜色施加于图画、印刷品、照片、地图、动态图像和其他视觉内容上的一个集体行为者的贡献的一种内容表达"},"altLabel":{"ar":["وكيل جماعي جامع لـ"],"de":["Gemeinschaftlicher Akteur als Bearbeiterin/Bearbeiter eines Exemplars von"],"en":["colorist collective agent of"],"es":["agente colectivo colorista de"],"fi":["-"],"hu":["színező kollektív ágense:"],"nl":["inkleurder-collectieve actor van"],"tr":["renklendirici kolektif temsilcisi"],"zh-Hans-CN":["……的着色者集体行为者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
