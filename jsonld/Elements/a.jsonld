                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50320", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfFamily.en", "label":"has related work of family"},{"@id":"http://rdaregistry.info/Elements/a/P51100", "lexicalAlias":"http://rdaregistry.info/Elements/a/sponsoredWorkOfCollectiveAgent.en", "label":"has sponsored work of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51102", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/sponsoredWorkOfFamily.en", "label":"has sponsored work of family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51102", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/sponsoredWorkOfFamily.en", "label":"has sponsored work of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P51103","label":{"ar":"له عمل برعاية شخص","ca":"té com a obra patrocinada per una persona","cs":"má dílo sponzorované osobou","da":"har værk sponsoreret af person","de":"hat Person als Träger eines Werks von","de":"hat Person als Träger eines Werks von","el":"έχει χορηγούμενο έργο του φυσικού προσώπου","en":"has sponsored work of person","es":"tiene obra patrocinada de persona","et":"isiku toetatud teos","fi":"henkilön sponsoroima teos","fr":"a pour œuvre parrainée d’une personne","hu":"személy szponzorált műve a következő:","it":"ha come opera sponsorizzata di persona","lv":"sponsors (persona) darbam","nl":"heeft gesponsord werk van persoon","no":"har verk sponset av person","tr":"kişinin sponsor olduğu eser ile ilişkilidir","zh-Hans-CN":"有个人的被赞助作品"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن رعاية بعض جوانب عمل."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en el patrocini d’algun aspecte d’una obra."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za sponzorování některého aspektu díla."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at sponsorere et aspekt af et værk."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die finanzielle Unterstützung einzelner Aspekte verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die finanzielle Unterstützung einzelner Aspekte verantwortlich ist."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα έργο που περιλαμβάνει την ευθύνη ενός φυσικού προσώπου που επιχορηγεί κάποια πτυχή του έργου."],"en":["Relates a person to a work that involves a responsibility of a person for sponsoring some aspect of a work."],"es":["Relaciona una persona con una obra que involucra una responsabilidad de una persona de patrocinar algún aspecto de una obra."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust teose mingil viisil toetamise eest."],"fi":["Liittää henkilön teokseen, jonka sponsoroimisesta henkilö on vastuussa."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à parrainer un aspect quelconque d’une œuvre."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy mű szponzorálásának valamely vonatkozásáért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona per la sponsorizzazione di alcuni aspetti di un'opera."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par kāda darba aspekta sponsorēšanu."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor het sponsoren van een aspect van een werk."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å sponse noen aspekter ved et verk."],"tr":["Bir kişiyi, bir çalışmanın belirli bir yönünü sponsor olma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及赞助一种作品某些方面的一个个人的责任的一种作品关联起来。"]},"note":{"ar":["يشمل ذلك تمويل البحوث ورعاية حدث يكون أساس لعمل."],"ca":["Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra."],"cs":["Zahrnuje financování výzkumu a sponzorování akce, která je základem díla."],"da":["Omfatter finansiering af forskning og sponsorering af et arrangement, som danner grundlag for et værk."],"de":["Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.,Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden."],"el":["Περιλαμβάνει τη χρηματοδότηση της έρευνας και της χορηγίας ενός συμβάντος που συνιστά τη βάση ενός έργου."],"en":["Includes funding research and sponsoring an event that is the basis of a work."],"es":["Incluye financiar investigación y patrocinar un evento que es la base de una obra."],"et":["Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist."],"fi":["Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin."],"fr":["Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre."],"hu":["Egy mű alapját képező kutatás finanszírozása és esemény szponzorálása is idetartozik."],"it":["Comprende finanziare una ricerca e sponsorizzare un evento che è la base di un'opera."],"lv":["Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā."],"nl":["Omvat financiering van onderzoek en sponsoren van een gebeurtenis die de basis van een werk is."],"no":["Forskningsmidler og sponsing av et arrangement som gir grunnlag for et verk, er inkludert."],"tr":["kişinin sponsor olduğu eser ile ilişkilidir"],"zh-Hans-CN":["包括作为一种作品基础的科研资助和活动赞助"]},"ToolkitLabel":{"ar":