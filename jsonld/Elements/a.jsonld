                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50111", "lexicalAlias":"http://rdaregistry.info/Elements/a/nameOfPerson.en", "label":"has name of person"},{"@id":"http://rdaregistry.info/Elements/a/P50415", "lexicalAlias":"http://rdaregistry.info/Elements/a/variantNameOfAgent.en", "label":"has variant name of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/variantNameOfPerson.en","instructionNumber":"9.2.3","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50103", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/variantNameOfPerson.en", "label":"has variant name of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50103", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/variantNameOfPerson.en", "label":"has variant name of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50102","label":{"ar":"له لغة شخص","ca":"té com a llengua d’una persona","cs":"má jazyk osoby","da":"har sprog for person","de":"hat Sprache einer Person","de":"hat Sprache einer Person","el":"έχει γλώσσα του φυσικού προσώπου","en":"has language of person","es":"tiene lenguaje de persona","et":"isiku keel","fi":"henkilön käyttämä kieli","fr":"a pour langue d’une personne","hu":"személy nyelve a következő:","it":"ha come lingua di persona","lv":"personas valoda","nl":"heeft taal van persoon","no":"har personens språk","tr":"kişinin dili ile ilişkilidir","zh-Hans-CN":"有个人的语言"},"definition":{"ar":["يربط شخصا بلغة يستخدمها شخص عند الكتابة للنشر، وللبث الإذاعي، إلخ"],"ca":["Relaciona una persona amb una llengua que és usada per una persona en les seves comunicacions."],"cs":["Vztahuje osobu k jazyku, který osoba používá v komunikaci."],"da":["Relaterer en person til et sprog, som en person anvender til at skrive til publicering, udsendelse etc."],"de":["Setzt eine Person in Beziehung zu einer Sprache, die eine Person für ihre Veröffentlichungen, zum Senden und so weiter verwendet.,Setzt eine Person in Beziehung zu einer Sprache, die eine Familie bei ihrer Kommunikation verwendet."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια γλώσσα την οποία το φυσικό πρόσωπο χρησιμοποιεί σε μια δημοσίευση, εκπομπή κ.λπ."],"en":["Relates a person to a language that is used by a person in its communications."],"es":["Relaciona una persona con un lenguaje que es usado por una persona en sus comunicaciones."],"et":["Seostab isiku keelega, mida isik kasutab, kirjutades avaldamiseks, avalikult esitamiseks vms."],"fi":["Liittää henkilön kieleen, jota henkilö käyttää viestinnässään."],"fr":["Met une personne en relation avec une langue qu’une personne utilise pour sa communication."],"hu":["Hozzákapcsol egy személyt egy nyelvhez, amelyet egy személy publikáció írására, műsorközvetítésben stb. használ"],"it":["Correla una persona a una lingua utilizzata da una persona quando scrive per una pubblicazione, trasmissione, etc."],"lv":["Sasaista personu ar valodu, ko persona lieto publicējoties vai uzstājoties."],"nl":["Relateert een persoon aan een taal die gebruikt is door een persoon in diens communicatie."],"no":["Relaterer en person til et språk brukt av en person som skriver for utgivelse, kringkasting etc."],"tr":["Bir kişiyi, bir kişinin iletişiminde kullandığı bir dille ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个个人在交流中所用的一种语言关联起来。"]},"ToolkitLabel":{"ar":"لغة شخص","ca":"llengua d’una persona","cs":"jazyk osoby","da":"sprog for person","de":"Sprache einer Person","de":"Sprache einer Person","el":"γλώσσα του φυσικού προσώπου","en":"language of person","es":"lenguaje de persona","et":"isiku keel","fi":"henkilön käyttämä kieli","fr":"langue d’une personne","hu":"személy nyelve:","it":"lingua di persona","lv":"personas valoda","nl":"taal van persoon","no":"personens språk","tr":"Kişinin dili","zh-Hans-CN":"个人的语言"},"ToolkitDefinition":{"ar":"لغة يستخدمها شخص عند الكتابة للنشر، والبث الإذاعي، إلخ.","ca":"Llengua que és usada per una persona en les seves comunicacions.","cs":"Jazyk, který osoba používá v komunikaci.","da":"Sprog, som en person anvender til at skrive til publicering, udsendelse etc.","de":"Eine Sprache, die eine Person für ihre Veröffentlichungen, zum Senden und so weiter verwendet.","de":"Eine Sprache, die eine Person bei ihrer Kommunikation verwendet.","el":"Μια γλώσσα την οποία το φυσικό πρόσωπο χρησιμοποιεί σε μια δημοσίευση, εκπομπή κ.λπ.","en":"A language that is used by a person in its communications.","es":"Un lenguaje que es utilizado por una persona en sus comunicaciones.","et":"Keel, mida isik kasutab, kirjutades avaldamiseks, avalikult esitamiseks vms.","fi":"Kieli, jota henkilö käyttää viestinnässään.","fr":"Langue qu’une personne utilise pour sa communication.","hu":"Egy nyelv, amelyet egy személy publikáció írására, műsorközvetítésben stb. használ.","it":"Lingua utilizzata da una persona quando scrive per una pubblicazione, trasmissione, etc.","lv":"Valoda, ko persona lieto publicējoties vai uzstājoties.","nl":"Een taal die gebruikt is door een persoon in diens communicatie.","no":"Et språk brukt av en person som skriver for utgivelse, kringkasting etc.","tr":"Bir kişinin iletişiminde kullandığı dil","zh-Hans-CN":"一个个人在交流中所用的一种语言"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/languageOfPerson.en","instructionNumber":"9.14","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50401", "lexicalAlias":"http://rdaregistry.info/Elements/a/languageOfAgent.en", "label":"has language of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50102", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/languageOfPerson.en", "label":"has language of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50102", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/languageOfPerson.en", "label":"has language of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50249","label":{"ar":"هو شخص موضوع لـ","ca":"és persona de matèria de","cs":"je předmětem (osobou) (čeho)","da":"er person, som er emne af","de":"ist Person als Thema von","de":"ist Person als Thema von","el":"είναι θέμα φυσικό πρόσωπο του","en":"is subject person of","es":"es persona tema de","et":"teema (isik) teoses","fi":"henkilö aiheena teoksessa","fr":"est une personne sujet de","hu":"személy tárgya a következőnek:","it":"è persona soggetto di","lv":"ir temats (persona)","nl":"is persoon als onderwerp van","no":"er emne for (person)","tr":"Konu kişisidir","zh-Hans-CN":"是……的主题个人"},"definition":{"ar":["يربط شخصا بعمل عن شخص."],"ca":["Relaciona una persona amb una obra que tracta d’una persona."],"cs":["Vztahuje osobu k dílu, které o osobě pojednává."],"da":["Relaterer en person til et værk, som handler om en person."],"de":["Setzt eine Person in Beziehung zu einem Werk, das von einer Person handelt.,Setzt eine Person in Beziehung zu einem Werk, das von einer Person handelt."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα έργο σχετικά με αυτό το φυσικό πρόσωπο."],"en":["Relates a person to a work that is about a person."],"es":["Relaciona una persona con una obra que es sobre una persona."],"et":["Seostab isiku teosega, mis on isiku kohta."],"fi":["Liittää henkilön teokseen, joka käsittelee henkilöä."],"fr":["Met une personne en relation avec une œuvre qui traite d’une personne."],"hu":["Hozzákapcsol egy személyt egy műhöz, amely egy személyről szól."],"it":["Correla una persona a un'opera che tratta di una persona."],"lv":["Sasaista personu ar darbu, kura temats ir persona."],"nl":["Relateert een persoon aan een werk dat gaat over een persoon."],"no":["Relaterer en person til et verk som handler om en person."],"tr":["Bir kişiyi, bir kişi hakkında olan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与关于一个个人的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص موضوع لـ","ca":"persona de matèria de","cs":"předmět (osoba) (čeho)","da":"person, som er emne af","de":"Person als Thema von","de":"Person als Thema von","el":"θέμα φυσικό πρόσωπο του","en":"subject person of","es":"persona tema de","et":"teema (isik) teoses","fi":"henkilö aiheena teoksessa","fr":"personne sujet de","hu":"személy tárgya:","it":"persona soggetto di","lv":"ir temats (persona)","nl":"persoon als onderwerp van","no":"emne for (person)","tr":"konu alınan kişi","zh-Hans-CN":"……的主题个人"},"ToolkitDefinition":{"ar":"عمل عن شخص.","ca":"Obra que tracta d’una persona.","cs":"Dílo, které pojednává o osobě.","da":"Værk, som handler om en person.","de":"Ein Werk, das von einer Person handelt.","de":"Ein Werk, das von einer Person handelt.","el":"Ένα έργο που αφορά σε ένα φυσικό πρόσωπο.","en":"A work that is about a person.","es":"Una obra que es sobre una persona.","et":"Teos, mis on isiku kohta.","fi":"Teos, joka käsittelee henkilöä.","fr":"Œuvre qui traite d’une personne.","hu":"Egy mű, amely egy személyről szól.","it":"Opera che tratta di una persona.","lv":"Darbs, kura temats ir persona.","nl":"Een werk dat gaat over een persoon.","no":"Et verk som handler om en person.","tr":"Bir kişi hakkındaki bir eser.","zh-Hans-CN":"关于一个个人的一种作品"},"altLabel":{"ar":["شخص موضوع"],"cs":["předmět (čeho) (osoba)"],"da":["emne af (person)"],"de":["Thema von (Person),Thema von (Person)"],"en":["subject of (person)"],"es":["tema de (persona)"],"fi":["aiheena teoksessa (henkilö)"],"fr":["sujet de (personne)"],"hu":["tárgya a következőnek (személy):"],"nl":["onderwerp van (persoon)"],"tr":["(kişinin) konusu"],"zh-Hans-CN":["（个人）的主题"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/subjectPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50311", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfPerson.en", "label":"has related work of person"},{"@id":"http://rdaregistry.info/Elements/a/P50366", "lexicalAlias":"http://rdaregistry.info/Elements/a/subjectAgentOf.en", "label":"is subject agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50368", "lexicalAlias":"http://rdaregistry.info/Elements/a/personDescribedBy.en", "label":"is person described by"},{"@id":"http://rdaregistry.info/Elements/a/object/P50249", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/subjectPersonOf.en", "label":"is subject person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50249", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/subjectPersonOf.en", "label":"is subject person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50112","label":{"ar":"أسس هيئة لشخص","ca":"té com a entitat corporativa fundada per una persona","cs":"má založenou korporaci osoby","da":"har korporation grundlagt af person","de":"hat von einer Person gegründete Körperschaft","de":"hat von einer Person gegründete Körperschaft","el":"έχει ιδρυθέν συλλογικό όργανο του φυσικού προσώπου","en":"has founded corporate body of person","es":"tiene organismo corporativo fundado de persona","et":"isiku asutatud asutus","fi":"henkilön perustama yhteisö","fr":"a pour collectivité fondée d’une personne","hu":"személy által alapított testület a következő:","it":"ha come ente fondato di persona","lv":"personas dibinātā institūcija","nl":"heeft opgerichte corporatie van persoon","no":"har korporasjon grunnlagt av person","tr":"kişinin kurduğu tüzel kişi ile ilişkilidir","zh-Hans-CN":"有个人的被创办的团体"},"definition":{"ar":["يربط شخصا بهيئة بادر بتأسيسها شخص."],"ca":["Relaciona una persona amb una entitat corporativa que és iniciada per una persona."],"cs":["Vztahuje osobu ke korporaci, která byla založena osobou."],"da":["Relaterer en person til en korporation, som er igangsat af en person."],"de":["Setzt eine Person in Beziehung zu einer Körperschaft, die von einer Person gegründet wurde.,Setzt eine Person in Beziehung zu einer Körperschaft, die von einer Person gegründet wurde."],"el":["Συνδέει ένα φυσικό πρόσωπο με έναν οργανισμό που ίδρυσε ένα φυσικό πρόσωπο."],"en":["Relates a person to a corporate body who is initiated by a person."],"es":["Relaciona una persona con un organismo corporativo que es iniciado por una persona."],"et":["Seostab isiku asutusega, millele isik on aluse pannud."],"fi":["Liittää henkilön yhteisöön, jonka henkilö on perustanut."],"fr":["Met une personne en relation avec une collectivité qui est établie par une personne."],"hu":["Hozzákapcsol egy személyt egy testülethez, amelynek létrehozását egy személy kezdeményezte."],"it":["Correla una persona a un ente fondato da una persona"],"lv":["Sasaista personu ar institūciju, ko dibinājusi persona."],"nl":["Relateert een persoon aan een corporatie die is gesticht door een persoon."],"no":["Relaterer en person til en korporasjon som er opprettet av en person."],"tr":["Bir kişiyi, bir kişi tarafından kurulan bir tüzel kişilikle İlişkilendirir."],"zh-Hans-CN":["将一个个人与被一个个人发起的一个团体关联起来。"]},"ToolkitLabel":{"ar":"أسس هيئة من شخص","ca":"entitat corporativa fundada per una persona","cs":"založená korporace osoby","da":"korporation grundlagt af person","de":"von einer Person gegründete Körperschaft","de":"von einer Person gegründete Körperschaft","el":"ιδρυθέν συλλογικό όργανο του φυσικού προσώπου","en":"founded corporate body of person","es":"organismo corporativo fundado de persona","et":"isiku asutatud asutus","fi":"henkilön perustama yhteisö","fr":"collectivité fondée d’une personne","hu":"személy által alapított testület:","it":"ente fondato di persona","lv":"personas dibinātā institūcija","nl":"opgerichte corporatie van persoon","no":"korporasjon grunnlagt av person","tr":"kişi tarafından kurulan tüzel kişi","zh-Hans-CN":"个人的被创办的团体"},"ToolkitDefinition":{"ar":"هيئة بادر بتأسيسها شخص.","ca":"Entitat corporativa que és iniciada per una persona.","cs":"Korporace, která byla založena osobou.","da":"Korporation, som er igangsat af en person.","de":"Eine Körperschaft, die von einer Person gegründet wurde.","de":"Eine Körperschaft, die von einer Person gegründet wurde.","el":"Ένας οργανισμός που ίδρυσε ένα φυσικό πρόσωπο.","en":"A corporate body who is initiated by a person.","es":"Un organismo corporativo que es iniciado por una persona.","et":"Asutus, millele isik on aluse pannud.","fi":"Yhteisö, jonka henkilö on perustanut.","fr":"Collectivité qui est établie par une personne.","hu":"Egy testület, amelynek létrehozását egy személy kezdeményezte.","it":"Ente fondato da una persona","lv":"Institūcija, ko dibinājusi persona.","nl":"Een corporatie die is gesticht door een persoon.","no":"En korporasjon som er opprettet av en person.","tr":"Bir kişi tarafından kurulan bir tüzel kişilik","zh-Hans-CN":"被一个个人发起的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/foundedCorporateBodyOfPerson.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50318", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfPerson.en", "label":"has related corporate body of person"},{"@id":"http://rdaregistry.info/Elements/a/P51104", "lexicalAlias":"http://rdaregistry.info/Elements/a/foundedCorporateBodyOfAgent.en", "label":"has founded corporate body of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50112", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/foundedCorporateBodyOfPerson.en", "label":"has founded corporate body of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50112", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/foundedCorporateBodyOfPerson.en", "label":"has founded corporate body of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50156","label":{"ca":"és editor literari de","da":"er redaktør af","de":"ist Herausgeber von","el":"είναι επιμελητής του","en":"is editor of (Deprecated)","fi":"toimittajana aineistossa","fr":"est un éditeur intellectuel de","hu":"szerkesztője"},"definition":{"ca":["Relaciona un agent, que contribueix amb una expressió d’una obra revisant o aclarint el contingut, o seleccionant i aplegant les obres, o les parts d’obres, d’un o més creadors, amb una expressió."],"da":["Relaterer en agent, der har bidraget til et udtryk af et værk ved at revidere eller præcisere indholdet, eller ved at udvælge og sammensætte værker eller dele af værker, af en eller flere ophavspersoner til et udtryk."],"de":["Setzt einen Akteur, der zu einer Expression eines Werks beiträgt, indem er den Inhalt überarbeitet oder erläutert oder Werke oder Teile von Werken von einem oder mehreren geistigen Schöpfern auswählt und zusammenstellt, mit einer Expression in Beziehung."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της αναθεώρησης ή αποσαφήνισης του περιεχομένου ή μέσω της επιλογής και συγκέντρωσης έργων ή μερών έργων από έναν ή περισσότερους δημιουργούς, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution of revision or clarification of the content, or selection and aggregation of works, or parts of works, by one or more creators. (Deprecated)"],"fi":["Liittää tomijan teoksen ekspressioon, joka on syntynyt tarkistamalla tai selkeyttämällä aiempaa sisältöä, tai valitsemalla ja kokoamalla yhden tai useamman teoksen tekijän teoksia tai niiden osia."],"fr":["Met un agent qui contribue à une expression d’une œuvre en révisant ou en clarifiant le contenu, ou bien en choisissant et en rassemblant des œuvres, ou des parties d’œuvres, d’un ou plusieurs créateurs en relation avec une expression."],"hu":["Egy ágenst (személyt, családot vagy testületet), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy vagy több alkotó által készített mű tartalmát átvizsgálja vagy pontosítja, vagy műveket vagy művek részeit kiválogatja és összeállítja, hozzákapcsol egy kifejezési formához."]},"note":{"da":["Bidragene kan omfatte tilføjelse af en indledning, noter eller andet vigtigt materiale, eller forberedelse af udtrykket af et værk til produktion, publicering eller distribution."],"de":["Dazu gehören eine Einleitung, Anmerkungen oder sonstiges kritisches Material hinzuzufügen oder eine Expression eines Werks für die Herstellung, die Veröffentlichung oder den Vertrieb vorzubereiten."],"el":["Οι συνεισφορές μπορεί να περιλαμβάνουν μια εισαγωγή, σημειώσεις ή άλλο κριτικό υλικό ή προετοιμασία της έκφρασης ενός έργου για παραγωγή, δημοσίευση ή διανομή."],"en":["Contributions may include adding an introduction, notes, or other critical matter, or preparing the expression of a work for production, publication, or distribution."],"fi":["Toimittaja voi osallistua ekspression tekoon lisäämällä johdannon, huomautuksia tai muuta kriittistä sisältöä. Toimittaja voi myös valmistella ekspression tuotantoa, julkaisemista tai jakelua varten."],"fr":["Les contributions peuvent inclure l’ajout d’une introduction, de notes ou d’autres textes critiques, ou bien la préparation de l’expression d’une œuvre aux fins de production, de publication ou de diffusion/distribution."],"hu":["A közreműködés magába foglalhatja bevezetés, jegyzetek vagy egyéb kritikai anyag hozzáadását, vagy egy mű kifejezési formájának előkészítését gyártáshoz, kiadáshoz vagy terjesztéshez."]},"ToolkitLabel":{"ca":"editor literari de","da":"redaktør af","de":"Herausgeber von","el":"επιμελητής του","en":"editor of (Deprecated)","fi":"toimittajana aineistossa","fr":"éditeur intellectuel de","hu":"szerkesztője","no":"tekstkonsulent for"},"ToolkitDefinition":{"ca":"Expressió d’una obra que incorpora una contribució que revisa o aclareix el contingut, o selecciona i aplega les obres, o les parts d’obres, d’un o més creadors.","da":"Udtryk af et værk der inkorporerer et bidrag ved at revidere eller præcisere indhold, eller ved at udvælge og sammensætte værker eller dele af værker, af en eller flere ophavspersoner.","de":"Eine Expression eines Werks, bei der ein Akteur den Inhalt überarbeitet oder erläutert oder Werke oder Teile von Werken von einem oder mehreren geistigen Schöpfern auswählt und zusammenstellt.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά μέσω της αναθεώρησης ή της αποσαφήνισης του περιεχομένου ή μέσω της συλλογής, επιλογής και επιμέλειας έργων ή μερών έργων από έναν ή περισσότερους δημιουργούς.","en":"An expression that includes a contribution of revision or clarification of the content, or selection and aggregation of works, or parts of works, by one or more creators. (Deprecated)","fi":"Teoksen ekspressio, joka on syntynyt tarkistamalla tai selkeyttämällä aiempaa sisältöä, tai valitsemalla ja kokoamalla yhden tai useamman teoksen tekijän teoksia tai niiden osia.","fr":"Expression d’une œuvre qui intègre une contribution consistant à réviser ou à clarifier le contenu, ou bien à choisir et à rassembler des œuvres, ou des parties d’œuvres, d’un ou plusieurs créateurs.","hu":"Egy mű kifejezési formája, amely hozzájárulást testesít meg azzal, hogy átdolgoz vagy pontosít egy vagy több alkotó által létrehozott tartalmat, műveik vagy műrészleteik szelektálása és összeállítása révén.","no":"Et uttrykk av et verk som omfatter et bidrag i form av å redigere innholdet eller gjøre det klarere, eller ved å velge ut og kombinere verker, eller deler av verker, av én eller flere opphavspersoner."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50451", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorToAggregatedContentOf.en", "label":"is contributor to aggregated content of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/editorOf.en","See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorAgentOf.en", "label":"is author agent of"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50156", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/editorOf.en", "label":"is editor of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50156", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/editorOf.en", "label":"is editor of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50264","label":{"ar":"هي مشاركة في معاهدة لـ","ca":"és participant en un tractat de","cs":"je účastníkem smlouvy (čeho)","da":"er traktatdeltager af","de":"ist Vertragspartnerin/Vertragspartner von","de":"ist Vertragspartnerin/Vertragspartner von","el":"είναι συμμέτοχος σε συνθήκη του","en":"is participant in treaty of","es":"es participante en tratado de","et":"rahvusvahelise lepingu osaline teoses","fi":"yhteisön allekirjoittama valtiosopimus","fr":"est un participant à un traité de","hu":"résztvevője a következő szerződésnek:","it":"è partecipante al trattato di","lv":"ir līgumslēdzējs","nl":"is deelnemer in verdrag van","no":"er part i traktat for","tr":"antlaşmasının katılımcısıdır","zh-Hans-CN":"是……条约的参与者"},"definition":{"ar":["يربط هيئة بعمل معاهدة تم التوقيع عليها، أو التصديق عليها، أو الانضمام إليها."],"ca":["Relaciona una entitat corporativa amb una obra que se signa, ratifica o accedeix a un tractat."],"cs":["Vztahuje korporaci k dílu tím, že podepsala, ratifikovala nebo přistoupila ke smlouvě."],"da":["Relaterer en korporation til et værk, som er underskrevet, ratificeret eller tiltrådt til en traktat."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem ein Abkommen unterzeichnet, ratifiziert oder ihm beigetreten wird.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem ein Abkommen unterzeichnet, ratifiziert oder ihm beigetreten wird."],"el":["Συνδέει ένα κυβερνητικό, διεθνές διακυβερνητικό συλλογικό όργανο ή άλλο συλλογικό όργανο, το οποίο έχει υπογράψει, επικυρώσει ή προσχωρήσει σε μια συνθήκη, με ένα έργο."],"en":["Relates a corporate body to a work that is signed, ratified, or acceded to a treaty."],"es":["Relaciona un organismo corporativo con una obra que es firmada, ratificada o accedida a un tratado."],"et":["Seostab asutuse teosega, mis on alla kirjutatud, ratifitseeritud või sellega on ühinetud."],"fi":["Liittää yhteisön teokseen, joka on allekirjoitettu, ratifioitu tai liitetty valitosopimukseen."],"fr":["Met une collectivité en relation avec une œuvre qui consiste en un traité qui a été signé, ratifié ou auquel un participant a adhéré."],"hu":["Hozzákapcsol egy testületet egy műhöz, amely aláírt, ratifikált vagy jóváhagyott egy szerződést."],"it":["Collega un ente a un'opera che è firmata, ratificata, o ha aderito a un trattato"],"lv":["Sasaista institūciju ar darbu, kas ir parakstīts, ratificēts vai pievienots līgumam."],"nl":["Relateert een corporatie aan een werk dat is getekend, geratificeerd of toegetreden aan een verdrag."],"no":["Relaterer en korporasjon til et verk som undertegnes, ratifiseres eller sluttes til en traktat."],"tr":["Bir tüzel kişiyi, imzalanmış, onaylanmış veya bir antlaşmaya katılmış bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与作为被签署、被批准、被同意的一个条约的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مشارك في معاهدة","ca":"participant en un tractat de","cs":"účastník smlouvy (čeho)","