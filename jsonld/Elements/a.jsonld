                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/filmDistributorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50497", "lexicalAlias":"http://rdaregistry.info/Elements/a/distributorPersonOf.en", "label":"is distributor person of"},{"@id":"http://rdaregistry.info/Elements/a/P50169", "lexicalAlias":"http://rdaregistry.info/Elements/a/filmDistributorAgentOf.en", "label":"is film distributor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50496", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/filmDistributorPersonOf.en", "label":"is film distributor person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50496", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/filmDistributorPersonOf.en", "label":"is film distributor person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50197","label":{"ar":"هو وكيل صانع أفلام لـ","ca":"és agent cineasta de","cs":"je filmařem (agentem) (čeho)","da":"er agent, som er filmskaber af","de":"ist Akteur als Filmemacherin/Filmemacher von","de":"ist Akteur als Filmemacherin/Filmemacher von","el":"είναι σκηνοθέτης φορέας του","en":"is filmmaker agent of","es":"es agente cineasta de","et":"filmitegija (tegija) teoses","fi":"elokuvantekijä (toimija) teoksessa","fr":"est un agent cinéaste de","hu":"filmkészítő ágense a következőnek:","it":"è regista cinematografico agente di","lv":"ir filmas veidotājs (aģents)","nl":"is filmmaker-actor van","no":"er filmskaper av (agent)","tr":"film üreticisi temsilcisidir","zh-Hans-CN":"是……的制片人行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن فيلم مستقل أو شخصي."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la creació d’una pel·lícula cinematogràfica independent o personal."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za vytvoření nezávislého nebo autorského filmu."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at skabe en indiefilm eller personlig film."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist."],"el":["Συνδέει έναν φορέα υπεύθυνο για τη δημιουργία ενός ανεξάρτητου ή προσωπικού φιλμ, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for creating an independent or personal film."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de crear un film independiente o personal."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust sõltumatu või autorifilmi eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à créer un film indépendant ou personnel."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy független- vagy magánfilm létrehozásáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per un film indipendente o personale."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het creëren van een zelfstandige of persoonlijke film."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av å skape en uavhengig eller personlig film."],"tr":["Bir temsilciyi, bağımsız veya kişisel bir film yaratma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及创作一部独立或个人电影的一个行为者的责任的一种作品关联起来。"]},"note":{"ar":["صانع الفيلم هو المسئول مسئولية فردية عن تصور جميع جوانب الفيلم وتنفيذها."],"ca":["Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula."],"cs":["Filmař je individuálně zodpovědný za koncepci a provedení všech aspektů filmu."],"da":["Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter."],"de":["Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.,Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich."],"el":["Ένας σκηνοθέτης είναι ατομικά υπεύθυνος για τη σύλληψη και την εκτέλεση όλων των πτυχών μιας ταινίας."],"en":["A filmmaker is individually responsible for the conception and execution of all aspects of the film."],"es":["Un cineasta es individualmente responsable de la concepción y ejecución de todos los aspectos del film."],"et":["Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest."],"fi":["Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta."],"fr":["Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film."],"hu":["Egy filmkészítő egyénileg felelős egy film koncepciójáért és összes aspektusának végrehajtásáért."],"it":["Un regista è individualmente responsabile del concepimento e dell'esecuzione di tutti gli aspetti del film."],"lv":["Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem."],"nl":["Een filmmaker is zelf verantwoordelijk voor het idee en de uitvoering van alle aspecten van de film."],"no":["En filmskaper er personlig ansvarlig for idéen og gjennomføringen av alle aspektene ved en film."],"tr":["Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur."],"zh-Hans-CN":["制片人对电影所有方面的构思和执行负有个人责任"]},"ToolkitLabel":{"ar":"وكيل صانع أفلام","ca":"agent cineasta de","cs":"filmař (agent) (čeho)","da":"agent, som er filmskaber af","de":"Akteur als Filmemacherin/Filmemacher von","de":"Akteur als Filmemacherin/Filmemacher von","el":"σκηνοθέτης φορέας του","en":"filmmaker agent of","es":"agente cineasta de","et":"filmitegija (tegija) teoses","fi":"elokuvantekijä (toimija) teoksessa","fr":"agent cinéaste de","hu":"filmkészítő ágense:","it":"regista cinematografico agente di","lv":"ir filmas veidotājs (aģents)","nl":"filmmaker-actor van","no":"filmskaper av (agent)","tr":"film üreticisi temsilcisi","zh-Hans-CN":"……的制片人行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن فيلم مستقل أو شخصي.","ca":"Obra que implica una responsabilitat d’un agent en la creació d’una pel·lícula cinematogràfica independent o personal.","cs":"Dílo, které zahrnuje odpovědnost agenta za vytvoření nezávislého nebo autorského filmu.","da":"Værk, som involverer en agents ansvar for en indiefilm eller personlig film.","de":"Ein Werk, bei dem ein Akteur für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της δημιουργίας ενός ανεξάρτητου ή προσωπικού φιλμ.","en":"A work that involves a responsibility of an agent for creating an independent or personal film.","es":"Una obra que involucra una responsabilidad de un agente de crear un film independiente o personal.","et":"Teos, mis sisaldab tegija vastutust sõltumatu või autorifilmi eest.","fi":"Teos, jossa toimija on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à créer un film indépendant ou personnel.","hu":"Egy mű, amelyhe