                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50388", "lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfCollectiveAgent.en", "label":"has field of activity of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50100", "lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfPerson.en", "label":"has field of activity of person"},{"@id":"http://rdaregistry.info/Elements/a/object/P50387", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/fieldOfActivityOfAgent.en", "label":"has field of activity of agent"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50387", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/fieldOfActivityOfAgent.en", "label":"has field of activity of agent"}]},{"@id":"http://rdaregistry.info/Elements/a/P50388","label":{"ar":"له مجال نشاط وكيل جماعي","ca":"té com a camp d’activitat d’un agent col·lectiu","cs":"má oblast působnosti kolektivního agenta","da":"har virkefelt for kollektiv agent","de":"hat Betätigungsfeld eines gemeinschaftlichen Akteurs","de":"hat Betätigungsfeld eines gemeinschaftlichen Akteurs","el":"έχει πεδίο δραστηριοποίησης του συλλογικού φορέα","en":"has field of activity of collective agent","es":"tiene campo de actividad del agente colectivo","et":"kollektiivi tegevusala","fi":"yhteistoimijan toiminta-ala","fr":"a pour domaine d’activité d’un agent collectif","hu":"kollektív ágens tevékenységi köre a következő:","it":"ha come campo di attività di agente collettivo","lv":"grupas darbības joma","nl":"heeft veld van activiteit van collectieve actor","no":"har virksomhetsområde for kollektiv agent","tr":"kolektif temsilcinin faaliyet alanı ile ilişkilidir","zh-Hans-CN":"有集体行为者的活跃领域"},"definition":{"ar":["يربط وكيلا جماعيا بمجال العمل والخبرة، الخ، الذي يمارسه الوكيل الجماعي."],"ca":["Relaciona un agent col·lectiu amb un camp d’acció, àrea d’experiència, etc., al qual es dedica un agent col·lectiu."],"cs":["Vztahuje kolektivního agenta k oblasti působnosti, oboru odbornosti atd., ve kterých kolektivní agent působí."],"da":["Relaterer en kollektiv agent til et indsatsområde, ekspertiseområde osv., inden for hvilket en kollektiv agent er engageret."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Tätigkeitsfeld, einem Wissensgebiet und so weiter, in dem ein gemeinschaftlicher Akteur aktiv ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Tätigkeitsfeld, einem Wissensgebiet und so weiter, in dem ein gemeinschaftlicher Akteur aktiv ist."],"en":["Relates a collective agent to a field of endeavor, area of expertise, etc., in which a collective agent is engaged."],"es":["Relaciona a un agente colectivo con un campo de actividad, área de especialización, etc., en la que un agente está involucrado."],"et":["Seostab kollektiivi tegevus- või erialaga, millega kollektiiv tegeleb või on tegelnud."],"fi":["Liittää yheistoimijan alaan, jolla yhteishenkilö toimii tai on toiminut, tai jonka asiantuntija tms. se on."],"fr":["Met un agent collectif en relation avec un champ d’activité, domaine d’expertise, etc. dans lequel un agent collectif évolue."],"hu":["Hozzákapcsol egy kollektív ágenst egy tevékenységhez, szakterülethez, illetékességi, stb. területhez, amely iránt a kollektív ágens elkötelezett."],"it":["Correla un agente collettivo a un campo di impegno, area di competenza, etc. in cui un agente collettivo è impegnato."],"lv":["Sasaista grupu ar grupas darbības jomu, kurā tā iesaistīta."],"nl":["Relateert een collectieve actor aan een veld van inspanning, vakgebied etc. waarbij een collectieve actor betrokken is."],"no":["Relaterer en kollektiv agent til et arbeidsfelt, et ekspertiseområde, etc., som en kollektiv agent er involvert i."],"tr":["Kolektif bir temsilciyi, bir kolektif temsilcinin dahil olduğu bir çalışma alanı, uzmanlık alanı vb. ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与一个集体行为者所从事的努力领域、专业范围等关联起来。"]},"ToolkitLabel":{"ar":"مجال نشاط وكيل جماعي","ca":"camp d’activitat d’un agent col·lectiu","cs":"oblast působnosti kolektivního agenta","da":"virkefelt for kollektiv agent","de":"Betätigungsfeld eines gemeinschaftlichen Akteurs","de":"Betätigungsfeld eines gemeinschaftlichen Akteurs","el":"πεδίο δραστηριοποίησης του συλλογικού φορέα","en":"field of activity of collective agent","es":"campo de actividad del agente colectivo","et":"kollektiivi tegevusala","fi":"yhteistoimijan toiminta-ala","fr":"domaine d’activité d’un agent collectif","hu":"kollektív ágens tevékenységi köre:","it":"campo di attività di agente collettivo","lv":"grupas darbības joma","nl":"veld van activiteit van collectieve actor","no":"virksomhetsområde for kollektiv agent","tr":"kolektif temsilcinin faaliyet alanı","zh-Hans-CN":"集体行为者的活跃领域"},"ToolkitDefinition":{"ar":"مجال العمل والخبرة، الخ، الذي يمارسه الوكيل الجماعي.","ca":"Camp d’acció, àrea d’experiència, etc., al qual es dedica un agent col·lectiu.","cs":"Oblast činnosti, obor odbornosti atd., ve kterých kolektivní agent působí.","da":"Indsatsområde, ekspertiseområde osv., inden for hvilket en kollektiv agent er engageret.","de":"Ein Tätigkeitsfeld, ein Wissensgebiet und so weiter, in dem ein gemeinschaftlicher Akteur aktiv ist.","de":"Ein Tätigkeitsfeld, ein Wissensgebiet und so weiter, in dem ein gemeinschaftlicher Akteur aktiv ist.","en":"A field of endeavor, area of expertise, etc., in which a collective agent is engaged.","es":"Un campo de actividad, un área de especialización, etc., en la que participa un agente colectivo.","et":"Tegevus- või eriala, millega kollektiiv tegeleb või on tegelnud.","fi":"Ala, jolla yhteishenkilö toimii tai on toiminut, tai jonka asiantuntija tms. se on.","fr":"Champ d’activité, domaine d’e