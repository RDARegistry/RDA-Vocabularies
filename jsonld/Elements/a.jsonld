                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorAgentOf.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50204", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfWorkOf.en", "label":"is creator agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P51114", "lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorCollectiveAgentof.en", "label":"is collector collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P51117", "lexicalAlias":"http://rdaregistry.info/Elements/a/isCollectorPersonof.en", "label":"is collector person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P51113", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/isCollectorAgentOf.en", "label":"is collector agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51113", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/isCollectorAgentOf.en", "label":"is collector agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51114","label":{"ca":"és agent col·lectiu col·leccionista de","cs":"je sběratelem (kolektivním agentem) (čeho)","de":"ist gemeinschaftlicher Akteur als Sammlerin/Sammler von","en":"is collector collective agent of","es":"es agente colectivo recolector de","fi":"muodostaja (yhteistoimija) kokoelmalle","fr":"est un agent collectif collectionneur de","hu":"összegyűjtő kollektív ágense a következő:","nl":"is verzamelaar-collectieve actor van","tr":"koleksiyoncu kolektif temsilcisidir","zh-Hans-CN":"是……的收藏者集体行为者"},"definition":{"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la col·lecció d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament"],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za vytvoření sbírky (díla) výběrem a uspořádáním jednotek, které exemplifikují ztvárnění dalších děl."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for collecting by selecting and arranging items that exemplify the embodiment of other works"],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de recolectar mediante la selección y disposición de elementos que ejemplifican la encarnación de otras obras."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija vastaa kokoelmateoksen muodostamisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää."],"fr":["Met un agent collectif en relation avec une œuvre de collection de ressources qui comporte une responsabilité de la part d’un agent collectif consistant à sélectionner et arranger des items qui exemplifient la matérialisation d’autres œuvres."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége olyan egységek válogatásással és elredendezéssel való összegyűjtéséért, amelyek más művek megtestesüléseinek példányai"],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor verzamelen door het selecteren en ordenen van items die voorstellen de belichaming van andere werken."],"tr":["Kolektif bir temsilciyi, diğer eserlerin somutlaşmasını örnekleyen öğeleri seçerek ve düzenleyerek toplama sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及通过选择和整理例证其他作品具体化的单件而进行收藏的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ca":"agent col·lectiu co