                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50147", "lexicalAlias":"http://rdaregistry.info/Elements/a/performerAgentOf.en", "label":"is performer agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/dancerAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50728", "lexicalAlias":"http://rdaregistry.info/Elements/a/dancerCollectiveAgentOf.en", "label":"is dancer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50577", "lexicalAlias":"http://rdaregistry.info/Elements/a/dancerPersonOf.en", "label":"is dancer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50073", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/dancerAgentOf.en", "label":"is dancer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50073", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/dancerAgentOf.en", "label":"is dancer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50728","label":{"ar":"هو وكيل جماعي راقص لـ","ca":"és agent col·lectiu ballarí de","cs":"je tanečníkem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er danser af","de":"ist gemeinschaftlicher Akteur als Tänzerin/Tänzer von","de":"ist gemeinschaftlicher Akteur als Tänzerin/Tänzer von","el":"είναι χορευτής συλλογικός φορέας του","en":"is dancer collective agent of","es":"es agente colectivo de bailarines de","et":"tantsija (kollektiiv) väljenduses","fi":"tanssija (yhteistoimija) ekspressiossa","fr":"est un agent collectif danseur de","hu":"táncos kollektív ágense a következőnek:","it":"è ballerino agente collettivo di","lv":"ir dejotājs (grupa)","nl":"is danser-collectieve actor van","no":"er danser for (kollektiv agent)","tr":"dansçı kolektif temsilcisidir","zh-Hans-CN":"是……的舞蹈者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في إدارة فرقة عزف وقيادتها في عرض موسيقي أو درامي."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu dansant en una representació musical o dramàtica."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že tančí v hudebním nebo dramatickém vystoupení."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at danse i en musikalsk eller dramatisk præsentation."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of dancing in a musical or dramatic presentation."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de danza en una presentación musical o dramática."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, tantsides muusika- või draamaetenduses."],"fi":["Liittää yhteistoimijan ekspressioon, jonka tekemisessä yhteistoimija on osallisena tanssimalla musiikki- tai näyttämöesityksessä."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à danser dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy zenei vagy drámai bemutatóban táncoló kollektív ágens közreműködését."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nella danza in una presentazione musicale o drammatica."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, dejojot muzikālā vai dramatiskā uzvedumā."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage van een collectieve actor door het dansen in een muziek- of dramapresentatie."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av dansing i en musikalsk eller dramatisk forestilling."],"tr":["Kolektif bir temsilciyi, müzikal veya dramatik bir sunumda kolektif bir dans temsilcisinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括在音乐或戏剧呈现中的一个舞蹈集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هو وكيل جماعي راقص لـ","ca":"agent col·lectiu ballarí de","cs":"tanečník (kolektivní agent) (čeho)","da":"kollektiv agent, som er danser af","de":"Gemeinschaftlicher Akteur als Tänzerin/Tänzer von","de":"Gemeinschaftlicher Akteur als Tänzerin/Tänzer von","el":"χορευτής συλλογικός φορέας του","en":"dancer collective agent of","es":"agente colectivo de bailarines de","et":"tantsija (kollektiiv) väljenduses","fi":"tanssija (yhteistoimija) ekspressiossa","fr":"agent collectif danseur de","hu":"táncos kollektív ágense:","it":"ballerino agente collettivo di","lv":"ir dejotājs (grupa)","nl":"danser-collectieve actor van","no":"danser for (kollektiv agent)","tr":"dansçı kolektif temsilci","zh-Hans-CN":"……的舞蹈者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في الرقص في عرض موسيقي أو درامي.","ca":"Expressió que inclou una contribució d’un agent col·lectiu dansant en una representació musical o dramàtica.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že tančí v hudebním nebo dramatickém vystoupení.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at danse i en musikalsk eller dramatisk præsentation.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er in einer musikalischen oder dramatischen Darbietung tanzt.","en":"An expression that includes a contribution by a collective agent of dancing in a musical or dramatic presentation.","es":"Una expresión que incluye una contribución de un agente colectivo de danza en una presentación musical o dramática.","et":"Väljendus, millesse kollektiiv on andnud panuse, tantsides muusika- või draamaetenduses.","fi":"Ekspressio, jonka tekemisessä yhteistoimija on osallisena tanssimalla musiikki- tai näyttämöesityksessä.","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à danser dans une présentation musicale ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy zenei vagy drámai bemutatóban táncoló kollektív ágens közreműködését.","it":"Espressione che comprende un contributo di un agente collettivo nella danza in una presentazione musicale o drammatica.","lv":"Izteiksme, kas ietver grupas ieguldījumu, dejojot muzikālā vai dramatiskā uzvedumā.","nl":"Een expressie die omvat een bijdrage van een collectieve actor door het dansen in een muziek- of dramapresentatie.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av dansing i en musikalsk eller dramatisk forestilling.","tr":"Müzikal veya dramatik bir sunumda kolektif bir temsilcinin dans katkısını içeren bir anlatım.","zh-Hans-CN":"包括在音乐或戏剧呈现中的一个舞蹈集体行为者的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
