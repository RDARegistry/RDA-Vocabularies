                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/draftsmanFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51077", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorFamilyToAmalgamationOf.en", "label":"is contributor family to amalgamation of"},{"@id":"http://rdaregistry.info/Elements/a/P50745", "lexicalAlias":"http://rdaregistry.info/Elements/a/draftsmanCollectiveAgentOf.en", "label":"is draftsman collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51047", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/draftsmanFamilyOf.en", "label":"is draftsman family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51047", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/draftsmanFamilyOf.en", "label":"is draftsman family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50594","label":{"ar":"هو شخص رسام هندسي لـ","ca":"és persona delineant de","cs":"je technickým kresličem (osobou) (čeho)","da":"er person, som er teknisk tegner af","de":"ist Person als Technische Zeichnerin/Technischer Zeichner von","de":"ist Person als Technische Zeichnerin/Technischer Zeichner von","el":"είναι σχεδιαστής φυσικό πρόσωπο του","en":"is draftsman person of","es":"es persona dibujante de","et":"joonestaja (isik) väljenduses","fi":"piirtäjä (henkilö) ekspressiossa","fr":"est une personne dessinatrice industrielle de","hu":"műszaki rajzoló személye a következőnek:","it":"è disegnatore industriale persona di","lv":"ir rasētājs (persona)","nl":"is technisch tekenaar-persoon van","no":"er teknisk tegner for (person)","tr":"teknik ressam kişisidir","zh-Hans-CN":"是……的绘图者个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص في وضع خطط أو رسومات مفصلة للمباني والسفن والطائرات والآلات والأشياء، إلخ."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona elaborant plànols o dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes, etc."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů atd."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt."],"en":["Relates a person to an expression that includes a contribution by a person of making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc."],"es":["Relaciona a una persona con una expresión que incluye la contribución de una persona en la realización de planos o dibujos detallados de edificios, barcos, aviones, máquinas, objetos, etc."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele."],"fi":["Liittää henkilön ekspressioon, jonka tekemisessä henkilö on osallisena tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tms."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à effectuer des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets, etc."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését épületek, hajók, repülőgépek, gépek, objektumok, stb. részletes terveinek vagy rajzainak elkészítésében."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nel fare progetti o disegni dettagliati per edifici, navi, aerei, macchine, oggetti, etc."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, izstrādājot ēku, kuģu, lidmašīnu, mašīnu, objektu utt. detalizētus plānus vai rasējumus."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen etc."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc."],"tr":["Bir kişiyi, binalar, gemiler, uçaklar, makineler, nesneler vb. için ayrıntılı planlar veya çizimler yapan bir kişinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括为建筑物、船舶、飞行器、机械装置、物体等制作详细平面图或绘制草图的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص رسام هندسي","ca":"persona delineant de","cs":"technický kreslič (osoba) (čeho)","da":"person, som er teknisk tegner af","de":"Person als Technische Zeichnerin/Technischer Zeichner von","de":"Person als Technische Zeichnerin/Technischer Zeichner von","el":"σχεδιαστής φυσικό πρόσωπο του","en":"draftsman person of","es":"persona dibujante de","et":"joonestaja (isik) väljenduses","fi":"piirtäjä (henkilö) ekspressiossa","fr":"personne dessinatrice industrielle de","hu":"műszaki rajzoló személye:","it":"disegnatore industriale persona di","lv":"ir rasētājs (persona)","nl":"technisch tekenaar-persoon van","no":"teknisk tegner for (person)","tr":"tasarımcı","zh-Hans-CN":"……的绘图者个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص في وضع خطط أو رسومات مفصلة للمباني والسفن والطائرات والآلات والأشياء، إلخ.","ca":"Expressió que inclou una contribució d’una persona elaborant plànols o dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes, etc.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů atd.","da":"Udtryk, som omfatter en persons bidrag ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc.","de":"Eine Expression, zu der eine Person beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder ähnliches erstellt.","en":"An expression that includes a contribution by a person of making detailed plans or drawings for buildings, ships, aircraft, machines, objects, etc.","es":"Una expresión que incluye la contribución de una persona en la realización de planos o dibujos detallados de edificios, barcos, aviones, máquinas, objetos, etc.","et":"Väljendus, millesse isik on andnud panuse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele.","fi":"Ekspressio, jonka tekemisessä henkilö on osallisena tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tms.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à effectuer des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets, etc.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését épületek, hajók, repülőgépek, gépek, objektumok, stb. részletes terveinek vagy rajzainak elkészítésében.","it":"Espressione che comprende un contributo di una persona nel fare progetti o disegni dettagliati per edifici, navi, aerei, macchine, oggetti, etc.","lv"