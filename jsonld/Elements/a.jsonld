                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/relatedEntityOfAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/x/P00028", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedEntityOfRDAEntity.en", "label":"has related entity of RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50479", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedEntityOfCollectiveAgent.en", "label":"has related entity of collective agent"},{"@id":"http://rdaregistry.info/Elements/a/P50482", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedEntityOfPerson.en", "label":"has related entity of person"},{"@id":"http://rdaregistry.info/Elements/a/P50304", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedRDAEntityOfAgent.en", "label":"has related RDA entity of agent"},{"@id":"http://rdaregistry.info/Elements/a/object/P50478", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/relatedEntityOfAgent.en", "label":"has related entity of agent"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50478", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/relatedEntityOfAgent.en", "label":"has related entity of agent"}]},{"@id":"http://rdaregistry.info/Elements/a/P50479","label":{"ar":"له كيان مرتبط بوكيل جماعي","ca":"té com a entitat relacionada amb un agent col·lectiu","cs":"má entitu související s kolektivním agentem","da":"har entitet relateret til kollektiv agent","de":"hat mit gemeinschaftlichem Akteur in Beziehung stehende Entität","de":"hat mit gemeinschaftlichem Akteur in Beziehung stehende Entität","el":"έχει σχετική οντότητα του συλλογικού φορέα","en":"has related entity of collective agent","es":"tiene una entidad relacionada de agente colectivo","et":"kollektiiviga seotud olem","fi":"yhteistoimijaan liittyvä entiteetti","fr":"a pour entité en relation avec un agent collectif","hu":"kollektív ágens kapcsolódó entitása a következő:","it":"ha come entità correlata di agente collettivo","lv":"ar grupu saistītā entīte","nl":"heeft gerelateerde entiteit van collectieve actor","no":"har relatert entitet av kollektiv agent","tr":"kolektif temsilcinin ilgili varlığı ile ilişkilidir","zh-Hans-CN":"有集体行为者的关联实体"},"definition":{"ar":["يربط وكيلا جماعيا بكيان مرتبط بوكيل جماعي."],"ca":["Relaciona un agent col·lectiu amb una entitat que s’associa amb un agent col·lectiu."],"cs":["Vztahuje kolektivního agenta k entitě, která je spojená s kolektivním agentem."],"da":["Relaterer en kollektiv agent til en entitet, som er knyttet til en kollektiv agent."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Entität, die mit einem gemeinschaftlichen Akteur in Verbindung steht.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Entität, die mit einem gemeinschaftlichen Akteur in Verbindung steht."],"en":["Relates a collective agent to an entity that is associated with a collective agent."],"es":["Relaciona un agente colectivo con una entidad que está asociada a un agente colectivo."],"et":["Seostab kollektiivi kollektiiviga seotud olemiga."],"fi":["Liittää yhteistoimijan entiteettiin, joka liittyy yhteistoimijaan."],"fr":["Met un agent collectif en relation avec une entité qui est associée à un agent collectif."],"hu":["Hozzákapcsol egy ágenst egy entitáshoz, amelyet egy kollektív ágenshez társítanak."],"it":["Correla un agente collettivo a un'entità associata a un agente collettivo."],"lv":["Sasaista grupu ar entīti, kas saistīta ar grupu."],"nl":["Relateert een collectieve actor aan een entiteit die is geassocieerd met een collectieve actor."],"no":["Relaterer en kollektiv agent til en entitet som forbindes med en kollektiv agent."],"tr":["Kollektif bir temsilciyi, kollektif temsilciyle bağlantılı bir varlıkla ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与和一个集体行为者有关的一个实体关联起来。"]},"ToolkitLabel":{"ar":"كيان مرتبط بوكيل جماعي","ca":"entitat relacionada amb un agent col·lectiu","cs":"entita související s kolektivním agentem","da":"entitet relateret til kollektiv agent","de":"Mit gemeinschaftlichem Akteur in Beziehung stehende Entität","de":"Mit gemeinschaftlichem Akteur in Beziehung stehende Entität","el":"σχετική οντότητα του συλλογικού φορέα","en":"related entity of collective agent","es":"entidad vinculada del agente colectivo","et":"kollektiiviga seotud olem","fi":"yhteistoimijaan liittyvä entiteetti","fr":"entité en relation avec un agent collectif","hu":"kollektív ágens kapcsolódó entitása a következő:","it":"entità correlata di agente collettivo","lv":"ar grupu saistītā entīte","nl":"gerelateerde entiteit van collectieve actor","no":"relatert entitet av kollektiv agent","tr":"kollektif temsilcinin ilişkili olduğu varlık","zh-Hans-CN":"集体行为者的关联实体"},"ToolkitDefinition":{"ar":"كيان مرتبط بوكيل جماعي.","ca":"Entitat que s’associa amb un agent col·lectiu.","cs":"Entita, která je spojená s kolektivním agentem.","da":"Entitet, som er knyttet til en kollektiv agent.","de":"Eine Entität, die mit einem gemeinschaftlichen Akteur in Verbindung steht.","de":"Eine Entität, die mit einem gemeinschaftlichen Akteur in Verbindung steht.","en":"An entity that is associated with a collective agent.","es":"Una entidad que está asociada a un agente colectivo.","et":"Kollektiiviga seotud olem.","fi":"Entiteetti, joka liittyy yhteistoimijaan.","fr":"Entité qui est associée à un agent collectif.","hu":"Egy entitás, amelyet egy kollektív ágenshez társítanak.","it":"Entità associata a un agente collettivo.","lv":"Entīte, kas saistīta ar grupu.","nl":"Een entiteit die is geassocieerd met een collectieve actor.","no":"En entitet som forbindes med en kollektiv agent.","tr":"Bir kolektif temsilciyle bağlantılı olan bir varlık.","zh-Hans-CN":"和一个集体行为者有关的一个实体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
