                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/composerFamilyOfWorkOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50995", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfWorkOf.en", "label":"is creator family of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50673", "lexicalAlias":"http://rdaregistry.info/Elements/a/composerCollectiveAgentOfWorkOf.en", "label":"is composer collective agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50975", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/composerFamilyOfWorkOf.en", "label":"is composer family of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50975", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/composerFamilyOfWorkOf.en", "label":"is composer family of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50522","label":{"ar":"هو شخص ملحن عمل لـ","ca":"és persona compositora d’una obra de","cs":"je skladatelem díla (osobou) (čeho)","da":"er person, som er komponist af værk af","de":"ist Person als Komponistin/Komponist eines Werks von","de":"ist Person als Komponistin/Komponist eines Werks von","el":"είναι συνθέτης φυσικό πρόσωπο του έργου του","en":"is composer person of work of","es":"es persona compositora de obras de","et":"teose helilooja (isik) teoses","fi":"teoksen säveltäjä (henkilö) musiikkiteoksessa","fr":"est une personne compositrice d’une œuvre de","hu":"zeneszerző személye a következő műnek:","it":"è compositore persona di opera di","lv":"ir komponists (persona) darbam","nl":"is componist-persoon van werk van","no":"er komponist for verk for (person)","tr":"eserinin besteci kişisidir","zh-Hans-CN":"是……的作品的作曲者个人"},"definition":{"ar":["يربط شخصا بعمل موسيقي يترتب عليه مسئولية شخص عن الموسيقى."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la creació d’una obra musical."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za vytvoření hudebního díla."],"da":["Relaterer en person til et værk, som er et musikværk, som involverer en persons ansvar for musik."],"de":["Setzt eine Person in Beziehung zu einem Musikwerk, bei dem eine Person für die Musik verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für die Schaffung eines Musikwerks verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for creating a musical work."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona en la creación de una obra musical."],"et":["Seostab isiku muusikateosega, mis sisaldab isiku vastutust muusika loomise eest."],"fi":["Liittää henkilön teokseen, joka on musiikkiteos, jonka luomisesta henkilö on vastuussa."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à créer une œuvre musicale."],"hu":["Hozzákapcsol egy személyt egy zeneműhöz, amelyhez hozzátartozik egy személy felelőssége a zenéért."],"it":["Correla una persona a un'opera musicale che implica una responsabilità di una persona per la musica."],"lv":["Sasaista personu ar darbu, kas ir mūzikas darbs, kas ietver personas atbildību par mūzikas radīšanu."],"nl":["Relateert een persoon aan een werk dat is een muziekwerk dat met zich meebrengt een verantwoordelijkheid van een persoon voor muziek."],"no":["Relaterer en person til et musikalsk verk som involverer et ansvar for en person i form av musikk."],"tr":["Bir kişiyi, kişinin bir müzik eseri yaratma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及创作一种音乐作品的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص ملحن عمل","ca":"persona compositora d’una obra de","cs":"skladatel díla (osoba) (čeho)","da":"person, som er komponist af værk af","de":"Person als Komponistin/Komponist eines Werks von","de":"Person als Komponistin/Komponist eines Werks von","el":"συνθέτης φυσικό πρόσωπο του έργου του","en":"composer person of work of","es":"persona compositora de obras de","et":"teose helilooja (isik) teoses","fi":"teoksen säveltäjä (henkilö) musiikkiteoksessa","fr":"personne compositrice d’une œuvre de","hu":"zeneszerző személye a következő műnek:","it":"compositore persona di opera di","lv":"ir komponists (persona) darbam","nl":"componist-persoon van werk van","no":"komponist for verk for (person)","tr":"eserin bestecisi","zh-Hans-CN":"……的作品的作曲者个人"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل موسيقي يترتب عليه تحمل شخص المسئولية عن الموسيقى.","ca":"Obra que implica un responsabilitat d’una persona en la creació d’una obra musical.","cs":"Dílo, které zahrnuje odpovědnost osoby za vytvoření hudebního díla.","da":"Værk, som er et musikværk, som involverer en persons ansvar for musik.","de":"Ein Musikwerk, bei dem eine Person für die Musik verantwortlich ist.","de":"Ein Werk, bei dem eine Person für die Schaffung eines Musikwerks verantwortlich ist.","en":"A work that involves a responsibility of a person for creating a musical work.","es":"Una obra que implica la responsabilidad de una persona en la creación de una obra musical.","et":"Muusikateos, mis sisaldab isiku vastutust muusika loomise eest.","fi":"Teos, joka on musiikkiteos, jonka luomisesta henkilö on vastuussa.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à créer une œuvre musicale.","hu":"Egy zenemű, amelyhez hozzátartozik egy személy felelőssége a zenéért.","it":"Opera musicale che implica una responsabilità di una persona per la musica.","lv":"Mūzikas darbs, kas ietver personas atbildību par mūzikas radīšanu.","nl":"Een werk dat is een muziekwerk dat met zich meebrengt een verantwoordelijkheid van een persoon voor muziek.","no":"Et musikalsk verk som involverer et ansvar for en person i form av musikk.","tr":"Bir müzik eseri yaratmak için bir kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及创作一种音乐作品的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/composerPersonOfWorkOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50187", "lexicalAlias":"http://rdaregistry.info/Elements/a/composerAgentOfWorkOf.en", "label":"is composer agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50522", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/composerPersonOfWorkOf.en", "label":"is composer person of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50522", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/composerPersonOfWorkOf.en", "label":"is composer person of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50070","label":{"ar":"هو وكيل مايسترو لـ","ca":"és agent director d’orquestra de","cs":"je dirigentem (agentem) (čeho)","da":"er agent, som er dirigent af","de":"ist Akteur als Dirigentin/Dirigent von","de":"ist Akteur als Dirigentin/Dirigent von","el":"είναι διευθυντής ορχήστρας φορέας του","en":"is conductor agent of","es":"es agente director de","et":"dirigent (tegija) väljenduses","fi":"johtaja (toimija) ekspressiossa","fr":"est un agent chef musical de","hu":"karmester ágense a következőnek:","it":"è direttore agente di","lv":"ir diriģents (aģents)","nl":"is dirigent-actor van","no":"er dirigent for (agent)","tr":"orkestra şefi temsilcisidir","zh-Hans-CN":"是……的指挥行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent dirigint un grup d’intèrprets en una representació musical o dramàtica."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet."],"el":["Συνδέει έναν εκτελεστή, ο οποίος συνεισφέρει στην έκφραση ενός μουσικού έργου μέσω της καθοδήγησης μιας ομάδας εκτελεστών σε μια μουσική ή δραματική παρουσίαση κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of leading a performing group in a musical or dramatic presentation."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de liderar a un grupo escénico en una presentación musical o dramática."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, juhatades muusika- või draamaetenduse esitusrühma."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu johtamalla esiintyjäryhmän esiintymistä musiikki- tai näytelmäesityksessä."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à diriger un groupe d’interprètes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy zenei vagy drámai bemutatóban előadói csoportot vezető ágens közreműködését."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente che guida un organico in una rappresentazione musicale o teatrale."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, vadot izpildītāju grupu muzikālā vai dramatiskā uzvedumā."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage van een actor door het leiden van een uitvoerende groep in een muziek- of dramapresentatie."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling etc."],"tr":["Bir temsilciyi, müzikal veya dramatik bir sunumda bir performans grubuna liderlik eden bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括有领导音乐或戏剧呈现的表演团队的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل قائد فرقة موسيقية لـ","ca":"agent director d’orquestra de","cs":"dirigent (agent) (čeho)","da":"agent, som er dirigent af","de":"Akteur als Dirigentin/Dirigent von","de":"Akteur als Dirigentin/Dirigent von","el":"διευθυντής ορχήστρας φορέας του","en":"conductor agent of","es":"agente director de","et":"dirigent (tegija) väljenduses","fi":"johtaja (toimija) ekspressiossa","fr":"agent chef musical de","hu":"karmester ágense:","it":"direttore agente di","lv":"ir diriģents (aģents)","nl":"dirigent-actor van","no":"dirigent for (agent)","tr":"orkestra şefi temsilcisi","zh-Hans-CN":"……的指挥行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في قيادة فرقة عزف في عرض موسيقي أو درامي.","ca":"Expressió que inclou una contribució d’un agent dirigint un grup d’intèrprets en una representació musical o dramàtica.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení.","da":"Udtryk, som omfatter en agents bidrag ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet.","el":"Μια έκφραση ενός μουσικού έργου που ενσωματώνει τη συνεισφορά της διεύθυνσης ενός συνόλου σε μια μουσική ή δραματική παρουσίαση κ.λπ.","en":"An expression that includes a contribution by an agent of leading a performing group in a musical or dramatic presentation.","es":"Una expresión que incluye una contribución de un agente de liderar a un grupo escénico en una presentación musical o dramática.","et":"Väljendus, millesse tegija on andnud panuse, juhatades muusika- või draamaetenduse esitusrühma.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu johtamalla esiintyjäryhmän esiintymistä musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à diriger un groupe d’interprètes dans une présentation musicale ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy zenei vagy drámai bemutatóban előadói csoportot vezető ágens közreműködését.","it":"Espressione che include un contributo da parte di un agente che guida un organico in una rappresentazione musicale o teatrale.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, vadot izpildītāju grupu muzikālā vai dramatiskā uzvedumā.","nl":"Een expressie die omvat een bijdrage van een actor door het leiden van een uitvoerende groep in een muziek- of dramapresentatie.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling etc.","tr":"Müzikal veya dramatik bir sunumda bir performans grubuna liderlik eden bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括有领导音乐或戏剧呈现的表演团队的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["مايسترو لـ"],"ca":["director d’orquestra de"],"cs":["dirigent (čeho)"],"da":["dirigent af"],"de":["Dirigent von,Dirigent von"],"el":["διευθυντής ορχήστρας του"],"en":["conductor of"],"es":["director de"],"et":["dirigent väljenduses"],"fi":["johtaja ekspressiossa"],"fr":["chef musical de"],"hu":["karmestere:"],"it":["direttore di"],"nl":["dirigent van"],"no":["dirigent for"],"tr":["orkestra şefi"],"zh-Hans-CN":["……的指挥"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
