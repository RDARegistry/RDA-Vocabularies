                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/otherAgentManifestationOf.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50307", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedManifestationOfAgent.en", "label":"has related manifestation of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50181", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/otherAgentManifestationOf.en", "label":"is other agent associated with manifestation of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50181", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/otherAgentManifestationOf.en", "label":"is other agent associated with manifestation of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50038","label":{"ar":"لها تاريخ توقف","ca":"té com a data de cessament","cs":"má datum ukončení","da":"har dato for ophør","de":"hat Auflösungsdatum","de":"hat Auflösungsdatum","el":"έχει καταληκτική χρονολογία","en":"has date of termination","es":"tiene fecha de rescisión","et":"tegevuse lõpetamise aeg","fi":"lakkauttamisajankohta","fr":"a pour date de cessation","hu":"megszüntetésének időpontja a következő:","it":"ha come data di termine","lv":"pastāvēšanas beigu datējums","nl":"heeft datum van opheffing","no":"har tidspunkt for opphør","sv":"har tid för institutionens upphörande","tr":"sonlanma tarihi ile ilişkilidir","zh-Hans-CN":"有终止日期"},"definition":{"ar":["يربط هيئة بفترة زمنية توقفت الهيئة خلالها أو حُلت."],"ca":["Relaciona una entitat corporativa amb un interval de temps durant el qual una entitat corporativa cessa o es dissol."],"cs":["Vztahuje korporaci k časovému období, ve kterém korporace zanikla nebo byla zrušena."],"da":["Relaterer en korporation til en tidsperiode, hvorunder en korporation er ophørt eller opløst."],"de":["Setzt eine Körperschaft in Beziehung zu einem Zeitraum, in dem eine Körperschaft aufgehoben oder aufgelöst wurde.,Setzt eine Körperschaft in Beziehung zu einem Zeitraum, in dem eine Körperschaft aufgehoben oder aufgelöst wurde."],"el":["Συνδέει ένα συλλογικό όργανο με ένα χρονικό διάστημα κατά το οποίο το συλλογικό όργανο έπαυσε [να υφίσταται] ή διαλύθηκε."],"en":["Relates a corporate body to a timespan during which a corporate body is terminated or dissolved."],"es":["Relaciona un organismo corporativo con un espacio de tiempo durante el cual un organismo corporativo es rescindido o disuelto."],"et":["Seostab asutuse ajavahemikuga, millal asutuse tegevus on lõpetatud."],"fi":["Liittää yhteisön ajanjaksoon, jolloin yhteisö on lakkautettu tai hajotettu."],"fr":["Met une collectivité en relation avec un laps de temps pendant lequel une collectivité cesse son activité ou est dissoute."],"hu":["Hozzákapcsolt egy testületet egy időtartamhoz, amely alatt egy testületet megszüntettek vagy feloszlattak."],"it":["Correla un ente a un arco di tempo nel quale un ente è cessato o è stato sciolto."],"lv":["Sasaista institūciju ar laikposmu, kad institūcija beidz pastāvēt vai likvidēta."],"nl":["Relateert een corporatie aan een tijdspanne gedurende welke een corporatie wordt beëindigd of opgeheven."],"no":["Relaterer en korporasjon til et tidsrom hvor en korporasjon blir lagt ned eller oppløst."],"tr":["Bir tüzel kişiyi, feshedildiği veya dağıtıldığı bir zaman aralığı ile ilişkilidir."],"zh-Hans-CN":["将一个团体与一个团体终止或解散的时间段关联起来。"]},"ToolkitLabel":{"ar":"تاريخ التوقف","ca":"data de cessament","cs":"datum ukončení","da":"dato for ophør","de":"Auflösungsdatum","de":"Auflösungsdatum","el":"καταληκτική χρονολογία","en":"date of termination","es":"fecha de rescisión","et":"tegevuse lõpetamise aeg","fi":"lakkauttamisajankohta","fr":"date de cessation","hu":"megszüntetés időpontja:","it":"data di termine","lv":"pastāvēšanas beigu datējums","nl":"datum van opheffing","no":"tidspunkt for opphør","sv":"tid för institutionens upphörande","tr":"sonlandırma tarihi","zh-Hans-CN":"终止日期"},"ToolkitDefinition":{"ar":"فترة زمنية توقفت الهيئة خلالها أو حُلت .","ca":"Interval de temps durant el qual una entitat corporativa cessa o es dissol.","cs":"Časové období, ve kterém korporace zanikla nebo byla zrušena.","da":"Tidsperiode, hvorunder en korporation er ophørt eller opløst.","de":"Ein Zeitraum, in dem eine Körperschaft aufgehoben oder aufgelöst wurde.","de":"Ein Zeitraum, in dem eine Körperschaft aufgehoben oder aufgelöst wurde.","el":"Μια χρονολογία κατά την οποία ένα συλλογικό όργανο έπαυσε ή λύθηκε.","en":"A timespan during which a corporate body is terminated or dissolved.","es":"Un espacio de tiempo durante el cual un organismo corporativo es rescindido o disuelto.","et":"Ajavahemik, millal asutuse tegevus on lõpetatud.","fi":"Ajanjakso, jolloin yhteisö on lakkautettu tai hajotettu.","fr":"Laps de temps pendant lequel une collectivité cesse son activité ou est dissoute.","hu":"Egy időtartam, amely alatt egy testületet megszüntettek vagy feloszlattak.","it":"Arco di tempo durante il quale un ente è cessato o sciolto","lv":"Laikposms, kad institūcija beidz pastāvēt vai likvidēta.","nl":"Een tijdspanne gedurende welke een corporatie wordt beëindigd of opgeheven.","no":"Et tidsrom hvor en korporasjon blir lagt ned eller oppløst.","tr":"Bir tüzel kuruluşun sona erdiği veya feshedildiği bir zaman aralığı.","zh-Hans-CN":"一个团体终止或解散的时间段"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50351", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedTimespanOfCorporateBody.en", "label":"has related timespan of corporate body"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/dateOfTermination.en","instructionNumber":"11.4.4","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50038", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/dateOfTermination.en", "label":"has date of termination"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50038", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/dateOfTermination.en", "label":"has date of termination"}]},{"@id":"http://rdaregistry.info/Elements/a/P50212","label":{"ar":"هو وكيل مدون لمحضر اجتماع لـ","ca":"és agent responsable de notes de","cs":"je zapisovatelem jednání (agentem) (čeho)","da":"er agent, som er referent af","de":"ist Akteur als Protokollantin/Protokollant von","de":"ist Akteur als Protokollantin/Protokollant von","el":"είναι πρακτικογράφος φορέας του","en":"is minute taker agent of","es":"agente tomador de minutas de","et":"protokollija (tegija) väljenduses","fi":"pöytäkirjan laatija (toimija) ekspressiossa","fr":"est un agent procès-verbaliste de","hu":"jegyzőkönyvvezető ágense a következőnek:","it":"è verbalizzatore agente di","lv":"ir protokolists (aģents)","nl":"is notulist-actor van","no":"er referent for (agent)","tr":"zabıt katibi temsilcisidir","zh-Hans-CN":"是……的会议记录者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل بتسجيل محاضر اجتماع."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent en l’enregistrament de les notes d’una reunió."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agentatím, že zapisuje průběh jednání."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at tage referat ved et møde."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist."],"el":["Συνδέει έναν φορέα υπεύθυνο για την καταγραφή των πρακτικών μιας συνάντησης, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of recording the minutes of a meeting."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de registrar las minutas de una reunión."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse kohtumist protokollides."],"fi":["Liittää toimijan ekspressioon, jossa toimija on osallisena kokouksen pöytäkirjan laatimisessa."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à rédiger le procès-verbal d’une réunion."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését egy értekezlet jegyzőkönyvének rögzítésében."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente per registrare le minute di una riunione."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, rakstot sanāksmes protokolu."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door vastleggen van de notulen van een bijeenkomst."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å ta referat fra et møte."],"tr":["Bir temsilciyi, toplantının tutanaklarını kaydeden bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括写会议记录的一个行为者的贡献的一种内容表达关联起来。"]}