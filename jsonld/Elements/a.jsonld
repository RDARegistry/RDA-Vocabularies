                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerCollectiveAgentOfWorkOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50693", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCollectiveAgentOfWorkOf.en", "label":"is creator collective agent of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50186", "lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerAgentOfWorkOf.en", "label":"is cartographer agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50827", "lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerCorporateBodyOfWorkOf.en", "label":"is cartographer corporate body of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50978", "lexicalAlias":"http://rdaregistry.info/Elements/a/cartographerFamilyOfWorkOf.en", "label":"is cartographer family of work of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50676", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/cartographerCollectiveAgentOfWorkOf.en", "label":"is cartographer collective agent of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50676", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/cartographerCollectiveAgentOfWorkOf.en", "label":"is cartographer collective agent of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50827","label":{"ar":"هي هيئة رسامة خرائط لعمل لـ","ca":"és entitat corporativa cartògrafa d’una obra de","cs":"je kartografem (korporací) (čeho)","da":"er korporation, som er kartograf for værk af","de":"ist Körperschaft als Kartografin/Kartograf eines Werks von","de":"ist Körperschaft als Kartografin/Kartograf eines Werks von","el":"είναι χαρτογράφος συλλογικό όργανο του έργου του","en":"is cartographer corporate body of work of","es":"es organismo corporativo cartógrafo de obra de","et":"teose kartograaf (asutus) teoses","fi":"teoksen kartantekijä (yhteisö) teoksessa","fr":"est une collectivité cartographe d’une œuvre de","hu":"térképész testülete a következő műnek:","it":"è cartografo ente di opera di","lv":"ir kartogrāfs (institūcija) darbam","nl":"is cartograaf-corporatie van werk van","no":"er kartograf for verk for (korporasjon)","tr":"eserinin kartograf tüzel kişisidir","zh-Hans-CN":"是……的作品的地图绘制者团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن أعمال رسم الخرائط."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en la creació d’una obra cartogràfica."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za vytvoření kartografického díla."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for at skabe et kartografisk værk."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Schaffung eines kartografischen Werks verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Schaffung eines kartografischen Werks verantwortlich ist."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for creating a cartographic work."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad de un organismo corporativo de crear una obra cartográfica."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust kartograafilise teose eest."],"fi":["Liittää yhteisön teokseen, joka on kartografinen teos, jonka luomisesta yhteisö on vastuussa."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à créer une œuvre cartographique."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége egy kartográfiai mű létrehozásáért."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente per un'opera cartografica."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par karti, atlantu, globusu vai citu kartogrāfijas materiālu."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het creëren van een cartografisch werk."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av et kartografisk verk."],"tr":["Bir tüzel kişiyi, bir kartografik çalışma yaratmak için bir tüzel kişiliğin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及创作一种地图作品的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة رسامة خرائط لعمل","ca":"entitat corporativa cartògrafa d’una obra de","cs":"kartograf (korporace) (čeho)","da":"korporation, som er kartograf for værk af","de":"Körperschaft als Kartografin/Kartograf eines Werks von","de":"Körperschaft als Kartografin/Kartograf eines Werks von","el":"χαρτογράφος συλλογικό όργανο του έργου του","en":"cartographer corporate body of work of","es":"organismo corporativo cartógrafo de obra de","et":"teose kartograaf (asutus) teoses","fi":"teoksen kartantekijä (yhteisö) teoksessa","fr":"collectivité cartographe d’une œuvre de","hu":"térképész testülete a következő műnek:","it":"cartografo ente di opera di","lv":"ir kartogrāfs (institūcija) darbam","nl":"cartograaf-corporatie van werk van","no":"kartograf for verk for (korporasjon)","tr":"eserin kartograf tüzel kişisi","zh-Hans-CN":"……的作品的地图绘制者团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن أعمال رسم الخرائط.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en la creació d’una obra cartogràfica.","cs":"Dílo, které zahrnuje odpovědnost korporace za vytvoření kartografického díla.","da":"Værk, som involverer en korporations ansvar for at skabe et kartografisk værk.","de":"Ein Werk, bei dem eine Körperschaft für die Schaffung eines kartografischen Werks verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für die Schaffung eines kartografischen Werks verantwortlich ist.","en":"A work that involves a responsibility of a corporate body for creating a cartographic work.","es":"Una obra que involucra una responsabilidad de un organismo corporativo de crear una obra cartográfica.","et":"Teos, mis sisaldab asutuse vastutust kartograafilise teose eest.","fi":"Teos, joka on kartografinen teos, jonka luomisesta yhteisö on vastuussa.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à créer une œuvre cartographique.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége egy kartográfiai mű létrehozásáért.","it":"Opera che implica una responsabilità di un ente per un'opera cartografica.","lv":"Darbs, kas ietver institūcijas atbildību par karti, atlantu, globusu vai citu kartogrāfijas materiālu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het creëren van een cartografisch werk.","no":"Et verk som involverer et ansvar for en korporasjon i form av et kartografisk verk.","tr":"Kartografik bir eser oluşturmak için bir tüzel kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及创作一种地图作品的一个团体的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
