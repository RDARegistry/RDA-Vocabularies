                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/publisherAgentOf.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50477", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfManifestationOf.en", "label":"is creator agent of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50168", "lexicalAlias":"http://rdaregistry.info/Elements/a/broadcasterAgentOf.en", "label":"is broadcaster agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50658", "lexicalAlias":"http://rdaregistry.info/Elements/a/publisherCollectiveAgentOf.en", "label":"is publisher collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50507", "lexicalAlias":"http://rdaregistry.info/Elements/a/publisherPersonOf.en", "label":"is publisher person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50203", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/publisherAgentOf.en", "label":"is publisher agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50203", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/publisherAgentOf.en", "label":"is publisher agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50658","label":{"ar":"هو وكيل جماعي ناشر لـ","ca":"és agent col·lectiu editor de","cs":"je nakladatelem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er udgiver af","de":"ist gemeinschaftlicher Akteur als Verlag von","de":"ist gemeinschaftlicher Akteur als Verlag von","el":"είναι εκδότης συλλογικός φορέας του","en":"is publisher collective agent of","es":"es el agente colectivo editor de","et":"kirjastaja (kollektiiv) kehastuses","fi":"kustantaja (yhteistoimija) manifestaatiossa","fr":"est un agent collectif éditeur de","hu":"kiadó kollektív ágense a következő:","it":"è editore agente collettivo di","lv":"ir izdevējs (grupa)","nl":"is uitgever-collectieve actor van","no":"er utgiver av (kollektiv agent)","tr":"yayıncı kolektif temsilcisidir","zh-Hans-CN":"是……的出版者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن النشر، التحرير، أو الإصدار."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en la publicació, la posada en circulació o l’emissió."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost agenta za zveřejnění, uvedení nebo vydání."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for publicering, frigivelse eller udgivelse."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für das Veröffentlichen, die Freigabe oder die Herausgabe verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für das Veröffentlichen, die Freigabe oder die Herausgabe verantwortlich ist."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for publishing, releasing, or issuing."],"es":["Relaciona a un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de publicar, liberar o emitir."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust avaldamise, väljalaskmise või väljaandmise eest."],"fi":["Liittää yhteistoimijan manifestaatioon, jonka kustantamisesta, julkaisemisesta tai ilmestymisestä yhteistoimija on vastuussa."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif en ce qui concerne la publication, la mise à disposition ou l’édition."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége közzétételért, kiadásért vagy kibocsátásért."],"it":["Correla un agente collettivo a una manifestazione che implica una responsabilità di un agente collettivo per la pubblicazione, distribuzione o emissione."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par publicēšanu, izlaišanu vai izdošanu."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor uitgeven, uitbrengen of uitvaardigen."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av publisering, tilgjengeliggjøring eller utgivelse."],"tr":["Kolektif bir temsilciyi, bir kolektif temsilcinin yayıncılık, satış, ya da ihraç etme sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及出版、发布或发行的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي ناشر","ca":"agent col·lectiu editor de","cs":"nakladatel (kolektivní agent) (čeho)","da":"kollektiv agent, som er udgiver af","de":"Gemeinschaftlicher Akteur als Verlag von","de":"Gemeinschaftlicher Akteur als Verlag von","el":"εκδότης συλλογικός φορέας του","en":"publisher collective agent of","es":"agente colectivo editor de","et":"kirjastaja (kollektiiv) kehastuses","fi":"kustantaja (yhteistoimija) manifestaatiossa","fr":"agent collectif éditeur de","hu":"kiadó kollektív ágense a következő:","it":"editore agente collettivo di","lv":"ir izdevējs (grupa)","nl":"uitgever-collectieve actor van","no":"utgiver av (kollektiv agent)","tr":"Yayımcı kolektif temsilcisi","zh-Hans-CN":"……的出版者集体行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل جماعي عن النشر، التحرير، أو الإصدار.","ca":"Manifestació que implica una responsabilitat d’un agent col·lectiu en la publicació, la posada en circulació o l’emissió.","cs":"Provedení, které zahrnuje odpovědnost agenta za zveřejnění, uvedení nebo vydání.","da":"Manifestation, som involverer en kollektiv agents a