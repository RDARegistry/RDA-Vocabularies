                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/addressOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50419", "lexicalAlias":"http://rdaregistry.info/Elements/a/addressOfCollectiveAgent.en", "label":"has address of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/datatype/P50420", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/addressOfFamily.en", "label":"has address of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50101","label":{"ca":"té com a afiliació","da":"har tilhørsforhold","de":"hat Affiliation","el":"έχει σύνδεση","fi":"viiteryhmä","fr":"a pour affiliation","sv":"har organisatorisk tillhörighet"},"definition":{"ca":["Relaciona una persona amb un grup en el qual una persona està o ha estat afiliada per qüestions de feina, en qualitat de membre, per afinitat cultural, etc."],"da":["Relaterer en person til en gruppe, som en person er eller har været tilknyttet via beskæftigelse, medlemskab, kulturel identitet etc."],"de":["Setzt eine Person mit einer Gruppe, die durch Anstellung, Mitgliedschaft, kulturelle Identität usw. zugehörig ist oder war, in Beziehung."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια ομάδα με την οποία το φυσικό πρόσωπο συνδέεται ή έχει συνδεθεί μέσω εργασίας, συνδρομής μέλους, πολιτιστικής ταυτότητας κ.λπ."],"fi":["Liittää henkilön ryhmään, johon henkilöllä on ollut yhteys työn, jäsenyyden, kulttuuri-identiteetin tms. kautta."],"fr":["Met une personne en relation avec un groupe auquel une personne est ou a été affiliée par recrutement, acquisition de la qualité de membre, identité culturelle, etc."]},"ToolkitLabel":{"ca":"afiliació","da":"tilhørsforhold","de":"Affiliation","el":"σύνδεση","es":"afiliación","fi":"viiteryhmä","fr":"affiliati