                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/printerCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50656", "lexicalAlias":"http://rdaregistry.info/Elements/a/manufacturerCollectiveAgentOf.en", "label":"is manufacturer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50179", "lexicalAlias":"http://rdaregistry.info/Elements/a/printerAgentOf.en", "label":"is printer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50803", "lexicalAlias":"http://rdaregistry.info/Elements/a/printerCorporateBodyOf.en", "label":"is printer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50954", "lexicalAlias":"http://rdaregistry.info/Elements/a/printerFamilyOf.en", "label":"is printer family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50652", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/printerCollectiveAgentOf.en", "label":"is printer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50652", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/printerCollectiveAgentOf.en", "label":"is printer collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50803","label":{"ar":"هي هيئة مسئولة عن الطباعة","ca":"és entitat corporativa impressora de","cs":"je tiskárnou (korporací) (čeho)","da":"er korporation, som er trykker af","de":"ist Körperschaft als Druckerin/Drucker von","de":"ist Körperschaft als Druckerin/Drucker von","el":"είναι τυπογράφος συλλογικό όργανο του","en":"is printer corporate body of","es":"es organismo corporativo impresor de","et":"trükkija (asutus) kehastuses","fi":"painaja (yhteisö) manifestaatiossa","fr":"est une collectivité imprimeuse de","hu":"nyomdász testülete a kö