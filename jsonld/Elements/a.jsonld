                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerAgentOf.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50477", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfManifestationOf.en", "label":"is creator agent of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50178", "lexicalAlias":"http://rdaregistry.info/Elements/a/collotyperAgentOf.en", "label":"is collotyper agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50171", "lexicalAlias":"http://rdaregistry.info/Elements/a/engraverAgentOf.en", "label":"is engraver agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50177", "lexicalAlias":"http://rdaregistry.info/Elements/a/etcherAgentOf.en", "label":"is etcher agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50175", "lexicalAlias":"http://rdaregistry.info/Elements/a/lithographerAgentOf.en", "label":"is lithographer agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50651", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerCollectiveAgentOf.en", "label":"is printmaker collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50500", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerPersonOf.en", "label":"is printmaker person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50173", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/printmakerAgentOf.en", "label":"is printmaker agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50173", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/printmakerAgentOf.en", "label":"is printmaker agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50651","label":{"ar":"هو وكيل جماعي طبّاع لـ","ca":"és agent col·lectiu gravador d’estampes de","cs":"je tiskařem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er grafiker af","de":"ist gemeinschaftlicher Akteur als Druckgrafikerin/Druckgrafiker von","de":"ist gemeinschaftlicher Akteur als Druckgrafikerin/Druckgrafiker von","el":"είναι χαράκτης συλλογικός φορέας του","en":"is printmaker collective agent of","es":"es agente colectivo grabador de","et":"graafika trükkija (kollektiiv) kehastuses","fi":"kuvalaatan valmistaja (yhteistoimija) manifestaatiossa","fr":"est un agent collectif graveur d’estampe de","hu":"nyomtatványkészítő kollektív ágense a következőnek:","it":"è incisore agente collettivo di","lv":"ir gravīru meistars (grupa)","nl":"is prentmaker-collectieve actor van","no":"er grafiker for (kollektiv agent)","tr":"baskı sanatçısı kolektif temsilcisidir","zh-Hans-CN":"是……的印版制作者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن إعداد سطح لطباعة بارزة، أو غائرة، أو مستوية."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en la fabricació d’una superfície d’impressió en relleu, gravada en profunditat o planogràfica."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost kolektivního agenta za zhotovení reliéfního, hlubotiskového nebo planografického tiskového povrchu."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for at lave en relief-, dybtryks- eller fladtryksoverflade."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für die Herstellung einer Hochdruck-, Tiefdruck- oder Flachdruckoberfläche verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für die Herstellung einer Hochdruck-, Tiefdruck- oder Flachdruckoberfläche verantwortlich ist."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for making a relief, intaglio, or planographic printing surface."],"es":["Relaciona un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de realizar una superficie de impresión en relieve, calcográfica o planográfica."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust kõrgtrüki, sügavtrüki või lametrüki teel tõmmiste tegemise eest."],"fi":["Liittää yhteistoimijan manifestaatioon, jossa yhteistoimija on vastuussa kohokuvan, syväpainon tai laakapainon painopinnan valmistamisesta."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à préparer un élément d’impression en relief, en creux ou planographique."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége egy relief, egy mélynyomásos vagy síknyomásos felület készítéséért."],"it":["Correla un agente collettivo a una manifestazione che implica una responsabilità di un agente collettivo per la realizzazione di una superficie a rilievo, intaglio o stampa planografica."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par reljefa, dobspiedes vai gludspieduma drukāšanas virsmas izveidi."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het maken van een relief, intaglio of vlakdruk oppervlak."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av å lage en overflate for relieff-, intaglio- eller plantrykk."],"tr":["Kolektif bir temsilciyi, bir kabartma, oyma veya planografik baskı yüzeyi yapma sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及制作浮雕、凹版或平版印刷表面的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي طبّاع","ca":"agent col·lectiu gravador d’