                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/inventorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50844", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfWorkOf.en", "label":"is creator corporate body of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50677", "lexicalAlias":"http://rdaregistry.info/Elements/a/inventorCollectiveAgentOf.en", "label":"is inventor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50828", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/inventorCorporateBodyOf.en", "label":"is inventor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50828", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/inventorCorporateBodyOf.en", "label":"is inventor corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50979","label":{"ar":"هي عائلة مخترعة لـ","ca":"és família inventora de","cs":"je vynálezcem (rodinou) (čeho)","da":"er familie, som er opfinder af","de":"ist Familie als Erfinderin/Erfinder von","de":"ist Familie als Erfinderin/Erfinder von","el":"είναι εφευρέτης οικογένεια του","en":"is inventor family of","es":"es familia inventora de","et":"leiutaja (perekond) teoses","fi":"keksijä (suku) teoksessa","fr":"est une famille inventrice de","hu":"feltaláló családja a következőnek:","it":"è inventore famiglia di","lv":"ir izgudrotājs (dzimta/ģimene)","nl":"is uitvinder-familie van","no":"er oppfinner av (familie)","tr":"mucit ailesidir","zh-Hans-CN":"是……的发明者家族"},"definition":{"ar":["يربط عائلة بعمل يترتب عليه مسئولية عائلة عن ابتكار جهاز أو عملية جديدة."],"ca":["Relaciona una família amb una obra que implica una responsabilitat d’una família en la creació d’un mecanisme o procés nou."],"cs":["Vztahuje rodinu k dílu, které zahrnuje odpovědnost rodiny za vytvoření nového zařízení nebo procesu."],"da":["Relaterer en familie til et værk, som involverer en families ansvar for at skabe en ny anordning eller proces."],"de":["Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.,Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist."],"en":["Relates a family to a work that involves a responsibility of a family for creating a new device or process."],"es":["Relaciona una familia con una obra que involucra una responsabilidad de una familia de crear un nuevo dispositivo o proceso."],"et":["Seostab perekonna teosega, mis sisaldab perekonna vastutust uue seadme või protsessi eest."],"fi":["Liittää suvun teokseen, jossa suku on vastuussa uuden välineen tai menetelmän luomisesta."],"fr":["Met une famille en relation avec une œuvre qui comporte une responsabilité de la part d’une famille consistant à créer un nouveau dispositif ou procédé."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyhez hozzátartozik egy család felelőssége egy új eszköz vagy eljárás létrehozásáért."],"it":["Correla una famiglia a un'opera che implica una responsabilità di una famiglia per un nuovo strumento o processo."],"lv":["Sasaista dzimtu/ģimeni ar darbu, kas ietver dzimtas/ģimenes atbildību par jaunas ierīces vai procesa radīšanu."],"nl":["Relateert een familie aan een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor het creëren van een nieuw apparaat of proces."],"no":["Relaterer en familie til et verk som involverer et ansvar for en familie i form av en ny innretning eller prosess."],"tr":["Bir aileyi, bir ailenin yeni bir cihaz veya süreç oluşturma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及创建一个新装置或新过程的一个家族的责任的一种作品关联起来。"]