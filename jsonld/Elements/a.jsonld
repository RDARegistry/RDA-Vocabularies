                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/screenwriterPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50541", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorPersonOf.en", "label":"is author person of"},{"@id":"http://rdaregistry.info/Elements/a/P50223", "lexicalAlias":"http://rdaregistry.info/Elements/a/screenwriterAgentOf.en", "label":"is screenwriter agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50532", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/screenwriterPersonOf.en", "label":"is screenwriter person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50532", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/screenwriterPersonOf.en", "label":"is screenwriter person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50222","label":{"ar":"هو وكيل نحات لـ","ca":"és agent escultor de","cs":"je sochařem (agentem) (čeho)","da":"er agent, som er skulptør af","de":"ist Akteur als Bildhauerin/Bildhauer von","de":"ist Akteur als Bildhauerin/Bildhauer von","el":"είναι γλύπτης φορέας του","en":"is sculptor agent of","es":"es agente escultor de","et":"skulptor (tegija) teoses","fi":"kuvanveistäjä (toimija) teoksessa","fr":"est un agent sculpteur de","hu":"szobrász ágense a következőnek:","it":"è scultore agente di","lv":"ir tēlnieks (aģents)","nl":"is beeldhouwer-actor van","no":"er skulptør av (agent)","tr":"heykeltıraş temsilcisidir","zh-Hans-CN":"是……的雕塑家行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن النمذجة ثلاثية الأبعاد، أو النحت، أو تقنية مماثلة."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en el modelatge, la talla o una tècnica tridimensional similar."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za trojrozměrné modelování, vyřezávání nebo podobnou techniku."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for tredimensionel modellering, udskæring eller lignende teknik."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für dreidimensionales Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für dreidimensionales Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist."],"el":["Συνδέει έναν καλλιτέχνη υπεύθυνο για τη δημιουργία ενός τρισδιάστατου έργου μέσω του μοντελισμού, της γλυπτικής ή μιας παρόμοιας τεχνικής, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for three-dimensional modeling, carving, or similar technique."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de modelar, esculpir o utilizar otra técnica similar de forma tridimensional."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust kolmemõõtmelise modelleerimise, nikerdamise või muu sellise tehnika eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à utiliser le modelage, la taille ou une technique similaire pour une œuvre tridimensionnelle."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége háromdimenziós modellezésért, faragásért vagy hasonló technikáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per la modellazione tridimensionale, scultura o tecnica simile."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par trīsdimensionālu modelēšanu, grebšanu vai līdzīgu tehniku."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor driedimensionaal modelleren, snijden of gelijksoortige techniek."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av tre-dimensjonal modellering, utskjæring eller lignende teknikker."],"tr":["Bir temsilciyi, üç boyutlu modelleme, oyma veya benzer teknik için bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及三维模型、雕刻或类似技术的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل نحات","ca":"agent escultor de","cs":"sochař (agent) (čeho)","da":"agent, som er skulptør af","de":"Akteur als Bildhauerin/Bildhauer von","de":"Akteur als Bildhauerin/Bildhauer von","el":"γλύπτης φορέας του","en":"sculptor agent of","es":"agente escultor de","et":"skulptor (tegija) teoses","fi":"kuvanveistäjä (toimija) teoksessa","fr":"agent sculpteur de","hu":"szobrász ágense:","it":"scultore agente di","lv":"ir tēlnieks (aģents)","nl":"beeldhouwer-actor van","no":"skulptør av (agent)","tr":"heykeltıraş temsilcisi","zh-Hans-CN":"……的雕塑家行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن النمذجة ثلاثية الأبعاد، أو النحت، أو تقنية مماثلة.","ca":"Obra que implica una responsabilitat d’un agent en el modelatge, la talla o una tècnica tridimensional similar.","cs":"Dílo, které zahrnuje odpovědnost agenta za trojrozměrné modelování, vyřezávání nebo podobnou techniku.","da":"Værk, som involverer en agents ansvar for tredimensionel modellering, udskæring eller lignende teknik.","de":"Ein Werk, bei dem ein Akteur für dreidimensionales Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für dreidimensionales Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.","el":"Ένα τρισδιάστατο έργο που περιλαμβάνει την καλλιτεχνική ευθύνη του μοντελισμού, της γλυπτικής ή μιας παρόμοιας τεχνικής.","en":"A work that involves a responsibility of an agent for three-dimensional modeling, carving, or similar technique.","es":"Una obra que involucra una responsabilidad de un agente de modelar, esculpir o utilizar otra técnica similar de forma tridimensional.","et":"Teos, mis sisaldab tegija vastutust kolmemõõtmelise modelleerimise, nikerdamise või muu sellise tehnika eest.","fi":"Teos, jossa toimija on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à utiliser le modelage, la taille ou une technique similaire pour une œuvre tridimensionnelle.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége háromdimenziós modellezésért, faragásért vagy hasonló technikáért.","it":"Opera che implica la responsabilità di un agente per la modellazione tridimensionale, scultura o tecnica simile.","lv":"Darbs, kas ietver aģenta atbildību par trīsdimensionālu modelēšanu, grebšanu vai līdzīgu tehniku.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor driedimensionaal modelleren, snijden of gelijksoortige techniek.","no":"Et verk som involverer ansvar for en agent i form av tre-dimensjonal modellering, utskjæring eller lignende teknikker.","tr":"Üç boyutlu modelleme, oyma veya benzeri bir teknik için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及三维模型、雕刻或类似技术的一个行为者的责任的一种作品"},"altLabel":{"ar":["نحات"],"ca":["escultor de"],"cs":["sochař (čeho)"],"da":["billedhugger af"],"de":["Bildhauer von,Bildhauer von"],"el":["γλύπτης του"],"en":["sculptor of"],"es":["escultor de"],"et":["skulptor teoses"],"fi":["kuvanveistäjänä teoksessa"],"fr":["sculpteur de"],"hu":["szobrásza:"],"it":["scultore di"],"nl":["beeldhouwer van"],"no":["skulptør av"],"tr":["heykeltıraş"],"zh-Hans-CN":["……的雕塑家"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
