                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/audioProducerAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50201", "lexicalAlias":"http://rdaregistry.info/Elements/a/producerAgentOf.en", "label":"is producer agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50698", "lexicalAlias":"http://rdaregistry.info/Elements/a/audioProducerCollectiveAgentOf.en", "label":"is audio producer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50547", "lexicalAlias":"http://rdaregistry.info/Elements/a/audioProducerPersonOf.en", "label":"is audio producer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50295", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/audioProducerAgentOf.en", "label":"is audio producer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50295", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/audioProducerAgentOf.en", "label":"is audio producer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50698","label":{"ar":"هو وكيل جماعي منتج مواد صوتية لـ","ca":"és agent col·lectiu productor d’àudio de","cs":"je producentem zvukového záznamu (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er lydproducer af","de":"ist gemeinschaftlicher Akteur als Produzentin/Produzent einer Tonaufnahme von","de":"ist gemeinschaftlicher Akteur als Produzentin/Produzent einer Tonaufnahme von","el":"είναι παραγωγός ήχου συλλογικός φορέας του","en":"is audio producer collective agent of","es":"es agente colectivo productor de audio de","et":"audioprodutsent (kollektiiv) teoses","fi":"äänituottaja (yhteistoimija) teoksessa","fr":"est un agent collectif producteur audio de","hu":"audio-producer kollektív ágense a következőnek:","it":"è produttore audio agente collettivo di","lv":"ir skaņu ierakstu producents (grupa)","nl":"is geluidsproducent-collectieve actor van","no":"er lydprodusent for (kollektiv agent)","tr":"ses yapımcısı kolektif temsilcisidir","zh-Hans-CN":"是……的音频制作者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن إدارة معظم جوانب الأعمال التجارية للتسجيل الصوتي."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la gestió de la majoria dels aspectes comercials d’un enregistrament àudio."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za řízení většiny obchodních aspektů zvukového záznamu."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for managing most of the business aspects of an audio recording."],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de gestionar la mayoría de los aspectos comerciales de una grabación de audio."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust helisalvestuse enamiku äriliste aspektide korraldamise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à gérer la majeure partie des aspects commerciaux d’un enregistrement audio."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy audiofelvétel legtöbb üzleti vonatkozásának menedzseléséért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo nella gestione della maggior parte degli aspetti commerciali di una registrazione audio."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par lielāko daļu skaņu ieraksta biznesa aspektiem."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å håndtere de fleste forretningsmessige aspektene ved et lydopptak."],"tr":["Kolektif bir temsilciyi, bir ses kaydının ticari yönlerinin çoğunu yönetmek için kollektif bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及音频录制工作大多数方面之管理的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي منتج مواد صوتية","ca":"agent col·lectiu productor d’àudio de","cs":"producent zvukového záznamz (kolektivní agent) (čeho)","da":"kollektiv agent, som er lydproducer af","de":"Gemeinschaftlicher Akteur als Produzent einer Tonaufnahme von","de":"Gemeinschaftlicher Akteur als Produzent einer Tonaufnahme von","el":"παραγωγός ήχου συλλογικός φορέας του","en":"audio producer collective agent of","es":"agente colectivo productor de audio de","et":"audioprodutsent (kollektiiv) teoses","fi":"äänituottaja (yhteistoimija) teoksessa","fr":"agent collectif producteur audio de","hu":"audio-producer kollektív ágense:","it":"produttore audio agente collettivo di","lv":"ir skaņu ierakstu producents (grupa)","nl":"geluidsproducent-collectieve actor van","no":"lydprodusent for (kollektiv agent)","tr":"ses yapımcısı kolektif temsilci","zh-Hans-CN":"……的音频制作者集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن إدارة معظم جوانب الأعمال التجارية للتسجيل الصوتي.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za řízení většiny obchodních aspektů zvukového záznamu.","da":"Værk, som involverer en kollektiv agents ansvar for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for managing most of the business aspects of an audio recording.","es":"Una obra que implica la responsabilidad de un agente colectivo de gestionar la mayoría de los aspectos comerciales de una grabación de audio.","et":"Teos, mis sisaldab kollektiivi vastutust helisalvestuse enamiku äriliste aspektide korraldamise eest.","fi":"Teos, jossa yhteistoimija on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à gérer la majeure partie des aspects commerciaux d’un enregistrement audio.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége egy audiofelvétel legtöbb üzleti vonatkozásának menedzseléséért.","it":"Opera che implica una responsabilità di un agente collettivo nella gestione della maggior parte degli aspetti commerciali di una registrazione audio.","lv":"Darbs, kas ietver grupas atbildību par lielāko daļu skaņu ieraksta biznesa aspektiem.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av å håndtere de fleste forretningsmessige aspektene ved et lydopptak.","tr":"Bir ses kaydının ticari yönlerinin çoğunu yönetmek için kollektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及音频录制工作大多数方面之管理的一个集体行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
