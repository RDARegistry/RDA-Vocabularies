                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50561", "lexicalAlias":"http://rdaregistry.info/Elements/a/directorPersonOf.en", "label":"is director person of"},{"@id":"http://rdaregistry.info/Elements/a/P50049", "lexicalAlias":"http://rdaregistry.info/Elements/a/radioDirectorAgentOf.en", "label":"is radio director agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50563", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/radioDirectorPersonOf.en", "label":"is radio director person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50563", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/radioDirectorPersonOf.en", "label":"is radio director person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50214","label":{"ar":"هو وكيل منتج إذاعي لـ","ca":"és agent productor radiofònic de","cs":"je rozhlasovým producentem (agentem) (čeho)","da":"er agent, som er radioproducer af","de":"ist Akteur als Hörfunkproduzentin/Hörfunkproduzent von","de":"ist Akteur als Hörfunkproduzentin/Hörfunkproduzent von","el":"είναι ραδιοφωνικός παραγωγός φορέας του","en":"is radio producer agent of","es":"es agente productor de radio de","et":"raadioprodutsent (tegija) teoses","fi":"radiotuottaja (toimija) teoksessa","fr":"est un agent producteur de radio de","hu":"rádióproducer ágense a következőnek:","it":"è produttore radiofonico agente di","lv":"ir radio raidījuma producents (aģents)","nl":"is radioproducent-actor van","no":"er radioprodusent for (agent)","tr":"radyo yapımcısı temsilcisidir","zh-Hans-CN":"是……的广播制作人行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن معظم الجوانب التجارية لإنتاج برنامج إذاعي."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la majoria dels aspectes comercials de la producció d’un programa radiofònic."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za většinu obchodních aspektů výroby rozhlasového programu."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for størstedelen af de forretningsmæssige aspekter ved et radioprogram."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist."],"el":["Συνδέει έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές ενός ραδιοφωνικού προγράμματος, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for most of the business aspects of the production of a radio program."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente para la mayoría de los aspectos comerciales de la producción de un programa de radio."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust enamiku äriliste aspektide eest raadiosaate tootmisel."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa suurimmasta osasta radio-ohjelman liiketoimintaa."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne la majeure partie des aspects commerciaux de la production d’une émission de radio."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy rádióműsor legtöbb üzleti vonatkozásáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per la maggior parte degli aspetti commerciali della produzione di un programma radiofonico."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par radio raidījuma darbības/biznesa aspektiem."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het merendeel van de zakelijke aspecten van het produceren van een radioprogramma."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av de fleste forretningsmessige aspektene ved produksjon av et radioprogram."],"tr":["Bir temsilciyi, bir radyo programı yapımının çoğu ticari yönüne ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及广播节目制作的大部分商业运作的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل منتج إذاعي لـ","ca":"agent productor radiofònic de","cs":"rozhlasový producent (agent) (čeho)","da":"agent, som er radioproducer af","de":"Akteur als Hörfunkproduzentin/Hörfunkproduzent von","de":"Akteur als Hörfunkproduzentin/Hörfunkproduzent von","el":"ραδιοφωνικός παραγωγός φορέας του","en":"radio producer agent of","es":"agente productor de radio de","et":"raadioprodutsent (tegija) teoses","fi":"radiotuottaja (toimija) teoksessa","fr":"agent producteur de radio de","hu":"rádióproducer ágense:","it":"produttore radiofonico agente di","lv":"ir radio raidījuma producents (aģents)","nl":"radioproducent-actor van","no":"radioprodusent for (agent)","tr":"radyo yapımcısı temsilcisi","zh-Hans-CN":"……的广播制作人行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن معظم الجوانب التجارية لإنتاج برنامج إذاعي.","ca":"Obra que implica una responsabilitat d’un agent en la majoria dels aspectes comercials de la producció d’un programa radiofònic.","cs":"Dílo, které zahrnuje odpovědnost agenta za většinu obchodních aspektů výroby rozhlasového programu.","da":"Værk, som involverer en agents ansvar for størstedelen af de foretningsmæssige aspekter ved et radioprogram.","de":"Ein Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.","el":"Ένα έργο που περιλαμβάνει την ευθύνη της παραγωγής για τις περισσότερες επιχειρηματικές πτυχές ενός ραδιοφωνικού προγράμματος.","en":"A work that involves a responsibility of an agent for most of the business aspects of the production of a radio program.","es":"Una obra que involucra una responsabilidad de un agente para la mayoría de los aspectos comerciales de la producción de un programa de radio.","et":"Teos, mis sisaldab tegija vastutust enamiku äriliste aspektide eest raadiosaate tootmisel.","fi":"Teos, jossa toimija on vastuussa suurimmasta osasta radio-ohjelman liiketoimintaa.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne la majeure partie des aspects commerciaux de la production d’une émission de radio.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy rádióműsor legtöbb üzleti vonatkozásáért.","it":"Opera che implica la responsabilità di un agente per la maggior parte degli aspetti commerciali della produzione di un programma radiofonico.","lv":"Darbs, kas ietver aģenta atbildību par radio raidījuma darbības/biznesa aspektiem.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het merendeel van de zakelijke aspecten van het produceren van een radioprogramma.","no":"Et verk som involverer ansvar for en agent i form av de fleste forretningsmessige aspektene ved produksjon av et radioprogram.","tr":"Bir radyo programının yapımının ticari yönlerinin çoğu için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及广播节目制作的大部分商业运作的一个行为者的责任的一种作品"},"altLabel":{"ar":["منتج إذاعي لـ"],"ca":["productor radiofònic de"],"cs":["rozhlasový producent (čeho)"],"da":["radioproducer af"],"de":["Hörfunkproduzent von,Hörfunkproduzent von"],"el":["ραδιοφωνικός παραγωγός του"],"en":["radio producer of"],"es":["productor de radio de"],"et":["raadioprodutsent teoses"],"fi":["tuottajana radio-ohjelmassa"],"fr":["producteur de radio de"],"h