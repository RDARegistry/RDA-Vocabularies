                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/localAffiliate.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50336", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfCorporateBody.en", "label":"has related corporate body of corporate body"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50241", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/localAffiliate.en", "label":"has local affiliate"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50241", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/localAffiliate.en", "label":"has local affiliate"}]},{"@id":"http://rdaregistry.info/Elements/a/P50059","label":{"ar":"له لقب شرف متوارث","ca":"té com a terme honorífic hereditari","cs":"má dědičný titul","da":"har nedarvet æresbevisning","de":"hat Erbtitel","de":"hat Erbtitel","el":"έχει κληρονομικό όρο τιμής","en":"has hereditary term of honour","es":"tiene término honorífico hereditario","et":"pärilik tiitel","fi":"periytyvä arvonimi","fr":"a pour terme d’honneur héréditaire","hu":"hódolat örökletes kifejezése a következő:","it":"ha come titolo ereditario d'onore","lv":"pārmantotais tituls","nl":"heeft erfelijke term van eer","no":"har arvet hedersbetegnelse","sv":"har ärvd titel","tr":"aileye ait soyluluk unvanı ile ilişkilidir","zh-Hans-CN":"有世袭荣誉称号"},"definition":{"ar":["يربط عائلة بكلمة أو عبارة تدل على الملكية والنبالة الخ، مرتبطة بعائلة."],"ca":["Relaciona una família amb una paraula o frase indicativa de reialesa, noblesa, etc., associada amb una família."],"cs":["Vztahuje rodinu ke slovu nebo frázi označující královský rod, šlechtu atd. spojené s rodinou."],"da":["Relaterer en familie til et ord eller udtryk, som indikerer kongeslægt, adelslægt etc., som er knyttet til en familie."],"de":["Setzt eine Familie in Beziehung zu einem Wort oder einer Phrase, das/die mit einer Familie in Verbindung steht und auf die Zugehörigkeit zu einem Fürstentum, zum Adel und so weiter hinweist.,Setzt eine Familie in Beziehung zu einem Wort oder einer Phrase, das/die mit einer Familie in Verbindung steht und auf die Zugehörigkeit zu einem Fürstentum, zum Adel und so weiter hinweist."],"el":["Συνδέει μια οικογένεια με έναν τίτλο ευγενείας κ.λπ. συνδεδεμένο με μια οικογένεια."],"en":["Relates a family to a word or phrase indicative of royalty, nobility, etc., associated with a family."],"es":["Relaciona una familia con una palabra o frase indicativa de la realeza, nobleza, etc., asociada con una familia."],"et":["Seostab perekonna sõna või väljendiga, mis näitab perekonna kuninglikku seisust, aadliseisust vms."],"fi":["Liittää suvun sanaan tai ilmaukseen, joka osoittaa suvun kuninkaallista, aatelis- tms. arvoa."],"fr":["Met une famille en relation avec un mot ou une locution qui indique la royauté, la noblesse, etc. et qui est associé à une famille."],"hu":["Hozzákapcsol egy családot egy szóhoz vagy kifejezéshez, amely társulva egy családdal, királyi, nemesi stb. címre utal."],"it":["Correla una famiglia a una parola o frase indicativa di regalità, nobiltà, etc. associata a una famiglia."],"lv":["Sasaista dzimtu/ģimeni ar vārdu vai frāzi, kas norāda uz aristokrātiju u.tml., kas saistīts ar dzimtu/ģimeni."],"nl":["Relateert een familie aan een woord of uitdrukking wijzend op koningschap, adel etc, geassocieerd met een familie."],"no":["Relaterer en familie til et ord eller en frase som antyder tilknytning til kongehus, adel etc. som forbindes med en familie."],"tr":["Bir aileyi, bir aileyle ilişkili kraliyet, soyluluk vb. gösteren bir kelime veya anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与表示皇室、贵族等与家族相关的一个单词或短语关联起来。"]},"ToolkitLabel":{"ar":"لقب شرف متوارث","ca":"terme honorífic hereditari","cs":"dědičný titul","da":"nedarvet æresbevisning","de":"Erbtitel","de":"Erbtitel","el":"κληρονομικός όρος τιμής","en":"hereditary term of honour","es":"término honorífico hereditario","et":"pärilik tiitel","fi":"periytyvä arvonimi","fr":"terme d’honneur héréditaire","hu":"hódolat örökletes kifejezése:","it":"titolo ereditario d'onore","lv":"pārmantotais tituls","nl":"erfelijke term van eer","no":"arvet hedersbetegnelse","sv":"ärvd titel","tr":"soyluluk unvanı ile ilişkilidir","zh-Hans-CN":"世袭荣誉称号"},"ToolkitDefinition":{"ar":"كلمة أو عبارة تدل على الملكية والنبالة الخ، مرتبطة بعائلة.","ca":"Paraula o frase indicativa de reialesa, noblesa, etc., associada amb una família.","cs":"Slovo nebo fráze označující královský rod, šlechtu atd. spojené s rodinou.","da":"Ord eller udtryk, som indikerer kongeslægt, adelslægt etc., som er knyttet til en familie.","de":"Ein Wort oder eine Phrase, das/die mit einer Familie in Verbindung steht und auf die Zugehörigkeit zu einem Fürstentum, zum Adel und so weiter hinweist.","de":"Ein Wort oder eine Phrase, das/die mit einer Familie in Verbindung steht und auf die Zugehörigkeit zu einem Fürstentum, zum Adel und so weiter hinweist.","el":"Ένας τίτλος ευγενείας κ.λπ. συνδεδεμένος με μια οικογένεια.","en":"A word or phrase indicative of royalty, nobility, etc., associated with a family.","es":"Una palabra o frase indicativa de la realeza, nobleza, etc., asociada con una familia.","et":"Sõna või väljend, mis näitab perekonna kuninglikku seisust, aadliseisust vms.","fi":"Sana tai ilmaus, joka osoittaa suvun kuninkaallista, aatelis- tms. arvoa.","fr":"Mot ou locution qui indique la royauté, la noblesse, etc. et qui est associé à une famille.","hu":"Egy szó vagy kifejezés, amely társulva egy családdal, királyi, nemesi stb. címre utal.","it":"Parola o frase indicativa di regalità, nobiltà, etc. associata a una famiglia.","lv":"Vārds vai frāze, kas norāda uz aristokrātiju u.tml., kas saistīts ar dzimtu/ģimeni.","nl":"Een woord of uitdrukking wijzend op koningschap, adel etc, geassocieerd met een familie.","no":"Et ord eller en frase som antyder tilknytning til kongehus, adel etc. som forbindes med en familie.","tr":"Bir aileyle bağlantılı olan kraliyet, soyluluk vb. gösteren bir kelime veya ifade.","zh-Hans-CN":"表示皇室、贵族等与家族相关的一个单词或短语"},"altLabel":{"ar":["لقب شرف متوارث"],"ca":[","],"cs":[","],"da":["arvelig æresperiode"],"de":[",Erbtitel"],"en":["hereditary title,hereditary term of honor"],"es":["título hereditario,término honorífico hereditario"],"fi":[","],"fr":["terme honorifique héréditaire,titre héréditaire"],"hu":[","],"nl":["erfelijke titel,erfelijke titel van eer"],"tr":["aileye ait soyluluk unvanı,aileye ait soyluluk unvanı"],"zh-Hans-CN":["世袭头衔,世袭荣誉称号"],"zh-Hant-TW":[","]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
