                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfCorporateBody.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50388", "lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfCollectiveAgent.en", "label":"has field of activity of collective agent"}],"instructionNumber":"11.1","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50022", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/fieldOfActivityOfCorporateBody.en", "label":"has field of activity of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50022", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/fieldOfActivityOfCorporateBody.en", "label":"has field of activity of corporate body"}]},{"@id":"http://rdaregistry.info/Elements/a/P50236","label":{"ar":"له فترة نشاط هيئة","ca":"té com a període d’activitat d’una entitat corporativa","cs":"má dobu činnosti korporace","da":"har aktivitetsperiode for korporation","de":"hat Wirkungszeitraum einer Körperschaft","de":"hat Wirkungszeitraum einer Körperschaft","el":"έχει περίοδο της δραστηριοποίησης του συλλογικού οργάνου","en":"has period of activity of corporate body","es":"tiene periodo de actividad de organismo corporativo","et":"asutuse tegutsemisaeg","fi":"yhteisön toiminta-aika","fr":"a pour période d’activité d’une collectivité","hu":"testület tevékenységiének időszaka a következő:","it":"ha come periodo di attività di ente","lv":"institūcijas darbības periods","nl":"heeft periode van activiteit van corporatie","no":"har periode for aktivitet for korporasjon","sv":"har verksamhetstid för institutionen","tr":"tüzel kişinin faaliyet dönemi ile ilişkilidir","zh-Hans-CN":"有团体的活跃期"},"definition":{"ar":["يربط هيئة بفترة زمنية كانت الهيئة خلالها نشطة في مجال عملها الأساسي."],"ca":["Relaciona una entitat corporativa amb un interval de temps durant el qual una entitat corporativa està en actiu en el seu camp d’activitat principal."],"cs":["Vztahuje korporaci k časovému období, ve kterém je korporace činná ve svém hlavním oboru činnosti."],"da":["Relaterer en korporation til en tidsperiode, hvori en korporation er aktiv i sit primære virkefelt."],"de":["Setzt eine Körperschaft in Beziehung zu einem Zeitraum, in dem eine Körperschaft in ihrem primären Tätigkeitsfeld aktiv ist.,Setzt eine Körperschaft in Beziehung zu einem Zeitraum, in dem eine Körperschaft in ihrem primären Tätigkeitsfeld aktiv ist."],"el":["Συνδέει ένα συλλογικό όργανο με μια χρονολογία ή εύρος χρονολογιών ενδεικτικών της περιόδου κατά την οποία ήταν ενεργό ένα συλλογικό όργανο."],"en":["Relates a corporate body to a timespan during which a corporate body is active in its primary field of endeavor."],"es":["Relaciona un organismo corporativo con un espacio de tiempo durante el cual un organismo corporativo está activo en su área primaria de desempeño."],"et":["Seostab asutuse ajavahemikuga, millal asutus on olnud oma peamisel tegevusalal aktiivne."],"fi":["Liittää yhteisön ajanjaksoon, jonka aikana yhteisö on ollut aktiivinen ensisijaisella toiminta-alallaan."],"fr":["Met une collectivité en relation avec un laps de temps pendant lequel une collectivité est active dans son principal champ d’activité."],"hu":["Hozzákapcsol egy testületet egy időtartamhoz, amely alatt egy testület fő működési területén aktív."],"it":["Correla un ente a un arco di tempo nel quale un ente è attivo nel suo principale campo di impegno."],"lv":["Sasaista institūciju ar laikposmu, kurā institūcija ir aktīva savā darbības jomā."],"nl":["Relateert een corporatie aan een tijdspanne gedurende welke een corporatie actief is in haar primaire werkveld."],"no":["Relaterer en korporasjon til et tidsrom hvor en korporasjon er aktiv innenfor sitt hovedvirkeområde."],"tr":["bir tüzel kişiyi, kendi öncelikli çalışma alanında uğraşma etkinliği sırasında bir zaman aralığı bir tüzel kişi ile ilgilidir."],"zh-Hans-CN":["将一个团体与一个团体在其主要努力领域活跃的时间段关联起来。"]},"ToolkitLabel":{"ar":"فترة نشاط الهيئة","ca":"període d’activitat d’una entitat corporativa","cs":"doba činnosti korporace","da":"aktivitetsperiode for korporation","de":"Wirkungszeitraum einer Körperschaft","de":"Wirkungszeitraum einer Körperschaft","el":"περίοδος της δραστηριοποίησης του συλλογικού οργάνου","en":"period of activity of corporate body","es":"periodo de actividad de organismo corporativo","et":"asutuse tegutsemisaeg","fi":"yhteisön toiminta-aika","fr":"période d’activité d’une collectivité","hu":"testület tevékenységének időszaka:","it":"periodo di attività di ente","lv":"institūcijas darbības periods","nl":"periode van activiteit van corporatie","no":"periode for aktivitet for korporasjon","sv":"verksamhetstid för institutionen","tr":"tüzel kişinin faaliyet süresi","zh-Hans-CN":"团体的活跃期"},"ToolkitDefinition":{"ar":"فترة زمنية كانت الهيئة خلالها نشطة في مجال عملها الأساسي.","ca":"Interval de temps durant el qual una entitat corporativa està en actiu en el seu camp d’activitat principal.","cs":"Časové období, ve kterém je korporace činná ve svém hlavním oboru činnosti.","da":"Tidsperiode, hvori en korporation er aktiv i sit primære virkefelt.","de":"Ein Zeitraum, in dem eine Körperschaft in ihrem primären Tätigkeitsfeld aktiv ist.","de":"Ein Zeitraum, in dem eine Körperschaft in ihrem primären Tätigkeitsfeld aktiv ist.","el":"Μια χρονολογία ή εύρος χρονολογιών ενδεικτικών της περιόδου κατά την οποία ένα συλλογικό όργανο έδρασε/ήταν ενεργό.","en":"A timespan during which a corporate body is active in its primary field of endeavor.","es":"Un espacio de tiempo durante el cual un organismo corporativo está activo en su área primaria de desempeño.","et":"Ajavahemik, millal asutus on olnud oma peamisel tegevusalal aktiivne.","fi":"Ajanjakso, jonka aikana yhteisö on ollut aktiivinen ensisijaisella toiminta-alallaan.","fr":"Laps de temps pendant lequel une collectivité est active dans son principal champ d’activité.","hu":"Egy időtartam, amely alatt egy testület fő működési területén aktív.","it":"Arco di tempo nel quale un ente è attivo nel suo principale campo di impegno.","lv":"Laikposms, kurā institūcija ir aktīva savā darbības jomā.","nl":"Een tijdspanne gedurende welke een corporatie actief is in haar primaire werkveld.","no":"Et tidsrom hvor en korporasjon er aktiv innenfor sitt hovedvirkeområde.","tr":"Bir tüzel kişiliğin, asıl faaliyet alanında aktif olduğu bir zaman aralığı.","zh-Hans-CN":"一个团体在其主要努力领域活跃的时间段"},"altLabel":{"fi":["yhteisön toimintaan liittyvä ajanjakso"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
