                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/dedicatorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50844", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfWorkOf.en", "label":"is creator corporate body of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50717", "lexicalAlias":"http://rdaregistry.info/Elements/a/dedicatorCollectiveAgentOf.en", "label":"is dedicator collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50868", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/dedicatorCorporateBodyOf.en", "label":"is dedicator corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50868", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/dedicatorCorporateBodyOf.en", "label":"is dedicator corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51019","label":{"ar":"هي عائلة مسئولة عن إهداء كتاب لـ","ca":"és família dedicant de","cs":"je dedikátorem (rodinou) (čeho)","da":"er familie, som er dedikationsskriver af","de":"ist Familie als Widmende/Widmender von","de":"ist Familie als Widmende/Widmender von","el":"είναι αφιερωτής οικογένεια του","en":"is dedicator family of","es":"es familia dedicadora de","et":"pühendaja (perekond) teoses","fi":"omistuskirjoituksen tekijä (suku) teoksessa","fr":"est une famille dédicatrice d’une œuvre de","hu":"dedikáló családja a következőnek:","it":"è dedicante famiglia di","lv":"ir darba veltītājs (dzimta/ģimene)","nl":"is opdrager-familie van","no":"er dediserende familie av","tr":"ithaf eden ailesidir","zh-Hans-CN":"是……的题献者家族"},"definition":{"ar":["يربط عائلة بعمل تم تعيينه كإقرار بالإلهام أو الدعم لعائلة مرتبطة ."],"ca":["Relaciona una família amb una obra que s’assigna com a reconeixement per la inspiració o suport d’una família relacionada."],"cs":["Vztahuje rodinu k dílu, v němž je uvedeno ocenění inspirace nebo podpory od související rodiny."],"da":["Relaterer en familie til et værk, som er tilegnet en relateret familie, som en anerkendelse af inspiration eller støtte."],"de":["Setzt eine Familie in Beziehung zu einem Werk, das als Zeichen der Anerkennung oder Unterstützung einer in Beziehung stehenden Familie gewidmet ist.,Setzt eine Familie in Beziehung zu einem Werk, das als Zeichen der Anerkennung oder Unterstützung einer in Beziehung stehenden Familie gewidmet ist."],"en":["Relates a family to a work that is assigned as an acknowledgment of the inspiration or support of a related family."],"es":["Relaciona una familia con una obra asignada como un reconocimiento a la inspiración o apoyo de una familia relacionada."],"et":["Seostab perekonna teosega, mille seotud perekond on pühendanud kellelegi tänuavaldusena innustuse või toetuse eest."],"fi":["Liittää suvun teokseen, joka on omistettu sitä innoittaneelle tai tukeneelle suvulle."],"fr":["Met une famille en relation avec une œuvre qui est dédiée en reconnaissance de l’inspiration ou du soutien d’une famille en relation."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyet egy műhöz kapcsolódó család ösztönzésének vagy támogatásának köszöneteként jelölnek meg."],"it":["Correla una famiglia a un'opera assegnata come riconoscimento dell'ispirazione o supporto di una famiglia correlata."],"lv":["Sasaista dzimtu/ģimeni ar darbu, kas ir veltīts pateicībā par saistītās dzimtas/ģimenes iedvesmojumu vai atbalstu."],"nl":["Relateert een familie aan een werk dat toegekend is als erkenning van de inspiratie of hulp van een gerelateerde familie."],"no":["Relaterer en familie til et verk som er tilegnet som en anerkjennelse for inspirasjonen eller støtten fra en relatert familie."],"tr":["Bir aileyi, ilgili bir ailenin ilhamı veya desteğini tanıma olarak atanan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与被指定对一个相关家族的启发或支持之感谢的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عائلة مسئولة عن إهداء كتاب","ca":"família dedicant de","cs":"dedikátor (rodina) (čeho)","da":"familie, som er dedikationsskriver af","de":"Familie als Widmende/Widmender von","de":"Familie als Widmende/Widmender von","el":"αφιερωτής οικογένεια του","en":"dedicator family of","es":"familia dedicadora de","et":"pühendaja (perekond) teoses","fi":"omistuskirjoituksen tekijä (suku) teoksessa","fr":"famille dédicatrice d’une œuvre de","hu":"dedikáló családja:","it":"dedicante famiglia di","lv":"ir darba veltītājs (dzimta/ģimene)","nl":"opdrager-familie van","no":"dediserende familie av","tr":"adayan aile","zh-Hans-CN":"……的题献者家族"},"ToolkitDefinition":{"ar":"عمل تم تخصيصه كإقرار بالإلهام أو الدعم لعائلة مرتبطة .","ca":"Obra que s’assigna com a reconeixement per la inspiració o suport d’una família relacionada.","cs":"Dílo, v němž je uvedeno ocenění inspirace nebo podpory od související rodiny.","da":"Værk, som er tilegnet en relateret familie, som en anerkendelse af inspiration eller støtte.","de":"Ein Werk, das als Zeichen der Anerkennung oder Unterstützung einer in Beziehung stehenden Familie gewidmet ist.","de":"Ein Werk, das als Zeichen der Anerkennung oder Unterstützung einer in Beziehung stehenden Familie gewidmet ist.","en":"A work that is assigned as an acknowledgment of the inspiration or support of a related family.","es":"Una obra asignada como un reconocimiento a la inspiración o apoyo de una familia relacionada.","et":"Teos, mille seotud perekond on pühendanud kellelegi tänuavaldusena innustuse või toetuse eest.","fi":"Teos, joka on omistettu sitä innoittaneelle tai tukeneelle suvulle.","fr":"Œuvre qui est dédiée en reconnaissance de l’inspiration ou du soutien d’une famille en relation.","hu":"Egy mű, amelyet egy műhöz kapcsolódó család ösztönzésének vagy támogatásának köszöneteként jelölnek meg.","it":"Opera assegnata come riconoscimento dell'ispirazione o supporto di una famiglia correlata.","lv":"Darbs, kas ir veltīts pateicībā par saistītās dzimtas/ģimenes iedvesmojumu vai atbalstu.","nl":"Een werk dat toegekend is als erkenning van de inspiratie of hulp van een gerelateerde familie.","no":"Et verk som er tilegnet som en anerkjennelse for inspirasjonen eller støtten fra en relatert familie.","tr":"İlgili bir ailenin ilhamının veya desteğinin bir teşekkürü olarak atanan bir eser.","zh-Hans-CN":"被指定对一个相关家族的启发或支持之感谢的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
