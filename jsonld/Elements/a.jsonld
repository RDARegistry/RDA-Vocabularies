                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/librettistFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50994", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorFamilyOf.en", "label":"is author family of"},{"@id":"http://rdaregistry.info/Elements/a/P50685", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistCollectiveAgentOf.en", "label":"is librettist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50987", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/librettistFamilyOf.en", "label":"is librettist family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50987", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/librettistFamilyOf.en", "label":"is librettist family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50534","label":{"ar":"هو شخص واضع كلمات الأوبرا لـ","ca":"és persona llibretista de","cs":"je libretistou (osobou) (čeho)","da":"er person, som er librettist af","de":"ist Person als Librettistin/Librettist von","de":"ist Person als Librettistin/Librettist von","el":"είναι λιμπρετίστας φυσικό πρόσωπο του","en":"is librettist person of","es":"es libretista de","et":"libretist (isik) teoses","fi":"libretisti (henkilö) teoksessa","fr":"est une personne librettiste de","hu":"librettista személye a következőnek:","it":"è librettista persona di","lv":"ir libretists (persona)","nl":"is librettist-persoon van","no":"er librettist for (person)","tr":"libretto yazarı kişisidir","zh-Hans-CN":"是……的台本作者个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن تأليف كلمات الأوبرا أو غيرها من أعمال المسرح الموسيقي، أو موشحات دينية"],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for authoring the words of an opera or other musical stage work, or an oratorio."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona por la autoría de las palabras de una ópera u otra obra escénica musical, o un oratorio."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å være forfatter av ordene i en opera eller annet verk for en musikalsk scene, eller et oriatorium."],"tr":["Bir kişiyi, bir operanın veya başka bir müzikalin veya bir oratoryonun yazma sorumluluğunu içeren bir eserle ilişkilendirir"],"zh-Hans-CN":["将一个个人与涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص واضع كلمات الأوبرا","ca":"persona llibretista de","cs":"libretista (osoba) (čeho)","da":"person, som er librettist af","de":"Person als Librettistin/Librettist von","de":"Person als Librettistin/Librettist von","el":"λιμπρετίστας φυσικό πρόσωπο του","en":"librettist person of","es":"libretista de","et":"libretist (isik) teoses","fi":"libretisti (henkilö) teoksessa","fr":"personne librettiste de","hu":"librettista személye:","it":"librettista persona di","lv":"ir libretists (persona)","nl":"librettist-persoon van","no":"librettist for (person)","tr":"Opera metni yazarı","zh-Hans-CN":"……的台本作者个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن تأليف كلمات الأوبرا أو غيرها من أعمال المسرح الموسيقي، أو موشحات دينية.","ca":"Obra que implica una responsabilitat d’una persona en l’autoria de les paraules d’una òpera o una altra obra escènica musical o d’un oratori.","cs":"Dílo, které zahrnuje odpovědnost osoby za autorství textu opery nebo jiného díla pro hudební scénu nebo oratoria.","da":"Værk, som involverer en persons ansvar for at forfatte ordene til en opera eller andet musikalsk sceneværk eller et oratorium.","de":"Ein Werk, bei dem eine Person für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","de":"Ein Werk, bei dem eine Person für das Verfassen des Texts einer Oper, eines sonstigen Bühnenwerks oder eines Oratoriums verantwortlich ist.","en":"A work that involves a responsibility of a person for authoring the words of an opera or other musical stage work, or an oratorio.","es":"Una obra que implica la responsabilidad de una persona por la autoría de las palabras de una ópera u otra obra escénica musical, o un oratorio.","et":"Teos, mis sisaldab isiku vastutust ooperi või muu muusikalise lavateose või oratooriumi sõnade kirjutamise eest.","fi":"Teos, jossa henkilö on vastuussa musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à être l’auteur des paroles d’un opéra ou d’une autre œuvre musicale scénique ou d’un oratorio.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy opera vagy más zenés színpadi mű vagy egy oratórium szövegének szerzőségéért.","it":"Opera che implica una responsabilità di una persona come autore dei testi di un'opera lirica, altra opera musicale da palcoscenico o oratorio.","lv":"Darbs, kas ietver personas atbildību par tekstu operai vai citam muzikālam skatuves darbam, vai oratorijai.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor schrijven van de woorden van een opera of ander muzikaal podiumwerk of een oratorium.","no":"Et verk som involverer et ansvar for en person i form av å være forfatter av ordene i en opera eller annet verk for en musikalsk scene, eller et oriatorium.","tr":"Bir opera veya diğer müzikal sahne eserinin veya bir oratoryonun sözlerinin yazılmasında bir kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及歌剧或其他舞台音乐作品或者清唱剧的词的写作的一个个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/librettistPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50541", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorPersonOf.en", "label":"is author person of"},{"@id":"http://rdaregistry.info/Elements/a/P50225", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistAgentOf.en", "label":"is librettist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50534", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/librettistPersonOf.en", "label":"is librettist person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50534", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/librettistPersonOf.en", "label":"is librettist person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50256","label":{"ar":"هو وكيل مصمم إضاءة لـ","ca":"és agent dissenyador d’il·luminació de","cs":"je designérem osvětlení (agentem) (čeho)","da":"er agent, som er belysningsdesigner af","de":"ist Akteur als Lichtgestalterin/Lichtgestalter von","de":"ist Akteur als Lichtgestalterin/Lichtgestalter von","el":"είναι σχεδιαστής φωτισμού φορέας του","en":"is lighting designer agent of","es":"es agente diseñador de iluminación de","et":"valguskujundaja (tegija) väljenduses","fi":"valosuunnittelija (toimija) ekspressiossa","fr":"est un agent éclairagiste de","hu":"világítástervező ágense a következőnek:","it":"è progettista dell'illuminazione","lv":"ir gaismu mākslinieks (aģents)","nl":"is lichtontwerper-actor van","no":"er lysdesigner for (agent)","tr":"ışık tasarımcısı temsilcisidir","zh-Hans-CN":"是……的灯光设计者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في تصميم عناصر الإضاءة وإنشائها."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent en el disseny i creació de components luminotècnics."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že navrhuje a vytváří světelnou složku."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at designe og skabe belysningsdele."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Lichtelemente entwirft und erstellt.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er Lichtelemente entwirft und erstellt."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω του σχεδιασμού και της δημιουργίας συστατικών φωτισμού, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of designing and creating lighting components."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de diseñar y crear elementos de iluminación."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, kavandades ja luues selle valguskomponendid."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu suunnittelemalla ja luomalla valokomponentteja."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à concevoir et à créer des effets de lumière."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését világítási összetevők tervezésében és létrehozásában."],"it":["Correla un agente a un'espressione che include un contributo da parte di un agente nella progettazione e creazione di componenti per l'illuminazione."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, izstrādājot un radot apgaismojuma efektus."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door ontwerpen en creëren van lichteffecten."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent som utformer og skaper lyskomponenter."],"tr":["Bir temsilciyi, aydınlatma bileşenlerini tasarlayan ve oluşturan bir temsilcisinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括设计并创作灯光组成部分的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مصمم إضاءة","ca":"agent dissenyador d’il·luminació de","cs":"designér osvětlení (agent) (čeho)","da":"agent, som er belysningsdesigner af","de":"Akteur als Lichtgestalterin/Lichtgestalter von","de":"Akteur als Lichtgestalterin/Lichtgestalter von","el":"σχεδιαστής φωτισμού φορέας του","en":"lighting designer agent of","es":"agente diseñador de iluminación de","et":"valguskujundaja (tegija) väljenduses","fi":"valosuunnittelija (toimija) ekspressiossa","fr":"agent éclairagiste de","hu":"világítástervező ágense:","it":"progettista dell'illuminazione agente","lv":"ir gaismu mākslinieks (aģents)","nl":"lichtontwerper-actor van","no":"lysdesigner for (agent)","tr":"Işık tasarımcısı temsilcisi","zh-Hans-CN":"……的灯光设计者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في تصميم عناصر الإضاءة وإنشائها.","ca":"Expressió que inclou una contribució d’un agent en el disseny i creació de components luminotècnics.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že navrhuje a vytváří světelnou složku.","da":"Udtryk, som omfatter en agents bidrag ved at designe og skabe belysningsdele.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er Lichtelemente entwirft und erstellt.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er Lichtelemente entwirft und erstellt.","el":"Μια έκφραση ενός έργου που ενσωματώνει τη συνεισφορά του σχεδιασμού και της δημιουργίας συστατικών φωτισμού.","en":"An expression that includes a contribution by an agent of designing and creating lighting components.","es":"Una expresión que incluye una contribución de un agente de diseñar y crear elementos de iluminación.","et":"Väljendus, millesse tegija on andnud panuse, kavandades ja luues selle valguskomponendid.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu suunnittelemalla ja luomalla valokomponentteja.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à concevoir et à créer des effets de lumière.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését világítási összetevők tervezésében és létrehozásában.","it":"Espressione che include un contributo da parte di un agente per progettare e creare componenti di illuminazione.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, izstrādājot un radot apgaismojuma efektus.","nl":"Een expressie die omvat een bijdrage door een actor door ontwerpen en creëren van lichteffecten.","no":"Et uttrykk som inkluderer et bidrag fra en agent som utformer og skaper lyskomponenter.","tr":"Aydınlatma bileşenleri tasarlayan ve yaratan bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括设计并创作灯光组成部分的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["مصمم الإضاءة"],"ca":["dissenyador d’il·luminació de"],"cs":["designér osvětlení (čeho)"],"da":["belysningsdesigner af"],"de":["Lichtgestalter von,Lichtgestalter von"],"el":["σχεδιαστής φωτισμού του"],"en":["lighting designer of"],"es":["diseñador de iluminación de"],"et":["valguskujundaja väljenduses"],"fi":["valosuunnittelijana ekspressiossa"],"fr":["éclairagiste de"],"hu":["világítástervezője:"],"it":["pogettista dell'illuminazione di"],"nl":["lichtontwerper van"],"no":["lysdesigner for"],"tr":["Işık tasarımcısı"],"zh-Hans-CN":["……的灯光设计者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
