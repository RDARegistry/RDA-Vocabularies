                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/colouristCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50926", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCorporateBodyToAmalgamationOf.en", "label":"is contributor corporate body to amalgamation of"},{"@id":"http://rdaregistry.info/Elements/a/P50722", "lexicalAlias":"http://rdaregistry.info/Elements/a/colouristCollectiveAgentOf.en", "label":"is colourist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50873", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/colouristCorporateBodyOf.en", "label":"is colourist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50873", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/colouristCorporateBodyOf.en", "label":"is colourist corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51024","label":{"ar":"هي عائلة مسئولة عن تلوين لـ","ca":"és família colorista de","cs":"je koloristou (rodinou) (čeho)","da":"er familie, som er farvelægger af","de":"ist Familie als Koloristin/Kolorist von","de":"ist Familie als Koloristin/Kolorist von","el":"είναι επιχρωματιστής οικογένεια του","en":"is colourist family of","es":"es familia colorista de","et":"koloreerija (perekond) väljenduses","fi":"värittäjä (suku) ekspressiossa","fr":"est une famille coloriste de","hu":"colorist családja a következőnek:","it":"è colorista famiglia di","lv":"ir kolorists (dzimta/ģimene)","nl":"is inkleurder-familie van","no":"er fargelegger for (familie)","tr":"renklendirici ailesidir","zh-Hans-CN":"是……的着色者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في تلوين رسومات، ومطبوعات، وصور فوتوغرافية، وخرائط، وصور متحركة، وأي محتوى مرئي آخر."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment i a qualsevol altre contingut visual."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že nanáší barvy na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at farvelægge tegninger, tryk, fotos, kort, levende billeder og andet visuelt indhold."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbildern und so weiter aufbringt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbildern und so weiter aufbringt."],"en":["Relates a family to an expression that includes a contribution by a family of applying colour to drawings, prints, photographs, maps, moving images, and other visual content."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de aplicar color a dibujos, impresiones, fotografías, mapas, imágenes en movimiento y otro contenido visual."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte ja muud visuaalset sisu."],"fi":["Liittää suvun ekspressioon, jossa suku on osallisena värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tms."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à appliquer de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées et d’autres contenus visuels."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését szín felhordásában rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más vizuális tartalmakra."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nell'applicazione di colore a disegni, stampe, fotografie, mappe, immagini in movimento e altri contenuti visivi."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, izkrāsojot zīmējumu, gravīru, fotogrāfiju, karšu, kustīgo attēlu, u. tml."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden en andere visuele content."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av fargelegge tegninger, trykk, fotografier, kart, levende bilder og annet visuelt materiale."],"tr":["Bir aile ile çizimlere, baskılara, fotoğraflara, haritalare, hareketli resimlere ve diğer görsel içeriğe renk uygulamaları yaparak katkı yapan aileyi içeren anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括将颜色施加于图画、印刷品、照片、地图、动态图像和其他视觉内容上的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة مسئولة عن تلوين لـ","ca":"família colorista de","cs":"kolorista (rodina) (čeho)","da":"familie, som er farvelægger af","de":"Familie als Koloristin/Kolorist von","de":"Familie als Koloristin/Kolorist von","el":"επιχρωματιστής οικογένεια του","en":"colourist family of","es":"familia colorista de","et":"koloreerija (perekond) väljenduses","fi":"värittäjä (suku) ekspressiossa","fr":"famille coloriste de","hu":"colorist családja:","it":"colorista famiglia di","lv":"ir kolorists (dzimta/ģimene)","nl":"inkleurder-familie van","no":"fargelegger for (familie)","tr":"renklendirici ailesi","zh-Hans-CN":"……的着色者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في تلوين الرسومات، والمطبوعات، والصور الفوتوغرافية، والخرائط، والصور المتحركة، وأي محتوى مرئي آخر.","ca":"Expressió que inclou una contribució d’una família aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment i a qualsevol altre contingut visual.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že nanáší barvy na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah.","da":"Udtryk, som omfatter en families bidrag ved at farvelægge tegninger, tryk, fotos, kort, levende billeder og andet visuelt indhold.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbildern und so weiter aufbringt.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbildern und so weiter aufbringt.","en":"An expression that includes a contribution by a family of applying colour to drawings, prints, photographs, maps, moving images, and other visual content.","es":"Una expresión que incluye una contribución de una familia de aplicar color a dibujos, impresiones, fotografías, mapas, imágenes en movimiento y otro contenido visual.","et":"Väljendus, millesse perekond on andnud panuse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte ja muud visuaalset sisu.","fi":"Ekspressio, jossa suku on osallisena värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tms.","fr":"Expression qui intègre une contribution de la part d’une famille consistant à appliquer de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées et d’autres contenus visuels.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését szín felhordásában rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más vizuális tartalmakra.","it":"Espressione che comprende un contributo di una famiglia nell'applicazione di colore a disegni, stampe, fotografie, mappe, immagini in movimento e altri contenuti visivi.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, izkrāsojot zīmējumu, gravīru, fotogrāfiju, karšu, kustīgo attēlu, u. tml.","nl":"Een expressie die omvat een bijdrage door een familie door toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden en andere visuele content.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av fargelegge tegninger, trykk, fotografier, kart, levende bilder og annet visuelt materiale.","tr":"Çizimlere, baskılara, fotoğraflara, haritalara, hareketli resimlere ve diğer görsel içeriğe renk uygulamaları yapan bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括将颜色施加于图画、印刷品、照片、地图、动态图像和其他视觉内容上的一个家族的贡献的一种内容表达"},"altLabel":{"ar":["عائلة مسئولة عن تلوين لـ"],"de":["Familie als Coloristin/Colorist von,Familie als Coloristin/Colorist von"],"en":["colorist family of"],"es":["colorista de"],"fi":["-"],"hu":["színező családja:"],"nl":["inkleurder-familie van"],"tr":["renklendirici ailesi"],"zh-Hans-CN":["……的着色者家族"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
