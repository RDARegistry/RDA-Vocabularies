                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50388", "lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfCollectiveAgent.en", "label":"has field of activity of collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50389", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/fieldOfActivityOfFamily.en", "label":"has field of activity of family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50389", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/fieldOfActivityOfFamily.en", "label":"has field of activity of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50048","label":{"ar":"هو وكيل مخرج فيلم لـ","ca":"és agent director cinematogràfic de","cs":"je filmovým režisérem (agentem) (čeho)","da":"er agent, som er filminstruktør af","de":"ist Akteur als Filmregisseurin/Filmregisseur von","de":"ist Akteur als Filmregisseurin/Filmregisseur von","el":"είναι σκηνοθέτης φορέας του","en":"is film director agent of","es":"es agente director de cine de","et":"filmirežissöör (tegija) teoses","fi":"elokuvaohjaaja (toimija) teoksessa","fr":"est un agent réalisateur de cinéma de","hu":"filmrendező ágense a következőnek:","it":"è regista agente di","lv":"ir kinorežisors (aģents)","nl":"is filmregisseur-actor van","no":"er filmregissør av (agent)","tr":"film yönetmeni temsilcisidir","zh-Hans-CN":"是……的电影导演行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه تحمل وكيل مسئولية الإدارة العامة والإشراف على أداء مصور."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la gestió general i la supervisió d’una actuació filmada."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za obecné řízení a dohled nad zfilmovaným představením."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist."],"el":["Συνδέει έναν σκηνοθέτη υπεύθυνο για τη γενική διεύθυνση και εποπτεία μίας κινηματογραφικής ερμηνείας, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for the general management and supervision of a filmed performance."],"es":["Relaciona un agente con una obra que involucra la responsabilidad de un agente para la gestión y supervisión general de una presentación filmada."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust filmitava etenduse üldise juhtimise ja juhendamise eest."],"fi":["Liittää toimijan teokseen, joka sisältää vastuun elokuvatun esityksen yleisestä johtamisesta ja valvonnasta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à assurer la gestion et la supervision générales d’une prestation filmée."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy filmforgatás általános menedzseléséért és felügyeletéért."],"it":["Correla un agente a un'opera che implica una responsabilità di un agente per la gestione generale e la supervisione di un'interpretazione filmata."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par uzfilmētā pasākuma vispārējo vadību un uzraudzību."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het algemeen beheer en toezicht van een gefilmde uitvoering."],"no":["Relaterer en agent til et verk som involverer ansvar av en agent for generell ledelse av en filmet forestilling."],"tr":["Bir temsilciyi, filme alınmış bir performansın genel yönetimi ve denetimine ilişkin bir temsilcinin sorumluluğunu içeren eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及摄制表演的总体管理和监督的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل مخرج فيلم لـ","ca":"agent director cinematogràfic de","cs":"filmový režisér (agent) (čeho)","da":"agent, som er filminstruktør af","de":"Akteur als Filmregisseurin/Filmregisseur von","de":"Akteur als Filmregisseurin/Filmregisseur von","el":"σκηνοθέτης φορέας του","en":"film director agent of","es":"agente director de cine de","et":"filmirežissöör (tegija) teoses","fi":"elokuvaohjaaja (toimija) teoksessa","fr":"agent réalisateur de cinéma de","hu":"filmrendező ágense:","it":"agente regista di film","lv":"ir kinorežisors (aģents)","nl":"filmregisseur-actor van","no":"filmregissør av (agent)","tr":"film yönetmeni temsilcisi","zh-Hans-CN":"……的电影导演行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن الإدارة العامة والإشراف على أداء مصور.","ca":"Obra que implica una responsabilitat d’un agent en la gestió general i la supervisió d’una actuació filmada.","cs":"Dílo, které zahrnuje odpovědnost agenta za obecné řízení a dohled nad zfilmovaným představením.","da":"Værk, som involverer en agents ansvar for den generelle ledelse af- og tilsyn med en filmoptagelse.","de":"Ein Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.","el":"Ένα έργο το οποίο περιλαμβάνει την ευθύνη για τη γενική διαχείριση και εποπτεία μιας κινηματογραφικής ερμηνείας.","en":"A work that involves a responsibility of an agent for the general management and supervision of a filmed performance.","es":"Una obra que involucra la responsabilidad de un agente para la gestión y supervisión general de una presentación filmada.","et":"Teos, mis sisaldab tegija vastutust filmitava etenduse üldise juhtimise ja juhendamise eest.","fi":"Teos, joka sisältää toimijan vastuun elokuvatun esityksen yleisestä johtamisesta ja valvonnasta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à assurer la gestion et la supervision générales d’une prestation filmée.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége egy filmforgatás általános menedzseléséért és felügyeletéért.","it":"Opera che implica una responsabilità di un agente della gestione generale e la supervisione di un'interpretazione filmata.","lv":"Darbs, kas ietver aģenta atbildību par uzfilmētā pasākuma vispārējo vadību un uzraudzību","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het algemeen beheer en toezicht van een gefilmde uitvoering.","no":"Et verk som involverer ansvar av en agent for generell ledelse av en filmet forestilling.","tr":"Filme alınmış bir performansın genel yönetimi ve denetimi için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及摄制表演的总体管理和监督的一个行为者的责任的一种作品"},"altLabel":{"ar":["مخرج الفيلم"],"ca":["director cinematogràfic de"],"cs":["filmový režisér (čeho)"],"da":["filminstruktør af"],"de":["Filmregisseur von,Filmregisseur von"],"el":["σκηνοθέτης του"],"en":["film director of"],"es":["director de cine de"],"et":["filmirežissöör teoses"],"fi":["elokuvaohjaaja teoksessa"],"fr":["réalisateur de cinéma de,agent réalisateur de film de"],"hu":["filmrendezője:"],"it":["regista di"],"nl":["filmregisseur van"],"no":["filmregissør av"],"tr":["film yönetmeni"],"zh-Hans-CN":["……的电影导演"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
