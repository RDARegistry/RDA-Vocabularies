                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/appellantPersonOf.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50122", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/appellantPersonOf.en", "label":"is appellant person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50122", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/appellantPersonOf.en", "label":"is appellant person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50124","label":{"ar":"هو شخص مُدّعِ لـ","ca":"és persona demandant de","cs":"je žalobcem (osobou) (čeho)","da":"er person, som er sagsøger af","de":"ist zivilklagende Person von","de":"ist zivilklagende Person von","el":"είναι ενάγον φυσικό πρόσωπο του","en":"is plaintiff person of","es":"es persona demandante de","et":"hageja (isik) teoses","fi":"henkilökantaja teoksessa","fr":"est une personne demanderesse de","hu":"felperes személye a következőnek:","it":"è querelante persona di","lv":"ir prasītājs (persona)","nl":"is aanklager-persoon van","no":"er saksøker av (person)","tr":"davacı kişisidir","zh-Hans-CN":"是……的原告个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه تحمل شخص مسئولية رفع دعوى مدنية."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’interposar una demanda civil com a persona en un procés civil."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost za předložení žaloby jako osoba v civilním řízení."],"da":["Relaterer en person til et værk, som involverer et ansvar for at anlægge en sag, som en person, i en civilproces."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person eine Klage in ein Zivilverfahren einbringt.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person eine Klage in ein Zivilverfahren einbringt."],"el":["Συνδέει ένα φυσικό πρόσωπο, το οποίο ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας, με ένα έργο."],"en":["Relates a person to a work that involves a responsibility for bringing a suit as a person in a civil proceeding."],"es":["Relaciona una persona con una obra que involucra una responsabilidad de entablar una demanda como una persona en un procedimiento civil."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust tsiviilkohtumenetluses hagi esitamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa kanteen tuomisesta siviilioikeudenkäyntiin."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité consistant à intenter une poursuite civile en tant que personne."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége egy per elindításáért egy polgári jogi eljárásban."],"it":["Correla una persona a un'opera che implica una responsabilità nell'intentare una causa come persona in un processo civile."],"lv":["Sasaista personu ar darbu, kas ietver atbildību par to, ka persona ceļ prasību civiltiesā."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid voor het aanspannen van een proces als een persoon in een civielrechtelijke procedure."],"no":["Relaterer en person til et verk som involverer ansvar for å være en person som er saksøker i en sivilrettslig sak."],"tr":["Bir kişiyi, hukuk davasında kişi olarak dava açma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及民事诉讼中作为个人起诉的责任的作品关联起来。"]},"ToolkitLabel":{"ar":"شخص مدع لـ","ca":"persona demandant de","cs":"žalobce (osoba) (čeho)","da":"person, som er sagsøger af","de":"Zivilklagende Person von","de":"Zivilklagende Person von","el":"ενάγον φυσικό πρόσωπο του","en":"plaintiff person of","es":"persona demandante de","et":"hageja (isik) teoses","fi":"henkilökantaja teoksessa","fr":"personne demanderesse de","hu":"felperes személye:","it":"querelante persona di","lv":"ir prasītājs (persona)","nl":"aanklager-persoon van","no":"saksøker av (person)","tr":"davacı kişi","zh-Hans-CN":"……的原告个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه تحمل شخص مسئولية رفع دعوى مدنية.","ca":"Obra que implica una responsabilitat d’interposar una demanda civil com a persona en un procés civil.","cs":"Dílo, které zahrnuje odpovědnost za předložení žaloby jako osoba v civilním řízení.","da":"Værk, som involverer et ansvar for at anlægge en sag, som en person, i en civilproces.","de":"Ein Werk, bei dem eine Person eine Klage in ein Zivilverfahren einbringt.","de":"Ein Werk, bei dem eine Person eine Klage in ein Zivilverfahren einbringt.","el":"Ένα έργο, το οποίο περιλαμβάνει την άσκηση αγωγήςστο πλαίσιο αστικής διαδικασίας, από ένα φυσικό πρόσωπο.","en":"A work that involves a responsibility for bringing a suit as a person in a civil proceeding.","es":"Una obra que involucra una responsabilidad de entablar una demanda como una persona en un procedimiento civil.","et":"Teos, mis sisaldab isiku vastutust tsiviilkohtumenetluses hagi esitamise eest.","fi":"Teos, jossa henkilö on vastuussa kenteen tuomisesta siviilioikeudenkäyntiin.","fr":"Œuvre qui comporte une responsabilité consistant à intenter une poursuite civile en tant que personne.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége egy per elindításáért egy polgári jogi eljárásban.","it":"Opera che implica una responsabilità nell'intentare una causa come persona in un processo civile.","lv":"Darbs, kas ietver atbildību par to, ka persona ceļ prasību civiltiesā.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid voor het aanspannen van een proces als een persoon in een civielrechtelijke procedure.","no":"Et verk som involverer ansvar for å være en person som er saksøker i en sivilrettslig sak.","tr":"Bir hukuk davasında kişi olarak dava açma sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及民事诉讼中作为个人起诉的责任的作品"},"altLabel":{"fi":["henkilön tekemä kanne"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
