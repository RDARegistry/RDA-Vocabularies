                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"lexicalAlias":"http://rdaregistry.info/Elements/a/corporateBodyMemberOfCorporateBodyOf.en","instructionNumber":"29.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50336", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedCorporateBodyOfCorporateBody.en", "label":"has related corporate body of corporate body"},{"@id":"http://rdaregistry.info/Elements/a/P50439", "lexicalAlias":"http://rdaregistry.info/Elements/a/corporateBodyMemberOfCollectiveAgentOf.en", "label":"is corporate body member of collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50230", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/corporateBodyMemberOfCorporateBodyOf.en", "label":"is corporate body member of corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50230", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/corporateBodyMemberOfCorporateBodyOf.en", "label":"is corporate body member of corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50022","label":{"ar":"لها مجال نشاط هيئة","ca":"té com a camp d’activitat d’una entitat corporativa","cs":"má oblast působnosti (činnosti) korporace","da":"har virkefelt for korporation","de":"hat Betätigungsfeld einer Körperschaft","de":"hat Betätigungsfeld einer Körperschaft","el":"έχει πεδίο δραστηριοποίησης του συλλογικού οργάνου","en":"has field of activity of corporate body","es":"tiene campo de actividad de organismo corporativo","et":"asutuse tegevusala","fi":"yhteisön toiminta-ala","fr":"a pour domaine d’activité d’une collectivité","hu":"testület tevékenységi köre a következő:","it":"ha come campo di attività di ente","lv":"institūcijas darbības joma","nl":"heeft veld van activiteit van corporatie","no":"har virksomhetsområde for korporasjon","tr":"tüzel kişinin faaliyet alanı ile ilişkilidir","zh-Hans-CN":"有团体的活动领域"},"definition":{"ar":["يربط هيئة بمجالات العمل الذي تمارسه الهيئة واختصاصها ومسئوليتها وولايتها القضائية، إلخ."],"ca":["Relaciona una entitat corporativa amb un camp d’activitat, àrea de competència o de responsabilitat al qual es dedica una entitat corporativa."],"cs":["Vztahuje korporaci k oblasti činnosti, působnosti nebo odpovědnosti, kterou se korporace zabývá."],"da":["Relaterer en korporation til et indsats-, kompetence- eller ansvarsområde eller jurisdiktion etc., hvori en korporation virker."],"de":["Setzt eine Körperschaft in Beziehung zu einem Tätigkeitsfeld, einem Kompetenzbereich, einer Verantwortlichkeit, einer Zuständigkeit und so weiter, in dem/der eine Körperschaft tätig ist.,Setzt eine Körperschaft in Beziehung zu einem Tätigkeitsfeld, einem Kompetenzbereich, oder einer Zuständigkeit, in dem/der eine Körperschaft tätig ist."],"el":["Συνδέει ένα συλλογικό όργανο με έναν επιχειρηματικό τομέα στον οποίο το συλλογικό όργανο δραστηριοποιείται ή έναν τομέα αρμοδιότητας, ευθύνης, δικαιοδοσίας κ.λπ. με ένα συλλογικό όργανο."],"en":["Relates a corporate body to a field of endeavor, area of competence, or responsibility in which a corporate body is engaged."],"es":["Relaciona un organismo corporativo con un campo de negocios, área de competencia o responsabilidad en la que participa un organismo corporativo."],"et":["Seostab asutuse tegevusala, eriala, vastutusala, võimkonna või muuga, millega asutus tegeleb või on tegelnud."],"fi":["Liittää yhteisön alaan, jolla yhteisö toimii tai on toiminut, tai jonka asiantuntija tms. se on."],"fr":["Met une collectivité en relation avec un champ d’activité, domaine de compétence ou de responsabilité dans lequel une collectivité évolue."],"hu":["Hozzákapcsol egy testületet egy tevékenységhez, szakterülethez, illetékességi, vagy felelősségi területhez, amely iránt egy testület elkötelezett."],"it":["Correla un ente a un campo di impegno, area di competenza, responsabilità, giurisdizione, etc., nel quale un ente è impegnato."],"lv":["Sasaista institūciju ar darbības jomu, kurā institūcija ir iesaistīta atbilstoši tās kompetencei, atbildībai un jurisdikcijai, u.tml."],"nl":["Relateert een corporatie aan een veld van inspanning, vakgebied of verantwoordelijkheid waarbij een corporatie betrokken is."],"no":["Relaterer en korporasjon til et engasjement innen et felt, kompetanseområde, ansvarsområde, jurisdiksjon, etc. som en korporasjon er engasjert i."],"tr":["Bir tüzel kişiyi, bir tüzel kişinin faaliyet gösterdiği bir çalışma alanı, yetki alanı, sorumluluk alanı, yargı yetkisi vb. ile ilişkilendirir."],"zh-Hans-CN":["将一个团体与一个团体的努力领域、能力范围或担负责任关联起来。"]},"ToolkitLabel":{"ar":"مجال نشاط لهيئة","ca":"camp d’activitat d’una entitat corporativa","cs":"oblast působnosti (činnosti) korporace","da":"virkefelt for korporation","de":"Betätigungsfeld einer Körperschaft","de":"Betätigungsfeld einer Körperschaft","el":"πεδίο δραστηριοποίησης του συλλογικού οργάνου","en":"field of activity of corporate body","es":"campo de actividad de organismo corporativo","et":"asutuse tegevusala","fi":"yhteisön toiminta-ala","fr":"domaine d’activité d’une collectivité","hu":"testület tevékenységi köre:","it":"campo di attività di ente","lv":"institūcijas darbības joma","nl":"veld van activiteit van corporatie","no":"virksomhetsområde for korporasjon","tr":"tüzel kişinin faaliyet alanı","zh-Hans-CN":"团体的活动领域"},"ToolkitDefinition":{"ar":"مجالات عمل الهيئة واختصاصها ومسئوليتها وولايتها القضائية، إلخ.","ca":"Camp d’activitat, àrea de competència o de responsabilitat al qual es dedica una entitat corporativa.","cs":"Oblast činnosti, působnosti nebo odpovědnosti, kterou se korporace zabývá.","da":"Indsats-, kompetence- eller ansvarsområde eller jurisdiktion etc., hvori en korporation virker.","de":"Ein Tätigkeitsfeld, ein Kompetenzbereich, eine Verantwortlichkeit, eine Zuständigkeit und so weiter, in dem/der eine Körperschaft tätig ist.","de":"Ein Tätigkeitsfeld, ein Kompetenzbereich oder eine Zuständigkeit, in dem/der eine Körperschaft tätig ist.","el":"Ένας επιχειρηματικός τομέας στον οποίο το συλλογικό όργανο δραστηριοποιείται ή ένας τομέας αρμοδιότητας, ευθύνης, δικαιοδοσίας κ.λπ. ενός συλλογικού οργάνου.","en":"A field of endeavor, area of competence, or responsibility in which a corporate body is engaged.","es":"Un campo de negocios, área de competencia o responsabilidad en la que participa un organismo corporativo.","et":"Tegevusala, eriala, vastutusala, võimkond või muu, millega asutus tegeleb või on tegelnud.","fi":"Ala, jolla yhteisö toimii tai on toiminut, tai jonka asiantuntija tms. se on.","fr":"Champ d’activité, domaine de compétence ou de responsabilité dans lequel une collectivité évolue.","hu":"Egy tevékenység, szakterület, illetékességi vagy felelősségi terület, amely iránt egy testület elkötelezett.","it":"Campo di impegno, area di competenza, responsabilità, giurisdizione, etc., nel quale un ente è impegnato.","lv":"Darbības joma, kurā institūcija ir iesaistīta atbilstoši tās kompetencei, atbildībai un jurisdikcijai, u.tml.","nl":"Een veld van inspanning, vakgebied of verantwoordelijkheid waarbij een corporatie betrokken is.","no":"Et engasjement innen et felt, kompetanseområde, ansvarsområde, jurisdiksjon, etc. som en korporasjon er engasjert i.","tr":"Bir tüzel kişinin faaliyet gösterdiği çalışma alanı, yetki alanı, sorumluluk alanı, yargı yetkisi vb.","zh-Hans-CN":"一个团体的努力领域、能力范围或担负责任"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
