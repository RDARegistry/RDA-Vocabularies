                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorAgentOf.en", "label":"is author agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistAgentOf.en","See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50225", "lexicalAlias":"http://rdaregistry.info/Elements/a/librettistAgentOf.en", "label":"is librettist agent of"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50684", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistCollectiveAgentOf.en", "label":"is lyricist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50533", "lexicalAlias":"http://rdaregistry.info/Elements/a/lyricistPersonOf.en", "label":"is lyricist person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50224", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/lyricistAgentOf.en", "label":"is lyricist agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50224", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/lyricistAgentOf.en", "label":"is lyricist agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50684","label":{"ar":"هو وكيل جماعي كاتب أغاني لـ","ca":"és agent col·lectiu lletrista de","cs":"je textařem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er tekstforfatter af","de":"ist gemeinschaftlicher Akteur als Textdichterin/Textdichter von","de":"ist gemeinschaftlicher Akteur als Textdichterin/Textdichter von","el":"είναι στιχουργός συλλογικός φορέας του","en":"is lyricist collective agent of","es":"es agente colectivo letrista de","et":"sõnade autor (kollektiiv) teoses","fi":"sanoittaja (yhteistoimija) teoksessa","fr":"est un agent collectif parolier de","hu":"dalszövegíró kollektív ágense a következőnek:","it":"è paroliere agente collettivo di","lv":"ir dziesmas teksta autors (grupa)","nl":"is liedtekstschrijver-collectieve actor van","no":"er sangtekstforfatter for (kollektiv agent)","tr":"söz yazarı kolektif temsilcisidir","zh-Hans-CN":"是……的作词者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن تأليف كلمات الأغنية الشعبية، بما في ذلك أغنية من مَسرحية موسيقِيّة."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en l’autoria d’una cançó popular, inclosa una cançó d’un musical."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za autorství textu populární písně včetně písně z muzikálu."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for at forfatte ordene til en populær sang, inkl. en sang fra en musical."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for authoring the words of a popular song, including a song from a musical."],"es":["Relaciona a un agente colectivo con una obra que implica la responsabilidad de un agente colectivo de ser el autor de la letra de una canción popular, incluida una canción de un musical."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust levilaulu (k.a laul muusikalist) sõnade kirjutamise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa populaarimusiikkiin kuuluvan laulun (mukaan lukien musikaalilaulun) sanojen kirjoittamisesta."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à être l’auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége egy könyűzenei dalszöveg szerzőségéért, musicaldalt is beleértve."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo come autore delle parole di una canzone, inclusa una canzone di un musical."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par dziesmas vārdiem, ieskaitot dziesmas no mūzikla."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor schrijven van de woorden van een populair lied, inclusief een lied uit een musical."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å være forfatter av teksten til en populær sang, inkludert en sang fra en musikal."],"tr":["Kolektif bir temsilciyi, bir müzikalden bir şarkı da dâhil olmak üzere popüler bir şarkının sözlerini yazma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及流行歌曲（包括音乐剧中的歌曲）歌词的写作的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي كاتب أغاني","ca":"agent col·lectiu lletrista de","cs":"textař (kolektivní agent) (čeho)","da":"kollektiv agent, som er tekstforfatter af","de":"Gemeinschaftlicher Akteur als Textdichterin/Textdichter von","de":"Gemeinschaftlicher Akteur als Textdichterin/Textdichter von","el":"στιχουργός συλλογικός φορέας του","en":"lyricist collective agent of","es":"agente colectivo letrista de","et":"sõnade autor (kollektiiv) teoses","fi":"sanoittaja (yhteistoimija) teoksessa","fr":"agent collectif parolier de","hu":"dalszövegíró kollektív ágense:","it":"paroliere agente collettivo di","lv":"ir dziesmas teksta autors (grupa)","nl":"liedtekstschrijver-collectieve actor van","no":"sangtekstforfatter for (kollektiv agent)","tr":"Söz yazarı kolektif temsilcisi","zh-Hans-CN":"……的作词者集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن تأليف كلمات الأغنية الشعبية، بما في ذلك أغنية من مَسرحية موسيقِيّة.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en l’autoria d’una cançó popular, inclosa una cançó d’un musical.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za autorství textu populární písně včetně písně z muzikálu.","da":"Værk, som involverer en kollektiv agents ansvar for at forfatte ordene til en populær sang, inkl. en sang fra en musical.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Verfassen des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical, verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for authoring the words of a popular song, including a song from a musical.","es":"Una obra que implica la responsabilidad de un agente colectivo de ser el autor de la letra de una canción popular, incluida una canción de un musical.","et":"Teos, mis sisaldab kollektiivi vastutust levilaulu (k.a laul muusikalist) sõnade kirjutamise eest.","fi":"Teos, jossa yhteistoimija on vastuussa populaarimusiikkiin kuuluvan laulun (mukaan lukien musikaalilaulun) sanojen kirjoittamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à être l’auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége egy könyűzenei dalszöveg szerzőségéért, musicaldalt is beleértve.","it":"Opera che implica una responsabilità di un agente collettivo come autore delle parole di una canzone, inclusa una canzone di un musical.","lv":"Darbs, kas ietver grupas atbildību par dziesmas vārdiem, ieskaitot dziesmas no mūzikla.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor schrijven van de woorden van een populair lied, inclusief een lied uit een musical.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av å være forfatter av teksten til en populær sang, inkludert en sang fra en musikal.","tr":"Bir müzikalden bir şarkı da dâhil olmak üzere popüler bir şarkının sözlerini yazmak için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及流行歌曲（包括音乐剧中的歌曲）歌词的写作的一个集体行为者的责任的一种作品"},"note":{"ar":["يُستبعد تأليف الحوار فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només el diàleg d’un musical."],"cs":["Autorství pouze dialogu z muzikálu je vyloučeno."],"da":["At forfatte kun dialogen til en musical er ikke omfattet."],"de":["Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.,Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter."],"en":["Authoring of only the dialogue from a musical is excluded."],"es":["Se excluye la autoría únicamente del diálogo de un musical."],"et":["Ei hõlma üksnes muusikali dialoogide kirjutamist."],"fi":["Ei kata pelkän musikaalin dialogin kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu."],"hu":["Musical párbeszédeinek szerzősége nem tartozik ide."],"it":["È escluso l'essere autore solo del dialogo di un musical."],"lv":["Neietver mūzikla dialogus."],"nl":["Schrijven van enkel de dialoog van een musical is uitgesloten."],"no":["Det å bare skrive dialogen fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca diyaloglarının yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中仅是对白的写作。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
