                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50192", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistAgentOf.en", "label":"is artist agent of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/sculptorAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50716", "lexicalAlias":"http://rdaregistry.info/Elements/a/sculptorCollectiveAgentOf.en", "label":"is sculptor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50565", "lexicalAlias":"http://rdaregistry.info/Elements/a/sculptorPersonOf.en", "label":"is sculptor person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50222", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/sculptorAgentOf.en", "label":"is sculptor agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50222", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/sculptorAgentOf.en", "label":"is sculptor agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50716","label":{"ar":"هو وكيل جماعي نحات لـ","ca":"és agent col·lectiu escultor de","cs":"je sochařem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er skulptør af","de":"ist gemeinschaftlicher Akteur als Bildhauerin/Bildhauer von","de":"ist gemeinschaftlicher Akteur als Bildhauerin/Bildhauer von","el":"είναι γλύπτης συλλογικός φορέας του","en":"is sculptor collective agent of","es":"es agente colectivo escultor de","et":"skulptor (kollektiiv) teoses","fi":"kuvanveistäjä (yhteistoimija) teoksessa","fr":"est un agent collectif sculpteur de","hu":"szobrász kollektív ágense a következőnek:","it":"è scultore agente collettivo di","lv":"ir tēlnieks (grupa)","nl":"is beeldhouwer-collectieve actor van","no":"er skulptør for (kollektiv agent)","tr":"heykeltıraş kollektif temsilcidir","zh-Hans-CN":"是……的雕塑家集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن نمذجة ثلاثية الأبعاد أو نحت أو تقنية مماثلة."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en el modelatge, la talla o una tècnica tridimensional similar."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za trojrozměrné modelování, vyřezávání nebo podobnou techniku."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for tredimensionel modellering, udskæring eller lignende teknik."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für dreidimensionales Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für dreidimensionales Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for three-dimensional modeling, carving, or similar technique."],"es":["Relaciona un agente colectivo con una obra que implica una responsabilidad de un agente colectivo para el modelado tridimensional, tallado o técnica similar."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust kolmemõõtmelise modelleerimise, nikerdamise või muu sellise tehnika eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à utiliser le modelage, la taille ou une technique similaire pour une œuvre tridimensionnelle."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége háromdimenziós modellezésért, faragásért vagy hasonló technikáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo per la modellazione tridimensionale, scultura o tecnica simile."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par trīsdimensionālu modelēšanu, grebšanu vai līdzīgu tehniku."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor driedimensionaal modelleren, snijden of gelijksoortige techniek."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av modellering, utskjæring eller lignende teknikker for et tredimensjonalt verk."],"tr":["Kolektif bir temsilciyi, üç boyutlu modelleme, oyma veya benzer bir teknikler için kolektif bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及三维模型、雕刻或类似技术的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي نحات","ca":"agent col·lectiu escultor de","cs":"sochař (kolektivní agent) (čeho)","da":"kollektiv agent, som er skulptør af","de":"Gemeinschaftlicher Akteur als Bildhauerin/Bildhauer von","de":"Gemeinschaftlicher Akteur als Bildhauerin/Bildhauer von","el":"γλύπτης συλλογικός φορέας του","en":"sculptor collective agent of","es":"agente colectivo escultor de","et":"skulptor (kollektiiv) teoses","fi":"kuvanveistäjä (yhteistoimija) teoksessa","fr":"agent collectif sculpteur de","hu":"szobrász kollektív ágense:","it":"scultore agente collettivo di","lv":"ir tēlnieks (grupa)","nl":"beeldhouwer-collectieve actor van","no":"skulptør for (kollektiv agent)","tr":"heykeltıraş kollektif temsilci","zh-Hans-CN":"……的雕塑家集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن نمذجة ثلاثية الأبعاد أو نحت أو تقنية مماثلة.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en el modelatge, la talla o una tècnica tridimensional 