                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/casterPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50174", "lexicalAlias":"http://rdaregistry.info/Elements/a/casterAgentOf.en", "label":"is caster agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50494", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfManifestationOf.en", "label":"is creator person of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50502", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/casterPersonOf.en", "label":"is caster person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50502", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/casterPersonOf.en", "label":"is caster person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50294","label":{"ar":"هو وكيل مدير لطاقم التمثيل لـ","ca":"és agent director de càsting de","cs":"je castingovým režisérem (agentem) (čeho)","da":"er agent, som er caster af","de":"ist Akteur als Casting Director von","de":"ist Akteur als Casting Director von","el":"είναι διευθυντής διανομής ρόλων φορέας του","en":"is casting director agent of","es":"es agente director de casting de","et":"casting'u juht (tegija) teoses","fi":"roolittaja (toimija) teoksessa","fr":"est un agent directeur de casting de","hu":"szereposztó rendező ágense a következőnek:","it":"è direttore del casting di","lv":"ir aktieru atlases režisors (aģents)","nl":"is castingdirector-actor van","no":"er casting director for (agent)","tr":"cast yönetmeni temsilcisidir","zh-Hans-CN":"是……的角色导演行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن تحديد معظم الجوانب المتعلقة بأدوار الممثلين ومهامهم."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la majoria dels aspectes de l’assignació de papers i funcions als intèrprets."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za většinu aspektů přidělování rolí a úkolů účinkujícím."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for de fleste aspekter ved tildeling af roller og opgaver til udøvere."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist."],"el":["Συνδέει έναν φορέα μια ένα έργο που ενσωματώνει την ευθύνη της συνεισφοράς για τις περισσότερες πτυχές ανάθεσης μερών και καθηκόντων στους εκτελεστές."],"en":["Relates an agent to a work that involves a responsibility of an agent for most aspects of assigning roles and duties to performers."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente para la mayoría de los aspectos de la asignación de roles y funciones a intérpretes."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust esitajatele rollide ja ülesannete jagamise enamiku aspektide eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente per diversi aspetti nell'assegnare ruoli e compiti agli attori."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par lomu sadali un pienākumu piešķiršanu izpildītājiem."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent for de fleste aspekter ved rollefordeling og oppgaver mellom utøvere."],"tr":["Bir temsilciyi, oyunculara roller ve görevler atamanın çoğu yönüyle ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及给演员分配角色和任务的大多数工作的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل مدير لطاقم التمثيل","ca":"agent director de càsting de","cs":"castingový režisér (agent) (čeho)","da":"agent, som er caster af","de":"Akteur als Casting Director von","de":"Akteur als Casting Director von","el":"διευθυντής διανομής ρόλων φορέας του","en":"casting director agent of","es":"agente director de casting de","et":"casting'u juht (tegija) teoses","fi":"roolittaja (toimija) teoksessa","fr":"agent directeur de casting de","hu":"szereposztó rendező ágense:","it":"direttore del casting agente di","lv":"ir aktieru atlases režisors (aģents)","nl":"castingdirector-actor van","no":"casting director for (agent)","tr":"kast yönetmeni temsilcisi","zh-Hans-CN":"……的角色导演行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن تحديد معظم الجوانب المتعلقة بأدوار الممثلين ومهامهم.","ca":"Obra que implica una responsabilitat d’un agent en la majoria dels aspectes de l’assignació de papers i funcions als intèrprets.","cs":"Dílo, které zahrnuje odpovědnost agenta za většinu aspektů přidělování rolí a úkolů účinkujícím.","da":"Værk, som involverer en agents ansvar for de fleste aspekter ved tildeling af roller og opgaver til udøvere.","de":"Ein Werk, bei dem ein Akteur für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.","el":"Ένα έργο, το οποίο ενσωματώνει την ευθύνη της συνεισφοράς για τις περισσότερες πτυχές ανάθεσης μερών και καθηκόντων στους εκτελεστές.","en":"A work that involves a responsibility of an agent for most aspects of assigning roles and duties to performers.","es":"Una obra que involucra una responsabilidad de un agente para la mayoría de los aspectos de la asignación de roles y funciones a intérpretes.","et":"Teos, mis sisaldab tegija vastutust esitajatele rollide ja ülesannete jagamise enamiku aspektide eest.","fi":"Teos, jossa toimija on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent en ce qui concerne la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért.","it":"Opera che implica la responsabilità di un agente per diversi aspetti nell'assegnare ruoli e compiti agli attori.","lv":"Darbs, kas ietver aģenta atbildību par lomu sadali un pienākumu piešķiršanu izpildītājiem.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.","no":"Et verk som involverer ansvar for en agent for de fleste aspekter ved rollefordeling og oppgaver mellom utøvere.","tr":"Sanatçılara roller ve görevler atamanın çoğu yönü için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及给演员分配角色和任务的大多数工作的一个行为者的责任的一种作品"},"altLabel":{"ar":["مدير طاقم التمثيل"],"ca":["director de càsting de"],"cs":["castingový režisér (čeho)"],"da":["casting director af"],"de":["Casting Director von,Casting Director von"],"el":["διευθυντής διανομής ρόλων του"],"en":["casting director of"],"es":["director de casting de"],"et":["casting'u juht teoses"],"fi":["roolittajana esityksessä"],"fr":["directeur de casting de"],"hu":["szereposztó rendezője:"],"it":["direttore del casting di"],"nl":["castingdirector van"],"no":["casting director for"],"tr":["kast yönetmeni"],"zh-Hans-CN":["……的角色导演"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
