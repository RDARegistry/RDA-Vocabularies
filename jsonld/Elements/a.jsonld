                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50347", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedTimespanOfPerson.en", "label":"has related timespan of person"},{"@id":"http://rdaregistry.info/Elements/a/P50430", "lexicalAlias":"http://rdaregistry.info/Elements/a/periodOfActivityOfAgent.en", "label":"has period of activity of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/periodOfActivityOfPerson.en","instructionNumber":"9.3.4","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50098", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/periodOfActivityOfPerson.en", "label":"has period of activity of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50098", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/periodOfActivityOfPerson.en", "label":"has period of activity of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50100","label":{"ar":"له مجال نشاط لشخص","ca":"té com a camp d’activitat d’una persona","cs":"má oblast působnosti osoby","da":"har virkefelt for person","de":"hat Betätigungsfeld einer Person","de":"hat Betätigungsfeld einer Person","el":"έχει πεδίο δραστηριοποίησης του φυσικού προσώπου","en":"has field of activity of person","es":"tiene campo de actividad de persona","et":"isiku tegevusala","fi":"henkilön toiminta-ala","fr":"a pour domaine d’activité d’une personne","hu":"személy tevékenységi köre a következő:","it":"ha come campo di attività di persona","lv":"personas darbības joma","nl":"heeft veld van activiteit van persoon","no":"har virksomhetsområde for person","tr":"kişinin faaliyet alanı ile ilişkilidir","zh-Hans-CN":"有个人的活动领域"},"definition":{"ar":["يربط شخصا بمجال العمل والخبرة، الخ، التي يمارسها شخص."],"ca":["Relaciona una persona amb un camp d’acció, àrea d’experiència, etc., al qual es dedica una persona."],"cs":["Vztahuje osobu k oblasti působnosti, kterou se osoba zabývá."],"da":["Relaterer en person til et indsatsområde, ekspertiseområde osv., inden for hvilket en person er engageret."],"de":["Setzt eine Person in Beziehung zu einem Tätigkeitsfeld, einem Wissensgebiet und so weiter, in dem eine Person tätig ist.,Setzt eine Person in Beziehung zu einem Tätigkeitsfeld, einem Wissensgebiet und so weiter, in dem eine Person tätig ist."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα πεδίο δραστηριοποίησης, μια περιοχή ειδίκευσης κ.λπ. με την οποία το φυσικό πρόσωπο εμπλέκεται ή εμπλεκόταν."],"en":["Relates a person to a field of endeavor, area of expertise, etc., in which a person is engaged."],"es":["Relaciona una persona con un campo de desempeño, área de especialidad, etc., en la que participa una persona."],"et":["Seostab isiku tegevus- või erialaga, millega isik tegeleb või on tegelnud."],"fi":["Liittää henkilön alaan, jolla henkilö toimii tai on toiminut, tai jonka asiantuntija tms. hän on."],"fr":["Met une personne en relation avec un champ d’activité, domaine d’expertise, etc. dans lequel une personne évolue."],"hu":["Hozzákapcsol egy személyt egy tevékenységhez, szakterülethez, illetékességi, felelősségi, joghatósági, stb. területhez, amely iránt a személy elkötelezett."],"it":["Correla una persona a un campo di impegno, area di competenza, etc. nella quale una persona è impegnata."],"lv":["Sasaista personu ar personas darbības jomu, kurā tā iesaistīta."],"nl":["Relateert een persoon aan een veld van inspanning, vakgebied etc. waarbij een persoon betrokken is."],"no":["Relaterer en person til et arbeidsfelt, et ekspertiseområde, etc., som en person er involvert i."],"tr":["Bir kişiyi, meşgul olduğu bir çalışma alanı, uzmanlık alanı vb. ile ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个个人所从事的努力的领域和专长范围等关联起来。"]},"ToolkitLabel":{"ar":"مجال نشاط لشخص","ca":"camp d’activitat d’una persona","cs":"oblast působnosti osoby","da":"virkefelt for person","de":"Betätigungsfeld einer Person","de":"Betätigungsfeld einer Person","el":"πεδίο της δραστηριοποίησης του φυσικού προσώπου","en":"field of activity of person","es":"campo de actividad de persona","et":"isiku tegevusala","fi":"henkilön toiminta-ala","fr":"domaine d’activité d’une personne","hu":"személy tevékenységi köre:","it":"campo di attività di persona","lv":"personas darbības joma","nl":"veld van activiteit van persoon","no":"virksomhetsområde for person","tr":"kişinin faaliyet alanı","zh-Hans-CN":"个人的活动领域"},"ToolkitDefinition":{"ar":"مجال العمل والخبرة، الخ، التي يمارسها شخص.","ca":"Camp d’acció, àrea d’experiència, etc., al qual es dedica una persona.","cs":"Oblast činnosti, obor odbornosti atd., kterými se osoba zabývá.","da":"Indsatsområde, ekspertiseområde osv., inden for hvilket en person er engageret.","de":"Ein Tätigkeitsfeld, ein Wissensgebiet und so weiter, in dem eine Person tätig ist.","de":"Ein Tätigkeitsfeld, ein Wissensgebiet und so weiter, in dem eine Person tätig ist.","el":"Ένα πεδίο δραστηριοποίησης, μια περιοχή ειδίκευσης κ.λπ. με την οποία το φυσικό πρόσωπο εμπλέκεται ή εμπλεκόταν.","en":"A field of endeavor, area of expertise, etc., in which a person is engaged.","es":"Un campo de actividad, área de especialidad, etc., en la que participa una persona.","et":"Tegevus- või eriala, millega isik tegeleb või on tegelnud.","fi":"Ala, jolla henkilö toimii tai on toiminut, tai jonka asiantuntija tms. hän on.","fr":"Champ d’activité, domaine d’expertise, etc. dans lequel une personne évolue.","hu":"Egy tevékenység, szakterület, illetékességi, felelősségi, joghatósági, stb. terület, amely iránt a személy elkötelezett.","it":"Campo di impegno, area di competenza, etc. nella quale una persona è impegnata.","lv":"Personas darbības joma, kurā tā iesaistīta.","nl":"Een veld van inspanning, vakgebied etc. waarbij een persoon betrokken is.","no":"Et arbeidsfelt, et ekspertiseområde, etc., som en person er involvert i.","tr":"Bir kişinin meşgul olduğu bir uğraş, uzmanlık alanı vb.","zh-Hans-CN":"一个个人所从事的努力的领域和专长范围等"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfPerson.en","instructionNumber":"9.15","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50387", "lexicalAlias":"http://rdaregistry.info/Elements/a/fieldOfActivityOfAgent.en", "label":"has field of activity of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50100", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/fieldOfActivityOfPerson.en", "label":"has field of activity of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50100", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/fieldOfActivityOfPerson.en", "label":"has field of activity of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50103","label":{"ar":"له اسم مختلف لشخص","ca":"té com a variant de nom de persona","cs":"má variantní jméno osoby","da":"har variant af navn på person","de":"hat abweichenden Namen einer Person","de":"hat abweichenden Namen einer Person","el":"έχει εναλλακτικό όνομα του φυσικού προσώπου","en":"has variant name of person","es":"tiene variante de nombre de persona","et":"isiku variantnimi","fi":"henkilön varianttinimi","fr":"a pour variante de nom de personne","hu":"személy névváltozata a következő:","it":"ha come nome variante di persona","lv":"personas cits vārds","nl":"heeft variant naam van persoon","no":"har variantform av personnavn","sv":"har variantnamn för personen","tr":"kişinin alternatif ismi ile ilişkilidir","zh-Hans-CN":"有个人的变异名称"},"definition":{"ar":["يربط شخصا باسم شخص لم يُختر كاسم مفضل في تطبيق أو في سياق محدد."],"ca":["Relaciona una persona amb un nomen que és un nom de persona que no se selecciona com a preferent en un context o aplicació específic."],"cs":["Vztahuje osobu k nomen, které je pojmenováním osoby, které není vybráno pro preferenci ve specifické aplikaci nebo kontextu."],"da":["Relaterer en person til et nomen, som er et navn på person, som ikke er valgt som foretrukken i en specifik anvendelse eller kontekst."],"de":["Setzt eine Person in Beziehung zu einem Namen einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext nicht als Vorzugsform bestimmt wird.,Setzt eine Person in Beziehung zu einem Namen einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext nicht als Vorzugsform bestimmt wird."],"el":["Συνδέει ένα φυσικό πρόσωπο με ένα όνομα ή μια μορφή ονόματος με την οποία το φυσικό πρόσωπο είναι γνωστό, η οποία διαφέρει από το όνομα ή τη μορφή ονόματος που έχει επιλεγεί ως το προτιμώμενο όνομα."],"en":["Relates a person to a nomen that is a name of person that is not selected for preference in a specific application or context."],"es":["Relaciona una persona con un nomen que es un nombre de persona que no es seleccionado para preferencia en una aplicación o contexto específico."],"et":["Seostab isiku isiku nimega, mis kindlas rakenduses või kontekstis ei ole valitud eelistatuks."],"fi":["Liittää henkilön nomeniin, joka on henkilön nimi, jota ei ole valittu henkilön ensisijaiseksi nimeksi tietyssä sovelluksessa tai kontekstissa."],"fr":["Met une personne en relation avec un nomen qui est un nom de personne ne faisant pas l’objet d’un choix privilégié dans une application ou un contexte spécifiques."],"hu":["Hozzákapcsol egy személyt egy személynév nomenhez, amelyet egy bizonyos alkalmazásban vagy kontextusban nem részesítenek előnyben."],"it":["Correla una persona a un nome di persona non scelto come preferito in una specifica applicazione o contesto."],"lv":["Sasaista personu ar nomenu, kas ir personas vārds, kurš nav izvēlēts kā prioritārs noteiktā lietojumprogrammā vai kontekstā."],"nl":["Relateert een persoon aan een nomen dat is een naam van persoon die niet de voorkeur heeft gekregen in een specifieke applicatie of context."],"no":["Relaterer en person til et navn for person som ikke er valgt som preferanse i en bestemt applikasjon eller kontekst."],"tr":["Bir kişiyi, özel uygulama veya içerikte kullanılması tercih edilmeyen diğer ismiyle ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个作为个人名称并不在特定应用或语境下优先选用的命名关联起来。"]},"ToolkitLabel":{"ar":"اسم مختلف للشخص","ca":"variant de nom de persona","cs":"variantní jméno osoby","da":"variant af navn på person","de":"Abweichender Name einer Person","de":"Abweichender Name einer Person","el":"εναλλακτικό όνομα του φυσικού προσώπου","en":"variant name of person","es":"variante de nombre de persona","et":"isiku variantnimi","fi":"henkilön varianttinimi","fr":"variante de nom de personne","hu":"személy névváltozata:","it":"ha come nome variante di persona","lv":"personas cits vārds","nl":"variant naam van persoon","no":"variantform av personnavn","sv":"variantnamn för personen","tr":"kişinin alternatif ismi","zh-Hans-CN":"个人的变异名称"},"ToolkitDefinition":{"ar":"اسم عائلة اختير اسما مفضلا في تطبيق أو في سياق محدد.","ca":"Nomen que és un nom de persona que no se selecciona com a preferent en un context o aplicació específic.","cs":"Nomen, které je pojmenováním osoby, které není vybráno pro preferenci ve specifické aplikaci nebo kontextu.","da":"Nomen, som er et navn på person, som ikke er valgt som foretrukken i en specifik anvendelse eller kontekst.","de":"Ein Name einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext nicht als Vorzugsform bestimmt wird.","de":"Ein Name einer Person, der in einer bestimmten Anwendung oder in einem bestimmten Kontext nicht als Vorzugsform bestimmt wird.","el":"Ένα όνομα ή μια μορφή ονόματος με την οποία το φυσικό πρόσωπο είναι γνωστό, η οποία διαφέρει από το όνομα ή τη μορφή ονόματος που έχει επιλεγεί ως το προτιμώμενο όνομα.","en":"A nomen that is a name of person that is not selected for preference in a specific application or context.","es":"Un nomen que es un nombre de persona que no es seleccionado para preferencia en una aplicación o contexto específico.","et":"Isiku nimi, mis kindlas rakenduses või kontekstis ei ole valitud eelistatuks.","fi":"Nomen, joka on nimi, jota ei ole valittu henkilön ensisijaiseksi nimeksi tietyssä sovelluksessa tai kontekstissa.","fr":"Nomen qui est un nom de personne ne faisant pas l’objet d’un choix privilégié dans une application ou un contexte spécifiques.","hu":"Egy személynév nomen, amelyet egy bizonyos alkalmazásban vagy kontextusban nem részesítenek előnyben.","it":"Nome di persona non scelto come preferito in una specifica applicazione o contesto.","lv":"Personas vārds, kurš nav izvēlēts kā prioritārs noteiktā lietojumprogrammā vai kontekstā.","nl":"Een nomen dat is een naam van persoon die niet de voorkeur heeft gekregen in een specifieke applicatie of context.","no":"Et navn for person som ikke er valgt som preferanse i en bestemt applikasjon eller kontekst.","tr":"Belirli bir uygulamada veya bağlamda tercih için seçilmemiş kişi adı olan bir isim.","zh-Hans-CN":"一个作为个人名称并不在特定应用或语境下优先选用的命名"},"note":{"da":["Variantnavn for person inkluderer et navn eller navneform, der bruges af en person eller der findes i kilder, et navn der er resultatet af en anderledes translitteration etc."],"de":["Zu einem abweichenden Namen einer Person gehört ein Name oder eine Namensform, der/die von einer Person benutzt wird/werden oder wie er/sie in Nachschlagewerken gefunden wird/werden oder ein Name der sich aus einer abweichenden Transliteration ergibt usw."],"el":["Το εναλλακτικό όνομα για το φυσικό πρόσωπο περιλαμβάνει ένα όνομα ή μια μορφή ονόματος που χρησιμοποιείται από ένα φυσικό πρόσωπο ή εντοπίζεται στις πηγές αναφοράς, ένα όνομα που προκύπτει από έναν διαφορετικό μεταγραμματισμό ενός ονόματος κ.λπ."],"fi":["Varianttinimi käsittää nimen tai nimimuodon, jota on käytetty tietolähteissä, eri tavoin translitteroidun nimimuodon tms."],"fr":["Une variante de nom de personne comprend un nom ou une forme de nom utilisée par une personne ou trouvée dans les sources de référence, un nom qui résulte d’une translittération différente d’un nom, etc."]},"altLabel":{"ar":["اسم مختلف للشخص"],"cs":["variantní jméno pro osobu"],"da":["variantnavn for person"],"de":["Abweichender Name für einer Person,Abweichender Name für einer Person"],"en":["variant name for person"],"es":["variante de nombre para persona"],"fi":["-"],"hu":["személy névvariánsa:"],"nl":["variant naam voor persoon"],"tr":["kişi için alternatif isim"],"zh-Hans-CN":["给个人的变异名称"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
