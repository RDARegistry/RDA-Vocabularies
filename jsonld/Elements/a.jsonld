                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50691", "lexicalAlias":"http://rdaregistry.info/Elements/a/artistCollectiveAgentOf.en", "label":"is artist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50247", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistAgentOf.en", "label":"is book artist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50846", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistCorporateBodyOf.en", "label":"is book artist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50997", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookArtistFamilyOf.en", "label":"is book artist family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50695", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/bookArtistCollectiveAgentOf.en", "label":"is book artist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50695", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/bookArtistCollectiveAgentOf.en", "label":"is book artist collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50846","label":{"ar":"هي هيئة رسّامة كتب مصورة لـ","ca":"és entitat corporativa artista de llibre d’art de","cs":"je knižním výtvarníkem (korporací) (čeho)","da":"er korporation, som er bogkunstner af","de":"ist Körperschaft als Buchkünstlerin/Buchkünstler von","de":"ist Körperschaft als Buchkünstlerin/Buchkünstler von","el":"είναι βιβλίο του καλλιτέχνη συλλογικό όργανο του ?","en":"is book artist corporate body of","es":"es organismo corporativo artista del libro de","et":"raamatukunstnik (asutus) teoses","fi":"kirjataiteilija (yhteisö) teoksessa","fr":"est une collectivité artiste du livre de","hu":"könyvművész testülete a következőnek:","it":"è book artist ente di","lv":"ir grāmatu mākslinieks (institūcija)","nl":"is boekkunstenaar-corporatie van","no":"er bokkunstner for (korporasjon)","tr":"kitap sanatçısı tüzel kişisidir","zh-Hans-CN":"是……的图书美术家团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن استغلال شكل الكتاب أو تغيير بنيته المادية."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en l’explotació de la forma llibre o en la modificació de la seva estructura física."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za zpracování podoby knihy nebo změnu její fyzické struktury."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for at udnytte bogformen eller ændre dens fysiske struktur."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for exploiting the book form or altering its physical structure."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad de un organismo corporativo de explotar la forma del libro o alterar su estructura física."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à exploiter la forme livre ou à modifier sa structure physique."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége a könyvforma kiaknázásáért vagy fizikai szerkezetének megváltoztatásáért."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente per la valorizzazione del formato del libro o l'alterazione della sua struttura fisica."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par grāmatas formas izmantošanu vai tās fiziskās struktūras pārveidošanu."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het benutten van de vorm van het boek of veranderen van de fysieke structuur."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av å utnytte bokformatet eller endre dets fysiske struktur."],"tr":["Bir tüzel kişiyi, kitap biçiminden yararlanma veya fiziksel yapısını değiştirme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及开发图书外形或改变其物理结构的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة رسامة كتب مصورة لـ","ca":"entitat corporativa artista de llibre d’art de","cs":"knižní výtvarník (korporace) (čeho)","da":"korporation, som er bogkunstner af","de":"Körperschaft als Buchkünstlerin/Buchkünstler von","de":"Körperschaft als Buchkünstlerin/Buchkünstler von","el":"βιβλίο του καλλιτέχνη συλλογικό όργανο του ?","en":"book artist corporate body of","es":"organismo corporativo artista del libro de","et":"raamatukunstnik (asutus) teoses","fi":"kirjataiteilija (yhteisö) teoksessa","fr":"collectivité artiste du livre de","hu":"könyvművész testülete:","it":"book artist ente di","lv":"ir grāmatu mākslinieks (institūcija)","nl":"boekkunstenaar-corporatie van","no":"bokkunstner for (korporasjon)","tr":"kitap sanatçısı tüzel kişisi","zh-Hans-CN":"……的图书美术家团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن استغلال شكل الكتاب أو تغيير بنيته المادية.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en l’explotació de la forma llibre o en la modificació de la seva estructura física.","cs":"Dílo, které zahrnuje odpovědnost korporace za zpracování podoby knihy nebo změnu její fyzické struktury.","da":"Værk, som involverer en korporations ansvar for at udnytte bogformen eller ændre dens fysiske struktur.","de":"Ein Werk, bei dem eine Körperschaft für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","en":"A work that involves a responsibility of a corporate body for exploiting the book form or altering its physical structure.","es":"Una obra que involucra una responsabilidad de un organismo corporativo de explotar la forma del libro o alterar su estructura física.","et":"Teos, mis sisaldab asutuse vastutust raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.","fi":"Teos, jossa yhteisö on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à exploiter la forme livre ou à modifier sa structure physique.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége a könyvforma kiaknázásáért vagy fizikai szerkezetének megváltoztatásáért.","it":"Opera che implica una responsabilità di un ente per la valorizzazione del formato del libro o l'alterazione della sua struttura fisica.","lv":"Darbs, kas ietver institūcijas atbildību par grāmatas formas izmantošanu vai tās fiziskās struktūras pārveidošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.","no":"Et verk som involverer et ansvar for en korporasjon i form av å utnytte bokformatet eller endre dets fysiske struktur.","tr":"Kitap biçiminden yararlanmak veya fiziksel yapısını değiştirmek için bir tüzel kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及开发图书外形或改变其物理结构的一个团体的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
