                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/musicProgrammerCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50925", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCorporateBodyToPerformanceOf.en", "label":"is contributor corporate body to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50772", "lexicalAlias":"http://rdaregistry.info/Elements/a/musicProgrammerCollectiveAgentOf.en", "label":"is music programmer collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50923", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/musicProgrammerCorporateBodyOf.en", "label":"is music programmer corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50923", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/musicProgrammerCorporateBodyOf.en", "label":"is music programmer corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51074","label":{"ar":"هي عائلة مبرمجة موسيقى لـ","ca":"és família programadora de música de","cs":"je hudebním programátorem (rodinou) (čeho)","da":"er familie, som er musikprogrammør af","de":"ist Familie als Musik-Programmiererin/Musik-Programmierer von","de":"ist Familie als Musik-Programmiererin/Musik-Programmierer von","el":"είναι μουσικός προγραμματιστής οικογένεια του","en":"is music programmer family of","es":"es familia programadora musical de","et":"muusikaprogrammeerija (perekond) väljenduses","fi":"musiikkiohjelmoija (suku) ekspressiossa","fr":"est une famille programmeuse musicale de","hu":"zeneprogramozó családja a következőnek:","it":"è programmatore musicale famiglia di","lv":"ir mūzikas programmētājs (dzimta/ģimene)","nl":"is muziekprogrammeur-familie van","no":"er musikkprogrammerer for (familie)","tr":"müzik programcısı ailesidir","zh-Hans-CN":"是……的音乐编程者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في استخدام أجهزة الصوت الإلكترونية أو برمجيات الحاسب لتوليد أصوات."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família usant mecanismes electrònics àudio o programari d’ordinador per generar sons."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že používá elektronická zvuková zařízení nebo počítačový software k vytváření zvuků."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at bruge elektronisk lydapparatur eller computersoftware til at generere lyd."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie durch das Einsetzen elektronischer Audio-Geräte oder von Computerprogrammen Klangeffekte erzeugt.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie durch das Einsetzen elektronischer Audio-Geräte oder von Computerprogrammen Klangeffekte erzeugt."],"el":["Συνδέει μια οικογένεια με μια έκφραση που περιλαμβάνει μια συνεισφορά από μια οικογένεια μέσω της χρήσης ηλεκτρονικών συσκευών ήχου ή λογισμικού υπολογιστή για την παραγωγή ήχων."],"en":["Relates a family to an expression that includes a contribution by a family of using electronic audio devices or computer software to generate sounds."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de utilizar dispositivos electrónicos de audio o software de computadora para generar sonidos."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, tekitades helisid elektrooniliste audioseadmete või arvutitarkvara abil."],"fi":["Liittää suvun ekspressioon, jossa suku on osallisena musiikkiteoksen ekspression tekemisessä tuottamalla ääniä sähköisillä äänilaitteilla tai tietokoneohjelmilla."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à utiliser des appareils audio électroniques ou un logiciel pour générer des sons."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését hangok generálásában elektronikus audioeszközök vagy számítógépes szoftver használatával."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nell'utilizzo di dispositivi audio elettronici o software per generare suoni."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, izmantojot elektroniskas audioierīces un/vai datora programmatūru, lai radītu skaņu."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een actor door gebruik van elektronische geluidsapparatuur of computersoftware om geluiden te genereren."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å bruke elektroniske lydenheter eller programvare til å lage lyder."],"tr":["Bir aileyi, ses üretmek için elektronik ses cihazları veya bilgisayar yazılımı kullanan bir ailenin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括使用电子音频设备或计算机软件产生声音的一个家族的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة مبرمجة موسيقى","ca":"família programadora de música de","cs":"hudební programátor (rodina) (čeho)","da":"familie, som er musikprogrammør af","de":"Familie als Musik-Programmiererin/Musik-Programmierer von","de":"Familie als Musik-Programmiererin/Musik-Programmierer von","el":"μουσικός προγραμματιστής οικογένεια του","en":"music programmer family of","es":"familia programadora musical de","et":"muusikaprogrammeerija (perekond) väljenduses","fi":"musiikkiohjelmoija (suku) ekspressiossa","fr":"famille programmeuse musicale de","hu":"zeneprogramozó családja:","it":"programmatore musicale famiglia di","lv":"ir mūzikas programmētājs (dzimta/ģimene)","nl":"muziekprogrammeur-familie van","no":"mu