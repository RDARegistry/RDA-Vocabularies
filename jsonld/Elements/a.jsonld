                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50481", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedEntityOfFamily.en", "label":"has related entity of family"},{"@id":"http://rdaregistry.info/Elements/a/P50360", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedRDAEntityOfCollectiveAgent.en", "label":"has related RDA entity of collective agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/relatedRDAEntityOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50324", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedAgentOfFamily.en", "label":"has related agent of family"},{"@id":"http://rdaregistry.info/Elements/a/P50354", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPlaceOfFamily.en", "label":"has related place of family"},{"@id":"http://rdaregistry.info/Elements/a/P50355", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedTimespanOfFamily.en", "label":"has related timespan of family"},{"@id":"http://rdaregistry.info/Elements/a/P50321", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedExpressionOfFamily.en", "label":"has related expression of family"},{"@id":"http://rdaregistry.info/Elements/a/P50322", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedManifestationOfFamily.en", "label":"has related manifestation of family"},{"@id":"http://rdaregistry.info/Elements/a/P50320", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfFamily.en", "label":"has related work of family"},{"@id":"http://rdaregistry.info/Elements/a/P50356", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedNomenOfFamily.en", "label":"has related nomen of family"},{"@id":"http://rdaregistry.info/Elements/a/P50323", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfFamily.en", "label":"has related item of family"},{"@id":"http://rdaregistry.info/Elements/a/object/P50319", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/relatedRDAEntityOfFamily.en", "label":"has related RDA entity of family"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50319", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/relatedRDAEntityOfFamily.en", "label":"has related RDA entity of family"}]},{"@id":"http://rdaregistry.info/Elements/a/P50310","label":{"ar":"له كيان \"وام\" مرتبط بشخص","ca":"té com a entitat RDA relacionada amb una persona","cs":"má RDA entitu související s osobou","da":"har RDA-entitet relateret til person","de":"hat mit Person in Beziehung stehende RDA-Entität","de":"hat mit Person in Beziehung stehende RDA-Entität","el":"έχει σχετική RDA οντότητα του φυσικού προσώπου","en":"has related RDA entity of person","es":"tiene entidad RDA relacionada de persona","et":"isikuga seotud RDA olem","fi":"henkilöön liittyvä RDA-entiteetti","fr":"a pour entité RDA en relation avec une personne","hu":"személyhez kapcsolódó RDA-entitás a következő:","it":"ha come entità RDA correlata di persona","lv":"ar personu saistītā RDA entīte","nl":"heeft gerelateerde RDA-entiteit van persoon","no":"har RDA-entitet relatert til person","tr":"kişinin ilgili RDA varlığı ile ilişkilidir","zh-Hans-CN":"有个人的关联RDA实体"},"definition":{"ar":["يربط شخصا بكيان \"وام\" مرتبط بشخص."],"ca":["Relaciona una persona amb una entitat RDA que s’associa amb una persona."],"cs":["Vztahuje osobu k RDA entitě spojené s osobou."],"da":["Relaterer en person til en RDA-entitet, som er knyttet til en person."],"de":["Setzt eine Person in Beziehung zu einer RDA-Entität, die mit einer Person in Verbindung steht.,Setzt eine Person in Beziehung zu einer RDA-Entität, die mit einer Person in Verbindung steht."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια οντότητα η οποία συνδέεται με ένα περιγραφόμενο φυσικό πρόσωπο."],"en":["Relates a person to an RDA entity associated with a person."],"es":["Relaciona una persona con una entidad RDA asociada con una persona."],"et":["Seostab isiku isikuga seotud RDA olemiga."],"fi":["Liittää henkilön RDA-entiteettiin, joka liittyy henkilöön."],"fr":["Met une personne en relation avec une entité RDA qui est associée à une personne."],"hu":["Hozzákapcsol egy személyt egy személyhez kapcsolódó RDA-entitáshoz."],"it":["Correla un agente a un agente associato a un agente."],"lv":["Sasaista personu ar RDA entīti, kas saistīta ar personu."],"nl":["Relateert een persoon aan een RDA-entiteit die is geassocieerd met een persoon."],"no":["Relaterer en person til en RDA-entitet som forbindes med en person."],"tr":["Bir kişiyi, kişiyle bağlantılı olan bir RDA varlığıyla ilişkilendirir."],"zh-Hans-CN":["将一个个人与和一个个人相关的一个RDA实体关联起来。"]},"ToolkitLabel":{"ar":"كيان \"وام\" مرتبط بشخص","ca":"entitat RDA relacionada amb una persona","cs":"RDA entita související s osobou","da":"RDA-entitet relateret til person","de":"Mit Person in Beziehung stehende RDA-Entität","de":"mit Person in Beziehung stehende RDA-Entität","el":"σχετική RDA οντότητα του φυσικού προσώπου","en":"related RDA entity of person","es":"entidad RDA relacionada de persona","et":"isikuga seotud RDA olem","fi":"henkilöön liittyvä RDA-entiteetti","fr":"entité RDA en relation avec une personne","hu":"személyhez kapcsolódó RDA-entitás:","it":"entità RDA correlata di persona","lv":"ar personu saistītā RDA entīte","nl":"gerelateerde RDA-entiteit van persoon","no":"RDA-entitet relatert til person","tr":"Kişinin RDA varlığıyla ilişkisi","zh-Hans-CN":"个人的关联RDA实体"},"ToolkitDefinition":{"ar":"كيان \"وام\" مرتبط بشخص.","ca":"Entitat RDA que s’associa amb una persona.","cs":"RDA entita, která je spojena s agentem.","da":"RDA-entitet, som er knyttet til en person.","de":"Eine RDA-Entität, die mit einer Person in Verbindung steht.","de":"Eine RDA-Entität, die mit einer Person in Verbindung steht.","en":"An RDA entity that is associated with a person.","es":"Una entidad RDA que está asociada con una persona.","et":"Isikuga seotud RDA olem.","fi":"RDA-entiteetti, joka liittyy henkilöön.","fr":"Entité RDA qui est associée à une personne.","hu":"Személyhez kapcsolódó RDA-entitás.","it":"Entità RDA associata a una persona.","lv":"RDA entīte, kas saistīta ar personu.","nl":"Een RDA-entiteit die is geassocieerd met een persoon.","no":"En RDA-entitet som forbindes med en person.","tr":"Bir kişiyle bağlantılı olan bir RDA varlığı..","zh-Hans-CN":"和一个个人相关的一个RDA实体"},"altLabel":{"fi":["henkilöön liittyvä entiteetti"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50482", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedEntityOfPerson.en", "label":"has related entity of person"},{"@id":"http://rdaregistry.info/Elements/a/P50304", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedRDAEntityOfAgent.en", "label":"has related RDA entity of agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/relatedRDAEntityOfPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50315", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedAgentOfPerson.en", "label":"has related agent of person"},{"@id":"http://rdaregistry.info/Elements/a/P50346", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedPlaceOfPerson.en", "label":"has related place of person"},{"@id":"http://rdaregistry.info/Elements/a/P50347", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedTimespanOfPerson.en", "label":"has related timespan of person"},{"@id":"http://rdaregistry.info/Elements/a/P50312", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedExpressionOfPerson.en", "label":"has related expression of person"},{"@id":"http://rdaregistry.info/Elements/a/P50313", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedManifestationOfPerson.en", "label":"has related manifestation of person"},{"@id":"http://rdaregistry.info/Elements/a/P50311", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedWorkOfPerson.en", "label":"has related work of person"},{"@id":"http://rdaregistry.info/Elements/a/P50348", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedNomenOfPerson.en", "label":"has related nomen of person"},{"@id":"http://rdaregistry.info/Elements/a/P50314", "lexicalAlias":"http://rdaregistry.info/Elements/a/relatedItemOfPerson.en", "label":"has related item of person"},{"@id":"http://rdaregistry.info/Elements/a/object/P50310", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/relatedRDAEntityOfPerson.en", "label":"has related RDA entity of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50310", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/relatedRDAEntityOfPerson.en", "label":"has related RDA entity of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50293","label":{"ar":"هو وكيل فنان ريميكس لـ","ca":"és agent artista de remescla de","cs":"je remixérem (agentem) (čeho)","da":"er agent, som er remixer af","de":"ist Akteur als Remix Artist von","de":"ist Akteur als Remix Artist von","el":"είναι καλλιτέχνης διασκευών φορέας του","en":"is remix artist agent of","es":"es agente artista de remix de","et":"remiksija (tegija) teoses","fi":"uudelleenmiksaaja (toimija) teoksessa","fr":"est un agent remixeur de","hu":"remixművész ágense a következőnek:","it":"è artista di remix agente di","lv":"ir remiksa mākslinieks (aģents)","nl":"is remixartiest-actor van","no":"er remikser av (agent)","tr":"remix sanatçısı temsilcisidir","zh-Hans-CN":"是……的合成艺术家行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist."],"el":["Συνδέει έναν φορέα με ένα ακουστικό έργο που δημιουργήθηκε μέσω του χειρισμού, της επανασύνθεσης, της μίξης και της αναπαραγωγής προηγούμενα ηχογραφημένων ήχων."],"en":["Relates an agent to a work that involves a responsibility of an agent for manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de manipular, recombinar, mezclar y reproducir sonidos previamente grabados."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à manipuler, recombiner, mixer et reproduire des sons préalablement enregistrés."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért."],"it":["Correla un agente a un'opera che implica la responsabilità di un agente nel manipolare, ricombinare, mescolare e riprodurre suoni precedentemente registrati."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent for manipulering, sammensetting, miksing og reproduksjon av tidligere innspilt lyd."],"tr":["Bir temsilciyi, önceden kaydedilmiş sesleri düzenlemek, yeniden birleştirmek, karıştırmak ve çoğaltmakla görebli bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及操纵、重新组合、混合和复制事先录制的声音的一个行为者的责任的一种作品关联起来。"]},"note":{"ar":["تُستبعد أنشطة إعادة المزج التي لا تغير بصورة جوهرية طبيعة ومحتوى العمل الأصلي، وأنشطة مزج المسارات المسجلة لكي تبدو مسارا واحدا مستمرا."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"el":["Δεν περιλαμβάνονται οι διαδικασίες μείξης, οι οποίες δεν μεταβάλλουν ουσιαστικά τη φύση και το περιεχόμενο του αρχικού έργου και η μείξη ηχογραφημένων κομματιών [με τέτοιον τρόπο], ώστε [αυτά] να εμφανίζονται ως ένα ενιαίο κομμάτι."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Actividades de remix que no cambian sustancialmente la naturaleza y contenido de la obra original, y mezclar juntas pistas grabadas para que parezcan una pista continua, se excluyen."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse le attività di rimissaggio che non cambiano in modo sostanziale la natura e il contenuto dell'opera originale, e il missaggio di tracce registrate insieme per risultare come una traccia continua."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van de oorspronkelijke resource niet substantieel wijzigen, resulterend in een nieuwe resource, en mixen en samenstellen van meerdere sporen van een opname zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"ToolkitLabel":{"ar":"وكيل فنان ريميكس","ca":"agent artista de remescla de","cs":"remixér (agent) (čeho)","da":"agent, som er remixer af","de":"Akteur als Remix Artist von","de":"Akteur als Remix Artist von","el":"καλλιτέχνης διασκευών φορέας του","en":"remix artist agent of","es":"agente artista de remix de","et":"remiksija (tegija) teoses","fi":"uudelleenmiksaaja (toimija) teoksessa","fr":"agent remixeur de","hu":"remixművész ágense:","it":"artista del remix agente di","lv":"ir remiksa mākslinieks (aģents)","nl":"remixartiest-actor van","no":"remikser av (agent)","tr":"remiks sanatçısı temsilci","zh-Hans-CN":"……的合成艺术家行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها.","ca":"Obra que implica una responsabilitat d’un agent en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Dílo, které zahrnuje odpovědnost agenta za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků.","da":"Værk, som involverer en agents ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein Werk, bei dem ein Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","de":"Ein Werk, bei dem ein Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","el":"Ένα ακουστικό έργο που δημιουργήθηκε μέσω του χειρισμού, της επανασύνθεσης, της μίξης και της αναπαραγωγής προηγούμενα ηχογραφημένων ήχων.","en":"A work that involves a responsibility of an agent for manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una obra que involucra una responsabilidad de un agente de manipular, recombinar, mezclar y reproducir sonidos previamente grabados.","et":"Teos, mis sisaldab tegija vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest.","fi":"Teos, jossa toimija on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent consistant à manipuler, recombiner, mixer et reproduire des sons préalablement enregistrés.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért.","it":"Opera che implica la responsabilità di un agente nel manipolare, ricombinare, mescolare e riprodurre suoni precedentemente registrati.","lv":"Darbs, kas ietver aģenta atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"Et verk som involverer ansvar for en agent for manipulering, sammensetting, miksing og reproduksjon av tidligere innspilt lyd.","tr":"Önceden kaydedilmiş sesleri düzenleme, yeniden birleştirme, miksleme ve yeniden üretmek için bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及操纵、重新组合、混合和复制事先录制的声音的一个行为者的责任的一种作品"},"altLabel":{"ar":["فنان ريميكس"],"ca":["artista de remescla de"],"cs":["remixér (čeho)"],"da":["remixer af"],"de":["Remix Artist von,Remix Artist von"],"el":["καλλιτέχνης remix του"],"en":["remix artist of"],"es":["artista de remix de"],"et":["remiksija teoses"],"fi":["äänitaiteilijana ääniteoksessa"],"fr":["remixeur de"],"hu":["remixművésze:"],"it":["artista del remix di"],"nl":["remixartiest van"],"no":["remikser av"],"tr":["remiks sanatçısı"],"zh-Hans-CN":["……的合成艺术家"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50298", "lexicalAlias":"http://rdaregistry.info/Elements/a/djAgentOf.en", "label":"is DJ agent of"}],"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50204", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorAgentOfWorkOf.en", "label":"is creator agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50699", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistCollectiveAgentOf.en", "label":"is remix artist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50548", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistPersonOf.en", "label":"is remix artist person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50293", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/remixArtistAgentOf.en", "label":"is remix artist agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50293", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/remixArtistAgentOf.en", "label":"is remix artist agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50699","label":{"ar":"هو وكيل جماعي فنان ريميكس لـ","ca":"és agent col·lectiu artista de remescla de","cs":"je remixérem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er remixer af","de":"ist gemeinschaftlicher Akteur als Remix Artist von","de":"ist gemeinschaftlicher Akteur als Remix Artist von","el":"είναι remix καλλιτέχνης συλλογικός φορέας του","en":"is remix artist collective agent of","es":"es agente colectivo artista de remezclas de","et":"remiksija (kollektiiv) teoses","fi":"uudelleenmiksaaja (yhteistoimija) teoksessa","fr":"est un agent collectif remixeur de","hu":"remixművész kollektív ágense a következőnek:","it":"è artista di remix agente collettivo di","lv":"ir remiksa mākslinieks (grupa)","nl":"is remixartiest-collectieve actor van","no":"er remikser av (kollektiv agent)","tr":"remix sanatçısı kolektif temsilcisidir","zh-Hans-CN":"是……的合成艺术家集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بعمل يترتب عليه مسئولية وكيل جماعي عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها."],"ca":["Relaciona un agent col·lectiu amb una obra que implica una responsabilitat d’un agent col·lectiu en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje kolektivního agenta k dílu, které zahrnuje odpovědnost kolektivního agenta za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků."],"da":["Relaterer en kollektiv agent til et værk, som involverer en kollektiv agents ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einem Werk, bei dem ein gemeinschaftlicher Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist."],"en":["Relates a collective agent to a work that involves a responsibility of a collective agent for manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona un agente colectivo con una obra que involucra la responsabilidad de un agente colectivo de manipular, recombinar, mezclar y reproducir sonidos previamente grabados."],"et":["Seostab kollektiivi teosega, mis sisaldab kollektiivi vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest."],"fi":["Liittää yhteistoimijan teokseen, jossa yhteistoimija on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met un agent collectif en relation avec une œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés."],"hu":["Hozzákapcsol egy kollektív ágenst egy műhöz, amelyhez hozzátartozik egy kollektív ágens felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért."],"it":["Correla un agente collettivo a un'opera che implica una responsabilità di un agente collettivo nella manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati."],"lv":["Sasaista grupu ar darbu, kas ietver grupas atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu."],"nl":["Relateert een collectieve actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer en kollektiv agent til et verk som involverer et ansvar for en kollektiv agent i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Kolektif bir temsilciyi, ses kayıtlarının iş durumunu, yeniden birleştirmek, karıştırmak ve yeniden üretmek için kolektif bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及操纵、重新组合、混合和复制事先录制的声音的一个集体行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فنان ريميكس","ca":"agent col·lectiu artista de remescla de","cs":"remixér (kolektivní agent) (čeho)","da":"kollektiv agent, som er remixer af","de":"Gemeinschaftlicher Akteur als Remix Artist von","de":"Gemeinschaftlicher Akteur als Remix Artist von","el":"remix καλλιτέχνης συλλογικός φορέας του","en":"remix artist collective agent of","es":"agente colectivo artista de remezclas de","et":"remiksija (kollektiiv) teoses","fi":"uudelleenmiksaaja (yhteistoimija) teoksessa","fr":"agent collectif remixeur de","hu":"remixművész kollektív ágense:","it":"artista di remix agente collettivo di","lv":"ir remiksa mākslinieks (grupa)","nl":"remixartiest-collectieve actor van","no":"remikser av (kollektiv agent)","tr":"remiks sanatçısı kolektif temsilci","zh-Hans-CN":"……的合成艺术家集体行为者"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل جماعي عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها.","ca":"Obra que implica una responsabilitat d’un agent col·lectiu en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Dílo, které zahrnuje odpovědnost kolektivního agenta za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků.","da":"Værk, som involverer en kollektiv agents ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","de":"Ein Werk, bei dem ein gemeinschaftlicher Akteur für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","en":"A work that involves a responsibility of a collective agent for manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una obra que involucra la responsabilidad de un agente colectivo de manipular, recombinar, mezclar y reproducir sonidos previamente grabados.","et":"Teos, mis sisaldab kollektiivi vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest.","fi":"Teos, jossa yhteistoimija on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Œuvre qui comporte une responsabilité de la part d’un agent collectif consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés.","hu":"Egy mű, amelyhez hozzátartozik egy kollektív ágens felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért.","it":"Opera che implica una responsabilità di un agente collettivo nella manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati.","lv":"Darbs, kas ietver grupas atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een collectieve actor voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"Et verk som involverer et ansvar for en kollektiv agent i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri düzenleme, yeniden birleştirme, miksleme ve yeniden üretmek için kolektif bir temsilcinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及操纵、重新组合、混合和复制事先录制的声音的一个集体行为者的责任的一种作品"},"note":{"ar":["تُستبعد أنشطة إعادة المزج التي لا تغير بشكل جوهري طبيعة ومحتوى العمل الأصلي، وأنشطة مزج المسارات المسجلة لكي تبدو مسارا واحدا مستمرا."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido de la obra original, y la mezcla de pistas grabadas para que aparezcan como una pista continua."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse attività di remix che non modificano sostanzialmente la natura e contenuto dell'opera originale e il missaggio di tracce registrate in modo che appaiano come una traccia continua."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van de oorspronkelijke resource niet substantieel wijzigen, resulterend in een nieuwe resource, en mixen en samenstellen van meerdere sporen van een opname zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50693", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCollectiveAgentOfWorkOf.en", "label":"is creator collective agent of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50293", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistAgentOf.en", "label":"is remix artist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50850", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistCorporateBodyOf.en", "label":"is remix artist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51001", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistFamilyOf.en", "label":"is remix artist family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50699", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/remixArtistCollectiveAgentOf.en", "label":"is remix artist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50699", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/remixArtistCollectiveAgentOf.en", "label":"is remix artist collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50850","label":{"ar":"هي هيئة مسئولة عن الريميكس لـ","ca":"és entitat corporativa artista de remescla de","cs":"je remixérem (korporací) (čeho)","da":"er korporation, som er remixer af","de":"ist Körperschaft als Remix Artist von","de":"ist Körperschaft als Remix Artist von","el":"είναι remix καλλιτέχνης συλλογικό όργανο του","en":"is remix artist corporate body of","es":"es organismo corporativo artista de remix de","et":"remiksija (asutus) teoses","fi":"uudelleenmiksaaja (yhteisö) teoksessa","fr":"est une collectivité remixeuse de","hu":"remixművész testülete a következőnek:","it":"è artista di remix ente di","lv":"ir remiksa mākslinieks (institūcija)","nl":"is remixartiest-corporatie van","no":"er remikser av (korporasjon)","tr":"remix sanatçısı tüzel kişisidir","zh-Hans-CN":"是……的合成艺术家团体"},"definition":{"ar":["يربط هيئة بعمل يترتب عليه مسئولية هيئة عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها."],"ca":["Relaciona una entitat corporativa amb una obra que implica una responsabilitat d’una entitat corporativa en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje korporaci k dílu, které zahrnuje odpovědnost korporace za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků."],"da":["Relaterer en korporation til et værk, som involverer en korporations ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.,Setzt eine Körperschaft in Beziehung zu einem Werk, bei dem eine Körperschaft für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist."],"en":["Relates a corporate body to a work that involves a responsibility of a corporate body for manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona un organismo corporativo con una obra que involucra una responsabilidad de un organismo corporativo de manipular, recombinar, mezclar y reproducir sonidos previamente grabados."],"et":["Seostab asutuse teosega, mis sisaldab asutuse vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest."],"fi":["Liittää yhteisön teokseen, jossa yhteisö on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une collectivité en relation avec une œuvre qui comporte une responsabilité de la part d’une collectivité consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés."],"hu":["Hozzákapcsol egy testületet egy műhöz, amelyhez hozzátartozik egy testület felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért."],"it":["Correla un ente a un'opera che implica una responsabilità di un ente per la manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati."],"lv":["Sasaista institūciju ar darbu, kas ietver institūcijas atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu."],"nl":["Relateert een corporatie aan een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer en korporasjon til et verk som involverer et ansvar for en korporasjon i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir tüzel kişiyi, önceden kaydedilmiş seslerin manipüle edilmesi, yeniden birleştirilmesi, karıştırılması ve yeniden üretilmesi için kurumsal bir organın sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个团体与涉及操纵、重新组合、混合和复制事先录制的声音的一个团体的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"هيئة مسئولة عن الريميكس","ca":"entitat corporativa artista de remescla de","cs":"remixér (korporace) (čeho)","da":"korporation, som er remixer af","de":"Körperschaft als Remix Artist von","de":"Körperschaft als Remix Artist von","el":"remix καλλιτέχνης συλλογικό όργανο του","en":"remix artist corporate body of","es":"organismo corporativo artista de remix de","et":"remiksija (asutus) teoses","fi":"uudelleenmiksaaja (yhteisö) teoksessa","fr":"collectivité remixeuse de","hu":"remixművész testülete:","it":"artista di remix ente di","lv":"ir remiksa mākslinieks (institūcija)","nl":"remixartiest-corporatie van","no":"remikser av (korporasjon)","tr":"remiks sanatçısı tüzel kişi","zh-Hans-CN":"……的合成艺术家团体"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية هيئة عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها.","ca":"Obra que implica una responsabilitat d’una entitat corporativa en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Dílo, které zahrnuje odpovědnost korporace za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků.","da":"Værk, som involverer en korporations ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein Werk, bei dem eine Körperschaft für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","de":"Ein Werk, bei dem eine Körperschaft für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","en":"A work that involves a responsibility of a corporate body for manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una obra que involucra una responsabilidad de un organismo corporativo de manipular, recombinar, mezclar y reproducir sonidos previamente grabados.","et":"Teos, mis sisaldab asutuse vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest.","fi":"Teos, jossa yhteisö on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Œuvre qui comporte une responsabilité de la part d’une collectivité consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés.","hu":"Egy mű, amelyhez hozzátartozik egy testület felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért.","it":"Opera che implica una responsabilità di un ente per la manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati.","lv":"Darbs, kas ietver institūcijas atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een corporatie voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"Et verk som involverer et ansvar for en korporasjon i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri düzenleme, yeniden birleştirme, miksleme ve yeniden üretmek için bir tüzel kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及操纵、重新组合、混合和复制事先录制的声音的一个团体的责任的一种作品"},"note":{"ar":["تُستبعد أنشطة إعادة المزج التي لا تغير بشكل جوهري طبيعة ومحتوى العمل الأصلي، وأنشطة مزج المسارات المسجلة لكي تبدو مسارا واحدا مستمرا."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"el":["Δεν περιλαμβάνονται οι διαδικασίες μείξης, οι οποίες δεν μεταβάλλουν ουσιαστικά τη φύση και το περιεχόμενο του αρχικού έργου και η μείξη ηχογραφημένων κομματιών [με τέτοιον τρόπο], ώστε [αυτά] να εμφανίζονται ως ένα ενιαίο κομμάτι."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Actividades de remix que no cambian sustancialmente la naturaleza y contenido de la obra original, y mezclar juntas pistas grabadas para que parezcan una pista continua, se excluyen."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse attività di remix che non modificano sostanzialmente la natura e contenuto dell'opera originale e il missaggio di tracce registrate in modo che appaiano come una traccia continua."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van de oorspronkelijke resource niet substantieel wijzigen, resulterend in een nieuwe resource, en mixen en samenstellen van meerdere sporen van een opname zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50844", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCorporateBodyOfWorkOf.en", "label":"is creator corporate body of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50699", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistCollectiveAgentOf.en", "label":"is remix artist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50850", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/remixArtistCorporateBodyOf.en", "label":"is remix artist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50850", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/remixArtistCorporateBodyOf.en", "label":"is remix artist corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51001","label":{"ar":"هي عائلة مسئولة عن الريميكس لـ","ca":"és família artista de remescla de","cs":"je remixérem (rodinou) (čeho)","da":"er familie, som er remixer af","de":"ist Familie als Remix Artist von","de":"ist Familie als Remix Artist von","el":"είναι remix καλλιτέχνης οικογένεια του","en":"is remix artist family of","es":"es familia artista de remix de","et":"remiksija (perekond) teoses","fi":"uudelleenmiksaaja (suku) teoksessa","fr":"est une famille remixeuse de","hu":"remixművész családja a következőnek:","it":"è artista di remix famiglia di","lv":"ir remiksa mākslinieks (dzimta/ģimene)","nl":"is remixartiest-familie van","no":"er remikser av (familie)","tr":"remix sanatçısı ailesidir","zh-Hans-CN":"是……的合成艺术家家族"},"definition":{"ar":["يربط عائلة بعمل يترتب عليه مسئولية عائلة عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها."],"ca":["Relaciona una família amb una obra que implica una responsabilitat d’una família en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje rodinu k dílu, které zahrnuje odpovědnost rodiny za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků."],"da":["Relaterer en familie til et værk, som involverer en families ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.,Setzt eine Familie in Beziehung zu einem Werk, bei dem eine Familie für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist."],"en":["Relates a family to a work that involves a responsibility of a family for manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona una familia con una obra que involucra una responsabilidad de una familia de manipular, recombinar, mezclar y reproducir sonidos previamente grabados."],"et":["Seostab perekonna teosega, mis sisaldab perekonna vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest."],"fi":["Liittää suvun teokseen, jossa suku on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une famille en relation avec une œuvre qui comporte une responsabilité de la part d’une famille consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés."],"hu":["Hozzákapcsol egy családot egy műhöz, amelyhez hozzátartozik egy család felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért."],"it":["Correla una famiglia a un'opera che implica una responsabilità di una famiglia per la manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati."],"lv":["Sasaista dzimtu/ģimeni ar darbu, kas ietver dzimtas/ģimenes atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu."],"nl":["Relateert een familie aan een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer en familie til et verk som involverer et ansvar for en familie i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir aileyi, önceden kaydedilmiş sesleri değiştirme, yeniden birleştirme, karıştırma ve çoğaltma sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个家族与涉及操纵、重新组合、混合和复制事先录制的声音的一个家族的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عائلة مسئولة عن الريميكس","ca":"família artista de remescla de","cs":"remixér (rodina) (čeho)","da":"familie, som er remixer af","de":"Familie als Remix Artist von","de":"Familie als Remix Artist von","el":"remix καλλιτέχνης οικογένεια του","en":"remix artist family of","es":"familia artista de remix de","et":"remiksija (perekond) teoses","fi":"uudelleenmiksaaja (suku) teoksessa","fr":"famille remixeuse de","hu":"remixművész családja:","it":"artista di remix famiglia di","lv":"ir remiksa mākslinieks (dzimta/ģimene)","nl":"remixartiest-familie van","no":"remikser av (familie)","tr":"remiks sanatçısı aile","zh-Hans-CN":"……的合成艺术家家族"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية عائلة عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها.","ca":"Obra que implica una responsabilitat d’una família en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Dílo, které zahrnuje odpovědnost rodiny za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků.","da":"Værk, som involverer en families ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein Werk, bei dem eine Familie für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","de":"Ein Werk, bei dem eine Familie für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","en":"A work that involves a responsibility of a family for manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una obra que involucra una responsabilidad de una familia de manipular, recombinar, mezclar y reproducir sonidos previamente grabados.","et":"Teos, mis sisaldab perekonna vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest.","fi":"Teos, jossa suku on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Œuvre qui comporte une responsabilité de la part d’une famille consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés.","hu":"Egy mű, amelyhez hozzátartozik egy család felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért.","it":"Opera che implica una responsabilità di una famiglia per la manipolazione, la ricombinazione, il missaggio e la riproduzione di suoni precedentemente registrati.","lv":"Darbs, kas ietver dzimtas/ģimenes atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een familie voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"Et verk som involverer et ansvar for en familie i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri düzenleme, yeniden birleştirme, miksleme ve yeniden üretmek için bir ailenin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及操纵、重新组合、混合和复制事先录制的声音的一个家族的责任的一种作品"},"note":{"ar":["تُستبعد أنشطة إعادة المزج التي لا تغير بشكل جوهري طبيعة ومحتوى العمل الأصلي، وأنشطة مزج المسارات المسجلة لكي تبدو مسارا واحدا مستمرا."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"el":["Δεν περιλαμβάνονται οι διαδικασίες μείξης, οι οποίες δεν μεταβάλλουν ουσιαστικά τη φύση και το περιεχόμενο του αρχικού έργου και η μείξη ηχογραφημένων κομματιών [με τέτοιον τρόπο], ώστε [αυτά] να εμφανίζονται ως ένα ενιαίο κομμάτι."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Actividades de remix que no cambian sustancialmente la naturaleza y contenido de la obra original, y mezclar juntas pistas grabadas para que parezcan una pista continua, se excluyen."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse attività di remix che non modificano sostanzialmente la natura e contenuto dell'opera originale e il missaggio di tracce registrate in modo che appaiano come una traccia continua."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van de oorspronkelijke resource niet substantieel wijzigen, resulterend in een nieuwe resource, en mixen en samenstellen van meerdere sporen van een opname zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50995", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfWorkOf.en", "label":"is creator family of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50699", "lexicalAlias":"http://rdaregistry.info/Elements/a/remixArtistCollectiveAgentOf.en", "label":"is remix artist collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51001", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/remixArtistFamilyOf.en", "label":"is remix artist family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51001", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/remixArtistFamilyOf.en", "label":"is remix artist family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50548","label":{"ar":"هو شخص فنان ريميكس لـ","ca":"és persona artista de remescla de","cs":"je remixérem (osobou) (čeho)","da":"er person, som er remixer af","de":"ist Person als Remix Artist von","de":"ist Person als Remix Artist von","el":"είναι remix καλλιτέχνης φυσικό πρόσωπο του","en":"is remix artist person of","es":"es persona artista de remixes de","et":"remiksija (isik) teoses","fi":"uudelleenmiksaaja (henkilö) teoksessa","fr":"est une personne remixeuse de","hu":"remixművész személye a következőnek:","it":"è artista di remix persona di","lv":"ir remiksa mākslinieks (persona)","nl":"is remixartiest-persoon van","no":"er remikser av (person)","tr":"remix sanatçısı kişisidir","zh-Hans-CN":"是……的合成艺术家个人"},"definition":{"ar":["يربط شخصا بعمل يترتب عليه مسئولية شخص عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist."],"en":["Relates a person to a work that involves a responsibility of a person for manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona de manipular, recombinar, mezclar y reproducir sonidos previamente grabados."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest."],"fi":["Liittää henkilön teokseen, jossa henkilö on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona nella manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir kişiyi, önceden kaydedilmiş sesleri işleme, yeniden birleştirme, karıştırma ve yeniden üretmeyi içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及操纵、重新组合、混合和复制事先录制的声音的一个个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص فنان ريميكس","ca":"persona artista de remescla de","cs":"remixér (osoba) (čeho)","da":"person, som er remixer af","de":"Person als Remix Artist von","de":"Person als Remix Artist von","el":"remix καλλιτέχνης φυσικό πρόσωπο του","en":"remix artist person of","es":"persona artista de remixes de","et":"remiksija (isik) teoses","fi":"uudelleenmiksaaja (henkilö) teoksessa","fr":"personne remixeuse de","hu":"remixművész személye:","it":"artista di remix persona di","lv":"ir remiksa mākslinieks (persona)","nl":"remixartiest-persoon van","no":"remikser av (person)","tr":"remiks sanatçısı kişi","zh-Hans-CN":"……的合成艺术家个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية شخص عن معالجة المواد السمعية المسجلة مسبقًا وإعادة تجميعها ومزجها واستنساخها.","ca":"Obra que implica una responsabilitat d’una persona en la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Dílo, které zahrnuje odpovědnost osoby za manipulaci, rekombinaci, mixáž a reprodukci dříve nahraných zvuků.","da":"Værk, som involverer en persons ansvar for manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein Werk, bei dem eine Person für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","de":"Ein Werk, bei dem eine Person für das Bearbeiten, Rekombinieren, Mischen und Reproduzieren einer bestehenden Tonaufnahme verantwortlich ist.","en":"A work that involves a responsibility of a person for manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una obra que implica la responsabilidad de una persona de manipular, recombinar, mezclar y reproducir sonidos previamente grabados.","et":"Teos, mis sisaldab isiku vastutust varem salvestatud helide manipuleerimise, ümberkombineerimise, segamise ja taastekitamise eest.","fi":"Teos, jossa henkilö on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à manipuler, à recombiner, à mixer et à reproduire des sons préalablement enregistrés.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége korábbi hangfelvételek manipulálásáért, újrakombinálásáért, keveréséért és reprodukálásáért.","it":"Opera che implica una responsabilità di una persona nella manipolazione, ricombinazione, missaggio e riproduzione di suoni precedentemente registrati.","lv":"Darbs, kas ietver personas atbildību par iepriekš ierakstītas skaņas manipulāciju, pārkombinēšanu, miksēšanu un atkārtotu atskaņošanu.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"Et verk som involverer et ansvar for en person i form av å manipulere, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri düzenleme, yeniden birleştirme, miksleme ve yeniden üretmek için bir kişinin sorumluluğunu içeren bir eser.","zh-Hans-CN":"涉及操纵、重新组合、混合和复制事先录制的声音的一个个人的责任的一种作品"},"note":{"ar":["تُستبعد أنشطة إعادة المزج التي لا تغير بشكل جوهري طبيعة ومحتوى العمل الأصلي، وأنشطة مزج المسارات المسجلة لكي تبدو مسارا واحدا مستمرا."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido de la obra original, así como la mezcla de pistas grabadas para que aparezcan como una pista continua."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse attività di remix che non modificano sostanzialmente la natura e contenuto dell'opera originale e il missaggio di tracce registrate in modo che appaiano come una traccia continua."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van de oorspronkelijke resource niet substantieel wijzigen, resulterend in een nieuwe resource, en mixen en samenstellen van meerdere sporen van een opname zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
