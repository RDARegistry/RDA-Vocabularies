                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/personDescribedWithMetadataBy.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50368", "lexicalAlias":"http://rdaregistry.info/Elements/a/personDescribedBy.en", "label":"is person described by"},{"@id":"http://rdaregistry.info/Elements/a/P51108", "lexicalAlias":"http://rdaregistry.info/Elements/a/agentDescribedWithMetadataBy.en", "label":"is agent described with metadata by"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51112", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/personDescribedWithMetadataBy.en", "label":"is person described with metadata by"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51112", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/personDescribedWithMetadataBy.en", "label":"is person described with metadata by"}]},{"@id":"http://rdaregistry.info/Elements/a/P51113","label":{"ca":"és agent col·leccionista de","cs":"je sběratelem (agentem) (čeho)","de":"ist Akteur als Sammlerin/Sammler von","en":"is collector agent of","es":"es agente recolector de","fi":"muodostaja (toimija) kokoelmalle","fr":"est un agent collectionneur de","hu":"összegyűjtő ágense a következőnek:","nl":"is verzamelaar-actor van","tr":"koleksiyoncu temsilcisidir","zh-Hans-CN":"是……的收藏者行为者"},"definition":{"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la col·lecció d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament"],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za vytvoření sbírky (díla) výběrem a uspořádáním jednotek, které exemplifikují ztvárnění dalších děl."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates an agent to a work that involves a responsibility of an agent for collecting by selecting and arranging items that exemplify the embodiment of other works"],"es":["Relaciona a un agente con una obra que implica la responsabilidad de un agente de recopilar mediante la selección y disposición de elementos que ejemplifiquen la encarnación de otras obras."],"fi":["Liittää toimijan teokseen, jossa toimija vastaa kokoelmateoksen muodostamisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää."],"fr":["Met un agent en relation avec une œuvre de collection de ressources qui comporte une responsabilité de la part d’un agent consistant à sélectionner et arranger des items qui exemplifient la matérialisation d’autres œuvres."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége olyan egységek válogatásással és elredendezéssel való összegyűjtéséért, amelyek más művek megtestesüléseinek példányai"],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor verzamelen door het selecteren en ordenen van items die voorstellen de belichaming van andere werken."],"tr":["Bir temsilciyi, diğer eserlerin somutlaşmasını örnekleyen kopyaları seçerek ve düzenleyerek toplamakla görevli bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及通过选择和整理例证其他作品具体化的单件而进行收藏的一个行为者的责任的一种作品关联起来。"]},"ToolkitLabel":{"ca":"agent col·leccionista de","cs":"sběratel (agent) (čeho)","de":"Akteur als Sammlerin/Sammler von","en":"collector agent of","es":"agente recolector de","fi":"muodostaja (toimija) kokoelmalle","fr":"agent collectionneur de","hu":"összegyűjtő ágense a következőnek:","nl":"verzamelaar-actor van","tr":"koleksiyoncu temsilci","zh-Hans-CN":"……的收藏者行为者"},"ToolkitDefinition":{"ca":"Una obra que implica una responsabilitat d’un agent en la col·lecció d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament","cs":"Dílo, které zahrnuje odpovědnost agenta za vytvoření sbírky (díla) výběrem a uspořádáním jednotek, které exemplifikují ztvárnění dalších děl.","de":"Ein Werk, bei dem ein Akteur für die Aggregation verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","en":"A work that involves a responsibility of an agent for collecting by selecting and arranging items that exemplify the embodiment of other works","es":"Una obra que implica la responsabilidad de un agente de recopilar mediante la selección y disposición de elementos que ejemplifican la encarnación de otras obras.","fi":"Teos, jossa toimija vastaa kokoelmateoksen luomisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää.","fr":"Œuvre de collection de ressources qui comporte une responsabilité de la part d’un agent consistant à sélectionner et arranger des items qui exemplifient la matérialisation d’autres œuvres.","hu":"Egy mű, amelyhez hozzátartozik egy ágens felelőssége olyan egységek válogatásással és elredendezéssel való összegyűjtéséért, amelyek más művek megtestesüléseinek példányai","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor verzamelen door het selecteren en ordenen van items die voorstellen de belichaming van andere werken.","tr":"Diğer eserlerin somutlaşmış halini örnekleyen kopyaları seçip düzenleyerek toplama sorumluluğunu üstlenen bir temsilciyi içeren bir eser.","zh-Hans-CN":"涉及通过选择和整理例证其他作品具体化的单件而进行收藏的一个行为者的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
