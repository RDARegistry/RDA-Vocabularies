                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50449", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorAgentToPerformanceOf.en", "label":"is contributor agent to performance of"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/productionDesignerAgentOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50734", "lexicalAlias":"http://rdaregistry.info/Elements/a/productionDesignerCollectiveAgentOf.en", "label":"is production designer collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50583", "lexicalAlias":"http://rdaregistry.info/Elements/a/productionDesignerPersonOf.en", "label":"is production designer person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50198", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/productionDesignerAgentOf.en", "label":"is production designer agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50198", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/productionDesignerAgentOf.en", "label":"is production designer agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50734","label":{"ar":"هو وكيل جماعي قائد فرقة عزف لـ","ca":"és agent col·lectiu dissenyador de producció de","cs":"je výrobním designérem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er produktionsdesigner af","de":"ist gemeinschaftlicher Akteur als Szenenbildnerin/Szenenbildner von","de":"ist gemeinschaftlicher Akteur als Szenenbildnerin/Szenenbildner von","el":"είναι σχεδιαστής παραγωγής συλλογικός φορέας του","en":"is production designer collective agent of","es":"es agente colectivo diseñador de producción de","et":"kunstnik-lavastaja (kollektiiv) väljenduses","fi":"lavastussuunnittelija (yhteistoimija) ekspressiossa","fr":"est un agent collectif chef décorateur de","hu":"látványtervező kollektív ágense a következőnek:","it":"è designer di produzione agente collettivo di","lv":"ir filmas scenogrāfs (grupa)","nl":"is productieontwerper-collectieve actor van","no":"er produksjonsdesigner for (kollektiv agent)","tr":"yapım tasarımcısı kolektif temsilcisidir","zh-Hans-CN":"是……的制作设计者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي لتصميم المظهر المرئي العام لإنتاج صور متحركة."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu dissenyant l’aparença visual general d’una producció d’imatge en moviment."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta za navrhování celkové vizuální podoby výroby pohyblivého obrazu."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at designe en levende billedproduktions overordnede visuelle udtryk."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er für die Gestaltung des gesamten visuellen Erscheinungsbilds einer Bewegtbildproduktion verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er für die Gestaltung des gesamten visuellen Erscheinungsbilds einer Bewegtbildproduktion verantwortlich ist."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of designing the overall visual appearance of a moving image production."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo al diseño de la apariencia visual general de una producción de imágenes en movimiento."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, kujundades liikuvast pildist koosneva produktsiooni visuaalse üldilme."],"fi":["Liittää yhteistoimijan ekspressioon, johon yhteistoimija osallistuu suunnittelemalla liikkuvan kuvan tuotannon visuaalisen kokonaisilmeen."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à concevoir l’aspect visuel global d’une production d’images animées."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy tervező kollektív ágens közreműködését mozgókép-produkció általános vizuális megjelenésében."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nella progettazione dell'aspetto visivo complessivo di una produzione di immagini in movimento."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, izstrādājot kustīga attēla vispārējo vizuālo izskatu."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door ontwerpen van het totale visuele uiterlijk van een bewegend beeld-productie."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å utforme det generelle visuelle uttrykket til en produksjon med levende bilder."],"tr":["Kolektif bir temsilciyi, bir hareketli görüntü prodüksiyonunun genel görsel tasarımının kolektif bir temsilci tarafından tasarlanmasına katkıda bulunulmasını içeren anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括设计动态图像制作整体视觉效果的一个集体行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مصمم إَنتاج","ca":"agent col·lectiu dissenyador de producció de","cs":"výrobní designér (kolektivní agent) (čeho)","da":"kollektiv agent, som er produktionsdesigner af","de":"Gemeinschaftlicher Akteur als Szenenbildnerin/Szenenbildner von","de":"Gemeinschaftlicher Akteur als Szenenbildnerin/Szenenbildner von","el":"σχεδιαστής παραγωγής συλλογικός φορέας του","en":"production designer collective agent of","es":"agente colectivo di