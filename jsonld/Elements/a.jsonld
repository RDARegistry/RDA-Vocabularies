                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50237", "lexicalAlias":"http://rdaregistry.info/Elements/a/categoryOfCorporateBody.en", "label":"has category of corporate body"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/categoryOfGovernment.en","instructionNumber":"11.7.1.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50238", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/categoryOfGovernment.en", "label":"has category of government"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50238", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/categoryOfGovernment.en", "label":"has category of government"}]},{"@id":"http://rdaregistry.info/Elements/a/P50489","label":{"ar":"له فئة لشخص","ca":"té com a categoria de persona","cs":"má kategorii osoby","da":"har kategori af person","de":"hat Kategorie einer Person","de":"hat Kategorie einer Person","el":"έχει κατηγορία του φυσικού προσώπου","en":"has category of person","es":"tiene categoría de persona","et":"isiku kategooria","fi":"henkilön kategoria","fr":"a pour catégorie de personne","hu":"személy kategóriája a következő:","it":"ha come categoria di persona","lv":"personas kategorija","nl":"heeft categorie van persoon","no":"har kategori for person","tr":"kişinin kategorisi ile ilişkilidir","zh-Hans-CN":"有个人的类别"},"definition":{"ar":["يربط شخصا بالنوع الذي ينتمي إليه شخص."],"ca":["Relaciona una persona amb un tipus al qual pertany una persona."],"cs":["Vztahuje osobu k typu, ke kterému osoba patří."],"da":["Relaterer en person til en type, som en person tilhører."],"de":["Setzt eine Person in Beziehung zu einer Art, zu der eine Person gehört.,Setzt eine Person in Beziehung zu einer Art, zu der eine Person gehört."],"en":["Relates a person to a type to which a person belongs."],"es":["Relaciona a una persona con un tipo al que pertenece."],"et":["Seostab isiku tüübiga, millesse isik kuulub."],"fi":["Liittää henkilön tyyppiin tai jaotteluun, johon henkilö kuuluu."],"fr":["Met une personne en relation avec un type auquel une personne appartient."],"hu":["Hozzákapcsol egy személyt ahhoz a típushoz, amelyhez a személy tartozik."],"it":["Correla una persona a un tipo a cui una persona appartiene."],"lv":["Sasaista personu ar veidu, pie kura pieder persona."],"nl":["Relateert een persoon aan een type waartoe een persoon behoort."],"no":["Relaterer en person til en type som en person tilhører."],"tr":["Bir kişiyi, kişinin ait olduğu tip ile ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个个人所属于的一个类型关联起来。"]},"altLabel":{"ar":["نوع الشخص"],"ca":["tipus de persona"],"cs":["typ osoby"],"da":["type af person"],"el":["τύπος του φυσικού προσώπου"],"en":["type of person"],"es":["tipo de persona"],"et":["isiku tüüp"],"fi":["henkilön tyyppi"],"fr":["type de personne"],"hu":["személy típusa:"],"it":["tipo di persona"],"nl":["type van persoon"],"no":["type person"],"tr":["kişinin türü"],"zh-Hans-CN":["个人的类型"]},"ToolkitLabel":{"ar":"فئة الشخص","ca":"categoria de persona","cs":"kategorie osoby","da":"kategori af person","de":"Kategorie einer Person","de":"Kategorie einer Person","el":"κατηγορία του φυσικού προσώπου","en":"category of person","es":"categoría de persona","et":"isiku kategooria","fi":"henkilön kategoria","fr":"catégorie de personne","hu":"személy kategóriája:","it":"categoria di persona","lv":"personas kategorija","nl":"categorie van persoon","no":"kategori for person","tr":"kişi kategorisi","zh-Hans-CN":"个人的类别"},"ToolkitDefinition":{"ar":"نوع ينتمي إليه شخص.","ca":"Tipus al qual pertany una persona.","cs":"Typ, ke kterému osoba patří.","da":"Type, som en person tilhører.","de":"Eine Art, zu der eine Person gehört.","de":"Eine Art, zu der eine Person gehört.","en":"A type to which a person belongs.","es":"Un tipo al que pertenece una persona.","et":"Tüüp, millesse isik kuulub.","fi":"Tyyppi tai jaottelu, johon henkilö kuuluu.","fr":"Type auquel une personne appartient.","hu":"Egy típus, amelyhez a személy tartozik.","it":"Tipo a cui una persona appartiene.","lv":"Veids, pie kura pieder persona.","nl":"Een type waartoe een persoon behoort.","no":"En type som en person tilhører.","tr":"Bir kişinin ait olduğu bir tür.","zh-Hans-CN":"一个个人所属于的一个类型"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/categoryOfPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50490", "lexicalAlias":"http://rdaregistry.info/Elements/a/categoryOfAgent.en", "label":"has category of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50489", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/categoryOfPerson.en", "label":"has category of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50489", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/categoryOfPerson.en", "label":"has category of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50271","label":{"ar":"هو وكيل مراقب لـ","ca":"és agent censor de","cs":"je cenzorem (agentem) (čeho)","da":"er agent, som er censor af","de":"ist Akteur als Zensorin/Zensor von","de":"ist Akteur als Zensorin/Zensor von","el":"είναι λογοκριτής φορέας του","en":"is censor agent of","es":"es agente censor de","et":"tsensor (tegija) väljenduses","fi":"sensori (toimija) ekspressiossa","fr":"est un agent censeur de","hu":"cenzor ágense a következőnek:","it":"è censore agente di","lv":"ir cenzors (aģents)","nl":"is censor-actor van","no":"er sensor av (agent)","tr":"sansürcü temsilcisidir","zh-Hans-CN":"是……的审查者行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن يُحدث تغييرا جوهريا في طابعه أو في مضمونه العام."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου αναθεωρώντας το περιεχόμενο με σκοπό την απόκρυψη, η οποία θεωρείται μη αποδεκτή σε ηθικό, πολιτικό, στρατιωτικό ή άλλο επίπεδο, αφήνοντας ωστόσο τη φύση και το περιεχόμενο αμετάβλητα, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy ágens közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható tartalom kiküszöbölése céljából, ugyanakkor a jellegzetességeket és általánosságban a tartalmat lényegében változatlanul hagyja."],"it":["Correla un agente a un'espressione che comprende il contributo da parte di un agente nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å redigerer innholdet i et annet uttrykk i den hensikt å fjerne deler som anses som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir temsilciyi, ahlaki, politik, askeri veya diğer gerekçelerle sakıncalı görülen içeriği bastırmak amacıyla başka bir anlatımın içeriğini gözden geçirmeye yönelik bir temsilcinin katkısını içeren, ancak niteliğini ve genel içeriğini büyük ölçüde değiştirmeden bırakan bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个行为者的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل مراقب","ca":"agent censor de","cs":"cenzor (agent) (čeho)","da":"agent, som er censor af","de":"Akteur als Zensorin/Zensor von","de":"Akteur als Zensorin/Zensor von","el":"λογοκριτής φορέας του","en":"censor agent of","es":"agente censor de","et":"tsensor (tegija) väljenduses","fi":"sensori (toimija) ekspressiossa","fr":"agent censeur de","hu":"cenzor ágense:","it":"censore agente di","lv":"ir cenzors (aģents)","nl":"censor-actor van","no":"sensor av (agent)","tr":"sansür temsilcisi","zh-Hans-CN":"……的审查者行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن يُحدث تغييرا جوهريا في طابعه أو في مضمونه العام.","ca":"Expressió que inclou una contribució d’un agent revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny.","da":"Udtryk, som omfatter en agents bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","el":"Μια έκφραση ενός έργου που περιλαμβάνει την ευθύνη της αναθεώρησης του περιεχομένου με σκοπό την απόκρυψη, η οποία θεωρείται μη αποδεκτή σε ηθικό, πολιτικό, στρατιωτικό ή άλλο επίπεδο, αφήνοντας ωστόσο τη φύση και το περιεχόμενο αμετάβλητα.","en":"An expression that includes a contribution by an agent of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged.","es":"Una expresión que incluye una contribución de un agente de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar.","et":"Väljendus, millesse tegija on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi..","fr":"Expression qui intègre une contribution de la part d’un agent consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés.","hu":"Egy kifejezési forma, amely magában foglalja egy ágens közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható tartalom kiküszöbölése céljából, ugyanakkor a jellegzetességeket és általánosságban a tartalmat lényegében változatlanul hagyja.","it":"Espressione che comprende il contributo da parte di un agente nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina.","nl":"Een expressie die omvat een bijdrage door een actor door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å redigerer innholdet i et annet uttrykk i den hensikt å fjerne deler som anses som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Ahlaki, politik, askeri veya diğer alanlarda sakıncalı görülen içeriğin temzilenmesi amaçlı bir başka anlatım içeriğini revize etmek, fakat yapıyı ve genel içeriği önemli ölçüde değiştirmeden bırakmakla görevli bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个行为者的贡献的内容表达"},"altLabel":{"ar":["مراقب"],"ca":["censor de"],"cs":["cenzor (čeho)"],"da":["censor af"],"de":["Zensor von,Zensor von"],"el":["λογοκριτής του"],"en":["censor of"],"es":["censor de"],"et":["tsensor väljenduses"],"fi":["sensorina ekspressiossa"],"fr":["censeur de"],"hu":["cenzora:"],"it":["censore di"],"nl":["censor van"],"no":["sensor av"],"tr":["sansür"],"zh-Hans-CN":["……的审查者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/censorAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"See Also":[{"@id":"http://rdaregistry.info/Elements/a/P50195", "lexicalAlias":"http://rdaregistry.info/Elements/a/authorAgentOf.en", "label":"is author agent of"}],"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50447", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserAgentOf.en", "label":"is reviser agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50764", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorCollectiveAgentOf.en", "label":"is censor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50613", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorPersonOf.en", "label":"is censor person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50271", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/censorAgentOf.en", "label":"is censor agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50271", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/censorAgentOf.en", "label":"is censor agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50764","label":{"ar":"هو وكيل جماعي مراقب لـ","ca":"és agent col·lectiu censor de","cs":"je cenzorem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er censor af","de":"ist gemeinschaftlicher Akteur als Zensorin/Zensor von","de":"ist gemeinschaftlicher Akteur als Zensorin/Zensor von","el":"είναι λογοκριτής συλλογικός φορέας του","en":"is censor collective agent of","es":"es agente colectivo censor de","et":"tsensor (kollektiiv) väljenduses","fi":"sensori (yhteistoimija) ekspressiossa","fr":"est un agent collectif censeur de","hu":"cenzor kollektív ágense a következőnek:","it":"è censore agente collettivo di","lv":"ir cenzors (grupa)","nl":"is censor-collectieve actor van","no":"er sensor for (kollektiv agent)","tr":"sansürcü kolektif temsilcisidir","zh-Hans-CN":"是……的审查者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتعبيرة تتضمن إسهام وكيل جماعي في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن يُحدث تغييرا جوهريا في طابعه أو في مضمونه العام ."],"ca":["Relaciona un agent col·lectiu amb una expressió que inclou una contribució d’un agent col·lectiu revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials."],"cs":["Vztahuje kolektivního agenta k vyjádření, které zahrnuje přispění kolektivního agenta tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny."],"da":["Relaterer en kollektiv agent til et udtryk, som omfatter en kollektiv agents bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern."],"en":["Relates a collective agent to an expression that includes a contribution by a collective agent of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged."],"es":["Relaciona un agente colectivo con una expresión que incluye una contribución de un agente colectivo de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar."],"et":["Seostab kollektiivi väljendusega, millesse kollektiiv on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata."],"fi":["Liittää yhteistoimijan ekspressioon, jossa yhteistoimija on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi.."],"fr":["Met un agent collectif en relation avec une expression qui intègre une contribution de la part d’un agent collectif consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés."],"hu":["Hozzákapcsol egy kollektív ágenst egy kifejezési formához, amely magában foglalja egy kollektív ágens közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és az általános tartalmat lényegében változatlanul hagyja."],"it":["Correla un agente collettivo a un'espressione che comprende un contributo di un agente collettivo nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale."],"lv":["Sasaista grupu ar izteiksmi, kas ietver grupas ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina."],"nl":["Relateert een collectieve actor aan een expressie die omvat een bijdrage door een collectieve actor door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten."],"no":["Relaterer en kollektiv agent til et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Kolektif bir temsilciyi, ahlaki, politik, askeri veya diğer alanlarda sakıncalı görülen içeriğin temizlenmesi amaçlı bir başka anlatımın içeriğinigözden geçirme, fakat yapıyı ve genel içeriği önemli ölçüde değiştirmeden bırakmakla görevli bir kolektif temsilcinin katkısını içeren bir anlatım ile ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个集体行为者的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مراقِب","ca":"agent col·lectiu censor de","cs":"cenzor (kolektivní agent) (čeho)","da":"kollektiv agent, som er censor af","de":"Gemeinschaftlicher Akteur als Zensorin/Zensor von","de":"Gemeinschaftlicher Akteur als Zensorin/Zensor von","el":"λογοκριτής συλλογικός φορέας του","en":"censor collective agent of","es":"agente colectivo censor de","et":"tsensor (kollektiiv) väljenduses","fi":"sensori (yhteistoimija) ekspressiossa","fr":"agent collectif censeur de","hu":"cenzor kollektív ágense:","it":"censore agente collettivo di","lv":"ir cenzors (grupa)","nl":"censor-collectieve actor van","no":"sensor for (kollektiv agent)","tr":"sansür kolektif temsilcisi","zh-Hans-CN":"……的审查者集体行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل جماعي في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن يُحدث تغييرا جوهريا في طابعه أو في مضمونه العام.","ca":"Expressió que inclou una contribució d’un agent col·lectiu revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials.","cs":"Vyjádření, které zahrnuje přispění kolektivního agenta tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny.","da":"Udtryk, som omfatter en kollektiv agents bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","de":"Eine Expression, zu der ein gemeinschaftlicher Akteur beiträgt, indem er den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","en":"An expression that includes a contribution by a collective agent of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged.","es":"Una expresión que incluye una contribución de un agente colectivo de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar.","et":"Väljendus, millesse kollektiiv on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata.","fi":"Ekspressio, jossa yhteistoimija on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi..","fr":"Expression qui intègre une contribution de la part d’un agent collectif consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés.","hu":"Egy kifejezési forma, amely magában foglalja egy kollektív ágens közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és az általános tartalmat lényegében változatlanul hagyja.","it":"Espressione che comprende un contributo di un agente collettivo nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale.","lv":"Izteiksme, kas ietver grupas ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina.","nl":"Een expressie die omvat een bijdrage door een collectieve actor door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten.","no":"Et uttrykk som inkluderer et bidrag fra en kollektiv agent i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Ahlaki, politik, askeri veya diğer alanlarda sakıncalı görülen içeriğin temzilenmesi amaçlı bir başka anlatım içeriğini revize etmek, fakat yapıyı ve genel içeriği önemli ölçüde değiştirmeden bırakmakla görevli kolektif bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个集体行为者的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/censorCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50744", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en", "label":"is reviser collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50271", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorAgentOf.en", "label":"is censor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50915", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorCorporateBodyOf.en", "label":"is censor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51066", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorFamilyOf.en", "label":"is censor family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50764", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/censorCollectiveAgentOf.en", "label":"is censor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50764", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/censorCollectiveAgentOf.en", "label":"is censor collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50915","label":{"ar":"هي هيئة مراقِبة لـ","ca":"és entitat corporativa censora de","cs":"je cenzorem (korporací) (čeho)","da":"er korporation, som er censor af","de":"ist Körperschaft als Zensorin/Zensor von","de":"ist Körperschaft als Zensorin/Zensor von","el":"είναι λογοκριτής συλλογικό όργανο του","en":"is censor corporate body of","es":"es organismo corporativo censor de","et":"tsensor (asutus) väljenduses","fi":"sensori (yhteisö) ekspressiossa","fr":"est une collectivité censeure de","hu":"cenzor testülete a következőnek:","it":"è censore ente di","lv":"ir cenzors (institūcija)","nl":"is censor-corporatie van","no":"er sensor for (korporasjon)","tr":"sansürcü tüzel kişisidir","zh-Hans-CN":"是……的审查者团体"},"definition":{"ar":["يربط هيئة بتعبيرة تتضمن إسهام هيئة في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن تُحدث تغييرا جوهريا في طابعه أو في مضمونه العام."],"ca":["Relaciona una entitat corporativa amb una expressió que inclou una contribució d’una entitat corporativa revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials."],"cs":["Vztahuje korporaci k vyjádření, které zahrnuje přispění korporace tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny."],"da":["Relaterer en korporation til et udtryk, som omfatter en korporations bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret."],"de":["Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.,Setzt eine Körperschaft in Beziehung zu einer Expression, zu der eine Körperschaft beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern."],"en":["Relates a corporate body to an expression that includes a contribution by a corporate body of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged."],"es":["Relaciona un organismo corporativo con una expresión que incluye una contribución de un organismo corporativo de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar."],"et":["Seostab asutuse väljendusega, millesse asutus on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata."],"fi":["Liittää yhteisön ekspressioon, jossa yhteisö on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi."],"fr":["Met une collectivité en relation avec une expression qui intègre une contribution de la part d’une collectivité consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés."],"hu":["Hozzákapcsol egy testületet egy kifejezési formához, amely magában foglalja egy testület közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és az általános tartalmat lényegében változatlanul hagyja."],"it":["Correla un ente a un'espressione che comprende un contributo di un ente nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale."],"lv":["Sasaista institūciju ar izteiksmi, kas ietver institūcijas ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina."],"nl":["Relateert een corporatie aan een expressie die omvat een bijdrage door een corporatie door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten."],"no":["Relaterer en korporasjon til et uttrykk som inkluderer et bidrag fra en korporasjon i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir tüzel kişiyi, ahlaki, politik, askeri veya diğer gerekçelerle sakıncalı görülen içeriği bastırmak amacıyla başka bir ifadenin içeriğini gözden geçirmeye yönelik bir kurumsal organın katkısını içeren, ancak niteliğini ve genel içeriğini büyük ölçüde değiştirmeden bırakan bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个团体与包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个团体的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"هيئة مراقِبة","ca":"entitat corporativa censora de","cs":"cenzor (korporace) (čeho)","da":"korporation, som er censor af","de":"Körperschaft als Zensorin/Zensor von","de":"Körperschaft als Zensorin/Zensor von","el":"λογοκριτής συλλογικός φορέας του","en":"censor corporate body of","es":"organismo corporativo censor de","et":"tsensor (asutus) väljenduses","fi":"sensori (yhteisö) ekspressiossa","fr":"collectivité censeure de","hu":"cenzor testülete:","it":"censore ente di","lv":"ir cenzors (institūcija)","nl":"censor-corporatie van","no":"sensor for (korporasjon)","tr":"sansür tüzel kişisi","zh-Hans-CN":"……的审查者团体"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام هيئة في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن تُحدث تغييرا جوهريا في طابعه أو في مضمونه العام.","ca":"Expressió que inclou una contribució d’una entitat corporativa revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials.","cs":"Vyjádření, které zahrnuje přispění korporace tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny.","da":"Udtryk, som omfatter en korporations bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","de":"Eine Expression, zu der eine Körperschaft beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","en":"An expression that includes a contribution by a corporate body of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged.","es":"Una expresión que incluye una contribución de un organismo corporativo de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar.","et":"Väljendus, millesse asutus on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata.","fi":"Ekspressio, jossa yhteisö on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi.","fr":"Expression qui intègre une contribution de la part d’une collectivité consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés.","hu":"Egy kifejezési forma, amely magában foglalja egy testület közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és az általános tartalmat lényegében változatlanul hagyja.","it":"Espressione che comprende un contributo di un ente nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale.","lv":"Izteiksme, kas ietver institūcijas ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina.","nl":"Een expressie die omvat een bijdrage door een corporatie door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten.","no":"Et uttrykk som inkluderer et bidrag fra en korporasjon i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Bir ifadenin içeriğini, ahlaki, politik, askeri veya diğer nedenlerle hoş karşılanmayan içeriği bastırmak amacıyla gözden geçiren ancak doğasını ve genel içeriğini büyük ölçüde değiştirmeyen tüzel bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个团体的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/censorCorporateBodyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10005", "lexicalAlias":"http://rdaregistry.info/Elements/c/CorporateBody.en", "label":"corporate body"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50895", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCorporateBodyOf.en", "label":"is reviser corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P50764", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorCollectiveAgentOf.en", "label":"is censor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50915", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/censorCorporateBodyOf.en", "label":"is censor corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50915", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/censorCorporateBodyOf.en", "label":"is censor corporate body of"}]},{"@id":"http://rdaregistry.info/Elements/a/P51066","label":{"ar":"هي عائلة مراقِبة لـ","ca":"és família censora de","cs":"je cenzorem (rodinou) (čeho)","da":"er familie, som er censor af","de":"ist Familie als Zensorin/Zensor von","de":"ist Familie als Zensorin/Zensor von","el":"είναι λογοκριτής οικογένεια του","en":"is censor family of","es":"es familia censora de","et":"tsensor (perekond) väljenduses","fi":"sensori (suku) ekspressiossa","fr":"est une famille censeure de","hu":"cenzor családja a következőnek:","it":"è censore famiglia di","lv":"ir cenzors (dzimta/ģimene)","nl":"is censor-familie van","no":"er sensor for (familie)","tr":"sansürcü ailesidir","zh-Hans-CN":"是……的审查者家族"},"definition":{"ar":["يربط عائلة بتعبيرة تتضمن إسهام عائلة في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن تُحدث تغييرا جوهريا في طابعه أو في مضمونه العام."],"ca":["Relaciona una família amb una expressió que inclou una contribució d’una família revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials."],"cs":["Vztahuje rodinu k vyjádření, které zahrnuje přispění rodiny tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny."],"da":["Relaterer en familie til et udtryk, som omfatter en families bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret."],"de":["Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.,Setzt eine Familie in Beziehung zu einer Expression, zu der eine Familie beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern."],"en":["Relates a family to an expression that includes a contribution by a family of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged."],"es":["Relaciona una familia con una expresión que incluye una contribución de una familia de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar."],"et":["Seostab perekonna väljendusega, millesse perekond on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata."],"fi":["Liittää suvun ekspressioon, jossa suku on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi.."],"fr":["Met une famille en relation avec une expression qui intègre une contribution de la part d’une famille consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés."],"hu":["Hozzákapcsol egy családot egy kifejezési formához, amely magában foglalja egy család közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és az általános tartalmat lényegében változatlanul hagyja."],"it":["Correla una famiglia a un'espressione che comprende un contributo di una famiglia nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale."],"lv":["Sasaista dzimtu/ģimeni ar izteiksmi, kas ietver dzimtas/ģimenes ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina."],"nl":["Relateert een familie aan een expressie die omvat een bijdrage door een familie door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten."],"no":["Relaterer en familie til et uttrykk som inkluderer et bidrag fra en familie i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir aileyi, ahlaki, politik, askeri veya diğer gerekçelerle sakıncalı görülen içeriği bastırmak amacıyla başka bir ifadenin içeriğinin gözden geçirilmesine yönelik bir ailenin katkısını içeren ancak niteliğini ve genel içeriğini büyük ölçüde değiştirmeden bırakan bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个家族与包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个家族的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"عائلة مراقِبة","ca":"família censora de","cs":"cenzor (rodina) (čeho)","da":"familie, som er censor af","de":"Familie als Zensorin/Zensor von","de":"Familie als Zensorin/Zensor von","el":"λογοκριτής οικογένεια του","en":"censor family of","es":"familia censora de","et":"tsensor (perekond) väljenduses","fi":"sensori (suku) ekspressiossa","fr":"famille censeure de","hu":"cenzor családja:","it":"censore famiglia di","lv":"ir cenzors (dzimta/ģimene)","nl":"censor-familie van","no":"sensor for (familie)","tr":"sansür ailesi","zh-Hans-CN":"……的审查者家族"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام عائلة في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن حدث تغييرا جوهريا في طابعه أو في مضمونه العام.","ca":"Expressió que inclou una contribució d’una família revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials.","cs":"Vyjádření, které zahrnuje přispění rodiny tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny.","da":"Udtryk, som omfatter en families bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","de":"Eine Expression, zu der eine Familie beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","en":"An expression that includes a contribution by a family of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged.","es":"Una expresión que incluye una contribución de una familia de corregir el contenido de otra expresión con el propósito de suprimir contenido que es considerado objetable por motivos morales, políticos, militares o de otro tipo, pero dejando la naturaleza y el contenido en general sustancialmente sin alterar.","et":"Väljendus, millesse perekond on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata.","fi":"Ekspressio, jossa suku on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi..","fr":"Expression qui intègre une contribution de la part d’une famille consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés.","hu":"Egy kifejezési forma, amely magában foglalja egy család közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és az általános tartalmat lényegében változatlanul hagyja.","it":"Espressione che comprende un contributo di una famiglia nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale.","lv":"Izteiksme, kas ietver dzimtas/ģimenes ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina.","nl":"Een expressie die omvat een bijdrage door een familie door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten.","no":"Et uttrykk som inkluderer et bidrag fra en familie i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Ahlaki, politik, askeri veya diğer alanlarda sakıncalı görülen içeriğin temzilenmesi amaçlı bir başka anlatım içeriğini revize etmek, fakat yapıyı ve genel içeriği önemli ölçüde değiştirmeden bırakmakla görevli bir ailenin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个家族的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/censorFamilyOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P51046", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserFamilyOf.en", "label":"is reviser family of"},{"@id":"http://rdaregistry.info/Elements/a/P50764", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorCollectiveAgentOf.en", "label":"is censor collective agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P51066", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/censorFamilyOf.en", "label":"is censor family of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P51066", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/censorFamilyOf.en", "label":"is censor family of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50613","label":{"ar":"هو شخص رقيب لـ","ca":"és persona censora de","cs":"je cenzorem (osobou) (čeho)","da":"er person, som er censor af","de":"ist Person als Zensorin/Zensor von","de":"ist Person als Zensorin/Zensor von","el":"είναι λογοκριτής φυσικό πρόσωπο του","en":"is censor person of","es":"es la persona censora de","et":"tsensor (isik) väljenduses","fi":"sensori (henkilö) ekspressiossa","fr":"est une personne censeure de","hu":"cenzor személye a következőnek:","it":"è censore persona di","lv":"ir cenzors (persona)","nl":"is censor-persoon van","no":"er sensor for (person)","tr":"sansürcü kişisidir","zh-Hans-CN":"……的审查者个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن يُحدث تغييرا جوهريا في طابعه أو في مضمونه العام ."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern."],"en":["Relates a person to an expression that includes a contribution by a person of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona para revisar el contenido de otra expresión con el fin de suprimir contenido que se considera objetable por motivos morales, políticos, militares u otros, pero dejando la naturaleza y el contenido general sustancialmente sin cambios. ."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata."],"fi":["Liittää henkilön ekspressioon, jossa henkilö on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi.."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és a tartalmat lényegében változatlanul hagyja."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir kişiyi, ahlaki, siyasi, askeri veya diğer gerekçelerle sakıncalı olduğu düşünülen, bununla birlikte niteliği ve genel içeriği temelde değişmeden bırakılan içeriği gizlemek amacıyla bir başka içeriğin gözden geçirilmesine yönelik bir kişinin katkısını içeren anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个个人的贡献的内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص مراقب","ca":"persona censora de","cs":"cenzor (osoba) (čeho)","da":"person, som er censor af","de":"Person als Zensorin/Zensor von","de":"Person als Zensorin/Zensor von","el":"λογοκριτής φυσικό πρόσωπο του","en":"censor person of","es":"persona censora de","et":"tsensor (isik) väljenduses","fi":"sensori (henkilö) ekspressiossa","fr":"personne censeure de","hu":"cenzor személye:","it":"censore persona di","lv":"ir cenzors (persona)","nl":"censor-persoon van","no":"sensor for (person)","tr":"sansürcü kişi","zh-Hans-CN":"……的审查者个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص في مراجعة محتوى تعبيرة أخرى بغرض حجب محتوى قد يكون موضع اعتراض لأسباب أخلاقية أو سياسية أو عسكرية أو لاعتبارات أخرى، دون أن يُحدث تغييرا جوهريا في طابعه أو في مضمونه العام.","ca":"Expressió que inclou una contribució d’una persona revisant el contingut d’una altra expressió amb el propòsit de suprimir el contingut considerat objectable per motius ètics, polítics, militars o altres motius, però deixant la natura i el contingut general sense canvis substancials.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že reviduje obsah jiného vyjádření za účelem potlačení obsahu považovaného za nevhodný z morálních, politických, vojenských nebo jiných důvodů, ale ponechává povahu a obecný obsah v podstatě beze změny.","da":"Udtryk, som omfatter en persons bidrag ved at revidere indholdet af et andet indtryk med henblik på at undertrykke indhold, som anses for at være moralsk, politisk, militært eller af anden årsag stødende, men som i alt væsentligt lader originalværkets karakter og indhold være uændret.","de":"Eine Expression, zu der eine Person beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","de":"Eine Expression, zu der eine Person beiträgt, indem sie den Inhalt einer anderen Expression überarbeitet, um Teile zu unterdrücken, die aus moralischen, politischen, militärischen oder aus anderen Gründen unerwünscht sind, ohne den Charakter und den Inhalt des Originalwerks substantiell zu verändern.","en":"An expression that includes a contribution by a person of revising the content of another expression for the purpose of suppressing content that is deemed objectionable on moral, political, military, or other grounds, but leaving the nature and general content substantially unchanged.","es":"Una expresión que incluye una contribución de una persona para revisar el contenido de otra expresión con el fin de suprimir contenido que se considera objetable por motivos morales, políticos, militares u otros, pero dejando la naturaleza y el contenido general sustancialmente sin cambios. .","et":"Väljendus, millesse isik on andnud panuse, revideerides teise väljenduse sisu eesmärgiga välja jätta sisu, mida peetakse moraalsetel, poliitilistel, militaarsetel või muudel põhjustel ebasoovitavaks, kuid jättes allikväljenduse olemuse ja üldise sisu põhiliselt muutmata.","fi":"Ekspressio, jossa henkilö on osallisena tarkastamalla toisen ekspression sisältöä kiistanalaisen sisällön salaamiseksi moraalisin, poliittisin, sotilaallisin tai muin perustein, mutta jättäen alkuperäisen teoksen luonteen ja yleisen sisällön olennaisilta osiltaan muuttumattomaksi..","fr":"Expression qui intègre une contribution de la part d’une personne consistant à réviser le contenu d’une autre expression dans le but de supprimer le contenu jugé inadmissible pour des motifs moraux, politiques, militaires ou autres tout en conservant la nature et le contenu sensiblement inchangés.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését egy másik kifejezési forma tartalmának a felülvizsgálatában, morális, politikai, katonai vagy egyéb alapon kifogásolható részek kiküszöbölése céljából, ugyanakkor a jellegzetességeket és a tartalmat lényegében változatlanul hagyja.","it":"Espressione che comprende un contributo di una persona nella revisione del contenuto di un'altra espressione allo scopo di eliminare contenuto ritenuto opinabile per ragioni morali, politiche, militari o di altra natura, ma lasciando sostanzialmente immutati la natura e il contenuto generale.","lv":"Izteiksme, kas ietver personas ieguldījumu, pārskatot citas izteiksmes saturu ar mērķi, lai izslēgtu saturu, kas tiek uzskatīts par nepieņemamu morālu, politisku, militāru vai citu iemeslu dēļ, bet tā būtību un vispārējo saturu būtiski nemaina.","nl":"Een expressie die omvat een bijdrage door een persoon door het herzien van content van een andere expressie met de bedoeling content die gezien wordt als bezwaarlijk op morele, politieke, militaire of andere gronden te onderdrukken, maar de aard en algemene content grotendeels intact te laten.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av å redigere innholdet av et annet uttrykk i den hensikt å fjerne deler som upassende av moralske, politiske, militære eller andre årsaker, men som lar originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Ahlaki, politik, askeri veya diğer alanlarda sakıncalı görülen içeriğin temzilenmesi amaçlı bir başka anlatım içeriğini revize etmek, fakat yapıyı ve genel içeriği önemli ölçüde değiştirmeden bırakmakla görevli bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括修订另一种内容表达的内容以禁止视为不符合道德、政治、军事或其他背景的内容但却保持性质和总体内容不变的一个个人的贡献的内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
