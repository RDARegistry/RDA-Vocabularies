                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/censorPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50593", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserPersonOf.en", "label":"is reviser person of"},{"@id":"http://rdaregistry.info/Elements/a/P50271", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorAgentOf.en", "label":"is censor agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50613", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/censorPersonOf.en", "label":"is censor person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50613", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/censorPersonOf.en", "label":"is censor person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50268","label":{"ar":"هو وكيل قائد كورال لـ","ca":"és agent director de cor de","cs":"je sborovým dirigentem (agentem) (čeho)","da":"er agent, som er kordirigent af","de":"ist Akteur als Chorleiterin/Chorleiter von","de":"ist Akteur als Chorleiterin/Chorleiter von","el":"είναι διευθυντής χορωδίας φορέας του","en":"is choral conductor agent of","es":"es agente director coral de","et":"koorijuht (tegija) väljenduses","fi":"kuoronjohtaja (toimija) ekspressiossa","fr":"est un agent chef de chœur de","hu":"kórusvezető ágense a következőnek:","it":"è agente direttore agente di corale agente di","lv":"ir kordiriģents (aģents)","nl":"is koordirigent-actor van","no":"er kordirigent for (agent)","tr":"koro şefi temsilcisidir","zh-Hans-CN":"是……的合唱指挥行为者"},"definition":{"ar":["يربط وكيلا بتعبيرة تتضمن إسهام وكيل في قيادة فريق كورال في عرض موسيقي أو درامي."],"ca":["Relaciona un agent amb una expressió que inclou una contribució d’un agent dirigint una coral en una representació musical o dramàtica."],"cs":["Vztahuje agenta k vyjádření, které zahrnuje přispění agenta tím, že řídí pěvecký sbor v hudebním nebo dramatickém vystoupení."],"da":["Relaterer en agent til et udtryk, som omfatter en agents bidrag ved at lede et optrædende kor i en musikalsk eller dramatisk præsentation."],"de":["Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.,Setzt einen Akteur in Beziehung zu einer Expression, zu der ein Akteur beiträgt, indem er einen Chor in einer musikalischen oder dramatischen Darbietung leitet."],"el":["Συνδέει έναν διευθυντή ορχήστρας με μια έκφραση ενός μουσικού έργου μέσω της καθοδήγησης ενός χορωδιακού συνόλου σε μια μουσική ή δραματική παρουσίαση κ.λπ., με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution by an agent of leading a choral performing group in a musical or dramatic presentation."],"es":["Relaciona un agente con una expresión que incluye una contribución de un agente de dirigir un grupo de interpretación coral en una presentación musical o dramática."],"et":["Seostab tegija väljendusega, millesse tegija on andnud panuse, juhatades koori muusika- või draamaetenduses."],"fi":["Liittää toimijan ekspressioon, jonka tekemiseen toimija osallistuu johtamalla kuoroa musiikki- tai näytelmäesityksessä."],"fr":["Met un agent en relation avec une expression qui intègre une contribution de la part d’un agent consistant à diriger un groupe de choristes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy ágenst egy kifejezési formához, amely magában foglalja egy zenei vagy drámai bemutatóban énekkari előadó csoportot vezető ágens közreműködését."],"it":["Correla un agente a un'espressione che comprende un contributo da parte di un agente nel condurre e guidare un gruppo corale che si esibisce in una rappresentazione musicale o teatrale."],"lv":["Sasaista aģentu ar izteiksmi, kas ietver aģenta ieguldījumu, diriģējot izpildītājmākslinieku grupu mūzikas vai dramatiskā uzvedumā."],"nl":["Relateert een actor aan een expressie die omvat een bijdrage door een actor door leiden van een optredende koorgroep in een muzikale of dramatische presentatie."],"no":["Relaterer en agent til et uttrykk som inkluderer et bidrag fra en agent i form av å lede et kor i en musikalsk eller dramatisk forestilling."],"tr":["Bir temsilciyi, müzikal veya dramatik bir sunumda bir koro performans grubuna liderlik eden bir temsilcinin katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个行为者与包括在音乐或戏剧呈现中领导一个合唱表演团队的一个行为者的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"وكيل قائد كورال","ca":"agent director de cor de","cs":"sborový dirigent (agent) (čeho)","da":"agent, som er kordirigent af","de":"Akteur als Chorleiterin/Chorleiter von","de":"Akteur als Chorleiterin/Chorleiter von","el":"διευθυντής χορωδίας φορέας του","en":"choral conductor agent of","es":"agente director coral de","et":"koorijuht (tegija) väljenduses","fi":"kuoronjohtaja (toimija) ekspressiossa","fr":"agent chef de chœur de","hu":"kórusvezető ágense:","it":"direttore di corale agente di","lv":"ir kordiriģents (aģents)","nl":"koordirigent-actor van","no":"kordirigent for (agent)","tr":"koro şefi temsilcisi","zh-Hans-CN":"……的合唱指挥行为者"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام وكيل في قيادة فريق كورال في عرض موسيقي أو درامي.","ca":"Expressió que inclou una contribució d’un agent dirigint una coral en una representació musical o dramàtica.","cs":"Vyjádření, které zahrnuje přispění agenta tím, že řídí pěvecký sbor v hudebním nebo dramatickém vystoupení.","da":"Udtryk, som omfatter en agents bidrag ved at lede et optrædende kor i en musikalsk eller dramatisk præsentation.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.","de":"Eine Expression, zu der ein Akteur beiträgt, indem er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.","el":"Μια έκφραση ενός μουσικού έργου που ενσωματώνει τη συνεισφορά της διεύθυνσης ενός χορωδιακού συνόλου σε μια μουσική ή δραματική παρουσίαση κ.λπ.","en":"An expression that includes a contribution by an agent of leading a choral performing group in a musical or dramatic presentation.","es":"Una expresión que incluye una contribución de un agente de dirigir un grupo de interpretación coral en una presentación musical o dramática.","et":"Väljendus, millesse tegija on andnud panuse, juhatades koori muusika- või draamaetenduses.","fi":"Ekspressio, jonka tekemiseen toimija osallistuu johtamalla kuoroa musiikki- tai näytelmäesityksessä.","fr":"Expression qui intègre une contribution de la part d’un agent consistant à diriger un groupe de choristes dans une présentation musicale ou dramatique.","hu":"Egy kifejezési forma, amely magában foglalja egy zenei vagy drámai bemutatóban énekkari előadó csoportot vezető ágens közreműködését.","it":"Espressione che comprende un contributo da parte di un agente nel condurre e guidare un gruppo corale che si esibisce in una rappresentazione musicale o teatrale.","lv":"Izteiksme, kas ietver aģenta ieguldījumu, diriģējot izpildītājmākslinieku grupu mūzikas vai dramatiskā uzvedumā.","nl":"Een expressie die omvat een bijdrage door een actor door leiden van een optredende koorgroep in een muzikale of dramatische presentatie.","no":"Et uttrykk som inkluderer et bidrag fra en agent i form av å lede et kor i en musikalsk eller dramatisk forestilling.","tr":"Müzikal veya dramatik bir sunumda bir koro performans grubuna liderlik eden bir temsilcinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括在音乐或戏剧呈现中领导一个合唱表演团队的一个行为者的贡献的一种内容表达"},"altLabel":{"ar":["قائد كورال"],"ca":["director de cor de"],"cs":["sborový dirigent (čeho)"],"da":["kordirigent af"],"de":["Chorleiter von,Chorleiter von"],"el":["διευθυντής χορωδίας του"],"en":["choral conductor of"],"es":["director coral de"],"et":["koorijuht väljenduses"],"fi":["kuoronjohtajana ekspressiossa"],"fr":["chef de chœur de"],"hu":["kórusvezetője:"],"it":["diettore di corale di"],"nl":["koordirigent van"],"no":["kordirigent for"],"tr":["koro şefi"],"zh-Hans-CN":["……的合唱指挥"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
