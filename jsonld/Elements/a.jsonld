                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/bookDesignerPersonOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50170", "lexicalAlias":"http://rdaregistry.info/Elements/a/bookDesignerAgentOf.en", "label":"is book designer agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50494", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfManifestationOf.en", "label":"is creator person of manifestation of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50509", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/bookDesignerPersonOf.en", "label":"is book designer person of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50509", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/bookDesignerPersonOf.en", "label":"is book designer person of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50172","label":{"ar":"هو وكيل نقّاش حروف برايل لـ","ca":"és agent estampador braille de","cs":"je tiskařem Braillova písma (agentem) (čeho)","da":"er agent, som er punktskriftspræger af","de":"ist Akteur als Brailleschriftprägerin/Brailleschriftpräger von","de":"ist Akteur als Brailleschriftprägerin/Brailleschriftpräger von","el":"είναι τυπογράφος μπράιγ φορέας του","en":"is braille embosser agent of","es":"es agente grabador en relieve de braille de","et":"punktkirja kirjutaja (tegija) kehastuses","fi":"pistekirjoituksen tekijä (toimija) manifestaatiossa","fr":"est un agent producteur braille de","hu":"Braille-dombornyomó ágense a következőnek:","it":"è agente stampatore braille di","lv":"ir iespiedējs Braila rakstā (aģents)","nl":"is brailleerder-actor van","no":"er punktskriftpreger for (agent)","tr":"braille kabartmacısı temsilcisidir","zh-Hans-CN":"是……的布莱叶盲文点字制作者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل عن نقش حروف برايل باستخدام قلم أو طابعة خاصة للنقش أو أي أداة أخرى."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent en el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za vyražení braillských buněk pomocí stylusu, speciální vyrážecí tiskárny nebo jiného zařízení."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for at præge punktskriftsceller vha. en stift, særlig prægeprinter eller anden anordning."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet."],"el":["Συνδέει έναν φορέα, ο οποίος εμπλέκεται στην κατασκευή μιας εκδήλωσης κατασκευάζοντας μια ανάγλυφη εκτύπωση μπράιγ χρησιμοποιώντας έναν ειδικό εκτυπωτή ανάγλυφης εκτύπωσης ή άλλη συσκευή, με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for embossing braille cells using a stylus, special embossing printer, or other device."],"es":["Relaciona un agente con una manifestación que involucra una responsabilidad de un agente de grabar en relieve celdas braille utilizando un stylus, impresora especial de grabado en relieve u otro dispositivo."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega punktkirjamärkide tegemise eest."],"fi":["Liittää toimijan manifestaatioon, jonka tekemisestä toimija on vastuussa tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent consistant à embosser des cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil."],"hu":["Hozzákapcsol egy ágenst egy megjelenési formához, amelyhez hozzátartozik egy ágens felelőssége braille-cellák dombornyomásáért íróvessző, speciális dombornyomtató vagy más eszköz használatával."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente per lo sbalzo di punti braille utilizzando uno stilo, una speciale stampante a sbalzo o altro dispositivo."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par Braila raksta matricas iespiešanu, izmantojot irbuli, īpaša ciļņa iespieduma printeri vai citu ierīci."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het pregen van braille cellen met gebruikmaking van een stylus, speciale preegdrukmachine of ander instrument."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av preging av brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning."],"tr":["Bir temsilciyi, bir kalem, özel kabartma yazıcı veya başka bir cihaz kullanarak braille hücrelerini kabartmakla görevli olan temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل نقاش حروف برايل","ca":"agent estampador braille de","cs":"tiskař Braillova písma (agent) (čeho)","da":"agent, som er punktskriftspræger af","de":"Akteur als Brailleschriftprägerin/Brailleschriftpräger von","de":"Akteur als Brailleschriftprägerin/Brailleschriftpräger von","el":"τυπογράφος μπράιγ φορέας του","en":"braille embosser agent of","es":"agente grabador en relieve de braille","et":"punktkirja kirjutaja (tegija) kehastuses","fi":"pistekirjoituksen tekijä (toimija) manifestaatiossa","fr":"agent producteur braille de","hu":"Braille-dombornyomó ágense:","it":"stampatore braille agente di","lv":"ir iespiedējs Braila rakstā (aģents)","nl":"brailleerder-actor van","no":"punktskriftpreger for (agent)","tr":"braille kabartmacısı temsilcisi","zh-Hans-CN":"……的布莱叶盲文点字制作者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن نقش حروف برايل باستخدام قلم أو طابعة خاصة للنقش أو أي أداة أخرى.","ca":"Manifestació que implica una responsabilitat d’un agent en el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme.","cs":"Provedení, které zahrnuje odpovědnost agenta za vyražení braillských buněk pomocí stylusu, speciální vyrážecí tiskárny nebo jiného zařízení.","da":"Manifestation, som involverer en agents ansvar for at præge punktskriftsceller vha. en stift, særlig prægeprinter eller anden anordning.","de":"Eine Manifestation, bei der ein Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet.","de":"Eine Manifestation, bei der ein Akteur für das Prägen von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät verwendet.","el":"Μια εκδήλωση που κατασκευάζεται από έναν φορέα υπεύθυνο για την ανάγλυφη εκτύπωση μπράιγ μέσω της χρήσης ενός ειδικού εκτυπωτή ανάγλυφης εκτύπωσης ή άλλης συσκευής.","en":"A manifestation that involves a responsibility of an agent for embossing braille cells using a stylus, special embossing printer, or other device.","es":"Una manifestación que involucra una responsabilidad de un agente de grabar en relieve celdas braille utilizando un stylus, impresora especial de grabado en relieve u otro dispositivo.","et":"Kehastus, mis sisaldab tegija vastutust spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega punktkirjamärkide tegemise eest.","fi":"Manifestaatio, jonka tekemisestä toimija on vastuussa tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent consistant à embosser des cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy ágens felelőssége braille-cellák dombornyomásáért íróvessző, speciális dombornyomtató vagy más eszköz használatával.","it":"Manifestazione che implica la responsabilità di un agente per lo sbalzo di punti braille utilizzando uno stilo, una speciale stampante a sbalzo o altro dispositivo.","lv":"Manifestācija, kas ietver aģenta atbildību par Braila raksta matricas iespiešanu, izmantojot irbuli, īpaša ciļņa iespieduma printeri vai citu ierīci.","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het pregen van braille cellen met gebruikmaking van een stylus, speciale preegdrukmachine of ander instrument.","no":"En manifestasjon som involverer ansvar for en agent i form av preging av brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning.","tr":"Bir kalem, özel kabartma yazıcı veya başka bir cihaz kullanarak braille hücrelerini kabartmak için bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文的一个行为者的责任的一种载体表现"},"altLabel":{"ar":["نقَّاش حروف برايل"],"ca":["estampador braille de"],"cs":["tiskař Braillova písma (čeho)"],"da":["braillepræger af"],"de":["Brailleschriftpräger von,Brailleschriftpräger von"],"el":["τυπογράφος μπράιγ του"],"en":["braille embosser of"],"es":["grabador en relieve de"],"et":["punktkirja kirjutaja kehastuses"],"fi":["valmistajana pistekirjoituksessa"],"fr":["producteur braille de"],"hu":["Braille-dombornyomója:"],"it":["stampatore braille di"],"nl":["brailleerder van"],"no":["punktskriftpreger for"],"tr":["braille kabartmacısı"],"zh-Hans-CN":["……的布莱叶盲文点字制作者"]},"isDefinedBy":{"@id":"http://rda