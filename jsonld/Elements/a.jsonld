                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"lexicalAlias":"http://rdaregistry.info/Elements/a/nameOfPerson.en","instructionNumber":"9.2","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50382", "lexicalAlias":"http://rdaregistry.info/Elements/a/appellationOfPerson.en", "label":"has appellation of person"},{"@id":"http://rdaregistry.info/Elements/a/P50385", "lexicalAlias":"http://rdaregistry.info/Elements/a/nameOfAgent.en", "label":"has name of agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50292", "lexicalAlias":"http://rdaregistry.info/Elements/a/givenName.en", "label":"has given name"},{"@id":"http://rdaregistry.info/Elements/a/P50115", "lexicalAlias":"http://rdaregistry.info/Elements/a/fullerFormOfName.en", "label":"has fuller form of name"},{"@id":"http://rdaregistry.info/Elements/a/P50117", "lexicalAlias":"http://rdaregistry.info/Elements/a/preferredNameOfPerson.en", "label":"has preferred name of person"},{"@id":"http://rdaregistry.info/Elements/a/P50103", "lexicalAlias":"http://rdaregistry.info/Elements/a/variantNameOfPerson.en", "label":"has variant name of person"},{"@id":"http://rdaregistry.info/Elements/a/P50291", "lexicalAlias":"http://rdaregistry.info/Elements/a/surname.en", "label":"has surname"},{"@id":"http://rdaregistry.info/Elements/a/object/P50111", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/nameOfPerson.en", "label":"has name of person"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50111", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/nameOfPerson.en", "label":"has name of person"}]},{"@id":"http://rdaregistry.info/Elements/a/P50098","label":{"ar":"له فترة نشاط شخص","ca":"té com a període d’activitat d’una persona","cs":"má dobu činnosti osoby","da":"har aktivitetsperiode for person","de":"hat Wirkungszeitraum einer Person","de":"hat Wirkungszeitraum einer Person","el":"έχει περίοδο δραστηριοποίησης του φυσικού προσώπου","en":"has period of activity of person","es":"tiene periodo de actividad de persona","et":"isiku tegutsemisaeg","fi":"henkilön toiminta-aika","fr":"a pour période d’activité d’une personne","hu":"személy tevékenységének időszaka a következő:","it":"ha come periodo di attività di persona","lv":"personas darbības periods","nl":"heeft periode van activiteit van persoon","no":"har periode en person var aktiv","sv":"har verksamhetstid för personen","tr":"kişinin faaliyet dönemi ile ilişkilidir","zh-Hans-CN":"有个人的活动时期"},"definition":{"ar":["يربط شخصا بفترة زمنية ينشط خلالها شخص في مجال عمله الأساسي."],"ca":["Relaciona una persona amb un interval de temps durant el qual una persona està en actiu en el seu camp principal d’activitat."],"cs":["Vztahuje osobu k časovému období, ve kterém je osoba činná ve svém hlavním oboru činnosti."],"da":["Relaterer en person til en tidsperiode, hvori en person er aktiv i sit primære virkefelt."],"de":["Setzt eine Person in Beziehung zu einem Zeitraum, in dem eine Person in ihrem primären Tätigkeitsfeld aktiv ist.,Setzt eine Person in Beziehung zu einem Zeitraum, in dem eine Person in ihrem primären Tätigkeitsfeld aktiv ist."],"el":["Συνδέει ένα φυσικό πρόσωπο με μια χρονολογία ή ένα εύρος χρονολογιών ενδεικτικών της περιόδου κατά την οποία το φυσικό πρόσωπο έδρασε στο κύριο πεδίο της δραστηριοποίησης του/της."],"en":["Relates a person to a timespan during which a person is active in their primary field of endeavor."],"es":["Relaciona una persona con un espacio de tiempo durante el cual una persona está activa en su área primaria de desempeño."],"et":["Seostab isiku ajavahemikuga, mille jooksul isik on olnud oma peamisel tegevusalal aktiivne."],"fi":["Liittää henkilön ajanjaksoon, jonka aikana henkilö on ollut aktiivinen ensisijaisella toiminta-alallaan."],"fr":["Met une personne en relation avec un laps de temps pendant lequel une personne est active dans son principal champ d’activité."],"hu":["Hozzákapcsol egy személyt egy időtartamhoz, amely alatt egy személy fő tevékenységi területén aktív."],"it":["Correla una persona a un arco di tempo durante il quale una persona è attiva nel suo primario campo di impegno."],"lv":["Sasaista personu ar laikposmu, kurā persona ir aktīva savā darbības jomā."],"nl":["Relateert een persoon aan een tijdspanne gedurende welke een persoon actief is in zijn primaire veld van inspanning."],"no":["Relaterer en person til et tidsrom hvor en person er aktiv innenfor sitt hovedvirke."],"tr":["Bir kişiyi birincil çaba alanında aktif olduğu bir zaman aralığı ile ilişkilendirir."],"zh-Hans-CN":["将一个个人与一个个人在其主要努力领域中活跃的时间段关联起来。"]},"ToolkitLabel":{"ar":"فترة نشاط شخص","ca":"període d’activitat d’una persona","cs":"doba činnosti osoby","da":"aktivitetsperiode for person","de":"Wirkungszeitraum einer Person","de":"Wirkungszeitraum einer Person","el":"περίοδος της δραστηριοποίησης του φυσικού προσώπου","en":"period of activity of person","es":"periodo de actividad de persona","et":"isiku tegutsemisaeg","fi":"henkilön toiminta-aika","fr":"période d’activité d’une personne","hu":"személy tevékenységének időszaka:","it":"periodo di attività di persona","lv":"personas darbības periods","nl":"periode van activiteit van persoon","no":"perioden en person var aktiv","sv":"verksamhetstid för personen","tr":"kişinin faaliyet süresi","zh-Hans-CN":"个人的活动时期"},"ToolkitDefinition":{"ar":"فترة زمنية ينشط خلالها شخص في مجال عمله الأساسي.","ca":"Interval de temps durant el qual una persona està en actiu en el seu camp principal d’activitat.","cs":"Časové období, ve kterém je osoba činná ve svém hlavním oboru činnosti.","da":"Tidsperiode, hvori en person er aktiv i sit primære virkefelt.","de":"Ein Zeitraum, in dem eine Person in ihrem primären Tätigkeitsfeld aktiv ist.","de":"Ein Zeitraum, in dem eine Person in ihrem primären Tätigkeitsfeld aktiv ist.","el":"Μια χρονολογία ή ένα εύρος χρονολογιών ενδεικτικών της περιόδου κατά την οποία το φυσικό πρόσωπο έδρασε στο κύριο πεδίο της δραστηριοποίησης του/της.","en":"A timespan during which a person is active in their primary field of endeavor.","es":"Espacio de tiempo durante el cual una persona está activa en su área primaria de desempeño.","et":"Ajavahemik, mille jooksul isik on olnud oma peamisel tegevusalal aktiivne.","fi":"Ajanjakso, jonka aikana henkilö on ollut aktiivinen ensisijaisella toiminta-alallaan.","fr":"Laps de temps pendant lequel une personne est active dans son principal champ d’activité.","hu":"Egy időtartam, amely alatt egy személy fő tevékenységi területén aktív.","it":"Arco di tempo durante il quale una persona è attiva nel suo primario campo di impegno.","lv":"Laikposms, kurā persona ir aktīva savā darbības jomā.","nl":"Een tijdspanne gedurende welke een persoon actief is in zijn primaire veld van inspanning.","no":"Et tidsrom hvor en person er aktiv innenfor sitt hovedvirke.","tr":"Bir kişinin, asıl faaliyet alanında aktif olduğu bir zaman aralığı.","zh-Hans-CN":"一个个人在其主要努力领域中活跃的时间段"},"altLabel":{"fi":["henkilön toimintaan liittyvä ajanjakso"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
