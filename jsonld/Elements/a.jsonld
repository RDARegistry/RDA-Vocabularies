                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/colouristCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50775", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorCollectiveAgentToAmalgamationOf.en", "label":"is contributor collective agent to amalgamation of"},{"@id":"http://rdaregistry.info/Elements/a/P50266", "lexicalAlias":"http://rdaregistry.info/Elements/a/colouristAgentOf.en", "label":"is colourist agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50873", "lexicalAlias":"http://rdaregistry.info/Elements/a/colouristCorporateBodyOf.en", "label":"is colourist corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51024", "lexicalAlias":"http://rdaregistry.info/Elements/a/colouristFamilyOf.en", "label":"is colourist family of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50722", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/colouristCollectiveAgentOf.en", "label":"is colourist collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50722", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/colouristCollectiveAgentOf.en", "label":"is colourist collective agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50873","label":{"ar":"هي هيئة فني تلوين لـ","ca":"és entitat corporativa colorista de","cs":"je koloristou (korporací) (čeho)","da":"er korporation, som er farvelægger af","de":"ist Körperschaft als Koloristin/Kolorist von","de":"ist Körperschaft als Koloristin/Kolorist von","el":"είναι επιχρωματιστής συλλογικό όργανο του","en":"is colourist corporate body of","es":"es organismo corporativo colorista de","et":"koloreerija (asutus) väljenduses","fi":"värittäjä (yhteisö) ekspressiossa","fr":"es