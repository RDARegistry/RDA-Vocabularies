                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/interviewerFamilyOfWorkOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10008", "lexicalAlias":"http://rdaregistry.info/Elements/c/Family.en", "label":"family"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50995", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorFamilyOfWorkOf.en", "label":"is creator family of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50678", "lexicalAlias":"http://rdaregistry.info/Elements/a/interviewerCollectiveAgentOfWorkOf.en", "label":"is interviewer collective agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50980", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/interviewerFamilyOfWorkOf.en", "label":"is interviewer family of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50980", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/interviewerFamilyOfWorkOf.en", "label":"is interviewer family of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50588","label":{"ar":"هو شخص محاور في تعبيرة لـ","ca":"és persona entrevistadora d’una expressió de","cs":"je tazatelem vyjádření (osobou) (čeho)","da":"er person, som er interviewer for udtryk af","de":"ist Person als Interviewerin/Interviewer einer Expression von","de":"ist Person als Interviewerin/Interviewer einer Expression von","el":"είναι συνεντευκτής φυσικό πρόσωπο της έκφρασης του","en":"is interviewer person of expression of","es":"es entrevistador de expresión de","et":"intervjueerija (isik) väljenduses","fi":"ekspression haastattelija (henkilö) ekspressiossa","fr":"est une personne intervieweuse d’une expression de","hu":"interjúkészítő személye a következő kifejezési formának:","it":"è intervistatore persona di espressione di","lv":"ir intervētājs (persona) izteiksmē","nl":"is interviewer-persoon van expressie van","no":"er intervjuer for uttrykk for (person)","tr":"anlatımının görüşmeci kişisidir","zh-Hans-CN":"是……的内容表达的采访者个人"},"definition":{"ar":["يربط شخصا بتعبيرة تتضمن إسهام شخص في إجراء مقابلات أو في إعداد تقارير أو جمع المعلومات بطريقة أخرى."],"ca":["Relaciona una persona amb una expressió que inclou una contribució d’una persona entrevistant, informant o recopilant informació d’alguna altra manera."],"cs":["Vztahuje osobu k vyjádření, které zahrnuje přispění osoby tím, že působí jako tazatel, zpravodaj nebo jiná osoba, která shromažďuje informace."],"da":["Relaterer en person til et udtryk, som omfatter en persons bidrag ved at interviewe, rapportere eller en anden form for indsamling af information."],"de":["Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.,Setzt eine Person in Beziehung zu einer Expression, zu der eine Person beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt."],"en":["Relates a person to an expression that includes a contribution by a person of interviewing, reporting, or some other kind of gathering of information."],"es":["Relaciona a una persona con una expresión que incluye una contribución de una persona en entrevistas, informes o algún otro tipo de recopilación de información."],"et":["Seostab isiku väljendusega, millesse isik on andnud panuse, intervjueerides, tehes reportaaži või kogudes muul viisil infot."],"fi":["Liittää henkilön ekspressioon, jonka tekemisessä henkilö on osallisena toimimalla haastattelijana, toimittajana tai jonain muuna tietoja keräävänä toimijana."],"fr":["Met une personne en relation avec une expression qui intègre une contribution de la part d’une personne consistant à réaliser un entretien, un reportage ou un autre type de collecte d’informations."],"hu":["Hozzákapcsol egy személyt egy kifejezési formához, amely magában foglalja egy személy közreműködését interjúban, riportban vagy más információgyűjtő minőségben."],"it":["Correla una persona a un'espressione che comprende un contributo di una persona nell'intervistare, riferire notizie o altro tipo di raccolta di informazioni."],"lv":["Sasaista personu ar izteiksmi, kas ietver personas ieguldījumu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs."],"nl":["Relateert een persoon aan een expressie die omvat een bijdrage door een persoon door ondervragen, rapporteren of een andere vorm van informatie verzamelen."],"no":["Relaterer en person til et uttrykk som inkluderer et bidrag fra en person i form av intervjuer, rapportering eller en annen form for innsamling av informasjon."],"tr":["Bir kişiyi, bir kişinin görüşme, raporlama veya başka türde bilgi toplama katkısını içeren bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一个个人与包括一个采访、报道或其他某种信息收集的一个个人的贡献的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"شخص محاور في تعبيرة","ca":"persona entrevistadora d’una expressió de","cs":"tazatel vyjádření (osoba) (čeho)","da":"person, som er interviewer for udtryk af","de":"Person als Interviewerin/Interviewer einer Expression von","de":"Person als Interviewerin/Interviewer einer Expression von","el":"εσυνεντευκτής φυσικό πρόσωπο της έκφρασης του","en":"interviewer person of expression of","es":"entrevistador de expresión de","et":"intervjueerija (isik) väljenduses","fi":"ekspression haastattelija (henkilö) ekspressiossa","fr":"personne intervieweuse d’une expression de","hu":"interjúkészítő személye a következő kifejezési formának:","it":"intervistatore persona di espressione di","lv":"ir intervētājs (persona) izteiksmē","nl":"interviewer-persoon van expressie van","no":"intervjuer for uttrykk for (person)","tr":"anlatımının görüşmeci kişisidir","zh-Hans-CN":"……的内容表达的采访者个人"},"ToolkitDefinition":{"ar":"تعبيرة تتضمن إسهام شخص في إجراء مقابلات أو إعداد تقارير أو جمع المعلومات بطريقة أخرى.","ca":"Expressió que inclou una contribució d’una persona entrevistant, informant o recopilant informació d’alguna altra manera.","cs":"Vyjádření, které zahrnuje přispění osoby tím, že působí jako tazatel, zpravodaj nebo jiná osoba, která shromažďuje informace.","da":"Udtryk, som omfatter en persons bidrag ved at interviewe, rapportere eller en anden form for indsamling af information.","de":"Eine Expression, zu der eine Person beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.","de":"Eine Expression, zu der eine Person beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.","en":"An expression that includes a contribution by a person of interviewing, reporting, or some other kind of gathering of information.","es":"Una expresión que incluye una contribución de una persona en entrevistas, informes o algún otro tipo de recopilación de información.","et":"Väljendus, millesse isik on andnud panuse, intervjueerides, tehes reportaaži või kogudes muul viisil infot.","fi":"Ekspressio, jonka tekemisessä henkilö on osallisena toimimalla haastattelijana, toimittajana tai jonain muuna tietoja keräävänä toimijana.","fr":"Expression qui intègre une contribution de la part d’une personne consistant à réaliser un entretien, un reportage ou un autre type de collecte d’informations.","hu":"Egy kifejezési forma, amely magában foglalja egy személy közreműködését interjúban, riportban vagy más információgyűjtő minőségben.","it":"Espressione che comprende un contributo di una persona nell'intervistare, riferire notizie o altro tipo di raccolta di informazioni.","lv":"Izteiksme, kas ietver personas ieguldījumu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.","nl":"Een expressie die omvat een bijdrage door een persoon door ondervragen, rapporteren of een andere vorm van informatie verzamelen.","no":"Et uttrykk som inkluderer et bidrag fra en person i form av intervjuer, rapportering eller en annen form for innsamling av informasjon.","tr":"Röportaj, raporlama veya başka bir tür bilgi toplayan bir kişinin katkısını içeren bir anlatım.","zh-Hans-CN":"包括一个采访、报道或其他某种信息收集的一个个人的贡献的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/interviewerPersonOfExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50623", "lexicalAlias":"http://rdaregistry.info/Elements/a/contributorPersonToPerformanceOf.en", "label":"is contributor person to performance of"},{"@id":"http://rdaregistry.info/Elements/a/P50140", "lexicalAlias":"http://rdaregistry.info/Elements/a/interviewerAgentOfExpressionOf.en", "label":"is interviewer agent of expression of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50588", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/interviewerPersonOfExpressionOf.en", "label":"is interviewer person of expression of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50588", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/interviewerPersonOfExpressionOf.en", "label":"is interviewer person of expression of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50527","label":{"ar":"هو شخص محاور في عمل لـ","ca":"és persona entrevistadora d’una obra de","cs":"je tazatelem díla (osobou) (čeho)","da":"er person, som er interviewer for værk af","de":"ist Person als Interviewerin/Interviewer eines Werks von","de":"ist Person als Interviewerin/Interviewer eines Werks von","el":"είναι συνεντευκτής φυσικό πρόσωπο του έργου του","en":"is interviewer person of work of","es":"es persona entrevistadora de obras de","et":"intervjueerija (isik) teoses","fi":"teoksen haastattelija (henkilö) teoksessa","fr":"est une personne intervieweuse d’une œuvre de","hu":"interjúkészítő személye a következő műnek:","it":"è intervistatore persona di opera di","lv":"ir intervētājs (persona) darbā","nl":"is interviewer-persoon van werk van","no":"er intervjuer for verk for (person)","tr":"eserinin görüşmeci kişisidir","zh-Hans-CN":"是……的作品的采访者个人"},"definition":{"ar":["يربط شخصا بعمل ينطوي على مسئولية شخص عن العمل كمحاور أو مراسل أو كاتب استطلاع أو أي نوع آخر من الأشخاص الذين يجمعون المعلومات."],"ca":["Relaciona una persona amb una obra que implica una responsabilitat d’una persona actuant com un entrevistador, un periodista, un enquestador o qualsevol altra persona que recull la informació."],"cs":["Vztahuje osobu k dílu, které zahrnuje odpovědnost osoby tím, že působí jako tazatel, zpravodaj, osoba provádějící průzkum veřejného mínění, nebo jiná osoba, která shromažďuje informace."],"da":["Relaterer en person til et værk, som involverer en persons ansvar for at optræde som interviewer, journalist, meningsmåler eller en anden form for person, som indsamler information."],"de":["Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.,Setzt eine Person in Beziehung zu einem Werk, bei dem eine Person als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt."],"en":["Relates a person to a work that involves a responsibility by a person for acting as an interviewer, reporter, pollster, or some other kind of person who gathers information."],"es":["Relaciona a una persona con una obra que implica la responsabilidad de una persona por actuar como entrevistador, reportero, encuestador o algún otro tipo de persona que recopila información."],"et":["Seostab isiku teosega, mis sisaldab isiku vastutust tegutsemise eest intervjueerija, reporteri, küsitleja või muu infot koguva isikuna."],"fi":["Liittää henkilön teokseen, jonka luomisesta henkilö on vastuussa toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna tietoja keräävänä henkilönä."],"fr":["Met une personne en relation avec une œuvre qui comporte une responsabilité de la part d’une personne consistant à agir à titre d’intervieweur, de reporteur, de sondeur ou d’autre type de personne recueillant de l’information."],"hu":["Hozzákapcsol egy személyt egy műhöz, amelyhez hozzátartozik egy személy felelőssége interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő személyként."],"it":["Correla una persona a un'opera che implica una responsabilità di una persona nell'agire come intervistatore, giornalista, sondaggista o altro tipo di persona che raccoglie informazioni."],"lv":["Sasaista personu ar darbu, kas ietver personas atbildību, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs."],"nl":["Relateert een persoon aan een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor optreden als een interviewer, verslaggever, opiniepeiler of een andere soort persoon die informatie verzamelt."],"no":["Relaterer en person til et verk som involverer et ansvar for en person i form av å fungere som intervjuer, reporter, eller som en annen person som samler inn informasjon."],"tr":["Bir kişiyi, bir kişinin mülakatçı, muhabir, anketör veya bilgi toplayan başka tür bir kişi olarak hareket etme sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个个人与涉及担当采访者、记者、民意调查员的一个个人或其他类型信息搜集个人的责任的一种作品关联起来。"]},"ToolkitLabel":{"ar":"شخص محاور في عمل","ca":"persona entrevistadora d’una obra de","cs":"tazatel díla (osoba) (čeho)","da":"person, som er interviewer for værk af","de":"Person als Interviewerin/Interviewer eines Werks von","de":"Person als Interviewerin/Interviewer eines Werks von","el":"συνεντευκτής φυσικό πρόσωπο του έργου του","en":"interviewer person of work of","es":"persona entrevistadora de obras de","et":"intervjueerija (isik) teoses","fi":"teoksen haastattelija (henkilö) teoksessa","fr":"personne intervieweuse d’une œuvre de","hu":"interjúkészítő személye a következő műnek:","it":"intervistatore persona di opera di","lv":"ir intervētājs (persona) darbā","nl":"interviewer-persoon van werk van","no":"intervjuer for verk for (person)","tr":"eserinin görüşmeci kişisidir","zh-Hans-CN":"……的作品的采访者个人"},"ToolkitDefinition":{"ar":"عمل يترتب عليه مسئولية وكيل عن العمل كمحاور أو مراسل أو كاتب استطلاع أو أي نوع آخر من الأشخاص الذين يجمعون المعلومات.","ca":"Obra que implica una responsabilitat d’una persona actuant com un entrevistador, un periodista, un enquestador o qualsevol altra persona que recull la informació.","cs":"Dílo, které zahrnuje odpovědnost osoby tím, že působí jako tazatel, zpravodaj, osoba provádějící průzkum veřejného mínění, nebo jiná osoba, která shromažďuje informace.","da":"Værk, som involverer en persons ansvar for at optræde som interviewer, journalist, meningsmåler eller en anden form for person, som indsamler information.","de":"Ein Werk, bei dem eine Person als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.","de":"Ein Werk, bei dem eine Person als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.","en":"A work that involves a responsibility of a person for acting as an interviewer, reporter, pollster, or some other kind of person who gathers information.","es":"Una obra que implica la responsabilidad de una persona por actuar como entrevistador, reportero, encuestador o algún otro tipo de persona que recopila información.","et":"Teos, mis sisaldab isiku vastutust tegutsemise eest intervjueerija, reporteri, küsitleja või muu infot koguva isikuna.","fi":"Teos, jonka luomisesta henkilö on vastuussa toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna tietoja keräävänä henkilönä.","fr":"Œuvre qui comporte une responsabilité de la part d’une personne consistant à agir à titre d’intervieweur, de reporteur, de sondeur ou d’autre type de personne recueillant de l’information.","hu":"Egy mű, amelyhez hozzátartozik egy személy felelőssége interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő személyként.","it":"Opera che implica una responsabilità di una persona nell'agire come intervistatore, giornalista, sondaggista o altro tipo di persona che raccoglie informazioni.","lv":"Darbs, kas ietver personas atbildību, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.","nl":"Een werk dat met zich meebrengt een verantwoordelijkheid van een persoon voor optreden als een interviewer, verslaggever, opiniepeiler of een andere soort persoon die informatie verzamelt.","no":"Et verk som involverer et ansvar for en person i form av å fungere som intervjuer, reporter, eller som en annen person som samler inn informasjon.","tr":"Bir kişinin görüşmeci, muhabir, anketör veya bilgi toplayan başka türde bir kişi olarak hareket etme sorumluluğunu içeren bir çalışma.","zh-Hans-CN":"涉及担当采访者、记者、民意调查员的一个个人或其他类型信息搜集个人的责任的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/interviewerPersonOfWorkOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10004", "lexicalAlias":"http://rdaregistry.info/Elements/c/Person.en", "label":"person"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50542", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorPersonOfWorkOf.en", "label":"is creator person of work of"},{"@id":"http://rdaregistry.info/Elements/a/P50191", "lexicalAlias":"http://rdaregistry.info/Elements/a/interviewerAgentOfWorkOf.en", "label":"is interviewer agent of work of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50527", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/interviewerPersonOfWorkOf.en", "label":"is interviewer person of work of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50527", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/interviewerPersonOfWorkOf.en", "label":"is interviewer person of work of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50188","label":{"ar":"هو وكيل مخترع لـ","ca":"és agent inventor de","cs":"je vynálezcem (agentem) (čeho)","da":"er agent, som er opfinder af","de":"ist Akteur als Erfinderin/Erfinder von","de":"ist Akteur als Erfinderin/Erfinder von","el":"είναι εφευρέτης φορέας του","en":"is inventor agent of","es":"es agente inventor de","et":"leiutaja (tegija) teoses","fi":"keksijä (toimija) teoksessa","fr":"est un agent inventeur de","hu":"feltaláló ágense a következőnek:","it":"è inventore agente di","lv":"ir izgudrotājs (aģents)","nl":"is uitvinder-actor van","no":"er oppfinner av (agent)","tr":"mucit temsilcisidir","zh-Hans-CN":"是……的发明者行为者"},"definition":{"ar":["يربط وكيلا بعمل يترتب عليه مسئولية وكيل عن ابتكار جهاز أو عملية جديدة."],"ca":["Relaciona un agent amb una obra que implica una responsabilitat d’un agent en la creació d’un mecanisme o procés nou."],"cs":["Vztahuje agenta k dílu, které zahrnuje odpovědnost agenta za vytvoření nového zařízení nebo procesu."],"da":["Relaterer en agent til et værk, som involverer en agents ansvar for at skabe en ny anordning eller proces."],"de":["Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.,Setzt einen Akteur in Beziehung zu einem Werk, bei dem ein Akteur für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist."],"el":["Συνδέει έναν φορέα υπεύθυνο για τη δημιουργία μιας νέας συσκευής ή διαδικασίας, με ένα έργο."],"en":["Relates an agent to a work that involves a responsibility of an agent for creating a new device or process."],"es":["Relaciona un agente con una obra que involucra una responsabilidad de un agente de crear un nuevo dispositivo o proceso."],"et":["Seostab tegija teosega, mis sisaldab tegija vastutust uue seadme või protsessi eest."],"fi":["Liittää toimijan teokseen, jossa toimija on vastuussa uuden välineen tai menetelmän luomisesta."],"fr":["Met un agent en relation avec une œuvre qui comporte une responsabilité de la part d’un agent consistant à créer un nouveau dispositif ou procédé."],"hu":["Hozzákapcsol egy ágenst egy műhöz, amelyhez hozzátartozik egy ágens felelőssége egy új eszköz vagy eljárás létrehozásáért."],"it":["Correla un agente a un'opera che implica una responsabilità di un agente per un nuovo dispositivo o processo."],"lv":["Sasaista aģentu ar darbu, kas ietver aģenta atbildību par jaunas ierīces vai procesa radīšanu."],"nl":["Relateert een actor aan een werk dat met zich meebrengt een verantwoordelijkheid van een actor voor het creëren van een nieuw apparaat of proces."],"no":["Relaterer en agent til et verk som involverer ansvar for en agent i form av en ny innretning eller prosess."],"tr":["Bir temsilciyi, yeni bir cihaz veya süreç oluşturmaya ilişkin bir temsilcinin sorumluluğunu içeren bir eserle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及创建一个新装置或新过程的一个行为者