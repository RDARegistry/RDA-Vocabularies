                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCollectiveAgentOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10011", "lexicalAlias":"http://rdaregistry.info/Elements/c/CollectiveAgent.en", "label":"collective agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50776", "lexicalAlias":"http://rdaregistry.info/Elements/a/creatorCollectiveAgentOfExpressionOf.en", "label":"is creator collective agent of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50447", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserAgentOf.en", "label":"is reviser agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50766", "lexicalAlias":"http://rdaregistry.info/Elements/a/abridgerCollectiveAgentOf.en", "label":"is abridger collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50765", "lexicalAlias":"http://rdaregistry.info/Elements/a/arrangerCollectiveAgentOfMusicOf.en", "label":"is arranger collective agent of music of"},{"@id":"http://rdaregistry.info/Elements/a/P50764", "lexicalAlias":"http://rdaregistry.info/Elements/a/censorCollectiveAgentOf.en", "label":"is censor collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50763", "lexicalAlias":"http://rdaregistry.info/Elements/a/restorationistCollectiveAgentOfExpressionOf.en", "label":"is restorationist collective agent of expression of"},{"@id":"http://rdaregistry.info/Elements/a/P50895", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserCorporateBodyOf.en", "label":"is reviser corporate body of"},{"@id":"http://rdaregistry.info/Elements/a/P51046", "lexicalAlias":"http://rdaregistry.info/Elements/a/reviserFamilyOf.en", "label":"is reviser family of"},{"@id":"http://rdaregistry.info/Elements/a/P50773", "lexicalAlias":"http://rdaregistry.info/Elements/a/transcriberCollectiveAgentOf.en", "label":"is transcriber collective agent of"},{"@id":"http://rda