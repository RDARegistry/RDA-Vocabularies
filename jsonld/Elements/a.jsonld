                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50154", "lexicalAlias":"http://rdaregistry.info/Elements/a/writerOfSupplementaryTextualContentOf.en", "label":"is writer of supplementary textual content of (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/a/writerOfPrefaceOf.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50149", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/writerOfPrefaceOf.en", "label":"is writer of preface of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50149", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/writerOfPrefaceOf.en", "label":"is writer of preface of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50254","label":{"ca":"és escriptor d’un pròleg de","da":"er forfatter til indledning til","de":"ist Verfasser eines Vorworts von","el":"είναι συγγραφέας του προλόγου του","en":"is writer of foreword of (Deprecated)","fi":"alkusanojen kirjoittajana ekspressiossa","fr":"est un auteur d’avant-propos de","hu":"előszó írója"},"definition":{"ca":["Relaciona un agent, que contribueix a una expressió d’una obra proporcionant un pròleg a una obra original, amb una expressió."],"da":["Relaterer en agent, der bidrager til et udtryk af et værk ved at skrive en indledning til et oprindeligt værk til et udtryk."],"de":["Setzt einen Akteur, der an einer Expression eines Werks mitwirkt, indem er ein Vorwort zum Originalwerk liefert, mit einer Expression in Beziehung."],"el":["Συνδέει έναν φορέα, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας έναν πρόλογο στο πρωτότυπο έργο, με μια έκφραση."],"en":["Relates an agent to an expression that includes a contribution of providing a foreword. (Deprecated)"],"fi":["Liittää toimijan teoksen ekspressioon, joka sisältää alkuperäiseen teokseen kirjoitetun esipuheen."],"fr":["Met un agent qui contribue à une expression d’une œuvre en fournissant un avant-propos à une œuvre originale en relation avec une expression."],"hu":["Egy ágenst (személyt, családot vagy testületet), aki/amely hozzájárul egy mű kifejezési formájához azzal, hogy egy eredeti művet előszóval lát el, hozzákapcsol egy kifejezési formához."]},"ToolkitLabel":{"ca":"escriptor d’un pròleg de","da":"forfatter til indledning til","de":"Verfasser eines Vorworts von","el":"συγγραφέας του προλόγου του","en":"writer of foreword of (Deprecated)","fi":"alkusanojen kirjoittajana ekspressiossa","fr":"auteur d’avant-propos de","hu":"előszó írója","no":"forfatter av forord til"},"ToolkitDefinition":{"ca":"Expressió d’una obra que incorpora una contribució que proporciona un pròleg a una obra original.","da":"Udtryk af et værk, der inkorporerer et bidrag ved at skrive en indledning til et oprindeligt værk.","de":"Eine Expression eines Werks, bei der ein Akteur ein Vorwort zum Originalwerk liefert.","el":"Μια έκφραση που ενσωματώνει τη συνεισφορά ενός προλόγου στο πρωτότυπο έργο.","en":"An expression that includes a contribution of providing a foreword. (Deprecated)","fi":"Teoksen ekspressio, joka sisältää alkuperäiseen teokseen kirjoitetun esipuheen.","fr":"Expression d’une œuvre qui intègre une contribution consistant à fournir un avant-propos à une œuvre originale.","hu":"Egy mű kifejezési módja, amely közreműködést testesít meg azzal, hogy egy eredeti művet előszóval lát el.","no":"Et uttrykk av et verk som omfatter et bidrag i form av å tilføre et forord til originalverket."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/a/writerOfForewordOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50154", "lexicalAlias":"http://rdaregistry.info/Elements/a/writerOfSupplementaryTextualContentOf.en", "label":"is writer of supplementary textual content of (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/object/P50254", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/writerOfForewordOf.en", "label":"is writer of foreword of (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50254", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/writerOfForewordOf.en", "label":"is writer of foreword of (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/a/P50171","label":{"ar":"هو وكيل نقّاش لـ","ca":"és agent gravador de","cs":"je rytcem (agentem) (čeho)","da":"er agent, som er gravør af","de":"ist Akteur als Stecherin/Stecher von","de":"ist Akteur als Stecherin/Stecher von","el":"είναι χαράκτης φορέας του","en":"is engraver agent of","es":"es agente grabador de","et":"graveerija (tegija) kehastuses","fi":"kaivertaja (toimija) manifestaatiossa","fr":"est un agent graveur de","hu":"vésnök ágense a következőnek:","it":"è agente incisore di","lv":"ir gravieris (aģents)","nl":"is graveur-actor van","no":"er gravør av (agent)","tr":"gravür sanatçısı temsilcisidir","zh-Hans-CN":"是……的雕版者行为者"},"definition":{"ar":["يربط وكيلا بتجسيدة تنطوي على مسئولية وكيل عن نقش الحروف والأشكال، الخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة."],"ca":["Relaciona un agent amb una manifestació que implica una responsabilitat d’un agent en la gravació de lletres, figures, etc., sobre una superfície com ara una planxa de fusta o de metall usada en la impressió."],"cs":["Vztahuje agenta k provedení, které zahrnuje odpovědnost agenta za vyřezání písmen, číslic atd. na povrchu, jako je dřevěná nebo kovová deska používaná pro tisk."],"da":["Relaterer en agent til en manifestation, som involverer en agents ansvar for at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning."],"de":["Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für das Schneiden von Buchstaben, figürlichen Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist.,Setzt einen Akteur in Beziehung zu einer Manifestation, bei der ein Akteur für das Schneiden von Buchstaben, figürlichen Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist."],"el":["Συνδέει έναν φορέα, ο οποίος εμπλέκεται στην κατασκευή μιας εκδήλωσης μέσω της κοπής γραμμάτων, ψηφίων κ.λπ. σε μια επιφάνεια, όπως μια ξύλινη ή μεταλλική πλάκα που χρησιμοποιείται για την εκτύπωση, με μια εκδήλωση."],"en":["Relates an agent to a manifestation that involves a responsibility of an agent for cutting letters, figures, etc., on a surface such as a wooden or metal plate used for printing."],"es":["Relaciona un agente con una manifestación que involucra la responsabilidad de un agente para cortar letras, figuras, etc., sobre una superficie tal como una placa de madera o metal utilizada para imprimir."],"et":["Seostab tegija kehastusega, mis sisaldab tegija vastutust tähtede, kujundite jms lõikamise eest trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale."],"fi":["Liittää toimijan manifestaatioon, jossa toimija on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tms. painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle."],"fr":["Met un agent en relation avec une manifestation qui comporte une responsabilité de la part d’un agent consistant à graver des lettres, des figures, etc. sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression."],"hu":["Hozzákapcsol egy ágenst egy megjelenés formához, amelyhez hozzátartozik egy ágens felelőssége betűknek, számoknak stb. nyomtatáshoz használt fa- vagy fémlemez felületére történő metszéséért."],"it":["Correla un agente a una manifestazione che implica la responsabilità di un agente per l'incisione di lettere, figure, etc., su una superficie come una lastra di legno o metallo utilizzata per la stampa."],"lv":["Sasaista aģentu ar manifestāciju, kas ietver aģenta atbildību par burtu, zīmju u.tml. iegriešanu uz drukāšanai izmantojama materiāla virsmas (piemēram, uz koka vai metāla plāksnes)."],"nl":["Relateert een actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het snijden van letters, figuren etc., in een ondergrond zoals een houten of metalen plaat gebruikt voor het drukken."],"no":["Relaterer en agent til en manifestasjon som involverer ansvar for en agent i form av utskjæring av bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking."],"tr":["Bir temsilciyi, baskı için kullanılan ahşap veya metal gibi bir plaka yüzey üzerinde, harf, rakam vb...yi kesmekle görevli bir temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个行为者与涉及通过在木版或金属版等表面上雕刻字母、图形等以用于印刷的一个行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل نقّاش","ca":"agent gravador de","cs":"rytec (agent) (čeho)","da":"agent, som er gravør af","de":"Akteur als Stecherin/Stecher von","de":"Akteur als Stecherin/Stecher von","el":"χαράκτης φορέας του","en":"engraver agent of","es":"agente grabador de","et":"graveerija (tegija) kehastuses","fi":"kaivertaja (toimija) manifestaatiossa","fr":"agent graveur de","hu":"vésnök ágense:","it":"incisore agente di","lv":"ir gravieris (aģents)","nl":"graveur-actor van","no":"gravør av (agent)","tr":"gravür sanatçısı temsilcisi","zh-Hans-CN":"……的雕版者行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل عن نقش الحروف والأشكال، الخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة.","ca":"Manifestació que implica una responsabilitat d’un agent en la gravació de lletres, figures, etc., sobre una superfície com ara una planxa de fusta o de metall usada en la impressió.","cs":"Provedení, které zahrnuje odpovědnost agenta za vyřezání písmen, číslic atd. na povrchu, jako je dřevěná nebo kovová deska používaná pro tisk.","da":"Manifestation, som involverer en agents ansvar for at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning.","de":"Eine Manifestation, bei der ein Akteur für das Schneiden von Buchstaben, figürliche Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist.","de":"Eine Manifestation, bei der ein Akteur für das Schneiden von Buchstaben, figürliche Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist.","el":"Μια εκδήλωση που κατασκευάζεται από έναν φορέα υπεύθυνο για την κοπή γραμμάτων, ψηφίων κ.λπ. σε μια επιφάνεια, όπως μια ξύλινη ή μεταλλική πλάκα που χρησιμοποιείται για την εκτύπωση.","en":"A manifestation that involves a responsibility of an agent for cutting letters, figures, etc., on a surface such as a wooden or metal plate used for printing.","es":"Una manifestación que involucra una responsabilidad de un agente para cortar letras, figuras, etc., sobre una superficie tal como una placa de madera o metal utilizada para imprimir.","et":"Kehastus, mis sisaldab tegija vastutust tähtede, kujundite jms lõikamise eest trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale.","fi":"Manifestaatio, jossa toimija on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tms. painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent consistant à graver des lettres, des figures, etc. sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression.","hu":"Egy megjelenés forma, amelyhez hozzátartozik egy ágens felelőssége betűknek, számoknak stb. nyomtatáshoz használt fa- vagy fémlemez felületére történő metszéséért.","it":"Manifestazione che implica la responsabilità di un agente per l'incisione di lettere, figure, etc., su una superficie come una lastra di legno o metallo utilizzata per la stampa.","lv":"Manifestācija, kas ietver aģenta atbildību par burtu, zīmju u.tml. iegriešanu uz drukāšanai izmantojama materiāla virsmas (piemēram, uz koka vai metāla plāksnes).","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een actor voor het snijden van letters, figuren etc., in een ondergrond zoals een houten of metalen plaat gebruikt voor het drukken.","no":"En manifestasjon som involverer ansvar for en agent i form av utskjæring av bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking.","tr":"Baskı için kullanılan ahşap veya metal bir levha gibi bir yüzey üzerine harf, şekil vb. kesmek için bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及通过在木版或金属版等表面上雕刻字母、图形等以用于印刷的一个行为者的责任的一种载体表现"},"altLabel":{"ar":["نقّاش"],"ca":["gravador de"],"cs":["rytec (čeho)"],"da":["gravør af"],"de":["Stecher von,Stecher von"],"el":["χαράκτης του"],"en":["engraver of"],"es":["grabador de"],"et":["graveerija kehastuses"],"fi":["kaivertajana painotuotteessa"],"fr":["graveur de"],"hu":["vésnöke:"],"it":["incisore di"],"nl":["graveur van"],"no":["gravør av"],"tr":["gravür sanatçısı"],"zh-Hans-CN":["……的雕版者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10002", "lexicalAlias":"http://rdaregistry.info/Elements/c/Agent.en", "label":"agent"},"lexicalAlias":"http://rdaregistry.info/Elements/a/engraverAgentOf.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/a/P50173", "lexicalAlias":"http://rdaregistry.info/Elements/a/printmakerAgentOf.en", "label":"is printmaker agent of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/a/P50646", "lexicalAlias":"http://rdaregistry.info/Elements/a/engraverCollectiveAgentOf.en", "label":"is engraver collective agent of"},{"@id":"http://rdaregistry.info/Elements/a/P50495", "lexicalAlias":"http://rdaregistry.info/Elements/a/engraverPersonOf.en", "label":"is engraver person of"},{"@id":"http://rdaregistry.info/Elements/a/object/P50171", "lexicalAlias":"http://rdaregistry.info/Elements/a/object/engraverAgentOf.en", "label":"is engraver agent of"},{"@id":"http://rdaregistry.info/Elements/a/datatype/P50171", "lexicalAlias":"http://rdaregistry.info/Elements/a/datatype/engraverAgentOf.en", "label":"is engraver agent of"}]},{"@id":"http://rdaregistry.info/Elements/a/P50646","label":{"ar":"هو وكيل جماعي نقّاش لـ","ca":"és agent col·lectiu gravador de","cs":"je rytcem (kolektivním agentem) (čeho)","da":"er kollektiv agent, som er gravør af","de":"ist gemeinschaftlicher Akteur als Stecherin/Stecher von","de":"ist gemeinschaftlicher Akteur als Stecherin/Stecher von","el":"είναι χαράκτης συλλογικός φορέας του","en":"is engraver collective agent of","es":"es agente colectivo grabador de","et":"graveerija (kollektiiv) kehastuses","fi":"kaivertaja (yhteistoimija) manifestaatiossa","fr":"est un agent collectif graveur de","hu":"vésnök kollektív ágense a következőnek:","it":"è incisore agente collettivo di","lv":"ir gravieris (grupa)","nl":"is graveur-collectieve actor van","no":"er gravør for (kollektiv agent)","tr":"gravür sanatçısı kolektif temsilcisidir","zh-Hans-CN":"是……的雕版者集体行为者"},"definition":{"ar":["يربط وكيلا جماعيا بتجسيدة تنطوي على مسئولية وكيل جماعي عن رص الحروف والأشكال، الخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة."],"ca":["Relaciona un agent col·lectiu amb una manifestació que implica una responsabilitat d’un agent col·lectiu en la gravació de lletres, figures, etc., sobre una superfície com ara una planxa de fusta o de metall usada en la impressió."],"cs":["Vztahuje kolektivního agenta k provedení, které zahrnuje odpovědnost kolektivního agenta za vyřezání písmen, číslic atd. na povrchu, jako je dřevěná nebo kovová deska používaná pro tisk."],"da":["Relaterer en kollektiv agent til en manifestation, som involverer en kollektiv agents ansvar for at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning."],"de":["Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für das Schneiden von Buchstaben, figürlichen Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist.,Setzt einen gemeinschaftlichen Akteur in Beziehung zu einer Manifestation, bei der ein gemeinschaftlicher Akteur für das Schneiden von Buchstaben, figürlichen Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist."],"en":["Relates a collective agent to a manifestation that involves a responsibility of a collective agent for cutting letters, figures, etc., on a surface such as a wooden or metal plate used for printing."],"es":["Relaciona un agente colectivo con una manifestación que implica la responsabilidad de un agente colectivo de cortar letras, figuras, etc., sobre una superficie como una placa de madera o metal utilizada para imprimir."],"et":["Seostab kollektiivi kehastusega, mis sisaldab kollektiivi vastutust tähtede, kujundite jms lõikamise eest trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale."],"fi":["Liittää yhteistoimijan manifestaatioon, jossa yhteistoimija on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tms. painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle."],"fr":["Met un agent collectif en relation avec une manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à graver des lettres, des figures, etc. sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression."],"hu":["Hozzákapcsol egy kollektív ágenst egy megjelenési formához, amelyhez hozzátartozik egy kollektív ágens felelőssége betűknek, számoknak stb. nyomtatáshoz használt fa- vagy fémlemez felületére történő metszéséért."],"it":["Correla un agente collettivo a una manifestazione che implica una responsabilità di un agente collettivo per l'incisione di lettere, figure, etc., su una superficie come una lastra di legno o metallo utilizzata per la stampa."],"lv":["Sasaista grupu ar manifestāciju, kas ietver grupas atbildību par burtu, zīmju u.tml. iegriešanu uz drukāšanai izmantojama materiāla virsmas (piemēram, uz koka vai metāla plāksnes)."],"nl":["Relateert een collectieve actor aan een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het snijden van letters, figuren etc., in een ondergrond zoals een houten of metalen plaat gebruikt voor het drukken."],"no":["Relaterer en kollektiv agent til en manifestasjon som involverer et ansvar for en kollektiv agent i form av å skjære ut bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking."],"tr":["Kolektif bir temsilciyi, baskı için kullanılan ahşap veya metal bir plaka gibi bir yüzey üzerinde harfleri, şekilleri vb. kesmek için kolektif bir temsilcinin sorumluluğunu içeren bir gösterimle ilişkilendirir."],"zh-Hans-CN":["将一个集体行为者与涉及通过在木版或金属版等表面上雕刻字母、图形等以用于印刷的一个集体行为者的责任的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي نقاش","ca":"agent col·lectiu gravador de","cs":"rytec (kolektivní agent) (čeho)","da":"kollektiv agent, som er gravør af","de":"Gemeinschaftlicher Akteur als Stecherin/Stecher von","de":"Gemeinschaftlicher Akteur als Stecherin/Stecher von","el":"χαράκτης συλλογικός φορέας του","en":"engraver collective agent of","es":"agente colectivo grabador de","et":"graveerija (kollektiiv) kehastuses","fi":"kaivertaja (yhteistoimija) manifestaatiossa","fr":"agent collectif graveur de","hu":"vésnök kollektív ágense:","it":"incisore agente collettivo di","lv":"ir gravieris (grupa)","nl":"graveur-collectieve actor van","no":"gravør for (kollektiv agent)","tr":"gravür sanatçısı kolektif temsilcisi","zh-Hans-CN":"……的雕版者集体行为者"},"ToolkitDefinition":{"ar":"تجسيدة تنطوي على مسئولية وكيل جماعي عن رص الحروف والأشكال، الخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة.","ca":"Manifestació que implica una responsabilitat d’un agent col·lectiu en la gravació de lletres, figures, etc., sobre una superfície com ara una planxa de fusta o de metall usada en la impressió.","cs":"Provedení, které zahrnuje odpovědnost kolektivního agenta za vyřezání písmen, číslic atd. na povrchu, jako je dřevěná nebo kovová deska používaná pro tisk.","da":"Manifestation, som involverer en kollektiv agents ansvar for at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für das Schneiden von Buchstaben, figürlichen Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist.","de":"Eine Manifestation, bei der ein gemeinschaftlicher Akteur für das Schneiden von Buchstaben, figürlichen Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte, die zum Drucken benutzt wird, verantwortlich ist.","en":"A manifestation that involves a responsibility of a collective agent for cutting letters, figures, etc., on a surface such as a wooden or metal plate used for printing.","es":"Una manifestación que implica la responsabilidad de un agente colectivo de cortar letras, figuras, etc., sobre una superficie como una placa de madera o metal utilizada para imprimir.","et":"Kehastus, mis sisaldab kollektiivi vastutust tähtede, kujundite jms lõikamise eest trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale.","fi":"Manifestaatio, jossa yhteistoimija on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tms. painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle.","fr":"Manifestation qui comporte une responsabilité de la part d’un agent collectif consistant à graver des lettres, des figures, etc. sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression.","hu":"Egy megjelenési forma, amelyhez hozzátartozik egy kollektív ágens felelőssége betűknek, számoknak stb. nyomtatáshoz használt fa- vagy fémlemez felületére történő metszéséért.","it":"Manifestazione che implica una responsabilità di un agente collettivo per l'incisione di lettere, figure, etc., su una superficie come una lastra di legno o metallo utilizzata per la stampa.","lv":"Manifestācija, kas ietver grupas atbildību par burtu, zīmju u.tml. iegriešanu uz drukāšanai izmantojama materiāla virsmas (piemēram, uz koka vai metāla plāksnes).","nl":"Een manifestatie die met zich meebrengt een verantwoordelijkheid van een collectieve actor voor het snijden van letters, figuren etc., in een ondergrond zoals een houten of metalen plaat gebruikt voor het drukken.","no":"En manifestasjon som involverer et ansvar for en kollektiv agent i form av å skjære ut bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking.","tr":"Baskı için kullanılan ahşap veya metal bir plaka gibi bir yüzey üzerine harfleri, şekilleri vb. kesmek için kolektif bir temsilcinin sorumluluğunu içeren bir gösterim.","zh-Hans-CN":"涉及通过在木版或金属版等表面上雕刻字母、图形等以用于印刷的一个集体行为者的责任的一种载体表现"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/a/", "label":"Agent properties"},"status": {
