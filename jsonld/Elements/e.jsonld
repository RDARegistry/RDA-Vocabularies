                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/voiceActorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20369", "lexicalAlias":"http://rdaregistry.info/Elements/e/actorPerson.en", "label":"has actor person"},{"@id":"http://rdaregistry.info/Elements/e/P20070", "lexicalAlias":"http://rdaregistry.info/Elements/e/voiceActorAgent.en", "label":"has voice actor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20384", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/voiceActorPerson.en", "label":"has voice actor person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20384", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/voiceActorPerson.en", "label":"has voice actor person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20236","ToolkitLabel":{"ca":"relació d’expressió tot-part","da":"helheds-del udtryksrelation","de":"Teil-Ganzes-Beziehung auf Expressionsebene","el":"σχέση συνόλου-τμήματος έκφρασης με","es":"relación de la expresión todo-parte","fi":"ekspression osa-kokonaissuhde","fr":"relation d’expression tout-partie","no":"relasjonstypen hel/del av uttrykk","vi":"mối quan hệ biểu hiện toàn bộ-phần"},"ToolkitDefinition":{"ca":"Expressió d’una obra que és continguda o conté una altra expressió.","da":"Udtryk der er indeholdt i eller indeholder et udtryk.","de":"Eine Expression, die in einer anderen Expression enthalten ist oder eine andere Expression enthält.","el":"Μια έκφραση η οποία περιέχεται σε ή περιέχει μια έκφραση.","es":"Una expresión que es incluida en, o contiene la expresión.","fi":"Ekspressio, joka sisältyy toiseen ekspressioon tai sisältää toisen ekspression.","fr":"Expression qui contient ou est contenue dans une autre expression.","no":"Et uttrykk som omfattes av eller selv omfatter et annet uttrykk.","vi":"Biểu hiện được chứa trong hoặc chứa biểu hiện khác."},"label":{"ca":"té com a relació d’expressió tot-part","da":"har helheds-del udtryksrelation med","de":"hat Teil-Ganzes-Beziehungen auf Expressionsebene","el":"έχει σχέση συνόλου-τμήματος έκφρασης με","fi":"ekspression osa-kokonaissuhde","fr":"a pour relation d’expression tout-partie","vi":"có mối quan hệ biểu hiện toàn bộ-phần"},"definition":{"ca":["Relaciona una expressió amb una expressió d’una obra que és continguda o conté una altra expressió."],"da":["Relaterer et udtryk til et udtryk der er indeholdt i eller indeholder et udtryk."],"de":["Setzt eine Expression mit einer Expression, die in einer anderen Expression enthalten ist oder eine andere Expression enthält, in Beziehung."],"el":["Συνδέει μια έκφραση με μια έκφραση η οποία περιέχεται σε ή περιέχει μια έκφραση."],"fi":["Liittää ekspression ekspressioon, joka sisältyy toiseen ekspressioon tai sisältää toisen ekspression."],"fr":["Met une expression en relation avec une expression qui contient ou est contenue dans une autre expression."],"vi":["Liên kết một biểu hiện với biểu hiện được chứa trong hoặc chứa biểu hiện khác."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/wholePartExpressionRelationship.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20236", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/wholePartExpressionRelationship.en", "label":"has whole-part expression relationship (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20236", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/wholePartExpressionRelationship.en", "label":"has whole-part expression relationship (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20252","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم عملا موسيقيا في فيلم سينمائي."],"ca":["Relaciona una expressió amb una expressió d’una obra que usa una obra musical en una pel·lícula cinematogràfica."],"cs":["Vztahuje vyjádření k vyjádření díla, které využívá hudební dílo ve filmu."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvender et musikværk i en spillefilm."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die ein Musikwerk in einem Film verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die ein Musikwerk in einem Film verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο χρησιμοποιεί ένα μουσικό έργο σε μια κινηματογραφική ταινία."],"en":["Relates an expression to an expression of a work that uses a musical work in a motion picture."],"es":["Relaciona una expresión con una expresión de una obra que utiliza una obra musical en una película."],"et":["Seostab väljenduse filmiteose väljendusega, milles kasutatakse muusikateost."],"fi":["Liittää ekspression teoksen ekspressioon, joka käyttää musiikkiteosta elokuvassa."],"fr":["Met une expression en relation avec une expression d’une œuvre qui utilise une œuvre musicale dans un film."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy zeneművet használ egy mozgóképben."],"lv":["Sasaista izteiksmi ar darba izteiksmi - kinofilma, kurā izmantots mūzikas darbs."],"nl":["Relateert een expressie aan een expressie van een werk dat een muziekwerk in een speelfim gebruikt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som bruker et musikalsk verk i en spillefilm."],"tr":["Bir anlatımı, bir sinema filminde bir müzik eserini kullanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sử dụng tác phẩm âm nhạc trong phim điện ảnh."],"zh-Hans-CN":["将一种内容表达与使用一种电影中的一种音乐作品的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"موسيقي لتعبيرة فيلم سينمائي","ca":"música per a una expressió de pel·lícula cinematogràfica","cs":"hudba pro film (vyjádření)","da":"musik til filmudtryk","de":"Musik für Film (Expression)","de":"Musik für Film (Expression)","el":"μουσική για κινηματογραφική ταινία (έκφραση)","en":"music for motion picture expression","es":"música para la expresión cinematográfica","et":"muusika filmile (väljendus)","fi":"musiikki elokuvaan (ekspressio)","fr":"musique pour un film (expression)","hu":"zene a következő mozgókép kifejezési formájához:","lv":"mūzika kino izteiksmei","nl":"muziek voor speelfilm-expressie","no":"musikk for spillefilm (uttrykk)","tr":"sinema filmi ifadesi için müzik","vi":"âm nhạc của điện ảnh (biểu hiện)","zh-Hans-CN":"用于电影内容表达的音乐"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم عملا موسيقيا في فيلم سينمائي.","ca":"Expressió d’una obra que usa una obra musical en una pel·lícula cinematogràfica.","cs":"Vyjádření díla, které využívá hudební dílo ve filmu.","da":"Udtryk af et værk, som anvender et musikværk i en spillefilm.","de":"Eine Expression eines Werks, die ein Musikwerk in einem Film verwendet.","de":"Eine Expression eines Werks, die ein Musikwerk in einem Film verwendet.","el":"Μια έκφραση ενός έργου το οποίο χρησιμοποιεί ένα μουσικό έργο σε μια κινηματογραφική ταινία.","en":"An expression of a work that uses a musical work in a motion picture.","es":"Una expresión de una obra que utiliza una obra musical en una película.","et":"Filmiteose väljendus, milles kasutatakse muusikateost.","fi":"Teoksen ekspressio, joka käyttää musiikkiteosta elokuvassa.","fr":"Expression d’une œuvre qui utilise une œuvre musicale dans un film.","hu":"Egy mű kifejezési formája, amely egy zeneművet használ egy mozgóképben.","lv":"Darba izteiksme - kinofilma, kurā izmantots mūzikas darbs.","nl":"Een expressie van een werk dat een muziekwerk in een speelfim gebruikt.","no":"Et uttrykk av et verk som bruker et musikalsk verk i en spillefilm.","tr":"Bir sinema filminde müzik eseri kullanan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sử dụng tác phẩm âm nhạc trong phim điện ảnh.","zh-Hans-CN":"使用一种电影中的一种音乐作品的一种作品的一种内容表达"},"label":{"ar":"هي موسيقي لتعبيرة فيلم سينمائي","ca":"és música per a una expressió de pel·lícula cinematogràfica","cs":"je hudbou pro film (vyjádření)","da":"er musik til filmudtryk","de":"ist Musik für Film (Expression)","de":"ist Musik für Film (Expression)","el":"είναι μουσική για κινηματογραφική ταινία (έκφραση)","en":"is music for motion picture expression","es":"es música para la expresión cinematográfica","et":"muusika filmile (väljendus)","fi":"musiikki elokuvaan (ekspressio)","fr":"est une musique pour un film (expression)","hu":"zene a következő mozgókép kifejezési formájához:","lv":"ir mūzika kino izteiksmei","nl":"is muziek voor speelfilm-expressie","no":"er musikk for spillefilm (uttrykk)","tr":"sinema filmi anlatımı müziğidir","vi":"là âm nhạc của điện ảnh (biểu hiện)","zh-Hans-CN":"是用于电影内容表达的音乐"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForExpression.en", "label":"is music for expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicForMotionPictureExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20252", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicForMotionPictureExpression.en", "label":"is music for motion picture expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20252", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicForMotionPictureExpression.en", "label":"is music for motion picture expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20262","definition":{"ar":["تربط بين تعبيرة وتفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى موسيقي لتعبيرة."],"ca":["Relaciona una expressió amb les particularitats del conjunt de caràcters o de símbols usat per expressar el contingut musical d’una expressió."],"cs":["Vztahuje vyjádření k podrobnostem o souboru znaků nebo symbolů použitých k vyjadřování hudebního obsahu vyjádření."],"da":["Relaterer et udtryk til detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks musikalske indhold."],"de":["Setzt eine Expression in Beziehung zu Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με τις λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για την έκφραση του μουσικού περιεχομένου μιας έκφρασης."],"en":["Relates an expression to details of a set of characters or symbols used to express musical content of an expression. (Deprecated)"],"es":["Relaciona una expresión con detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido musical de una expresión."],"et":["Seostab väljenduse täpsemate andmetega märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse muusikalise sisu väljendamiseks."],"fi":["Liittää ekspression tarkempiin tietoihin merkeistä ja symboleista, joilla ekspression musiikkisisältö on ilmaistu."],"fr":["Met une expression en relation avec des particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer un contenu musical d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma zenei tartalmát kifejező karakterek vagy szimbólumok csoportjának részleteihez."],"lv":["Sasaista izteiksmi ar sīkāku informāciju par zīmju vai simbolu kopumu, kas ticis lietots, lai atklātu mūzikas izteiksmes saturu."],"nl":["Relateert een expressie aan details van een verzameling van tekens of symbolen gebruikt om muziekcontent van een expressie uit te drukken."],"no":["Relaterer et uttrykk til detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke det musikalske innholdet i et uttrykk."],"tr":["Bir anlatımı, bir anlatımın müzikal içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntılarıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung âm nhạc của biểu hiện."],"zh-Hans-CN":["将一种内容表达与用于表示一种内容表达之音乐内容的字符或符号的集合的细节关联起来。"]},"ToolkitLabel":{"ar":"تفاصيل شكل من أشكال التدوين الموسيقي","ca":"particularitats de forma de notació musical","cs":"podrobnosti o formě záznamu hudby","da":"detaljer om musikalsk notationsform","de":"Details zur Form der Musiknotation","de":"Details zur Form der Musiknotation","el":"λεπτομέρειες της μορφής της μουσικής σημειογραφίας","en":"details of form of musical notation (Deprecated)","es":"detalles de la forma de notación musical","et":"muusikanotatsiooni vormi täpsustus","fi":"nuottikirjoituksen tyypin tarkemmat tiedot","fr":"particularités d’une forme de notation musicale","hu":"zenei lejegyzés formájának részletei:","lv":"detalizēti par notācijas formu","nl":"details van vorm van muzieknotatie","no":"detaljer vedrørende musikknotasjon","sv":"detaljerad information om form av musiknotation","tr":"müzikal nota biçiminin ayrıntıları","vi":"chi tiết của hình thái ký hiệu âm nhạc","zh-Hans-CN":"乐谱形式的细节"},"ToolkitDefinition":{"ar":"تفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى موسيقي لتعبيرة.","ca":"Particularitats d’un conjunt de caràcters o de símbols usat per expressar el contingut musical d’una expressió.","cs":"Podrobnosti o souboru znaků nebo symbolů použitých k vyjadřování hudebního obsahu vyjádření.","da":"Detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks musikalske indhold.","de":"Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken.","de":"Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken.","el":"Οι λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για την έκφραση του μουσικού περιεχομένου μιας έκφρασης.","en":"Details of a set of characters or symbols used to express musical content of an expression. (Deprecated)","es":"Detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido musical de una expresión.","et":"Täpsemad andmed märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse muusikalise sisu väljendamiseks.","fi":"Tarkemmat tiedot merkeistä ja symboleista, joilla ekspression musiikkisisältö on ilmaistu.","fr":"Particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer un contenu musical d’une expression.","hu":"Egy kifejezési forma zenei tartalmát kifejező karakterek vagy szimbólumok csoportjának részletei.","lv":"Sīkāka informācija par zīmju vai simbolu kopumu, kas ticis lietots, lai atklātu mūzikas izteiksmes saturu.","nl":"Details van een verzameling van tekens of symbolen gebruikt om muziekcontent van een expressie uit te drukken.","no":"Detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke det musikalske innholdet i et uttrykk.","tr":"Bir anlatımın müzikal içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntıları.","vi":"Chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung âm nhạc của biểu hiện.","zh-Hans-CN":"用于表示一种内容表达之音乐内容的字符或符号的集合的细节"},"label":{"ar":"لها تفاصيل شكل من أشكال التدوين الموسيقي","ca":"té com a particularitats de forma de notació musical","cs":"má podrobnosti o formě záznamu hudby","da":"har detaljer om musikalsk notationsform","de":"hat Details zur Form der Musiknotation","de":"hat Details zur Form der Musiknotation","el":"έχει λεπτομέρειες της μορφής της μουσικής σημειογραφίας","en":"has details of form of musical notation (Deprecated)","es":"tiene detalles de la forma de notación musical","et":"muusikanotatsiooni vormi täpsustus","fi":"nuottikirjoituksen tyypin tarkemmat tiedot","fr":"a pour particularités d’une forme de notation musicale","hu":"zenei lejegyzés formájának részletei a következők:","lv":"detalizēti par notācijas formu","nl":"heeft details van vorm van muzieknotatie","no":"har detaljer vedrørende musikknotasjon","sv":"har detaljerad information om form av musiknotation","tr":"müzik notasyonu biçiminin ayrıntıları ile ilişkilidir","vi":"có chi tiết của hình thái ký hiệu âm nhạc","zh-Hans-CN":"有乐谱形式的细节"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfFormOfMusicalNotation.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.13.3.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20262", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfFormOfMusicalNotation.en", "label":"has details of form of musical notation (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20243","label":{"ar":"لها تعبيرة موسيقى","ca":"té com a expressió de música","cs":"má hudbu (vyjádření)","da":"har musikudtryk","de":"hat Musik (Expression)","de":"hat Musik (Expression)","el":"είναι μουσική (έκφραση)","en":"has music expression","es":"tiene expresión musical","et":"muusika (väljendus)","fi":"musiikki (ekspressio)","fr":"a pour musique (expression)","hu":"zenei kifejezési formája a következő:","lv":"izteiksme: mūzika","nl":"heeft muziek-expressie","no":"har musikk (uttrykk)","tr":"müzik anlatımı ile ilişkilidir","vi":"là âm nhạc (biểu hiện)","zh-Hans-CN":"有音乐内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل موسيقي يستخدم في فيلم سينمائي، أو مسرحية، أو برنامج تليفزيوني، إلخ."],"ca":["Relaciona una expressió amb una expressió d’una obra musical que s’usa en una pel·lícula cinematogràfica, una obra de teatre, un programa de televisió, etc."],"cs":["Vztahuje vyjádření k vyjádření hudebního díla, které je použito ve filmu, divadelní hře, televizním programu atd."],"da":["Relaterer et udtryk til et udtryk af et musikværk, som anvendes i en spillefilm, skuespil, tv-program etc."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks, die in einem Film, einem Theaterstück, einer Fernsehsendung und so weiter verwendet wird.,Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks, die in einem Film, einem Theaterstück, einer Fernsehsendung und so weiter verwendet wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μουσικού έργου το οποίο χρησιμοποιείται σε μια κινηματογραφική ταινία, ένα θεατρικό έργο, ένα τηλεοπτικό πρόγραμμα κ.λπ."],"en":["Relates an expression to an expression of a musical work that is used in a motion picture, play, television program, etc."],"es":["Relaciona una expresión con una expresión de una obra musical que se utiliza en una película, obra de teatro, programa de televisión, etc."],"et":["Seostab väljenduse muusikateose väljendusega, mida kasutatakse filmis, näidendis, telesaates vms."],"fi":["Liittää ekspression musiikkiteoksen ekspressioon, jota käytetään elokuvassa, näytelmässä, televisio-ohjelmassa jne."],"fr":["Met une expression en relation avec une expression d’une œuvre musicale qui est utilisée dans un film, une pièce de théâtre, une émission de télévision, etc."],"hu":["Hozzákapcsol egy kifejezési formát egy zenemű kifejezési formájához, amelyet egy filmben, színdarabban, tévéműsorban stb. használnak."],"lv":["Sasaista izteiksmi ar mūzikas darba izteiksmi, kas izmantota kinofilmā, uzvedumā, televīzijas raidījumā, u.tml."],"nl":["Relateert een expressie aan een expressie van een muziekwerk dat gebruikt is in een speelfilm, toneelstuk, televisieprogramma etc."],"no":["Relaterer et uttrykk til et uttrykk av et musikalsk verk brukt i en spillefilm, et skuespill, et fjernsynsprogram etc."],"tr":["Bir anlatımı, bir sinema filmi, tiyatro oyunu, televizyon programı vb. içinde kullanılan bir müzik eserinin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm âm nhạc được sử dụng trong phim điện ảnh, kịch, chương trình truyền hình, v.v..."],"zh-Hans-CN":["将一种内容表达与被用于电影、戏剧、电视节目等中的一种音乐作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"لها تعبيرة موسيقى","ca":"expressió de música","cs":"hudba (vyjádření)","da":"musikudtryk","de":"Musik (Expression)","de":"Musik (Expression)","el":"μουσική (έκφραση)","en":"music expression","es":"expresión musical","et":"muusika (väljendus)","fi":"musiikki (ekspressio)","fr":"musique (expression)","hu":"zenei kifejezési forma:","lv":"izteiksme: mūzika","nl":"muziek-expressie","no":"musikk (uttrykk)","tr":"müzik ifadesi","vi":"âm nhạc (biểu hiện)","zh-Hans-CN":"音乐内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل موسيقي يستخدم في فيلم سينمائي، أو مسرحية، أو برنامج تليفزيوني، إلخ.","ca":"Expressió d’una obra musical que s’usa en una pel·lícula cinematogràfica, una obra de teatre, un programa de televisió, etc.","cs":"Vyjádření hudebního díla, které je použito ve filmu, divadelní hře, televizním programu atd.","da":"Udtryk af et musikværk, som anvendes i en spillefilm, skuespil, tv-program etc.","de":"Eine Expression eines Musikwerks, die in einem Film, einem Theaterstück, einer Fernsehsendung und so weiter verwendet wird.","de":"Eine Expression eines Musikwerks, die in einem Film, einem Theaterstück, einer Fernsehsendung und so weiter verwendet wird.","el":"Μια έκφραση ενός μουσικού έργου το οποίο χρησιμοποιείται σε μια κινηματογραφική ταινία, ένα θεατρικό έργο, ένα τηλεοπτικό πρόγραμμα κ.λπ.","en":"An expression of a musical work that is used in a motion picture, play, television program, etc.","es":"Una expresión de una obra musical que se utiliza en una película, obra de teatro, programa de televisión, etc.","et":"Muusikateose väljendus, mida kasutatakse filmis, näidendis, telesaates vms.","fi":"Musiikkiteoksen ekspressio, jota käytetään elokuvassa, näytelmässä, televisio-ohjelmassa jne.","fr":"Expression d’une œuvre musicale qui est utilisée dans un film, une pièce de théâtre, une émission de télévision, etc.","hu":"Egy zenemű kifejezési formája, amelyet egy filmen, színdarabban, tévéműsorban stb. használnak.","lv":"Mūzikas darba izteiksme, kas izmantota kinofilmā, uzvedumā, televīzijas raidījumā, u.tml.","nl":"Een expressie van een muziekwerk dat gebruikt is in een speelfilm, toneelstuk, televisieprogramma etc.","no":"Et uttrykk av et musikalsk verk brukt i en spillefilm, et skuespill, et fjernsynsprogram etc.","tr":"Bir sinema filminde, oyunda, televizyon programında vb. kullanılan bir müzik eserinin anlatımı.","vi":"Biểu hiện của tác phẩm âm nhạc được sử dụng trong phim điện ảnh, kịch, chương trình truyền hình, v.v...","zh-Hans-CN":"被用于电影、戏剧、电视节目等中的一种音乐作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20251", "lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureMusicExpression.en", "label":"has motion picture music expression"},{"@id":"http://rdaregistry.info/Elements/e/P20085", "lexicalAlias":"http://rdaregistry.info/Elements/e/incidentalMusicExpression.en", "label":"has incidental music expression"},{"@id":"http://rdaregistry.info/Elements/e/P20249", "lexicalAlias":"http://rdaregistry.info/Elements/e/radioProgramMusicExpression.en", "label":"has radio program music expression"},{"@id":"http://rdaregistry.info/Elements/e/P20247", "lexicalAlias":"http://rdaregistry.info/Elements/e/televisionProgramMusicExpression.en", "label":"has television program music expression"},{"@id":"http://rdaregistry.info/Elements/e/P20245", "lexicalAlias":"http://rdaregistry.info/Elements/e/videoMusicExpression.en", "label":"has video music expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20243", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicExpression.en", "label":"has music expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20243", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicExpression.en", "label":"has music expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20064","definition":{"ar":["تربط بين تعبيرة ومجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى موسيقي لتعبيرة."],"ca":["Relaciona una expressió amb un conjunt de caràcters o de símbols usat per expressar el contingut musical d’una expressió."],"cs":["Vztahuje vyjádření k souboru znaků nebo symbolů, používaných k vyjadřování hudebního obsahu vyjádření."],"da":["Relaterer et udtryk til et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks musikindhold."],"de":["Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το μουσικό περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to a set of characters or symbols used to express musical content of an expression."],"es":["Relaciona una expresión con un conjunto de caracteres o símbolos utilizados para expresar el contenido musical de una expresión."],"et":["Seostab väljenduse märkide või sümbolite kogumiga, mida on kasutatud väljenduse muusikalise sisu väljendamiseks."],"fi":["Liittää ekspression joukkoon merkkejä tai symboleja, joita käytetään ekspression musiikillisen sisällön ilmaisemiseen."],"fr":["Met une expression en relation avec un ensemble de caractères ou de symboles utilisé pour exprimer un contenu musical d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát karakterek vagy szimbólumok egy csoportjához, amelyet arra használnak, hogy egy kifejezési forma zenei tartalmát kifejezze."],"lv":["Sasaista izteiksmi ar zīmju vai simbolu kopumu, kas tiek lietoti, lai atklātu izteiksmes mūzikas saturu."],"nl":["Relateert een expressie aan een verzameling van karakters of symbolen gebruikt om muziekcontent van een expressie weer te geven."],"no":["Relaterer et uttrykk til et sett med tegn eller symboler som brukes til å uttrykke det musikalske innholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın müzikal içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung âm nhạc của biểu hiện."],"zh-Hans-CN":["将一种内容表达与用于表达一种内容表达的音乐内容的字符或符号的集合关联起来。"]},"ToolkitLabel":{"ar":"شكل من أشكال التدوين الموسيقي","ca":"forma de notació musical","cs":"podoba hudebního zápisu","da":"musikalsk notationsform","de":"Form einer Musiknotation","de":"Form einer Musiknotation","el":"μορφή της μουσικής σημειογραφίας","en":"form of musical notation","es":"forma de notación musical","et":"muusikanotatsiooni vorm","fi":"nuottikirjoituksen tyyppi","fr":"forme de notation musicale","hu":"zenei lejegyzés formája:","lv":"notācijas forma","nl":"vorm van muzieknotatie","no":"musikknotasjonsform","sv":"form av musiknotation","tr":"müzikal notasyon formu","vi":"hình thái của ký hiệu âm nhạc","zh-Hans-CN":"乐谱的形式"},"ToolkitDefinition":{"ar":"مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى موسيقي لتعبيرة.","ca":"Conjunt de caràcters o de símbols usat per expressar el contingut musical d’una expressió.","cs":"Vztahuje vyjádření k souboru znaků nebo symbolů, používaných k vyjadřování hudebního obsahu vyjádření.","da":"Sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks musikindhold.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den musikalischen Inhalt einer Expression auszudrücken.","el":"Ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το μουσικό περιεχόμενο μιας έκφρασης.","en":"A set of characters or symbols used to express musical content of an expression.","es":"Conjunto de caracteres o símbolos utilizados para expresar el contenido musical de una expresión.","et":"Märkide või sümbolite kogum, mida on kasutatud väljenduse muusikalise sisu väljendamiseks.","fi":"Joukko merkkejä tai symboleja, joita käytetään ekspression musiikillisen sisällön ilmaisemiseen.","fr":"Ensemble de caractères ou de symboles utilisé pour exprimer un contenu musical d’une expression.","hu":"zenei lejegyzés formája:","lv":"Zīmju vai simbolu kopums, kas tiek lietoti, lai atklātu izteiksmes mūzikas saturu.","nl":"Een verzameling van karakters of symbolen gebruikt om muziekcontent van een expressie weer te geven.","no":"Et sett med tegn eller symboler som brukes til å uttrykke det musikalske innholdet i et uttrykk.","tr":"Bir anlatımın müzikal içeriğini ifade etmek için kullanılan karakterler veya semboller kümesi.","vi":"Chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung âm nhạc của biểu hiện.","zh-Hans-CN":"用于表达一种内容表达的音乐内容的字符或符号的集合"},"label":{"ar":"شكل من أشكال التدوين الموسيقي","ca":"té com a forma de notació musical","cs":"má podobu hudebního zápisu","da":"har musikalsk notationsform","de":"hat Form einer Musiknotation","de":"hat Form einer Musiknotation","el":"έχει μορφή της μουσικής σημειογραφίας","en":"has form of musical notation","es":"tiene forma de notación musical","et":"muusikanotatsiooni vorm","fi":"nuottikirjoituksen tyyppi","fr":"a pour forme de notation musicale","hu":"zenei lejegyzés formája a következő:","lv":"notācijas forma","nl":"heeft vorm van muzieknotatie","no":"har musikknotasjonsform","sv":"har form av musiknotation","tr":"müzikal notasyon biçimi ile ilişkilidir","vi":"có hình thái của ký hiệu âm nhạc","zh-Hans-CN":"有乐谱的形式"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20062", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotation.en", "label":"has form of notation"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/formOfMusicalNotation.en","instructionNumber":"7.13.3","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20064", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/formOfMusicalNotation.en", "label":"has form of musical notation"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20064", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/formOfMusicalNotation.en", "label":"has form of musical notation"}]},{"@id":"http://rdaregistry.info/Elements/e/P20215","label":{"ar":"لها وسيط أداء لمحتوى موسيقي","ca":"té com a repartiment d’execució d’un contingut musical","cs":"má obsazení hudebního obsahu","da":"har besætning for musikalsk indhold","de":"hat Besetzung für musikalischen Inhalt","de":"hat Besetzung für musikalischen Inhalt","el":"έχει μέσο της εκτέλεσης του μουσικού περιεχομένου","en":"has medium of performance of musical content","es":"tiene medio de interpretación de contenido musical","et":"muusikalise sisu esituskoosseis","fi":"musiikin esityskokoonpano","fr":"a pour distribution d’exécution d’un contenu musical","hu":"zenei tartalom előadásmédiuma a következő:","lv":"mūzikas izpildījuma veids","nl":"heeft uitvoeringsmedium van muzikale content","no":"har besetning for musikalsk innhold","tr":"müzikal içeriğin performans ortamı ile ilişkilidir","vi":"có phương tiện biểu diễn của nội dung âm nhạc","zh-Hans-CN":"有音乐内容的表演媒介"},"definition":{"ar":["تربط بين تعبيرة وآلة، أو صوت، أو مجموعة وعدد من أجزاء، أو فنانين وعاملين مُستخدمين، أو يُعتزم استخدامهم لأداء المحتوى الموسيقي لتعبيرة."],"ca":["Relaciona una expressió amb un instrument, veu o conjunt i el nombre de parts, intèrprets i mans usat o concebut per ser usat, per a l’execució d’un contingut musical d’una expressió."],"cs":["Vztahuje vyjádření k nástroji, hlasu nebo souboru a k počtu hlasů, účinkujících a rukou, který se používá nebo je určen k provedení hudebního obsahu vyjádření."],"da":["Relaterer et udtryk til et instrument, en stemme eller ensemble, og antallet af dele, udøvere og hænder, som er anvendt, eller påtænkt anvendt, til at opføre et udtryks musikindhold."],"de":["Setzt eine Expression in Beziehung zu einem Instrument, einer Singstimme oder einem Ensemble und der Anzahl der Stimmen, der Ausführenden und Hände, das/die zur Darbietung eines musikalischen Inhalts einer Expression verwendet wird/werden oder verwendet werden soll/sollen.,Setzt eine Expression in Beziehung zu einem Instrument, einer Singstimme oder einem Ensemble und der Anzahl der Stimmen, der Ausführenden und Hände, das/die zur Darbietung eines musikalischen Inhalts einer Expression verwendet wird/werden oder verwendet werden soll/sollen."],"el":["Συνδέει μια έκφραση με ένα όργανο, μια φωνή ή ένα σύνολο που χρησιμοποιείται ή προορίζεται για την εκτέλεση μουσικού περιεχομένου."],"en":["Relates an expression to an instrument, voice, or ensemble and the number of parts, performers and hands used, or intended to be used, to perform the musical content of an expression."],"es":["Relaciona una expresión con un instrumento, voz o conjunto y el número de partes, intérpretes y manos utilizadas, o que se pretende utilizar, para interpretar el contenido musical de una expresión."],"et":["Seostab väljenduse väljenduse muusikalise sisu esitamiseks kasutatud või esitamiseks mõeldud muusikainstrumendi, lauluhääle või ansambliga ning partiide, esitajate ja käte arvuga."],"fi":["Liittää ekspression ekspression musiikillisen sisällön esittämiseen käytettyyn tai käytettäväksi tarkoitettuun soittimeen, lauluääneen tai esittäjäryhmään ja stemmojen, esittäjien ja käsien lukumäärään."],"fr":["Met une expression en relation avec un instrument, une voix ou un ensemble ainsi que le nombre de parties, d’interprètes ou de mains utilisés ou destinés à être utilisés dans une exécution du contenu musical d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy hangszerhez, hanghoz vagy együtteshez, illetve egy kifejezési forma zenei tartalmának előadásához használt, vagy használni kívánt szólamok, előadók és kezek számához ."],"lv":["Sasaista izteiksmi ar mūzikas instrumentu, balsi un/vai ansambli, ko lieto (vai ko paredzēts lietot) mūzikas atskaņošanai."],"nl":["Relateert een expressie aan een instrument, stem of ensemble en het aantal partijen, uitvoerders en handen gebruikt, of bedoeld gebruikt te worden, om de muzikale content van een expressie uit te voeren."],"no":["Relaterer et uttrykk til et instrument, en stemme eller et ensemble og antall stemmer, utøvere og hender som brukes eller er tenkt brukt for å framføre det musikalske innholdet av et uttrykk."],"tr":["Bir anlatımı, bir enstrüman, ses veya toplulukla ve bir anlatımın müzikal içeriğini gerçekleştirmek için kullanılan veya kullanılması amaçlanan parçaların, performansçıların ve ellerin sayısıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với nhạc cụ, giọng, và/hoặc đồng diễn được sử dụng, hoặc có ý định sử dụng, cho biểu diễn nội dung âm nhạc."],"zh-Hans-CN":["将一种内容表达与一种内容表达的音乐内容之表演所用或构想所用的乐器、人声或组合以及声部、表演者和手的数量关联起来。"]},"ToolkitLabel":{"ar":"وسيط أداء لمحتوى موسيقي","ca":"repartiment d’execució d’un contingut musical","cs":"obsazení hudebního obsahu","da":"besætning for musikalsk indhold","de":"Besetzung für musikalischen Inhalt","de":"Besetzung für musikalischen Inhalt","el":"μέσο της εκτέλεσης του μουσικού περιεχομένου","en":"medium of performance of musical content","es":"medio de interpretación de contenido musical","et":"muusikalise sisu esituskoosseis","fi":"musiikin esityskokoonpano","fr":"distribution d’exécution d’un contenu musical","hu":"zenei tartalom előadásmédiuma:","lv":"mūzikas izpildījuma veids","nl":"uitvoeringsmedium van muzikale content","no":"besetning for musikalsk innhold","tr":"müzikal içeriğin performans ortamı","vi":"phương tiện biểu diễn của nội dung âm nhạc","zh-Hans-CN":"音乐内容的表演媒介"},"ToolkitDefinition":{"ar":"آلة، أو صوت، أو مجموعة وعدد من أجزاء، أو فنانين وعاملين مُستخدمين، أو يُعتزم استخدامهم لأداء المحتوى الموسيقي لتعبيرة.","ca":"Instrument, veu o conjunt i el nombre de parts, intèrprets i mans usat o concebut per ser usat, per a l’execució d’un contingut musical d’una expressió.","cs":"Nástroj, hlas nebo soubor a počet hlasů, účinkujících a rukou, který se používá nebo je určen k provedení hudebního obsahu vyjádření.","da":"Instrument, stemme eller ensemble, og antallet af dele, udøvere og hænder, som er anvendt, eller påtænkt anvendt, til at opføre et udtryks musikindhold.","de":"Ein Instrument, eine Singstimme oder ein Ensemble und die Anzahl der Stimmen, der Ausführenden und Hände, das/die zur Darbietung eines musikalischen Inhalts einer Expression verwendet wird/werden oder verwendet werden soll/sollen.","de":"Ein Instrument, eine Singstimme oder ein Ensemble und die Anzahl der Stimmen, der Ausführenden und Hände, das/die zur Darbietung eines musikalischen Inhalts einer Expression verwendet wird/werden oder verwendet werden soll/sollen.","el":"Ένα όργανο, μια φωνή ή ένα σύνολο που χρησιμοποιείται ή προορίζεται για την εκτέλεση μουσικού περιεχομένου.","en":"An instrument, voice, or ensemble and the number of parts, performers and hands used, or intended to be used, to perform the musical content of an expression.","es":"Un instrumento, voz o conjunto y el número de partes, intérpretes y manos utilizadas, o que se pretende utilizar, para interpretar el contenido musical de una expresión.","et":"Väljenduse muusikalise sisu esitamiseks kasutatud või esitamiseks mõeldud muusikainstrument, lauluhääl või ansambel ning partiide, esitajate ja käte arv.","fi":"Ekspression musiikillisen sisällön esittämiseen käytetty tai käytettäväksi tarkoitettu soitin, lauluääni tai esittäjäryhmä ja stemmojen, esittäjien ja käsien lukumäärä.","fr":"Instrument, voix ou ensemble ainsi que le nombre de parties, d’interprètes ou de mains utilisés ou destinés à être utilisés dans une exécution du contenu musical d’une expression.","hu":"Egy hangszer, hang vagy együttes, illetve egy kifejezési forma zenei tartalmának előadásához használt, vagy használni kívánt szólamok, előadók és kezek száma.","lv":"Mūzikas instruments, balss un/vai ansamblis, ko lieto (vai ko paredzēts lietot) mūzikas atskaņošanai.","nl":"Een instrument, stem of ensemble en het aantal partijen, uitvoerders en handen gebruikt, of bedoeld gebruikt te worden, om de muzikale content van een expressie uit te voeren.","no":"Et instrument, en stemme eller et ensemble og antall stemmer, utøvere og hender som brukes eller er tenkt brukt for å framføre det musikalske innholdet av et uttrykk.","tr":"Bir anlatımın müzikal içeriğini gerçekleştirmek için kullanılan veya kullanılması amaçlanan bir enstrüman, ses veya topluluk ve gereken parça, icracıların ve ellerin sayısı.","vi":"Nhạc cụ, giọng, và/hoặc đồng diễn được sử dụng, hoặc có ý định sử dụng, cho biểu diễn nội dung âm nhạc.","zh-Hans-CN":"一种内容表达的音乐内容之表演所用或构想所用的乐器、人声或组合以及声部、表演者和手的数量"},"altLabel":{"ar":["وسيط أداء"],"ca":["repartiment d’execució"],"cs":["obsazení"],"de":["Besetzung,Besetzung"],"en":["medium of performance"],"es":["medio de interpretación"],"fi":["esityskokoonpano"],"fr":["distribution d’exécution"],"hu":["előadásmédiuma:"],"nl":["uitvoeringsmedium"],"tr":["performans ortamı"],"zh-Hans-CN":["表演媒介"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/mediumOfPerformanceOfMusicalContent.en","instructionNumber":"7.21","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20215", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/mediumOfPerformanceOfMusicalContent.en", "label":"has medium of performance of musical content"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20215", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/mediumOfPerformanceOfMusicalContent.en", "label":"has medium of performance of musical content"}]},{"@id":"http://rdaregistry.info/Elements/e/P20244","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مثل فيلم سينمائي، أو مسرحية، أو برنامج تليفزيوني، إلخ. يستخدم عملا موسيقيا."],"ca":["Relaciona una expressió amb una expressió d’una obra com ara una pel·lícula cinematogràfica, una obra de teatre, un programa de televisió, etc., que usa una obra musical."],"cs":["Vztahuje vyjádření k vyjádření díla jako je film, divadelní hra, televizní program atd. a které využívá hudební dílo."],"da":["Relaterer et udtryk til et udtryk af et værk, såsom en spillefilm, skuespil, tv-program etc., som anvender et musikværk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, zum Beispiel einem Film, einem Theaterstück, einer Fernsehsendung und so weiter, die ein Musikwerk verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, zum Beispiel einem Film, einem Theaterstück, einer Fernsehsendung und so weiter, die ein Musikwerk verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου όπως μια κινηματογραφική ταινία, ένα θεατρικό έργο, ένα τηλεοπτικό πρόγραμμα κ.λπ. το οποίο χρησιμοποιεί ένα μουσικό έργο."],"en":["Relates an expression to an expression of a work such as a motion picture, play, television program, etc., that uses a musical work."],"es":["Relaciona una expresión con una expresión de una obra tal como una película, obra de teatro, programa de televisión, etc., que utiliza una obra musical."],"et":["Seostab väljenduse teose, nt filmi, näidendi, telesaate vms väljendusega, milles kasutatakse muusikateost."],"fi":["Liittää ekspression teoksen ekspressioon kuten elokuvaan, näytelmään, televisio-ohjelmaan tms., joka käyttää musiikkiteosta."],"fr":["Met une expression en relation avec une expression d’une œuvre telle qu’un film, une pièce de théâtre, une émission de télévision, etc. qui utilise une œuvre musicale."],"hu":["Hozzákapcsol egy kifejezési formát egy mű, mint például egy film, színdarab, tévéműsor stb. kifejezési formájához, amely egy zeneművet használ."],"lv":["Sasaista izteiksmi ar darba izteiksmi, piemēram, kinofilma, luga, televīzijas raidījums, u.tml., kurā izmantots mūzikas darbs."],"nl":["Relateert een expressie aan een expressie van een werk zoals een film, toneelstuk, televisieprogramma etc. dat een muziekwerk gebruikt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som en spillefilm, et fjernsynsprogram etc. som bruker et musikalsk verk."],"tr":["Bir anlatımı, bir müzik eserini kullanan sinema filmi, tiyatro oyunu, televizyon programı vb. gibi bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm như là phim điện ảnh, kịch, chương trình truyền hình, v.v... sử dụng tác phẩm âm nhạc."],"zh-Hans-CN":["将一种内容表达与使用一种音乐作品的诸如电影、戏剧、电视节目等一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"موسيقي لتعبيرة","ca":"música per a una expressió","cs":"hudba k vyjádření","da":"musik til udtryk","de":"Musik für (Expression)","de":"Musik für (Expression)","el":"μουσική για (έκφραση)","en":"music for expression","es":"música para la expresión","et":"muusika väljendusele","fi":"musiikki ekspressioon","fr":"musique pour une expression","hu":"zene kifejezési formához:","lv":"mūzika izteiksmei","nl":"muziek voor expressie","no":"musikk for uttrykk","tr":"İfade için müzik","vi":"âm nhạc của (biểu hiện)","zh-Hans-CN":"用于内容表达的音乐"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مثل فيلم سينمائي، أو مسرحية، أو برنامج تليفزيوني، إلخ. يستخدم عملا موسيقيا.","ca":"Expressió d’una obra com ara una pel·lícula cinematogràfica, una obra de teatre, un programa de televisió, etc., que usa una obra musical.","cs":"Vyjádření díla jako je film, divadelní hra, televizní program atd. a které využívá hudební dílo.","da":"Udtryk af et værk, såsom en spillefilm, skuespil, tv-program etc., som anvender et musikværk.","de":"Eine Expression eines Werks, zum Beispiel einem Film, einem Theaterstück, einer Fernsehsendung und so weiter, die ein Musikwerk verwendet.","de":"Eine Expression eines Werks, zum Beispiel einem Film, einem Theaterstück, einer Fernsehsendung und so weiter, die ein Musikwerk verwendet.","el":"Μια έκφραση ενός έργου, όπως μια κινηματογραφική ταινία, ένα θεατρικό έργο, ένα τηλεοπτικό πρόγραμμα κ.λπ. το οποίο χρησιμοποιεί ένα μουσικό έργο.","en":"An expression of a work such as a motion picture, play, television program, etc., that uses a musical work.","es":"Una expresión de una obra tal como una película, obra de teatro, programa de televisión, etc., que utiliza una obra musical.","et":"Teose, nt filmi, näidendi, telesaate vms väljendus, milles kasutatakse muusikateost.","fi":"Teoksen ekspressio kuten elokuva, näytelmä, televisio-ohjelma tms., joka käyttää musiikkiteosta.","fr":"Expression d’une œuvre telle qu’un film, une pièce de théâtre, une émission de télévision, etc. qui utilise une œuvre musicale.","hu":"Egy mű, mint például egy film, színdarab, tévéműsor stb. kifejezési formája, amely egy zeneművet használ.","lv":"Darba izteiksme, piemēram, kinofilma, luga, televīzijas raidījums, u.tml., kurā izmantots mūzikas darbs.","nl":"Een expressie van een werk zoals een film, toneelstuk, televisieprogramma etc. dat een muziekwerk gebruikt.","no":"Et uttrykk av et verk som en spillefilm, et fjernsynsprogram etc. som bruker et musikalsk verk.","tr":"Bir müzik çalışmasının kullanıldığı sinema filmi, oyun, televizyon programı vb. bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm như là phim điện ảnh, kịch, chương trình truyền hình, v.v... sử dụng tác phẩm âm nhạc.","zh-Hans-CN":"使用一种音乐作品的诸如电影、戏剧、电视节目等一种作品的一种内容表达"},"label":{"ar":"هي موسيقي لتعبيرة","ca":"és música per a una expressió","cs":"je hudbou k vyjádření","da":"er musik til udtryk","de":"ist Musik für (Expression)","de":"ist Musik für (Expression)","el":"είναι μουσική για (έκφραση)","en":"is music for expression","es":"es música para la expresión","et":"muusika väljendusele","fi":"musiikki ekspressioon","fr":"est une musique pour une expression","hu":"zene a következő kifejezési formához:","lv":"ir mūzika izteiksmei","nl":"is muziek voor expressie","no":"er musikk for uttrykk","tr":"anlatım müziğidir","vi":"là âm nhạc của (biểu hiện)","zh-Hans-CN":"是用于内容表达的音乐"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicForExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20103", "lexicalAlias":"http://rdaregistry.info/Elements/e/incidentalMusicForExpression.en", "label":"is incidental music for expression"},{"@id":"http://rdaregistry.info/Elements/e/P20252", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForMotionPictureExpression.en", "label":"is music for motion picture expression"},{"@id":"http://rdaregistry.info/Elements/e/P20250", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForRadioProgramExpression.en", "label":"is music for radio program expression"},{"@id":"http://rdaregistry.info/Elements/e/P20248", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForTelevisionProgramExpression.en", "label":"is music for television program expression"},{"@id":"http://rdaregistry.info/Elements/e/P20246", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForVideoExpression.en", "label":"is music for video expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicForExpression.en", "label":"is music for expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicForExpression.en", "label":"is music for expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20250","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم عملا موسيقيا في برنامج إذاعي."],"ca":["Relaciona una expressió amb una expressió d’una obra que usa una obra musical en un programa radiofònic."],"cs":["Vztahuje vyjádření k vyjádření díla, využívá hudební dílo v rozhlasovém programu."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvender et musikværk i et radioprogram."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die ein Musikwerk in einer Hörfunksendung verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die ein Musikwerk in einer Hörfunksendung verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο χρησιμοποιεί ένα μουσικό έργο σε ένα ραδιοφωνικό πρόγραμμα."],"en":["Relates an expression to an expression of a work that uses a musical work in a radio program."],"es":["Relaciona una expresión con una expresión de una obra que utiliza una obra musical en un programa de radio."],"et":["Seostab väljenduse raadiosaate väljendusega, milles kasutatakse muusikateost."],"fi":["Liittää ekspression teoksen ekspressioon, joka käyttää musiikkiteosta radio-ohjelmassa."],"fr":["Met une expression en relation avec une expression d’une œuvre qui utilise une œuvre musicale dans une émission de radio."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy zeneművet használ egy rádióműsorban."],"lv":["Sasaista izteiksmi ar darba izteiksmi - radio raidījums, kurā izmantots mūzikas darbs."],"nl":["Relateert een expressie aan een expressie van een werk dat een muziekwerk in een radioprogramma gebruikt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som bruker et musikalsk verk i et radioprogram."],"tr":["Bir anlatımı, bir radyo programında bir müzik eserini kullanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sử dụng tác phẩm âm nhạc trong chương trình truyền thanh."],"zh-Hans-CN":["将一种内容表达与使用一个广播节目中一种音乐作品的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"موسيقى لتعبيرة برنامج إذاعي","ca":"música per a una expressió de programa radiofònic","cs":"hudba pro rozhlasový program (vyjádření)","da":"musik til radioprogramudtryk","de":"Musik für Hörfunksendung (Expression)","de":"Musik für Hörfunksendung (Expression)","el":"μουσική για ραδιοφωνικό πρόγραμμα (έκφραση)","en":"music for radio program expression","es":"música para la expresión de programas de radio","et":"muusika raadiosaatele (väljendus)","fi":"musiikki radio-ohjelmaan (ekspressio)","fr":"musique pour une émission de radio (expression)","hu":"zene a következő rádióműsor kifejezési formájához:","lv":"mūzika radio raidījuma izteiksmei","nl":"muziek voor radioprogramma-expressie","no":"musikk for radioprogram (uttrykk)","tr":"radyo programı ifadesi için müzik","vi":"âm nhạc của chương trình truyền thanh (biểu hiện)","zh-Hans-CN":"用于广播节目内容表达的音乐"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم عملا موسيقيا في برنامج إذاعي.","ca":"Expressió d’una obra que usa una obra musical en un programa radiofònic.","cs":"Vyjádření díla, využívá hudební dílo v rozhlasovém programu.","da":"Udtryk af et værk, som anvender et musikværk i et radioprogram.","de":"Eine Expression eines Werks, die ein Musikwerk in einer Hörfunksendung verwendet.","de":"Eine Expression eines Werks, die ein Musikwerk in einer Hörfunksendung verwendet.","el":"Μια έκφραση ενός έργου το οποίο χρησιμοποιεί ένα μουσικό έργο σε ένα ραδιοφωνικό πρόγραμμα.","en":"An expression of a work that uses a musical work in a radio program.","es":"Una expresión de una obra que utiliza una obra musical en un programa de radio.","et":"Raadiosaate väljendus, milles kasutatakse muusikateost.","fi":"Teoksen ekspressio, joka käyttää musiikkiteosta radio-ohjelmassa.","fr":"Expression d’une œuvre qui utilise une œuvre musicale dans une émission de radio.","hu":"Egy mű kifejezési formája, amely egy zeneművet használ egy rádióműsorban.","lv":"Darba izteiksme - radio raidījums, kurā izmantots mūzikas darbs.","nl":"Een expressie van een werk dat een muziekwerk in een radioprogramma gebruikt.","no":"Et uttrykk av et verk som bruker et musikalsk verk i et radioprogram.","tr":"Bir radyo programında müzik eseri kullanan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sử dụng tác phẩm âm nhạc trong chương trình truyền thanh.","zh-Hans-CN":"使用一个广播节目中一种音乐作品的一种作品的一种内容表达"},"label":{"ar":"هي موسيقى لتعبيرة برنامج إذاعي","ca":"és música per a una expressió de programa radiofònic","cs":"je hudbou pro rozhlasový program (vyjádření)","da":"er musik til radioprogramudtryk","de":"ist Musik für Hörfunksendung (Expression)","de":"ist Musik für Hörfunksendung (Expression)","el":"είναι μουσική για ραδιοφωνικό πρόγραμμα (έκφραση)","en":"is music for radio program expression","es":"es música para expresión de programas de radio","et":"muusika raadiosaatele (väljendus)","fi":"musiikki radio-ohjelmaan (ekspressio)","fr":"est une musique pour une émission de radio (expression)","hu":"zene a következő rádióműsor kifejezési formájához:","lv":"ir mūzika radio raidījuma izteiksmei","nl":"is muziek voor radioprogramma-expressie","no":"er musikk for radioprogram (uttrykk)","tr":"radyo programı anlatımı müziğidir","vi":"là âm nhạc của chương trình truyền thanh (biểu hiện)","zh-Hans-CN":"是用于广播节目内容表达的音乐"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForExpression.en", "label":"is music for expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicForRadioProgramExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20250", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicForRadioProgramExpression.en", "label":"is music for radio program expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20250", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicForRadioProgramExpression.en", "label":"is music for radio program expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20026","definition":{"ca":["Relaciona una expressió amb un agent que contribueix a una expressió afegint música a una obra que originalment no en tenia, composant música nova per substituir la música original, o composant música nova per complementar la música existent."],"da":["Relaterer et udtryk til en agent, der har bidraget til et udtryk ved at tilføje musik til et værk, der oprindeligt manglede det, ved at komponere ny musik som erstatning for den oprindelige musik, eller ved at komponere ny musik som supplement til eksisterende musik."],"de":["Setzt eine Expression mit einem Akteur, der zu einer Expression eines Werks beiträgt, indem er Musik zu einem Werk hinzufügt, das im Original keine hatte, neue Musik als Ersatz für die Originalmusik komponiert oder neue Musik komponiert, die die existierende Musik ergänzt, in Beziehung."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση μέσω της προσθήκης μουσικής σε ένα έργο που αρχικά δεν διέθετε [μουσική], μέσω της σύνθεσης νέας μουσικής προς αντικατάσταση της πρωτότυπης μουσικής ή μέσω της σύνθεσης νέας μουσικής ως συμπλήρωμα της ήδη υπάρχουσας μουσικής."],"en":["Relates an expression to an agent who contributes to an expression by adding music to a work that originally lacked it, by composing new music to substitute for original music, or by composing new music to supplement existing music. (Deprecated)"],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen lisäämällä musiikkia teokseen, johon ei aikaisemmin sisältynyt musiikkia tai säveltämällä uutta musiikkia korvaamaan teoksen aikaisemman musiikin tai täydentämään olemassa olevaa musiikkia."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en ajoutant de la musique à une œuvre qui n’en avait pas à l’origine, en composant une nouvelle musique pour remplacer une musique originale ou en composant une nouvelle musique pour compléter une musique existante."],"hu":["Egy kifejezési formát hozzákapcsol egy ágenshez (személyhez, családhoz vagy testülethez), aki/amely egy kifejezési formához hozzájárul azzal, hogy zenét ad hozzá egy műhöz, amelyből az eredetileg hiányzott, új zenét komponált, hogy az eredeti zenét felváltsa, vagy új zenét komponált, hogy a meglévő zenét kiegészítse."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện bằng cách thêm âm nhạc vào tác phẩm mà nguyên gốc chưa có, bằng cách soạn nhạc mới thay cho nhạc nguyên gốc, hoặc bằng cách sáng tác nhạc mới để bổ sung cho nhạc đã có."]},"ToolkitLabel":{"ca":"compositor (expressió)","da":"komponist (udtryk)","de":"Komponist (Expression)","el":"συνθέτης (έκφραση)","en":"composer of expression (Deprecated)","es":"compositor (expresión)","fi":"säveltäjä (ekspressio)","fr":"compositeur (expression)","hu":"zeneszerző (kifejezési forma)","no":"komponist (uttrykk)","vi":"người soạn nhạc(biểu hiện)"},"ToolkitDefinition":{"ca":"Agent que contribueix a una expressió afegint música a una obra que originalment no en tenia, composant música nova per substituir la música original, o composant música nova per complementar la música existent.","da":"Agent, der har bidraget til et udtryk ved at tilføje musik til et værk, der oprindeligt manglede det, ved at komponere ny musik som erstatning for den oprindelige musik, eller ved at komponere ny musik som supplement til eksisterende musik.","de":"Ein Akteur, der zu einer Expression eines Werks beiträgt, indem er Musik zu einem Werk hinzufügt, das im Original keine hatte, neue Musik als Ersatz für die Originalmusik komponiert oder neue Musik komponiert, die die existierende Musik ergänzt.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση μέσω της προσθήκης μουσικής σε ένα έργο που αρχικά δεν διέθετε [μουσική] μέσω της σύνθεσης νέας μουσικής προς αντικατάσταση της πρωτότυπης μουσικής ή μέσω της σύνθεσης νέας μουσικής ως συμπλήρωμα της ήδη υπάρχουσας μουσικής.","en":"An agent who contributes to an expression by adding music to a work that originally lacked it, by composing new music to substitute for original music, or by composing new music to supplement existing music. (Deprecated)","es":"Una persona, familia o entidad corporativa que contribuye a una expresión agregando música a una obra que originalmente no tenía, componiendo música nueva para sustituir la música original, o componiendo nueva música para complementar la música existente.","fi":"Toimija, joka osallistuu ekspression tekemiseen lisäämällä musiikkia teokseen, johon ei aikaisemmin sisältynyt musiikkia tai säveltämällä uutta musiikkia korvaamaan teoksen aikaisemman musiikin tai täydentämään olemassa olevaa musiikkia.","fr":"Agent qui contribue à une expression en ajoutant de la musique à une œuvre qui n’en avait pas à l’origine, en composant une nouvelle musique pour remplacer une musique originale ou en composant une nouvelle musique pour compléter une musique existante.","hu":"Egy ágens (személy, család vagy testület), aki/amely egy kifejezési formához hozzájárul azzal, hogy zenét ad hozzá a műhöz, amelynek eredetileg nem volt, új zenét komponál az eredeti zene helyettesítésére, vagy új zenét komponál a meglévő zene kiegészítésére.","no":"En agent som bidrar til et uttrykk ved å sette musikk til et verk som opprinnelig var uten musikk, ved å komponere musikk som erstatning for originalmusikken, eller ved å komponere ny musikk i tillegg til den eksisterende musikken.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách thêm âm nhạc vào tác phẩm mà nguyên gốc chưa có, bằng cách soạn nhạc mới thay cho nhạc nguyên gốc, hoặc bằng cách sáng tác nhạc mới để bổ sung cho nhạc đã có."},"label":{"ca":"té com a compositor (expressió)","da":"har komponist (udtryk)","de":"hat Komponist (Expression)","el":"έχει συνθέτη (έκφραση)","en":"has composer of expression (Deprecated)","fi":"säveltäjä (ekspressio)","fr":"a pour compositeur (expression)","hu":"van zeneszerzője (kifejezési forma)","vi":"cóngười soạn nhạc(biểu hiện)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/composerOfExpression.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20578", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorToAggregatedContent.en", "label":"has contributor to aggregated content (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20026", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/composerOfExpression.en", "label":"has composer of expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20026", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/composerOfExpression.en", "label":"has composer of expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20241","label":{"ar":"هي معالجة كتعبيرة مسرح موسيقي","ca":"és adaptat com a expressió de teatre musical","cs":"je adaptováno jako muzikál (vyjádření)","da":"er bearbejdet som musikteaterudtryk","de":"ist bearbeitet als Musiktheaterstück (Expression)","de":"ist bearbeitet als Musiktheaterstück (Expression)","el":"είναι προσαρμοσμένη ως μουσικό θέατρο (έκφραση)","en":"is adapted as musical theatre expression","es":"se adapta como expresión de teatro musical","et":"adapteeritud muusikalina (väljendus)","fi":"musikaalisovitus (ekspressio)","fr":"est adapté au théâtre musical (expression)","hu":"kifejezési forma zenés színházi darabbá való átalakítása:","lv":"ir adaptēts kā muzikāls iestudējums (izteiksme)","nl":"is bewerkt als muziektheater-expressie","no":"er bearbeidet som musikal (uttrykk)","tr":"müzikal tiyatro anlatımı olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản âm nhạc (biểu hiện)","zh-Hans-CN":"被改编为音乐戏剧内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مسرحي موسيقي مبني على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra de teatre musical que es basa en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření muzikálového díla, které je založené na vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et musikteaterværk, baseret på et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Musiktheaterstücks (Werk), die auf einer Expression eines anderen Werks basiert.,Setzt eine Expression in Beziehung zu einer Expression eines Musiktheaterstücks (Werk), die auf einer Expression eines anderen Werks basiert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μουσικο-θεατρικού έργου βασισμένου σε μια έκφραση-πηγή."],"en":["Relates an expression to an expression of a musical theatre work that is based on an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra de teatro musical que se basa en una expresión de otra obra."],"et":["Seostab väljenduse allikväljendusel põhineva muusikaliväljendusega."],"fi":["Liittää ekspression musikaaliteoksen ekspressioon, joka perustuu toisen teoksen ekspressioon."],"fr":["Met une expression en relation avec une expression d’une œuvre de théâtre musical qui est basée sur une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy zeneszínházi mű kifejezési formájához, amely egy másik mű kifejezési formáján alapul."],"lv":["Sasaista izteiksmi ar muzikāla iestudējuma izteiksmi, veidota pēc darba pamatizteiksmes."],"nl":["Relateert een expressie aan een expressie van een muziektheaterwerk dat is gebaseerd op een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et musikalverk basert på et kildeuttrykk."],"tr":["Bir anlatımı, başka bir eserin anlatımına dayanan bir müzikal tiyatro eserinin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm nhà hát âm nhạc dụa trên biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与基于另一种作品的一种内容表达的一种音乐戏剧作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة كتعبيرة مسرح موسيقي","ca":"adaptat com a expressió de teatre musical","cs":"adaptováno jako muzikál (vyjádření)","da":"bearbejdet som musikteaterudtryk","de":"Bearbeitet als Musiktheaterstück (Expression)","de":"Bearbeitet als Musiktheaterstück (Expression)","el":"προσαρμοσμένη ως μουσικό θέατρο (έκφραση)","en":"adapted as musical theatre expression","es":"adaptado como expresión de teatro musical","et":"adapteeritud muusikalina (väljendus)","fi":"musikaalisovitus (ekspressio)","fr":"adapté au théâtre musical (expression)","hu":"feldolgozva a következő zenés színházi darabbá:","lv":"adaptēts kā izteiksme: muzikāls iestudējums","nl":"bewerkt als muziektheater-expressie","no":"bearbeidet som musikal (uttrykk)","tr":"müzik sahnesi anlatımı olarak uyarlanan","vi":"được phỏng theo như là kịch bản âm nhạc (biểu hiện)","zh-Hans-CN":"被改编为音乐戏剧内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مسرح موسيقي مبني على تعبيرة لعمل آخر.","ca":"Expressió d’una obra de teatre musical que es basa en una expressió d’una altra obra.","cs":"Vyjádření muzikálového díla, které je založené na vyjádření jiného díla.","da":"Udtryk af et musikteaterværk, baseret på et udtryk af et andet værk.","de":"Eine Expression eines Musiktheaterstücks (Werk), die auf einer Expression eines anderen Werks basiert.","de":"Eine Expression eines Musiktheaterstücks (Werk), die auf einer Expression eines anderen Werks basiert.","el":"Μια έκφραση ενός μουσικο-θεατρικού έργου βασισμένου σε μια έκφραση-πηγή.","en":"An expression of a musical theatre work that is based on an expression of another work.","es":"Una expresión de una obra de teatro musical que se basa en una expresión de otra obra.","et":"Allikväljendusel põhinev muusikaliväljendus.","fi":"Musikaaliteoksen ekspressio, joka perustuu toisen teoksen ekspressioon.","fr":"Expression d’une œuvre de théâtre musical qui est basée sur une expression d’une autre œuvre