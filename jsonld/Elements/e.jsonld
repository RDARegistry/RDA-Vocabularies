                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20305", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedCollectiveAgentOfExpression.en", "label":"has related collective agent of expression"},{"@id":"http://rdaregistry.info/Elements/x/P00009", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedCorporateBodyOfRDAEntity.en", "label":"has related corporate body of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/relatedCorporateBodyOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20507", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCorporateBodyOfExpression.en", "label":"has creator corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20304", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/relatedCorporateBodyOfExpression.en", "label":"has related corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20304", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/relatedCorporateBodyOfExpression.en", "label":"has related corporate body of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20264","definition":{"ar":["تربط بين تعبيرة وتفاصيل تخطيط موسيقي أو مادي لمحتوى تعبيرة يُعرض في شكل من أشكال التدوين الموسيقي."],"ca":["Relaciona una expressió amb les particularitats de la disposició musical o física del contingut d’una expressió que es presenta en la forma de notació musical."],"cs":["Vztahuje vyjádření k podrobnostem o hudebním nebo fyzickém uspořádání obsahu vyjádření, které je prezentováno ve formě hudebního zápisu."],"da":["Relaterer et udtryk til detaljer om et musikalsk eller fysisk layout af et udtryks indhold, som er repræsenteret som musikalsk notation."],"de":["Setzt eine Expression in Beziehung zu Details zu dem musikalischen oder physischen Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird.,Setzt eine Expression in Beziehung zu Details zu dem musikalischen oder physischen Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird."],"el":["Συνδέει μια έκφραση με τις λεπτομέρειες της μουσικής ή της φυσικής διάταξης του περιεχομένου μιας έκφρασης, η οποία παρουσιάζεται με τη μορφή της μουσικής σημειογραφίας."],"en":["Relates an expression to details of a musical or physical layout of the content of an expression that is presented in the form of musical notation. (Deprecated)"],"es":["Relaciona una expresión con detalles de una disposición musical o física del contenido de una expresión que se presenta en forma de notación musical."],"et":["Seostab väljenduse täpsemate andmetega muusikanotatsiooni vormis esitatud väljenduse sisu muusikalise või füüsilise vormistusviisi kohta."],"fi":["Liittää ekspression tarkempiin tietoihin nuottikirjoituksen muodossa esitetyn ekspression sisällön musiikillisesta tai fyysisestä taitosta."],"fr":["Met une expression en relation avec des particularités d’une disposition musicale ou matérielle du contenu d’une expression qui se présente sous forme de notation musicale."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma tartalmának zenei lejegyzés formájában megjelenő zenei vagy fizikai elrendezésének részleteihez."],"lv":["Sasaista izteiksmi ar sīkāku informāciju par muzikāla vai fiziska satura izteiksmes izkārtojumu, kas atspoguļots nošu rakstā."],"nl":["Relateert een expressie aan details van een muzikale of fysieke lay-out van de content van een expressie die is aangeboden in de vorm van muzieknotatie."],"no":["Relaterer et uttrykk til detaljer vedrørende det musikalske eller fysiske oppsettet for innholdet av et uttrykk som presenteres i form av musikknotasjon."],"tr":["Bir anlatımı, müzik notasyonu biçiminde sunulan bir anlatımın içeriğinin müzikal veya fiziksel düzeninin ayrıntılarıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tiết của sắp đặt âm nhạc hoặc vật lý của nội dung của biểu hiện được trình bày dưới hình thái ký hiệu âm nhạc."],"zh-Hans-CN":["将一种内容表达与以乐谱形式呈现的一种内容表达之内容的音乐或物理布局的细节关联起来。"]},"ToolkitLabel":{"ar":"تفاصيل صيغة من موسيقى مدونة","ca":"particularitats de format de música notada","cs":"podrobnosti o formátu záznamu pohybu","da":"detaljer om format for noteret musik","de":"Details zur musikalischen Ausgabeform","de":"eine bestimmte musikalische Ausgabeform","el":"λεπτομέρειες του μορφότυπου της μουσικής σημειογραφίας","en":"details of format of notated music (Deprecated)","es":"detalles del formato de la música notada","et":"noodi tüübi täpsustus","fi":"nuottiaineiston muodon tarkemmat tiedot","fr":"particularités d’une présentation de la musique notée","hu":"zenei lejegyzés formátumának részletei:","lv":"detalizēti par notācijas formātu","nl":"details van formaat van bladmuziek","no":"detaljer vedrørende format for notert musikk","sv":"detaljerad information om format för noterad musik","tr":"notalı müzik biçiminin ayrıntıları","vi":"chi tiết của định dạng âm nhạc ký hiệu","zh-Hans-CN":"乐谱格式的细节"},"ToolkitDefinition":{"ar":"تفاصيل لتخطيط موسيقي أو مادي لمحتوى تعبيرة يُعرض في شكل من أشكال التدوين الموسيقي.","ca":"Particularitats de la disposició musical o física del contingut d’una expressió que es presenta en la forma de notació musical.","cs":"Podrobnosti o hudebním nebo fyzickém uspořádání obsahu vyjádření, které je prezentováno ve formě hudebního zápisu.","da":"Detaljer om et musikalsk eller fysisk layout af et udtryks indhold, som er repræsenteret som musikalsk notation.","de":"Details zu dem musikalischen oder physischen Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird.","de":"Details zu dem musikalischen oder physischen Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird.","el":"Οι λεπτομέρειες της μουσικής ή της φυσικής διάταξης του περιεχομένου μιας έκφρασης η οποία παρουσιάζεται με τη μορφή της μουσικής σημειογραφίας.","en":"Details of a musical or physical layout of the content of an expression that is presented in the form of musical notation. (Deprecated)","es":"Detalles de una disposición musical o física del contenido de una expresión que se presenta en forma de notación musical.","et":"Täpsemad andmed muusikanotatsiooni vormis esitatud väljenduse sisu muusikalise või füüsilise vormistusviisi kohta.","fi":"Tarkemmat tiedot nuottikirjoituksen muodossa esitetyn ekspression sisällön musiikillisesta tai fyysisestä taitosta.","fr":"Particularités d’une disposition musicale ou matérielle du contenu d’une expression qui se présente sous forme de notation musicale.","hu":"Egy kifejezési forma tartalmának zenei lejegyzés formájában megjelenő zenei vagy fizikai elrendezésének részletei.","lv":"Sīkāka informācija par muzikāla vai fiziska satura izteiksmes izkārtojumu, kas atspoguļots nošu rakstā.","nl":"Details van een muzikale of fysieke lay-out van de content van een expressie die is aangeboden in de vorm van muzieknotatie.","no":"Detaljer vedrørende det musikalske eller fysiske oppsettet for innholdet av et uttrykk som presenteres i form av musikknotasjon.","tr":"Müzikal nota şeklinde sunulan bir ifadenin içeriğinin müzikal veya fiziksel düzeninin ayrıntıları.","vi":"Chi tiết của sắp đặt âm nhạc hoặc vật lý của nội dung của biểu hiện được trình bày dưới hình thái ký hiệu âm nhạc.","zh-Hans-CN":"以乐谱形式呈现的一种内容表达之内容的音乐或物理布局的细节"},"label":{"ar":"لها تفاصيل صيغة من موسيقى مدونة","ca":"té com a particularitats de format de música notada","cs":"má podrobnosti o formátu notového zápisu","da":"har detaljer om format for noteret musik","de":"hat Details zur musikalischen Ausgabeform","de":"hat Details zur musikalischen Ausgabeform","el":"έχει λεπτομέρειες του μορφότυπου της μουσικής σημειογραφίας","en":"has details of format of notated music (Deprecated)","es":"tiene detalles del formato de la música notada","et":"noodi tüübi täpsustus","fi":"nuottiaineiston muodon tarkemmat tiedot","fr":"a pour particularités d’une présentation de la musique notée","hu":"zenei lejegyzés formátumának részletei a következők:","lv":"detalizēti par notācijas formātu","nl":"heeft details van formaat van bladmuziek","no":"har detaljer vedrørende format for notert musikk","sv":"har detaljerad information om format för noterad musik","tr":"notaya alınmış müzik formatının ayrıntıları ile ilişkilidir","vi":"có chi tiết của định dạng âm nhạc ký hiệu","zh-Hans-CN":"有乐谱格式的细节"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfFormatOfNotatedMusic.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.20.1.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20264", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfFormatOfNotatedMusic.en", "label":"has details of format of notated music (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20263","definition":{"ar":["تربط بين تعبيرة وتفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى حركة لتعبيرة."],"ca":["Relaciona una expressió amb les particularitats del conjunt de caràcters o de símbols usat per expressar el contingut de moviment d’una expressió."],"cs":["Vztahuje vyjádření k podrobnostem o souboru znaků nebo symbolů použitých k vyjádření pohybového obsahu vyjádření."],"da":["Relaterer et udtryk til detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks bevægelsesindhold."],"de":["Setzt eine Expression in Beziehung zu Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με τις λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο της κίνησης μιας έκφρασης."],"en":["Relates an expression to details of a set of characters or symbols used to express movement content of an expression. (Deprecated)"],"es":["Relaciona una expresión con detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido de movimiento de una expresión."],"et":["Seostab väljenduse täpsemate andmetega märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse liikumissisu väljendamiseks."],"fi":["Liittää ekspression tarkempiin tietoihin merkeistä ja symboleista, joilla ekspression liikesisältö on ilmaistu."],"fr":["Met une expression en relation avec des particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer un contenu de mouvement d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma mozgástartalmát kifejező karakterek vagy szimbólumok egy csoportjának részleteihez."],"lv":["Sasaista izteiksmi ar sīkāku informāciju par zīmju vai simbolu kopumu, kas ticis lietots, lai atklātu kustības izteiksmes saturu."],"nl":["Relateert een expressie aan details van een verzameling van tekens of symbolen gebruikt om bewegingscontent van een expressie uit te drukken."],"no":["Relaterer et uttrykk til detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke bevegelsesinnholdet i et uttrykk."],"tr":["Bir anlatımı, bir anlatımın hareket içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntılarıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung động thái của biểu hiện"],"zh-Hans-CN":["将一种内容表达与用于表示一种内容表达之动作内容的字符或符号的集合的细节关联起来。"]},"ToolkitLabel":{"ar":"تفاصيل شكل من أشكال الحركات المدونة","ca":"particularitats de forma de notació de moviment","cs":"podrobnosti o formě záznamu pohybu","da":"detaljer om bevægelsesnotationsform","de":"Details zur Form der Bewegungsnotation","de":"Details zur Form der Bewegungsnotation","el":"λεπτομέρειες της μορφής της σημειογραφίας κίνησης","en":"details of form of notated movement (Deprecated)","es":"detalles de la forma del movimiento anotado","et":"liikumisnotatsiooni vormi täpsustus","fi":"liikenotaation tyypin tarkemmat tiedot","fr":"particularités d’une forme de notation du mouvement","hu":"mozgásírásforma részletei:","lv":"detalizēti par kustības pieraksta veidu","nl":"details van vorm van bewegingsnotatie","no":"detaljer vedrørende form for bevegelsesnotasjon","sv":"detaljerad information om form av noterad rörelse","tr":"notasyonlu hareket biçiminin ayrıntıları","vi":"chi tiết của hình thái động thái ký hiệu","zh-Hans-CN":"动作谱形式的细节"},"ToolkitDefinition":{"ar":"تفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى حركة لتعبيرة.","ca":"Particularitats d’un conjunt de caràcters o de símbols usat per expressar el contingut de moviment d’una expressió.","cs":"Podrobnosti o souboru znaků nebo symbolů použitých k vyjádření pohybového obsahu vyjádření.","da":"Detaljer om et sæt af tegn eller de symboler, som anvendes til at udtrykke et udtryks bevægelsesindhold.","de":"Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken.","de":"Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken.","el":"Οι λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο της κίνησης μιας έκφρασης.","en":"Details of a set of characters or symbols used to express movement content of an expression. (Deprecated)","es":"Detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido de movimiento de una expresión.","et":"Täpsemad andmed märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse liikumissisu väljendamiseks.","fi":"Tarkemmat tiedot merkeistä ja symboleista, joilla ekspression liikesisältö on ilmaistu.","fr":"Particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer un contenu de mouvement d’une expression.","hu":"Egy kifejezési forma mozgástartalmát kifejező karakterek vagy szimbólumok egy csoportjának részletei.","lv":"Sīkāka informācija par zīmju vai simbolu kopumu, kas ticis lietots, lai atklātu kustības izteiksmes saturu.","nl":"Details van een verzameling van tekens of symbolen gebruikt om bewegingscontent van een expressie uit te drukken.","no":"Detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke bevegelsesinnholdet i et uttrykk.","tr":"Bir anlatımın hareket içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntıları.","vi":"Chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung động thái của biểu hiện","zh-Hans-CN":"用于表示一种内容表达之动作内容的字符或符号的集合的细节"},"label":{"ar":"لها تفاصيل شكل من أشكال الحركات المدونة","ca":"té com a particularitats de forma de notació de moviment","cs":"má podrobnosti o formě záznamu pohybu","da":"har detaljer om bevægelsesnotationsform","de":"hat Details zur Form der Bewegungsnotation","de":"hat Details zur Form der Bewegungsnotation","el":"έχει λεπτομέρειες της μορφής της σημειογραφίας κίνησης","en":"has details of form of notated movement (Deprecated)","es":"tiene detalles de la forma del movimiento anotado","et":"liikumisnotatsiooni vormi täpsustus","fi":"liikenotaation tyypin tarkemmat tiedot","fr":"a pour particularités d’une forme de notation du mouvement","hu":"mozgásírásforma részletei a következők:","lv":"detalizēti par kustības pieraksta veidu","nl":"heeft details van vorm van bewegingsnotatie","no":"har detaljer vedrørende form for bevegelsesnotasjon","sv":"har detaljerad information om form av noterad rörelse","tr":"notaya alınmış hareket biçiminin ayrıntıları ile ilişkilidir","vi":"có chi tiết của hình thái động thái ký hiệu","zh-Hans-CN":"有动作谱形式的细节"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfFormOfNotatedMovement.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.13.5.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20263", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfFormOfNotatedMovement.en", "label":"has details of form of notated movement (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20063","definition":{"ar":["تربط بين تعبيرة ومجموعة تمثيلات أو رموز مستخدمة للتعبير عن حركة محتوى تعبيرة."],"ca":["Relaciona una expressió amb un conjunt de caràcters o de símbols usat per expressar el contingut de moviment d’una expressió."],"cs":["Vztahuje vyjádření k souboru znaků nebo symbolů, používaných k vyjadřování pohybového obsahu vyjádření."],"da":["Relaterer et udtryk til et sæt af tegn eller symboler, som anvendes til at udtrykke de bevægelser et udtryk indeholder."],"de":["Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο της κίνησης μιας έκφρασης."],"en":["Relates an expression to a set of characters or symbols used to express movement content of an expression."],"es":["Relaciona una expresión con un conjunto de caracteres o símbolos utilizados para expresar el contenido de movimiento de una expresión."],"et":["Seostab väljenduse märkide või sümbolite kogumiga, mida on kasutatud väljenduse liikumissisu väljendamiseks."],"fi":["Liittää ekspression joukkoon merkkejä tai symboleja, joita käytetään ekspression liikesisällön ilmaisemiseen."],"fr":["Met une expression en relation avec un ensemble de caractères ou de symboles utilisé pour exprimer un contenu de mouvement d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát karakterek vagy szimbólumok egy csoportjához, amelyet arra használnak, hogy egy kifejezési forma mozgástartalmát kifejezze."],"lv":["Sasaista izteiksmi ar zīmju vai simbolu kopumu, kas tiek lietoti, lai atklātu izteiksmes kustības saturu."],"nl":["Relateert een expressie aan een verzameling van karakters of symbolen gebruikt om bewegingscontent van een expressie weer te geven."],"no":["Relaterer et uttrykk til et sett med tegn eller symboler som brukes til å uttrykke bevegelsesinnholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın hareket içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung động thái của biểu hiện."],"zh-Hans-CN":["将一种内容表达与用于表达一种内容表达的动作内容的字符或符号的集合关联起来。"]},"ToolkitLabel":{"ar":"شكل من أشكال الحركات المدونة","ca":"forma de notació de moviment","cs":"podoba zapsaného pohybu","da":"bevægelsesnotationsform","de":"Form der Bewegungsnotationen","de":"Form der Bewegungsnotationen","el":"μορφή της σημειογραφίας κίνησης","en":"form of notated movement","es":"forma de movimiento anotado","et":"liikumisnotatsiooni vorm","fi":"liikenotaation tyyppi","fr":"forme de notation du mouvement","hu":"mozgásírás formája:","lv":"kustības pieraksta forma","nl":"vorm van bewegingsnotatie","no":"bevegelsesnotasjonsform","tr":"notasyonlu hareket formu","vi":"hình thái của động thái ký hiệu","zh-Hans-CN":"动作谱的形式"},"ToolkitDefinition":{"ar":"مجموعة تمثيلات أو رموز مستخدمة للتعبير عن حركة محتوى تعبيرة.","ca":"Conjunt de caràcters o de símbols usat per expressar el contingut de moviment d’una expressió.","cs":"Soubor znaků nebo symbolů, používaných k vyjadřování pohybového obsahu vyjádření.","da":"Sæt af tegn eller symboler, som anvendes til at udtrykke de bevægelser et udtryk indeholder.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den Bewegungsinhalt einer Expression auszudrücken.","el":"Ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο της κίνησης μιας έκφρασης.","en":"A set of characters or symbols used to express movement content of an expression.","es":"Conjunto de caracteres o símbolos utilizados para expresar el contenido de movimiento de una expresión.","et":"Märkide või sümbolite kogum, mida on kasutatud väljenduse liikumissisu väljendamiseks.","fi":"Joukko merkkejä tai symboleja, joita käytetään ekspression liikesisällön ilmaisemiseen.","fr":"Ensemble de caractères ou de symboles utilisé pour exprimer un contenu de mouvement d’une expression.","hu":"Karakterek vagy szimbólumok egy csoportja, amelyet arra használnak, hogy egy kifejezési forma mozgástartalmát kifejezze.","lv":"Zīmju vai simbolu kopums, kas tiek lietoti, lai atklātu izteiksmes kustības saturu.","nl":"Een verzameling van karakters of symbolen gebruikt om bewegingscontent van een expressie weer te geven.","no":"Et sett med tegn eller symboler som brukes til å uttrykke bevegelsesinnholdet i et uttrykk.","tr":"Bir anlatımın hareket içeriğini ifade etmek için kullanılan bir dizi karakterler veya semboller kümesi.","vi":"Chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung động thái của biểu hiện.","zh-Hans-CN":"用于表达一种内容表达的动作内容的字符或符号的集合"},"label":{"ar":"لها شكل من أشكال الحركات المدونة","ca":"té com a forma de notació de moviment","cs":"má podobu zapsaného pohybu","da":"har bevægelsesnotationsform","de":"hat Form der Bewegungsnotation","de":"hat Form der Bewegungsnotation","el":"έχει μορφή της σημειογραφίας κίνησης","en":"has form of notated movement","es":"tiene forma de movimiento anotado","et":"liikumisnotatsiooni vorm","fi":"liikenotaation tyyppi","fr":"a pour forme de notation du mouvement","hu":"mozgásírás formája a következő:","lv":"kustības pieraksta forma","nl":"heeft vorm van bewegingsnotatie","no":"har bevegelsesnotasjonsform","tr":"notaya alınmış hareketin biçimi ile ilişkilidir","vi":"có hình thái của động thái ký hiệu","zh-Hans-CN":"有动作谱的形式"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20062", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotation.en", "label":"has form of notation"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotatedMovement.en","instructionNumber":"7.13.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20063", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/formOfNotatedMovement.en", "label":"has form of notated movement"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20063", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/formOfNotatedMovement.en", "label":"has form of notated movement"}]},{"@id":"http://rdaregistry.info/Elements/e/P20209","definition":{"ar":["تربط بين تعبيرة وتخطيط موسيقي أو مادي لمحتوى تعبيرة يُعرض في شكل من أشكال التدوين الموسيقي."],"ca":["Relaciona una expressió amb una disposició musical o física del contingut d’una expressió que es presenta en la forma de notació musical."],"cs":["Vztahuje vyjádření k hudebnímu nebo fyzickému uspořádání obsahu vyjádření, které je prezentováno ve formě notového zápisu."],"da":["Relaterer et udtryk til et musikalsk eller fysisk layout af et udtryks indhold, som er præsenteret som musikalsk notation."],"de":["Setzt eine Expression in Beziehung zu einem musikalischen oder physischen Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird.,Setzt eine Expression in Beziehung zu einem musikalischen oder physischen Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird."],"el":["Συνδέει μια έκφραση με μια μουσική ή φυσική διάταξη του περιεχομένου μιας έκφρασης η οποία παρουσιάζεται στη μορφή της μουσικής σημειογραφίας."],"en":["Relates an expression to a musical or physical layout of the content of an expression that is presented in the form of musical notation."],"es":["Relaciona una expresión con una disposición musical o física del contenido de una expresión que se presenta en forma de notación musical."],"et":["Seostab väljenduse muusikanotatsiooni vormis esitatud väljenduse sisu muusikalise või füüsilise vormistusviisiga."],"fi":["Liittää ekspression ekspression sisällön musiikilliseen tai fyysiseen taittoon, joka esitetään nuottikirjoituksen muodossa."],"fr":["Met une expression en relation avec une disposition musicale ou matérielle du contenu d’une expression qui se présente sous forme de notation musicale."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma tartalmának zenei vagy fizikai elrendezéséhez, amely egy zenei lejegyzés formájában jelenik meg."],"lv":["Sasaista izteiksmi ar izteiksmes satura muzikālu vai fizisku izkārtojumu, kas atspoguļots nošu rakstā."],"nl":["Relateert een expressie aan een muzikale of fysieke lay-out van de content van een expressie die is aangeboden in de vorm van muzieknotatie."],"no":["Relaterer et uttrykk til et musikalsk eller fysisk oppsett for innholdet i et uttrykk som presenteres i form av musikknotasjon."],"tr":["Bir anlatımı, müzik notasyonu şeklinde sunulan bir anlatımının içeriğinin müzikal veya fiziksel düzeniyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với sắp đặt âm nhạc hoặc vật lý của nội dung của biểu hiện được trình bày dưới hình thái của ký hiệu âm nhạc."],"zh-Hans-CN":["将一种内容表达与以乐谱形式呈现的一种内容表达之内容的音乐或物理布局关联起来。"]},"ToolkitLabel":{"ar":"صيغة من موسيقى مدونة","ca":"format de música notada","cs":"formát notového zápisu","da":"format for noteret musik","de":"Musikalische Ausgabeform","de":"Musikalische Ausgabeform","el":"μορφότυπο της μουσικής σημειογραφίας","en":"format of notated music","es":"formato de música notada","et":"noodi tüüp","fi":"nuottiaineiston muoto","fr":"présentation de la musique notée","hu":"zenei lejegyzés formátuma:","lv":"notācijas formāts","nl":"format van bladmuziek","no":"format for nedskrevet musikk","sv":"format för noterad musik","tr":"notaya alınmış müzik formatı","vi":"định dạng của âm nhạc ký hiệu","zh-Hans-CN":"乐谱的格式"},"ToolkitDefinition":{"ar":"تخطيط موسيقي أو مادي لمحتوى تعبيرة يُعرض في شكل من أشكال التدوين الموسيقي.","ca":"Disposició musical o física del contingut d’una expressió que es presenta en la forma de notació musical.","cs":"Hudební nebo fyzické uspořádání obsahu vyjádření, které je prezentováno ve formě notového zápisu.","da":"Musikalsk eller fysisk layout af et udtryks indhold, som er præsenteret som musikalsk notation.","de":"Ein musikalisches oder physisches Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird.","de":"Ein musikalisches oder physisches Layout des Inhalts einer Expression, der in Form einer Musiknotation präsentiert wird.","el":"Μια μουσική ή φυσική διάταξη του περιεχομένου μιας έκφρασης η οποία παρουσιάζεται στη μορφή της μουσικής σημειογραφίας.","en":"A musical or physical layout of the content of an expression that is presented in the form of musical notation.","es":"Una disposición musical o física del contenido de una expresión que se presenta en forma de notación musical.","et":"Muusikanotatsiooni vormis esitatud väljenduse sisu muusikaline või füüsiline vormistusviis.","fi":"Ekspression sisällön musiikillinen tai fyysinen taitto, joka esitetään nuottikirjoituksen muodossa.","fr":"Disposition musicale ou matérielle du contenu d’une expression qui se présente sous forme de notation musicale.","hu":"Egy kifejezési forma tartalmának zenei vagy fizikai elrendezése, amely egy zenei lejegyzés formájában jelenik meg.","lv":"Izteiksmes satura muzikāls vai fizisks izkārtojums, kas atspoguļots nošu rakstā.","nl":"Een muzikale of fysieke lay-out van de content van een expressie die is aangeboden in de vorm van muzieknotatie.","no":"Et musikalsk eller fysisk oppsett for innholdet i et uttrykk som presenteres i form av musikknotasjon.","tr":"Müzik notasyonu şeklinde sunulan bir anlatımın içeriğinin müzikal veya fiziksel düzeni.","vi":"Sắp đặt âm nhạc hoặc vật lý của nội dung của biểu hiện được trình bày dưới hình thái của ký hiệu âm nhạc.","zh-Hans-CN":"以乐谱形式呈现的一种内容表达之内容的音乐或物理布局"},"label":{"ar":"لها صيغة من موسيقى مدونة","ca":"té com a format de música notada","cs":"má formát notového zápisu","da":"har format for noteret musik","de":"hat musikalische Ausgabeform","de":"hat musikalische Ausgabeform","el":"έχει μορφότυπο της μουσικής σημειογραφίας","en":"has format of notated music","es":"tiene formato de música notada","et":"noodi tüüp","fi":"nuottiaineiston muoto","fr":"a pour présentation de la musique notée","hu":"zenei lejegyzés formátuma a következő:","lv":"notācijas formāts","nl":"heeft formaat van bladmuziek","no":"har format for nedskrevet musikk","sv":"har format för noterad musik","tr":"notaya alınmış müziğin formatı ile ilişkilidir","vi":"có định dạng của âm nhạc ký hiệu","zh-Hans-CN":"有乐谱的形式"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
