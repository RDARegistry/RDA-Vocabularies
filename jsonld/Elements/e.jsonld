                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20129", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayBasedOnExpression.en", "label":"is screenplay based on expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureScreenplayBasedOnExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20130", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/motionPictureScreenplayBasedOnExpression.en", "label":"is motion picture screenplay based on expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20130", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/motionPictureScreenplayBasedOnExpression.en", "label":"is motion picture screenplay based on expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20129","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل معالج كسيناريو لفيلم سينمائي، أو برنامج تليفزيوني، أو فيديو."],"ca":["Relaciona una expressió amb una expressió d’una obra que és adaptada com un guió d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo."],"cs":["Vztahuje vyjádření k vyjádření díla, které je adaptováno jako scénář pro film, televizní program nebo video."],"da":["Relaterer et udtryk til et udtryk af et værk, som er bearbejdet til et manuskript til en spillefilm, tv-program eller video."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Drehbuch für einen Film, eine Fernsehsendung oder ein Video bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Drehbuch für einen Film, eine Fernsehsendung oder ein Video bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως σενάριο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο."],"en":["Relates an expression to an expression of a work that is adapted as a screenplay for a motion picture, television program, or video."],"es":["Relaciona una expresión con una expresión de una obra que se adapta como guión para una película, programa de televisión o vídeo."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud filmi, telesaate või videofilmi stsenaariumina."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sovitettu elokuvan, televisio-ohjelman tai videon käsikirjoitukseksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est adaptée en scénario de film, d’émission de télévision ou de vidéo."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet egy mozgókép, tévéműsor vagy videó forgatókönyveként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir adaptēta kā kinofilmas, televīzijas uzveduma vai video scenārijs."],"nl":["Relateert een expressie aan een expressie van een werk dat is bewerkt als een scenario voor een speelfilm, televisieprogramma of video."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til et manuskript for en spillefilm, et fjernsynsprogram eller en video."],"tr":["Bir anlatımı, sinema filmi, televizyon programı veya video için senaryo olarak uyarlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được phỏng theo như là kịch bản cho phim điện ảnh, chương trình truyền hình, hoặc video."],"zh-Hans-CN":["将一种内容表达与被改编为电影、电视节目或视频剧本的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"سيناريو مبني على تعبيرة","ca":"guió basat en una expressió","cs":"scénář založený na vyjádření","da":"manuskript baseret på udtryk","de":"Drehbuch basiert auf (Expression)","de":"Drehbuch basiert auf (Expression)","el":"σενάριο βασισμένο σε (έκφραση)","en":"screenplay based on expression","es":"guión basado en la expresión","et":"stsenaariumi aluseks olev väljendus","fi":"käsikirjoituksen perustana oleva ekspressio","fr":"scénario basé sur une expression","hu":"forgatókönyv kifejezési forma alapján:","lv":"kā scenārijs adaptētā izteiksme","nl":"scenario gebaseerd op expressie","no":"filmmanus basert på uttrykk","tr":"anlatıma dayalı senaryo","vi":"kịch bản dựa trên (biểu hiện)","zh-Hans-CN":"基于内容表达的影视剧剧本"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معالج كسيناريو لفيلم سينمائي، أو برنامج تليفزيوني، أو فيديو.","ca":"Expressió d’una obra que és adaptada com un guió d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo.","cs":"Vyjádření díla, které je adaptováno jako scénář pro film, televizní program nebo video.","da":"Udtryk af et værk, som er bearbejdet til et manuskript til en spillefilm, tv-program eller video.","de":"Eine Expression eines Werks, die als Drehbuch für einen Film, eine Fernsehsendung oder ein Video bearbeitet ist.","de":"Eine Expression eines Werks, die als Drehbuch für einen Film, eine Fernsehsendung oder ein Video bearbeitet ist.","el":"Μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως σενάριο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο.","en":"An expression of a work that is adapted as a screenplay for a motion picture, television program, or video.","es":"Una expresión de una obra que se adapta como guión para una película, programa de televisión o vídeo.","et":"Teose väljendus, mis on adapteeritud filmi, telesaate või videofilmi stsenaariumina.","fi":"Teoksen ekspressio, joka on sovitettu elokuvan, televisio-ohjelman tai videon käsikirjoitukseksi.","fr":"Expression d’une œuvre qui est adaptée en scénario de film, d’émission de télévision ou de vidéo.","hu":"Egy mű kifejezési formája, amelyet egy mozgókép, tévéműsor vagy videó forgatókönyveként adaptáltak.","lv":"Darba izteiksme, kas ir adaptēta kā kinofilmas, televīzijas uzveduma vai video scenārijs.","nl":"Een expressie van een werk dat is bewerkt als een scenario voor een speelfilm, televisieprogramma of video.","no":"Et uttrykk av et verk som er bearbeidet til et manuskript for en spillefilm, et fjernsynsprogram eller en video.","tr":"Bir sinema filmi, televizyon programı veya video için senaryo olarak uyarlanan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được phỏng theo như là kịch bản cho phim điện ảnh, chương trình truyền hình, hoặc video.","zh-Hans-CN":"被改编为电影、电视节目或视频剧本的一种作品的一种内容表达"},"label":{"ar":"هي سيناريو مبني على تعبيرة","ca":"és guió basat en una expressió","cs":"je scénářem založeným na vyjádření","da":"er manuskript baseret på udtryk","de":"ist Drehbuch basierend auf (Expression)","de":"ist Drehbuch basierend auf (Expression)","el":"είναι σενάριο βασισμένο σε (έκφραση)","en":"is screenplay based on expression","es":"es un guión basado en la expresión","et":"stsenaariumi aluseks olev väljendus","fi":"käsikirjoituksen perustana oleva ekspressio","fr":"est un scénario basé sur une expression","hu":"forgatókönyv a következő kifejezési formából:","lv":"kā scenārijs adaptētā izteiksme","nl":"is scenario gebaseerd op expressie","no":"er filmmanus basert på uttrykk","tr":"senaryo anlatıma dayanmaktadır","vi":"là kịch bản dựa trên (biểu hiện)","zh-Hans-CN":"是基于内容表达的影视剧剧本"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayBasedOnExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20130", "lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureScreenplayBasedOnExpression.en", "label":"is motion picture screenplay based on expression"},{"@id":"http://rdaregistry.info/Elements/e/P20131", "lexicalAlias":"http://rdaregistry.info/Elements/e/televisionScreenplayBasedOnExpression.en", "label":"is television screenplay based on expression"},{"@id":"http://rdaregistry.info/Elements/e/P20132", "lexicalAlias":"http://rdaregistry.info/Elements/e/videoScreenplayBasedOnExpression.en", "label":"is video screenplay based on expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20129", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/screenplayBasedOnExpression.en", "label":"is screenplay based on expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20129", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/screenplayBasedOnExpression.en", "label":"is screenplay based on expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20190","label":{"ar":"هي ليبرتو/نص أوبرالي مبني على تعبيرة","ca":"és llibret basat en una expressió","cs":"je libretem založeným na vyjádření","da":"er libretto baseret på udtryk","de":"ist Libretto basierend auf (Expression)","de":"ist Libretto basierend auf (Expression)","el":"είναι λιμπρέτο βασισμένο στην (έκφραση)","en":"is libretto based on expression","es":"es libreto basado en la expresión","et":"libreto aluseks olev väljendus","fi":"libreton perustana oleva ekspressio","fr":"est un livret basé sur une expression","hu":"librettó a következő kifejezési forma alapján:","lv":"ir librets veidots pēc izteiksmes","nl":"is libretto gebaseerd op expressie","no":"er libretto basert på uttrykk","tr":"anlatıma dayalı librettodur","vi":"là lời nhạc kịch dựa trên (biểu hiện)","zh-Hans-CN":"是基于内容表达的台本"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم كأساس لنص للأوبرا، أو عمل آخر للمسرح الموسيقي، أو لموسيقى دينية."],"ca":["Relaciona una expressió amb una expressió d’una obra que s’usa com la base del text d’una òpera o d’una altra obra per a l’escena musical o un oratori."],"cs":["Vztahuje vyjádření k vyjádření díla, které je použito jako základ pro text opery nebo jiného díla pro hudební scénu nebo oratoria."],"da":["Relaterer et udtryk til et udtryk af et værk, som er bearbejdet til tekst til en opera eller et andet musikalsk sceneværk eller til et oratorium."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Grundlage für den Text einer Oper oder ein anderes Musikwerk für die Bühne oder für ein Oratorium verwendet wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Grundlage für den Text einer Oper oder ein anderes Musikwerk für die Bühne oder für ein Oratorium verwendet wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως το κείμενο μιας όπερας ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο."],"en":["Relates an expression to an expression of a work that is used as the basis for the text of an opera or other work for the musical stage, or an oratorio."],"es":["Relaciona una expresión con una expresión de una obra que se utiliza como base para el texto de una ópera u otra obra para el escenario musical, o un oratorio."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud ooperi või muu muusikalise lavateose või oratooriumi tekstina."],"fi":["Liittää ekspression teoksen ekspressioon, jota on käytetty oopperan, muun musiikillisen näyttämöteoksen tai oratorion tekstin perustana."],"fr":["Met une expression en relation avec une expression d’une œuvre qui sert de base au texte d’un opéra ou d’une autre œuvre pour la scène musicale, ou bien d’un oratorio."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet egy opera, egyéb zenés színpadi mű, vagy egy oratórium szövegének alapjaként használtak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas izmantota par pamatu operas, oratorijas vai cita muzikāli dramatiska darba tekstam."],"nl":["Relateert een expressie aan een expressie van een werk dat is gebruikt als de basis voor de tekst van een opera of ander werk voor het muziekpodium, of een oratorium."],"no":["Relaterer et uttrykk til et uttrykk av et verk brukt som utgangspunkt for teksten til en opera eller annet dramatisk musikalsk verk eller et oratorium."],"tr":["Bir anlatımı, bir operanın veya müzik sahnesi için başka bir eserin veya oratoryonun metnine temel olarak kullanılan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được sử dụng như là cơ sở cho văn bản của opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio."],"zh-Hans-CN":["将一种内容表达与被用作一种歌剧或其他舞台音乐作品或清唱剧文本基础的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"ليبرتو/نص أوبرالي مبني على تعبيرة","ca":"llibret basat en una expressió","cs":"libreto založené na vyjádření","da":"libretto baseret på udtryk","de":"Libretto basiert auf (Expression)","de":"Libretto basiert auf (Expression)","el":"λιμπρέτο βασισμένο στην (έκφραση)","en":"libretto based on expression","es":"libreto basado en la expresión","et":"libreto aluseks olev väljendus","fi":"libreton perustana oleva ekspressio","fr":"livret basé sur une expression","hu":"librettó kifejezési forma alapján:","lv":"librets veidots pēc izteiksmes","nl":"libretto gebaseerd op expressie","no":"libretto basert på uttrykk","tr":"Anlatıma dayalı opera metni","vi":"lời nhạc kịch dựa trên (biểu hiện)","zh-Hans-CN":"基于内容表达的台本"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم كأساس لنص للأوبرا، أو عمل آخر للمسرح الموسيقي، أو لموسيقى دينية.","ca":"Expressió d’una obra que s’usa com la base del text d’una òpera o d’una altra obra per a l’escena musical o un oratori.","cs":"Vyjádření díla, které je použito jako základ pro text opery nebo jiného díla pro hudební scénu nebo oratoria.","da":"Udtryk af et værk, som er blevet bearbejdet til tekst til en opera eller et andet musikalsk sceneværk eller til et oratorium.","de":"Eine Expression eines Werks, die als Grundlage für den Text einer Oper oder ein anderes Musikwerk für die Bühne oder für ein Oratorium verwendet wird.","de":"Eine Expression eines Werks, die als Grundlage für den Text einer Oper oder ein anderes Musikwerk für die Bühne oder für ein Oratorium verwendet wird.","el":"Μια έκφραση ενός έργου το οποίο έχει χρησιμοποιηθεί ως η βάση για το κείμενο μιας όπερας ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο.","en":"An expression of a work that is used as the basis for the text of an opera or other work for the musical stage, or an oratorio.","es":"Una expresión de una obra que se utiliza como base para el texto de una ópera u otra obra para el escenario musical, o un oratorio.","et":"Teose väljendus, mis on adapteeritud ooperi või muu muusikalise lavateose või oratooriumi tekstina.","fi":"Teoksen ekspressio, jota on käytetty oopperan, muun musiikillisen näyttämöteoksen tai oratorion tekstin perustana.","fr":"Expression d’une œuvre qui sert de base au texte d’un opéra ou d’une autre œuvre pour la scène musicale, ou bien d’un oratorio.","hu":"Egy mű kifejezési formája, amelyet egy opera, egyéb zenés színpadi mű, vagy egy oratórium szövegének alapjaként használtak.","lv":"Darba izteiksme, kas izmantota par pamatu operas, oratorijas vai cita muzikāli dramatiska darba tekstam.","nl":"Een expressie van een werk dat is gebruikt als de basis voor de tekst van een opera of ander werk voor het muziekpodium, of een oratorium.","no":"Et uttrykk av et verk brukt som utgangspunkt for teksten til en opera eller annet dramatisk musikalsk verk eller et oratorium.","tr":"Bir operanın veya müzik sahnesi için başka bir eserin veya bir oratoryonun metnine temel olarak kullanılan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được sử dụng như là cơ sở cho văn bản của opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặcoratorio.","zh-Hans-CN":"被用作一种歌剧或其他舞台音乐作品或清唱剧文本基础的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/librettoBasedOnExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20190", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/librettoBasedOnExpression.en", "label":"is libretto based on expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20190", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/librettoBasedOnExpression.en", "label":"is libretto based on expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20133","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل معالج كسيناريو لبرنامج إذاعي."],"ca":["Relaciona una expressió amb una expressió d’una obra que s’adapta com un guió d’un programa radiofònic."],"cs":["Vztahuje vyjádření k vyjádření díla, které je adaptováno jako scénář pro rozhlasový program."],"da":["Relaterer et udtryk til et udtryk af et værk, som er bearbejdet til manuskript til et radioprogram."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Skript für eine Hörfunksendung bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Skript für eine Hörfunksendung bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως σενάριο για ένα ραδιοφωνικό πρόγραμμα."],"en":["Relates an expression to an expression of a work that is adapted as a script for a radio program."],"es":["Relaciona una expresión con una expresión de una obra que se adapta como guión para un programa de radio."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud raadiosaate stsenaariumina."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sovitettu radio-ohjelman käsikirjoitukseksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est adaptée en script d’émission de radio."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet egy rádióműsor forgatókönyveként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir adaptēta kā radio raidījuma scenārijs."],"nl":["Relateert een expressie aan een expressie van een werk dat is bewerkt als een script voor een radioprogramma."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til et manuskript for et radioprogram."],"tr":["Bir anlatımı, bir radyo programı için senaryo olarak uyarlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được phỏng theo như là kịch bản cho chương trình truyền thanh."],"zh-Hans-CN":["将一种内容表达与被改编为广播节目文稿的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"سيناريو إذاعي مبني على تعبيرة","ca":"guió radiofònic basat en una expressió","cs":"rozhlasový scénář založený na vyjádření","da":"radiomanuskript baseret på udtryk","de":"Hörfunkskript basierend auf (Expression)","de":"Hörfunkskript basierend auf (Expression)","el":"ραδιοφωνικό σενάριο βασισμένο σε (έκφραση)","en":"radio script based on expression","es":"guión radiofónico basado en la expresión","et":"raadiostsenaariumi aluseks olev väljendus","fi":"radiokäsikirjoituksen perustana oleva ekspressio","fr":"script radiophonique basé sur une expression","hu":"rádiós szövegkönyv a következő kifejezési forma alapján:","lv":"kā radio raidījuma scenārijs adaptētā izteiksme","nl":"radioscript gebaseerd op expressie","no":"radiomanus basert på uttrykk","tr":"anlatıma dayalı radyo senaryosu","vi":"kịch bản truyền thanh dựa trên (biểu hiện)","zh-Hans-CN":"基于内容表达的广播文稿"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معالج كسيناريو لبرنامج