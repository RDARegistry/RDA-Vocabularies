                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/sequentialExpressionRelationship.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20235", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/sequentialExpressionRelationship.en", "label":"has sequential expression relationship (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20235", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/sequentialExpressionRelationship.en", "label":"has sequential expression relationship (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20025","label":{"ar":"لها وكيل مغنٍ","ca":"té com a agent cantant","cs":"má zpěváka (agenta)","da":"har agent, som er sanger","de":"hat Sängerin/Sänger (Akteur)","de":"hat Sängerin/Sänger (Akteur)","el":"έχει τραγουδιστή","en":"has singer agent","es":"tiene agente cantante","et":"laulja (tegija)","fi":"laulaja (toimija)","fr":"a pour agent chanteur","hu":"énekes ágense a következő:","lv":"dziedātājs (aģents)","nl":"heeft zanger-actor","no":"har sanger (agent)","tr":"şarkıcı temsilcisi ile ilişkilidir","vi":"cóca sỹ","zh-Hans-CN":"有演唱者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة أو دون مصاحبة آلة موسيقية، لإنتاج أغنية."],"ca":["Relaciona una expressió amb un agent que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música."],"cs":["Vztahuje vyjádření k agentovi, který je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj."],"da":["Relaterer et udtryk til en agent, som er en udøver, som bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalledsagelse, til at skabe musik."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt."],"el":["Συνδέει μια έκφραση με έναν εκτελεστή ο οποίος συνεισφέρει σε μια έκφραση ενός έργου χρησιμοποιώντας τη φωνή του/της/των με ή χωρίς συνοδεία για την παραγωγή μουσικής."],"en":["Relates an expression to an agent who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music."],"es":["Relaciona una expresión con un agente que es un intérprete que contribuye a una expresión utilizando su voz, con o sin acompañamiento instrumental, para producir música."],"et":["Seostab väljenduse tegijaga, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma."],"fi":["Liittää ekspression toimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia."],"fr":["Met une expression en relation avec un agent interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására."],"lv":["Sasaista izteiksmi ar aģentu, kas ir izpildītājs, kas sniedzis ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma."],"nl":["Relateert een expressie aan een actor die een uitvoerder is die bijdraagt aan een expressie door het gebruik van zijn stem, met of zonder instrumentale begeleiding, om muziek te produceren."],"no":["Relaterer et uttrykk til en agent som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, for å lage musikk."],"tr":["Bir anlatımı, müzik üretmek için enstrüman eşliğinde veya eşliksiz sesini kullanarak bir anlatıma katkıda bulunan sanatçı olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách sử dụng giọng của mình, có hoặc không có nhạc cụ đệm, để toạ ra âm nhạc."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个行为者关联起来。"]},"note":{"ar":["قد يشتمل أداء المغني أو لا يشتمل على كلمات فعلية."],"ca":["Una actuació d’un cantant pot incloure paraules reals o no incloure-les."],"cs":["Účinkování zpěváka může, ale nemusí obsahovat skutečná slova."],"da":["En sangers optræden kan omfatte egentlige ord, men gør det ikke nødvendigvis."],"de":["Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht.,Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht."],"el":["Η ερμηνεία ενός τραγουδιστή μπορεί να περιλαμβάνει ή όχι, πραγματικές λέξεις."],"en":["A performance of a singer may or may not include actual words."],"es":["La actuación de un cantante puede incluir o no palabras reales."],"et":["Laulja esitus võib sisaldada või mitte sisaldada tegelikult olemasolevaid sõnu."],"fi":["Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja."],"fr":["Une prestation d’un chanteur peut inclure ou non des paroles."],"hu":["Egy énekes előadása tartalmazhat vagy nem tartalmazhat tényleges szavakat."],"lv":["Dziedātāja sniegumā var būt vai nebūt iekļauts teksts."],"nl":["Een uitvoering van een zanger kan al dan niet werkelijke woorden omvatten."],"no":["Sangerens framføring kan være med eller uten ord."],"tr":["Bir şarkıcının performansı gerçek sözleri içerebilir veya içermebilir."],"vi":["Biểu diễn của ca sỹ có thể hoặc không bao gồm các từ thực sự"],"zh-Hans-CN":["演唱者的表演可以包括或可以不包括歌词"]},"ToolkitLabel":{"ar":"وكيل مغنٍ","ca":"agent cantant","cs":"zpěvák (agent)","da":"agent, som er sanger","de":"Sängerin/Sänger (Akteur)","de":"Sängerin/Sänger (Akteur)","el":"τραγουδιστής","en":"singer agent","es":"agente cantante","et":"laulja (tegija)","fi":"laulaja (toimija)","fr":"agent chanteur","hu":"énekes ágens:","lv":"dziedātājs (aģents)","nl":"zanger-actor","no":"sanger (agent)","tr":"şarkıcı temsilci","vi":"ca sỹ","zh-Hans-CN":"演唱者行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة أو دون مصاحبة آلة موسيقية، لإنتاج أغنية.","ca":"Agent que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música.","cs":"Agent, který je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj.","da":"Agent, som er en udøver, som bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalledsagelse, til at skabe musik.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","el":"Ένας εκτελεστής ο οποίος συνεισφέρει σε μια έκφραση ενός έργου χρησιμοποιώντας τη φωνή του/της/των με ή χωρίς συνοδεία για την παραγωγή μουσικής.","en":"An agent who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music.","es":"Un agente que es un intérprete que contribuye a una expresión utilizando su voz, con o sin acompañamiento instrumental, para producir música.","et":"Tegija, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma.","fi":"Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia.","fr":"Agent interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique.","hu":"Egy előadó ágens, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására.","lv":"Aģents - izpildītājs, kas sniedzis ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma.","nl":"Een actor die een uitvoerder is die bijdraagt aan een expressie door het gebruik van zijn stem, met of zonder instrumentale begeleiding, om muziek te produceren.","no":"En agent som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, for å lage musikk.","tr":"Müzik üretmek için enstrümantal eşlikli veya eşliksiz olarak sesini kullanarak bir anlatıma katkıda bulunan bir sanatçı olan temsilci.","vi":"Người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách sử dụng giọng của mình, có hoặc không có nhạc cụ đệm, để toạ ra âm nhạc.","zh-Hans-CN":"作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个行为者"},"altLabel":{"ar":["مغنّ"],"ca":["cantant"],"cs":["zpěvák"],"da":["sanger"],"de":["Sänger,Sänger"],"en":["singer"],"es":["cantante"],"et":["laulja"],"fi":["laulaja"],"fr":["chanteur"],"hu":["énekes:"],"nl":["zanger"],"no":["sanger"],"tr":["şarkıcı"],"zh-Hans-CN":["演唱者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
