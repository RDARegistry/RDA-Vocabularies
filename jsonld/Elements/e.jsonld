                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20507", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCorporateBodyOfExpression.en", "label":"has creator corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20405", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCollectiveAgent.en", "label":"has translator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20464", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/translatorCorporateBody.en", "label":"has translator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20464", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/translatorCorporateBody.en", "label":"has translator corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20523","label":{"ar":"لها عائلة مترجمة","ca":"té com a família traductora","cs":"má překladatele (rodinu)","da":"har familie, som er oversætter","de":"hat Übersetzerin/Übersetzer (Familie)","de":"hat Übersetzerin/Übersetzer (Familie)","en":"has translator family","es":"tiene familia traductora","et":"tõlkija (perekond)","fi":"kääntäjä (suku)","fr":"a pour famille traductrice","hu":"fordító családja a következő:","lv":"tulkotājs (dzimta/ģimene)","nl":"heeft vertaler-familie","no":"har oversetter (familie)","tr":"çevirmen ailesi ile ilişkilidir","zh-Hans-CN":"有译者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet."],"en":["Relates an expression to a family who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al expresar el contenido lingüístico de la obra en un lenguaje diferente."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáinak eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket."],"tr":["Bir anlatımı, eserin dilsel içeriğini orijinal eserin önceki anlatımlarından farklı bir dilde ifade ederek anlatıma katkıda bulunan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مترجمة","ca":"família traductora","cs":"překladatel (rodina)","da":"familie, som er oversætter","de":"Übersetzerin/Übersetzer (Familie)","de":"Übersetzerin/Übersetzer (Familie)","en":"translator family","es":"familia traductora","et":"tõlkija (perekond)","fi":"kääntäjä (suku)","fr":"famille traductrice","hu":"fordító családja:","lv":"tulkotājs (dzimta/ģimene)","nl":"vertaler-familie","no":"oversetter (familie)","tr":"tercüman ailesi","zh-Hans-CN":"译者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي.","ca":"Família que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original.","cs":"Rodina, která přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla.","da":"Familie, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.","en":"A family who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work.","es":"Una familia que contribuye a una expresión al expresar el contenido lingüístico de la obra en un lenguaje diferente.","et":"Perekond, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest.","fi":"Suku, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä.","fr":"Famille qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale.","hu":"Egy család, amely egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáinak eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához.","lv":"Dzimta/ģimene, kas sniegusi ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm.","nl":"Een familie die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk.","no":"En familie som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket.","tr":"Eserin dilsel içeriğini orijinal eserin önceki ifadelerinden farklı bir dille ifade ederek bir anlatıma katkıda bulunan aile.","zh-Hans-CN":"通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个家族"},"note":{"ar":["يمكن للمترجم أيضًا ترجمة المحتوى اللغوي بين أشكال اللغة نفسها خلال فترات زمنية مختلفة."],"ca":["Un traductor també pot traduir un contingut lingüístic entre formes de la mateixa llengua de diferents períodes de temps."],"cs":["Překladatel může také překládat jazykový obsah mezi formami téhož jazyka z různých časových období."],"da":["Oversætter må også oversætte lingvistisk indhold mellem former af det samme sprog fra forskellige tidsperioder."],"de":["Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden.,Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden."],"en":["A translator may also translate linguistic content between forms of the same language from different time periods."],"es":["Un traductor también puede traducir contenido lingüístico entre formas del mismo lenguaje desde diferentes periodos de tiempo."],"et":["Tõlkija võib keelesisu tõlkida ka sama keele eri ajal kasutatud vormide vahel."],"fi":["Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä."],"fr":["Un traducteur peut également traduire un contenu linguistique dans une même langue depuis une forme datant d’une période donnée vers une forme datant d’une autre période."],"hu":["Egy fordító ugyanannak a nyelvnek a különböző időszakokból származó formái közötti nyelvi tartalmat is fordíthatja."],"lv":["Ietver satura tulkošanu no senākas valodas formas mūsdienu valodas formā vienas valodas ietvaros."],"nl":["Een vertaler kan ook taalkundige content vertalen tussen vormen van dezelfde taal uit verschillende tijdperiodes."],"no":["En oversetter kan også oversette språklig innhold mellom ulike former av det samme språket fra ulike tidsperioder."],"tr":["Bir çevirmen, aynı dilin farklı zaman dilimlerindeki biçimleri arasında da dilsel içerik çevirisi yapabilir."],"zh-Hans-CN":["译者还可以在同一种语言的不同时期的形式之间翻译语言内容。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
