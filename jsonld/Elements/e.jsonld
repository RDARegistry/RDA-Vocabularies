                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/colouristFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20544", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToAmalgamation.en", "label":"has contributor family to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20399", "lexicalAlias":"http://rdaregistry.info/Elements/e/colouristCollectiveAgent.en", "label":"has colourist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20517", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/colouristFamily.en", "label":"has colourist family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20517", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/colouristFamily.en", "label":"has colourist family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20340","label":{"ar":"لها شخص رسام","ca":"té com a persona colorista","cs":"má koloristu (osobu)","da":"har person, som er farvelægger","de":"hat Koloristin/Kolorist (Person)","de":"hat Koloristin/Kolorist (Person)","en":"has colourist person","es":"tiene persona colorista","et":"kolorist (isik)","fi":"värittäjä (henkilö)","fr":"a pour personne coloriste","hu":"colorist személye a következő:","lv":"kolorists (persona)","nl":"heeft inkleurder-persoon","no":"har fargelegger (person)","tr":"renklendirici ile ilişkilidir","zh-Hans-CN":"有着色者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال تلوين الرسومات، أو المطبوعات، أو الصور الفوتوغرافية، أو الخرائط، أو الصور المتحركة، أو أي محتوى آخر."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment o altre contingut."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření nanášením barev na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at farvelægge tegninger, tryk, fotos, kort, levende billeder etc."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt."],"en":["Relates an expression to a person who contributes to an expression by applying colour to drawings, prints, photographs, maps, moving images, or other content."],"es":["Relaciona una expresión con una persona que contribuye a una expresión aplicando color a dibujos, grabados, fotografías, mapas, imágenes en movimiento u otro contenido."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte vms."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en appliquant de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées ou d’autres contenus."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki hozzájárul egy kifejezési formához azzal, hogy színt hord fel rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más tartalmakra."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, izkrāsojot zīmējumus, gravīras, fotogrāfijas, kartes, kustīgus attēlus, u.tml."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden of andere content."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å fargelegge tegninger, trykk, fotografier, kart, levende bilder, etc."],"tr":["Bir anlatımı çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere veya diğer içeriğe renk uygulayarak anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过将颜色施加于图画、印刷品、照片、地图、动态图像或其他内容上而对一种内容表达作出贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص رسام","ca":"persona colorista","cs":"kolorista (osoba)","da":"person, som er farvelægger","de":"Koloristin/Kolorist (Person)","de":"Koloristin/Kolorist (Person)","en":"colourist person","es":"persona colorista","et":"kolorist (isik)","fi":"värittäjä (henkilö)","fr":"personne coloriste","hu":"colorist személy:","lv":"kolorists (persona)","nl":"inkleurder-persoon","no":"fargelegger (person)","tr":"renklendirici","zh-Hans-CN":"着色者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال تلوين الرسومات، أو المطبوعات، أو الصور الفوتوغرافية، أو الخرائط، أو الصور المتحركة، أو أي محتوى آخر.","ca":"Persona que contribueix a una expressió aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment o altre contingut.","cs":"Osoba, která přispívá k vyjádření nanášením barev na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah.","da":"Person, som bidrager til et udtryk ved at farvelægge tegninger, tryk, fotos, kort, levende billeder etc.","de":"Eine Person, die zu einer Expression beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt.","de":"Eine Person, die zu einer Expression beiträgt, indem sie Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt.","en":"A person who contributes to an expression by applying colour to drawings, prints, photographs, maps, moving images, or other content.","es":"Una persona que contribuye a una expresión aplicando color a dibujos, grabados, fotografías, mapas, imágenes en movimiento u otro contenido.","et":"Isik, kes annab panuse väljendusse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte vms.","fi":"Henkilö, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä.","fr":"Personne qui contribue à une expression en appliquant de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées ou d’autres contenus.","hu":"Egy személy, aki hozzájárul egy kifejezési formához azzal, hogy színt hord fel rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más tartalmakra.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, izkrāsojot zīmējumus, gravīras, fotogrāfijas, kartes, kustīgus attēlus, u.tml.","nl":"Een persoon die bijdraagt aan een expressie door het toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden of andere content.","no":"En person som bidrar til et uttrykk ved å fargelegge tegninger, trykk, fotografier, kart, levende bilder, etc.","tr":"Çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere veya diğer içeriklere renk uygulayarak bir anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过将颜色施加于图画、印刷品、照片、地图、动态图像或其他内容上而对一种内容表达作出贡献的一个个人"},"altLabel":{"ar":["شخص رسام"],"da":["person, som er farvelægger"],"de":["Coloristin/Colorist (Person),Coloristin/Colorist (Person)"],"en":["colorist person"],"es":["persona colorista"],"fi":["-"],"hu":["színező személy:"],"nl":["inkleurder-persoon"],"tr":["renklendirici"],"zh-Hans-CN":["着色者个人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
