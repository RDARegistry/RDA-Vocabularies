                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20329", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToPerformance.en", "label":"has contributor agent to performance"}],"See Also":[{"@id":"http://rdaregistry.info/Elements/w/P10053", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerAgentOfWork.en", "label":"has composer agent of work"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20421", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerCollectiveAgent.en", "label":"has music programmer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20362", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerPerson.en", "label":"has music programmer person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20294", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicProgrammerAgent.en", "label":"has music programmer agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20294", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicProgrammerAgent.en", "label":"has music programmer agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20421","label":{"ar":"لها وكيل جماعي مبرمج موسيقي","ca":"té com a agent col·lectiu programador de música","cs":"má hudebního programátora (kolektivního agenta)","da":"har kollektiv agent, som er musikprogrammør","de":"hat Musik-Programmiererin/Musik-Programmierer (Gemeinschaftlicher Akteur)","de":"hat Musik-Programmiererin/Musik-Programmierer (Gemeinschaftlicher Akteur)","en":"has music programmer collective agent","es":"tiene agente colectivo programador musical","et":"muusikaprogrammeerij