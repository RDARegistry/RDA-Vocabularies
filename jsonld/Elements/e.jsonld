                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20435", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistCollectiveAgent.en", "label":"has instrumentalist collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20376", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistPerson.en", "label":"has instrumentalist person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20020", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/instrumentalistAgent.en", "label":"has instrumentalist agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20020", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/instrumentalistAgent.en", "label":"has instrumentalist agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20435","label":{"ar":"لها وكيل جماعي عازف","ca":"té com a agent col·lectiu instrumentista","cs":"má instrumentalistu (kolektivního agenta)","da":"har kollektiv agent, som er instrumentalist","de":"hat Instrumentalmusikerin/Instrumentalmusiker (Gemeinschaftlicher Akteur)","de":"hat Instrumentalmusikerin/Instrumentalmusiker (Gemeinschaftlicher Akteur)","en":"has instrumentalist collective agent","es":"tiene agente colectivo instrumentista","et":"instrumentalist (kollektiiv)","fi":"soittaja (yhteistoimija)","fr":"a pour agent collectif instrumentiste","hu":"zenész kollektív ágense a következő:","lv":"instrumentālists (grupa)","nl":"heeft instrumentalist-collectieve actor","no":"har instrumentalist (kollektiv agent)","tr":"enstrüman sanatçısı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有乐器演奏者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال العزف على آلة موسيقية."],"ca":["Relaciona una expressió amb un agent col·lectiu que és un intèrpret que contribueix a una expressió tocant un instrument musical."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je účinkujícím, který přispívá k vyjádření tím, že hraje na hudební nástroj."],"da":["Relaterer et udtryk til en kollektiv agent, som er en udøver, som bidrager til et udtryk ved at spille et musikinstrument."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt."],"en":["Relates an expression to a collective agent who is a performer who contributes to an expression by playing a musical instrument."],"es":["Relaciona una expresión con un agente colectivo que es un intérprete que contribuye a una expresión al tocar un instrumento musical."],"et":["Seostab väljenduse kollektiiviga, kes esitajana annab panuse väljendusse, mängides muusikainstrumenti."],"fi":["Liittää ekspression yhteistoimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta."],"fr":["Met une expression en relation avec un agent collectif interprète qui contribue à une expression en jouant d’un instrument de musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó kollektív ágenshez, amely hangszeren játszik és ezzel hozzájárul egy kifejezési formához."],"lv":["Sasaista izteiksmi ar grupu, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, spēlējot mūzikas instrumentu."],"nl":["Relateert een expressie aan een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het spelen van een muziekinstrument."],"no":["Relaterer et uttrykk til en kollektiv agent som er en utøver som bidrar til et uttrykk ved å spille et musikkinstrument."],"tr":["Bir anlatımı, müzik aleti çalarak anlatıma katkıda bulunan bir sanatçı olan kolektif temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过演奏乐器对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي عازف","ca":"agent col·lectiu instrumentista","cs":"instrumentalista (kolektivní agent)","da":"kollektiv agent, som er instrumentalist","de":"Instrumentalmusikerin/Instrumentalmusiker (Gemeinschaftlicher Akteur)","de":"Instrumentalmusikerin/Instrumentalmusiker (Gemeinschaftlicher Akteur)","en":"instrumentalist collective agent","es":"agente colectivo instrumentista","et":"instrumentalist (kollektiiv)","fi":"soittaja (yhteistoimija)","fr":"agent collectif instrumentiste","hu":"zenész kollektív ágens:","lv":"instrumentālists (grupa)","nl":"instrumentalist-collectieve actor","no":"instrumentalist (kollektiv agent)","tr":"enstrümantalist kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"乐器演奏者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال العزف على آلة موسيقية.","ca":"Agent col·lectiu que és un intèrpret que contribueix a una expressió tocant un instrument musical.","cs":"Kolektivní agent, který je účinkujícím, který přispívá k vyjádření tím, že hraje na hudební nástroj.","da":"Kollektiv agent, som er en udøver, som bidrager til et udtryk ved at spille et musikinstrument.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt.","en":"A collective agent who is a performer who contributes to an expression by playing a musical instrument.","es":"Un agente colectivo que es un intérprete que contribuye a una expresión al tocar un instrumento musical.","et":"Kollektiiv, kes esitajana annab panuse väljendusse, mängides muusikainstrumenti.","fi":"Yhteistoimija, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta.","fr":"Agent collectif interprète qui contribue à une expression en jouant d’un instrument de musique.","hu":"Egy előadó kollektív ágens, amely hangszeren játszik és ezzel hozzájárul egy kifejezési formához.","lv":"Grupa - izpildītājs, kas sniegusi ieguldījumu izteiksmē, spēlējot mūzikas instrumentu.","nl":"Een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het spelen van een muziekinstrument.","no":"En kollektiv agent som er en utøver som bidrar til et uttrykk ved å spille et musikkinstrument.","tr":"Müzik enstrümanı çalarak ifadeye katkıda bulunan bir sanatçı olan kolektif temsilci.","zh-Hans-CN":"作为一个表演者通过演奏乐器对一种内容表达有贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
