                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/sourceExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20189", "lexicalAlias":"http://rdaregistry.info/Elements/e/revisionOf.en", "label":"is revision of"},{"@id":"http://rdaregistry.info/Elements/e/P20139", "lexicalAlias":"http://rdaregistry.info/Elements/e/arrangementOf.en", "label":"is arrangement of"},{"@id":"http://rdaregistry.info/Elements/e/P20141", "lexicalAlias":"http://rdaregistry.info/Elements/e/translationOf.en", "label":"is translation of"},{"@id":"http://rdaregistry.info/Elements/e/object/P20574", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/sourceExpression.en", "label":"has source expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20574", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/sourceExpression.en", "label":"has source expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20576","label":{"ca":"és expressió descrita amb metadades per","cs":"je vyjádřením popsaným metadaty (čím)","de":"ist Akteur beschrieben durch Metadaten","en":"is expression described with metadata by","es":"es expresión descrita con metadatos por","fi":"ekspressiota metatiedoilla kuvaileva teos","fr":"est une expression décrite avec des métadonnées par","hu":"kifejezési forma leírva a következő metaadatokkal:","nl":"is expressie beschreven met metadata door","tr":"tarafından üstveri ile tanımlanmış anlatımdır","zh-Hans-CN":"是被……用元数据描述的内容表达"},"definition":{"ca":["Relaciona una expressió amb una obra que és una obra de metadades d’una expressió."],"cs":["Vztahuje vyjádření k dílu, které je metadatovým dílem pro vyjádření."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Drehbuch für ein Video bearbeitet ist."],"en":["Relates an expression to a work that is a metadata work for an expression."],"es":["Relaciona una expresión con una obra que es una obra de metadatos para una expresión."],"fi":["Liittää ekspression teokseen, joka on ekspression metatietoteos."],"fr":["Met une expression en relation avec une œuvre qui consiste en une œuvre de métadonnées pour une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy műhöz, amely egy kifejezési formára vonatkozó metaadatmű."],"nl":["Relateert een expressie aan een werk dat is een metadatawerk voor een expressie."],"tr":["Bir anlatımı, anlatım için üstveri eseri olan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一种内容表达的元数据作品的一种作品关联起来。"]},"ToolkitLabel":{"ca":"expressió descrita amb metadades per","cs":"vyjádření popsané metadaty","en":"expression described with metadata by","es":"expresión descrita con metadatos por","fi":"ekspressiota metatiedoilla kuvaileva teos","fr":"expression décrite avec des métadonnées par","hu":"kifejezési forma leírva a következő metaadatokkal:","nl":"expressie beschreven met metadata door","tr":"tarafından üstverilerle açıklanan anlatım","zh-Hans-CN":"被……用元数据描述的内容表达"},"ToolkitDefinition":{"ca":"Obra que és una obra de metadades d’una expressió.","cs":"Dílo, které je metadatovým dílem pro vyjádření.","de":"Eine Expression eines Werks, die als Drehbuch für ein Video bearbeitet ist.","en":"A work that is a metadata work for an expression.","es":"Una obra que es una obra de metadatos para una expresión.","fi":"Teos, joka on ekspression metatietoteos.","fr":"Œuvre qui consiste en une œuvre de métadonnées pour une expression.","hu":"Egy mű, amely egy kifejezési formára vonatkozó metaadatmű.","nl":"Een werk dat is een metadatawerk voor een expressie.","tr":"Bir anlatım için üstveri çalışması olan bir eser.","zh-Hans-CN":"作为一种内容表达的元数据作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
