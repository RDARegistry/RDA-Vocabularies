                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/narratorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20437", "lexicalAlias":"http://rdaregistry.info/Elements/e/narratorCollectiveAgent.en", "label":"has narrator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20496", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/narratorCorporateBody.en", "label":"has narrator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20496", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/narratorCorporateBody.en", "label":"has narrator corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20555","label":{"ar":"لها عائلة راوية","ca":"té com a família narradora","cs":"má vypravěče-komentátora (rodinu)","da":"har familie, som er fortæller/indlæser","de":"hat Erzählerin/Erzähler (Familie)","de":"hat Erzählerin/Erzähler (Familie)","en":"has narrator family","es":"tiene familia narradora","et":"jutustaja (perekond)","fi":"kertoja (suku)","fr":"a pour famille narratrice","hu":"narrátor családja a következő:","lv":"teicējs (dzimta/ģimene)","nl":"heeft verteller-familie","no":"har forteller (familie)","tr":"anlatıcı ailesi ile ilişkilidir","zh-Hans-CN":"有旁白者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تكون مؤديًا يساهم في تعبيرة من خلال القراءة بصوت مرتفع، أو سرد فصل من مسرحية، أو واقعة، أو حدث آخر."],"ca":["Relaciona una expressió amb una família que és un intèrpret que contribueix a una expressió llegint en veu alta o explicant una acció, una situació o qualsevol altre esdeveniment."],"cs":["Vztahuje vyjádření k rodině, která je účinkujícím, který přispívá k vyjádření tím, že nahlas předčítá nebo slovně popisuje činnost, děj nebo jinou událost."],"da":["Relaterer et udtryk til en familie, som er en udøver, som bidrager til et udtryk ved at læse højt eller berette om en handling, en hændelse, et begivenhedsforløb etc."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert."],"en":["Relates an expression to a family who is a performer who contributes to an expression by reading aloud or giving an account of an act, occurrence, or other event."],"es":["Relaciona una expresión con una familia que es un intérprete que contribuye a una expresión al leer en voz alta o dar un reporte de un acto, acontecimiento u otro evento."],"et":["Seostab väljenduse perekonnaga, kes esitajana annab panuse väljendusse, valjusti lugedes või jutustades mingist tegevusest, juhtumist, sündmuste käigust vms."],"fi":["Liittää ekspression sukuun, joka on esittäjä, joka osallistuu ekspression tekemiseen lukemalla ääneen tai kertomalla toiminnasta, tapauksesta tai muusta tapahtumasta."],"fr":["Met une expression en relation avec une famille interprète qui contribue à une expression en lisant à voix haute ou en rendant compte d’une action, d’une situation ou d’un autre événement."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó családhoz, amely hozzájárul egy kifejezési formához egy cselekményről, történésről vagy más eseményről szóló beszámoló hangos felolvasásával."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, skaļi nolasot tekstu vai informējot par darbību, notikumu, notikumu gaitu u.tml."],"nl":["Relateert een expressie aan een familie die een uitvoerder is die bijdraagt aan een expressie door het hardop lezen of verslag geven van een daad, voorval of andere gebeurtenis."],"no":["Relaterer et uttrykk til en familie som er en utøver som bidrar til et uttrykk ved å lese høyt eller fortelle om en handling, hendelse, historie etc."],"tr":["Bir anlatımı, bir eylemi, oluşumu veya başka bir olayı anlatarak veya yüksek sesle okuyarak bir anlatıma katkıda bulunan bir sanatçı olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过朗读或描述行为、事情或其他事件而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة راوية","ca":"família narradora","cs":"vypravěč-komentátor (rodina)","da":"familie, som er fortæller/indlæser","de":"Erzählerin/Erzähler (Familie)","de":"Erzählerin/Erzähler (Familie)","en":"narrator family","es":"familia narradora","et":"jutustaja (perekond)","fi":"kertoja (suku)","fr":"famille narratrice","hu":"narrátor család:","lv":"teicējs (dzimta/ģimene)","nl":"verteller-familie","no":"forteller (familie)","tr":"anlatici ai̇le","zh-Hans-CN":"旁白者家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤديًا يساهم في تعبيرة من خلال القراءة بصوت مرتفع، أو سرد فصل من مسرحية، أو واقعة، أو حدث آخر.","ca":"Família que és un intèrpret que contribueix a una expressió llegint en veu alta o explicant una acció, una situació o qualsevol altre esdeveniment.","cs":"Rodina, která je účinkujícím, který přispívá k vyjádření tím, že nahlas předčítá nebo slovně popisuje činnost, děj nebo jinou událost","da":"Familie, som er en udøver, som bidrager til et udtryk ved at læse højt eller berette om en handling, en hændelse, et begivenhedsforløb etc.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.","en":"A family who is a performer who contributes to an expression by reading aloud or giving an account of an act, occurrence, or other event.","es":"Una familia que es un intérprete que contribuye a una expresión al leer en voz alta o dar un reporte de un acto, acontecimiento u otro evento.","et":"Perekond, kes esitajana annab panuse väljendusse, valjusti lugedes või jutustades mingist tegevusest, juhtumist, sündmuste käigust vms.","fi":"Suku, joka on esittäjä, joka osallistuu ekspression tekemiseen lukemalla ääneen tai kertomalla toiminnasta, tapauksesta tai muusta tapahtumasta.","fr":"Famille interprète qui contribue à une expression en lisant à voix haute ou en rendant compte d’une action, d’une situation ou d’un autre événement.","hu":"Egy előadó család, amely hozzájárul egy kifejezési formához egy cselekményről, történésről vagy más eseményről szóló beszámoló hangos felolvasásával.","lv":"Dzimta/ģimene - izpildītājs, kas sniegusi ieguldījumu izteiksmē, skaļi nolasot tekstu vai informējot par darbību, notikumu, notikumu gaitu u.tml.","nl":"Een familie die een uitvoerder is die bijdraagt aan een expressie door het hardop lezen of verslag geven van een daad, voorval of andere gebeurtenis.","no":"En familie som er en utøver som bidrar til et uttrykk ved å lese høyt eller fortelle om en handling, hendelse, historie etc.","tr":"Bir eylemi, olayı veya başka bir durumu yüksek sesle okuyarak veya açıklama yaparak bir anlatıma katkıda bulunan sanatçı bir aile.","zh-Hans-CN":"作为一个表演者通过朗读或描述行为、事情或其他事件而对一种内容表达有贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
