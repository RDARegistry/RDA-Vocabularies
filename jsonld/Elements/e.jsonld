                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20560", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorFamily.en", "label":"has conductor family"},{"@id":"http://rdaregistry.info/Elements/e/P20395", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorCollectiveAgent.en", "label":"has choral conductor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20513", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/choralConductorFamily.en", "label":"has choral conductor family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20513", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/choralConductorFamily.en", "label":"has choral conductor family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20336","label":{"ar":"لها شخص قائد كورال","ca":"té com a persona directora de cor","cs":"má sborového dirigenta (osobu)","da":"har person, som er kordirigent","de":"hat Chorleiterin/Chorleiter (Person)","de":"hat Chorleiterin/Chorleiter (Person)","en":"has choral conductor person","es":"tiene persona director coral","et":"koorijuht (isik)","fi":"kuoronjohtaja (henkilö)","fr":"a pour personne chef de chœur","hu":"kórusvezető személye a következő:","lv":"kordiriģents (persona)","nl":"heeft koordirigent-persoon","no":"har kordirigent (person)","tr":"koro şefi ile ilişkilidir","zh-Hans-CN":"有合唱指挥个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مايسترو يساهم في تعبيرة من خلال قيادة فريق كورال في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió dirigint una coral en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že řídí pěvecký sbor v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en person, som er dirigent, som bidrager til et udtryk ved at lede et optrædende kor i en musikalsk eller dramatisk præsentation."],"de":["Setzt eine Expression in Beziehung zu einer Dirigentin/einem Dirigenten (Person), die/der zu einer Expression beiträgt, indem sie/er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.,Setzt eine Expression in Beziehung zu einer Dirigentin/einem Dirigenten (Person), die/der zu einer Expression beiträgt, indem sie/er einen Chor in einer musikalischen oder dramatischen Darbietung leitet."],"en":["Relates an expression to a person who contributes to an expression by leading a choral performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con una persona que contribuye a una expresión dirigiendo un grupo coral en una presentación musical o dramática."],"et":["Seostab väljenduse isikuga, kes dirigendina annab panuse väljendusse, juhatades koori muusika- või draamaetenduses."],"fi":["Liittää ekspression henkilöön, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla kuoroa musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en dirigeant un groupe de choristes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy karmester személyhez, aki hozzájárul egy kifejezési formához azzal, hogy énekkari előadói csoportot vezet egy zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar personu, kura kā diriģents vada kora izpildītājmākslinieku grupu mūzikas vai dramatiskā uzvedumā."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het leiden van een optredende koorgroep in een muzikale of dramatische presentatie."],"no":["Relaterer et uttrykk til en person som er en dirigent som bidrar til et uttrykk ved å lede et kor i en musikalsk eller dramatisk forestilling etc."],"tr":["Bir anlatımı, müzikal veya dramatik bir sunumda bir koro performans grubuna liderlik ederek bir anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过在音乐或戏剧呈现中领导一个合唱表演团队而对一种内容表达作出贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص قائد كورال","ca":"persona directora de cor","cs":"sborový dirigent (osoba)","da":"person, som er kordirigent","de":"Chorleiterin/Chorleiter (Person)","de":"Chorleiterin/Chorleiter (Person)","en":"choral conductor person","es":"persona director coral","et":"koorijuht (isik)","fi":"kuoronjohtaja (henkilö)","fr":"personne chef de chœur","hu":"kórusvezető személy:","lv":"kordiriģents (persona)","nl":"koordirigent-persoon","no":"kordirigent (person)","tr":"koro şefi","zh-Hans-CN":"合唱指挥个人"},"ToolkitDefinition":{"ar":"شخص يكون مايسترو يساهم في تعبيرة من خلال قيادة فريق كورال في عرض موسيقي أو درامي.","ca":"Persona que contribueix a una expressió dirigint una coral en una representació musical o dramàtica.","cs":"Osoba, která přispívá k vyjádření tím, že řídí pěvecký sbor v hudebním nebo dramatickém vystoupení.","da":"Person, som er dirigent, som bidrager til et udtryk ved at lede et optrædende kor i en musikalsk eller dramatisk præsentation.","de":"Eine Dirigentin/Ein Dirigent (Person), die/der zu einer Expression beiträgt, indem sie/er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.","de":"Eine Dirigentin/Ein Dirigent (Person), die/der zu einer Expression beiträgt, indem sie/er einen Chor in einer musikalischen oder dramatischen Darbietung leitet.","en":"A person who contributes to an expression by leading a choral performing group in a musical or dramatic presentation.","es":"Una persona que contribuye a una expresión dirigiendo un grupo coral en una presentación musical o dramática.","et":"Isik, kes dirigendina annab panuse väljendusse, juhatades koori muusika- või draamaetenduses.","fi":"Henkilö, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla kuoroa musiikki- tai näytelmäesityksessä.","fr":"Personne qui contribue à une expression en dirigeant un groupe de choristes dans une présentation musicale ou dramatique.","hu":"Egy karmester személy, aki hozzájárul egy kifejezési formához azzal, hogy énekkari előadói csoportot vezet egy zenei vagy drámai bemutatóban.","lv":"Persona, kura kā diriģents vada kora izpildītājmākslinieku grupu mūzikas vai dramatiskā uzvedumā.","nl":"Een persoon die bijdraagt aan een expressie door het leiden van een optredende koorgroep in een muzikale of dramatische presentatie.","no":"En person som er en dirigent som bidrar til et uttrykk ved å lede et kor i en musikalsk eller dramatisk forestilling etc.","tr":"Müzikal veya dramatik sunumunda koroya ya da icra eden bir gruba liderlik ederek anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过在音乐或戏剧呈现中领导一个合唱表演团队而对一种内容表达作出贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
