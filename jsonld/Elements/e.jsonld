                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForExpression.en", "label":"is music for expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicForVideoExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20246", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicForVideoExpression.en", "label":"is music for video expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20246", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicForVideoExpression.en", "label":"is music for video expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20573","label":{"ar":"لها لون","ca":"té com a color","cs":"má barvu","da":"har farve","de":"hat Farbton","de":"hat Farbton","en":"has colour","es":"tiene color","fi":"väri","fr":"a pour couleur","hu":"a színe a következő:","lv":"krāsa","nl":"heeft kleur","tr":"renk ile ilişkilidir","zh-Hans-CN":"有颜色"},"definition":{"ar":["تربط بين تعبيرة وتصنيف يعكس تدرجا للمحتوى المرئي لتعبيرة."],"ca":["Relaciona una expressió amb una categorització que reflecteix un matís del contingut visual d’una expressió."],"cs":["Vztahuje vyjádření ke kategorizaci odrážející odstín vizuálního obsahu vyjádření."],"da":["Relaterer et udtryk til en kategorisering, som reflekterer en farvetone af et udtryks synlige indhold."],"de":["Setzt eine Expression in Beziehung zu einer Kategorisierung, die eine Farbschattierung des bildlichen Inhalts einer Expression widerspiegelt.,Setzt eine Expression in Beziehung zu einer Kategorisierung, die eine Farbschattierung des bildlichen Inhalts einer Expression widerspiegelt."],"en":["Relates an expression to a categorization reflecting a hue of the visual content of an expression."],"es":["Relaciona una expresión con una categorización que refleja una tonalidad del contenido visual de una expresión."],"fi":["Liittää ekspression kategorisointiin, joka ilmaisee ekspression visuaalisen sisällön värisävyn."],"fr":["Met une expression en relation avec une catégorisation qui indique une teinte du contenu visuel d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma vizuális tartalmának színárnyalatát tükröző kategorizáláshoz."],"lv":["Sasaista izteiksmi ar kategoriju, kas atspoguļo izteiksmes vizuālā satura toni."],"nl":["Relateert een expressie aan een categorisatie die de tint weergeeft van de visuele content van een expressie."],"tr":["Bir anlatımı, bir anlatımın görsel içeriğinin bir tonunu yansıtan bir kategoriyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与反映一种内容表达的视觉内容的色调的一个分类关联起来。"]},"ToolkitLabel":{"ar":"لون","ca":"color","cs":"barva","da":"farve","de":"Farbton","de":"Farbton","en":"colour","es":"color","fi":"väri","fr":"couleur","hu":"szín","lv":"krāsa","nl":"kleur","tr":"renk","zh-Hans-CN":"颜色"},"ToolkitDefinition":{"ar":"تصنيف يعكس تدرجا للمحتوى المرئي لتعبيرة.","ca":"Categorització que reflecteix un matís del contingut visual d’una expressió.","cs":"Kategorizace odrážející odstín vizuálního obsahu vyjádření.","da":"Kategorisering, som reflekterer en farvetone af et udtryks synlige indhold.","de":"Eine Kategorisierung, die eine Farbschattierung des bildlichen Inhalts einer Expression widerspiegelt.","de":"Eine Kategorisierung, die eine Farbschattierung des bildlichen Inhalts einer Expression widerspiegelt.","en":"A categorization reflecting a hue of the visual content of an expression.","es":"Una categorización que refleja una tonalidad del contenido visual de una expresión.","fi":"Kategorisointi, joka ilmaisee ekspression visuaalisen sisällön värisävyn.","fr":"Catégorisation qui indique une teinte du contenu visuel d’une expression.","hu":"Egy kifejezési forma vizuális tartalmának színárnyalatát tükröző kategorizálás.","lv":"Kategorija, kas atspoguļo izteiksmes vizuālā satura toni.","nl":"Een categorisatie die de tint weergeeft van visuele content van een expressie.","tr":"Bir ifadenin görsel içeriğinin tonunu yansıtan bir kategorizasyon.","zh-Hans-CN":"反映一种内容表达的视觉内容的色调的一个分类"},"altLabel":{"ar":["لون"],"ca":["color"],"da":["farve"],"de":["ursprüngliche"],"en":["color"],"es":["color"],"fi":["-"],"hu":["szín"],"nl":["kleur"],"tr":["renk"],"zh-Hans-CN":["颜色"]},"note":{"ar":["قد يوجد لون في تعبيرة لها نوع محتوى من \"صورة خرائطية\"، أو \"صورة متحركة خرائطية\"، أو \"شكل خرائطي ثلاثي الأبعاد\"، أو \"حركة مدونة\"، أو \"موسيقى مدونة\"، أو \"حركة مؤداة\"، أو \"صورة ثابتة\"، أو \"نص\"، أو \"صورة متحركة ثُلاثية الأبعاد\"، أو \"شكل ثلاثي الأبعاد\"، أو \"صورة متحركة ثنائية الأبعاد\"."],"ca":["El color pot ser present en una expressió amb un tipus de contingut de \"imatge cartogràfica\", \"imatge cartogràfica en moviment\", \"forma cartogràfica tridimensional\", \"moviment notat\", \"música notada\", \"moviment executat\", \"imatge fixa\", \"text\", \"imatge en moviment tridimensional\", \"forma tridimensional\" o \"imatge en moviment bidimensional\"."],"cs":["Barva může být přítomna ve vyjádřeních s obsahem typu: „kartografický obraz“, „kartografický pohyblivý obraz“, „kartografická trojrozměrná forma“, „zápis pohybu“, „zápis hudby“, „provedený pohyb“, „statický obraz“, „text“, „trojrozměrný pohyblivý obraz“, „trojrozměrná forma“, nebo „dvojrozměrný pohyblivý obraz“."],"da":["Farve kan være til stede i et udtryk med indholdstype \"kartografisk billede\", kartografisk levende billede\", \"kartografisk tredimensional form\", \"noteret bevægelse\", \"noteret musik\", \"fremført bevægelse\", \"stillbillede\", \"tekst\", \"tredimensional levende billede\", \"tredimensional form\", eller \"todimensional form\"."],"de":["Dies kann auf eine Expression mit dem Inhaltstyp kartografisches Bild, kartografisches Bewegtbild, kartografische dreidimensionale Form, Bewegtnotation, Noten, aufgeführte Bewegung, unbewegtes Bild, Text, dreidimensionales Bewegtbild, dreidimensionale Form oder zweidimensionales Bewegtbild zutreffen.,Dies kann auf eine Expression mit dem Inhaltstyp „kartografisches Bild“, „kartografisches Bewegtbild“, „kartografische dreidimensionale Form“, „Bewegtnotation“, „Noten“, „aufgeführte Bewegung“, „unbewegtes Bild“, „Text“, „dreidimensionales Bewegtbild“, „dreidimensionale Form“ oder „zweidimensionales Bewegtbild“ zutreffen."],"en":["Colour may be present in an expression with a content type of \"cartographic image\", \"cartographic moving image\", \"cartographic three-dimensional form\", \"notated movement\", \"notated music\", \"performed movement\", \"still image\", \"text\", \"three-dimensional moving image\", \"three-dimensional form\", or \"two-dimensional moving image\"."],"es":["El color puede estar presente en una expresión con un tipo de contenido de \"imagen cartográfica\", \"imagen cartográfica en movimiento\", \"forma cartográfica tridimensional\", \"movimiento notado\", \"música notada\", \"movimiento interpretado\", \"imagen fija\", \"texto\", \"imagen tridimensional en movimiento\", \"forma tridimensional en movimiento\" o \"imagen bidimensional en movimiento\"."],"fi":["Väri voi esiintyä ekspressiossa \"kartografisen kuvan\", \"kartografisen liikkuvan kuvan\", \"kartografisen kolmiulotteisen muodon\", \"liikenotaation\", \"nuottikirjoituksen\", \"esitetyn liikkeen\", \"stillkuvan\", \"tekstin\", \"kolmiulotteisen liikkuvan kuvan\", \"kolmiulotteisen muodon\" tai \"kaksiulotteisen liikkuvan kuvan\" sisältötyypin kanssa."],"fr":["De la couleur peut être présente dans une expression qui a pour type de contenu &laquo;&nbsp;forme cartographique tridimensionnelle&nbsp;&raquo;, &laquo;&nbsp;forme tridimensionnelle&nbsp;&raquo;, &laquo;&nbsp;image animée bidimensionnelle&nbsp;&raquo;, &laquo;&nbsp;image animée tridimensionnelle&nbsp;&raquo;, &laquo;&nbsp;image cartographique&nbsp;&raquo;, &laquo;&nbsp;image cartographique animée&nbsp;&raquo;, &laquo;&nbsp;image fixe&nbsp;&raquo;, &laquo;&nbsp;mouvement exécuté&nbsp;&raquo;, &laquo;&nbsp;mouvement noté&nbsp;&raquo;, &laquo;&nbsp;musique notée&nbsp;&raquo; ou &laquo;&nbsp;texte&nbsp;&raquo;."],"hu":["Olyan kifejezési forma tartalmazhat színt, amelynek a tartalomtípusa \"kartográfiai kép\", \"kartográfiai mozgókép\", \"háromdimenziós kartográfiai forma\", \"mozgásírás\"; \"zenei lejegyzés\", \"előadott mozgás\", \"állókép\", \"szöveg\", \"háromdimenziós mozgókép\", \"háromdimenziós forma\" vagy \"kétdimenziós mozgókép\"."],"lv":["Krāsa var būt izteiksmei, kuras satura veids ir \"kartogrāfisks attēls\", \"kustīgs kartogrāfisks attēls\", \"kartogrāfiska trīsdimensiju forma\", \"kustības pieraksts\", \"notācija\", \"kustības izpildījums\", \"attēls\", \"teksts\", \"trīsdimensiju kustīgs attēls\", \"trīsdimensiju forma\" vai \"divdimensiju kustīgs attēls\"."],"nl":["Kleur kan aanwezig zijn in een expressie met een type content van “cartografisch beeld”, “cartografisch bewegend beeld”, “cartografische driedimensionale vorm”, “bewegingsnotatie”, “muzieknotatie”, “uitgevoerde beweging”, “niet-bewegend beeld”, “tekst”, “driedimensionaal bewegend beeld”, driedimensionale vorm” of \"tweedimensionaal bewegend beeld\"."],"tr":["Renk, \"kartografik görüntü\", \"kartografik hareketli görüntü\", \"kartografik üç boyutlu form\", \"notalı hareket\", \"notalı müzik\", \"icra edilen hareket\", \"sabit görüntü\", \"metin\", \"üç boyutlu hareketli görüntü\", \"üç boyutlu form\" veya \"iki boyutlu hareketli görüntü\" içerik türüne sahip bir ifadede mevcut olabilir."],"zh-Hans-CN":["颜色可以呈现在以下内容类型的内容表达中：“地图图像”、“地图动态图像”、“地图三维形式”、“动作谱”、“乐谱”、“表演动作”、“静态图像”、“文本”、“三维动态图像”、“三维形式”、“二维动态图像”。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/colour.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20573", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/colour.en", "label":"has colour"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20573", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/colour.en", "label":"has colour"}]},{"@id":"http://rdaregistry.info/Elements/e/P20575","label":{"ca":"té expressió derivada","cs":"má odvozené vyjádření","de":"hat Ableitung","en":"has derivative expression","es":"tiene expresión derivativa","fi":"johdannaisekspressio","fr":"a pour expression dérivée","hu":"származtatott kifejezési formája","nl":"heeft afgeleide expressie","tr":"türev anlatım ile ilişkilidir","zh-Hans-CN":"有衍生内容表达"},"definition":{"ca":["Relaciona una expressió amb una expressió que és una modificació d’una altra expressió de la mateixa obra."],"cs":["Vztahuje vyjádření k vyjádření, které je modifikací jiného vyjádření téhož díla."],"de":["Setzt eine Expression in Beziehung zu einem Wort oder einer Phrase, die dazu dient, eine Expression von einer anderen Expression desselben Werks zu unterscheiden."],"en":["Relates an expression to an expression that is a modification of another expression of the same work."],"es":["Relaciona una expresión con una expresión que es una modificación de otra expresión de la misma obra."],"fi":["Liittää ekspression ekspressioon, joka on muunnos saman teoksen toisesta ekspressiosta."],"fr":["Met une expression en relation avec une expression qui consiste en une modification d’une autre expression de la même œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amely ugyanazon mű egy másik kifejezési formájának a módosítása."],"nl":["Relateert een expressie aan een expressie die een aanpassing is van een andere expressie van hetzelfde werk."],"tr":["Bir anlatımı, aynı eserin başka bir anlatımının değiştirilmesi olan bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为同一种作品的另一种内容表达之修改的一种内容表达关联起来。"]},"ToolkitLabel":{"ca":"expressió derivada","cs":"odvozené vyjádření","de":"Abgeleitete Beziehung auf Expressionsebene","en":"derivative expression","es":"expresión derivativa","fi":"johdannaisekspressio","fr":"expression dérivée","hu":"forrás kifejezési forma","nl":"afgeleide expressie","tr":"türetilmiş anlatım","zh-Hans-CN":"衍生内容表达"},"ToolkitDefinition":{"ca":"Expressió que és una modificació d’una altra expressió de la mateixa obra.","cs":"Vyjádření, které je modifikací jiného vyjádření téhož díla.","de":"Ein Wort oder eine Phrase, die dazu dient, eine Expression von einer anderen Expression desselben Werks zu unterscheiden.","en":"An expression that is a modification of another expression of the same work.","es":"Una expresión que es una modificación de otra expresión de la misma obra.","fi":"Ekspressio, joka on muunnos saman teoksen toisesta ekspressiosta.","fr":"Expression qui consiste en une modification d’une autre expression de la même œuvre.","hu":"Egy kifejezési formához, amely ugyanazon mű egy másik kifejezési formájának a módosítása.","nl":"Een expressie die een aanpassing is van een andere expressie van hetzelfde werk.","tr":"Aynı eserin başka bir ifadesinin değiştirilmiş hali olan bir anlatım.","zh-Hans-CN":"作为同一种作品的另一种内容表达之修改的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/derivativeExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"See Also":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20211", "lexicalAlias":"http://rdaregistry.info/Elements/e/revisedAs.en", "label":"is revised as"},{"@id":"http://rdaregistry.info/Elements/e/P20165", "lexicalAlias":"http://rdaregistry.info/Elements/e/arrangedAs.en", "label":"is arranged as"},{"@id":"http://rdaregistry.info/Elements/e/P20171", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatedAs.en", "label":"is translated as"},{"@id":"http://rdaregistry.info/Elements/e/object/P20575", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/derivativeExpression.en", "label":"has derivative expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20575", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/derivativeExpression.en", "label":"has derivative expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20574","label":{"ca":"té expressió font","cs":"má zdrojové vyjádření","de":"hat","en":"has source expression","es":"tiene expresión fuente","fi":"lähde-ekspressio","fr":"a pour expression source","hu":"forrás kifejezési formája","nl":"heeft bronexpressie","tr":"kaynak anlatımı ile ilişkilidir","zh-Hans-CN":"有源内容表达"},"definition":{"ca":["Relaciona una expressió amb una expressió que es modifica per crear una nova expressió de la mateixa obra."],"cs":["Vztahuje vyjádření k vyjádření, které je modifikováno za účelem vytvoření nového vyjádření téhož díla."],"de":["Datum einer Expression ist ein Kernelement, wenn es benötigt wird, um eine Expression eines Werks von einer anderen Expression desselben Werks zu unterscheiden."],"en":["Relates an expression to an expression that is modified to create a new expression of the same work."],"es":["Relaciona una expresión con una expresión que es modificada para crear una nueva expresión de la misma obra."],"fi":["Liittää ekspression ekspressioon, jota on muokattu uuden ekspression luomiseksi samasta teoksesta."],"fr":["Met une expression en relation avec une expression qui est modifiée pour créer une nouvelle expression de la même œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amelyet módosítottak, hogy létrehozzák ugyanannak a műnek egy új kifejezési formáját."],"nl":["Relateert een expressie aan een expressie die is aangepast om een nieuwe expressie van hetzelfde werk te creëren."],"tr":["Bir anlatımı, aynı eserin yeni bir anlatımını oluşturmak için değiştirilen bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与被修改以创建同一种作品的一个新内容表达的一种内容表达关联起来。"]},"ToolkitLabel":{"ca":"expressió font","cs":"zdrojové vyjádření","de":"In Beziehung stehende Expression","en":"source expression","es":"expresión fuente","fi":"lähde-ekspressio","fr":"expression source","hu":"forrás kifejezési forma","nl":"bronexpressie","tr":"kaynak anlatım","zh-Hans-CN":"源内容表达"},"ToolkitDefinition":{"ca":"Expressió que es modifica per crear una nova expressió de la mateixa obra.","cs":"Vyjádření, které je modifikováno za účelem vytvoření nového vyjádření téhož díla.","de":"Ein Rang, der als Bestätigung für wissenschaftliche Leistungen verliehen wird.","en":"An expression that is modified to create a new expression of the same work.","es":"Una expresión que es modificada para crear una nueva expresión de la misma obra.","fi":"Ekspressio, jota on muokattu uuden ekspression luomiseksi samasta teoksesta.","fr":"Expression qui est modifiée pour créer une nouvelle expression de la même œuvre.","hu":"Egy kifejezési formához, amelyet módosítottak, hogy létrehozzák ugyanannak a műnek egy új kifejezési formáját.","nl":"Een expressie die is aangepast om een nieuwe expressie van hetzelfde werk te creëren.","tr":"Aynı eserin yeni bir anlatımını yaratmak için düzenlenen bir anlatım.","zh-Hans-CN":"被修改以创建同一种作品的一个新内容表达的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
