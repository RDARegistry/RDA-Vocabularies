                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/presenterFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20447", "lexicalAlias":"http://rdaregistry.info/Elements/e/presenterCollectiveAgent.en", "label":"has presenter collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20565", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/presenterFamily.en", "label":"has presenter family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20565", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/presenterFamily.en", "label":"has presenter family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20388","label":{"ar":"لها شخص مقدم","ca":"té com a persona presentadora","cs":"má prezentátora (osobu)","da":"har person, som er præsentator","de":"hat Präsentatorin/Präsentator (Person)","de":"hat Präsentatorin/Präsentator (Person)","en":"has presenter person","es":"tiene persona presentadora","et":"esitleja (isik)","fi":"esittämisestä vastaava henkilö","fr":"a pour personne présentatrice","hu":"bemutató személye a következő:","lv":"piedāvātājs (persona)","nl":"heeft presenterende persoon","no":"har person som presenterer","tr":"sunucu kişisi ile ilişkilidir","zh-Hans-CN":"有出品人个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يُتضمَّن في بيان ذي اعتماد \"X presents:\" في تجسيدة تجسد تعبيرة وقد تكون مرتبطة بإنتاج صور متحركة بطريقة ما، أو تمويلها، أو توزيعها."],"ca":["Relaciona una expressió amb una persona que s’inclou en una menció de crèdits en una forma “X presenta:” en una manifestació que materialitza una expressió i que està probablement associada d’alguna manera amb la producció, el finançament o la distribució d’una expressió d’una obra d’imatge en moviment."],"cs":["Vztahuje vyjádření k osobě, která je zahrnutá v údaji X uvádí: v provedení ztělesňujícím vyjádření a která je pravděpodobně nějakým způsobem spojená s výrobou, financováním nebo distribucí vyjádření pohyblivého obrazu (díla)."],"da":["Relaterer et udtryk til en person, som er nævnt i en fortekst i levende billedmaterialer som \"X præsenterer:\", og som sandsynligvis er knyttet til produktion, finansiering eller distribution på en eller anden måde."],"de":["Setzt eine Expression in Beziehung zu einer Person, die in der Angabe \"X präsentiert:\" in einer Manifestation enthalten ist, die eine Expression verkörpert, und die wahrscheinlich in irgendeiner Weise mit der Produktion, der Finanzierung oder dem Vertrieb einer Expression eines Bewegtbildwerks in Verbindung steht.,Setzt eine Expression in Beziehung zu einer Person, die in der Angabe \"X präsentiert:\" in einer Manifestation enthalten ist, die eine Expression verkörpert, und die wahrscheinlich in irgendeiner Weise mit der Produktion, der Finanzierung oder dem Vertrieb einer Expression eines Bewegtbildwerks in Verbindung steht."],"en":["Relates an expression to a person who is included in statement of an \"X presents:\" credit in a manifestation that embodies an expression and who is probably associated with production, finance, or distribution of an expression of a moving image work in some way."],"es":["Relaciona una expresión con una persona que está incluida en una declaración de un crédito \"X presenta:\" en una manifestación que materializa una expresión y que probablemente está asociada con la producción, financiamiento o distribución de una expresión de una obra de imágenes en movimiento de alguna manera."],"et":["Seostab väljenduse isikuga, kes on nimetatud filmi tiitrites vormis \"X esitleb\" ja kes on tõenäoliselt mingil viisil seotud filmi tootmise, rahastamise või levitamisega."],"fi":["Liittää ekspression henkilöön, joka sisältyy merkintään \"X esittää:\" ekspression sisältävän manifestaation alku- tai lopputeksteissä ja joka liittyy todennäköisesti liikkuvan kuvan teoksen ekspression tuotantoon, rahoitukseen tai jakeluun jollakin tavoin."],"fr":["Met une expression en relation avec une personne qui est incluse dans le générique d’une manifestation matérialisant une expression sous la forme &laquo;&nbsp;X présente&nbsp;&raquo; et qui est probablement associée d’une façon quelconque à la production, au financement ou à la distribution d’une expression d’une œuvre d’images animées."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, akit megemlítenek egy megjelenési formában megtestesülő kifejezési forma az \"X bemutatja:\" stáblistaelemében, és aki valószínűleg valamilyen módon egy mozgóképmű kifejezési formájának előállításához, finanszírozásához vagy terjesztéséhez kapcsolódik."],"lv":["Sasaista izteiksmi ar personu, kura minēta kustīgu attēlu materiālu titros frāzē \"X piedāvā:\" un kura, iespējams, ir saistīta ar izgatavošanu, finansēm vai izplatīšanu."],"nl":["Relateert een expressie aan een persoon die opgenomen is in een vermelding van een \"X presenteert:\" creditatie in een manifestatie dat een expressie verwezenlijkt en die waarschijnlijk op één of andere manier geassocieerd is met productie, financiën of distributie van een bewegend beeldwerk."],"no":["Relaterer et uttrykk til en person som er nevnt i rollen \"X presenterer\" for materiale i form av levende bilder, og som sannsynligvis er involvert i produksjon, finansiering eller distribusjon av materialet."],"tr":["Bir anlatımı, bir anlatımı somutlaştıran bir gösterimde \"X sunar:\" şeklinde yer alan ve büyük olasılıkla hareketli görüntü eserinin anlatımının yapımı, finansmanı veya dağıtımı ile bir şekilde bağlantılı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与包括在具体化一种内容表达的一种载体表现的摄制人员名单中以“某某 出品”（X presents）的方式被提及的且与动态图像作品的内容表达的制作、财务或发行等有某些联系的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مقدم","ca":"persona presentadora","cs":"prezentátor (osoba)","da":"person, som er præsentator","de":"Präsentatorin/Präsentator (Person)","de":"Präsentatorin/Präsentator (Person)","en":"presenter person","es":"persona presentadora","et":"esitleja (isik)","fi":"esittämisestä vastaava henkilö","fr":"personne présentatrice","hu":"bemutató személy:","lv":"piedāvātājs (persona)","nl":"presenterende persoon","no":"person som presenterer","tr":"Sunum yapan kişi","zh-Hans-CN":"出品人个人"},"ToolkitDefinition":{"ar":"شخص يُتضمَّن في بيان ذي اعتماد \"X presents:\" في تجسيدة تجسد تعبيرة وقد تكون مرتبطة بإنتاج صور متحركة بطريقة ما، أو تمويلها، أو توزيعها.","ca":"Persona que s’inclou en una menció de crèdits en una forma “X presenta:” en una manifestació que materialitza una expressió i que està probablement associada d’alguna manera amb la producció, el finançament o la distribució d’una expressió d’una obra d’imatge en moviment.","cs":"Osoba, která je zahrnutá v údaji X uvádí: v provedení ztělesňujícím vyjádření a která je pravděpodobně nějakým způsobem spojená s výrobou, financováním nebo distribucí vyjádření pohyblivého obrazu (díla).","da":"Person, som er nævnt i en fortekst i levende billedmaterialer som \"X præsenterer:\", og som sandsynligvis er knyttet til produktion, finansiering eller distribution på en eller anden måde.","de":"Eine Person, die in der Angabe \"X präsentiert:\" in einer Manifestation enthalten ist, die eine Expression verkörpert, und die wahrscheinlich in irgendeiner Weise mit der Produktion, der Finanzierung oder dem Vertrieb einer Expression eines Bewegtbildwerks in Verbindung steht.","de":"Eine Person, die in der Angabe \"X präsentiert:\" in einer Manifestation enthalten ist, die eine Expression verkörpert, und die wahrscheinlich in irgendeiner Weise mit der Produktion, der Finanzierung oder dem Vertrieb einer Expression eines Bewegtbildwerks in Verbindung steht.","en":"A person who is included in statement of an \"X presents:\" credit in a manifestation that embodies an expression and who is probably associated with production, finance, or distribution of an expression of a moving image work in some way.","es":"Una persona que está incluida en una declaración de un crédito \"X presenta:\" en una manifestación que materializa una expresión y que probablemente está asociada con la producción, financiamiento o distribución de una expresión de una obra de imágenes en movimiento de alguna manera.","et":"Isik, kes on nimetatud filmi tiitrites vormis \"X esitleb\" ja kes on tõenäoliselt mingil viisil seotud filmi tootmise, rahastamise või levitamisega.","fi":"Henkilö, joka sisältyy merkintään \"X esittää:\" ekspression sisältävän manifestaation alku- tai lopputeksteissä ja joka liittyy todennäköisesti liikkuvan kuvan teoksen ekspression tuotantoon, rahoitukseen tai jakeluun jollakin tavoin.","fr":"Personne qui est incluse dans le générique d’une manifestation matérialisant une expression sous la forme &laquo;&nbsp;X présente&nbsp;&raquo; et qui est probablement associée d’une façon quelconque à la production, au financement ou à la distribution d’une expression d’une œuvre d’images animées.","hu":"Egy személy, akit megemlítenek egy megjelenési formában megtestesülő kifejezési forma az \"X bemutatja:\" stáblistaelemében, és aki valószínűleg valamilyen módon egy mozgóképmű kifejezési formájának előállításához, finanszírozásához vagy terjesztéséhez kapcsolódik.","lv":"Persona, kura minēta kustīgu attēlu materiālu titros frāzē \"X piedāvā:\" un kura, iespējams, ir saistīta ar izgatavošanu, finansēm vai izplatīšanu.","nl":"Een persoon die opgenomen is in een vermelding van een \"X presenteert:\" creditatie in een manifestatie dat een expressie verwezenlijkt en die waarschijnlijk op één of andere manier geassocieerd is met productie, financiën of distributie van een bewegend beeldwerk.","no":"En person som er nevnt i rollen \"X presenterer\" for materiale i form av levende bilder, og som sannsynligvis er involvert i produksjon, finansiering eller distribusjon av materialet.","tr":"Bir anlatımın gösteriminde yer alan ve muhtemelen bir harekli görüntü eserinin bir anlatımının üretimi, finansmanı veya dağıtımıyla bir şekilde bağlantılı olan 'X sunar:' ibaresine dahil edilen kişi.","zh-Hans-CN":"包括在具体化一种内容表达的一种载体表现的摄制人员名单中以“某某 出品”（X presents）的方式被提及的且与动态图像作品的内容表达的制作、财务或发行等有某些联系的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/presenterPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20351", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en", "label":"has performer person"},{"@id":"http://rdaregistry.info/Elements/e/P20054", "lexicalAlias":"http://rdaregistry.info/Elements/e/presenterAgent.en", "label":"has presenter agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20388", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/presenterPerson.en", "label":"has presenter person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20388", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/presenterPerson.en", "label":"has presenter person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20317","label":{"ar":"لها خط الزوال الأول","ca":"té com a meridià inicial","cs":"má základní poledník","da":"har primær median","de":"hat Nullmeridian","de":"hat Nullmeridian","en":"has prime meridian","es":"tiene meridiano principal","et":"nullmeridiaan","fi":"nollameridiaani","fr":"a pour méridien origine","hu":"kezdő hosszúsági köre a következő:","lv":"nulles meridiāns","nl":"heeft nulmeridiaan","no":"har referansemeridian","tr":"başlangıç meridyeni ile ilişkilidir","zh-Hans-CN":"有本初子午线"},"definition":{"ar":["تربط بين تعبيرة وخط طول ثابت يمر عبر مكان معين على سطح الأرض والأقطاب الأرضية، والتي يقاس منها خط الطول شرقًا وغربًا."],"ca":["Relaciona una expressió amb una línia de longitud constant que passa per un lloc determinat de la superfície de la terra i els pols terrestres, des de la qual es mesura la longitud est i oest."],"cs":["Vztahuje vyjádření k čáře konstantní zeměpisné délky procházející daným místem na zemském povrchu a zemskými póly, z níž se vyměřuje východní a západní délka."],"da":["Relaterer et udtryk til en linje med konstant længdegrad, som passerer gennem et givet sted på jordoverfladen og de terrestriske poler, hvorfra længdegrad øst og vest måles."],"de":["Setzt eine Expression in Beziehung zu einer Linie konstanter Länge, die durch ein bestimmtes Geografikum auf der Erdoberfläche und den Erdpolen verläuft und von der aus die Längengrade Ost und West gemessen werden.,Setzt eine Expression in Beziehung zu einer Linie konstanter Länge, die durch ein bestimmtes Geografkum auf der Erdoberfläche und den Erdpolen verläuft und von der aus die Längengrade Ost und West gemessen werden."],"en":["Relates an expression to a line of constant longitude passing through a given place on the surface of the earth and the terrestrial poles, from which longitude east and west is measured."],"es":["Relaciona una expresión con una línea de longitud constante que pasa por un lugar determinado de la superficie de la tierra y los polos terrestres, desde donde se mide la longitud este y oeste."],"et":["Seostab väljenduse Maa pinna kindlat kohta ja poolusi läbiva püsiva pikkusjoonega, millest mõõdetakse ida ja lääne suunas pikkuskraade."],"fi":["Liittää ekspression pysyvän pituusasteen viivaan, joka kulkee maan pinnalla olevan tietyn paikan ja maapallon napojen läpi, ja josta itäinen ja läntinen pituusaste mitataan."],"fr":["Met une expression en relation avec une ligne de longitude constante passant par un lieu donné à la surface de la terre et par les pôles terrestres, à partir de laquelle la longitude est et ouest est mesurée."],"hu":["Hozzákapcsol egy kifejezési formát ahhoz az állandó hosszúsági körhöz, amely egy adott helyen áthalad a Föld felszínén és a földi pólusokon, és amelytől a keleti és nyugati hosszúsági fokokat mérik."],"lv":["Sasaista izteiksmi ar garuma līniju, kas iet caur noteiktu vietu un sadala Zemi Austrumu puslodē un Rietumu puslodē."],"nl":["Relateert een expressie aan een lijn van constante lengtegraad die een gegeven plaats op het oppervlak van de aarde en de aardse polen doorsnijdt, vanwaar lengtegraad oost en west gemeten wordt."],"no":["Relaterer et uttrykk til en fastsatt lengdesirkel som strekker seg gjennom et gitt sted på overflaten av jorden og jordens poler, som lengdegrad øst og vest måles utfra."],"tr":["Bir anlatımı, doğu ve batı boylamlarının ölçüldüğü, dünya yüzeyinde belirli bir yerden ve karasal kutuplardan geçen sabit bir boylam çizgisiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与穿过地球表面一个指定的地点和地球两极并以此测量东经和西经的一条恒定经线关联起来。"]},"ToolkitLabel":{"ar":"خط الزوال الأول","ca":"meridià inicial","cs":"základní poledník","da":"primær median","de":"Nullmeridian","de":"Nullmeridian","en":"prime meridian","es":"meridiano principal","et":"nullmeridiaan","fi":"nollameridiaani","fr":"méridien origine","hu":"kezdő hosszúsági köre:","lv":"nulles meridiāns","nl":"nulmeridiaan","no":"referansemeridian","tr":"asal meridyen","zh-Hans-CN":"本初子午线"},"ToolkitDefinition":{"ar":"خط طول ثابت يمر عبر مكان معين على سطح الأرض والأقطاب الأرضية، والتي يقاس منها خط الطول شرقًا وغربًا.","ca":"Línia de longitud constant que passa per un lloc determinat de la superfície de la terra i els pols terrestres, des de la qual es mesura la longitud est i oest.","cs":"Čára konstantní zeměpisné délky procházející daným místem na zemském povrchu a zemskými póly, z níž se vyměřuje východní a západní délka.","da":"Linje med konstant længdegrad, som passerer gennem et givet sted på jordoverfladen og de terrestriske poler, hvorfra længdegrad øst og vest måles.","de":"Eine Linie konstanter Länge, die durch ein bestimmtes Geografikum auf der Erdoberfläche und den Erdpolen verläuft und von der aus die Längengrade Ost und West gemessen werden.","de":"Eine Linie konstanter Länge, die durch ein bestimmtes Geografkum auf der Erdoberfläche und den Erdpolen verläuft und von der aus die Längengrade Ost und West gemessen werden.","en":"A line of constant longitude passing through a given place on the surface of the earth and the terrestrial poles, from which longitude east and west is measured.","es":"Una línea de longitud constante que pasa por un lugar determinado de la superficie de la tierra y los polos terrestres, desde donde se mide la longitud este y oeste.","et":"Maa pinna kindlat kohta ja poolusi läbiv püsiv pikkusjoon, millest mõõdetakse ida ja lääne suunas pikkuskraade.","fi":"Pysyvä pituusasteen viiva, joka kulkee maan pinnalla olevan tietyn paikan ja maapallon napojen läpi, ja josta itäinen ja läntinen pituusaste mitataan.","fr":"Ligne de longitude constante passant par un lieu donné à la surface de la terre et par les pôles terrestres, à partir de laquelle la longitude est et ouest est mesurée.","hu":"Azon állandó hosszúsági kör, amely egy adott helyen áthalad a Föld felszínén és a földi pólusokon, és amelytől a keleti és nyugati hosszúsági fokokat mérik.","lv":"Garuma līnija, kas iet caur noteiktu vietu un sadala Zemi Austrumu puslodē un Rietumu puslodē.","nl":"Een lijn van constante lengtegraad die een gegeven plaats op het oppervlak van de aarde en de aardse polen doorsnijdt, vanwaar lengtegraad oost en west gemeten wordt.","no":"En fastsatt lengdesirkel som strekker seg gjennom et gitt sted på overflaten av jorden og jordens poler, som lengdegrad øst og vest måles utfra.","tr":"Dünya yüzeyinde belirli bir yerden ve karasal kutuplardan geçen, doğu ve batı boylamlarının ölçüldüğü sabit boylam çizgisi.","zh-Hans-CN":"穿过地球表面一个指定的地点和地球两极并以此测量东经和西经的一条恒定经线"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/primeMeridian.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20317", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/primeMeridian.en", "label":"has prime meridian"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20317", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/primeMeridian.en", "label":"has prime meridian"}]},{"@id":"http://rdaregistry.info/Elements/e/P20056","label":{"ar":"لها وكيل مصمم إنتاج","ca":"té com a agent dissenyador de producció","cs":"má výrobního designéra (agenta)","da":"har agent, som er produktionsdesigner","de":"hat Szenenbildnerin/Szenenbildner (Akteur)","de":"hat Szenenbildnerin/Szenenbildner (Akteur)","el":"έχει σχεδιαστή παραγωγής","en":"has production designer agent","es":"tiene agente diseñador de producción","et":"kunstnik-lavastaja (tegija)","fi":"lavastussuunnittelija (toimija)","fr":"a pour agent chef décorateur","hu":"látványtervező ágense a következő:","lv":"filmas scenogrāfs (aģents)","nl":"heeft productieontwerper-actor","no":"har produksjonsdesigner (agent)","tr":"yapım tasarımcısı temsilcisi ile ilişkilidir","vi":"có người thiết kế sản phẩm","zh-Hans-CN":"有制作设计者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل مسئول عن تصميم المظهر المرئي العام لإنتاج صور متحركة."],"ca":["Relaciona una expressió amb un agent que és responsable de dissenyar l’aparença visual general d’una producció d’imatge en moviment."],"cs":["Vztahuje vyjádření k agentovi, který je odpovědný za navrhování celkové vizuální podoby výroby pohyblivého obrazu."],"da":["Relaterer et udtryk til en agent, som er ansvarlig for at designe en levende billedproduktions overordnede visuelle udseende."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der für die Gestaltung des gesamten visuellen Erscheinungsbilds einer Bewegtbildproduktion verantwortlich ist.,Setzt eine Expression in Beziehung zu einem Akteur, der für die Gestaltung des gesamten visuellen Erscheinungsbilds einer Bewegtbildproduktion verantwortlich ist."],"el":["Συνδέει μια έκφραση με έναν φορέα υπεύθυνο για τον σχεδιασμό της συνολικής οπτικής εμφάνισης μιας παραγωγής κινητής εικόνας."],"en":["Relates an expression to an agent who is responsible for designing the overall visual appearance of a moving image production."],"es":["Relaciona una expresión con un agente que es responsable de diseñar la apariencia visual general de una producción de imágenes en movimiento."],"et":["Seostab väljenduse tegijaga, kes vastutab liikuvast pildist koosneva produktsiooni visuaalse üldilme kujundamise eest."],"fi":["Liittää ekspression toimijaan, joka vastaa liikkuvan kuvan tuotannon visuaalisen kokonaisilmeen suunnittelusta."],"fr":["Met une expression en relation avec un agent qui est responsable de concevoir l’aspect visuel global d’une production d’images animées."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely felelős egy mozgókép-produkció átfogó vizuális megjelenítésének a tervezéséért."],"lv":["Sasaista izteiksmi ar aģentu, kas ir atbildīgs par kustīgā attēla vispārējā vizuālā izskata producēšanu."],"nl":["Relateert een expressie aan een actor die verantwoordelijk is voor het ontwerpen van het totale visuele uiterlijk van een bewegend beeld-productie."],"no":["Relaterer et uttrykk til en agent som har ansvar for å designe det generelle visuelle uttrykket til en produksjon med levende bilder."],"tr":["Bir anlatımı, hareketli bir görüntü yapımının genel görsel görünümünü tasarlamaktan sorumlu olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân có trách nhiệm về thiết kế diện mạo về thị giác tổng hợp của sản xuất hình ảnh động."],"zh-Hans-CN":["将一种内容表达与对设计动态图像制作整体视觉效果负责的一个行为者关联起来。"]},"ToolkitLa