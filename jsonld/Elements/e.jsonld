                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/reviserCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20507", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCorporateBodyOfExpression.en", "label":"has creator corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20406", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserCollectiveAgent.en", "label":"has reviser collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20475", "lexicalAlias":"http://rdaregistry.info/Elements/e/abridgerCorporateBody.en", "label":"has abridger corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20483", "lexicalAlias":"http://rdaregistry.info/Elements/e/arrangerCorporateBodyOfMusic.en", "label":"has arranger corporate body of music"},{"@id":"http://rdaregistry.info/Elements/e/P20474", "lexicalAlias":"http://rdaregistry.info/Elements/e/censorCorporateBody.en", "label":"has censor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20473", "lexicalAlias":"http://rdaregistry.info/Elements/e/restorationistCorporateBodyOfExpression.en", "label":"has restorationist corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20477", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberCorporateBody.en", "label":"has transcriber corporate body"},{"@id":"http://rdaregistry.info/Elements/e/object/P20465", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/reviserCorporateBody.en", "label":"has reviser corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20465", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/reviserCorporateBody.en", "label":"has reviser corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20524","label":{"ar":"لها عائلة مراجعة","ca":"té com a família revisora","cs":"má korektora (rodinu)","da":"har familie, som er omarbejder af","de":"hat Überarbeiterin/Überarbeiter (Familie)","de":"hat Überarbeiterin/Überarbeiter (Familie)","en":"has reviser family","es":"tiene familia revisora","et":"redigeerija (perekond)","fi":"tarkistaja (suku)","fr":"a pour famille réviseuse","hu":"átdolgozó családja a következő:","lv":"pārskatītājs (dzimta/ģimene)","nl":"heeft herziener-familie","no":"har omarbeider (familie)","tr":"gözden geçiren ailesi ile ilişkilidir","zh-Hans-CN":"有修订者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة من خلال إجراء تغييرات على محتوى تعبيرة أخرى."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió fent canvis en el contingut d’una altra expressió."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že provádí změny v obsahu jiného vyjádření."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at lave ændringer til indholdet af et andet udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie am Inhalt einer anderen Expression Veränderungen vornimmt.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie am Inhalt einer anderen Expression Veränderungen vornimmt."],"en":["Relates an expression to a family who contributes to an expression by making changes to the content of another expression."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al hacer cambios al contenido de otra expresión."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, tehes muudatusi teise väljenduse sisusse."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen tekemällä muutoksia toisen ekspression sisältöön."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en apportant des modifications au contenu d’une autre expression."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely egy másik kifejezési forma tartalmának megváltoztatásával hozzájárul egy kifejezési formához."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, veicot izmaiņas citas izteiksmes saturā."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door wijzigingen te maken in de content van een andere expressie."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å gjøre endringer i innholdet av et annet uttrykk."],"tr":["Bir anlatımı, başka bir anlatımının içeriğinde değişiklik yapan bir temsilcinin katkıda bulunan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过对另一种内容表达的内容作改动而对一种内容表达作出贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مراجعة","ca":"família revisora","cs":"korektor (rodina)","da":"familie, som er omarbejder af","de":"Überarbeiterin/Überarbeiter (Familie)","de":"Überarbeiterin/Überarbeiter (Familie)","en":"reviser family","es":"familia revisora","et":"redigeerija (perekond)","fi":"tarkistaja (suku)","fr":"famille réviseuse","hu":"átdolgozó család:","lv":"pārskatītājs (dzimta/ģimene)","nl":"herziener-familie","no":"omarbeider (familie)","tr":"gözden geçiren aile","zh-Hans-CN":"修订者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة من خلال إجراء تغييرات على محتوى تعبيرة أخرى.","ca":"Família que contribueix a una expressió fent canvis en el contingut d’una altra expressió.","cs":"Rodina, která přispívá k vyjádření tím, že provádí změny v obsahu jiného vyjádření.","da":"Familie, som bidrager til et udtryk ved at lave ændringer til indholdet af et andet udtryk.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie am Inhalt einer anderen Expression Veränderungen vornimmt.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie am Inhalt einer anderen Expression Veränderungen vornimmt.","en":"A family who contributes to an expression by m