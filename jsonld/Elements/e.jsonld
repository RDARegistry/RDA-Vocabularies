                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20484", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToPerformance.en", "label":"has contributor corporate body to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20413", "lexicalAlias":"http://rdaregistry.info/Elements/e/intervieweeCollectiveAgentOfExpression.en", "label":"has interviewee collective agent of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/intervieweeCorporateBodyOfExpression.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20472", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/intervieweeCorporateBodyOfExpression.en", "label":"has interviewee corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20472", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/intervieweeCorporateBodyOfExpression.en", "label":"has interviewee corporate body of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20531","label":{"ar":"لها عائلة محاورة لتعبيرة","ca":"té com a família entrevistada d’una expressió","cs":"má dotazovaného ve vyjádření (rodinu)","da":"har familie, som er interviewperson for udtryk","de":"hat Interviewte/Interviewten einer Expression (Familie)","de":"hat Interviewte/Interviewten einer Expression (Familie)","en":"has interviewee family of expression","es":"tiene familia entrevistada de expresión","et":"väljenduse intervjueeritav (perekond)","fi":"ekspression haastateltava (suku)","fr":"a pour famille interviewée d’une expression","hu":"kifejezési forma interjúalany családja a következő:","lv":"izteiksmē intervēts (dzimta/ģimene)","nl":"heeft geïnterviewde familie van expressie","no":"har intervjuobjekt for uttrykk (familie)",