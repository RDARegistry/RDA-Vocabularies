                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20329", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToPerformance.en", "label":"has contributor agent to performance"}],"See Also":[{"@id":"http://rdaregistry.info/Elements/e/P20013", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenPresenterAgent.en", "label":"has onscreen presenter agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20422", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantCollectiveAgent.en", "label":"has onscreen participant collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20363", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantPerson.en", "label":"has onscreen participant person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20279", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/onscreenParticipantAgent.en", "label":"has onscreen participant agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20279", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/onscreenParticipantAgent.en", "label":"has onscreen participant agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20422","label":{"ar":"لها وكيل جماعي مشارك في برامج على الشاشة","ca":"té com a agent col·lectiu participant en pantalla","cs":"má vystupujícího na obrazovce (kolektivního agenta)","da":"har kollektiv agent, som er programmedvirkende","de":"hat On-Screen-Teilnehmerin/On-Screen-Teilnehmer (Gemeinschaftlicher Akteur)","de":"hat On-Screen-Teilnehmerin/On-Screen-Teilnehmer (Gemeinschaftlicher Akteur)","en":"has onscreen participant collective agent","es":