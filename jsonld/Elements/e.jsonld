                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en", "label":"is adapted as expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsMotionPictureExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20009", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsMotionPictureExpression.en", "label":"is adapted as motion picture expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20009", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsMotionPictureExpression.en", "label":"is adapted as motion picture expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20251","label":{"ar":"لها تعبيرة موسيقى لفيلم سينمائي","ca":"té com a expressió de música de pel·lícula cinematogràfica","cs":"má hudbu ve filmu (vyjádření)","da":"har filmmusikudtryk","de":"hat Filmmusik (Expression)","de":"hat Filmmusik (Expression)","el":"είναι κινηματογραφική μουσική (έκφραση)","en":"has motion picture music expression","es":"tiene expresión musical cinematográfica","et":"filmi muusika (väljendus)","fi":"elokuvamusiikki (ekspressio)","fr":"a pour musique de film (expression)","hu":"mozgókép-zene kifejezési formája a következő:","lv":"izteiksme: kinomūzika","nl":"heeft speelfilmmuziek-expressie","no":"har filmmusikk for spillefilm (uttrykk)","tr":"sinema filmi müziği anlatımı ile ilişkilidir","vi":"là âm nhạc điện ảnh","zh-Hans-CN":"有电影音乐内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل موسيقي يستخدم في فيلم سينمائي."],"ca":["Relaciona una expressió amb una expressió d’una obra musical que s’usa en una pel·lícula cinematogràfica."],"cs":["Vztahuje vyjádření k vyjádření hudebního díla, které je použito ve filmu."],"da":["Relaterer et udtryk til et udtryk af et musikværk, som anvendes i en spillefilm."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks, die in einem Film verwendet wird.,Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks, die in einem Film verwendet wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μουσικού έργου το οποίο χρησιμοποιείται σε μια κινηματογραφική ταινία."],"en":["Relates an expression to an expression of a musical work that is used in a motion picture."],"es":["Relaciona una expresión con una expresión de una obra musical que se utiliza en una película."],"et":["Seostab väljenduse muusikateose väljendusega, mida kasutatakse filmis."],"fi":["Liittää ekspression musiikkiteoksen ekspressioon, jota käytetään elokuvassa."],"fr":["Met une expression en relation avec une expression d’une œuvre musicale qui est utilisée dans un film."],"hu":["Hozzákapcsol egy kifejezési formát egy zenemű kifejezési formájához, amelyet egy filmben használnak."],"lv":["Sasaista izteiksmi ar mūzikas darba izteiksmi, kas izmantota kinofilmā."],"nl":["Relateert een expressie aan een expressie van een muziekwerk dat gebruikt is in een speelfilm."],"no":["Relaterer et uttrykk til et uttrykk av et musikalsk verk brukt i en spillefilm."],"tr":["Bir anlatımı, bir sinema filminde kullanılan bir müzik eserinin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm âm nhạc được sử dụng trong phim điện ảnh."],"zh-Hans-CN":["将一种内容表达与被用于一种电影的一种音乐作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة موسيقى لفيلم سينمائي","ca":"expressió de música de pel·lícula cinematogràfica","cs":"hudba ve filmu (vyjádření)","da":"filmmusikudtryk","de":"Filmmusik (Expression)","de":"Filmmusik (Expression)","el":"κινηματογραφική μουσική (έκφραση)","en":"motion picture music expression","es":"expresión musical cinematográfica","et":"filmi muusika (väljendus)","fi":"elokuvamusiikki (ekspressio)","fr":"musique de film (expression)","hu":"filmzene kifejezési formája:","lv":"izteiksme: kinomūzika","nl":"speelfilmmuziek-expressie","no":"filmmusikk for spillefilm (uttrykk)","tr":"sinema film müziği ifadesi","vi":"âm nhạc điện ảnh","zh-Hans-CN":"电影音乐内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل موسيقي يستخدم في فيلم سينمائي.","ca":"Expressió d’una obra musical que s’usa en una pel·lícula cinematogràfica.","cs":"Vyjádření hudebního díla, které je použito ve filmu.","da":"Udtryk af et musikværk, som anvendes i en spillefilm.","de":"Eine Expression eines Musikwerks, die in einem Film verwendet wird.","de":"Eine Expression eines Musikwerks, die in einem Film verwendet wird.","el":"Μια έκφραση ενός μουσικού έργου το οποίο χρησιμοποιείται σε μια κινηματογραφική ταινία.","en":"An expression of a musical work that is used in a motion picture.","es":"Una expresión de una obra musical que se utiliza en una película.","et":"Muusikateose väljendus, mida kasutatakse filmis.","fi":"Musiikkiteoksen ekspressio, jota käytetään elokuvassa.","fr":"Expression d’une œuvre musicale qui est utilisée dans un film.","hu":"Egy zenemű kifejezési formája, amelyet egy filmben használnak.","lv":"Mūzikas darba izteiksme, kas izmantota kinofilmā.","nl":"Een expressie van een muziekwerk dat gebruikt is in een speelfilm.","no":"Et uttrykk av et musikalsk verk brukt i en spillefilm.","tr":"Bir sinema filminde kullanılan müzik eserinin anlatımı.","vi":"Biểu hiện của tác phẩm âm nhạc được sử dụng trong phim điện ảnh.","zh-Hans-CN":"被用于一种电影的一种音乐作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20243", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicExpression.en", "label":"has music expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureMusicExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20251", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/motionPictureMusicExpression.en", "label":"has motion picture music expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20251", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/motionPictureMusicExpression.en", "label":"has motion picture music expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20027","definition":{"ca":["Relaciona una expressió amb un agent que contribueix a una expressió d’una obra cartogràfica proporcionant mesuraments o relacions dimensionals d’una àrea geogràfica representada."],"da":["Relaterer et udtryk til en agent, der har bidraget til et udtryk af et kartografisk værk ved at tilvejebringe opmålinger eller målestoksforhold til det geografiske område, der er repræsenteret."],"de":["Setzt eine Expression mit einem Akteur, der an der Expression eines kartografischen Werks mitwirkt, indem er Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt, in Beziehung."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός χαρτογραφικού έργου παρέχοντας μετρήσεις ή σχέσεις διαστάσεων για τη γεωγραφική περιοχή που αναπαρίσταται."],"en":["Relates an expression to an agent who contributes to an expression of a cartographic work by providing measurements or dimensional relationships for a geographic area represented. (Deprecated)"],"fi":["Liittää ekspression toimijaan, joka osallistuu karttateoksen ekspression tekemiseen tarjoamalla esitetyn maantieteellisen alueen mitat tai mittasuhteet."],"fr":["Met une expression en relation avec un agent qui contribue à une expression d’une œuvre cartographique en fournissant des mesures ou des relations dimensionnelles pour une aire géographique représentée."],"hu":["Egy kifejezési formát hozzákapcsol egy ágenshez (személyhez, családhoz vagy testülethez), aki/amely egy térképészeti mű kifejezési formájához hozzájárul azzal, hogy mérési adatokat vagy dimenzionális kapcsolatokat ad hozzá egy ábrázolt földrajzi területhez."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện bằng cách cung cấp độ đo hoặc mối quan hệ kích thước cho khu vực địa lý được trình bày."]},"ToolkitLabel":{"ca":"agrimensor","da":"landmåler","de":"Landvermesser","el":"τοπογράφος μηχανικός","en":"surveyor (Deprecated)","es":"topógrafo","fi":"maanmittari","fr":"arpenteur","hu":"földmérő","no":"landmåler","vi":"người vẽ bản đồ địa hình"},"ToolkitDefinition":{"ca":"Agent que contribueix a una expressió d’una obra cartogràfica proporcionant mesuraments o relacions dimensionals d’una àrea geogràfica representada.","da":"Agent, der har bidraget til et udtryk af et kartografisk værk ved at tilvejebringe opmålinger eller målestoksforhold til det geografiske område, der er repræsenteret.","de":"Ein Akteur, der an der Expression eines kartografischen Werks mitwirkt, indem er Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός χαρτογραφικού έργου παρέχοντας μετρήσεις ή σχέσεις διαστάσεων για τη γεωγραφική περιοχή που αναπαρίσταται.","en":"An agent who contributes to an expression of a cartographic work by providing measurements or dimensional relationships for a geographic area represented. (Deprecated)","es":"Una persona, familia o entidad corporativa que contribuye a una expresión de una obra cartográfica proporcionando medidas o relaciones dimensionales para el área geográfica representada.","fi":"Toimija, joka osallistuu karttateoksen ekspression tekemiseen tarjoamalla esitetyn maantieteellisen alueen mitat tai mittasuhteet.","fr":"Agent qui contribue à une expression d’une œuvre cartographique en fournissant des mesures ou des relations dimensionnelles pour une aire géographique représentée.","hu":"Egy ágens (személy, család vagy testület), aki/amely egy térképészeti mű kifejezési formájához hozzájárul azzal, hogy az ábrázolt földrajzi területhez méretarányokat vagy dimenzionális kapcsolatokat ad hozzá.","no":"En agent som bidrar til et uttrykk av et kartografisk verk ved å tilføre målinger eller størrelsesforhold for det geografiske området som gjengis.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bản đồ bằng cách cung cấp độ đo hoặc mối quan hệ kích thước cho khu vực địa lý được trình bày."},"label":{"ca":"té com a agrimensor","da":"har landmåler","de":"hat Landvermesser","el":"έχει τοπογράφο μηχανικό","en":"has surveyor (Deprecated)","fi":"maanmittari","fr":"a pour arpenteur","hu":"van földmérője","vi":"cóngười vẽ bản đồ địa hình"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/surveyor.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20578", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorToAggregatedContent.en", "label":"has contributor to aggregated content (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20027", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/surveyor.en", "label":"has surveyor (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20027", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/surveyor.en", "label":"has surveyor (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20171","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يترجم تعبيرة أخرى لعمل."],"ca":["Relaciona una expressió amb una expressió la llengua de la qual és una modificació d’una altra expressió de la mateixa obra."],"cs":["Vztahuje vyjádření k vyjádření, jehož jazyk je modifikací jiného vyjádření téhož díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som oversætter teksten på et andet udtryk af et værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Text einer anderen Expression eines Werks übersetzt.,Setzt eine Expression in Beziehung zu einem Wort oder einer Phrase, die dazu dient, eine Expression von einer anderen Expression desselben Werks zu unterscheiden."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου, το οποίο μεταφράζει το κείμενο μιας έκφρασης-πηγής σε μια γλώσσα διαφορετική από εκείνη του πρωτότυπου έργου."],"en":["Relates an expression to an expression whose language is a modification of another expression of the same work."],"es":["Relaciona una expresión con una expresión cuyo lenguaje es una modificación de otra expresión de la misma obra."],"et":["Seostab väljenduse teose väljendusega, milles allikväljenduse tekst on tõlgitud teise keelde kui originaalteos."],"fi":["Liittää ekspression teoksen ekspressioon, joka kääntää teoksen toisen ekspression tekstin."],"fr":["Met une expression en relation avec une expression dont la langue est une modification d’une autre expression de la même œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy mű másik kifejezési formájának szövegét fordítja."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas pārtulko avota izteiksmes tekstu valodā, kas atšķiras no oriģināldarba valodas."],"nl":["Relateert een expressie aan een expressie wiens taal een aanpassing is van een andere expressie van hetzelfde werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som oversetter teksten fra et kildeuttrykk til et annet språk enn i originalverket."],"tr":["Bir anlatımı, dili aynı çalışmanın başka bir anlatımının değiştirilmesi olan bir anlatımla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm dịch văn bản của biểu hiện nguồn sang ngôn ngữ khác với ngôn ngữ của tác phẩm nguyên gốc."],"zh-Hans-CN":["将一种内容表达与其语言为同一种作品的另一种内容表达的修改的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مترجمة كـ","ca":"traduït com","cs":"přeloženo jako","da":"oversat som","de":"übersetzt als","de":"übersetzt als","el":"μεταφρασμένη ως","en":"translated as","es":"traducido como","et":"tõlge","fi":"käännös","fr":"traduit comme","hu":"fordítva a következőként:","lv":"tulkojums","nl":"vertaald als","no":"oversatt som","tr":"çevirme","vi":"được dịch như là","zh-Hans-CN":"被翻译为"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يترجم نص تعبيرة أخرى لعمل.","ca":"Expressió la llengua de la qual és una modificació d’una altra expressió de la mateixa obra.","cs":"Vyjádření, jehož jazyk je modifikací jiného vyjádření téhož díla.","da":"Udtryk af et værk, som oversætter teksten på et andet udtryk af et værk.","de":"Eine Expression eines Werks, die den Text einer anderen Expression eines Werks übersetzt.","de":"Ein Wort oder eine Phrase, die dazu dient, eine Expression von einer anderen Expression desselben Werks zu unterscheiden.","el":"Μια έκφραση ενός έργου το οποίο μεταφράζει το κείμενο μιας έκφρασης-πηγής σε μια γλώσσα διαφορετική από εκείνη του πρωτότυπου έργου.","en":"An expression whose language is a modification of another expression of the same work.","es":"Una expresión cuyo lenguaje es una modificación de otra expresión de la misma obra.","et":"Teose väljendus, milles allikväljenduse tekst on tõlgitud teise keelde kui originaalteos.","fi":"Teoksen ekspressio, joka kääntää teoksen toisen ekspression tekstin.","fr":"Expression dont la langue est une modification d’une autre expression de la même œuvre.","hu":"Egy mű kifejezési formája, amely egy forráskifejezés szövegét lefordítja az eredeti mű nyelvétől különböző nyelvre.","lv":"Darba izteiksme, kas pārtulko avota izteiksmes tekstu valodā, kas atšķiras no oriģināldarba valodas.","nl":"Een expressie wiens taal een aanpassing is van een andere expressie van hetzelfde werk.","no":"Et uttrykk av et verk som oversetter teksten fra et kildeuttrykk til et annet språk enn i originalverket.","tr":"Aynı eserin başka bir anlatımının dilinin değiştirilmiş hali olan bir anlatım.","vi":"Biểu hiện của tác phẩm dịch văn bản của biểu hiện nguồn sang ngôn ngữ khác với ngôn ngữ của tác phẩm nguyên gốc.","zh-Hans-CN":"其语言为同一种作品的另一种内容表达的修改的一种内容表达"},"label":{"ar":"هي مترجمة كـ","ca":"és traduït com","cs":"je přeloženo jako","da":"er oversat som","de":"ist übersetzt als","de":"ist übersetzt als","el":"είναι μεταφρασμένη ως","en":"is translated as","es":"se traduce como","et":"tõlge","fi":"käännös","fr":"est traduit comme","hu":"fordítva a következőként:","lv":"ir tulkojums","nl":"is vertaald als","no":"er oversatt som","tr":"olarak tercüme edilir","vi":"được dịch như là","zh-Hans-CN":"被翻译为"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/translatedAs.en","instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20575", "lexicalAlias":"http://rdaregistry.info/Elements/e/derivativeExpression.en", "label":"has derivative expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20079", "lexicalAlias":"http://rdaregistry.info/Elements/e/dubbedVersion.en", "label":"has dubbed version"},{"@id":"http://rdaregistry.info/Elements/e/object/P20171", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/translatedAs.en", "label":"is translated as"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20171", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/translatedAs.en", "label":"is translated as"}]},{"@id":"http://rdaregistry.info/Elements/e/P20141","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مترجم؛ أي النص المعبر عنه بلغة مختلفة عن لغة العمل الأصلي."],"ca":["Relaciona una expressió amb una expressió la llengua de la qual es modifica per crear una nova expressió que és diferent d’una altra expressió de la mateixa obra."],"cs":["Vztahuje vyjádření k vyjádření, jehož jazyk je modifikován za účelem vytvoření nového vyjádření, které je odlišné od jiného vyjádření téhož díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som er oversat, dvs. teksten er udtrykt i et andet sprog end det, som er anvendt i det originale værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die übersetzt wurde. Das heißt, dass der Text in einer Sprache ausgedrückt wird, die sich von der des Originalwerks unterscheidet.,Setzt eine Expression in Beziehung zu einer Expression eines Romans, die nach einer Expression eines anderen Werks bearbeitet wurde."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει μεταφραστεί, δηλαδή το κείμενο εκφράζεται σε μια γλώσσα διαφορετική από εκείνη του πρωτότυπου έργου."],"en":["Relates an expression to an expression whose language is modified to create a new expression that is different from another expression of the same work."],"es":["Relaciona una expresión con una expresión cuyo lenguaje se modifica para crear una nueva expresión que es diferente de otra expresión de la misma obra."],"et":["Seostab väljenduse teose väljendusega, mis on tõlgitud, s.t tekst on väljendatud teises keeles kui originaalteos."],"fi":["Liittää ekspression teoksen ekspressioon, joka on käännetty, eli teksti on ilmaistu alkuperäisteoksesta poikkeavalla kielellä."],"fr":["Met une expression en relation avec une expression dont la langue est modifiée pour créer une nouvelle expression qui est différente d’une autre expression de la même œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet lefordítottak, azaz a nyelvben kifejezett szöveg különbözik egy eredeti mű nyelvétől."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir tulkota, t.i., teksts izteikts valodā, kas atšķiras no oriģināldarba valodas."],"nl":["Relateert een expressie aan een expressie wiens taal is aangepast om een nieuwe expressie te creëren die verschilt van een andere expressie van hetzelfde werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er oversatt, dvs. at teksten uttrykkes på et annet språk enn i originalverket."],"tr":["Bir anlatımı, aynı eserin başka bir anlatımından farklı yeni bir anlatım oluşturmak için dili değiştirilen bir anlatımla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được dịch, nhĩa là, văn bản được thể hiện trong ngôn ngữ khác với ngôn ngữ của tác phẩm nguyên gốc."],"zh-Hans-CN":["将一种内容表达与其语言被修改而创建不同于同一种作品的另一种内容表达的一种新的内容表达的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"ترجمة لـ","ca":"traducció de","cs":"překlad (čeho)","da":"oversættelse af","de":"Übersetzung von","de":"Übersetzung von","el":"μετάφραση της","en":"translation of","es":"traducción de","et":"tõlke alus","fi":"käännöksen perusta","fr":"traduction de","hu":"fordítása:","lv":"ir tulkojums","nl":"vertaling van","no":"oversettelse av","tr":"çeviri","vi":"dịch của","zh-Hans-CN":"……的翻译"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مترجم؛ أي النص المعبر عنه بلغة مختلفة عن لغة العمل الأصلي.","ca":"Expressió la llengua de la qual es modifica per crear una nova expressió que és diferent d’una altra expressió de la mateixa obra.","cs":"Vyjádření, jehož jazyk je modifikován za účelem vytvoření nového vyjádření, které je odlišné od jiného vyjádření téhož díla.","da":"Udtryk af et værk, som er oversat, dvs. teksten er udtrykt i et andet sprog end det, som er anvendt i det originale værk.","de":"Eine Expression eines Werks, die übersetzt wurde. Das heißt, dass der Text in einer Sprache ausgedrückt wird, die sich von der des Originalwerks unterscheidet.","de":"Datum einer Expression ist ein Kernelement, wenn es benötigt wird, um eine Expression eines Werks von einer anderen Expression desselben Werks zu unterscheiden.","el":"Μια έκφραση ενός έργου το οποίο έχει μεταφραστεί, δηλαδή το κείμενο εκφράζεται σε μια γλώσσα διαφορετική από εκείνη του πρωτότυπου έργου.","en":"An expression whose language is modified to create a new expression that is different from another expression of the same work.","es":"Una expresión cuyo lenguaje se modifica para crear una nueva expresión que es diferente de otra expresión de la misma obra.","et":"Teose väljendus, mis on tõlgitud, s.t tekst on väljendatud teises keeles kui originaalteos.","fi":"Teoksen ekspressio, joka on käännetty, eli teksti on ilmaistu alkuperäisteoksesta poikkeavalla kielellä.","fr":"Expression dont la langue est modifiée pour créer une nouvelle expression qui est différente d’une autre expression de la même œuvre.","hu":"Egy mű kifejezési formája, amelyet lefordítottak, azaz a nyelvben kifejezett szöveg különbözik egy eredeti mű nyelvétől.","lv":"Darba izteiksme, kas ir tulkota, t.i., teksts izteikts valodā, kas atšķiras no oriģināldarba valodas.","nl":"Een expressie wiens taal is aangepast om een nieuwe expressie te creëren die verschilt van een andere expressie van hetzelfde werk.","no":"Et uttrykk av et verk som er oversatt, dvs. at teksten uttrykkes på et annet språk enn i originalverket.","tr":"Aynı eserin başka bir anlatımından farklı yeni bir anlatım yaratmak için dili değiştirilmiş bir anlatım.","vi":"Biểu hiện của tác phẩm được dịch, nhĩa là, văn bản được thể hiện trong ngôn ngữ khác với ngôn ngữ của tác phẩm nguyên gốc.","zh-Hans-CN":"其语言被修改而创建不同于同一种作品的另一种内容表达的一种新的内容表达的一种内容表达"},"label":{"ar":"هي ترجمة لـ","ca":"és traducció de","cs":"je překladem (čeho)","da":"er oversættelse af","de":"ist Übersetzung von","de":"ist Übersetzung von","el":"είναι μετάφραση της","en":"is translation of","es":"es la traducción de","et":"tõlke alus","fi":"käännöksen perusta","fr":"est une traduction de","hu":"fordítása a következőnek:","lv":"ir tulkojums","nl":"is vertaling van","no":"er oversettelse av","tr":"tercümesidir","vi":"là dịch của","zh-Hans-CN":"是……的翻译"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/translationOf.en","instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20574", "lexicalAlias":"http://rdaregistry.info/Elements/e/sourceExpression.en", "label":"has source expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20078", "lexicalAlias":"http://rdaregistry.info/Elements/e/dubbedVersionOf.en", "label":"is dubbed version of"},{"@id":"http://rdaregistry.info/Elements/e/object/P20141", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/translationOf.en", "label":"is translation of"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20141", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/translationOf.en", "label":"is translation of"}]},{"@id":"http://rdaregistry.info/Elements/e/P20065","definition":{"ar":["تربط بين تعبيرة ومجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى لغوي مكتوب لتعبيرة."],"ca":["Relaciona una expressió amb un conjunt de caràcters o de símbols usat per expressar el contingut lingüístic escrit d’una expressió."],"cs":["Vztahuje vyjádření k souboru znaků nebo symbolů, používaných k vyjadřování psaného jazykového obsahu vyjádření."],"da":["Relaterer et udtryk til et sæt af tegn eller symboler, som anvendes til at udtrykke det skrevne sprogindhold af et udtryk."],"de":["Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το γραπτό γλωσσικό περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to a set of characters or symbols used to express written language content of an expression."],"es":["Relaciona una expresión con un conjunto de caracteres o símbolos utilizados para expresar en lenguaje escrito el contenido de una expresión."],"et":["Seostab väljenduse märkide või sümbolite kogumiga, mida on kasutatud väljenduse kirjutatud keeles sisu väljendamiseks."],"fi":["Liittää ekspression joukkoon merkkejä tai symboleja, joita käytetään ekspression kirjoitetun kielellisen sisällön ilmaisemiseen."],"fr":["Met une expression en relation avec un ensemble de caractères ou de symboles utilisé pour exprimer un contenu linguistique écrit d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát karakterek vagy szimbólumok egy csoportjához, amelyet arra használnak, hogy egy kifejezési forma nyelvi tartalmát kifejezze."],"lv":["Sasaista izteiksmi ar rakstzīmju un/vai simbolu kopumu, ko lieto, lai izteiktu izteiksmes saturu rakstiski."],"nl":["Relateert een expressie aan een verzameling van karakters of symbolen gebruikt om geschreven taalcontent van een expressie uit te drukken."],"no":["Relaterer et uttrykk til et sett av tegn eller symboler som brukes til å uttrykke det skrevne språkinnholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın yazılı dil içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung ngôn ngữ viết của biểu hiện."],"zh-Hans-CN":["将一种内容表达与用于表达一种内容表达的书写语言内容的字符或符号的集合关联起来。"]},"ToolkitLabel":{"ar":"سيناريو","ca":"escriptura","cs":"písmo","da":"manuskript","de":"Schrift","de":"Schrift","el":"γραφή","en":"script","es":"guion","et":"kirjasüsteem","fi":"kirjoitusjärjestelmä","fr":"écriture","hu":"írásrendszere:","lv":"raksts","nl":"schrift","no":"skriftsystem","tr":"senaryo","vi":"hệ thống viết","zh-Hans-CN":"文字"},"ToolkitDefinition":{"ar":"مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى لغوي مكتوب لتعبيرة.","ca":"Conjunt de caràcters o de símbols usat per expressar el contingut lingüístic escrit d’una expressió.","cs":"Soubor znaků nebo symbolů, používaných k vyjadřování psaného jazykového obsahu vyjádření.","da":"Sæt af tegn eller symboler, som anvendes til at udtrykke det skrevne sprogindhold af et udtryk.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken.","el":"Ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το γραπτό γλωσσικό περιεχόμενο μιας έκφρασης.","en":"A set of characters or symbols used to express written language content of an expression.","es":"Conjunto de caracteres o símbolos utilizados para expresar el contenido del lenguaje escrito de una expresión.","et":"Märkide või sümbolite kogum, mida on kasutatud väljenduse kirjutatud keeles sisu väljendamiseks.","fi":"Joukko merkkejä tai symboleja, joita käytetään ekspression kirjoitetun kielellisen sisällön ilmaisemiseen.","fr":"Ensemble de caractères ou de symboles utilisé pour exprimer un contenu linguistique écrit d’une expression.","hu":"Karakterek vagy szimbólumok egy csoportja, amelyet arra használnak, hogy egy kifejezési forma nyelvi tartalmát kifejezze.","lv":"Rakstzīmju un/vai simbolu kopums, ko lieto, lai izteiktu izteiksmes saturu rakstiski.","nl":"Een verzameling van karakters of symbolen gebruikt om geschreven taalcontent van een expressie uit te drukken.","no":"Et sett av tegn eller symboler som brukes til å uttrykke det skrevne språkinnholdet i et uttrykk.","tr":"Bir anlatımın yazılı dil içeriğini ifade etmek için kullanılan karakterler veya semboller kümesi.","vi":"Chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung ngôn ngữ viết của biểu hiện.","zh-Hans-CN":"用于表达一种内容表达的书写语言内容的字符或符号的集合"},"label":{"ar":"لها سيناريو","ca":"té com a escriptura","cs":"má písmo","da":"har manuskript","de":"hat Schrift","de":"hat Schrift","el":"έχει γραφή","en":"has script","es":"tiene guion","et":"kirjasüsteem","fi":"kirjoitusjärjestelmä","fr":"a pour écriture","hu":"írásrendszere a következő:","lv":"raksts","nl":"heeft schrift","no":"har skriftsystem","tr":"yazı sistemi ile ilişkilidir","vi":"có hệ thống viết","zh-Hans-CN":"有文字"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20062", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotation.en", "label":"has form of notation"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/script.en","instructionNumber":"7.13.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20065", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/script.en", "label":"has script"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20065", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/script.en", "label":"has script"}]},{"@id":"http://rdaregistry.info/Elements/e/P20173","label":{"ar":"هي سيناريو لتعبيرة فيلم سينمائي","ca":"és expressió de guió per a pel·lícula cinematogràfica","cs":"je scénářem pro film (vyjádření)","da":"er manuskript til filmudtryk","de":"ist Drehbuch für Film (Expression)","de":"ist Drehbuch für Film (Expression)","el":"είναι σενάριο για κινηματογραφική ταινία (έκφραση)","en":"is screenplay for motion picture expression","es":"es un guión para la expresión cinematográfica","et":"stsenaarium filmiteose väljendusele","fi":"käsikirjoitus elokuvaan (ekspressio)","fr":"est un scénario pour un film (expression)","hu":"forgatókönyv mozgókép a következő kifejezési formához:","lv":"ir kinoscenārijs izteiksmei","nl":"is scenario voor speelfilm-expressie","no":"er manus for spillefilm (uttrykk)","tr":"sinema filmi anlatımı için senaryodur","vi":"là kịch bản cho biểu hiện điện ảnh (biểu hiện)","zh-Hans-CN":"是电影内容表达的剧本"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم نصًّا كسيناريو لفيلم سينمائي."],"ca":["Relaciona una expressió amb una expressió d’una obra que usa el text com un guió d’una pel·lícula cinematogràfica."],"cs":["Vztahuje vyjádření k vyjádření díla, které využívá text jako scénář pro film."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvender teksten som manuskript til en spillefilm."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Text als Drehbuch für einen Film verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Text als Drehbuch für einen Film verwendet."],"el":["Συνδέει μια έκφραση ενός έργου το οποίο χρησιμοποιεί το κείμενο ως σενάριο για μια κινηματογραφική ταινία."],"en":["Relates an expression to an expression of a work that uses the text as a screenplay for a motion picture."],"es":["Relaciona una expresión con una expresión de una obra que utiliza el texto como guión de una película"],"et":["Seostab väljenduse teose väljendusega, milles kasutatakse teksti filmi stsenaariumina."],"fi":["Liittää ekspression teoksen ekspressioon, joka käyttää tekstiä elokuvan käsikirjoituksena."],"fr":["Met une expression en relation avec une expression d’une œuvre qui utilise le texte comme scénario d’un film."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely a szöveget egy mozgókép forgatókönyveként használja."],"lv":["Sasaista izteiksmi ar darba izteiksmi - kinofilma, kurā izmantots teksts kā scenārijs."],"nl":["Relateert een expressie aan een expressie van een werk dat de tekst gebruikt als een scenario voor een speelfilm."],"no":["Relaterer et uttrykk til et uttrykk av et verk som bruker teksten som manuskript for en spillefilm."],"tr":["Bir anlatımı, metni bir sinema filmi için senaryo olarak kullanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sử dụng văn bản như là kịch bản cho phim điện ảnh."],"zh-Hans-CN":["将一种内容表达与使用电影剧本的文本的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"سيناريو لتعبيرة فيلم سينمائي","ca":"expressió de guió per a pel·lícula cinematogràfica","cs":"scénář pro film (vyjádření)","da":"manuskript til filmudtryk","de":"Drehbuch für Film (Expression)","de":"Drehbuch für Film (Expression)","el":"σενάριο για κινηματογραφική ταινία (έκφραση)","en":"screenplay for motion picture expression","es":"guión para expresión cinematográfica","et":"stsenaarium filmiteose väljendusele","fi":"käsikirjoitus elokuvaan (ekspressio)","fr":"scénario pour un film (expression)","hu":"forgatókönyv mozgókép kifejezési formájához:","lv":"kinoscenārijs izteiksmei","nl":"scenario voor speelfilm-expressie","no":"manus for spillefilm (uttrykk)","tr":"sinema filmi anlatımı için senaryo","vi":"kịch bản cho biểu hiện điện ảnh (biểu hiện)","zh-Hans-CN":"电影内容表达的剧本"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم نص كسيناريو لفيلم سينمائي.","ca":"Expressió d’una obra que usa el text com un guió d’una pel·lícula cinematogràfica.","cs":"Vyjádření díla, které využívá text jako scénář pro film.","da":"Udtryk af et værk, som anvender teksten som manuskript til en spillefilm.","de":"Eine Expression eines Werks, die den Text als Drehbuch für einen Film verwendet.","de":"Eine Expression eines Werks, die den Text als Drehbuch für einen Film verwendet.","el":"Μια έκφραση ενός έργου το οποίο χρησιμοποιεί το κείμενο ως σενάριο για μια κινηματογραφική ταινία.","en":"An expression of a work that uses the text as a screenplay for a motion picture.","es":"Una expresión de una obra que utiliza el texto como guión de una película","et":"Teose väljendus, milles kasutatakse teksti filmi stsenaariumina.","fi":"Teoksen ekspressio, joka käyttää tekstiä elokuvan käsikirjoituksena.","fr":"Expression d’une œuvre qui utilise le texte comme scénario d’un film.","hu":"Egy mű kifejezési formája, amely a szöveget egy mozgókép forgatókönyveként használja.","lv":"Darba izteiksme - kinofilma, kurā izmantots teksts kā scenārijs.","nl":"Een expressie van een werk dat de tekst gebruikt als een scenario voor een speelfilm.","no":"Et uttrykk av et verk som bruker teksten som manuskript for en spillefilm.","tr":"Metni bir sinema filmi için senaryo olarak kullanan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sử dụng văn bản như là kịch bản cho phim điện ảnh.","zh-Hans-CN":"使用电影剧本的文本的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20102", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForExpression.en", "label":"is screenplay for expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForMotionPictureExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20173", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/screenplayForMotionPictureExpression.en", "label":"is screenplay for motion picture expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20173", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/screenplayForMotionPictureExpression.en", "label":"is screenplay for motion picture expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20157","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يقدم نصًا لفيلم سينمائي، أو برنامج تليفزيوني، أو فيديو."],"ca":["Relaciona una expressió amb una expressió d’una obra que proporciona el text d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo."],"cs":["Vztahuje vyjádření k vyjádření díla, které poskytuje text pro film, televizní program nebo video."],"da":["Relaterer et udtryk til et udtryk af et værk, som angiver tekst til en spillefilm, tv-program eller video."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für einen Film, eine Fernsehsendung oder ein Video liefert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für einen Film, eine Fernsehsendung oder ein Video liefert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο παρέχει κείμενο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο."],"en":["Relates an expression to an expression of a work that provides text for a motion picture, television program or video."],"es":["Relaciona una expresión con una expresión de una obra que proporciona texto para una película, programa de televisión o vídeo."],"et":["Seostab väljenduse teose väljendusega, mis annab teksti filmile, telesaatele või videofilmile."],"fi":["Liittää ekspression teoksen ekspressioon, joka on elokuvan, televisio-ohjelman tai videon käsikirjoitus."],"fr":["Met une expression en relation avec une expression d’une œuvre qui fournit un texte pour un film, une émission de télévision ou une vidéo."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet egy mozgókép, tévéműsor vagy videó forgatókönyveként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas nodrošina tekstu kinofilmai, televīzijas raidījumam vai video."],"nl":["Relateert een expressie aan een expressie van een werk dat tekst levert voor een speelfilm, televisieprogramma of video."],"no":["Relaterer et uttrykk til et uttrykk av et verk som tilfører tekst til en spillefilm, et fjernsynsprogram eller en video."],"tr":["Bir anlatımı, bir sinema filmi, televizyon programı veya video için metin sağlayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm cung cấp văn bản cho phim điện ảnh, chương trình truyền hình hoặc video."],"zh-Hans-CN":["将一种内容表达与为一种电影、电视节目或视频提供文本的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"سيناريو لتعبيرة","ca":"expressió de guió","cs":"scénář (vyjádření)","da":"manuskriptudtryk","de":"Drehbuch (Expression)","de":"Drehbuch (Expression)","el":"σενάριο (έκφραση)","en":"screenplay expression","es":"expresión del guión","et":"stsenaarium (väljendus)","fi":"käsikirjoitus (ekspressio)","fr":"scénario (expression)","hu":"forgatókönyv kifejezési formája:","lv":"izteiksme: scenārijs","nl":"scenario-expressie","no":"filmmanus (uttrykk)","tr":"senaryo anlatımı","vi":"kịch bản (biểu hiện)","zh-Hans-CN":"影视剧剧本内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يقدم نصًا لفيلم سينمائي، أو برنامج تليفزيوني، أو فيديو.","ca":"Expressió d’una obra que proporciona el text d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo.","cs":"Vyjádření díla, které poskytuje text pro film, televizní program nebo video.","da":"Udtryk af et værk, som angiver tekst til en spillefilm, tv-program eller video.","de":"Eine Expression eines Werks, die Text für einen Film, eine Fernsehsendung oder ein Video liefert.","de":"Eine Expression eines Werks, die Text für einen Film, eine Fernsehsendung oder ein Video liefert.","el":"Μια έκφραση ενός έργου το οποίο παρέχει κείμενο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο.","en":"An expression of a work that provides text for a motion picture, television program or video.","es":"Una expresión de una obra que proporciona texto para una película, programa de televisión o vídeo.","et":"Teose väljendus, mis annab teksti filmile, telesaatele või videofilmile.","fi":"Teoksen ekspressio, joka on elokuvan, televisio-ohjelman tai videon käsikirjoitus.","fr":"Expression d’une œuvre qui fournit un texte pour un film, une émission de télévision ou une vidéo.","hu":"Egy mű kifejezési formája, amelyet egy mozgókép, tévéműsor vagy videó forgatókönyveként adaptáltak.","lv":"Darba izteiksme, kas nodrošina tekstu kinofilmai, televīzijas raidījumam vai video.","nl":"Een expressie van een werk dat tekst levert voor een speelfilm, televisieprogramma of video.","no":"Et uttrykk av et verk som tilfører tekst til en spillefilm, et fjernsynsprogram eller en video.","tr":"Bir sinema filmi, televizyon programı veya video için metin sağlayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm cung cấp văn bản cho phim điện ảnh, chương trình truyền hình hoặc video.","zh-Hans-CN":"为一种电影、电视节目或视频提供文本的一种作品的一种内容表达"},"label":{"ar":"لها تعبيرة سيناريو","ca":"té com a expressió de guió","cs":"má scénář (vyjádření)","da":"har manuskriptudtryk","de":"hat Drehbuch (Expression)","de":"hat Drehbuch (Expression)","el":"είναι σενάριο (έκφραση)","en":"has screenplay expression","es":"tiene expresión de guión","et":"stsenaarium (väljendus)","fi":"käsikirjoitus (ekspressio)","fr":"a pour scénario (expression)","hu":"forgatókönyv kifejezési formája a következő:","lv":"izteiksme: scenārijs","nl":"heeft scenario-expressie","no":"har filmmanus (uttrykk)","tr":"senaryo anlatımı ile ilişkilidir","vi":"là kịch bản (biểu hiện)","zh-Hans-CN":"有影视剧剧本内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20158", "lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureScreenplayExpression.en", "label":"has motion picture screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/P20161", "lexicalAlias":"http://rdaregistry.info/Elements/e/televisionScreenplayExpression.en", "label":"has television screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/P20162", "lexicalAlias":"http://rdaregistry.info/Elements/e/videoScreenplayExpression.en", "label":"has video screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20157", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/screenplayExpression.en", "label":"has screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20157", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/screenplayExpression.en", "label":"has screenplay expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20102","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مثل فيلم سينمائي، أو برنامج تليفزيوني، أو فيديو يستخدم نص عمل كسيناريو."],"ca":["Relaciona una expressió amb una expressió d’una obra com ara una pel·lícula cinematogràfica, un programa de televisió o un vídeo, que usa el text d’una obra com a guió."],"cs":["Vztahuje vyjádření k vyjádření díla jako je film, televizní program nebo video, které využívá text díla jako scénář."],"da":["Relaterer et udtryk til et udtryk af et værk, såsom en spillefilm, skuespil, tv-program eller video, som anvender værkets tekst som manuskript."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, wie zum Beispiel ein Film, eine Fernsehsendung oder ein Video, die den Text eines Werks als Drehbuch verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, wie zum Beispiel ein Film, eine Fernsehsendung oder ein Video, die den Text eines Werks als Drehbuch verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου, όπως μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο, το οποίο χρησιμοποιεί το κείμενο ενός έργου ως σενάριο."],"en":["Relates an expression to an expression of a work such as a motion picture, television program, or video, that uses the text of a work as a screenplay."],"es":["Relaciona una expresión con la expresión de una obra, como una película, un programa de televisión o un vídeo, que utiliza el texto de una obra como guión."],"et":["Seostab väljenduse teose väljendusega, nt filmi, telesaate või videofilmiga, milles on kasutatud stsenaariumina teose teksti."],"fi":["Liittää ekspression teoksen, kuten elokuvan, televisio-ohjelman tai videon, ekspressioon, joka käyttää teoksen tekstiä käsikirjoituksena."],"fr":["Met une expression en relation avec une expression d’une œuvre telle qu’un film, une émission de télévision ou une vidéo qui utilise le texte d’une œuvre comme scénario."],"hu":["Hozzákapcsol egy kifejezési formát egy olyan mű, mint például egy film, tévéműsor, vagy videó, kifejezési formája, amely egy mű szövegét forgatókönyvként használja."],"lv":["Sasaista izteiksmi ar darba izteiksmi - kinofilma, televīzijas raidījums vai video, kurā izmantots pamatdarba teksts kā scenārijs."],"nl":["Relateert een expressie aan een expressie van een werk zoals een een speelfilm, televisieprogramma of video dat de tekst van een werk als scenario gebruikt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som en spillefilm, et fjernsynsprogram eller en video, som bruker tekst fra et verk som manuskript."],"tr":["Bir anlatımı, bir eserin metnini senaryo olarak kullanan sinema filmi, televizyon programı veya video gibi bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm như là phim điện ảnh, chương trình truyền hình, hoặc video, có sử dụng văn bản của tác phẩm như là kịch bản."],"zh-Hans-CN":["将一种内容表达与使用一种作品的文本作为剧本的诸如电影、电视节目或视频的一种作品一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"سيناريو لتعبيرة","ca":"guió per a una expressió","cs":"scénář pro vyjádření","da":"manuskript til udtryk","de":"Drehbuch für (Expression)","de":"Drehbuch für (Expression)","el":"σενάριο για (έκφραση)","en":"screenplay for expression","es":"guión de expresión","et":"stsenaarium väljendusele","fi":"käsikirjoitus ekspressioon","fr":"scénario pour une expression","hu":"forgatókönyv kifejezési formához:","lv":"scenārijs izteiksmei","nl":"scenario voor expressie","no":"filmmanus for uttrykk","tr":"anlatım için senaryo","vi":"kịch bản cho (biểu hiện)","zh-Hans-CN":"内容表达的影视剧剧本"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مثل فيلم سينمائي، أو برنامج تليفزيوني، أو فيديو يستخدم نص عمل كسيناريو.","ca":"Expressió d’una obra com ara una pel·lícula cinematogràfica, un programa de televisió o un vídeo, que usa el text d’una obra com a guió.","cs":"Vyjádření díla jako je film, televizní program nebo video, které využívá text díla jako scénář.","da":"Udtryk af et værk, såsom en spillefilm, skuespil, tv-program eller video, som anvender værkets tekst som manuskript.","de":"Eine Expression eines Werks, wie zum Beispiel ein Film, eine Fernsehsendung oder ein Video, die den Text eines Werks als Drehbuch verwendet.","de":"Eine Expression eines Werks, wie zum Beispiel ein Film, eine Fernsehsendung oder ein Video, die den Text eines Werks als Drehbuch verwendet.","el":"Μια έκφραση ενός έργου, όπως μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο, το οποίο χρησιμοποιεί το κείμενο ενός έργου ως σενάριο.","en":"An expression of a work such as a motion picture, television program, or video, that uses the text of a work as a screenplay.","es":"Una expresión de una obra, como una película, un programa de televisión o un vídeo, que utiliza el texto de una obra como guión.","et":"Teose väljendus, nt film, telesaade või videofilm, milles on kasutatud stsenaariumina teose teksti.","fi":"Teoksen, kuten elokuvan, television tai videon, ekspressio, joka käyttää teoksen tekstiä käsikirjoituksena.","fr":"Expression d’une œuvre telle qu’un film, une émission de télévision ou une vidéo qui utilise le texte d’une œuvre comme scénario.","hu":"Egy olyan mű, mint például egy film, tévéműsor, vagy videó, kifejezési formája, amely egy mű szövegét forgatókönyvként használja.","lv":"Darba izteiksme - kinofilma, televīzijas raidījums vai video, kurā izmantots pamatdarba teksts kā scenārijs.","nl":"Een expressie van een werk zoals een een speelfilm, televisieprogramma of video dat de tekst van een werk als scenario gebruikt.","no":"Et uttrykk av et verk som en spillefilm, et fjernsynsprogram eller en video, som bruker tekst fra et verk som manuskript.","tr":"Bir eserin metnini senaryo olarak kullanan sinema filmi, televizyon programı veya video gibi bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm như là phim điện ảnh, chương trình truyền hình, hoặc video, có sử dụng văn bản của tác phẩm như là kịch bản.","zh-Hans-CN":"使用一种作品的文本作为剧本的诸如电影、电视节目或视频的一种作品一种内容表达"},"label":{"ar":"هي سيناريو لتعبيرة","ca":"és guió per a una expressió","cs":"je scénářem pro vyjádření","da":"er manuskript til udtryk","de":"ist Drehbuch für (Expression)","de":"ist Drehbuch für (Expression)","el":"είναι σενάριο για (έκφραση)","en":"is screenplay for expression","es":"es un guión para la expresión","et":"stsenaarium väljendusele","fi":"käsikirjoitus ekspressioon","fr":"est un scénario pour une expression","hu":"forgatókönyv kifejezési formához:","lv":"ir scenārijs izteiksmei","nl":"is scenario voor expressie","no":"er filmmanus for uttrykk","tr":"anlatım için senaryodur","vi":"là kịch bản cho (biểu hiện)","zh-Hans-CN":"是内容表达的影视剧剧本"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20173", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForMotionPictureExpression.en", "label":"is screenplay for motion picture expression"},{"@id":"http://rdaregistry.info/Elements/e/P20174", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForTelevisionProgramExpression.en", "label":"is screenplay for television program expression"},{"@id":"http://rdaregistry.info/Elements/e/P20175", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForVideoExpression.en", "label":"is screenplay for video expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20102", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/screenplayForExpression.en", "label":"is screenplay for expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20102", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/screenplayForExpression.en", "label":"is screenplay for expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20176","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم نصًّا كسيناريو لبرنامج إذاعي."],"ca":["Relaciona una expressió amb una expressió d’una obra que usa el text com a guió d’un programa radiofònic."],"cs":["Vztahuje vyjádření k vyjádření díla, které využívá text jako scénář pro rozhlasový program."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvender teksten som manuskript til et radioprogram."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Text als Skript für eine Hörfunksendung verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Text als Skript für eine Hörfunksendung verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο χρησιμοποιεί το κείμενο ως σενάριο για ένα ραδιοφωνικό πρόγραμμα."],"en":["Relates an expression to an expression of a work that uses the text as a script for a radio program."],"es":["Relaciona una expresión con una expresión de una obra que utiliza el texto como guión de un programa de radio."],"et":["Seostab väljenduse teose väljendusega, milles kasutatakse teksti raadiosaate stsenaariumina."],"fi":["Liittää ekspression teoksen ekspressioon, joka käyttää tekstiä radio-ohjelman käsikirjoituksena."],"fr":["Met une expression en relation avec une expression d’une œuvre qui utilise le texte comme script d’une émission de radio."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely a szöveget egy rádióműsor forgatókönyveként használja."],"lv":["Sasaista izteiksmi ar darba izteiksmi - radio raidījums, kurā izmantots teksts kā scenārijs."],"nl":["Relateert een expressie aan een expressie van een werk dat de tekst gebruikt als een script voor een radioprogramma."],"no":["Relaterer et uttrykk til et uttrykk av et verk som bruker teksten som manuskript for et radioprogram."],"tr":["Bir anlatımı, metni bir radyo programı için senaryo olarak kullanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sử dụng văn bản như là kịch bản cho chương trình truyền thanh."],"zh-Hans-CN":["将一种内容表达与使用作为一个广播节目的文稿之文本的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"سيناريو لتعبيرة برنامج إذاعي","ca":"expressió de guió per a programa radiofònic","cs":"scénář pro rozhlasový program (vyjádření)","da":"manuskript til radioprogramudtryk","de":"Skript für Hörfunksendung (Expression)","de":"Skript für Hörfunksendung (Expression)",