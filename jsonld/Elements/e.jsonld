                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/digestedAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20170", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/digestedAsExpression.en", "label":"is digested as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20170", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/digestedAsExpression.en", "label":"is digested as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20164","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يعيد صياغة محتوى تعبيرة عمل آخر في شكل مختلف."],"ca":["Relaciona una expressió amb una expressió d’una obra que replanteja el contingut d’una expressió d’una altra obra en una forma diferent."],"cs":["Vztahuje vyjádření k vyjádření díla, které přetváří obsah vyjádření jiného díla v odlišné formě."],"da":["Relaterer et udtryk til et udtryk af et værk, som gentager indholdet i et udtryk af et andet værk i en anden form."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Inhalt einer Expression eines anderen Werks in einer anderen Form neu darstellt.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Inhalt einer Expression eines anderen Werks in einer anderen Form neu darstellt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο αναδιατυπώνει το περιεχόμενο ενός έργου-πηγής σε μια διαφορετική μορφή."],"en":["Relates an expression to an expression of a work that restates the content of an expression of another work in a different form."],"es":["Relaciona una expresión con una expresión de una obra que reafirma el contenido de una expresión de otra obra de forma diferente."],"et":["Seostab väljenduse teose väljendusega, mis väljendab allikteose sisu teises vormis."],"fi":["Liittää ekspression teoksen ekspressioon, joka toisintaa toisen teoksen ekspression sisällön eri muodossa."],"fr":["Met une expression en relation avec une expression d’une œuvre qui reprend le contenu d’une expression d’une autre œuvre sous une formulation différente."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy másik mű kifejezési formájának tartalmát másik formában újrafogalmazza."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas izsaka pamatdarba saturu citā veidā."],"nl":["Relateert een expressie aan een expressie van een werk dat de content van een expressie van een ander werk in een andere vorm formuleert."],"no":["Relaterer et uttrykk til et uttrykk av et verk som gjentar et kildeverks innhold i en annen form."],"tr":["Bir anlatımı, başka bir yapıtın anlatımının içeriğini farklı bir biçimde yeniden ifade eden bir yapıtın anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm trình bày lại nội dung của tác phẩm nguồn dưới hình thái khác."],"zh-Hans-CN":["将一种内容表达与用不同形式重述另一种作品的一种内容表达之内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معاد صياغتها كتعبيرة","ca":"parafrasejat com a expressió","cs":"parafrázováno jako vyjádření","da":"parafraseret som udtryk","de":"Paraphrasiert als (Expression)","de":"Paraphrasiert als (Expression)","el":"παράφραση ως (έκφραση)","en":"paraphrased as expression","es":"parafraseado como expresión","et":"parafraas väljendusena","fi":"parafraasi (ekspressio)","fr":"paraphrasé comme une expression","hu":"parafrázis kifejezési formája:","lv":"izteiksme: parafrāze","nl":"geparafraseerd als expressie","no":"omskrevet til uttrykk","tr":"anlatım olarak yorumlanmıştır","vi":"được diễn giải như là (biểu hiện)","zh-Hans-CN":"被演绎为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يعيد صياغة محتوى تعبيرة عمل آخر في شكل مختلف.","ca":"Expressió d’una obra que replanteja el contingut d’una expressió d’una altra obra en una forma diferent.","cs":"Vyjádření díla, které přetváří obsah vyjádření jiného díla v odlišné formě.","da":"Udtryk af et værk, som gentager indholdet i et udtryk af et andet værk i en anden form.","de":"Eine Expression eines Werks, die den Inhalt einer Expression eines anderen Werks in einer anderen Form neu darstellt.","de":"Eine Expression eines Werks, die den Inhalt einer Expression eines anderen Werks in einer anderen Form neu darstellt.","el":"Μια έκφραση ενός έργου το οποίο αναδιατυπώνει το περιεχόμενο ενός έργου-πηγής σε μια διαφορετική μορφή.","en":"An expression of a work that restates the content of an expression of another work in a different form.","es":"Una expresión de una obra que reafirma el contenido de una expresión de otra obra de forma diferente.","et":"Teose väljendus, mis väljendab allikteose sisu teises vormis.","fi":"Teoksen ekspressio, joka toisintaa toisen teoksen ekspression sisällön eri muodossa.","fr":"Expression d’une œuvre qui reprend le contenu d’une expression d’une autre œuvre sous une formulation différente.","hu":"Egy mű kifejezési formája, amely átír egy zenei kompozíciót olyan előadásmédiumra, amely különbözik a műnek eredetileg szánt médiumtól.","lv":"Darba izteiksme, kas izsaka pamatdarba saturu citā veidā.","nl":"Een expressie van een werk dat de content van een expressie van een ander werk in een andere vorm formuleert.","no":"Et uttrykk av et verk som gjentar et kildeverks innhold i en annen form.","tr":"Başka bir eserin anlatımının içeriğini farklı bir biçimde yeniden ifade eden bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm trình bày lại nội dung của tác phẩm nguồn dưới hình thái khác.","zh-Hans-CN":"用不同形式重述另一种作品的一种内容表达之内容的一种作品的一种内容表达"},"label":{"ar":"هي معاد صياغتها كتعبيرة","ca":"és parafrasejat com a expressió","cs":"je parafrázováno jako vyjádření","da":"er parafraseret som udtryk","de":"ist paraphrasiert als (Expression)","de":"ist paraphrasiert als (Expression)","el":"είναι παράφραση ως (έκφραση)","en":"is paraphrased as expression","es":"se parafrasea como expresión","et":"parafraas väljendusena","fi":"parafraasi (ekspressio)","fr":"est paraphrasé comme une expression","hu":"parafrázis kifejezési formája a következő:","lv":"izteiksmes parafrāze","nl":"is geparafraseerd als expressie","no":"er omskrevet til uttrykk","tr":"anlatım olarak yeniden yorumlanmıştır","vi":"được diễn giải như là (biểu hiện)","zh-Hans-CN":"被演绎为内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
