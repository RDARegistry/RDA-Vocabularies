                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicalTheatreAdaptationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20239", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicalTheatreAdaptationOfExpression.en", "label":"is musical theatre adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20239", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicalTheatreAdaptationOfExpression.en", "label":"is musical theatre adaptation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20231","label":{"ar":"لها عمل معبر عنه","ca":"té com a obra expressada","cs":"má vyjádřené dílo","da":"har værk udtrykt","de":"hat durch eine Expression realisiertes Werk","de":"hat durch eine Expression realisiertes Werk","el":"έχει έργο εκφρασμένο","en":"has work expressed","es":"tiene obra expresada","et":"väljendatud teos","fi":"ekspression toteuttama teos","fr":"a pour œuvre exprimée","hu":"kifejezett műve a következő:","lv":"izteiksme darbam","nl":"heeft gerealiseerd werk","no":"har verk uttrykt","sv":"har uttryckt verk","tr":"anlatımı yapılan eser ile ilişkilidir","vi":"có tác phẩm được biểu hiện","zh-Hans-CN":"有被内容表达的作品"},"definition":{"ar":["تربط بين تعبيرة وعمل يتحقق في تعبيرة."],"ca":["Relaciona una expressió amb una obra que es realitza mitjançant una expressió."],"cs":["Vztahuje vyjádření k dílu, které je realizováno prostřednictvím vyjádření."],"da":["Relaterer et udtryk til et værk, som realiseres gennem et udtryk."],"de":["Setzt eine Expression in Beziehung zu einem Werk, das durch eine Expression realisiert wird.,Setzt eine Expression in Beziehung zu einem Werk, das durch eine Expression realisiert wird."],"el":["Συνδέει μια έκφραση με ένα έργο που υλοποιείται μέσω μιας έκφρασης."],"en":["Relates an expression to a work that is realized through an expression."],"es":["Relaciona una expresión con una obra que se realiza a través de una expresión."],"et":["Seostab väljenduse teosega, mis on väljenduses realiseeritud."],"fi":["Liittää ekspression teokseen, joka toteutuu ekspression kautta."],"fr":["Met une expression en relation avec une œuvre qui est réalisée à travers une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formán keresztül megvalósított műhöz."],"lv":["Sasaista izteiksmi ar darbu, kas ir realizēts izteiksmē."],"nl":["Relateert een expressie aan een werk dat gerealiseerd is door een expressie."],"no":["Relaterer et uttrykk til et verk som er realisert gjennom et uttrykk."],"tr":["Bir anlatımı, bir anlatımı aracılığıyla gerçekleştirilen bir eserle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác phẩm được nhận thức qua biểu hiện."],"zh-Hans-CN":["将一种内容表达与通过一种内容表达被实现的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل معبر عنه","ca":"obra expressada","cs":"vyjádřené dílo","da":"værk udtrykt","de":"Durch eine Expression realisiertes Werk","de":"Durch eine Expression realisiertes Werk","el":"έργο εκφρασμένο","en":"work expressed","es":"obra expresada","et":"väljendatud teos","fi":"ekspression toteuttama teos","fr":"œuvre exprimée","hu":"kifejezett mű:","lv":"izteiksme darbam","nl":"gerealiseerd werk","no":"verk uttrykt","sv":"uttryckt verk","tr":"anlatımı yapılan çalışma","vi":"tác phẩm được biểu hiện","zh-Hans-CN":"被内容表达的作品"},"ToolkitDefinition":{"ar":"عمل يتحقق في تعبيرة.","ca":"Obra que es realitza mitjançant una expressió.","cs":"Dílo, které je realizováno prostřednictvím vyjádření.","da":"Værk, som realiseres gennem et udtryk.","de":"Ein Werk, das durch eine Expression realisiert wird.","de":"Ein Werk, das durch eine Expression realisiert wird.","el":"Ένα έργο που υλοποιείται μέσω μιας έκφρασης.","en":"A work that is realized through an expression.","es":"Una obra que se realiza a través de una expresión.","et":"Teos, mis on väljenduses realiseeritud.","fi":"Teos, joka toteutuu ekspression kautta.","fr":"Œuvre qui est réalisée à travers une expression.","hu":"Egy kifejezési formán keresztül megvalósított mű.","lv":"Darbs, kas ir realizēts izteiksmē.","nl":"Een werk dat gerealiseerd is door een expressie.","no":"Et verk som er realisert gjennom et uttrykk.","tr":"Bir anlatımla gerçekleştirilen bir çalışma.","vi":"Tác phẩm được nhận thức qua biểu hiện.","zh-Hans-CN":"通过一种内容表达被实现的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
