                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/draftsmanCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20485", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToAmalgamation.en", "label":"has contributor corporate body to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20398", "lexicalAlias":"http://rdaregistry.info/Elements/e/draftsmanCollectiveAgent.en", "label":"has draftsman collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20457", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/draftsmanCorporateBody.en", "label":"has draftsman corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20457", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/draftsmanCorporateBody.en", "label":"has draftsman corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20516","label":{"ar":"لها عائلة رسامة هندسي","ca":"té com a família delineant","cs":"má technického kresliče (rodinu)","da":"har familie, som er teknisk tegner","de":"hat Technische Zeichnerin/Technischen Zeichner (Familie)","de":"hat Technische Zeichnerin/Technischen Zeichner (Familie)","en":"has draftsman family","es":"tiene familia delineante","et":"joonestaja (perekond)","fi":"piirtäjä (suku)","fr":"a pour famille dessinatrice industrielle","hu":"műszaki rajzoló családja a következő:","lv":"rasētājs (dzimta/ģimene)","nl":"heeft technisch tekenaar-familie","no":"har teknisk tegner (familie)","tr":"teknik ressam ailesi ile ilişkilidir","zh-Hans-CN":"有绘图者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة من خلال مهندس معماري، أو مخترع، أو وكيل آخر عن طريق وضع خطط أو رسومات مفصلة للمباني، أو السفن، أو الطائرات، أو الآلات، أو الأشياء، أو إنشاءات أخرى."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió d’un arquitecte, un inventor o un altre agent amb l’elaboració dels plànols o els dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes o d’altres construccions."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření architekta, vynálezce nebo jiného agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů nebo jiných konstrukcí."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk af en arkitekt, opfinder etc. ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt."],"en":["Relates an expression to a family who contributes to an expression by an architect, inventor, or other agent by making detailed plans or drawings for buildings, ships, aircraft, machines, objects, or other constructions."],"es":["Relaciona una expresión con una familia que contribuye a una expresión de un arquitecto, inventor u otro agente al realizar planos o dibujos detallados para edificios, barcos, aviones, máquinas, objetos, etc."],"et":["Seostab väljenduse perekonnaga, kes annab panuse arhitekti, leiutaja vms väljendusse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele."],"fi":["Liittää ekspression sukuun, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista."],"fr":["Met une expression en relation avec une famille qui contribue à une expression d’un architecte, d’un inventeur ou d’un autre agent en effectuant des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets ou d’autres constructions."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely hozzájárul egy építész, feltaláló vagy egyéb ágens által létrehozott kifejezési formához azzal, hogy elkészíti épületek, hajók, repülőgépek, gépek, objektumok vagy egyéb konstrukciók részletes terveit vagy rajzait."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, veidojot ēku, kuģu, lidmašīnu, mašīnu, objektu, u.tml. detalizētus plānus vai rasējumus."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie van een architect, uitvinder of andere actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen of andere constructies."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk av en arkitekt, oppfinner, etc. ved å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc."],"tr":["Bir anlatımı, binalar, gemiler, uçaklar, makineler, nesneler veya diğer yapılar için ayrıntılı planlar veya çizimler yaparak bir mimar, mucit veya başka bir temsilcinin anlatımına katkıda bulunan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过由建筑师、发明者或其他行为者为建筑物、船舶、飞行器、机械装置、物体或其他结构制作详细平面图或绘制草图而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة رسامة هندسي","ca":"família delineant","cs":"technický kreslič (rodina)","da":"familie, som er teknisk tegner","de":"Technische Zeichnerin/Technischer Zeichner (Familie)","de":"Technische Zeichnerin/Technischer Zeichner (Familie)","en":"draftsman family","es":"agente colectivo delineante","et":"joonestaja (perekond)","fi":"piirtäjä (suku)","fr":"famille dessinatrice industrielle","hu":"műszaki rajzoló család:","lv":"rasētājs (dzimta/ģimene)","nl":"technisch tekenaar-familie","no":"teknisk tegner (familie)","tr":"tasarımcı aile","zh-Hans-CN":"绘图者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة من خلال مهندس معماري، أو مخترع، أو وكيل آخر عن طريق وضع خطط أو رسومات مفصلة للمباني، أو السفن، أو الطائرات، أو الآلات، أو الأشياء، أو إنشاءات أخرى.","ca":"Família que contribueix a una expressió d’un arquitecte, un inventor o un altre agent amb l’elaboració dels plànols o els dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes o d’altres construccions.","cs":"Rodina, která přispívá k vyjádření architekta, vynálezce nebo jiného agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů nebo jiných konstrukcí.","da":"Familie, som bidrager til et udtryk af en arkitekt, opfinder etc. ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc.","de":"Eine Familie, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt.","de":"Eine Familie, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt.","en":"A family who contributes to an expression by an architect, inventor, or other agent by making detailed plans or drawings for buildings, ships, aircraft, machines, objects, or other constructions.","es":"Una familia que contribuye a una expresión de un arquitecto, inventor u otro agente al realizar planos o dibujos detallados para edificios, barcos, aviones, máquinas, objetos, etc.","et":"Perekond, kes annab panuse arhitekti, leiutaja vms väljendusse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele.","fi":"Suku, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista.","fr":"Famille qui contribue à une expression d’un architecte, d’un inventeur ou d’un autre agent en effectuant des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets ou d’autres constructions.","hu":"Egy család, amely hozzájárul egy építész, feltaláló vagy egyéb ágens által létrehozott kifejezési formához azzal, hogy elkészíti épületek, hajók, repülőgépek, gépek, objektumok vagy egyéb konstrukciók részletes terveit vagy rajzait.","lv":"Dzimta/ģimene, kas sniegusi ieguldījumu izteiksmē, veidojot ēku, kuģu, lidmašīnu, mašīnu, objektu, u.tml. detalizētus plānus vai rasējumus.","nl":"Een familie die bijdraagt aan een expressie van een architect, uitvinder of andere actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen of andere constructies.","no":"En familie som bidrar til et uttrykk av en arkitekt, oppfinner, etc. ved å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc.","tr":"Mimari, mucitlik veya diğer alanlarda bir temsilci olarak binalar, gemiler, uçaklar, makineler, nesneler ya da diğer yapılar için ayrıntılı planlar veya çizimler yaparak bir anlatıma katkıda bulunan bir aile.","zh-Hans-CN":"通过由建筑师、发明者或其他行为者为建筑物、船舶、飞行器、机械装置、物体或其他结构制作详细平面图或绘制草图而对一种内容表达有贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/draftsmanFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20544", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToAmalgamation.en", "label":"has contributor family to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20398", "lexicalAlias":"http://rdaregistry.info/Elements/e/draftsmanCollectiveAgent.en", "label":"has draftsman collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20516", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/draftsmanFamily.en", "label":"has draftsman family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20516", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/draftsmanFamily.en", "label":"has draftsman family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20339","label":{"ar":"لها شخص رسام هندسي","ca":"té com a persona delineant","cs":"má technického kresliče (osobu)","da":"har person, som er teknisk tegner","de":"hat Technische Zeichnerin/Technischen Zeichner (Person)","de":"hat Technische Zeichnerin/Technischen Zeichner (Person)","en":"has draftsman person","es":"tiene persona dibujante","et":"joonestaja (isik)","fi":"piirtäjä (henkilö)","fr":"a pour personne dessinatrice industrielle","hu":"műszaki rajzoló személye a következő:","lv":"rasētājs (persona)","nl":"heeft technisch tekenaar-persoon","no":"har teknisk tegner (person)","tr":"teknik ressam kişisi ile ilişkilidir","zh-Hans-CN":"有绘图者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال مهندس معماري، أو مخترع، أو وكيل آخر عن طريق وضع خطط أو رسومات مفصلة للمباني، أو السفن، أو الطائرات، أو الآلات، أو الأشياء، أو إنشاءات أخرى."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió d’un arquitecte, un inventor o un altre agent amb l’elaboració dels plànols o els dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes o altres construccions."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření architekta, vynálezce nebo jiného agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů nebo jiných konstrukcí."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk af en arkitekt, opfinder etc. ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt."],"en":["Relates an expression to a person who contributes to an expression by an architect, inventor, or other agent by making detailed plans or drawings for buildings, ships, aircraft, machines, objects, or other constructions."],"es":["Relaciona una expresión con una persona que contribuye a una expresión de un arquitecto, inventor u otro agente haciendo planos o dibujos detallados de edificios, barcos, aviones, máquinas, objetos u otras construcciones."],"et":["Seostab väljenduse isikuga, kes annab panuse arhitekti, leiutaja vms väljendusse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele."],"fi":["Liittää ekspression henkilöön, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista."],"fr":["Met une expression en relation avec une personne qui contribue à une expression d’un architecte, d’un inventeur ou d’un autre agent en effectuant des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets ou d’autres constructions."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki hozzájárul egy építész, feltaláló vagy egyéb ágens által létrehozott kifejezési formához azzal, hogy elkészíti épületek, hajók, repülőgépek, gépek, objektumok vagy egyéb konstrukciók részletes terveit vagy rajzait."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, veidojot ēku, kuģu, lidmašīnu, mašīnu, objektu, u.tml. detalizētus plānus vai rasējumus."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie van een architect, uitvinder of andere actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen of andere constructies."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk av en arkitekt, oppfinner, etc. ved å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc."],"tr":["Bir anlatımı, binalar, gemiler, uçaklar, makineler, nesneler veya diğer yapılar için ayrıntılı planlar veya çizimler yaparak bir mimar, mucit veya başka bir temsilcinin anlatımına katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过由建筑师、发明者或其他行为者为建筑物、船舶、飞行器、机械装置、物体或其他结构制作详细平面图或绘制草图而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص رسام هندسي","ca":"persona delineant","cs":"technický kreslič (osoba)","da":"person, som er teknisk tegner","de":"Technische Zeichnerin/Technischer Zeichner (Person)","de":"Technische Zeichnerin/Technischer Zeichner (Person)","en":"draftsman person","es":"persona dibujante","et":"joonestaja (isik)","fi":"piirtäjä (henkilö)","fr":"personne dessinatrice industrielle","hu":"műszaki rajzoló személy:","lv":"rasētājs (persona)","nl":"technisch tekenaar-persoon","no":"teknisk tegner (person)","tr":"tasarımcı","zh-Hans-CN":"绘图者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال مهندس معماري، أو مخترع، أو وكيل آخر عن طريق وضع خطط أو رسومات مفصلة للمباني، أو السفن، أو الطائرات، أو الآلات، أو الأشياء، أو إنشاءات أخرى.","ca":"Persona que contribueix a una expressió d’un arquitecte, un inventor o un altre agent amb l’elaboració dels plànols o els dibuixos detallats d’edificis, de vaixells, d’avions, de màquines, d’objectes o altres construccions.","cs":"Osoba, která přispívá k vyjádření architekta, vynálezce nebo jiného agenta tím, že zhotovuje podrobné plány nebo výkresy budov, lodí, letadel, strojů, objektů nebo jiných konstrukcí.","da":"Person, som bidrager til et udtryk af en arkitekt, opfinder etc. ved at lave detaljerede planer eller tegninger til bygninger, skibe, luftfartøj, maskiner, objekter etc.","de":"Eine Person, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt.","de":"Eine Person, die zu einer Expression einer Architektin/eines Architekten, einer Erfinderin/eines Erfinders oder eines anderen Akteurs beiträgt, indem sie detaillierte Pläne oder Zeichnungen für Gebäude, Schiffe, Flugzeuge, Maschinen, Objekte oder andere Konstruktionen anfertigt.","en":"A person who contributes to an expression by an architect, inventor, or other agent by making detailed plans or drawings for buildings, ships, aircraft, machines, objects, or other constructions.","es":"Una persona que contribuye a una expresión de un arquitecto, inventor u otro agente haciendo planos o dibujos detallados de edificios, barcos, aviones, máquinas, objetos u otras construcciones.","et":"Isik, kes annab panuse arhitekti, leiutaja vms väljendusse, tehes täpseid plaane või jooniseid ehitistele, laevadele, lennukitele, masinatele vm objektidele.","fi":"Henkilö, joka osallistuu arkkitehdin, suunnittelijan tai muun toimijan luoman ekspression tekemiseen tuottamalla tarkkoja suunnitelmia tai piirroksia rakennuksista, laivoista, lentokoneista, laitteista, esineistä tai muista luomuksista.","fr":"Personne qui contribue à une expression d’un architecte, d’un inventeur ou d’un autre agent en effectuant des plans ou des dessins détaillés pour des bâtiments, des navires, des avions, des machines, des objets ou d’autres constructions.","hu":"Egy személy, aki hozzájárul egy építész, feltaláló vagy egyéb ágens által létrehozott kifejezési formához azzal, hogy elkészíti épületek, hajók, repülőgépek, gépek, objektumok vagy egyéb konstrukciók részletes terveit vagy rajzait.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, veidojot ēku, kuģu, lidmašīnu, mašīnu, objektu, u.tml. detalizētus plānus vai rasējumus.","nl":"Een persoon die bijdraagt aan een expressie van een architect, uitvinder of andere actor door het maken van gedetailleerde plattegronden of tekeningen voor gebouwen, schepen, luchtvaartuigen, machines, voorwerpen of andere constructies.","no":"En person som bidrar til et uttrykk av en arkitekt, oppfinner, etc. ved å lage detaljerte plantegninger for bygninger, skip, fly, maskiner, gjenstander, etc.","tr":"Bir bina, gemi, uçak, makine, nesne veya başka bir yapı için ayrıntılı planlar veya çizimler yaparak bir mimar, mucit veya başka bir temsilcinin anlatımına katkıda bulunan kişi","zh-Hans-CN":"通过由建筑师、发明者或其他行为者为建筑物、船舶、飞行器、机械装置、物体或其他结构制作详细平面图或绘制草图而对一种内容表达有贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
