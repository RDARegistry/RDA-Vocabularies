                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20292", "lexicalAlias":"http://rdaregistry.info/Elements/e/audioEngineerAgent.en", "label":"has audio engineer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20445", "lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerCollectiveAgent.en", "label":"has recording engineer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20386", "lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerPerson.en", "label":"has recording engineer person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20050", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/recordingEngineerAgent.en", "label":"has recording engineer agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20050", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/recordingEngineerAgent.en", "label":"has recording engineer agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20445","label":{"ar":"لها وكيل جماعي مهندس تسجيل","ca":"té com a agent col·lectiu enginyer de so","cs":"má technika záznamu (kolektivního agenta)","da":"har kollektiv agent, som er indspilningstekniker","de":"hat Aufnahmetechnikerin/Aufnahmetechniker (Gemeinschaftlicher Akteur)","de":"hat Aufnahmetechnikerin/Aufnahmetechniker (Gemeinschaftlicher Akteur)","en":"has recording engineer collective agent","es":"tiene agente colectivo ingeniero de grabación","et":"salvestusinsener (kollektiiv)","fi":"äänittäjä (yhteistoimija)","fr":"a pour agent collectif preneur de son","hu":"hangrögzítő kollektív ágense a következő:","lv":"ierakstu inženieris (grupa)","nl":"heeft opnametechn