                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/softwareDeveloperPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20367", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToAmalgamation.en", "label":"has contributor person to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20280", "lexicalAlias":"http://rdaregistry.info/Elements/e/softwareDeveloperAgent.en", "label":"has software developer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20353", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/softwareDeveloperPerson.en", "label":"has software developer person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20353", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/softwareDeveloperPerson.en", "label":"has software developer person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20276","label":{"ar":"لها وكيل مصمم صوت","ca":"té com a agent dissenyador de so","cs":"má designéra zvuku (agenta)","da":"har agent, som er lyddesigner","de":"hat Tongestalterin/Tongestalter (Akteur)","de":"hat Tongestalterin/Tongestalter (Akteur)","el":"έχει ηχολήπτη","en":"has sound designer agent","es":"tiene agente diseñador de sonido","et":"helikujundaja (tegija)","fi":"äänisuunnittelija (toimija)","fr":"a pour agent concepteur sonore","hu":"hangtervező ágense a következő:","lv":"skaņu mākslinieks (aģents)","nl":"heeft geluidsontwerper-actor","no":"har lyddesigner (agent)","tr":"ses tasarımcısı temsilcisi ile ilişkilidir","vi":"có người thiết kế âm thanh","zh-Hans-CN":"有音响设计者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال تصميم عناصر سمعية أو صوتية وإنشائها."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió amb el disseny i la creació de components àudio o sonors."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření tím, že navrhuje a vytváří zvukovou složku."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at designe og skabe audio- eller lyddele."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er Tonelemente entwirft und erstellt.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er Tonelemente entwirft und erstellt."],"el":["Συνδέει μια έκφραση με έναν φορέα που συνεισφέρει σε μια έκφραση ενός έργου μέσω του σχεδιασμού και της δημιουργίας ακουστικών/ηχητικών συστατικών."],"en":["Relates an expression to an agent who contributes to an expression by designing and creating audio or sound components."],"es":["Relaciona una expresión con un agente que contribuye a una expresión diseñando y creando audio o componentes de sonido."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, kavandades ja luues selle helikomponendid."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen suunnittelemalla ja luomalla äänikomponentteja."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en concevant et en créant des effets audio ou sonores."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy megtervezi és megalkotja a hang/audióelemeket."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, izstrādājot un radot audio un/vai skaņu komponentus."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het ontwerpen en creëren van audio- en geluidseffecten."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å utforme og skape lydkomponenter."],"tr":["Bir anlatımı, ses veya ses bileşenleri tasarlayıp oluşturarak bir anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng các thiết kế và tạo ra bộ phần cấu thành về audio/âm thanh."],"zh-Hans-CN":["将一种内容表达与通过设计和创建音频或音响组成部分而对内容表达有贡献的行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مصمم صوت","ca":"agent dissenyador de so","cs":"designér zvuku (agent)","da":"agent, som er lyddesigner","de":"Tongestalterin/Tongestalter (Akteur)","de":"Tongestalterin/Tongestalter (Akteur)","el":"ηχολήπτης","en":"sound designer agent","es":"agente diseñador de sonido","et":"helikujundaja (tegija)","fi":"äänisuunnittelija (toimija)","fr":"agent concepteur sonore","hu":"hangtervező ágens:","lv":"skaņu mākslinieks (aģents)","nl":"geluidsontwerper-actor","no":"lyddesigner (agent)","tr":"ses tasarımcı temsilci","vi":"người thiết kế âm thanh","zh-Hans-CN":"音响设计者行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال تصميم عناصر سمعية أو صوتية وإنشائها.","ca":"Agent que contribueix a una expressió amb el disseny i la creació de components àudio o sonors.","cs":"Agent, který přispívá k vyjádření tím, že navrhuje a vytváří zvukovou složku.","da":"Agent, som bidrager til et udtryk ved at designe og skabe audio- eller lyddele.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er Tonelemente entwirft und erstellt.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er Tonelemente entwirft und erstellt.","el":"Ένας φορέας που συνεισφέρει σε μια έκφραση ενός έργου μέσω του σχεδιασμού και της δημιουργίας ακουστικών/ηχητικών συστατικών.","en":"An agent who contributes to an expression by designing and creating audio or sound components.","es":"Un agente que contribuye a una expresión diseñando y creando audio o componentes de sonido.","et":"Tegija, kes annab panuse väljendusse, kavandades ja luues selle helikomponendid.","fi":"Toimija, joka osallistuu ekspression tekemiseen suunnittelemalla ja luomalla äänikomponentteja.","fr":"Agent qui contribue à une expression en concevant et en créant des effets audio ou sonores.","hu":"Egy ágens, amely hozzájárul egy kifejezési formához azzal, hogy megtervezi és megalkotja a hang/audióelemeket.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, izstrādājot un radot audio un/vai skaņu komponentus.","nl":"Een actor die bijdraagt aan een expressie door het ontwerpen en creëren van audio- en geluidseffecten.","no":"En agent som bidrar til et uttrykk ved å utforme og skape lydkomponenter.","tr":"Ses veya ses bileşenleri tasarlayarak ve oluşturarak bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng các thiết kế và tạo ra bộ phần cấu thành về audio/âm thanh.","zh-Hans-CN":"通过设计和创建音频或音响组成部分而对内容表达有贡献的行为者"},"altLabel":{"ar":["مصمم صوت"],"ca":["dissenyador de so"],"cs":["designér zvuku"],"da":["lyddesigner"],"de":["Tongestalter,Tongestalter"],"en":["sound designer"],"es":["diseñador de sonido"],"et":["helikujundaja"],"fi":["äänisuunnittelija"],"fr":["concepteur sonore"],"hu":["hangtervező:"],"nl":["geluidsontwerper"],"no":["lyddesigner"],"tr":["ses tasarımcısı"],"zh-Hans-CN":["音响设计者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
