                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20333", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedEntityOfExpression.en", "label":"has related entity of expression"},{"@id":"http://rdaregistry.info/Elements/x/P00001", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedRDAEntityOfRDAEntity.en", "label":"has related RDA entity of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/relatedRDAEntityOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20301", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedAgentOfExpression.en", "label":"has related agent of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20306", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedPlaceOfExpression.en", "label":"has related place of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20307", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedTimespanOfExpression.en", "label":"has related timespan of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20299", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedManifestationOfExpression.en", "label":"has related manifestation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20298", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedWorkOfExpression.en", "label":"has related work of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20308", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedNomenOfExpression.en", "label":"has related nomen of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20300", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedItemOfExpression.en", "label":"has related item of expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20297", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/relatedRDAEntityOfExpression.en", "label":"has related RDA entity of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20297", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/relatedRDAEntityOfExpression.en", "label":"has related RDA entity of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20318","label":{"ar":"لها نوع سطح طباعة بارزة","ca":"té representació de relleu","cs":"má znázornění reliéfu","da":"har relieftype","de":"hat Reliefdarstellung","de":"hat Reliefdarstellung","en":"has relief representation","es":"tiene representación en relieve","et":"reljeefi kujutamise viis","fi":"korkeuserojen esitystapa","fr":"a pour représentation du relief","hu":"domborzatábrázolás típusa a következő:","lv":"reljefa apzīmējums","nl":"heeft reliëfweergave","no":"har reliefftype","tr":"kabartma temsili ile ilişkilidir","zh-Hans-CN":"有地形表现"},"definition":{"ar":["تربط بين تعبيرة وطريقة تشير إلى الأبعاد الأفقية والرأسية لسطح الأرض وتضاريسها."],"ca":["Relaciona una expressió amb una representació cartogràfica de les formes de la superfície de la terra o d’un altre cos celeste, real o imaginari, mitjançant mètodes gràfics especials."],"cs":["Vztahuje vyjádření ke kartografickému znázornění tvarů povrchu Země nebo jiného nebeského tělesa, skutečného nebo imaginárního, pomocí speciálních grafických metod."],"da":["Relaterer et udtryk til en metode til at indikere de vandrette og lodrette dimensioner af landoverflade og terræn."],"de":["Setzt eine Expression in Beziehung zu einer Methode zur Angabe der horizontalen und vertikalen Darstellung des Geländes.,Gesamttitelangabe Eine Angabe, die eine Reihe identifiziert, zu der eine Ressource gehört, und die Zählung der Ressource innerhalb der Reihe."],"en":["Relates an expression to a cartographic representation of the surface forms of the earth or other celestial body, real or imaginary, by means of special graphic methods."],"es":["Relaciona una expresión con una representación cartográfica de las formas superficiales de la tierra u otro cuerpo celeste, real o imaginario, mediante métodos gráficos especiales."],"et":["Seostab väljenduse maapinna ja pinnavormide horisontaalsete ja vertikaalsete mõõtmete tähistamise meetodiga."],"fi":["Liittää ekspression kartografiseen esitykseen maan tai muun todellisen tai kuvitteellisen taivaankappaleen pinnanmuodoista erityisten graafisten menetelmien avulla."],"fr":["Met une expression en relation avec une représentation cartographique des formes de la surface de la terre ou d’un autre corps céleste, réel ou imaginaire, au moyen de méthodes graphiques spéciales."],"hu":["Hozzákapcsol egy kifejezési formát egy olyan jelölési módszerhez, amely a földfelszín és a terep vízszintes és függőleges méreteinek jelzésére irányul."],"lv":["Sasaista izteiksmi ar zemes virsmas un reljefa horizontālo un vertikālo izmēru apzīmēšanas metodi."],"nl":["Relateert een expressie aan een cartografische weergave van de oppervlaktevormen van de aarde of ander hemellichaam, bestaand of denkbeeldig, met behulp van speciale grafische methoden."],"no":["Relaterer et uttrykk til en metode som indikerer de horisontale og vertikale dimensjonene av jordoverflate og terreng."],"tr":["Bir anlatımı, yeryüzünün veya başka bir gök cisminin yüzey şekillerinin, gerçek veya hayali, özel grafik yöntemlerle kartografik bir temsiliyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过特殊图形方法对（真实或虚构）地球或其他天体的表面形状的地图表现关联起来。"]},"ToolkitLabel":{"ar":"نوع سطح طباعة بارزة","ca":"representació de relleu","cs":"znázornění reliéfu","da":"relieftype","de":"Reliefdarstellung","de":"Reliefdarstellung","en":"relief representation","es":"representación en relieve","et":"reljeefi kujutamise viis","fi":"korkeuserojen esitystapa","fr":"représentation du relief","hu":"domborzatábrázolás típusa:","lv":"reljefa apzīmējums","nl":"reliëfweergave","no":"reliefftype","tr":"kabartma temsili","zh-Hans-CN":"地形表现"},"ToolkitDefinition":{"ar":"طريقة تشير إلى الأبعاد الأفقية والرأسية لسطح الأرض وتضاريسها.","ca":"Representació cartogràfica de les formes de la superfície de la terra o d’un altre cos celeste, real o imaginari, mitjançant mètodes gràfics especials.","cs":"Kartografické znázornění tvarů povrchu Země nebo jiného nebeského tělesa, skutečného nebo imaginárního, pomocí speciálních grafických metod.","da":"Metode til at indikere de vandrette og lodrette dimensioner af landoverflade og terræn.","de":"Eine Methode zur Angabe der horizontalen und vertikalen Darstellung des Geländes.","de":"Eine Umfangseinheit, die aus einer Darstellung der Erde oder eines anderen Himmelskörpers (real oder imaginär) auf der Oberfläche einer Kugel besteht.","en":"A cartographic representation of the surface forms of the earth or other celestial body, real or imaginary, by means of special graphic methods.","es":"Una representación cartográfica de las formas superficiales de la tierra u otro cuerpo celeste, real o imaginario, mediante métodos gráficos especiales.","et":"Maapinna ja pinnavormide horisontaalsete ja vertikaalsete mõõtmete tähistamise meetod.","fi":"Kartografinen esitys maan tai muun todellisen tai kuvitteellisen taivaankappaleen pinnanmuodoista erityisten graafisten menetelmien avulla.","fr":"Représentation cartographique des formes de la surface de la terre ou d’un autre corps céleste, réel ou imaginaire, au moyen de méthodes graphiques spéciales.","hu":"Egy jelölési módszer, amely a földfelszín és a terep vízszintes és függőleges méreteinek jelzésére irányul.","lv":"Zemes virsmas un reljefa horizontālo un vertikālo izmēru apzīmēšanas metode.","nl":"Een cartografische weergave van de oppervlaktevormen van de aarde of ander hemellichaam, bestaand of denkbeeldig, met behulp van speciale grafische methoden.","no":"En metode som indikerer de horisontale og vertikale dimensjonene av jordoverflate og terreng.","tr":"Dünyanın veya başka bir gök cisminin yüzey şekillerinin, gerçek veya hayali durumunun özel grafik yöntemlerle kartografik olarak gösterimi.","zh-Hans-CN":"通过特殊图形方法对（真实或虚构）地球或其他天体的表面形状的地图表现"},"altLabel":{"ca":["té tipus de relleu"],"cs":["má typ reliéfu"],"de":["hat Reliefdarstellung"],"en":["has relief type"],"es":["tiene tipo relieve"],"fi":["korkokuvan esitysmuoto"],"fr":["type de relief"],"nl":["heeft reliëftype"],"tr":["kabartma türü ile ilişkilidir"],"zh-Hans-CN":["有地形类型"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
