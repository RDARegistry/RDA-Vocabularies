                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20157", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayExpression.en", "label":"has screenplay expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/televisionScreenplayExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20161", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/televisionScreenplayExpression.en", "label":"has television screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20161", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/televisionScreenplayExpression.en", "label":"has television screenplay expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20230","definition":{"ar":["تربط بين تعبيرة ومقياس ارتفاع أو بُعد رأسي لمحتوى رسم خرائطي لتعبيرة."],"ca":["Relaciona una expressió amb una escala de l’elevació o de la dimensió vertical del contingut cartogràfic d’una expressió."],"cs":["Vztahuje vyjádření k měřítku výšky nebo vertikálního rozměru kartografického obsahu vyjádření."],"da":["Relaterer et udtryk til en koteskala eller skala for vertikal dimension for et udtryks kartografiske indhold."],"de":["Setzt eine Expression in Beziehung zu einem Maßstab der Höhe oder einem vertikalen Maß von kartografischem Inhalt einer Expression.,Setzt eine Expression in Beziehung zu einem Maßstab der Höhe oder einem vertikalen Maß von kartografischem Inhalt einer Expression."],"el":["Συνδέει μια έκφραση με μια κλίμακα οριζόντιας ή κάθετης διάστασης του χαρτογραφικού περιεχομένου μιας έκφρασης."],"en":["Relates an expression to a scale of elevation or vertical dimension of cartographic content of an expression."],"es":["Relaciona una expresión con una escala de elevación o dimensión vertical del contenido cartográfico de una expresión."],"et":["Seostab väljenduse väljenduse kartograafilise sisu kõrguse või vertikaalmõõtme mõõtkavaga."],"fi":["Liittää ekspression ekspression kartografisen sisällön esittämän korkeuden tai vertikaalisen ulottuvuuden mittakaavaan."],"fr":["Met une expression en relation avec une échelle de l’élévation ou de la dimension verticale d’un contenu cartographique d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma kartográfiai tartalmának emelkedési vagy függőleges dimenziójának a léptékéhez."],"lv":["Sasaista izteiksmi ar resursa kartogrāfiskā satura augstuma vai vertikālās dimensijas mērogu."],"nl":["Relateert een expressie aan een schaal van elevatie of verticale dimensie van cartografische content van een expressie."],"no":["Relaterer et uttrykk til en målestokk som angir høyde over havet eller den vertikale dimensjonen for det kartografiske innholdet til et uttrykk."],"tr":["Bir anlatımı, bir anlatımın kartografik içeriğinin yükseklik ölçeği veya dikey boyutuyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với tỷ lệ của độ cao hoặc kích thước chiều dọc của nội dung bản đồ của biểu hiện."],"zh-Hans-CN":["将一种内容表达与内容表达的地图内容的高度或垂直尺寸的比例尺关联起来。"]},"ToolkitLabel":{"ar":"مقياس رأسي لمحتوى رسم خرائطي","ca":"escala vertical d’un contingut cartogràfic","cs":"vertikální měřítko kartografického obsahu","da":"vertikal skala for kartografisk indhold","de":"vertikaler Maßstab bei kartografischem Inhalt","de":"Vertikaler Maßstab bei kartografischem Inhalt","el":"κάθετη κλίμακα του χαρτογραφικού περιεχομένου","en":"vertical scale of cartographic content","es":"escala vertical de contenido cartográfico","et":"kartograafilise sisu vertikaalne mõõtkava","fi":"kartografisen sisällön vertikaalinen mittakaava","fr":"échelle des hauteurs d’un contenu cartographique","hu":"kartográfiai tartalom függőleges méretaránya:","lv":"kartogrāfiskā satura vertikālais mērogs","nl":"verticale schaal van cartografische content","no":"vertikal målestokk for kartografisk innhold","sv":"vertikal skala för kartografiskt innehåll","tr":"kartografik içeriğin dikey ölçeği","vi":"tỷ lệ dọc của nội dung bản đồ","zh-Hans-CN":"地图内容的垂直比例尺"},"ToolkitDefinition":{"ar":"مقياس ارتفاع أو بُعد رأسي لمحتوى رسم خرائطي لتعبيرة.","ca":"Escala de l’elevació o de la dimensió vertical del contingut cartogràfic d’una expressió.","cs":"Měřítko výšky nebo vertikálního rozměru kartografického obsahu vyjádření.","da":"Koteskala eller skala for vertikal dimension for et udtryks kartografiske indhold.","de":"Ein Maßstab der Höhe oder einem vertikalen Maß von kartografischem Inhalt einer Expression.","de":"Ein Maßstab der Höhe oder einem vertikalen Maß von kartografischem Inhalt einer Expression.","el":"Μια κλίμακα οριζόντιας ή κάθετης διάστασης του χαρτογραφικού περιεχομένου μιας έκφρασης.","en":"A scale of elevation or vertical dimension of cartographic content of an expression.","es":"Una escala de elevación o dimensión vertical del contenido cartográfico de una expresión.","et":"Väljenduse kartograafilise sisu kõrguse või vertikaalmõõtme mõõtkava.","fi":"Ekspression kartografisen sisällön esittämän korkeuden tai vertikaalisen ulottuvuuden mittakaava.","fr":"Échelle de l’élévation ou de la dimension verticale d’un contenu cartographique d’une expression.","hu":"Egy kifejezési forma kartográfiai tartalmának emelkedési vagy függőleges dimenziójának a léptéke.","lv":"Resursa kartogrāfiskā satura augstuma vai vertikālās dimensijas mērogs.","nl":"Een schaal van elevatie of verticale dimensie van cartografische content van een expressie.","no":"En målestokk som angir høyde over havet eller den vertikale dimensjonen for det kartografiske innholdet til et uttrykk.","tr":"Bir anlatımın kartografik içeriğinin yükseklik ölçeği veya dikey boyutu.","vi":"Tỷ lệ của độ cao hoặc kích thước chiều dọc của nội dung bản đồ của biểu hiện.","zh-Hans-CN":"内容表达的地图内容的高度或垂直尺寸的比例尺"},"label":{"ar":"لها مقياس رأسي لمحتوى رسم خرائطي","ca":"té com a escala vertical d’un contingut cartogràfic","cs":"má vertikální měřítko kartografického obsahu","da":"har vertikal skala for kartografisk indhold","de":"hat vertikalen Maßstab bei kartografischem Inhalt","de":"hat vertikalen Maßstab bei kartografischem Inhalt","el":"έχει κάθετη κλίμακα του χαρτογραφικού περιεχομένου","en":"has vertical scale of cartographic content","es":"tiene escala vertical de contenido cartográfico","et":"kartograafilise sisu vertikaalne mõõtkava","fi":"kartografisen sisällön vertikaalinen mittakaava","fr":"a pour échelle des hauteurs d’un contenu cartographique","hu":"kartográfiai tartalom függőleges méretaránya a következő:","lv":"kartogrāfiskā satura vertikālais mērogs","nl":"heeft verticale schaal van cartografische content","no":"har vertikal målestokk for kartografisk innhold","sv":"har vertikal skala för kartografiskt innehåll","tr":"kartografik içeriğin dikey ölçeği ile ilişkilidir","vi":"có tỷ lệ dọc của nội dung bản đồ","zh-Hans-CN":"有地图内容的垂直比例尺"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20228", "lexicalAlias":"http://rdaregistry.info/Elements/e/scale.en", "label":"has scale"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/verticalScaleOfCartographicContent.en","instructionNumber":"7.25.4","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20230", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/verticalScaleOfCartographicContent.en", "label":"has vertical scale of cartographic content"}]},{"@id":"http://rdaregistry.info/Elements/e/P20216","label":{"ar":"لها إسقاط محتوى رسم خرائطي","ca":"té com a projecció de contingut cartogràfic","cs":"má projekci kartografického obsahu","da":"har projicering af kartografisk indhold","de":"hat hat Projektion von kartografischem Inhalt","de":"hat Projektion von kartografischem Inhalt","el":"έχει προβολή του χαρτογραφικού περιεχομένου","en":"has projection of cartographic content","es":"tiene proyección de contenido cartográfico","et":"kartograafilise sisu projektsioon","fi":"kartografisen sisällön projektio","fr":"a pour projection d’un contenu cartographique","hu":"térképészeti tartalom vetülete a következő:","lv":"projekcija (kartogrāfijā)","nl":"heeft projectie van cartografische content","no":"har kartprojeksjon","sv":"har kartprojektion","tr":"kartografik içeriğin projeksiyonu ile ilişkilidir","vi":"có chiếu của nội dung bản đồ","zh-Hans-CN":"有地图内容的投影"},"definition":{"ar":["تربط بين تعبيرة وطريقة أو نظام مستخدم لتمثيل سطح الأرض أو الكرة السماوية على مسطح في تعبيرة."],"ca":["Relaciona una expressió amb un mètode o sistema usat per representar la superfície de la terra o d’una esfera celeste sobre un pla en una expressió."],"cs":["Vztahuje vyjádření k metodě nebo systému, použitým pro reprezentaci zemského povrchu nebo nebeské sféry do roviny ve vyjádření."],"da":["Relaterer et udtryk til en metode eller system, som anvendes til at repræsentere jordens overflade eller overfladen på et himmellegeme på et kort i et udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Methode oder einem System, die/das angewendet wird, um in einer Expression die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.,Setzt eine Ressource in Beziehung zu einer Methode oder einem System, die/das angewendet wird, um die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren."],"el":["Συνδέει μια έκφραση με μια μέθοδο ή ένα σύστημα που χρησιμοποιείται για την αναπαράσταση της γήινης επιφάνειας ή μιας ουράνιας σφαίρας σε ένα επίπεδο."],"en":["Relates an expression to a method or system used to represent the surface of the earth or of a celestial sphere on a plane in an expression."],"es":["Relaciona una expresión con un método o sistema utilizado para representar la superficie de la tierra o de una esfera celeste en un plano en una expresión."],"et":["Seostab väljenduse meetodi või süsteemiga, mida väljenduses on kasutatud Maa pinna või taevasfääri tasapinnaliseks kujutamiseks."],"fi":["Liittää ekspression menetelmään tai järjestelmään, jota käytetään esittämään maapallon tai taivaanpallon pintaa kaksiulotteisesti ekspressiossa."],"fr":["Met une expression en relation avec une méthode ou un système utilisé pour représenter la surface de la Terre ou d’une sphère céleste sur un plan dans une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy olyan módszerhez vagy rendszerhez, amelyet a Föld vagy egy égitest felszínének síkbeli ábrázolására használnak."],"lv":["Sasaista izteiksmi ar metodi vai sistēmu Zemes virsmas vai debess sfēras attēlošanai plaknē."],"nl":["Relateert een expressie aan een methode of systeem gebruikt om het oppervlak van de aarde of van een hemellichaam op een plat vlak in een expressie weer te geven."],"no":["Relaterer et uttrykk til en metode eller et system som brukes for å gjengi overflaten til jorden eller et annet kuleformet himmellegeme på en flat overflate i et uttrykk."],"tr":["Bir anlatımı, bir anlatımda yerkürenin veya bir göksel kürenin yüzeyini bir düzlem üzerinde temsil etmek için kullanılan bir yöntem veya sistemle ilişkilendirir."],"vi":["Liên kết một biểu hiện với phương pháp hoặc hệ thống được sử dụng để trình bày bề mặt của Trái đất hoặc thiên cầu trên mặt phẳng."],"zh-Hans-CN":["将一种内容表达与用于在一种内容表达的平面上表示地球或天球表面的方法或系统关联起来。"]},"ToolkitLabel":{"ar":"إسقاط محتوى رسم خرائطي","ca":"projecció de contingut cartogràfic","cs":"projekce kartografického obsahu","da":"projicering af kartografisk indhold","de":"Projektion von kartografischem Inhalt","de":"Projektion von kartografischem Inhalt","el":"προβολή του χαρτογραφικού περιεχομένου","en":"projection of cartographic content","es":"proyección de contenido cartográfico","et":"kartograafilise sisu projektsioon","fi":"kartografisen sisällön projektio","fr":"projection d’un contenu cartographique","hu":"térképészeti tartalom vetülete:","lv":"projekcija (kartogrāfijā)","nl":"projectie van cartografische content","no":"kartprojeksjon","sv":"kartprojektion","tr":"kartografik içeriğin projeksiyonu","vi":"chiếu của nội dung bản đồ","zh-Hans-CN":"地图内容的投影"},"ToolkitDefinition":{"ar":"طريقة أو نظام مستخدم لتمثيل سطح الأرض أو الكرة السماوية على مسطح في تعبيرة.","ca":"Mètode o sistema usat per representar la superfície de la terra o d’una esfera celeste sobre un pla en una expressió.","cs":"Metoda nebo systém, které jsou použité pro reprezentaci zemského povrchu nebo nebeské sféry do roviny ve vyjádření.","da":"Metode eller system, som anvendes til at repræsentere jordens overflade eller overfladen på et himmellegeme på et kort i et udtryk.","de":"Eine Methode oder ein System, die/das angewendet wird, um in einer Expression die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.","de":"Eine Methode oder ein System, die/das angewendet wird, um in einer Expression die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.","el":"Μια μέθοδος ή ένα σύστημα που χρησιμοποιείται για την αναπαράσταση της γήινης επιφάνειας ή μιας ουράνιας σφαίρας σε ένα επίπεδο.","en":"A method or system used to represent the surface of the earth or of a celestial sphere on a plane in an expression.","es":"Un método o sistema utilizado para representar la superficie de la tierra o de una esfera celeste en un plano en una expresión.","et":"Meetod või süsteem, mida väljenduses on kasutatud Maa pinna või taevasfääri tasapinnaliseks kujutamiseks.","fi":"Menetelmä tai järjestelmä, jota käytetään esittämään maapallon tai taivaanpallon pintaa kaksiulotteisesti ekspressiossa.","fr":"Méthode ou système utilisé pour représenter la surface de la Terre ou d’une sphère céleste sur un plan dans une expression.","hu":"Egy olyan módszer vagy rendszer, amelyet a Föld vagy egy égitest felszínének síkbeli ábrázolására használnak.","lv":"Metode vai sistēma Zemes virsmas vai debess sfēras attēlošanai plaknē.","nl":"Een methode of systeem gebruikt om het oppervlak van de aarde of van een hemellichaam op een plat vlak in een expressie weer te geven.","no":"En metode eller et system som brukes for å gjengi overflaten til jorden eller et annet kuleformet himmellegeme på en flat overflate i et uttrykk.","tr":"Bir anlatımda dünyanın veya göksel bir kürenin yüzeyini bir düzlem üzerinde temsil etmek için kullanılan bir yöntem veya sistem.","vi":"Phương pháp hoặc hệ thống được sử dụng để trình bày bề mặt của Trái đất hoặc thiên cầu trên mặt phẳng.","zh-Hans-CN":"用于在一种内容表达的平面上表示地球或天球表面的方法或系统"},"altLabel":{"de":["Projektion von kartographischem Inhalt"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/projectionOfCartographicContent.en","instructionNumber":"7.26","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20216", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/projectionOfCartographicContent.en", "label":"has projection of cartographic content"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20216", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/projectionOfCartographicContent.en", "label":"has projection of cartographic content"}]},{"@id":"http://rdaregistry.info/Elements/e/P20226","definition":{"ar":["تربط بين تعبيرة ونسبة مسافات أفقية في محتوى رسم خرائطي لتعبيرة بالمسافات الفعلية التي يمثلها."],"ca":["Relaciona una expressió amb una relació entre les distàncies horitzontals d’un contingut cartogràfic d’una expressió i les distàncies reals que representen."],"cs":["Vztahuje vyjádření k poměru horizontálních vzdáleností v kartografickém obsahu vyjádření a skutečných vzdáleností, které reprezentují."],"da":["Relaterer et udtryk til et forhold mellem horisontale afstande i et udtryks kartografiske indhold og de virkelige afstande, de repræsenterer."],"de":["Setzt eine Expression in Beziehung zu einem Verhältnis der horizontalen Entfernungen bei kartografischem Inhalt einer Expression zu den tatsächlichen Entfernungen, die sie repräsentieren.,Setzt eine Expression in Beziehung zu einem Verhältnis der horizontalen Entfernungen bei kartografischem Inhalt einer Expression zu den tatsächlichen Entfernungen, die sie repräsentieren."],"el":["Συνδέει μια έκφραση με τον λόγο των οριζόντιων αποστάσεων στο χαρτογραφικό περιεχόμενο μιας έκφρασης προς τις πραγματικές αποστάσεις που αναπαριστούν."],"en":["Relates an expression to a ratio of horizontal distances in cartographic content of an expression to the actual distances they represent."],"es":["Relaciona una expresión con una proporción de distancias horizontales en el contenido cartográfico de una expresión con las distancias reales que representan."],"et":["Seostab väljenduse väljenduse kartograafilise sisu horisontaalsete vahemaade ja nende esindatud tegelike vahemaade suhtega."],"fi":["Liittää ekspression ekspression kartografisen sisällön horisontaalisten etäisyyksien suhteeseen niiden esittämiin todellisiin mittoihin."],"fr":["Met une expression en relation avec un rapport entre les distances horizontales dans un contenu cartographique d’une expression et les distances réelles qu’elles représentent."],"hu":["Hozzákapcsol egy kifejezési formát a vízszintes távolságok arányához egy forrás kartográfiai tartalmában, amely a tényleges távolságokat képviseli és reprezentálja."],"lv":["Sasaista izteiksmi ar resursa kartogrāfiskajā saturā - horizontālā attāluma attiecību pret faktisko attālumu dabā."],"nl":["Relateert een expressie aan een verhouding van horizontale afstanden in cartografische inhoud van een expressie tot de werkelijke afstanden die ze weergeven."],"no":["Relaterer et uttrykk til et forhold mellom horisontale avstander i kartografisk innhold i et uttrykk og de faktiske avstandene de representerer."],"tr":["Bir anlatımı, bir anlatımın kartografik içeriğindeki yatay mesafeleri temsil ettikleri asıl mesafelere oranıyla.ilişkilendirir."],"vi":["Liên kết một biểu hiện với tỷ số của các khoảng cách nằm ngang trong nội dung bản đồ của biểu hiện với khoảng cách thực tế.mà chúng trình bày."],"zh-Hans-CN":["将一种内容表达与内容表达的地图内容的水平距离与它代表的实际距离的比关联起来。"]},"ToolkitLabel":{"ar":"مقياس أفقي لمحتوى رسم خرائطي","ca":"escala horitzontal d’un contingut cartogràfic","cs":"horizontální měřítko kartografického obsahu","da":"horisontal målestok for kartografisk indhold","de":"Horizontaler Maßstab bei kartografischem Inhalt","de":"horizontaler Maßstab bei kartografischem Inhalt","el":"οριζόντια κλίμακα του χαρτογραφικού περιεχομένου","en":"horizontal scale of cartographic content","es":"escala horizontal de contenido cartográfico","et":"kartograafilise sisu horisontaalne mõõtkava","fi":"kartografisen sisällön horisontaalinen mittakaava","fr":"échelle des longueurs d’un contenu cartographique","hu":"kartográfiai tartalom vízszintes méretaránya:","lv":"kartogrāfiskā satura horizontālais mērogs","nl":"horizontale schaal van cartografische content","no":"horisontal målestokk for kartografisk innhold","tr":"kartografik içeriğin yatay ölçeği ile ilişkilidir","vi":"tỷ lệ ngang của nội dung bản đồ","zh-Hans-CN":"地图内容的水平比例尺"},"ToolkitDefinition":{"ar":"نسبة مسافات أفقية في محتوى رسم خرائطي لتعبيرة بالمسافات الفعلية التي يمثلها.","ca":"Relació entre les distàncies horitzontals d’un contingut cartogràfic d’una expressió i les distàncies reals que representen.","cs":"Poměr horizontálních vzdáleností v kartografickém obsahu vyjádření a skutečných vzdáleností, které reprezentují.","da":"Forhold mellem horisontale afstande i et udtryks kartografiske indhold og de virkelige afstande, de repræsenterer.","de":"Ein Verhältnis der horizontalen Entfernungen bei kartografischem Inhalt einer Expression zu den tatsächlichen Entfernungen, die sie repräsentieren.","de":"Ein Verhältnis der horizontalen Entfernungen bei kartografischem Inhalt einer Expression zu den tatsächlichen Entfernungen, die sie repräsentieren.","el":"Ο λόγος των οριζόντιων αποστάσεων στο χαρτογραφικό περιεχόμενο μιας έκφρασης προς τις πραγματικές αποστάσεις που αναπαριστούν.","en":"A ratio of horizontal distances in cartographic content of an expression to the actual distances they represent.","es":"Una proporción de distancias horizontales en el contenido cartográfico de una expresión con las distancias reales que representan.","et":"Väljenduse kartograafilise sisu horisontaalsete vahemaade ja nende esindatud tegelike vahemaade suhe.","fi":"Ekspression kartografisen sisällön horisontaalisten etäisyyksien suhde niiden esittämiin todellisiin mittoihin.","fr":"Rapport entre les distances horizontales dans un contenu cartographique d’une expression et les distances réelles qu’elles représentent.","hu":"Vízszintes távolságok aránya egy forrás kartográfiai tartalmában, amely a tényleges távolságokat képviseli és reprezentálja.","lv":"Resursa kartogrāfiskajā saturā - horizontālā attāluma attiecība pret faktisko attālumu dabā.","nl":"Een verhouding van horizontale afstanden in cartografische inhoud van een expressie tot de werkelijke afstanden die ze weergeven.","no":"Et forhold mellom horisontale avstander i kartografisk innhold i et uttrykk og de faktiske avstandene de representerer.","tr":"Bir anlatımın kartografik içeriğindeki yatay mesafelerin temsil ettikleri asıl mesafelere oranı.","vi":"Tỷ số của các khoảng cách nằm ngang trong nội dung bản đồ của biểu hiện với khoảng cách thực tế.mà chúng trình bày.","zh-Hans-CN":"内容表达的地图内容的水平距离与它代表的实际距离的比"},"label":{"ar":"لها مقياس أفقي لمحتوى رسم خرائطي","ca":"té com a escala horitzontal d’un contingut cartogràfic","cs":"má horizontální měřítko kartografického obsahu","da":"har horisontal målestok for kartografisk indhold","de":"hat horizontalen Maßstab bei kartografischem Inhalt","de":"hat horizontalen Maßstab bei kartografischem Inhalt","el":"έχει οριζόντια κλίμακα του χαρτογραφικού περιεχομένου","en":"has horizontal scale of cartographic content","es":"tiene escala horizontal de contenido cartográfico","et":"kartograafilise sisu horisontaalne mõõtkava","fi":"kartografisen sisällön horisontaalinen mittakaava","fr":"a pour échelle des longueurs d’un contenu cartographique","hu":"kartográfiai tartalom vízszintes méretaránya a következő:","lv":"kartogrāfiskā satura horizontālais mērogs","nl":"heeft horizontale schaal van cartografische content","no":"har horisontal målestokk for kartografisk innhold","tr":"kartografik içeriğin yatay ölçeği ile ilişkilidir","vi":"có tỷ lệ ngang của nội dung bản đồ","zh-Hans-CN":"有地图内容的水平比例尺"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20228", "lexicalAlias":"http://rdaregistry.info/Elements/e/scale.en", "label":"has scale"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/horizontalScaleOfCartographicContent.en","instructionNumber":"7.25.3","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20226", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/horizontalScaleOfCartographicContent.en", "label":"has horizontal scale of cartographic content"}]},{"@id":"http://rdaregistry.info/Elements/e/P20042","definition":{"ca":["Relaciona una expressió amb un agent que contribueix a una expressió d’una obra o bé proporcionant una cartografia addicional o bé modificant la cartografia anterior."],"da":["Relaterer et udtryk til en agent, der har bidraget til et udtryk af et værk ved at tilvejebringe ekstra kartografi eller ved at ændre tidligere kartografi."],"de":["Setzt eine Expression mit einem Akteur, der zu einer Expression eines Werks beiträgt, indem er zusätzliche Kartografie liefert oder vorhandene Kartografie modifiziert, in Beziehung."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας πρόσθετη χαρτογράφηση ή τροποποιώντας την προηγούμενη χαρτογράφηση."],"en":["Relates an expression to an agent who contributes to an expression by providing additional cartography, or by modifying previous cartography. (Deprecated)"],"fi":["Liittää ekspression toimijaan, joka osallistuu teoksen ekspression tekemiseen täydentämällä teosta kartta-aineistolla tai muokkaamalla aiempaa karttateosta."],"fr":["Met une expression en relation avec un agent qui contribue à une expression d’une œuvre en fournissant une cartographie additionnelle ou en modifiant une cartographie antérieure."],"hu":["Egy kifejezési formát hozzákapcsol egy ágenshez (személyhez, családhoz vagy testülethez), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy további kartográfiát ad hozzá, vagy korábbi kartográfiát módosít."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp thuật vẽ bản đồ, hoặc bằng cách thay đổi thuật vẽ bản đồ trước đó."]},"ToolkitLabel":{"ca":"cartògraf (expressió)","da":"kartograf (udtryk)","de":"Kartograf (Expression)","el":"χαρτογράφος (έκφραση)","en":"cartographer of expression (Deprecated)","es":"cartógrafo (expresión)","fi":"kartantekijä (ekspressio)","fr":"cartographe (expression)","hu":"térképész (kifejezési forma)","no":"kartograf (uttrykk)","vi":"người vẽ bản đồ (biểu hiện)"},"ToolkitDefinition":{"ca":"Agent que contribueix a una expressió d’una obra o bé proporcionant una cartografia addicional o bé modificant la cartografia anterior.","da":"Agent, der har bidraget til et udtryk af et værk ved at tilvejebringe ekstra kartografi eller ved at ændre tidligere kartografi.","de":"Ein Akteur, der zu einer Expression eines Werks beiträgt, indem er zusätzliche Kartografie liefert oder vorhandene Kartografie modifiziert.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας πρόσθετη χαρτογράφηση ή τροποποιώντας την προηγούμενη χαρτογράφηση. .","en":"An agent who contributes to an expression by providing additional cartography, or by modifying previous cartography. (Deprecated)","es":"Una persona, familia o entidad corporativa que contribuye a una expresión de una obra proporcionando cartografía adicional o modificando la cartografía anterior.","fi":"Toimija, joka osallistuu teoksen ekspression tekemiseen täydentämällä teosta kartta-aineistolla tai muokkaamalla aiempaa karttateosta.","fr":"Agent qui contribue à une expression d’une œuvre en fournissant une cartographie additionnelle ou en modifiant une cartographie antérieure.","hu":"Egy ágens (személy, család vagy testület), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy további kartográfiát ad hozzá, vagy módosítja a korábbi kartográfiát.","no":"En agent som bidrar til et uttrykk av et verk ved å tilføre ytterligere kartografi eller ved å endre den tidligere kartografien.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp thuật vẽ bản đồ, hoặc bằng cách thay đổi thuật vẽ bản đồ trước đó."},"label":{"ca":"té com a cartògraf (expressió)","da":"har kartograf (udtryk)","de":"hat Kartograf (Expression)","el":"έχει χαρτογράφο (έκφραση)","en":"has cartographer of expression (Deprecated)","fi":"kartantekijä (ekspressio)","fr":"a pour cartographe (expression)","hu":"van térképésze (kifejezési forma)","vi":"có người vẽ bản đồ (biểu hiện)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/cartographerOfExpression.en","instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20578", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorToAggregatedContent.en", "label":"has contributor to aggregated content (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20042", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/cartographerOfExpression.en", "label":"has cartographer of expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20042", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/cartographerOfExpression.en", "label":"has cartographer of expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20312","label":{"ar":"لها عنوان لتعبيرة","ca":"té com a títol d’expressió","cs":"má název vyjádření","da":"har titel på udtryk","de":"hat Titel einer Expression","de":"hat Titel einer Expression","en":"has title of expression","es":"tiene título de expresión","et":"väljenduse pealkiri","fi":"ekspression nimeke","fr":"a pour titre d’expression","hu":"kifejezési forma címe a következő:","lv":"izteiksmes nosaukums","nl":"heeft titel van expressie","no":"har tittel for uttrykk","tr":"anlatım başlığı ile ilişkilidir","zh-Hans-CN":"有内容表达的题名"},"definition":{"ar":["تربط بين تعبيرة واسم تعريفي لتعبيرة في اللغة الطبيعية وفي العبارات المستخدمة في الخطاب العام."],"ca":["Relaciona una expressió amb un nomen que és una apel·lació d’expressió en llenguatge i frases naturals usada en el discurs comú."],"cs":["Vztahuje vyjádření k nomen, které je pojmenováním vyjádření v přirozeném jazyce a formulacích používaných v běžné řeči."],"da":["Relaterer et udtryk til en benævnelse på udtryk på normalsprog og med formuleringer, som bruges alment."],"de":["Setzt eine Expression in Beziehung zu einer Bezeichnung für eine Expression in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.,Setzt eine Exemplar in Beziehung zu einer Bezeichnung für ein Exemplar in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird."],"en":["Relates an expression to a nomen that is an appellation of expression in natural language and phrasing used in common discourse."],"es":["Relaciona una expresión con un nomen que es una denominación de expresión en lenguaje natural y fraseo utilizado en el discurso común."],"et":["Seostab väljenduse väljenduse nimetusega loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses."],"fi":["Liittää ekspression luonnollisella kielellä ja sanamuodolla olevaan, yleisessä diskurssissa käytettyyn ekspression nimitykseen."],"fr":["Met une expression en relation avec un nomen qui est une appellation d’expression exprimée dans un langage et une formulation naturels et utilisée dans le langage courant."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma természetes nyelvi megnevezéséhez és közbeszédben használt megfogalmazásához."],"lv":["Sasaista izteiksmi ar izteiksmes apzīmējumu dabiskā valodā un frāzēs, kas tiek lietots savstarpējā saziņā."],"nl":["Relateert een expressie aan een nomen dat is een aanduiding van expressie in natuurlijke taal en formulering in gebruikelijke bewoording."],"no":["Relaterer et uttrykk til en betegnelse for et uttrykk på et naturlig språk og med en frasering som brukes i vanlig diskurs."],"tr":["Bir anlatımı, doğal dilde ve ortak söylemde kullanılan ifadelerdeki bir anlatım unvanı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为用自然语言和普通话语措词表达的内容表达的称谓的一个命名关联起来。"]},"ToolkitLabel":{"ar":"عنوان لتعبيرة","ca":"títol d’expressió","cs":"název vyjádření","da":"titel på udtryk","de":"Titel einer Expression","de":"Titel einer Expression","en":"title of expression","es":"título de expresión","et":"väljenduse pealkiri","fi":"ekspression nimeke","fr":"titre d’expression","hu":"kifejezési forma címe:","lv":"izteiksmes nosaukums","nl":"titel van expressie","no":"tittel for uttrykk","tr":"anlatımın başlığı","zh-Hans-CN":"内容表达的题名"},"ToolkitDefinition":{"ar":"اسم تعريفي لتعبيرة في اللغة الطبيعية وفي العبارات المستخدمة في الخطاب العام.","ca":"Nomen que és una apel·lació d’expressió en llenguatge i frases naturals usada en el discurs comú.","cs":"Nomen, které je pojmenováním vyjádření v přirozeném jazyce a formulacích používaných v běžné řeči.","da":"Benævnelse på udtryk på normalsprog og med formuleringer, som bruges alment.","de":"Eine Bezeichnung für eine Expression in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.","de":"Eine Bezeichnung für einen Zeitraum in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.","en":"A nomen that is an appellation of expression in natural language and phrasing used in common discourse.","es":"Un nomen que es una denominación de expresión en lenguaje natural y fraseo utilizado en el discurso común.","et":"Väljenduse nimetus loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses.","fi":"Luonnollisella kielellä ja sanamuodolla oleva, yleisessä diskurssissa käytetty ekspression nimitys.","fr":"Nomen qui est une appellation d’expression exprimée dans un langage et une formulation naturels et utilisée dans le langage courant.","hu":"Egy kifejezési forma természetes nyelvi megnevezéséhez és közbeszédben használt megfogalmazása.","lv":"Izteiksmes apzīmējums dabiskā valodā un frāzēs, kas tiek lietots savstarpējā saziņā.","nl":"Een nomen dat is een aanduiding van expressie in natuurlijke taal en formulering in gebruikelijke bewoording.","no":"En betegnelse for et uttrykk på et naturlig språk og med en frasering som brukes i vanlig diskurs.","tr":"Doğal dilde ve ortak söylemde kullanılan ifadelerde bir anlatımın unvanı olan bir isim.","zh-Hans-CN":"作为用自然语言和普通话语措词表达的内容表达的称谓的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20311", "lexicalAlias":"http://rdaregistry.info/Elements/e/appellationOfExpression.en", "label":"has appellation of expression"},{"@id":"http://rdaregistry.info/Elements/x/P00019", "lexicalAlias":"http://rdaregistry.info/Elements/x/nameOfRDAEntity.en", "label":"has name of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/titleOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20315", "lexicalAlias":"http://rdaregistry.info/Elements/e/preferredTitleOfExpression.en", "label":"has preferred title of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20316", "lexicalAlias":"http://rdaregistry.info/Elements/e/variantTitleOfExpression.en", "label":"has variant title of expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20312", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/titleOfExpression.en", "label":"has title of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20312", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/titleOfExpression.en", "label":"has title of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20109","definition":{"ar":["تربط بين وتعبيرة وتعبيرة لعمل يتكون من محتوى موجز ويعَد ضروريًا لاستكمال تعبيرة لعمل ذي صلة."],"ca":["Relaciona una expressió amb una expressió d’una obra que consisteix en un contingut breu que és essencial per a la completesa d’una expressió d’una obra relacionada."],"cs":["Vztahuje vyjádření k vyjádření díla, sestávajícího ze stručného obsahu, který je podstatný pro úplnost vyjádření souvisejícího díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som består af kortfattet indhold, som er væsentligt for fuldstændigheden af et udtryk af et relateret værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus kurzem Inhalt besteht, der für die Vollständigkeit einer Expression eines in Beziehung stehenden Werks notwendig ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus kurzem Inhalt besteht, der für die Vollständigkeit einer Expression eines in Beziehung stehenden Werks notwendig ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συνίσταται από ένα σύντομο περιεχόμενο που είναι ουσιώδες για την πληρότητα μιας έκφρασης ενός άλλου έργου."],"en":["Relates an expression to an expression of a work consisting of brief content that is essential for the completeness of an expression of a related work."],"es":["Relaciona una expresión con una expresión de una obra que consta de un contenido breve que es esencial para la integridad de una expresión de una obra relacionada."],"et":["Seostab väljenduse teose väljendusega, mille sisu on lühike, kuid hädavajalik seotud teose väljenduse terviklikkuse seisukohast."],"fi":["Liittää ekspression teoksen ekspressioon, joka koostuu suppeasta sisällöstä, joka on olennainen siihen liittyvän teoksen kokonaisuudelle."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en un bref contenu essentiel à la complétude d’une expression d’une œuvre en relation."],"hu":["Hozzákapcsol egy kifejezési formát egy rövid tartalomból álló mű kifejezési formájához, amely nélkülözhetetlen egy kapcsolódó mű teljességéhez."],"lv":["Sasaista izteiksmi ar darba izteiksmi - īss saturs, kas ir būtisks saistītā darba pilnīgumam."],"nl":["Relateert een expressie aan een expressie van een werk dat bestaat uit korte content die essentieel is voor de volledigheid van een expressie van een gerelateerd werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som består av kortfattet innhold som er avgjørende for at et uttrykk av et relatert verk skal være fullstendig."],"tr":["B