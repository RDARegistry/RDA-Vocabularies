                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20560", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorFamily.en", "label":"has conductor family"},{"@id":"http://rdaregistry.info/Elements/e/P20427", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorCollectiveAgent.en", "label":"has instrumental conductor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20545", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/instrumentalConductorFamily.en", "label":"has instrumental conductor family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20545", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/instrumentalConductorFamily.en", "label":"has instrumental conductor family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20368","label":{"ar":"لها شخص مايسترو فرقة عزف","ca":"té com a persona directora instrumental","cs":"má dirigenta instrumentálního souboru (osobu)","da":"har person, som er instrumentaldirigent","de":"hat Orchesterleiterin/Orchesterleiter (Person)","de":"hat Orchesterleiterin/Orchesterleiter (Person)","en":"has instrumental conductor person","es":"tiene persona conductora instrumental","et":"orkestrijuht (isik)","fi":"kapellimestari (henkilö)","fr":"a pour personne chef d’orchestre","hu":"zenekari karmester személye a következő:","lv":"orķestra diriģents (persona)","nl":"heeft instrumentaal dirigent-persoon","no":"har instrumentaldirigent (person)","tr":"enstrüman şefi kişisi ile ilişkilidir","zh-Hans-CN":"有器乐指挥个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مايسترو يساهم في تعبيرة من خلال قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió dirigint un grup instrumental en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že řídí instrumentální skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en person, som er dirigent, som bidrager til et udtryk ved at lede en optrædende instrumentalgruppe i en musikalsk eller dramatisk præsentation."],"de":["Setzt eine Expression in Beziehung zu einer Dirigentin/einem Dirigenten (Person), die/der zu einer Expression beiträgt, indem sie/er eine Instrumentalgruppe in einer musikalischen oder dramatischen Darbietung leitet.,Setzt eine Expression in Beziehung zu einer Dirigentin/einem Dirigenten (Person), die/der zu einer Expression beiträgt, indem sie/er eine Instrumentalgruppe in einer musikalischen oder dramatischen Darbietung leitet."],"en":["Relates an expression to a person who contributes to an expression by leading an instrumental performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con una persona que contribuye a una expresión dirigiendo un grupo de interpretación instrumental en una presentación musical o dramática."],"et":["Seostab väljenduse isikuga, kes dirigendina annab panuse väljendusse, juhatades instrumentaalkoosseisu muusika- või draamaetenduses."],"fi":["Liittää ekspression henkilöön, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla soitinryhmää musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en dirigeant un groupe d’instrumentistes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy karmester személyhez, aki hozzájárul egy kifejezési formához azzal, hogy hangszeres előadói csoportot vezet egy zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar personu, kura līdzdarbojas muzikālā darba izteiksmē, diriģējot instrumentālās mūzikas grupu muzikālā vai dramatiskā uzvedumā, u.tml."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het leiden van een optredende instrumentale groep in een muzikale of dramatische presentatie."],"no":["Relaterer et uttrykk til en person som er en dirigent som bidrar til et uttrykk ved å lede en instrumentalgruppe i en musikalsk eller dramatisk forestilling."],"tr":["Bir anlatımı, müzikal veya dramatik bir sunumda enstrümantal bir performans grubuna liderlik ederek bir anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过在一个音乐或戏剧呈现中领导一个器乐表演团队而对一种内容表达作出贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مايسترو فرقة عزف","ca":"persona directora instrumental","cs":"dirigent instrumentálního souboru (osoba)","da":"person, som er instrumentaldirigent","de":"Orchesterleiterin/Orchesterleiter (Person)","de":"Orchesterleiterin/Orchesterleiter (Person)","en":"instrumental conductor person","es":"persona conductora instrumental","et":"orkestrijuht (isik)","fi":"kapellimestari (henkilö)","fr":"personne chef d’orchestre","hu":"zenekari karmester személy:","lv":"orķestra diriģents (persona)","nl":"instrumentaal dirigent-persoon","no":"instrumentaldirigent (person)","tr":"enstrüman şefi kişisi ile ilişkilidir","zh-Hans-CN":"器乐指挥个人"},"ToolkitDefinition":{"ar":"شخص يكون مايسترو يساهم في تعبيرة من خلال قيادة فريق كورال في عرض موسيقي أو درامي.","ca":"Persona que contribueix a una expressió dirigint un grup instrumental en una representació musical o dramàtica.","cs":"Osoba, která přispívá k vyjádření tím, že řídí instrumentální skupinu v hudebním nebo dramatickém vystoupení.","da":"Person, som er dirigent, som bidrager til et udtryk ved at lede en optrædende instrumentalgruppe i en musikalsk eller dramatisk præsentation.","de":"Eine Dirigentin/Ein Dirigent (Person), die/der zu einer Expression beiträgt, indem sie/er eine Instrumentalgruppe in einer musikalischen oder dramatischen Darbietung leitet.","de":"Eine Dirigentin/Ein Dirigent (Person), die/der zu einer Expression beiträgt, indem sie/er eine Instrumentalgruppe in einer musikalischen oder dramatischen Darbietung leitet.","en":"A person who contributes to an expression by leading an instrumental performing group in a musical or dramatic presentation.","es":"Una persona que contribuye a una expresión dirigiendo un grupo de interpretación instrumental en una presentación musical o dramática.","et":"Isik, kes dirigendina annab panuse väljendusse, juhatades instrumentaalkoosseisu muusika- või draamaetenduses.","fi":"Henkilö, joka on johtaja, joka osallistuu ekspression tekemiseen johtamalla soitinryhmää musiikki- tai näytelmäesityksessä.","fr":"Personne qui contribue à une expression en dirigeant un groupe d’instrumentistes dans une présentation musicale ou dramatique.","hu":"Egy karmester személy, aki hozzájárul egy kifejezési formához azzal, hogy hangszeres előadói csoportot vezet egy zenei vagy drámai bemutatóban.","lv":"Persona, kura līdzdarbojas muzikālā darba izteiksmē, diriģējot instrumentālās mūzikas grupu muzikālā vai dramatiskā uzvedumā, u.tml.","nl":"Een persoon die bijdraagt aan een expressie door het leiden van een optredende instrumentale groep in een muzikale of dramatische presentatie.","no":"En person som er en dirigent som bidrar til et uttrykk ved å lede en instrumentalgruppe i en musikalsk eller dramatisk forestilling.","tr":"Müzikal veya dramatik bir sunumda enstrümantal performans grubuna önderlik ederek bir anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过在一个音乐或戏剧呈现中领导一个器乐表演团队而对一种内容表达作出贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20383", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorPerson.en", "label":"has conductor person"},{"@id":"http://rdaregistry.info/Elements/e/P20286", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorAgent.en", "label":"has instrumental conductor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20368", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/instrumentalConductorPerson.en", "label":"has instrumental conductor person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20368", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/instrumentalConductorPerson.en", "label":"has instrumental conductor person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20020","label":{"ar":"لها وكيل عازف","ca":"té com a agent instrumentista","cs":"má instrumentalistu (agenta)","da":"har agent, som er instrumentalist","de":"hat Instrumentalmusikerin/Instrumentalmusiker (Akteur)","de":"hat Instrumentalmusikerin/Instrumentalmusiker (Akteur)","el":"έχει εκτελεστή","en":"has instrumentalist agent","es":"tiene agente instrumentista","et":"instrumentalist (tegija)","fi":"soittaja (toimija)","fr":"a pour agent instrumentiste","hu":"zenész ágense a következő:","lv":"instrumentālists (aģents)","nl":"heeft instrumentalist-actor","no":"har instrumentalist (agent)","tr":"enstrüman sanatçısı temsilcisi ile ilişkilidir","vi":"cónhạc công","zh-Hans-CN":"有乐器演奏者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مؤديًا يساهم في تعبيرة من خلال العزف على آلة موسيقية."],"ca":["Relaciona una expressió amb un agent que és un intèrpret que contribueix a una expressió tocant un instrument musical."],"cs":["Vztahuje vyjádření k agentovi, který je účinkujícím, který přispívá k vyjádření tím, že hraje na hudební nástroj."],"da":["Relaterer et udtryk til en agent, som er en udøver, som bidrager til et udtryk ved at spille et musikinstrument."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt."],"el":["Συνδέει μια έκφραση με έναν εκτελεστή ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της εκτέλεσης ενός μουσικού οργάνου."],"en":["Relates an expression to an agent who is a performer who contributes to an expression by playing a musical instrument."],"es":["Relaciona una expresión con un agente que es un intérprete que contribuye a una expresión tocando un instrumento musical."],"et":["Seostab väljenduse tegijaga, kes esitajana annab panuse väljendusse, mängides muusikainstrumenti."],"fi":["Liittää ekspression toimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta."],"fr":["Met une expression en relation avec un agent interprète qui contribue à une expression en jouant d’un instrument de musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó ágenshez, amely hangszeren játszik és ezzel hozzájárul egy kifejezési formához."],"lv":["Sasaista izteiksmi ar aģentu, kas ir izpildītājs, kas sniedzis ieguldījumu izteiksmē, spēlējot mūzikas instrumentu."],"nl":["Relateert een expressie aan een actor die een uitvoerder is die bijdraagt aan een expressie door het spelen van een muziekinstrument."],"no":["Relaterer et uttrykk til en agent som er en utøver som bidrar til et uttrykk ved å spille et musikkinstrument."],"tr":["Bir anlatımı, müzik aleti çalarak anlatıma katkıda bulunan bir sanatçı olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách chơi nhạc cụ."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过演奏乐器对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل عازف","ca":"agent instrumentista","cs":"instrumentalista (agent)","da":"agent, som er instrumentalist","de":"Instrumentalmusikerin/Instrumentalmusiker (Akteur)","de":"Instrumentalmusikerin/Instrumentalmusiker (Akteur)","el":"εκτελεστής","en":"instrumentalist agent","es":"agente instrumentista","et":"instrumentalist (tegija)","fi":"soittaja (toimija)","fr":"agent instrumentiste","hu":"zenész ágens:","lv":"instrumentālists (aģents)","nl":"instrumentalist-actor","no":"instrumentalist (agent)","tr":"enstrümantalist temsilcisi ile ilişkilidir","vi":"nhạc công","zh-Hans-CN":"乐器演奏者行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤديًا يساهم في تعبيرة من خلال العزف على آلة موسيقية.","ca":"Agent que és un intèrpret que contribueix a una expressió tocant un instrument musical.","cs":"Agent, který je účinkujícím, který přispívá k vyjádření tím, že hraje na hudební nástroj.","da":"Agent, som er en udøver, som bidrager til et udtryk ved at spille et musikinstrument.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er ein Musikinstrument spielt.","el":"Ένας εκτελεστής ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της εκτέλεσης ενός μουσικού οργάνου.","en":"An agent who is a performer who contributes to an expression by playing a musical instrument.","es":"Un agente que es un intérprete que contribuye a una expresión tocando un instrumento musical.","et":"Tegija, kes esitajana annab panuse väljendusse, mängides muusikainstrumenti.","fi":"Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen soittamalla soitinta.","fr":"Agent interprète qui contribue à une expression en jouant d’un instrument de musique.","hu":"Egy előadó ágens, amely hangszeren játszik és ezzel hozzájárul egy kifejezési formához.","lv":"Aģents - izpildītājs, kas sniedzis ieguldījumu izteiksmē, spēlējot mūzikas instrumentu.","nl":"Een actor die een uitvoerder is die bijdraagt aan een expressie door het spelen van een muziekinstrument.","no":"En agent som er en utøver som bidrar til et uttrykk ved å spille et musikkinstrument.","tr":"Bir müzik aleti çalarak bir anlatıma katkıda bulunan bir sanatçı olan temsilci.","vi":"Người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách chơi nhạc cụ.","zh-Hans-CN":"作为一个表演者通过演奏乐器对一种内容表达有贡献的一个行为者"},"altLabel":{"ar":["عازف"],"ca":["instrumentista"],"cs":["instrumentalista"],"da":["instrumentalist"],"de":["Instrumentalmusiker,Instrumentalmusiker"],"en":["instrumentalist"],"es":["instrumentista"],"et":["instrumentalist"],"fi":["soittaja"],"fr":["instrumentiste"],"hu":["zenész:"],"nl":["instrumentalist"],"no":["instrumentalist"],"tr":["enstrümantalist temsilcisi ile ilişkilidir"],"zh-Hans-CN":["乐器演奏者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
