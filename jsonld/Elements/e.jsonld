                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20202", "lexicalAlias":"http://rdaregistry.info/Elements/e/describedInExpression.en", "label":"is described in (expression) (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/commentaryInExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20187","ToolkitDefinition":{"en":"An expression of a work that is used as the basis for a set of explanatory or critical notes. (Deprecated)"},"ToolkitLabel":{"en":"commentary on (expression) (Deprecated)"},"definition":{"en":["Relates an expression to an expression of a work that is used as the basis for a set of explanatory or critical notes. (Deprecated)"]},"label":{"en":"is commentary on (expression) (Deprecated)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20072", "lexicalAlias":"http://rdaregistry.info/Elements/e/descriptionOfExpression.en", "label":"is description of (expression) (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/commentaryOnExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20021","label":{"ar":"لها وكيل معلق","ca":"té com a agent comentarista","cs":"má komentátora (agenta)","da":"har agent, som er kommentator","de":"hat Kommentatorin/Kommentator (Akteur)","de":"hat Kommentatorin/Kommentator (Akteur)","el":"έχει σχολιαστή","en":"has commentator agent","es":"tiene agente comentarista","et":"kommentaator (tegija)","fi":"kommentaattori (toimija)","fr":"a pour agent commentateur","hu":"kommentátor ágense a következő:","lv":"komentētājs (aģents)","nl":"heeft commentator-actor","no":"har kommentator (agent)","tr":"yorumcu temsilci ile ilişkilidir","vi":"cóngười bình luận","zh-Hans-CN":"有解说员行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر."],"ca":["Relaciona una expressió amb un agent que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual."],"cs":["Vztahuje vyjádření k agentovi, který je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média."],"da":["Relaterer et udtryk til en agent, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert."],"el":["Συνδέει μια έκφραση με έναν εκτελεστή ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της ερμηνείας, ανάλυσης ή συζήτησης ενός θέματος σχετικά με μια ηχογράφηση, μια ταινία ή άλλο οπτικοακουστικό μέσο."],"en":["Relates an expression to an agent who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium."],"es":["Relaciona una expresión con un agente que es un intérprete que contribuye a una expresión proporcionando interpretación, análisis o discusión del tema en una grabación, película u otro medio audiovisual."],"et":["Seostab väljenduse tegijaga, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi teemat või arutledes selle üle."],"fi":["Liittää ekspression toimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä."],"fr":["Met une expression en relation avec un agent interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon."],"lv":["Sasaista izteiksmi ar aģentu, kas ir izpildītājs, kas sniedzis ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē."],"nl":["Relateert een expressie aan een actor die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium."],"no":["Relaterer et uttrykk til en agent som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium."],"tr":["Bir anlatımı, bir kayıt, film veya başka bir görsel-işitsel ortamda yorum, analiz veya konunun tartışılmasını sağlayarak bir anlatıma katkıda bulunan bir yorumcu olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách giải thích, phân tích, hoặc thảo luận nội dung chủ đề về ghi, dựng phim, hoặc phương tiện nghe nhìn khác."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل معلق","ca":"agent comentarista","cs":"komentátor (agent)","da":"agent, som er kommentator","de":"Kommentatorin/Kommentator (Akteur)","de":"Kommentatorin/Kommentator (Akteur)","el":"σχολιαστής","en":"commentator agent","es":"agente comentarista","et":"kommentaator (tegija)","fi":"kommentaattori (toimija)","fr":"agent commentateur","hu":"kommentátor ágens:","lv":"komentētājs (aģents)","nl":"commentator-actor","no":"kommentator (agent)","tr":"yorumcu temsilcisi","vi":"người bình luận","zh-Hans-CN":"解说员行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر.","ca":"Agent que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual.","cs":"Agent, který je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média.","da":"Agent, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","el":"Ένας εκτελεστής ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της ερμηνείας, ανάλυσης ή συζήτησης ενός θέματος σχετικά με μια ηχογράφηση, μια ταινία ή άλλο οπτικοακουστικό μέσο.","en":"An agent who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium.","es":"Un agente que es un intérprete que contribuye a una expresión proporcionando interpretación, análisis o discusión del tema en una grabación, película u otro medio audiovisual.","et":"Tegija, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi teemat või arutledes selle üle.","fi":"Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä.","fr":"Agent interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel.","hu":"Egy előadó ágens, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon.","lv":"Aģents - izpildītājs, kas sniedzis ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē.","nl":"Een actor die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium.","no":"En agent som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium.","tr":"Bir kayıtta, filmde veya başka bir görsel-işitsel ortamda konunun yorumunu, analizini veya tartışmasını sağlayarak bir anlatıma katkıda bulunan bir sanatçı olan temsilci.","vi":"Người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách giải thích, phân tích, hoặc thảo luận nội dung chủ đề về ghi, dựng phim, hoặc phương tiện nghe nhìn khác.","zh-Hans-CN":"作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个行为者"},"altLabel":{"ar":["معلق"],"ca":["comentarista"],"cs":["komentátor"],"da":["kommentator"],"de":["Kommentator,Kommentator"],"en":["commentator"],"es":["comentarista"],"et":["kommentaator"],"fi":["kommentaattori"],"fr":["commentateur"],"hu":["kommentáror:"],"nl":["commentator"],"no":["kommentator"],"tr":["yorumcu"],"zh-Hans-CN":["解说员"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20436", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCollectiveAgent.en", "label":"has commentator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20377", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorPerson.en", "label":"has commentator person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20021", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/commentatorAgent.en", "label":"has commentator agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20021", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/commentatorAgent.en", "label":"has commentator agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20436","label":{"ar":"لها وكيل جماعي معلق","ca":"té com a agent col·lectiu comentarista","cs":"má komentátora (kolektivního agenta)","da":"har kollektiv agent, som er kommentator","de":"hat Kommentatorin/Kommentator (Gemeinschaftlicher Akteur)","de":"hat Kommentatorin/Kommentator (Gemeinschaftlicher Akteur)","en":"has commentator collective agent","es":"tiene agente colectivo comentarista","et":"kommentaator (kollektiiv)","fi":"kommentaattori (yhteistoimija)","fr":"a pour agent collectif commentateur","hu":"kommentátor kollektív ágense a következő:","lv":"komentētājs (grupa)","nl":"heeft commentator-collectieve actor","no":"har kommentator (kollektiv agent)","tr":"yorumcu kolektif temsilci ile ilişkilidir","zh-Hans-CN":"有解说员集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر."],"ca":["Relaciona una expressió amb un agent col·lectiu que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média."],"da":["Relaterer et udtryk til en kollektiv agent, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert."],"en":["Relates an expression to a collective agent who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium."],"es":["Relaciona una expresión con un agente colectivo que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, filmación u otro medio audiovisual."],"et":["Seostab väljenduse kollektiiviga, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle."],"fi":["Liittää ekspression yhteistoimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä."],"fr":["Met une expression en relation avec un agent collectif interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó kollektív ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon."],"lv":["Sasaista izteiksmi ar grupu, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē."],"nl":["Relateert een expressie aan een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium."],"no":["Relaterer et uttrykk til en kollektiv agent som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium."],"tr":["Bir anlatımı, bir kayıt, film veya başka bir görsel-işitsel ortamda yorum, analiz veya konunun tartışılmasını sağlayarak bir anlatıma katkıda bulunan bir yorumcu olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي معلق","ca":"agent col·lectiu comentarista","cs":"komentátor (kolektivní agent)","da":"kollektiv agent, som er kommentator","de":"Kommentatorin/Kommentator (Gemeinschaftlicher Akteur)","de":"Kommentatorin/Kommentator (Gemeinschaftlicher Akteur)","en":"commentator collective agent","es":"agente colectivo comentarista","et":"kommentaator (kollektiiv)","fi":"kommentaattori (yhteistoimija)","fr":"agent collectif commentateur","hu":"kommentátor kollektív ágens:","lv":"komentētājs (grupa)","nl":"commentator-collectieve actor","no":"kommentator (kollektiv agent)","tr":"yorumcu kolektif temsilcisi","zh-Hans-CN":"解说员集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر.","ca":"Agent col·lectiu que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual.","cs":"Kolektivní agent, který je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média.","da":"Kollektiv agent, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","en":"A collective agent who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium.","es":"Un agente colectivo que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, filmación u otro medio audiovisual.","et":"Kollektiiv, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle.","fi":"Yhteistoimija, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä.","fr":"Agent collectif interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel.","hu":"Egy előadó kollektív ágens, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon.","lv":"Grupa - izpildītājs, kas sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē.","nl":"Een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium.","no":"En kollektiv agent som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium.","tr":"Bir ifadeyi, yüksek sesle okuyarak veya bir eylemi, oluşu veya başka bir olayı anlatarak ifadeye katkıda bulunan bir sanatçı olan kolektif bir temsilciyle ilişkilendirir.","zh-Hans-CN":"作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20021", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorAgent.en", "label":"has commentator agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20495", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCorporateBody.en", "label":"has commentator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20554", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorFamily.en", "label":"has commentator family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20436", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/commentatorCollectiveAgent.en", "label":"has commentator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20436", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/commentatorCollectiveAgent.en", "label":"has commentator collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20495","label":{"ar":"لها هيئة معلقة","ca":"té com a entitat corporativa comentarista","cs":"má komentátora (korporaci)","da":"har korporation, som er kommentator","de":"hat Kommentatorin/Kommentator (Körperschaft)","de":"hat Kommentatorin/Kommentator (Körperschaft)","en":"has commentator corporate body","es":"tiene organismo corporativo comentarista","et":"kommentaator (asutus)","fi":"kommentaattori (yhteisö)","fr":"a pour collectivité commentatrice","hu":"kommentátor testülete a következő:","lv":"komentētājs (institūcija)","nl":"heeft commentator-corporatie","no":"har kommentator (korporasjon)","tr":"yorumcu tüzel kişi ile ilişkilidir","zh-Hans-CN":"有解说员团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر."],"ca":["Relaciona una expressió amb una entitat corporativa que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual."],"cs":["Vztahuje vyjádření ke korporaci, která je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média."],"da":["Relaterer et udtryk til en korporation, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert."],"en":["Relates an expression to a corporate body who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium."],"es":["Relaciona una expresión con un organismo corporativo que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, filmación u otro medio audiovisual."],"et":["Seostab väljenduse asutusega, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle."],"fi":["Liittää ekspression yhteisöön, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä."],"fr":["Met une expression en relation avec une collectivité interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó testülethez, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon."],"lv":["Sasaista izteiksmi ar institūciju, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē."],"nl":["Relateert een expressie aan een corporatie die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium."],"no":["Relaterer et uttrykk til en korporasjon som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium."],"tr":["Bir anlatımı, bir kayıt, film veya başka bir görsel-işitsel ortamda yorum, analiz veya konunun tartışılmasını sağlayarak bir anlatıma katkıda bulunan bir yorumcu olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة معلقة","ca":"entitat corporativa comentarista","cs":"komentátor (korporace)","da":"korporation, som er kommentator","de":"Kommentatorin/Kommentator (Körperschaft)","de":"Kommentatorin/Kommentator (Körperschaft)","en":"commentator corporate body","es":"organismo corporativo comentarista","et":"kommentaator (asutus)","fi":"kommentaattori (yhteisö)","fr":"collectivité commentatrice","hu":"kommentátor testület:","lv":"komentētājs (institūcija)","nl":"commentator-corporatie","no":"kommentator (korporasjon)","tr":"yorumcu tüzel kişisi","zh-Hans-CN":"解说员团体"},"ToolkitDefinition":{"ar":"هيئة تكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر.","ca":"Entitat corporativa que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual.","cs":"Korporace, která je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média.","da":"Korporation, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","en":"A corporate body who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium.","es":"Un organismo corporativo que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, filmación u otro medio audiovisual.","et":"Asutus, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle.","fi":"Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä.","fr":"Collectivité interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel.","hu":"Egy előadó testület, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon.","lv":"Institūcija - izpildītājs, kas sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē.","nl":"Een corporatie die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium.","no":"En korporasjon som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium.","tr":"Bir kayıt, film veya diğer görsel-işitsel ortamda konu hakkında yorum, analiz veya tartışma sağlayan ifadeye katkıda bulunan bir sanatçı olan bir tüzel kişidir.","zh-Hans-CN":"作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20436", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCollectiveAgent.en", "label":"has commentator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20495", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/commentatorCorporateBody.en", "label":"has commentator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20495", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/commentatorCorporateBody.en", "label":"has commentator corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20554","label":{"ar":"لها عائلة معلقة","ca":"té com a família comentarista","cs":"má komentátora (rodinu)","da":"har familie, som er kommentator","de":"hat Kommentatorin/Kommentator (Familie)","de":"hat Kommentatorin/Kommentator (Familie)","en":"has commentator family","es":"tiene familia comentarista","et":"kommentaator (perekond)","fi":"kommentaattori (suku)","fr":"a pour famille commentatrice","hu":"kommentátor családja a következő:","lv":"komentētājs (dzimta/ģimene)","nl":"heeft commentator-familie","no":"har kommentator (familie)","tr":"yorumcu aile ile ilişkilidir","zh-Hans-CN":"有解说员家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر."],"ca":["Relaciona una expressió amb una família que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual."],"cs":["Vztahuje vyjádření k rodině, která je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média."],"da":["Relaterer et udtryk til en familie, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert."],"en":["Relates an expression to a family who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium."],"es":["Relaciona una expresión con una familia que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, filmación u otro medio audiovisual."],"et":["Seostab väljenduse perekonnaga, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle."],"fi":["Liittää ekspression sukuun, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä."],"fr":["Met une expression en relation avec une famille interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó családhoz, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē."],"nl":["Relateert een expressie aan een familie die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium."],"no":["Relaterer et uttrykk til en familie som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium."],"tr":["Bir anlatımı, bir kayıt, film veya başka bir görsel-işitsel ortamda yorum, analiz veya konunun tartışılmasını sağlayarak bir anlatıma katkıda bulunan bir yorumcu olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة معلقة","ca":"família comentarista","cs":"komentátor (rodina)","da":"familie, som er kommentator","de":"Kommentatorin/Kommentator (Familie)","de":"Kommentatorin/Kommentator (Familie)","en":"commentator family","es":"familia comentarista","et":"kommentaator (perekond)","fi":"kommentaattori (suku)","fr":"famille commentatrice","hu":"kommentátor család:","lv":"komentētājs (dzimta/ģimene)","nl":"commentator-familie","no":"kommentator (familie)","tr":"yorumcu ailesi","zh-Hans-CN":"解说员家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر.","ca":"Família que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual.","cs":"Rodina, která je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média.","da":"Familie, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","en":"A family who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium.","es":"Una familia que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, filmación u otro medio audiovisual.","et":"Perekond, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle.","fi":"Suku, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä.","fr":"Famille interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel.","hu":"Egy előadó család, amely hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon.","lv":"Dzimta/ģimene - izpildītājs, kas sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē.","nl":"Een familie die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium.","no":"En familie som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium.","tr":"Bir kayıt, film veya başka bir görsel-işitsel ortamda konuyla ilgili yorum, analiz veya tartışma sağlayarak bir anlatıma katkıda bulunan sanatçı bir aile.","zh-Hans-CN":"作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20436", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCollectiveAgent.en", "label":"has commentator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20554", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/commentatorFamily.en", "label":"has commentator family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20554", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/commentatorFamily.en", "label":"has commentator family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20377","label":{"ar":"لها شخص معلق","ca":"té com a persona comentarista","cs":"má komentátora (osobu)","da":"har person, som er kommentator","de":"hat Kommentatorin/Kommentator (Person)","de":"hat Kommentatorin/Kommentator (Person)","en":"has commentator person","es":"tiene persona comentarista","et":"kommentaator (isik)","fi":"kommentaattori (henkilö)","fr":"a pour personne commentatrice","hu":"kommentátor személye a következő:","lv":"komentētājs (persona)","nl":"heeft commentator-persoon","no":"har kommentator (person)","tr":"yorumcu ile ilişkilidir","zh-Hans-CN":"有解说员个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر."],"ca":["Relaciona una expressió amb una persona que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual."],"cs":["Vztahuje vyjádření k osobě, která je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média."],"da":["Relaterer et udtryk til en person, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert."],"en":["Relates an expression to a person who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium."],"es":["Relaciona una expresión con una persona que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, film u otro medio audiovisual."],"et":["Seostab väljenduse isikuga, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle."],"fi":["Liittää ekspression henkilöön, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä."],"fr":["Met une expression en relation avec une personne interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó személyhez, aki hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon."],"lv":["Sasaista izteiksmi ar personu, kura ir izpildītājs, kura sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē."],"nl":["Relateert een expressie aan een persoon die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium."],"no":["Relaterer et uttrykk til en person som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium."],"tr":["Bir anlatımı, bir kayıt, film veya başka bir görsel-işitsel ortamda yorum, analiz veya konunun tartışılmasını sağlayarak bir anlatıma katkıda bulunan bir yorumcu olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص معلق","ca":"persona comentarista","cs":"komentátor (osoba)","da":"person, som er kommentator","de":"Kommentatorin/Kommentator (Person)","de":"Kommentatorin/Kommentator (Person)","en":"commentator person","es":"persona comentarista","et":"kommentaator (isik)","fi":"kommentaattori (henkilö)","fr":"personne commentatrice","hu":"kommentátor személy:","lv":"komentētājs (persona)","nl":"commentator-persoon","no":"kommentator (person)","tr":"yorumcu","zh-Hans-CN":"解说员个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤديًا يساهم في تعبيرة من خلال تقديم تفسير للموضوع، أو تحليله، أو مناقشته في تسجيل، أو في فيلم، أو أي وسيط سمعي بصري آخر.","ca":"Persona que és un intèrpret que contribueix a una expressió proporcionant l’opinió, l’anàlisi o l’explicació del tema d’un enregistrament, una pel·lícula o de qualsevol altre suport audiovisual.","cs":"Osoba, která je účinkujícím, který přispívá k vyjádření tím, že poskytuje interpretace, analýzy nebo diskusi o tématu nahrávky, filmu nebo jiného audiovizuálního média.","da":"Person, som er en udøver, som bidrager til et udtryk ved at stå for fortolkning, analyse eller diskussion af det emne, som behandles i en optagelse, film eller andet audiovisuelt medium.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er in einer Aufnahme, in einem Film oder in einem anderen audiovisuellen Medium eine Interpretation, eine Analyse oder eine Diskussion des Themas präsentiert.","en":"A person who is a performer who contributes to an expression by providing interpretation, analysis, or a discussion of the subject matter on a recording, film, or other audiovisual medium.","es":"Una persona que es un intérprete que contribuye a una expresión al proveer interpretación, análisis o una discusión sobre el tema en una grabación, film u otro medio audiovisual.","et":"Isik, kes esitajana annab panuse väljendusse, tõlgendades või analüüsides salvestuse, filmi või muu audiovisuaalse meediumi ainestikku või arutledes selle üle.","fi":"Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen tulkitsemalla tai analysoimalla äänitteen, elokuvan tai muun audiovisuaalisen aineiston aihetta tai keskustelemalla siitä.","fr":"Personne interprète qui contribue à une expression en fournissant une interprétation, une analyse ou une explication du sujet sur un enregistrement, un film ou un autre support audiovisuel.","hu":"Egy előadó személy, aki hozzájárul egy kifejezési formához azzal, hogy annak témáihoz értelmezést, elemzést nyújt vagy megvitatja azt egy felvételen, filmen vagy más audiovizuális médiumon.","lv":"Persona - izpildītājs, kura sniegusi ieguldījumu izteiksmē, sniedzot interpretāciju, analīzi vai diskusiju par tēmu ierakstā, filmā vai citā audiovizuālā vidē.","nl":"Een persoon die een uitvoerder is die bijdraagt aan een expressie door het verlenen van uitleg, analyse of een discussie over het onderwerp op een opname, film of ander audiovisueel medium.","no":"En person som er en utøver som bidrar til et uttrykk av et verk ved å tilføre tolkning, analyse eller drøfting av temaet for et opptak, en film eller et annet audiovisuelt medium.","tr":"Bir kayıtta, filmde veya başka bir görsel-işitsel ortamda konunun yorumunu, analizini veya tartışmasını sağlayarak bir anlatıma katkıda bulunan sanatçı olan kişi.","zh-Hans-CN":"作为一个表演者通过提供关于录像、电影或其他视听媒介中的主要内容之解释、分析或讨论而对一种内容表达有贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20351", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en", "label":"has performer person"},{"@id":"http://rdaregistry.info/Elements/e/P20021", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorAgent.en", "label":"has commentator agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20377", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/commentatorPerson.en", "label":"has commentator person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20377", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/commentatorPerson.en", "label":"has commentator person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20011","label":{"ar":"لها وكيل قائد أوركسترا","ca":"té com a agent director d’orquestra","cs":"má dirigenta (agenta)","da":"har agent, som er dirigent","de":"hat Dirigentin/Dirigent (Akteur)","de":"hat Dirigentin/Dirigent (Akteur)","el":"έχει διευθυντή ορχήστρας","en":"has conductor agent","es":"tiene agente conductor","et":"dirigent (tegija)","fi":"johtaja (toimija)","fr":"a pour agent chef musical","hu":"karmester ágense a következő:","lv":"diriģents (aģents)","nl":"heeft dirigent-actor","no":"har dirigent (agent)","tr":"orkestra şefi temsilcisi ile ilişkilidir","vi":"có người chỉ huy","zh-Hans-CN":"有指挥行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb un agent que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k agentovi, který je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en agent, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet."],"el":["Συνδέει μια έκφραση με έναν εκτελεστή ο οποίος συνεισφέρει σε μια έκφραση ενός μουσικού έργου μέσω της διεύθυνσης ενός οργανικού συνόλου σε μια μουσική ή δραματική παρουσίαση κ.λπ."],"en":["Relates an expression to an agent who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con un agente que es un intérprete que contribuye a la expresión de una obra musical dirigiendo un grupo interpretativo en una presentación musical o dramática."],"et":["Seostab väljenduse tegijaga, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma."],"fi":["Liittää ekspression toimijaan, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec un agent interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó ágenshez, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar aģentu, kas ir izpildītājs, kas sniedzis ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml."],"nl":["Relateert een expressie aan een actor die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en agent som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc."],"tr":["Bir anlatımı, müzikal veya drama gösteriminde bir performans grubunu yöneterek bir müzik eserinin anlatımına katkıda bulunan bir sanatçı olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với người biểu diễn đóng góp cho biểu hiện của tác phẩm âm nhạc bằng cách đứng đầu nhóm biểu diễn trong trình diễn âm nhạc hoặc kịch."],"zh-Hans-CN":["将一种内容表达与作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل قائد أوركسترا","ca":"agent director d’orquestra","cs":"dirigent (agent)","da":"agent, som er dirigent","de":"Dirigentin/Dirigent (Akteur)","de":"Dirigentin/Dirigent (Akteur)","el":"διευθυντής ορχήστρας","en":"conductor agent","es":"agente conductor","et":"dirigent (tegija)","fi":"johtaja (toimija)","fr":"agent chef musical","hu":"karmester ágens:","lv":"diriģents (aģents)","nl":"dirigent-actor","no":"dirigent (agent)","tr":"orkestra şefi temsilcisi","vi":"người chỉ huy","zh-Hans-CN":"指挥行为者"},"ToolkitDefinition":{"ar":"تربط بين تعبيرة ووكيل يكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي.","ca":"Agent que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica.","cs":"Agent, který je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení.","da":"Agent, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder dramatischen Darbietung leitet.","el":"Ένας εκτελεστής ο οποίος συνεισφέρει σε μια έκφραση ενός μουσικού έργου μέσω της διεύθυνσης ενός οργανικού συνόλου σε μια μουσική ή δραματική παρουσίαση κ.λπ.","en":"An agent who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation.","es":"Un agente que es un intérprete que contribuye a la expresión de una obra musical dirigiendo un grupo en una presentación musical o dramática.","et":"Tegija, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma.","fi":"Toimija, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä.","fr":"Agent interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique.","hu":"Egy előadó ágens, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy drámai bemutatóban.","lv":"Aģents - izpildītājs, kas sniedzis ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml.","nl":"Een actor die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie.","no":"En agent som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc.","tr":"Müzikal veya dramatik bir sunumda bir performans grubuna liderlik ederek bir müzik eserinin anlatımına katkıda bulunan bir sanatçı olan temsilci.","vi":"Người biểu diễn đóng góp cho biểu hiện của tác phẩm âm nhạc bằng cách đứng đầu nhóm biểu diễn trong trình diễn âm nhạc hoặc kịch, v.v...","zh-Hans-CN":"作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个行为者"},"altLabel":{"ar":["قائد أوركسترا"],"ca":["director d’orquestra"],"cs":["dirigent"],"da":["dirigent"],"de":["Dirigent,Dirigent"],"en":["conductor"],"es":["conductor"],"et":["dirigent"],"fi":["johtaja"],"fr":["chef musical"],"hu":["karmester:"],"nl":["dirigent"],"no":["dirigent"],"tr":["orkestra şefi"],"zh-Hans-CN":["指挥"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/conductorAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20285", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorAgent.en", "label":"has choral conductor agent"},{"@id":"http://rdaregistry.info/Elements/e/P20442", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCollectiveAgent.en", "label":"has conductor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20383", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorPerson.en", "label":"has conductor person"},{"@id":"http://rdaregistry.info/Elements/e/P20286", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorAgent.en", "label":"has instrumental conductor agent"},{"@id":"http://rdaregistry.info/Elements/e/object/P20011", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/conductorAgent.en", "label":"has conductor agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20011", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/conductorAgent.en", "label":"has conductor agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20442","label":{"ar":"لها وكيل جماعي مايسترو","ca":"té com a agent col·lectiu director d’orquestra","cs":"má dirigenta (kolektivního agenta)","da":"har kollektiv agent, som er dirigent","de":"hat Dirigentin/Dirigent (Gemeinschaftlicher Akteur)","de":"hat Dirigentin/Dirigent (Gemeinschaftlicher Akteur)","en":"has conductor collective agent","es":"tiene agente colectivo director","et":"dirigent (kollektiiv)","fi":"johtaja (yhteistoimija)","fr":"a pour agent collectif chef musical","hu":"karmester kollektív ágense a következő:","lv":"diriģents (grupa)","nl":"heeft dirigent-collectieve actor van","no":"har dirigent (kollektiv agent)","tr":"orkestra şefi kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有指挥集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb un agent col·lectiu que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en kollektiv agent, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet."],"en":["Relates an expression to a collective agent who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con un agente colectivo que es un intérprete que contribuye a una expresión de una obra musical al dirigir a un grupo escénico en una presentación musical o dramática."],"et":["Seostab väljenduse kollektiiviga, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma."],"fi":["Liittää ekspression yhteistoimijaan, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec un agent collectif interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó személyhez, aki hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy egy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar grupu, kas ir izpildītājs, kas sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml."],"nl":["Relateert een expressie aan een collectieve actor die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en kollektiv agent som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc."],"tr":["Bir anlatımı, müzikal veya drama gösteriminde bir performans grubunu yöneterek bir müzik eserinin anlatımına katkıda bulunan bir sanatçı olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مايسترو","ca":"agent col·lectiu director d’orquestra","cs":"dirigent (kolektivní agent)","da":"kollektiv agent, som er dirigent","de":"Dirigentin/Dirigent (Gemeinschaftlicher Akteur)","de":"Dirigentin/Dirigent (Gemeinschaftlicher Akteur)","en":"conductor collective agent","es":"agente colectivo director","et":"dirigent (kollektiiv)","fi":"johtaja (yhteistoimija)","fr":"agent collectif chef musical","hu":"karmester kollektív ágens:","lv":"diriģents (grupa)","nl":"dirigent-collectieve actor van","no":"dirigent (kollektiv agent)","tr":"orkestra şefi kolektif temsilcisi","zh-Hans-CN":"指挥集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي.","ca":"Agent col·lectiu que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica.","cs":"Kolektivní agent, který je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení.","da":"Kollektiv agent, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","en":"A collective agent who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation.","es":"Un agente colectivo que es un intérprete que contribuye a una expresión de una obra musical al dirigir a un grupo escénico en una presentación musical o dramática.","et":"Kollektiiv, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma.","fi":"Yhteistoimija, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä.","fr":"Agent collectif interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique.","hu":"Egy előadó kollektív ágens, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy egy drámai bemutatóban.","lv":"Grupa - izpildītājs, kas sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml.","nl":"Een collectieve actor die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie.","no":"En kollektiv agent som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc.","tr":"Müzikal veya dramatik bir sunumda bir performans grubuna liderlik ederek bir müzik eserinin ifadesine katkıda bulunan bir sanatçı olan kolektif bir temsilci.","zh-Hans-CN":"作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20011", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorAgent.en", "label":"has conductor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20395", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorCollectiveAgent.en", "label":"has choral conductor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20501", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCorporateBody.en", "label":"has conductor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20560", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorFamily.en", "label":"has conductor family"},{"@id":"http://rdaregistry.info/Elements/e/P20427", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorCollectiveAgent.en", "label":"has instrumental conductor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/object/P20442", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/conductorCollectiveAgent.en", "label":"has conductor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20442", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/conductorCollectiveAgent.en", "label":"has conductor collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20501","label":{"ar":"لها هيئة مايِسترو","ca":"té com a entitat corporativa directora d’orquestra","cs":"má dirigenta (korporaci)","da":"har korporation, som er dirigent","de":"hat Dirigentin/Dirigent (Körperschaft)","de":"hat Dirigentin/Dirigent (Körperschaft)","en":"has conductor corporate body","es":"tiene organismo corporativo director","et":"dirigent (asutus)","fi":"johtaja (yhteisö)","fr":"a pour collectivité chef musicale","hu":"karmester testülete a következő:","lv":"diriģents (institūcija)","nl":"heeft dirigent-corporatie van","no":"har dirigent (korporasjon)","tr":"orkestra şefi tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有指挥团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una entitat corporativa que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření ke korporaci, která je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en korporation, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet."],"en":["Relates an expression to a corporate body who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con un organismo corporativo que es un intérprete que contribuye a una expresión de una obra musical al dirigir a un grupo escénico en una presentación musical o dramática."],"et":["Seostab väljenduse asutusega, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma."],"fi":["Liittää ekspression yhteisöön, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une collectivité interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó testülethez, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei, vagy egy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar institūciju, kas ir izpildītājs, kas sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml."],"nl":["Relateert een expressie aan een corporatie die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en korporasjon som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc."],"tr":["Bir anlatımı, müzikal veya drama oyununda bir performans grubunu yöneterek bir müzik eserinin anlatımına katkıda bulunan bir sanatçı olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مايِسترو","ca":"entitat corporativa directora d’orquestra","cs":"dirigent (korporace)","da":"korporation, som er dirigent","de":"Dirigentin/Dirigent (Körperschaft)","de":"Dirigentin/Dirigent (Körperschaft)","en":"conductor corporate body","es":"organismo corporativo director","et":"dirigent (asutus)","fi":"johtaja (yhteisö)","fr":"collectivité chef musicale","hu":"karmester testület:","lv":"diriģents (institūcija)","nl":"dirigent-corporatie van","no":"dirigent (korporasjon)","tr":"orkestra şefi tüzel kişisi","zh-Hans-CN":"指挥团体"},"ToolkitDefinition":{"ar":"هيئة تكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي.","ca":"Entitat corporativa que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica.","cs":"Korporace, která je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení.","da":"Korporation, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","en":"A corporate body who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation.","es":"Un organismo corporativo que es un intérprete que contribuye a una expresión de una obra musical al dirigir a un grupo escénico en una presentación musical o dramática.","et":"Asutus, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma.","fi":"Yhteisö, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä.","fr":"Collectivité interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique.","hu":"Egy előadó testület, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei, vagy egy drámai bemutatóban.","lv":"Institūcija - izpildītājs, kas sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml.","nl":"Een corporatie die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie.","no":"En korporasjon som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc.","tr":"Bir müzikal veya dramatik sunumda bir performans grubuna liderlik ederek bir müzik eserinin ifadesine katkıda bulunan ve sanatçı olan tüzel kişi","zh-Hans-CN":"作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20442", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCollectiveAgent.en", "label":"has conductor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20454", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorCorporateBody.en", "label":"has choral conductor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20486", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorCorporateBody.en", "label":"has instrumental conductor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/object/P20501", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/conductorCorporateBody.en", "label":"has conductor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20501", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/conductorCorporateBody.en", "label":"has conductor corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20560","label":{"ar":"لها عائلة مايسترو","ca":"té com a família directora d’orquestra","cs":"má dirigenta (rodinu)","da":"har familie, som er dirigent","de":"hat Dirigentin/Dirigent (Familie)","de":"hat Dirigentin/Dirigent (Familie)","en":"has conductor family","es":"tiene familia directora","et":"dirigent (perekond)","fi":"johtaja (suku)","fr":"a pour famille chef musicale","hu":"karmester családja a következő:","lv":"diriģents (dzimta/ģimene)","nl":"heeft dirigent-familie van","no":"har dirigent (familie)","tr":"orkestra şefi ailesi ile ilişkilidir","zh-Hans-CN":"有指挥家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una família que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k rodině, která je účinkujícím, který přispívá k vyjádření hudebního díla díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en familie, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung mit einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.,Setzt eine Expression in Beziehung mit einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet."],"en":["Relates an expression to a family who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con una familia que es un intérprete que contribuye a una expresión de una obra musical al dirigir a un grupo escénico en una presentación musical o dramática."],"et":["Seostab väljenduse perekonnaga, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma."],"fi":["Liittää ekspression sukuun, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une famille interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó családhoz, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir izpildītājs, kas sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml."],"nl":["Relateert een expressie aan een familie die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en familie som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc."],"tr":["Bir anlatımı, müzikal veya drama oyununda bir performans grubunu yöneterek bir müzik eserinin anlatımına katkıda bulunan bir sanatçı olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مايسترو","ca":"família directora d’orquestra","cs":"dirigent (rodina)","da":"familie, som er dirigent","de":"Dirigentin/Dirigent (Familie)","de":"Dirigentin/Dirigent (Familie)","en":"conductor family","es":"familia directora","et":"dirigent (perekond)","fi":"johtaja (suku)","fr":"famille chef musicale","hu":"karmester család:","lv":"diriģents (dzimta/ģimene)","nl":"dirigent-familie van","no":"dirigent (familie)","tr":"orkestra şefi ailesi","zh-Hans-CN":"指挥家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي.","ca":"Família que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica.","cs":"Rodina, která je účinkujícím, který přispívá k vyjádření hudebního díla díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení.","da":"Familie, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","en":"A family who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation.","es":"Una familia que es un intérprete que contribuye a una expresión de una obra musical al dirigir a un grupo escénico en una presentación musical o dramática.","et":"Perekond, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma.","fi":"Suku, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä.","fr":"Famille interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique.","hu":"Egy előadó család, amely hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy drámai bemutatóban.","lv":"Dzimta/ģimene - izpildītājs, kas sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml.","nl":"Een familie die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie.","no":"En familie som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc.","tr":"Müzikal veya dramatik bir sunumda bir performans grubuna liderlik ederek bir müzik eserinin anlatımına katkıda bulunan sanatçı bir aile.","zh-Hans-CN":"作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/conductorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20442", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCollectiveAgent.en", "label":"has conductor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20513", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorFamily.en", "label":"has choral conductor family"},{"@id":"http://rdaregistry.info/Elements/e/P20545", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorFamily.en", "label":"has instrumental conductor family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20560", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/conductorFamily.en", "label":"has conductor family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20560", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/conductorFamily.en", "label":"has conductor family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20383","label":{"ar":"لها شخص قائد فرقة موسيقية","ca":"té com a persona directora d’orquestra","cs":"má dirigenta (osobu)","da":"har person, som er dirigent","de":"hat Dirigentin/Dirigent (Person)","de":"hat Dirigentin/Dirigent (Person)","en":"has conductor person","es":"tiene persona directora","et":"dirigent (isik)","fi":"johtaja (henkilö)","fr":"a pour personne chef musicale","hu":"karmester személye a következő:","lv":"diriģents (persona)","nl":"heeft dirigent-persoon van","no":"har dirigent (person)","tr":"orkestra şefi ile ilişkilidir","zh-Hans-CN":"有指挥个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una persona que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k osobě, která je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení."],"da":["Relaterer et udtryk til en person, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet."],"en":["Relates an expression to a person who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation."],"es":["Relaciona una expresión con una persona que contribuye a una expresión de una obra musical al liderar a un grupo escénico en una presentación musical o dramática."],"et":["Seostab väljenduse isikuga, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma."],"fi":["Liittää ekspression henkilöön, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une personne interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó személyhez, aki hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy egy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar personu, kura ir izpildītājs, kura sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml."],"nl":["Relateert een expressie aan een persoon die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en person som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc."],"tr":["Bir anlatımı, müzikal veya drama oyununda bir performans grubunu yöneterek bir müzik eserinin anlatımına katkıda bulunan bir sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص قائد فرقة موسيقية","ca":"persona directora d’orquestra","cs":"dirigent (osoba)","da":"person, som er dirigent","de":"Dirigentin/Dirigent (Person)","de":"Dirigentin/Dirigent (Person)","en":"conductor person","es":"persona directora","et":"dirigent (isik)","fi":"johtaja (henkilö)","fr":"personne chef musicale","hu":"karmester személy:","lv":"diriģents (persona)","nl":"dirigent-persoon van","no":"dirigent (person)","tr":"orkestra şefi","zh-Hans-CN":"指挥个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤديًا يساهم في تعبيرة لعمل موسيقي من خلال قيادة فرقة عزف في عرض موسيقي أو درامي.","ca":"Persona que és un intèrpret que contribueix a una expressió d’una obra musical dirigint un grup d’intèrprets en una representació musical o dramàtica.","cs":"Osoba, která je účinkujícím, který přispívá k vyjádření hudebního díla tím, že řídí účinkující skupinu v hudebním nebo dramatickém vystoupení.","da":"Person, som er en udøver, som bidrager til et musikværks udtryk ved at lede en udøvende gruppe i en musikalsk eller dramatisk præsentation etc.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression eines Musikwerks beiträgt, indem sie/er ein aufführendes Ensemble in einer musikalischen oder darstellenden Vorführung leitet.","en":"A person who is a performer who contributes to an expression of a musical work by leading a performing group in a musical or dramatic presentation.","es":"Una persona que contribuye a una expresión de una obra musical al liderar a un grupo escénico en una presentación musical o dramática.","et":"Isik, kes esitajana annab panuse muusikateose väljendusse, juhatades muusika- või draamaetenduse vms esitusrühma.","fi":"Henkilö, joka on esittäjä, joka osallistuu musiikkiteoksen ekspression tekemiseen johtamalla esiintyjäryhmää musiikki- tai näytelmäesityksessä.","fr":"Personne interprète qui contribue à une expression d’une œuvre musicale en dirigeant un groupe d’interprètes dans une présentation musicale ou dramatique.","hu":"Egy előadó személy, aki hozzájárul egy zenemű kifejezési formájához azzal, hogy előadói csoportot vezet egy zenei vagy egy drámai bemutatóban.","lv":"Persona - izpildītājs, kura sniegusi ieguldījumu mūzikāla darba izteiksmē, diriģējot izpildītāju grupu muzikālā vai dramatiskā uzvedumā, u.tml.","nl":"Een persoon die een uitvoerder is die bijdraagt aan een expressie van een muziekwerk door het leiden van een uitvoerende groep in een muziek- of dramapresentatie.","no":"En person som er en utøver som bidrar til et uttrykk av et musikalsk verk ved å lede en gruppe med utøvere i en musikalsk eller dramatisk forestilling, etc.","tr":"Bir müzikal veya dramatik sunumda bir performans grubuna liderlik ederek bir müzik eserinin anlatımına katkıda bulunan sanatçı olan kişi.","zh-Hans-CN":"作为一个表演者对一种音乐作品的一种内容表达有领导音乐或戏剧呈现中表演团队的贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/conductorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20351", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en", "label":"has performer person"},{"@id":"http://rdaregistry.info/Elements/e/P20011", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorAgent.en", "label":"has conductor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20336", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorPerson.en", "label":"has choral conductor person"},{"@id":"http://rdaregistry.info/Elements/e/P20368", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalConductorPerson.en", "label":"has instrumental conductor person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20383", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/conductorPerson.en", "label":"has conductor person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20383", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/conductorPerson.en", "label":"has conductor person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20328","label":{"ar":"لها وكيل مساهم في دمج","ca":"té com a agent contribuïdor a una amalgama","cs":"má přispěvatele ke sloučení (agenta)","da":"har agent, som er bidragsyder til sammensmeltning","de":"hat Beiträgerin/Beiträger zu einer Verschmelzung (Akteur)","de":"hat Beiträgerin/Beiträger zu einer Verschmelzung","en":"has contributor agent to amalgamation","es":"tiene agente contribuyente a la fusión","et":"sulami kaastööline (tegija)","fi":"yhdistymään osallinen toimija","fr":"a pour agent contributeur à un amalgame","hu":"vegyes tartalom közreműködő ágense a következő:","lv":"amalgamāta līdzradītājs (aģents)","nl":"heeft bijdrager-actor aan amalgamering","no":"har bidragsyter til sammenslutning (agent)","tr":"birleşmeye katkıda bulunan temsilci ile ilişkilidir","zh-Hans-CN":"有融合体的贡献者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل ييساهم في تعبيرة عبارة عن مزج سلس لأنواع من المحتوى."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió que és una mescla sense continuïtat de classes de contingut."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření, které je souvislou kombinací různých druhů obsahu."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk, som er en glat kombinering af forskellige slags af indhold."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression, die eine nahtlose Mischung von Inhalten darstellt, beiträgt.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression, die eine nahtlose Mischung von Inhalten darstellt, beiträgt."],"en":["Relates an expression to an agent who contributes to an expression that is a seamless mix of kinds of content."],"es":["Relaciona una expresión con un agente que contribuye a una expresión que es una combinación perfecta de tipos de contenido."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, mis on eri liiki sisu lahutamatu segu."],"fi":["Liittää ekspression toimijaan, joka osallistuu sellaisen ekspression tekemiseen, joka on saumaton yhdistelmä erilaisia sisältöjä."],"fr":["Met une expression en relation avec un agent qui contribue à une expression consistant en un mélange intégré de différents genres de contenu."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely egy olyan kifejezési formához járul hozzá, amely egy tartalom fajtáinak szabad keveréke."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, kas ietver atsevišķas sastāvdaļas, kuras nevar realizēt kā atsevišķas izteiksmes."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie die een naadloze mix van soorten content is."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk som er en sømløs blanding av forskjellig innhold."],"tr":["Bir anlatımı, içerik türlerinin kusursuz bir karışımı olan bir anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对作为各种内容无缝融合的一种内容表达作出贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مساهم في دمج","ca":"agent contribuïdor a una amalgama","cs":"přispěvatel ke sloučení (agent)","da":"agent, som er bidragsyder til sammensmeltning","de":"Beiträgerin/Beiträger zu einer Verschmelzung (Akteur)","de":"Beiträgerin/Beiträger zu einer Verschmelzung (Akteur)","en":"contributor agent to amalgamation","es":"agente contribuyente a la fusión","et":"sulami kaastööline (tegija)","fi":"yhdistymään osallinen toimija","fr":"agent contributeur à un amalgame","hu":"vegyes tartalomban közreműködő ágens:","lv":"amalgamāta līdzradītājs (aģents)","nl":"bijdrager-actor aan amalgamering","no":"bidragsyter til sammenslutning (agent)","tr":"birleşmeye katkıda bulunan temsilci","zh-Hans-CN":"融合体的贡献者行为者"},"ToolkitDefinition":{"ar":"وكيل يُساهم في تعبيرة عبارة عن مزج سلس لأنواع من المحتوى.","ca":"Agent que contribueix a una expressió que és una mescla sense continuïtat de classes de contingut.","cs":"Agent, který přispívá k vyjádření, které je souvislou kombinací různých druhů obsahu.","da":"Agent, som bidrager til et udtryk, som er en glat kombinering af forskellige slags af indhold.","de":"Ein Akteur, der zu einer Expression, die eine nahtlose Mischung von Inhalten darstellt, beiträgt.","de":"Ein Akteur, der zu einer Expression, die eine nahtlose Mischung von Inhalten darstellt, beiträgt.","en":"An agent who contributes to an expression that is a seamless mix of kinds of content.","es":"Un agente que contribuye a una expresión que es una combinación perfecta de tipos de contenido.","et":"Tegija, kes annab panuse väljendusse, mis on eri liiki sisu lahutamatu segu.","fi":"Toimija, joka osallistuu sellaise