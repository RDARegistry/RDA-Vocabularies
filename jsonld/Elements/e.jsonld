                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/concordanceExpression.en","instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20204", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfSourceWork.en", "label":"has expression of source work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20108", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/concordanceExpression.en", "label":"has concordance expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20108", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/concordanceExpression.en", "label":"has concordance expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20253","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يقدم رقصات للاستخدام في تعبيرة ذات صلة."],"ca":["Relaciona una expressió amb una expressió d’una obra que proporciona la coreografia que s’ha d’usar en una expressió relacionada."],"cs":["Vztahuje vyjádření k vyjádření díla, které poskytuje choreografii pro použití v souvisejícím vyjádření."],"da":["Relaterer et udtryk til et udtryk af et værk, som angiver koreografien til brug i det relaterede udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die die Choreografie zur Verwendung in einer in Beziehung stehenden Expression liefert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die die Choreografie zur Verwendung in einer in Beziehung stehenden Expression liefert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο παρέχει χορογραφία για χρήση σε μια σχετική έκφραση."],"en":["Relates an expression to an expression of a work that provides choreography for use in a related expression."],"es":["Relaciona una expresión con una expresión de una obra que proporciona coreografía para usar en una expresión relacionada."],"et":["Seostab väljenduse teose väljendusega, millest on võetud koreograafia kasutamiseks seotud väljenduses."],"fi":["Liittää ekspression teoksen ekspressioon, joka antaa koreografian käytettäväksi siihen liittyvässä ekspressiossa."],"fr":["Met une expression en relation avec une expression d’une œuvre qui fournit une chorégraphie destinée à être utilisée dans une expression en relation."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely koreográfiát nyújt egy kapcsolódó kifejezési formában való használathoz."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas nodrošina horeogrāfiju, kas izmantota saistītajā izteiksmē."],"nl":["Relateert een expressie aan een expressie van een werk dat choreografie levert voor gebruik in een gerelateerde expressie."],"no":["Relaterer et uttrykk til et uttrykk av et verk som tilfører koreografi som brukes i et tilknyttet uttrykk."],"tr":["Bir anlatımı, ilgili bir anlatımda kullanılmak üzere koreografi sağlayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm cung cấp nghệ thuật bố trí để sử dụng trong biểu hiện có quan hệ."],"zh-Hans-CN":["将一种内容表达与提供编舞用于一种相关内容表达的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة رقصات","ca":"expressió de coreografia","cs":"choreografie (vyjádření)","da":"koreografiudtryk","de":"Choreografie (Expression)","de":"Choreografie (Expression)","el":"χορογραφία (έκφραση)","en":"choreography expression","es":"expresión coreográfica","et":"koreograafia (väljendus)","fi":"koreografia (ekspressio)","fr":"chorégraphie (expression)","hu":"koreográfia kifejezési formája:","lv":"izteiksme: horeogrāfija","nl":"choreografie-expressie","no":"koreografi (uttrykk)","tr":"kareografi anlatımı","vi":"nghệ thuật bố trí (biểu hiện)","zh-Hans-CN":"编舞内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يقدم رقصات للاستخدام في تعبيرة ذات صلة.","ca":"Expressió d’una obra que proporciona la coreografia que s’ha d’usar en una expressió relacionada.","cs":"Vyjádření díla, které poskytuje choreografii pro použití v souvisejícím vyjádření.","da":"Udtryk af et værk, som angiver koreografien til brug i det relaterede udtryk.","de":"Eine Expression eines Werks, die die Choreografie zur Verwendung in einer in Beziehung stehenden Expression liefert.","de":"Eine Expression eines Werks, die die Choreografie zur Verwendung in einer in Beziehung stehenden Expression liefert.","el":"Μια έκφραση ενός έργου το οποίο παρέχει χορογραφία για χρήση σε μια σχετική έκφραση.","en":"An expression of a work that provides choreography for use in a related expression.","es":"Una expresión de una obra que proporciona coreografía para usar en una expresión relacionada.","et":"Teose väljendus, millest on võetud koreograafia kasutamiseks seotud väljenduses.","fi":"Teoksen ekspressio, joka antaa koreografian käytettäväksi siihen liittyvässä ekspressiossa.","fr":"Expression d’une œuvre qui fournit une chorégraphie destinée à être utilisée dans une expression en relation.","hu":"Egy mű kifejezési formája, amely koreográfiát nyújt egy kapcsolódó kifejezési formában való használathoz.","lv":"Darba izteiksme, kas nodrošina horeogrāfiju, kas izmantota saistītajā izteiksmē.","nl":"Een expressie van een werk dat choreografie levert voor gebruik in een gerelateerde expressie.","no":"Et uttrykk av et verk som tilfører koreografi som brukes i et tilknyttet uttrykk.","tr":"İlgili bir ifadede kullanmak için koreografi sağlayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm cung cấp nghệ thuật bố trí để sử dụng trong biểu hiện có quan hệ.","zh-Hans-CN":"提供编舞用于一种相关内容表达的一种作品的一种内容表达"},"label":{"ar":"لها تعبيرة رقصات","ca":"té com a expressió de coreografia","cs":"má choreografii (vyjádření)","da":"har koreografiudtryk","de":"hat Choreografie (Expression)","de":"hat Choreografie (Expression)","el":"είναι χορογραφία (έκφραση)","en":"has choreography expression","es":"tiene expresión coreográfica","et":"koreograafia (väljendus)","fi":"koreografia (ekspressio)","fr":"a pour chorégraphie (expression)","hu":"koreográfia kifejezési formája a következő:","lv":"izteiksme: horeogrāfija","nl":"heeft choreografie-expressie","no":"har koreografi (uttrykk)","tr":"kareografi anlatımı ile ilişkilidir","vi":"là nghệ thuật bố trí (biểu hiện)","zh-Hans-CN":"有编舞内容表达"},"altLabel":{"de":["Choreographie (Expression),Choreographie (Expression)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
