                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20347", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserPerson.en", "label":"has reviser person"},{"@id":"http://rdaregistry.info/Elements/e/P20034", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberAgent.en", "label":"has transcriber agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20359", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/transcriberPerson.en", "label":"has transcriber person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20359", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/transcriberPerson.en", "label":"has transcriber person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20037","definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Originalwerks unterscheidet.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Originalwerks unterscheidet."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου εκφράζοντας το γλωσσικό περιεχόμενο ενός έργου σε μια γλώσσα διαφορετική από τις προηγούμενες εκφράσεις του πρωτότυπου έργου."],"en":["Relates an expression to an agent who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work."],"es":["Relaciona una expresión con un agente que contribuye a una expresión expresando el contenido lingüístico de la obra en un idioma diferente al de expresiones anteriores de la obra original."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáinak eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket."],"tr":["Bir anlatımı, eserin dilsel içeriğini orijinal eserin önceki anlatımlarından farklı bir dilde ifade ederek anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách thể hiện nội dung ngôn ngữ của tác phẩm trong ngôn ngữ khác với ngôn ngữ của biểu hiện trước đây của tác phẩm nguyên gốc."],"zh-Hans-CN":["将一种内容表达与通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个行为者关联起来。"]},"note":{"ar":["يمكن للمترجم أيضًا ترجمة المحتوى اللغوي بين أشكال اللغة نفسها خلال فترات زمنية مختلفة."],"ca":["Un traductor també pot traduir un contingut lingüístic entre formes de la mateixa llengua de diferents períodes de temps."],"cs":["Překladatel může také překládat jazykový obsah mezi formami téhož jazyka z různých časových období."],"da":["Oversætter må også oversætte lingvistisk indhold mellem former af det samme sprog fra forskellige tidsperioder."],"de":["Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden.,Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden."],"el":["Περιλαμβάνεται η μετάφραση του γλωσσικού περιεχομένου μεταξύ μορφών της ίδιας γλώσσας από διαφορετικές χρονικές περιόδους."],"en":["A translator may also translate linguistic content between forms of the same language from different time periods."],"es":["Un traductor también puede traducir contenido lingüístico entre formas del mismo idioma de diferentes períodos de tiempo."],"et":["Tõlkija võib keelesisu tõlkida ka sama keele eri aegadel kasutatud vormide vahel."],"fi":["Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä."],"fr":["Un traducteur peut également traduire un contenu linguistique dans une même langue depuis une forme datant d’une période donnée vers une forme datant d’une autre période."],"hu":["Egy fordító ugyanannak a nyelvnek a különböző időszakokból származó formái közötti nyelvi tartalmat is fordíthatja."],"lv":["Ietver satura tulkošanu no senākas valodas formas mūsdienu valodas formā vienas valodas ietvaros."],"nl":["Een vertaler kan ook taalkundige content vertalen tussen vormen van dezelfde taal uit verschillende tijdperiodes."],"no":["En oversetter kan også oversette språklig innhold mellom ulike former av det samme språket fra ulike tidsperioder."],"tr":["Bir çevirmen, aynı dilin farklı zaman dilimlerindeki biçimleri arasında da dilsel içerik çevirisi yapabilir."],"vi":["Bao gồm cả dịch nội dung ngôn ngữ giữa các hình thái của cùng ngôn ngữ trong các thời kỳ khác nhau"],"zh-Hans-CN":["译者还可以在同一种语言的不同时期的形式之间翻译语言内容。"]},"ToolkitLabel":{"ar":"وكيل مترجم","ca":"agent traductor","cs":"překladatel (agent)","da":"agent, som er oversætter","de":"Übersetzerin/Übersetzer (Akteur)","de":"Übersetzerin/Übersetzer (Akteur)","el":"μεταφραστής","en":"translator agent","es":"agente traductor","et":"tõlkija (tegija)","fi":"kääntäjä (toimija)","fr":"agent traducteur","hu":"fordító ágens:","lv":"tulkotājs (aģents)","nl":"vertaler-actor","no":"oversetter (agent)","tr":"tercüman temsilcisi","vi":"người dịch","zh-Hans-CN":"译者行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي.","ca":"Agent que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original.","cs":"Agent, který přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla.","da":"Agent, som bidrager til et udtryk ved at udtrykke værkets sproglige indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Originalwerks unterscheidet.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Originalwerks unterscheidet.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου εκφράζοντας το γλωσσικό περιεχόμενο ενός έργου σε μια γλώσσα διαφορετική από τις προηγούμενες εκφράσεις του πρωτότυπου έργου.","en":"An agent who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work.","es":"Un agente que contribuye a una expresión expresando el contenido lingüístico de la obra en un idioma diferente al de expresiones anteriores de la obra original.","et":"Tegija, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest.","fi":"Toimija, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä.","fr":"Agent qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale.","hu":"Egy ágens, amely egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáinak eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm.","nl":"Een actor die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk.","no":"En agent som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket.","tr":"Eserin dilsel içeriğini orijinal eserin önceki anlatımlarından farklı bir dilde ifade ederek bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách thể hiện nội dung ngôn ngữ của tác phẩm trong ngôn ngữ khác với ngôn ngữ của biểu hiện trước đây của tác phẩm nguyên gốc.","zh-Hans-CN":"通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个行为者"},"label":{"ar":"لها وكيل مترجم","ca":"té com a agent traductor","cs":"má překladatele (agenta)","da":"har agent, som er oversætter","de":"hat Übersetzerin/Übersetzer (Akteur)","de":"hat Übersetzerin/Übersetzer (Akteur)","el":"έχει μεταφραστή","en":"has translator agent","es":"tiene agente traductor","et":"tõlkija (tegija)","fi":"kääntäjä (toimija)","fr":"a pour agent traducteur","hu":"fordító ágense a következő:","lv":"tulkotājs (aģents)","nl":"heeft vertaler-actor","no":"har oversetter (agent)","tr":"çevirmen temsilcisi ile ilişkilidir","vi":"có người dịch","zh-Hans-CN":"有译者行为者"},"altLabel":{"ar":["مترجم"],"ca":["traductor"],"cs":["překladatel"],"da":["oversætter"],"de":["Übersetzer,Übersetzer"],"en":["translator"],"es":["traductor"],"et":["tõlkija"],"fi":["kääntäjä"],"fr":["traducteur"],"hu":["fordító:"],"nl":["vertaler"],"no":["oversetter"],"tr":["tercüman"],"zh-Hans-CN":["译者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
