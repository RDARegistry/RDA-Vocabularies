                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/reviserPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20389", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorPersonOfExpression.en", "label":"has creator person of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20327", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserAgent.en", "label":"has reviser agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20357", "lexicalAlias":"http://rdaregistry.info/Elements/e/abridgerPerson.en", "label":"has abridger person"},{"@id":"http://rdaregistry.info/Elements/e/P20365", "lexicalAlias":"http://rdaregistry.info/Elements/e/arrangerPersonOfMusic.en", "label":"has arranger person of music"},{"@id":"http://rdaregistry.info/Elements/e/P20356", "lexicalAlias":"http://rdaregistry.info/Elements/e/censorPerson.en", "label":"has censor person"},{"@id":"http://rdaregistry.info/Elements/e/P20355", "lexicalAlias":"http://rdaregistry.info/Elements/e/restorationistPersonOfExpression.en", "label":"has restorationist person of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20359", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberPerson.en", "label":"has transcriber person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20347", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/reviserPerson.en", "label":"has reviser person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20347", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/reviserPerson.en", "label":"has reviser person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20218","definition":{"ar":["تربط بين تعبيرة ومكان مرتبط بتسجيل محتوى تعبيرة، أو تصويره، إلخ."],"ca":["Relaciona una expressió amb un lloc que s’associa amb l’enregistrament, la filmació, etc., del contingut d’una expressió."],"cs":["Vztahuje vyjádření k místu, které je spojené s nahráním, natočením (atd.) obsahu vyjádření."],"da":["Relaterer et udtryk til et sted, som er knyttet til optagelsen, indspilningen etc., af et udtryks indhold."],"de":["Setzt eine Expression in Beziehung zu einem Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.,Setzt eine Expression in Beziehung zu einem Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht."],"el":["Συνδέει μια έκφραση με έναν τόπο που συνδέεται με την ηχογράφηση, κινηματογράφηση κ.λπ. του περιεχομένου μιας έκφρασης."],"en":["Relates an expression to a place that is associated with recording, filming, etc., the content of an expression."],"es":["Relaciona una expresión con un lugar que está asociado a la grabación, filmación, etc., el contenido de una expresión."],"et":["Seostab väljenduse kohaga, mis on seotud väljenduse sisu salvestamise, filmimise vms jäädvustamisega."],"fi":["Liittää ekspression paikkaan, joka liittyy ekspression sisällön äänitykseen, kuvaukseen tms."],"fr":["Met une expression en relation avec un lieu qui est associé à l’enregistrement, au tournage, etc. du contenu d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy helyhez, amely egy kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik."],"lv":["Sasaista izteiksmi ar vietu, kas saistīta ar izteiksmes satura ierakstīšanu, filmēšanu u.tml."],"nl":["Relateert een expressie aan een plaats die geassocieerd is met het opnemen, filmen etc. van de content van een expressie."],"no":["Relaterer et uttrykk til et sted som er forbundet med innspilling, opptak, etc. av innholdet i et uttrykk."],"tr":["Bir anlatımı, bir anlatımın içeriğinin kaydedilmesi, filme alınması vb. ile bağlantılı olan bir yerle ilişkilendirir."],"vi":["Liên kết một biểu hiện với địa điểm liên quan tới ghi, làm phim, v.v..., của nội dung của biểu hiện."],"zh-Hans-CN":["将一种内容表达与和一种内容表达的内容的录制、摄制等有关的地点关联起来。"]},"ToolkitLabel":{"ar":"مكان التقاط","ca":"lloc de captura","cs":"místo zaznamenání","da":"optagelsessted","de":"Aufzeichnungsort","de":"Aufzeichnungsort","el":"τόπος της σύλληψης","en":"place of capture","es":"lugar de captura","et":"jäädvustamiskoht","fi":"tallennuspaikka","fr":"lieu de captation","hu":"rögzítés helye:","lv":"tveršanas vieta","nl":"plaats van vastleggen","no":"innspillingssted","sv":"inspelningsort","tr":"çekim yapılan yer","vi":"địa điểm thu nạp","zh-Hans-CN":"摄录地点"},"ToolkitDefinition":{"ar":"مكان مرتبط بتسجيل محتوى تعبيرة، أو تصويره، إلخ.","ca":"Lloc que s’associa amb l’enregistrament, la filmació, etc., del contingut d’una expressió.","cs":"Místo, které je spojené s nahráním, natočením (atd.) obsahu vyjádření.","da":"Sted, som er knyttet til optagelsen, indspilningen etc., af et udtryks indhold.","de":"Ein Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.","de":"Ein Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.","el":"Ένας τόπος που συνδέεται με την ηχογράφηση, κινηματογράφηση κ.λπ. του περιεχομένου μιας έκφρασης.","en":"A place that is associated with recording, filming, etc., the content of an expression.","es":"Un lugar que está asociado a la grabación, filmación, etc., el contenido de una expresión.","et":"Koht, mis on seotud väljenduse sisu salvestamise, filmimise vms jäädvustamisega.","fi":"Paikka, joka liittyy ekspression sisällön äänitykseen, kuvaukseen tms.","fr":"Lieu qui est associé à l’enregistrement, au tournage, etc. du contenu d’une expression.","hu":"Egy hely, amely egy kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik.","lv":"Izteiksmes satura tveršanas vieta (t.i., ierakstīšana, filmēšana, u.tml.).","nl":"Een plaats die geassocieerd is met het opnemen, filmen etc. van de content van een expressie.","no":"Et sted som er forbundet med innspilling, opptak, etc. av innholdet i et uttrykk.","tr":"Bir anlatımın içeriğinin kaydedildiği, çekildiği vb. ile bağlantılı olan bir yer.","vi":"Địa điểm liên quan tới ghi, làm phim, v.v..., của nội dung của biểu hiện.","zh-Hans-CN":"和一种内容表达的内容的录制、摄制等有关的地点"},"label":{"ar":"لها مكان التقاط","ca":"té com a lloc de captura","cs":"má místo zaznamenání","da":"har optagelsessted","de":"ist Aufzeichnungsort","de":"ist Aufzeichnungsort","el":"έχει τόπο της σύλληψης","en":"has place of capture","es":"tiene lugar de captura","et":"jäädvustamiskoht","fi":"tallennuspaikka","fr":"a pour lieu de captation","hu":"rögzítés helye a következő:","lv":"tveršanas vieta","nl":"heeft plaats van vastleggen","no":"har innspillingssted","sv":"har inspelningsort","tr":"kayıt yeri ile ilişkilidir","vi":"có địa điểm thu nạp","zh-Hans-CN":"有摄录地点"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
