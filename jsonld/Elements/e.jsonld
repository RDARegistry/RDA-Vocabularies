                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20543", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToPerformance.en", "label":"has contributor family to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20546", "lexicalAlias":"http://rdaregistry.info/Elements/e/actorFamily.en", "label":"has actor family"},{"@id":"http://rdaregistry.info/Elements/e/P20554", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorFamily.en", "label":"has commentator family"},{"@id":"http://rdaregistry.info/Elements/e/P20560", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorFamily.en", "label":"has conductor family"},{"@id":"http://rdaregistry.info/Elements/e/P20548", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerFamily.en", "label":"has dancer family"},{"@id":"http://rdaregistry.info/Elements/e/P20549", "lexicalAlias":"http://rdaregistry.info/Elements/e/hostFamily.en", "label":"has host family"},{"@id":"http://rdaregistry.info/Elements/e/P20558", "lexicalAlias":"http://rdaregistry.info/Elements/e/instructorFamily.en", "label":"has instructor family"},{"@id":"http://rdaregistry.info/Elements/e/P20553", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistFamily.en", "label":"has instrumentalist family"},{"@id":"http://rdaregistry.info/Elements/e/P20550", "lexicalAlias":"http://rdaregistry.info/Elements/e/moderatorFamily.en", "label":"has moderator family"},{"@id":"http://rdaregistry.info/Elements/e/P20555", "lexicalAlias":"http://rdaregistry.info/Elements/e/narratorFamily.en", "label":"has narrator family"},{"@id":"http://rdaregistry.info/Elements/e/P20547", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenPresenterFamily.en", "label":"has onscreen presenter family"},{"@id":"http://rdaregistry.info/Elements/e/P20552", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistFamily.en", "label":"has panelist family"},{"@id":"http://rdaregistry.info/Elements/e/P20565", "lexicalAlias":"http://rdaregistry.info/Elements/e/presenterFamily.en", "label":"has presenter family"},{"@id":"http://rdaregistry.info/Elements/e/P20551", "lexicalAlias":"http://rdaregistry.info/Elements/e/puppeteerFamily.en", "label":"has puppeteer family"},{"@id":"http://rdaregistry.info/Elements/e/P20559", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerFamily.en", "label":"has singer family"},{"@id":"http://rdaregistry.info/Elements/e/P20557", "lexicalAlias":"http://rdaregistry.info/Elements/e/speakerFamily.en", "label":"has speaker family"},{"@id":"http://rdaregistry.info/Elements/e/P20556", "lexicalAlias":"http://rdaregistry.info/Elements/e/storytellerFamily.en", "label":"has storyteller family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/performerFamily.en", "label":"has performer family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20057","ToolkitDefinition":{"en":"A person, family, or corporate body responsible for performing, narrating, and/or presenting a work. (Deprecated)"},"ToolkitLabel":{"en":"performer, narrator, and/or presenter (Deprecated)"},"definition":{"en":["Relates an expression to a person, family, or corporate body responsible for performing, narrating, and/or presenting a work. (Deprecated)"]},"label":{"en":"has performer, narrator, and/or presenter (Deprecated)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"instructionNumber":"7.23","lexicalAlias":"http://rdaregistry.info/Elements/e/performerNarratorAndOrPresenter.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20351","label":{"ar":"لها شخص مؤدٍ","ca":"té com a persona intèrpret","cs":"má účinkujícího (osobu)","da":"har person, som er udøver","de":"hat Ausführende/Ausführender (Person)","de":"hat Ausführende/Ausführender (Person)","en":"has performer person","es":"tiene persona intérprete","et":"esitaja (isik)","fi":"esittäjä (henkilö)","fr":"a pour personne interprète","hu":"előadó személye a következő:","lv":"izpildītājs (persona)","nl":"heeft uitvoerder-persoon","no":"har utøver (person)","tr":"sanatçı kişisi ile ilişkilidir","zh-Hans-CN":"有表演者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale etc., ofte i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt."],"en":["Relates an expression to a person who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation."],"es":["Relaciona una expresión con una persona que contribuye a una expresión interpretando música, actuando, bailando, hablando y otros roles, a menudo en una presentación musical o dramática."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å framføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling."],"tr":["Bir anlatımı, genellikle müzikal veya dramatik bir performansta müzik yaparak, oyunculuk yaparak, dans ederek, konuşarak veya başka bir rolle anlatıma katkıda bulunan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مؤدٍ","ca":"persona intèrpret","cs":"účinkující (osoba)","da":"person, som er udøver","de":"Ausführende/Ausführender (Person)","de":"Ausführende/Ausführender (Person)","en":"performer person","es":"persona intérprete","et":"esitaja (isik)","fi":"esittäjä (henkilö)","fr":"personne interprète","hu":"előadó személy:","lv":"izpildītājs (persona)","nl":"uitvoerder-persoon","no":"utøver (person)","tr":"Sanat icra eden kişi","zh-Hans-CN":"表演者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي.","ca":"Persona que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica.","cs":"Osoba, která přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení.","da":"Person, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale etc., ofte i en musikalsk eller dramatisk præsentation etc.","de":"Eine Person, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","de":"Eine Person, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","en":"A person who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation.","es":"Una persona que contribuye a una expresión interpretando música, actuando, bailando, hablando y otros roles, a menudo en una presentación musical o dramática.","et":"Isik, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms.","fi":"Henkilö, joka osallistuu teoksen ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä.","fr":"Personne qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique.","hu":"Egy személy, aki zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml.","nl":"Een persoon die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie.","no":"En person som bidrar til et uttrykk ved å framføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling.","tr":"Müzik icra ederek, oyunculuk yaparak, dans ederek, konuşarak veya genellikle müzikal veya dramatik bir performansta başka bir rol üstlenerek bir anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
