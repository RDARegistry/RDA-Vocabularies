                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/aggregatedBy.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20320", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/aggregatedBy.en", "label":"is aggregated by"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20320", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/aggregatedBy.en", "label":"is aggregated by"}]},{"@id":"http://rdaregistry.info/Elements/e/P20319","label":{"ar":"تجميعات","ca":"agregats","cs":"agreguje","da":"aggregerer","de":"Aggregate","de":"Aggregate","en":"aggregates","es":"agregados","et":"liidetud väljendus","fi":"aggregoi ekspression","fr":"agrège","hu":"aggregálja:","lv":"iekļauts apkopojumā","nl":"aggregeert","no":"aggregerer","tr":"toplama","zh-Hans-CN":"合集"},"definition":{"ar":["تربط تعبيرة بتعبيرة مختارة كجزء من خطة تعبيرة تجميعية."],"ca":["Relaciona una expressió amb una expressió que és tria com a part del pla d’una expressió agregadora."],"cs":["Vztahuje vyjádření k vyjádření, které bylo zvoleno jako část plánu agregujícího vyjádření."],"da":["Relaterer et udtryk til et udtryk, som vælges som en del af planen af et aggregerende udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression, die als Teil des Konzepts einer aggregierenden Expression ausgewählt wird.,Setzt eine Expression in Beziehung zu einer Expression, die als Teil des Konzepts einer aggregierenden Expression ausgewählt wird."],"en":["Relates an expression to an expression that is chosen as part of the plan of an aggregating expression."],"es":["Relaciona una expresión con una expresión que se elige como parte del plan de una expresión agregada."],"et":["Seostab väljenduse väljendusega, mis on valitud liitva väljenduse kava osaks."],"fi":["Liittää ekspression ekspressioon, joka on valittu osaksi aggregoivan ekspression suunnitelmaa."],"fr":["Met une expression en relation avec une expression qui est choisie dans le cadre du plan d’une expression agrégatrice."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amelyet egy aggregáló kifejezési forma tervének részeként választanak."],"lv":["Sasaista izteiksmi ar izteiksmi, kas izvēlēta kā daļa no izteiksmes–apkopojuma plāna."],"nl":["Relateert een expressie aan een expressie die gekozen is als onderdeel van het plan van een aggregerende expressie."],"no":["Relaterer et uttrykk til et uttrykk som er valgt som del av planen for et aggregert uttrykk."],"tr":["Bir anlatımı, toplayıcı anlatım planının bir parçası olarak seçilen bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与被选为合集性内容表达之计划部分的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تجميعات","ca":"agregats","cs":"agreguje","da":"aggregerer","de":"Aggregate","de":"Aggregate","en":"aggregates","es":"agregados","et":"liidetud väljendus","fi":"aggregoi ekspression","fr":"agrège","hu":"aggregálja:","lv":"iekļauts apkopojumā","nl":"aggregeert","no":"aggregerer","tr":"toplama","zh-Hans-CN":"合集"},"ToolkitDefinition":{"ar":"تعبيرة مختارة كجزء من خطة تعبيرة تجميعية.","ca":"Expressió que és tria com a part del pla d’una expressió agregadora.","cs":"Vyjádření, které bylo zvoleno jako část plánu agregujícího vyjádření.","da":"Relaterer et udtryk til et udtryk, som vælges som en del af planen af et aggregerende udtryk.","de":"Eine Expression, die als Teil des Konzepts einer aggregierenden Expression ausgewählt wird.","de":"Eine Expression, die als Teil des Konzepts einer aggregierenden Expression ausgewählt wird.","en":"An expression that is chosen as part of the plan of an aggregating expression.","es":"Una expresión que se elige como parte del plan de una expresión agregada.","et":"Väljendus, mis on valitud liitva väljenduse kava osaks.","fi":"Ekspressio, joka on valittu osaksi aggregoivan ekspression suunnitelmaa.","fr":"Expression qui est choisie dans le cadre du plan d’une expression agrégatrice.","hu":"Egy kifejezési forma, amelyet egy aggregáló kifejezési forma tervének részeként választanak.","lv":"Izteiksme, kas izvēlēta kā daļa no izteiksmes–apkopojuma plāna","nl":"Een expressie die gekozen is als onderdeel van het plan van een aggregerende expressie.","no":"Et uttrykk som er valgt som del av planen for et aggregert uttrykk.","tr":"Bir toplama anlatımının planının parçası olarak seçilen bir anlatım.","zh-Hans-CN":"被选为合集性内容表达之计划部分的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/aggregates.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20319", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/aggregates.en", "label":"aggregates"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20319", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/aggregates.en", "label":"aggregates"}]},{"@id":"http://rdaregistry.info/Elements/e/P20227","definition":{"ar":["تربط بين تعبيرة ونسبة أبعاد صورة ثابتة أو شكل ثلاثي الأبعاد تجسده تعبيرة بأبعاد الشيء الذي تمثله."],"ca":["Relaciona una expressió amb una relació entre les dimensions d’una imatge fixa o d’una forma tridimensional realitzada per una expressió i les dimensions de la cosa que representa."],"cs":["Vztahuje vyjádření k poměru rozměrů statického obrazu nebo trojrozměrné formy realizovaných vyjádřením a rozměrů znázorňované věci."],"da":["Relaterer et udtryk til et forhold mellem et fast billede eller en tredimensionel form indeholdt eller realiseret i et udtryk til dimensionerne for den ting, der er repræsenteret."],"de":["Setzt eine Expression in Beziehung zu einem Verhältnis der Maße eines unbewegten Bilds oder einer dreidimensionalen Form, das/die in einer Expression realisiert ist, zu den Maßen der Sache, die es/sie repräsentiert.,Setzt eine Expression in Beziehung zu einem Verhältnis der Maße eines unbewegten Bilds oder einer dreidimensionalen Form, das/die in einer Expression realisiert ist, zu den Maßen der Sache, die es/sie repräsentiert."],"el":["Συνδέει μια έκφραση με τον λόγο των διαστάσεων μιας κινητής εικόνας ή μιας τρισδιάστατης μορφής που περιέχεται ή ενσωματώνεται σε μια έκφραση προς τις διαστάσεις του πράγματος που αναπαρίσταται."],"en":["Relates an expression to a ratio of the dimensions of a still image or three-dimensional form realized by an expression to the dimensions of the thing that is represented."],"es":["Relaciona una expresión con una relación de las dimensiones de una imagen fija o forma tridimensional realizada por una expresión con las dimensiones de la cosa que se representa."],"et":["Seostab väljenduse väljenduses sisalduva või sellena realiseeritud liikumatu pildi või kolmemõõtmelise vormi mõõtmete ja kujutatava asja mõõtmete suhtega."],"fi":["Liittää ekspression ekspression toteuttaman stillkuvan tai kolmiulotteisen muodon mittojen suhteeseen esitetyn kohteen mittoihin."],"fr":["Met une expression en relation avec un rapport entre les dimensions d’une image fixe ou d’une forme tridimensionnelle matérialisée par une expression et les dimensions de la chose représentée."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formában megtestesített állókép vagy háromdimenziós forma méretének és a kifejezési forma által ábrázolt dolog méretének viszonyításához."],"lv":["Sasaista izteiksmi ar izteiksmē ietvertā attēla vai trīsdimensiju modeļa izmēru attiecību pret izmēriem dabā."],"nl":["Relateert een expressie aan een verhouding van de afmetingen van een stilstaand beeld of driedimensionale vorm gerealiseerd door een expressie tot de afmetingen van het ding dat vertegenwoordigd wordt."],"no":["Relaterer et uttrykk til et forhold mellom målene til et stillbilde eller en tredimensjonal form i eller realisert i et uttrykk og målene til det som gjengis."],"tr":["Bir anlatımı, durağan bir görüntünün veya üç boyutlu formun temsili anlatımının boyutlarının temsil edilen şeyin boyutlarına oranıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với tỷ số của kích thước của hình ảnh tính hoặc hình thái ba chiều được chứa hoặc bao gồm trong biểu hiện với kích thước của vật được trình bày."],"zh-Hans-CN":["将一种内容表达与内容表达所实现的静态图像或三维形式的尺寸与其所代表的事物尺寸之比关联起来。"]},"ToolkitLabel":{"ar":"مقياس صورة ثابتة أو شكل ثلاثي الأبعاد","ca":"escala d’una imatge fixa o una forma tridimensional","cs":"měřítko statického obrazu nebo trojrozměrné formy","da":"målestoksforhold for fast billede eller tredimensionel form","de":"Maßstab eines unbewegten Bilds oder einer dreidimensionalen Form","de":"Maßstab eines unbewegten Bilds oder einer dreidimensionalen Form","el":"κλίμακα της σταθερής εικόνας ή της τρισδιάστατης μορφής","en":"scale of still image or three-dimensional form","es":"escala de imagen fija o forma tridimensional","et":"liikumatu pildi või kolmemõõtmelise vormi mõõtkava","fi":"stillkuvan tai kolmiulotteisen muodon mittakaava","fr":"échelle d’une image fixe ou d’une forme tridimensionnelle","hu":"állókép vagy háromdimenziós forma méretaránya:","lv":"attēla vai trīsdimensiju modeļa mērogs","nl":"schaal van stilstaand beeld of drie-dimensionale vorm","no":"målestokk for stillbilde eller tredimensjonal form","sv":"skala för stillbild eller tredimensionell bild","tr":"durağan görüntü veya üç boyutlu şekil ölçeği","vi":"tỷ lệ của hình ảnh tĩnh hoặc hình thái ba chiều","zh-Hans-CN":"静态图像或三维形式的比例尺"},"ToolkitDefinition":{"ar":"نسبة أبعاد صورة ثابتة أو شكل ثلاثي الأبعاد تجسده تعبيرة بأبعاد الشيء الذي تمثله.","ca":"Relació entre les dimensions d’una imatge fixa o d’una forma tridimensional realitzada per una expressió i les dimensions de la cosa que representa.","cs":"Poměr rozměrů statického obrazu nebo trojrozměrné formy realizovaných vyjádřením a rozměrů znázorňované věci.","da":"Forhold mellem et fast billede eller en tredimensionel form indeholdt eller realiseret i et udtryk til dimensionerne for den ting, der er repræsenteret.","de":"Ein Verhältnis der Maße eines unbewegten Bilds oder einer dreidimensionalen Form, das/die in einer Expression realisiert ist, zu den Maßen der Sache, die es/sie repräsentiert.","de":"Ein Verhältnis der Maße eines unbewegten Bilds oder einer dreidimensionalen Form, das/die in einer Expression realisiert ist, zu den Maßen der Sache, die es/sie repräsentiert.","el":"Ο λόγος των διαστάσεων μιας κινητής εικόνας ή μιας τρισδιάστατης μορφής που περιέχεται ή ενσωματώνεται σε μια έκφραση προς τις διαστάσεις του πράγματος που αναπαρίσταται.","en":"A ratio of the dimensions of a still image or three-dimensional form realized by an expression to the dimensions of the thing that is represented.","es":"Una relación de las dimensiones de una imagen fija o forma tridimensional realizada por una expresión con las dimensiones de la cosa que se representa.","et":"Väljenduses sisalduva või sellena realiseeritud liikumatu pildi või kolmemõõtmelise vormi mõõtmete ja kujutatava asja mõõtmete suhe.","fi":"Ekspression toteuttaman stillkuvan tai kolmiulotteisen muodon mittojen suhde esitetyn kohteen mittoihin.","fr":"Rapport entre les dimensions d’une image fixe ou d’une forme tridimensionnelle matérialisée par une expression et les dimensions de la chose représentée.","hu":"Egy kifejezési formában megtestesített állókép vagy háromdimenziós forma méretének és a kifejezési forma által ábrázolt dolog méretének viszonyítása.","lv":"Izteiksmē ietvertā attēla vai trīsdimensiju modeļa izmēru attiecība pret izmēriem dabā.","nl":"Een verhouding van de afmetingen van een stilstaand beeld of driedimensionale vorm gerealiseerd door een expressie tot de afmetingen van het ding dat vertegenwoordigd wordt.","no":"Et forhold mellom målene til et stillbilde eller en tredimensjonal form i eller realisert i et uttrykk og målene til det som gjengis.","tr":"Bir anlatım tarafından gerçekleştirilen durağan bir görüntü veya üç boyutlu bir formun boyutlarının, temsil edilen şeyin boyutlarına oranı.","vi":"Tỷ số của kích thước của hình ảnh tính hoặc hình thái ba chiều được chứa hoặc bao gồm trong biểu hiện với kích thước của vật được trình bày.","zh-Hans-CN":"内容表达所实现的静态图像或三维形式的尺寸与其所代表的事物尺寸之比"},"label":{"ar":"لها مقياس صورة ثابتة أو شكل ثلاثي الأبعاد","ca":"té com a escala d’una imatge fixa o una forma tridimensional","cs":"má měřítko statického obrazu nebo trojrozměrné formy","da":"har målestoksforhold for fast billede eller tredimensionel form","de":"hat Maßstab eines unbewegten Bilds oder einer dreidimensionalen Form","de":"hat Maßstab eines unbewegten Bilds oder einer dreidimensionalen Form","el":"έχει κλίμακα της σταθερής εικόνας ή της τρισδιάστατης μορφής","en":"has scale of still image or three-dimensional form","es":"tiene escala de imagen fija o forma tridimensional","et":"liikumatu pildi või kolmemõõtmelise vormi mõõtkava","fi":"stillkuvan tai kolmiulotteisen muodon mittakaava","fr":"a pour échelle d’une image fixe ou d’une forme tridimensionnelle","hu":"állókép vagy háromdimenziós forma méretaránya a következő:","lv":"attēla vai trīsdimensiju modeļa mērogs","nl":"heeft schaal van stilstaand beeld of drie-dimensionale vorm","no":"har målestokk for stillbilde eller tredimensjonal form","sv":"har skala för stillbild eller tredimensionell bild","tr":"durağan görüntü veya üç boyutlu formun ölçeği ile ilişkilidir","vi":"có tỷ lệ của hình ảnh tĩnh hoặc hình thái ba chiều","zh-Hans-CN":"有静态图像或三维形式的比例尺"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20228", "lexicalAlias":"http://rdaregistry.info/Elements/e/scale.en", "label":"has scale"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/scaleOfStillImageOrThreeDimensionalForm.en","instructionNumber":"7.25.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20227", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/scaleOfStillImageOrThreeDimensionalForm.en", "label":"has scale of still image or three-dimensional form"}]},{"@id":"http://rdaregistry.info/Elements/e/P20117","ToolkitDefinition":{"en":"An expression of a work that examines the source expression to identify its components and their relations. (Deprecated)"},"ToolkitLabel":{"en":"analysed in (expression) (Deprecated)"},"definition":{"en":["Relates an expression to an expression of a work that examines the source expression to identify its components and their relations. (Deprecated)"]},"label":{"en":"is analysed in (expression) (Deprecated)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20202", "lexicalAlias":"http://rdaregistry.info/Elements/e/describedInExpression.en", "label":"is described in (expression) (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/analysedInExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20136","ToolkitDefinition":{"en":"An expression of a work that has been examined to identify its components and their relations. (Deprecated)"},"ToolkitLabel":{"en":"analysis of (expression) (Deprecated)"},"definition":{"en":["Relates an expression to an expression of a work that has been examined to identify its components and their relations. (Deprecated)"]},"label":{"en":"is analysis of (expression) (Deprecated)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20072", "lexicalAlias":"http://rdaregistry.info/Elements/e/descriptionOfExpression.en", "label":"is description of (expression) (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/analysisOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20028","label":{"ar":"لها وكيل فنان رسوم متحركة","ca":"té com a agent animador","cs":"má animátora (agenta)","da":"har agent, som er animator","de":"hat Trickfilmzeichnerin/Trickfilmzeichner (Akteur)","de":"hat Trickfilmzeichnerin/Trickfilmzeichner (Akteur)","el":"έχει δημιουργό κινουμένων σχεδίων","en":"has animator agent","es":"tiene agente animador","et":"animaator (tegija)","fi":"animaattori (toimija)","fr":"a pour agent animateur","hu":"animátor ágense a következő:","lv":"animators (aģents)","nl":"heeft animator-actor","no":"har animatør (agent)","tr":"animatör temsilci ile ilişkilidir","vi":"cóngười làm phim hoạt hoạ","zh-Hans-CN":"有动画师行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال جعل كائنات أو رسومات جامدة تتحرك حركة واضحة."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió donant l’aparença de moviment a objectes o dibuixos inanimats."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření tím, že dodává zdání pohybu neživým předmětům nebo kresbám."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at give en illusion af bevægelse til livløse objekter eller tegninger."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου κινητής εικόνας ή προγράμματος υπολογιστή δίνοντας φαινομενική κίνηση σε άψυχα αντικείμενα ή σχέδια."],"en":["Relates an expression to an agent who contributes to an expression by giving apparent movement to inanimate objects or drawings."],"es":["Relaciona una expresión con un agente que contribuye a una expresión dando movimiento aparente a objetos o dibujos inanimados."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, pannes näiliselt liikuma elutud esemed või joonistused."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en donnant l’illusion du mouvement à des objets inanimés ou à des dessins."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely élettelen tárgyak vagy rajzok látszólagos mozgatásával járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, piešķirot redzamu kustību nekustīgiem objektiem vai zīmējumiem."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het geven van schijnbare beweging aan levenloze objecten of tekeningen."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å gi tilsynelatende bevegelse til tegninger eller figurer."],"tr":["Bir anlatımı, hareketsiz nesnelere veya çizimlere belirgin hareket vererek anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm hình ảnh động hoặc chương trình máy tính bằng cách đưa ra chuyển động biểu kiến đối với vật vô tri vô giác hoặc bản vẽ."],"zh-Hans-CN":["将一种内容表达与通过给予无生命对象或绘画以貌似运动而对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل فنان رسوم متحركة","ca":"agent animador","cs":"animátor (agent)","da":"agent, som er animator","de":"Trickfilmzeichnerin/Trickfilmzeichner (Akteur)","de":"Trickfilmzeichnerin/Trickfilmzeichner (Akteur)","el":"δημιουργός κινουμένων σχεδίων","en":"animator agent","es":"agente animador","et":"animaator (tegija)","fi":"animaattori (toimija)","fr":"agent animateur","hu":"animátor ágens:","lv":"animators (aģents)","nl":"animator-actor","no":"animatør (agent)","tr":"animatör temsilcisi","vi":"người làm phim hoạt hoạ","zh-Hans-CN":"动画师行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال جعل كائنات أو رسومات جامدة تتحرك حركة واضحة.","ca":"Agent que contribueix a una expressió donant l’aparença de moviment a objectes o dibuixos inanimats.","cs":"Agent, který přispívá k vyjádření tím, že dodává zdání pohybu neživým předmětům nebo kresbám.","da":"Agent, som bidrager til et udtryk ved at give en illusion af bevægelse til livløse objekter eller tegninger.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου κινητής εικόνας ή προγράμματος υπολογιστή δίνοντας φαινομενική κίνηση σε άψυχα αντικείμενα ή σχέδια.","en":"An agent who contributes to an expression by giving apparent movement to inanimate objects or drawings.","es":"Un agente que contribuye a una expresión dando movimiento aparente a objetos o dibujos inanimados.","et":"Tegija, kes annab panuse väljendusse, pannes näiliselt liikuma elutud esemed või joonistused.","fi":"Toimija, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin.","fr":"Agent qui contribue à une expression en donnant l’illusion du mouvement à des objets inanimés ou à des dessins.","hu":"Egy ágens, amely élettelen tárgyak vagy rajzok látszólagos mozgatásával járul hozzá egy kifejezési formához.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, piešķirot redzamu kustību nekustīgiem objektiem vai zīmējumiem.","nl":"Een actor die bijdraagt aan een expressie door het geven van schijnbare beweging aan levenloze objecten of tekeningen.","no":"En agent som bidrar til et uttrykk ved å gi tilsynelatende bevegelse til tegninger eller figurer.","tr":"Cansız nesnelere veya çizimlere görünür hareket vererek bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm hình ảnh động hoặc chương trình máy tính bằng cách đưa ra chuyển động biểu kiến đối với vật vô tri vô giác hoặc bản vẽ.","zh-Hans-CN":"通过给予无生命对象或绘画以貌似运动而对一种内容表达有贡献的一个行为者"},"note":{"ar":["يُستبعد رسم الرسوم الكرتونية."],"ca":["S’exclou la creació dels dibuixos animats."],"cs":["Tvorba kreseb, které jsou animovány, je vyloučena."],"da":["Skabelse af tegningerne, som er animeret, er ikke omfattet."],"de":["Darunter fällt nicht die Erstellung der Zeichnungen, die animiert werden.,Darunter fällt nicht die Schaffung der Zeichnungen, die animiert werden."],"el":["Δεν περιλαμβάνεται η δημιουργία κινουμένων σχεδίων."],"en":["Creation of the drawings that are animated is excluded."],"es":["Queda excluida la creación de dibujos animados."],"et":["Ei hõlma liikuma pandavate joonistuste loomist."],"fi":["Ei koske animaatiopiirrosten tekijää."],"fr":["La création des dessins qui sont animés est exclue."],"hu":["Az animált rajzok megalkotása nem tartozik ide."],"lv":["Neietver animētu zīmējumu radīšanu."],"nl":["Creatie van de tekeningen die geanimeerd zijn is uitgesloten."],"no":["Det å skape tegningene som animeres, er ikke inkludert."],"tr":["Animasyonlu çizimlerin oluşturulması hariçtir."],"vi":["Bao gồm cả sáng tạo các bản vẽ sống động."],"zh-Hans-CN":["不包括动画图的创作。"]},"altLabel":{"ar":["فنان رسوم متحركة"],"ca":["animador"],"cs":["animátor"],"da":["animator"],"de":["Trickfilmzeichner,Trickfilmzeichner"],"en":["animator"],"es":["animador"],"et":["animaator"],"fi":["animaattori"],"fr":["animateur"],"hu":["animátor:"],"nl":["animator"],"no":["animatør"],"tr":["animatör"],"zh-Hans-CN":["动画师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20329", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToPerformance.en", "label":"has contributor agent to performance"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/animatorAgent.en","See Also":[{"@id":"http://rdaregistry.info/Elements/w/P10058", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistAgent.en", "label":"has artist agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20453", "lexicalAlias":"http://rdaregistry.info/Elements/e/animatorCollectiveAgent.en", "label":"has animator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20394", "lexicalAlias":"http://rdaregistry.info/Elements/e/animatorPerson.en", "label":"has animator person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20028", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/animatorAgent.en", "label":"has animator agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20028", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/animatorAgent.en", "label":"has animator agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20453","label":{"ar":"لها وكيل جماعي فنان رسوم متحركة","ca":"té com a agent col·lectiu animador","cs":"má animátora (kolektivního agenta)","da":"har kollektiv agent, som er animator","de":"hat Trickfilmzeichnerin/Trickfilmzeichner (Gemeinschaftlicher Akteur)","de":"hat Trickfilmzeichnerin/Trickfilmzeichner (Gemeinschaftlicher Akteur)","en":"has animator collective agent","es":"tiene agente colectivo animador","et":"animaator (kollektiiv)","fi":"animaattori (yhteistoimija)","fr":"a pour agent collectif animateur","hu":"animátor kollektív ágense a következő:","lv":"animators (grupa)","nl":"heeft animator-collectieve actor","no":"har animatør (kollektiv agent)","tr":"animatör kolektif temsilci ile ilişkilidir","zh-Hans-CN":"有动画师集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يساهم في تعبيرة من خلال جعل كائنات أو رسومات جامدة تتحرك حركة واضحة."],"ca":["Relaciona una expressió amb un agent col·lectiu que contribueix a una expressió donant l’aparença de moviment a objectes o dibuixos inanimats."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který přispívá k vyjádření tím, že dodává zdání pohybu neživým předmětům nebo kresbám."],"da":["Relaterer et udtryk til en kollektiv agent, som bidrager til et udtryk ved at give en illusion af bevægelse til livløse objekter eller tegninger."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt."],"en":["Relates an expression to a collective agent who contributes to an expression by giving apparent movement to inanimate objects or drawings."],"es":["Relaciona una expresión con un agente colectivo que contribuye a una expresión al dar movimiento aparente a objetos o dibujos inanimados."],"et":["Seostab väljenduse kollektiiviga, kes annab panuse väljendusse, pannes näiliselt liikuma elutud esemed või joonistused."],"fi":["Liittää ekspression yhteistoimijaan, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin."],"fr":["Met une expression en relation avec un agent collectif qui contribue à une expression en donnant l’illusion du mouvement à des objets inanimés ou à des dessins."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely élettelen tárgyak vagy rajzok látszólagos mozgatásával járul hozzá a forráshoz."],"lv":["Sasaista izteiksmi ar grupu, kas sniegusi ieguldījumu izteiksmē, piešķirot redzamu kustību nekustīgiem objektiem vai zīmējumiem."],"nl":["Relateert een expressie aan een collectieve actor die bijdraagt aan een expressie door het geven van schijnbare beweging aan levenloze objecten of tekeningen."],"no":["Relaterer et uttrykk til en kollektiv agent som bidrar til et uttrykk ved å gi tilsynelatende bevegelse til tegninger eller figurer."],"tr":["Bir anlatımı, hareketsiz nesnelere veya çizimlere belirgin hareket vererek anlatıma katkıda bulunan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过给予无生命对象或绘画以貌似运动而对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فنان رسوم متحركة","ca":"agent col·lectiu animador","cs":"animátor (kolektivní agent)","da":"kollektiv agent, som er animator","de":"Trickfilmzeichnerin/Trickfilmzeichner (Gemeinschaftlicher Akteur)","de":"Trickfilmzeichnerin/Trickfilmzeichner (Gemeinschaftlicher Akteur)","en":"animator collective agent","es":"agente colectivo animador","et":"animaator (kollektiiv)","fi":"animaattori (yhteistoimija)","fr":"agent collectif animateur","hu":"animátor kollektív ágense:","lv":"animators (grupa)","nl":"animator-collectieve actor","no":"animatør (kollektiv agent)","tr":"animatör kolektif temsilcisi","zh-Hans-CN":"动画师集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يساهم في تعبيرة من خلال جعل كائنات أو رسومات جامدة تتحرك حركة واضحة.","ca":"Agent col·lectiu que contribueix a una expressió donant l’aparença de moviment a objectes o dibuixos inanimats.","cs":"Kolektivní agent, který přispívá k vyjádření tím, že dodává zdání pohybu neživým předmětům nebo kresbám.","da":"Kollektiv agent, som bidrager til et udtryk ved at give en illusion af bevægelse til livløse objekter eller tegninger.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","en":"A collective agent who contributes to an expression by giving apparent movement to inanimate objects or drawings.","es":"Un agente colectivo que contribuye a una expresión al dar movimiento aparente a objetos o dibujos inanimados.","et":"Kollektiiv, kes annab panuse väljendusse, pannes näiliselt liikuma elutud esemed või joonistused.","fi":"Yhteistoimija, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin.","fr":"Agent collectif qui contribue à une expression en donnant l’illusion du mouvement à des objets inanimés ou à des dessins.","hu":"Egy kollektív ágens, amely élettelen tárgyak vagy rajzok látszólagos mozgatásával járul hozzá a forráshoz.","lv":"Grupa, kas sniegusi ieguldījumu izteiksmē, piešķirot redzamu kustību nekustīgiem objektiem vai zīmējumiem.","nl":"Een collectieve actor die bijdraagt aan een expressie door het geven van schijnbare beweging aan levenloze objecten of tekeningen.","no":"En kollektiv agent som bidrar til et uttrykk ved å gi tilsynelatende bevegelse til tegninger eller figurer.","tr":"Durgun nesnelere veya çizimlere belirgin hareket vererek bir ifadeye katkıda bulunan kolektif bir temsilci","zh-Hans-CN":"通过给予无生命对象或绘画以貌似运动而对一种内容表达有贡献的一个集体行为者"},"note":{"ar":["يُستبعد رسم الرسوم الكرتونية."],"ca":["S’exclou la creació dels dibuixos animats."],"cs":["Tvorba kreseb, které jsou animovány, je vyloučena."],"da":["Skabelse af tegningerne, som er animeret, er ikke omfattet."],"de":["Darunter fällt nicht die Schaffung der Zeichnungen, die animiert werden.,Darunter fällt nicht die Schaffung der Zeichnungen, die animiert werden."],"en":["Creation of the drawings that are animated is excluded."],"es":["La creación de los dibujos que son animados se excluye."],"et":["Ei hõlma liikuma pandavate joonistuste loomist."],"fi":["Ei koske animaatiopiirrosten tekijää."],"fr":["La création des dessins qui sont animés est exclue."],"hu":["Az animált rajzok megalkotása nem tartozik ide."],"lv":["Neietver animētu zīmējumu radīšanu."],"nl":["Creatie van de tekeningen die geanimeerd zijn is uitgesloten."],"no":["Det å skape tegningene som animeres, er ikke inkludert."],"tr":["Animasyonlu çizimlerin oluşturulması hariçtir"],"zh-Hans-CN":["不包括动画图的创作。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
