                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20425", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToPerformance.en", "label":"has contributor collective agent to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20428", "lexicalAlias":"http://rdaregistry.info/Elements/e/actorCollectiveAgent.en", "label":"has actor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20436", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCollectiveAgent.en", "label":"has commentator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20442", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCollectiveAgent.en", "label":"has conductor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20430", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerCollectiveAgent.en", "label":"has dancer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20431", "lexicalAlias":"http://rdaregistry.info/Elements/e/hostCollectiveAgent.en", "label":"has host collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20440", "lexicalAlias":"http://rdaregistry.info/Elements/e/instructorCollectiveAgent.en", "label":"has instructor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20435", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistCollectiveAgent.en", "label":"has instrumentalist collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20432", "lexicalAlias":"http://rdaregistry.info/Elements/e/moderatorCollectiveAgent.en", "label":"has moderator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20437", "lexicalAlias":"http://rdaregistry.info/Elements/e/narratorCollectiveAgent.en", "label":"has narrator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20429", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenPresenterCollectiveAgent.en", "label":"has onscreen presenter collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20434", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCollectiveAgent.en", "label":"has panelist collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20447", "lexicalAlias":"http://rdaregistry.info/Elements/e/presenterCollectiveAgent.en", "label":"has presenter collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20433", "lexicalAlias":"http://rdaregistry.info/Elements/e/puppeteerCollectiveAgent.en", "label":"has puppeteer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20441", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerCollectiveAgent.en", "label":"has singer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20439", "lexicalAlias":"http://rdaregistry.info/Elements/e/speakerCollectiveAgent.en", "label":"has speaker collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20438", "lexicalAlias":"http://rdaregistry.info/Elements/e/storytellerCollectiveAgent.en", "label":"has storyteller collective agent"},{"@id":"http://rdaregistry.info/Elements/e/object/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/performerCollectiveAgent.en", "label":"has performer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/performerCollectiveAgent.en", "label":"has performer collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20469","label":{"ar":"لها هيئة مؤدية","ca":"té com a entitat corporativa intèrpret","cs":"má účinkujícího (korporaci)","da":"har korporation, som er udøver","de":"hat Ausführende/Ausführenden (Körperschaft)","de":"hat Ausführende/Ausführenden (Körperschaft)","en":"has performer corporate body","es":"tiene organismo corporativo intérprete","et":"esitaja (asutus)","fi":"esittäjä (yhteisö)","fr":"a pour collectivité interprète","hu":"előadó testülete a következő:","lv":"izpildītājs (institūcija)","nl":"heeft uitvoerder-corporatie","no":"har utøver (korporasjon)","tr":"sanatçı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有表演者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení."],"da":["Relaterer et udtryk til en korporation, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale etc., ofte i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt."],"en":["Relates an expression to a corporate body who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión al interpretar música, una actuación, un baile, discurso, etc."],"et":["Seostab väljenduse asutusega, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms."],"fi":["Liittää ekspression yhteisöön, joka osallistuu ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en korporasjon som bidrar til et uttrykk ved å fremføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling."],"tr":["Bir anlatımı, genellikle müzikal veya dramatik bir sunumda müzik, oyunculuk, dans, konuşma ve diğer rollerle anlatıma katkıda bulunan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مؤدية","ca":"entitat corporativa intèrpret","cs":"účinkující (korporace)","da":"korporation, som er udøver","de":"Ausführende/Ausführender (Körperschaft)","de":"Ausführende/Ausführender (Körperschaft)","en":"performer corporate body","es":"organismo corporativo intérprete","et":"esitaja (asutus)","fi":"esittäjä (yhteisö)","fr":"collectivité interprète","hu":"előadó testület:","lv":"izpildītājs (institūcija)","nl":"uitvoerder-corporatie","no":"utøver (korporasjon)","tr":"sanatçı tüzel kişi","zh-Hans-CN":"表演者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي.","ca":"Entitat corporativa que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica.","cs":"Korporace, která přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení.","da":"Korporation, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale etc., ofte i en musikalsk eller dramatisk præsentation etc.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","en":"A corporate body who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation.","es":"Un organismo corporativo que contribuye a una expresión al interpretar música, una actuación, un baile, discurso, etc.","et":"Asutus, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms.","fi":"Yhteisö, joka osallistuu ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä.","fr":"Collectivité qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique.","hu":"Egy testület, amely zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban.","lv":"Institūcija, kas sniegusi ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml.","nl":"Een corporatie die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie.","no":"En korporasjon som bidrar til et uttrykk ved å fremføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling.","tr":"Tüzel bir kişi, dramatik tiyatro oyunu ya da sıklıkla bir müzikalde ,diğer rolleri ve konuşma,dans etme,rol yapma,müzik yapma ile bir ifadeye katkı sağlar.","zh-Hans-CN":"通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20484", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToPerformance.en", "label":"has contributor corporate body to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20487", "lexicalAlias":"http://rdaregistry.info/Elements/e/actorCorporateBody.en", "label":"has actor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20495", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorCorporateBody.en", "label":"has commentator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20501", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorCorporateBody.en", "label":"has conductor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20489", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerCorporateBody.en", "label":"has dancer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20490", "lexicalAlias":"http://rdaregistry.info/Elements/e/hostCorporateBody.en", "label":"has host corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20499", "lexicalAlias":"http://rdaregistry.info/Elements/e/instructorCorporateBody.en", "label":"has instructor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20494", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistCorporateBody.en", "label":"has instrumentalist corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20491", "lexicalAlias":"http://rdaregistr