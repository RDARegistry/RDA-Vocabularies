                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/artDirectorCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20425", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToPerformance.en", "label":"has contributor collective agent to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20038", "lexicalAlias":"http://rdaregistry.info/Elements/e/artDirectorAgent.en", "label":"has art director agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20468", "lexicalAlias":"http://rdaregistry.info/Elements/e/artDirectorCorporateBody.en", "label":"has art director corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20527", "lexicalAlias":"http://rdaregistry.info/Elements/e/artDirectorFamily.en", "label":"has art director family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20409", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/artDirectorCollectiveAgent.en", "label":"has art director collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20409", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/artDirectorCollectiveAgent.en", "label":"has art director collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20468","label":{"ar":"لها هيئة مخرجة فنية","ca":"té com a entitat corporativa directora artística","cs":"má art directora filmu (korporaci)","da":"har korporation, som er art director","de":"hat Art Director (Körperschaft)","de":"hat Art Director (Körperschaft)","en":"has art director corporate body","es":"tiene organismo corporativo director de arte","et":"filmikunstnik (asutus)","fi":"lavastaja (yhteisö)","fr":"a pour collectivité directrice artistique","hu":"művészeti vezető testülete a következő:","l