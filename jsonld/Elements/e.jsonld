                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20114", "lexicalAlias":"http://rdaregistry.info/Elements/e/imitatedAsExpression.en", "label":"is imitated as expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/parodiedAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20142", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/parodiedAsExpression.en", "label":"is parodied as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20142", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/parodiedAsExpression.en", "label":"is parodied as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20144","label":{"ar":"هي مستحوذة جزئيًا بتعبيرة","ca":"és absorbit en part per una expressió","cs":"je částečně absorbováno vyjádřením","da":"er delvis indlemmet af udtryk","de":"ist teilweise aufgegangen in (Expression)","de":"ist teilweise aufgegangen in (Expression)","el":"απορροφήθηκε μερικώς από (έκφραση)","en":"is absorbed in part by expression","es":"es absorbido en parte por la expresión","et":"osaliselt sulandunud väljendusega","fi":"sulautunut osittain ekspressioon","fr":"est absorbé en partie par une expression","hu":"részben magába olvasztja a következő kifejezési forma:","lv":"ir daļēji iekļaujošā izteiksme","nl":"is gedeeltelijk opgenomen door expressie","no":"er delvis innlemmet i uttrykk","tr":"anlatım tarafından kısmen kapsanmıştır","vi":"được hấp thụ một phần bởi (biểu hiện)","zh-Hans-CN":"被内容表达部分吸收"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يكون محتواه مدمجًا في محتوى جزئي لتعبيرة عمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra el contingut de la qual incorpora parcialment el contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah zahrnuje částečný obsah zahrnuje částečný obsah vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, hvis indhold inkorporerer det delvise indhold af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt teilweise durch den Inhalt einer Expression eines anderen Werks erweitert wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt teilweise durch den Inhalt einer Expression eines anderen Werks erweitert wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο ενσωματώνει μέρος του περιεχομένου μιας άλλης έκφρασης."],"en":["Relates an expression to an expression of a work whose content incorporates the partial content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido incorpora el contenido parcial de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mille sisu haarab osaliselt endasse teise teose väljenduse sisu."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisältöön toisen teoksen ekspression osittainen sisältö on yhdistynyt."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu intègre le contenu partiel d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek tartalma egy másik mű kifejezési formájának részleges tartalmát magába olvasztja."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kuras saturs iekļauj cita darba izteiksmes satura daļu."],"nl":["Relateert een expressie aan een expressie van een werk waarvan de content de gedeeltelijke content van een expressie van een ander werk opneemt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som omfatter en del av innholdet i et uttrykk av et annet verk."],"tr":["Bir anlatımı, içeriği başka bir esein anlatımının kısmi içeriğini içeren bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sáp nhập một phần của nội dung của biểu hiện khác."],"zh-Hans-CN":["将一种内容表达与其内容纳入另一种作品的一种内容表达之部分内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مستحوذة جزئيًا بتعبيرة","ca":"absorbit en part per una expressió","cs":"částečně absorbováno vyjádřením","da":"delvis indlemmet af udtryk","de":"Teilweise aufgegangen in (Expression)","de":"Teilweise aufgegangen in (Expression)","el":"απορροφήθηκε μερικώς από (έκφραση)","en":"absorbed in part by expression","es":"absorbido en parte por la expresión","et":"osaliselt sulandunud väljendusega","fi":"sulautunut osittain ekspressioon","fr":"absorbé en partie par une expression","hu":"részben magába olvasztja a következő kifejezési forma:","lv":"daļēji iekļaujošā izteiksme","nl":"gedeeltelijk opgenomen door expressie","no":"delvis innlemmet i uttrykk","tr":"anlatım tarafından kısmen kapsanan","vi":"được hấp thụ một phần bởi (biểu hiện)","zh-Hans-CN":"被内容表达部分吸收"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يكون محتواه مدمجًا في محتوى جزئي لتعبيرة عمل آخر.","ca":"Expressió d’una obra el contingut de la qual incorpora parcialment el contingut d’una expressió d’una altra obra.","cs":"Vyjádření díla, jehož obsah zahrnuje částečný obsah zahrnuje částečný obsah vyjádření jiného díla.","da":"Udtryk af et værk, hvis indhold inkorporerer det delvise indhold af et udtryk af et andet værk.","de":"Eine Expression eines Werks, deren Inhalt teilweise durch den Inhalt einer Expression eines anderen Werks erweitert wird.","de":"Eine Expression eines Werks, deren Inhalt teilweise durch den Inhalt einer Expression eines anderen Werks erweitert wird.","el":"Μια έκφραση ενός έργου το οποίο ενσωματώνει μέρος του περιεχομένου μιας άλλης έκφρασης.","en":"An expression of a work whose content incorporates the partial content of an expression of another work.","es":"Una expresión de una obra cuyo contenido incorpora el contenido parcial de una expresión de otra obra.","et":"Teose väljendus, mille sisu haarab osaliselt endasse teise teose väljenduse sisu.","fi":"Teoksen ekspressio, jonka sisältöön toisen teoksen ekspression osittainen sisältö on yhdistynyt.","fr":"Expression d’une œuvre dont le contenu intègre le contenu partiel d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amelynek tartalma egy másik mű kifejezési formájának részleges tartalmát magába olvasztja.","lv":"Darba izteiksme, kuras saturs iekļauj cita darba izteiksmes satura daļu.","nl":"Een expressie van een werk waarvan de content de gedeeltelijke content van een expressie van een ander werk opneemt.","no":"Et uttrykk av et verk som omfatter en del av innholdet i et uttrykk av et annet verk.","tr":"İçeriği başka bir eserin bir anlatımının kısmi içeriğini kapsayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sáp nhập một phần của nội dung của biểu hiện khác.","zh-Hans-CN":"其内容纳入另一种作品的一种内容表达之部分内容的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/absorbedInPartByExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20144", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/absorbedInPartByExpression.en", "label":"is absorbed in part by expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20144", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/absorbedInPartByExpression.en", "label":"is absorbed in part by expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20166","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يختصر تعبيرة لعمل ذي صلة دون تغيير المعنى العام أو طريقة العرض."],"ca":["Relaciona una expressió amb una expressió d’una obra que escurça una expressió d’una obra relacionada sense canviar-ne el significat general o la forma de presentació."],"cs":["Vztahuje vyjádření k vyjádření díla, které zkracuje vyjádření souvisejícího díla, aniž by se změnil celkový význam nebo způsob prezentace."],"da":["Relaterer et udtryk til et udtryk af et værk, som forkorter et udtryk af et relateret værk uden at ændre den overordnede betydning eller præsentationsmåde."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, das eine Expression eines in Beziehung stehenden Werks kürzt, ohne die allgemeine Bedeutung oder Darstellungsweise zu ändern.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, das eine Expression eines in Beziehung stehenden Werks kürzt, ohne die allgemeine Bedeutung oder Darstellungsweise zu ändern."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο περιορίζει [την έκταση] μιας έκφρασης-πηγής χωρίς να μεταβάλλει το γενικό νόημα ή τον τρόπο της παρουσίασης."],"en":["Relates an expression to an expression of a work that shortens an expression of a related work without changing the general meaning or manner of presentation."],"es":["Relaciona una expresión con una expresión de una obra que acorta una expresión de una obra relacionada sin cambiar el significado general o la forma de presentación."],"et":["Seostab väljenduse teose väljendusega, milles on lühendatud seotud teose väljendust, muutmata selle üldist tähendust ja esitusviisi."],"fi":["Liittää ekspression teoksen ekspressioon, joka lyhentää siihen liittyvän teoksen ekspressiota muuttamatta sen merkityssisältöä tai esitystyyliä."],"fr":["Met une expression en relation avec une expression d’une œuvre qui raccourcit une expression d’une œuvre en relation sans en changer le sens général ou le mode de présentation."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy kapcsolódó mű kifejezési formáját lerövidíti anélkül, hogy általános jelentését vagy prezentációját megváltoztatná."],"lv":["Sasaista izteiksmi ar saistītā darba jauna izteiksmi, kas saīsina iepriekšējo izteiksmi, nemainot nozīmi vai pasniegšanas veidu."],"nl":["Relateert een expressie aan een expressie van een werk dat een expressie van een gerelateerd werk inkort zonder de algehele betekenis of manier van presentatie te veranderen."],"no":["Relaterer et uttrykk til et uttrykk av et verk som forkorter et uttrykk av et relatert verk uten å endre den generelle meningen eller presentasjonsmåten."],"tr":["Bir anlatımı, genel anlamını veya sunum şeklini değiştirmeden ilgili bir eserin anlatımını kısaltan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm rút ngắn biểu hiện tài nguyên mà không thay đổi ý nghĩa tổng quát hoặc phương các trình bày."],"zh-Hans-CN":["将一种内容表达与缩短一种相关作品的一种内容表达而不改变其总体意义或呈现方式的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"هي مختصرة كتعبيرة","ca":"abreujat com a expressió","cs":"zkráceno jako vyjádření","da":"forkortet som udtryk","de":"Gekürzt als (Expression)","de":"Gekürzt als (Expression)","el":"συντμημένη ως (έκφραση)","en":"abridged as expression","es":"abreviado como expresión","et":"lühendatud väljendusena","fi":"lyhennelmä (ekspressio)","fr":"abrégé comme une expression","hu":"rövidítés kifejezési formaként:","lv":"saīsināta izteiksme","nl":"ingekort als expressie","no":"forkortet som uttrykk","tr":"anlatım olarak kısaltılmış","vi":"được rút gọn như là (biểu hiện)","zh-Hans-CN":"被缩编为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يختصر تعبيرة لعمل ذي صلة دون تغيير المعنى العام أو طريقة العرض.","ca":"Expressió d’una obra que escurça una expressió d’una obra relacionada sense canviar-ne el significat general o la forma de presentació.","cs":"Vyjádření díla, které zkracuje vyjádření souvisejícího díla, aniž by se změnil celkový význam nebo způsob prezentace.","da":"Udtryk af et værk, som forkorter et udtryk af et relateret værk uden at ændre den overordnede betydning eller præsentationsmåde.","de":"Eine Expression eines Werks, das eine Expression eines in Beziehung stehenden Werks kürzt, ohne die allgemeine Bedeutung oder Darstellungsweise zu ändern.","de":"Eine Expression eines Werks, das eine Expression eines in Beziehung stehenden Werks kürzt, ohne die allgemeine Bedeutung oder Darstellungsweise zu ändern.","el":"Μια έκφραση ενός έργου το οποίο περιορίζει [την έκταση] μιας έκφρασης-πηγής χωρίς να μεταβάλλει το γενικό νόημα ή τον τρόπο της παρουσίασης.","en":"An expression of a work that shortens an expression of a related work without changing the general meaning or manner of presentation.","es":"Una expresión de una obra que acorta una expresión de una obra relacionada sin cambiar el significado general o la forma de presentación.","et":"Teose väljendus, milles on lühendatud seotud teose väljendust, muutmata selle üldist tähendust ja esitusviisi.","fi":"Teoksen ekspressio, joka lyhentää siihen liittyvän teoksen ekspressiota muuttamatta sen merkityssisältöä tai esitystyyliä.","fr":"Expression d’une œuvre qui raccourcit une expression d’une œuvre en relation sans en changer le sens général ou le mode de présentation.","hu":"Egy mű kifejezési formája, amely egy kapcsolódó mű kifejezési formáját lerövidíti anélkül, hogy általános jelentését vagy prezentációját megváltoztatná.","lv":"Saistītā darba jauna izteiksme, kas saīsina iepriekšējo izteiksmi, nemainot nozīmi vai pasniegšanas veidu.","nl":"Een expressie van een werk dat een expressie van een gerelateerd werk inkort zonder de algehele betekenis of manier van presentatie te veranderen.","no":"Et uttrykk av et verk som forkorter et uttrykk av et relatert verk uten å endre den generelle meningen eller presentasjonsmåten.","tr":"Genel anlamını veya sunum şeklini değiştirmeden ilgili bir eserin anlatımını kısaltan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm rút ngắn biểu hiện tài nguyên mà không thay đổi ý nghĩa tổng quát hoặc phương các trình bày.","zh-Hans-CN":"缩短一种相关作品的一种内容表达而不改变其总体意义或呈现方式的一种作品的一种内容表达"},"label":{"ar":"هي مختصرة كتعبيرة","ca":"és abreujat com a expressió","cs":"je zkráceno jako vyjádření","da":"er forkortet som udtryk","de":"ist gekürzt als (Expression)","de":"ist gekürzt als (Expression)","el":"είναι συντμημένη ως (έκφραση)","en":"is abridged as expression","es":"se abrevia como expresión","et":"lühendatud väljendusena","fi":"lyhennelmä (ekspressio)","fr":"est abrégé comme une expression","hu":"rövidítve a következő kifejezési formában:","lv":"ir saīsināta izteiksme","nl":"is ingekort als expressie","no":"er forkortet som uttrykk","tr":"anlatım olarak özetlenmiştir","vi":"được rút gọn như là (biểu hiện)","zh-Hans-CN":"被缩编为内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/abridgedAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20166", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/abridgedAsExpression.en", "label":"is abridged as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20166", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/abridgedAsExpression.en", "label":"is abridged as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20119","label":{"ar":"هي مترجمة بتصرف كتعبيرة","ca":"és traduït lliurement com a expressió","cs":"je volně přeloženo jako vyjádření","da":"er frit oversat som udtryk","de":"ist frei übersetzt als (Expression)","de":"ist frei übersetzt als (Expression)","el":"είναι ελεύθερη μετάφραση ως (έκφραση)","en":"is freely translated as expression","es":"se traduce libremente como expresión","et":"vabalt tõlgitud väljendusena","fi":"vapaamuotoinen käännös (ekspressio)","fr":"est librement traduit comme une expression","hu":"szabadon fordítva a következő kifejezési formaként:","lv":"ir brīvs tulkojums (izteiksme)","nl":"is vrij vertaald als expressie","no":"er fritt oversatt som uttrykk","tr":"anlatım olarak serbestçe çevrilmiştir","vi":"được dịch tự do như là (biểu hiện)","zh-Hans-CN":"被自由翻译为内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يعد اقتباسًا وترجمة إلى لغة أخرى لتعبيرة مصدرية."],"ca":["Relaciona una expressió amb una expressió d’una obra que és alhora una adaptació i una traducció a una altra llengua d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které je současně adaptací vyjádření jiného díla a jeho překladem do jiného jazyka."],"da":["Relaterer et udtryk til et udtryk af et værk, som både er en bearbejdelse og en oversættelse til et andet sprog af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die sowohl eine Bearbeitung als auch eine Übersetzung einer Expression eines anderen Werks in eine andere Sprache ist.,Eine Expression eines Werks, die sowohl eine Bearbeitung als auch eine Übersetzung einer Expression eines anderen Werks in eine andere Sprache ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο είναι ταυτόχρονα προσαρμογή και μετάφραση μιας έκφρασης-πηγής σε μια άλλη γλώσσα ."],"en":["Relates an expression to an expression of a work that is both an adaptation and a translation into another language of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que es a la vez una adaptación y una traducción a otro idioma de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mis on nii allikväljenduse adapteering kui ka tõlge teise keelde."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sekä toisen teoksen ekspression mukaelma että käännös toiselle kielelle."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste à la fois en une adaptation et en une traduction dans une autre langue d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy forrás kifejezési formájának adaptációja és egy másik nyelvre való fordítása egyszerre."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir gan avota izteiksmes adaptācija, gan tulkojums citā valodā."],"nl":["Relateert een expressie aan een expressie van een werk dat tegelijk een bewerking en een vertaling in een andere taal is van een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er både en bearbeidelse av og en oversettelse til et annet språk av et kildeuttrykk."],"tr":["Bir anlatımı, bir kaynak anlatımının hem uyarlaması hem de başka bir dile çevirisi olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm vừa phỏng theo vừa dịch sang ngôn ngữ khác của biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与作为另一种作品的一种内容表达的另一种语言改编和翻译同时进行而成的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مترجمة بتصرف كتعبيرة","ca":"traduït lliurement com a expressió","cs":"volně přeloženo jako vyjádření","da":"frit oversat som udtryk","de":"Frei übersetzt als (Expression)","de":"Frei übersetzt als (Expression)","el":"ελεύθερη μετάφραση ως (έκφραση)","en":"freely translated as expression","es":"traducido libremente como expresión","et":"vabalt tõlgitud väljendusena","fi":"vapaamuotoinen käännös (ekspressio)","fr":"librement traduit comme une expression","hu":"szabadon fordítva kifejezési formaként:","lv":"brīvs tulkojums (izteiksme)","nl":"vrij vertaald als expressie","no":"fritt oversatt som uttrykk","tr":"anlatım olarak serbestçe çevrilmiş","vi":"được dịch tự do như là (biểu hiện)","zh-Hans-CN":"被自由翻译为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يعد اقتباسًا وترجمة إلى لغة أخرى لتعبيرة مصدرية.","ca":"Expressió d’una obra que és alhora una adaptació i una traducció a una altra llengua d’una expressió d’una altra obra.","cs":"Vyjádření díla, které je současně adaptací vyjádření jiného díla a jeho překladem do jiného jazyka.","da":"Udtryk af et værk, som både er en bearbejdelse og en oversættelse til et andet sprog af et udtryk af et andet værk.","de":"Eine Expression eines Werks, die sowohl eine Bearbeitung als auch eine Übersetzung einer Expression eines anderen Werks in eine andere Sprache ist.","de":"Eine Expression eines Werks, die sowohl eine Bearbeitung als auch eine Übersetzung einer Expression eines anderen Werks in eine andere Sprache ist.","el":"Μια έκφραση ενός έργου το οποίο είναι ταυτόχρονα προσαρμογή και μετάφραση μιας έκφρασης-πηγής σε μια άλλη γλώσσα.","en":"An expression of a work that is both an adaptation and a translation into another language of an expression of another work.","es":"Una expresión de una obra que es a la vez una adaptación y una traducción a otro idioma de una expresión de otra obra.","et":"Teose väljendus, mis on nii allikväljenduse adapteering kui ka tõlge teise keelde.","fi":"Teoksen ekspressio, joka on sekä toisen teoksen ekspression mukaelma että käännös toiselle kielelle.","fr":"Expression d’une œuvre qui consiste à la fois en une adaptation et en une traduction dans une autre langue d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amely egy forrás kifejezési formájának adaptációja és egy másik nyelvre való fordítása egyszerre.","lv":"Darba izteiksme, kas ir gan avota izteiksmes adaptācija, gan tulkojums citā valodā.","nl":"Een expressie van een werk dat tegelijk een bewerking en een vertaling in een andere taal is van een expressie van een ander werk.","no":"Et uttrykk av et verk som er både en bearbeidelse av og en oversettelse til et annet språk av et kildeuttrykk.","tr":"Bir eserin, başka bir eserin anlatımının hem uyarlaması hem de başka bir dile çevirisi olan anlatımı.","vi":"Biểu hiện của tác phẩm vừa phỏng theo vừa dịch sang ngôn ngữ khác của biểu hiện nguồn.","zh-Hans-CN":"作为另一种作品的一种内容表达的另一种语言改编和翻译同时进行而成的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/freelyTranslatedAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20119", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/freelyTranslatedAsExpression.en", "label":"is freely translated as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20119", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/freelyTranslatedAsExpression.en", "label":"is freely translated as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20086","label":{"ar":"هي معاد صنعها كتعبيرة","ca":"és nova versió com a expressió","cs":"je přepracováno jako vyjádření","da":"er genindspillet som udtryk","de":"ist Remake als (Expression)","de":"ist Remake als (Expression)","el":"είναι ανακατασκευασμένη ως (έκφραση)","en":"is remade as expression","es":"se rehace como expresión","et":"uusproduktsioon (väljendus)","fi":"uusintaproduktio (ekspressio)","fr":"est repris comme une expression","hu":"újrafeldolgozva a következő kifejezési formaként:","lv":"izteiksmes jauna versija","nl":"is opnieuw gemaakt als expressie","no":"er nyinnspilt som uttrykk","tr":"anlatım olarak yeniden yapılmıştır","vi":"được làm lại như là (biểu hiện)","zh-Hans-CN":"被重新制作为内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لفيلم سينمائي، أو برنامج إذاعي، أو برنامج تليفزيوني، أو فيديو مبني على عمل سابق."],"ca":["Relaciona una expressió amb una expressió d’una pel·lícula cinematogràfica nova, un programa radiofònic nou, un programa de televisió nou o un vídeo nou que es basa en una obra anterior."],"cs":["Vztahuje vyjádření k vyjádření nového pohyblivého obrazu, rozhlasového programu, televizního programu nebo videa, které je založeno na dřívějším díle."],"da":["Relaterer et udtryk til et udtryk af en spillefilm, radio- eller tv-program eller en video, baseret på et tidligere værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Films, einer Hörfunksendung, einer Fernsehsendung oder eines Videos, die auf einem früheren Werk basiert.,Setzt eine Expression in Beziehung zu einer Expression eines Films, einer Hörfunksendung, einer Fernsehsendung oder eines Videos, die auf einem früheren Werk basiert."],"el":["Συνδέει μια έκφραση με μια έκφραση μιας κινηματογραφικής ταινίας, ενός ραδιοφωνικού προγράμματος, τηλεοπτικού προγράμματος ή βίντεο, βασισμένων σε προηγούμενο έργο."],"en":["Relates an expression to an expression of a new motion picture, radio program, television program, or video that is based on an earlier work."],"es":["Relaciona una expresión con la expresión de una nueva película, programa de radio, programa de televisión o vídeo que se basa en una obra anterior."],"et":["Seostab väljenduse filmi, raadiosaate, telesaate või videofilmi väljendusega, mis põhineb varasemal teosel."],"fi":["Liittää ekspression elokuvan, radio-ohjelman, televisio-ohjelman tai videon ekspressioon, joka perustuu aiempaan teokseen."],"fr":["Met une expression en relation avec une expression d’un nouveau film, d’une nouvelle émission de radio, d’une nouvelle émission de télévision ou d’une nouvelle vidéo qui est basée sur une œuvre antérieure."],"hu":["Hozzákapcsol egy kifejezési formát egy korábbi művön alapuló mozgókép, rádióműsor, televízióműsor, vagy videó kifejezési formájához."],"lv":["Sasaista izteiksmi ar jaunu kinofilmas, radio, televīzijas raidījuma vai video izteiksmi, kas veidota pēc agrāka darba. rīmeiks."],"nl":["Relateert een expressie aan een expressie van een nieuwe speelfilm, radioprogramma, televisieprogramma of video die is gebaseerd op een eerder werk."],"no":["Relaterer et uttrykk til et uttrykk av en ny spillefilm, et nytt radioprogram, et nytt fjernsynsprogram eller en ny video basert på et tidligere verk."],"tr":["Bir anlatımı, daha önceki bir esere dayanan yeni bir sinema filmi, radyo programı, televizyon programı veya video anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của phim điện ảnh, chương trình truyền thanh, chương trình truyền hình, hoặc video mới dựa trên tác phẩm trước đây."],"zh-Hans-CN":["将一种内容表达与基于一种先前作品的一种新电影、广播节目、电视节目或视频的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معاد صنعها كتعبيرة","ca":"nova versió com a expressió","cs":"přepracováno jako vyjádření","da":"genindspillet som udtryk","de":"Remake als (Expression)","de":"Remake als (Expression)","el":"ανακατασκευασμένη ως (έκφραση)","en":"remade as expression","es":"rehecho como expresión","et":"uusproduktsioon (väljendus)","fi":"uusintaproduktio (ekspressio)","fr":"repris comme une expression","hu":"újrafeldolgozott kifejezési forma:","lv":"izteiksme: jauna versija","nl":"opnieuw gemaakt als expressie","no":"nyinnspilt som uttrykk","tr":"anlatım olarak yeniden yapılmış","vi":"được làm lại như là (biểu hiện)","zh-Hans-CN":"被重新制作为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لفيلم سينمائي، أو برنامج إذاعي، أو برنامج تليفزيوني، أو فيديو مبني على عمل سابق.","ca":"Expressió d’una pel·lícula cinematogràfica nova, un programa radiofònic nou, un programa de televisió nou o un vídeo nou que es basa en una obra anterior.","cs":"Vyjádření nového pohyblivého obrazu, rozhlasového programu, televizního programu nebo videa, které je založeno na dřívějším díle.","da":"Udtryk af en spillefilm, radio- eller tv-program eller video, baseret på et tidligere værk.","de":"Eine Expression eines Films, einer Hörfunksendung, einer Fernsehsendung oder eines Videos, die auf einem früheren Werk basiert.","de":"Eine Expression eines Films, einer Hörfunksendung, einer Fernsehsendung oder eines Videos, die auf einem früheren Werk basiert.","el":"Μια έκφραση μιας κινηματογραφικής ταινίας, ενός ραδιοφωνικού προγράμματος, τηλεοπτικού προγράμματος ή βίντεο βασισμένων σε προηγούμενο έργο.","en":"An expression of a new motion picture, radio program, television program, or video that is based on an earlier work.","es":"Una expresión de una nueva película, programa de radio, programa de televisión o vídeo basado en una obra anterior.","et":"Filmi, raadiosaate, telesaate või videofilmi väljendus, mis põhineb varasemal teosel.","fi":"Uuden elokuvan, radio-ohjelman, televisio-ohjelman tai videon ekspressio, joka perustuu aiempaan teokseen.","fr":"Expression d’un nouveau film, d’une nouvelle émission de radio, d’une nouvelle émission de télévision ou d’une nouvelle vidéo qui est basée sur une œuvre antérieure.","hu":"Egy korábbi művön alapuló új mozgókép, rádióműsor, televízióműsor, vagy videó kifejezési formája.","lv":"Jauna kinofilmas, radio, televīzijas raidījuma vai video izteiksme, kas veidota pēc agrāka darba. Rīmeiks.","nl":"Een expressie van een nieuwe speelfilm, radioprogramma, televisieprogramma of video die is gebaseerd op een eerder werk.","no":"Et uttrykk av en ny spillefilm, et nytt radioprogram, et nytt fjernsynsprogram eller en ny video basert på et tidligere verk.","tr":"Daha önceki bir çalışmaya dayanan yeni bir sinema filmi, radyo programı, televizyon programı veya video anlatımı.","vi":"Biểu hiện của phim điện ảnh, chương trình truyền thanh, chương trình truyền hình, hoặc video mới dựa trên tác phẩm trước đây.","zh-Hans-CN":"基于一种先前作品的一种新电影、广播节目、电视节目或视频的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/remadeAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20086", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/remadeAsExpression.en", "label":"is remade as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20086", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/remadeAsExpression.en", "label":"is remade as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20114","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل ينسخ نمط تعبيرة لعمل آخر أو محتواها."],"ca":["Relaciona una expressió amb una expressió d’una obra que copia l’estil o el contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které kopíruje styl nebo obsah vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som kopierer stil eller indhold fra et udryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Stil oder Inhalt einer Expression eines anderen Werks kopiert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Stil oder Inhalt einer Expression eines anderen Werks kopiert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο αντιγράφει το ύφος ή το περιεχόμενο ενός έργου-πηγής."],"en":["Relates an expression to an expression of a work that copies the style or content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que copia el estilo o contenido de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, milles jäljendatakse allikteose stiili või sisu."],"fi":["Liittää ekspression teoksen ekspressioon, joka jäljittelee toisen teoksen ekspression tyyliä tai sisältöä."],"fr":["Met une expression en relation avec une expression d’une œuvre qui copie le style ou le contenu d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy másik mű kifejezési formájának stílusát vagy tartalmát másolja."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas atdarina pamatdarba stilu vai saturu."],"nl":["Relateert een expressie aan een expressie van een werk dat de stijl of content van een expressie van een ander werk kopieert."],"no":["Relaterer et uttrykk til et uttrykk av et verk som kopierer stilen til eller innholdet i et kildeverk."],"tr":["Bir anlatımı, başka bir eserin anlatımının biçimini veya içeriğini kopyalayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sao chép phong cách hoặc nội dung của tác phẩm nguồn."],"zh-Hans-CN":["将一种内容表达与复制另一种作品的一种内容表达的风格和内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"محاكاة كتعبيرة","ca":"imitat com a expressió","cs":"imitováno jako vyjádření","da":"efterlignet som udtryk","de":"Imitiert als (Expression)","de":"Imitiert als (Expression)","el":"αντίγραφο ως (έκφραση)","en":"imitated as expression","es":"imitado como expresión","et":"jäljendatud väljendusena","fi":"jäljitelmä (ekspressio)","fr":"imité comme une expression","hu":"utánozva kifejezési formaként:","lv":"izteiksme: imitācija","nl":"geïmiteerd als expressie","no":"imitert som uttrykk","tr":"anlatım olarak taklit edilmiştir","vi":"được mô phỏng như là (biểu hiện)","zh-Hans-CN":"被模仿成为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل ينسخ نمط تعبيرة لعمل آخر أو محتواها.","ca":"Expressió d’una obra que copia l’estil o el contingut d’una expressió d’una altra obra.","cs":"Vyjádření díla, které kopíruje styl nebo obsah vyjádření jiného díla.","da":"Udtryk af et værk, som kopierer stil eller indhold fra et udryk af et andet værk.","de":"Eine Expression eines Werks, die den Stil oder Inhalt einer Expression eines anderen Werks kopiert.","de":"Eine Expression eines Werks, die den Stil oder Inhalt einer Expression eines anderen Werks kopiert.","el":"Μια έκφραση ενός έργου το οποίο αντιγράφει το ύφος ή το περιεχόμενο ενός έργου-πηγής.","en":"An expression of a work that copies the style or content of an expression of another work.","es":"Una expresión de una obra que copia el estilo o contenido de una expresión de otra obra.","et":"Teose väljendus, milles jäljendatakse allikteose stiili või sisu.","fi":"Teoksen ekspressio, joka jäljittelee toisen teoksen ekspression tyyliä tai sisältöä.","fr":"Expression d’une œuvre qui copie le style ou le contenu d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amely egy másik mű kifejezési formájának stílusát vagy tartalmát másolja.","lv":"Darba izteiksme, kas atdarina pamatdarba stilu vai saturu.","nl":"Een expressie van een werk dat de stijl of content van een expressie van een ander werk kopieert.","no":"Et uttrykk av et verk som kopierer stilen til eller innholdet i et kildeverk.","tr":"Başka bir eserin anlatımının tarzını veya içeriğini kopyalayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sao chép phong cách hoặc nội dung của tác phẩm nguồn.","zh-Hans-CN":"复制另一种作品的一种内容表达的风格和内容的一种作品的一种内容表达"},"label":{"ar":"هي محاكاة كتعبيرة","ca":"és imitat com a expressió","cs":"je imitováno jako vyjádření","da":"er efterlignet som udtryk","de":"ist imitiert als (Expression)","de":"ist imitiert als (Expression)","el":"είναι αντίγραφο ως (έκφραση)","en":"is imitated as expression","es":"se imita como expresión","et":"jäljendatud väljendusena","fi":"jäljitelmä (ekspressio)","fr":"est imité comme une expression","hu":"utánozlva a következő kifejezési formában:","lv":"izteiksmes imitācija","nl":"is geïmiteerd als expressie","no":"er imitert som uttrykk","tr":"anlatım olarak taklit edilmiştir","vi":"được mô phỏng như là (biểu hiện)","zh-Hans-CN":"被模仿成为内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/imitatedAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20142", "lexicalAlias":"http://rdaregistry.info/Elements/e/parodiedAsExpression.en", "label":"is parodied as expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20114", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/imitatedAsExpression.en", "label":"is imitated as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20114", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/imitatedAsExpression.en", "label":"is imitated as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20077","definition":{"ar":["تربط تعبيرة بتعبيرة لتكوين أدبي في شكل شعر مقتبس من تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una composició literària en vers que s’adapta d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření literární kompozice ve formě veršů, které je adaptované z vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af en litterær komposition i versform, bearbejdet ud fra et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression einer literarischen Dichtung in Versform, die nach einer Expression eines anderen Werks bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression einer literarischen Dichtung in Versform, die nach einer Expression eines anderen Werks bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση μιας λογοτεχνικής σύνθεσης σε έμμετρη μορφή προσαρμοσμένη από μια έκφραση-πηγή."],"en":["Relates an expression to an expression of a literary composition in verse form that is adapted from an expression of another work."],"es":["Relaciona una expresión con una expresión de una composición literaria en verso que está adaptada desde una expresión de otra obra."],"et":["Seostab väljenduse värsivormis kirjandusliku kompositsiooni väljendusega, mis on adapteeritud allikväljendusest."],"fi":["Liittää ekspression runomuodossa olevaan ekspressioon, joka on sovitettu toisen teoksen ekspressiosta."],"fr":["Met une expression en relation avec une expression d’une composition littéraire en vers qui est adaptée d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy verses formájú irodalmi összeállítás kifejezési formájához, amelyet egy másik mű kifejezési formájából dolgoztak át."],"lv":["Sasaista izteiksmi ar literārā darba izteiksmi vārsmās, kas veidota pēc darba pamatizteiksmes."],"nl":["Relateert een expressie aan een expressie van een literaire compositie in versvorm die is bewerkt naar een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av en litterær komposisjon i verseform bearbeidet fra et kildeuttrykk."],"tr":["Bir anlatımı, başka bir eserin anlatımından uyarlanmış bir edebi kompozisyonun nazım biçimindeki anlatımı ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm văn chương dưới hình thái thơ được phỏng theo biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与被改编自另一种作品的一种内容表达的一种文学韵文写作的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة شعريا كتعبيرة","ca":"adaptat en vers com a expressió","cs":"adaptováno ve verších jako vyjádření","da":"bearbejdet i versform som udtryk","de":"Bearbeitet als Gedicht (Expression)","de":"Bearbeitet als Gedicht (Expression)","el":"προσαρμοσμένη σε έμμετρο λόγο ως (έκφραση)","en":"adapted in verse as expression","es":"adaptado en verso como expresión","et":"adapteeritud värsivormis (väljendus)","fi":"runomukaelma (ekspressio)","fr":"adapté en vers comme une expression","hu":"verses feldolgozása a következő kifejezési formaként:","lv":"adaptēts kā izteiksme dzejā","nl":"bewerkt in versform als expressie","no":"bearbeidet til verseform som uttrykk","tr":"Manzum anlatım olarak uyarlanan","vi":"được phỏng theo thành thơ như là (biểu hiện)","zh-Hans-CN":"被改编成韵文作为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لتكوين أدبي في شكل شعر مقتبس من تعبيرة لعمل آخر.","ca":"Expressió d’una composició literària en vers que s’adapta d’una expressió d’una altra obra.","cs":"Vyjádření literární kompozice ve formě veršů, které je adaptované z vyjádření jiného díla.","da":"Udtryk af en litterær komposition i versform, bearbejdet ud fra et udtryk af et andet værk.","de":"Eine Expression einer literarischen Dichtung in Versform, die nach einer Expression eines anderen Werks bearbeitet ist.","de":"Eine Expression einer literarischen Dichtung in Versform, die nach einer Expression eines anderen Werks bearbeitet ist.","el":"Μια έκφραση μιας λογοτεχνικής σύνθεσης σε έμμετρη μορφή προσαρμοσμένη από μια έκφραση-πηγή.","en":"An expression of a literary composition in verse form that is adapted from an expression of another work.","es":"Una expresión de una composición literaria en forma de verso que es una adaptación de una expresión de otra obra.","et":"Värsivormis kirjandusliku kompositsiooni väljendus, mis on adapteeritud allikväljendusest.","fi":"Runomuodossa oleva ekspressio, joka on sovitettu toisen teoksen ekspressiosta.","fr":"Expression d’une composition littéraire en vers qui est adaptée d’une expression d’une autre œuvre.","hu":"Egy verses formájú irodalmi összeállítás kifejezési formája, amelyet egy másik mű kifejezési formájából dolgoztak át.","lv":"Literārā darba izteiksme vārsmās, veidota pēc darba pamatizteiksmes.","nl":"Een expressie van een literaire compositie in versvorm die is bewerkt naar een expressie van een ander werk.","no":"Et uttrykk av en litterær komposisjon i verseform bearbeidet fra et kildeuttrykk.","tr":"Bir edebi kompozisyonun başka bir eserin anlatımından uyarlanan nazım biçimindeki bir anlatımı.","vi":"Biểu hiện của tác phẩm văn chương dưới hình thái thơ được phỏng theo biểu hiện nguồn.","zh-Hans-CN":"被改编自另一种作品的一种内容表达的一种文学韵文写作的一种内容表达"},"label":{"ar":"هي معالجة شعريا كتعبيرة","ca":"és adaptat en vers com a expressió","cs":"je adaptováno ve verších jako vyjádření","da":"er bearbejdet i versform som udtryk","de":"ist bearbeitet als Gedicht (Expression)","de":"ist bearbeitet als Gedicht (Expression)","el":"είναι προσαρμοσμένη σε έμμετρο λόγο ως (έκφραση)","en":"is adapted in verse as expression","es":"está adaptado en verso como expresión","et":"adapteeritud värsivormis (väljendus)","fi":"runomukaelma (ekspressio)","fr":"est adapté en vers comme une expression","hu":"verses feldolgozása a következő kifejezési formaként:","lv":"ir adaptēts kā izteiksme dzejā","nl":"is bewerkt in versform als expressie","no":"er bearbeidet til verseform som uttrykk","tr":"manzum anlatım olarak uyarlanmıştır","vi":"được phỏng theo thành thơ như là (biểu hiện)","zh-Hans-CN":"被改编成韵文作为内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
