                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/dancerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20430", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerCollectiveAgent.en", "label":"has dancer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20371", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerPerson.en", "label":"has dancer person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20014", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dancerAgent.en", "label":"has dancer agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20014", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dancerAgent.en", "label":"has dancer agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20430","label":{"ar":"لها وكيل جماعي راقص","ca":"té com a agent col·lectiu ballarí","cs":"má tanečníka (kolektivního agenta)","da":"har kollektiv agent, som er danser","de":"hat Tänzerin/Tänzer (Gemeinschaftlicher Akteur)","de":"hat Tänzerin/Tänzer (Gemeinschaftlicher Akteur)","en":"has dancer collective agent","es":"tiene agente colectivo bailarín","et":"tantsija (kollektiiv)","fi":"tanssija (yhteistoimija)","fr":"a pour agent collectif danseur","hu":"táncos kollektív ágense a következő:","lv":"dejotājs (grupa)","nl":"heeft danser-collectieve actor","no":"har danser (kollektiv agent)","tr":"dansçı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有舞蹈者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال الرقص في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb un agent col·lectiu que és un intèrpret que contribueix a una expressió dansant en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je účinkujícím, který přispívá k vyjádření tím, že tančí v hudebním nebo dramatickém představení."],"da":["Relaterer et udtryk til en kollektiv agent, som er en udøver, som bidrager til et udtryk ved at danse i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer musikalischen, dramatischen oder ähnlichen Darbietung tanzt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer musikalischen, dramatischen oder ähnlichen Darbietung tanzt."],"en":["Relates an expression to a collective agent who is a performer who contributes to an expression by dancing in a musical or dramatic presentation."],"es":["Relaciona una expresión con un agente colectivo que es un intérprete que contribuye a una expresión al bailar en una presentación musical o dramática."],"et":["Seostab väljenduse kollektiiviga, kes esitajana annab panuse väljendusse, tantsides muusika- või draamaetenduses vms."],"fi":["Liittää ekspression yhteistoimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen tanssimalla musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec un agent collectif interprète qui contribue à une expression en dansant dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó kollektív ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy egy zenei vagy drámai bemutatóban táncol."],"lv":["Sasaista izteiksmi ar grupu, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, dejojot muzikālā, dramatiskā, u. tml. uzvedumā."],"nl":["Relateert een expressie aan een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het dansen in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en kollektiv agent som er en utøver som bidrar til et uttrykk ved å danse i en musikalsk eller dramatisk forestilling, etc."],"tr":["Bir anlatımı, müzikal veya dramatik bir sunumda dans ederek anlatıma katkıda bulunan sanatçı olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过在音乐或戏剧呈现中舞蹈对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي راقص","ca":"agent col·lectiu ballarí","cs":"tanečník (kolektivní agent)","da":"kollektiv agent, som er danser","de":"Tänzerin/Tänzer (Gemeinschaftlicher Akteur)","de":"Tänzerin/Tänzer (Gemeinschaftlicher Akteur)","en":"dancer collective agent","es":"agente colectivo bailarín","et":"tantsija (kollektiiv)","fi":"tanssija (yhteistoimija)","fr":"agent collectif danseur","hu":"táncos kollektív ágens:","lv":"dejotājs (grupa)","nl":"danser-collectieve actor","no":"danser (kollektiv agent)","tr":"dansçı kolektif temsilci","zh-Hans-CN":"舞蹈者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال الرقص في عرض موسيقي أو درامي.","ca":"Agent col·lectiu que és un intèrpret que contribueix a una expressió dansant en una representació musical o dramàtica.","cs":"Kolektivní agent, který je účinkujícím, který přispívá k vyjádření tím, že tančí v hudebním nebo dramatickém představení.","da":"Kollektiv agent, som er en udøver, som bidrager til et udtryk ved at danse i en musikalsk eller dramatisk præsentation etc.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer musikalischen, dramatischen oder ähnlichen Darbietung tanzt.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er in einer musikalischen, dramatischen oder ähnlichen Darbietung tanzt.","en":"A collective agent who is a performer who contributes to an expression by dancing in a musical or dramatic presentation.","es":"Un agente colectivo que es un intérprete que contribuye a una expresión al bailar en una presentación musical o dramática.","et":"Kollektiiv, kes esitajana annab panuse väljendusse, tantsides muusika- või draamaetenduses vms.","fi":"Yhteistoimija, joka on esittäjä, joka osallistuu ekspression tekemiseen tanssimalla musiikki- tai näytelmäesityksessä.","fr":"Agent collectif interprète qui contribue à une expression en dansant dans une présentation musicale ou dramatique.","hu":"Egy előadó kollektív ágens, amely hozzájárul egy kifejezési formához azzal, hogy egy zenei vagy drámai bemutatóban táncol.","lv":"Grupa - izpildītājs, kas sniegusi ieguldījumu izteiksmē, dejojot muzikālā, dramatiskā, u. tml. uzvedumā.","nl":"Een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het dansen in een muziek- of dramapresentatie.","no":"En kollektiv agent som er en utøver som bidrar til et uttrykk ved å danse i en musikalsk eller dramatisk forestilling, etc.","tr":"Müzikal veya dramatik bir sunumda dans ederek ifadeye katkıda bulunan bir sanatçı olan kolektif temsilci.","zh-Hans-CN":"作为一个表演者通过在音乐或戏剧呈现中舞蹈对一种内容表达有贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
