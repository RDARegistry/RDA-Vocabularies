                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20369", "lexicalAlias":"http://rdaregistry.info/Elements/e/actorPerson.en", "label":"has actor person"},{"@id":"http://rdaregistry.info/Elements/e/P20377", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorPerson.en", "label":"has commentator person"},{"@id":"http://rdaregistry.info/Elements/e/P20383", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorPerson.en", "label":"has conductor person"},{"@id":"http://rdaregistry.info/Elements/e/P20371", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerPerson.en", "label":"has dancer person"},{"@id":"http://rdaregistry.info/Elements/e/P20372", "lexicalAlias":"http://rdaregistry.info/Elements/e/hostPerson.en", "label":"has host person"},{"@id":"http://rdaregistry.info/Elements/e/P20381", "lexicalAlias":"http://rdaregistry.info/Elements/e/instructorPerson.en", "label":"has instructor person"},{"@id":"http://rdaregistry.info/Elements/e/P20376", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistPerson.en", "label":"has instrumentalist person"},{"@id":"http://rdaregistry.info/Elements/e/P20373", "lexicalAlias":"http://rdaregistry.info/Elements/e/moderatorPerson.en", "label":"has moderator person"},{"@id":"http://rdaregistry.info/Elements/e/P20378", "lexicalAlias":"http://rd