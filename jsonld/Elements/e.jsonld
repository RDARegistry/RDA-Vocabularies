                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20204", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfSourceWork.en", "label":"has expression of source work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/musicalSettingOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20159", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicalSettingOfExpression.en", "label":"is musical setting of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20159", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicalSettingOfExpression.en", "label":"is musical setting of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20239","label":{"ar":"هي معالجة مسرحية موسيقية لتعبيرة","ca":"és adaptació per a teatre musical d’una expressió","cs":"je muzikálovou adaptací vyjádření","da":"er bearbejdelse af udtryk til musikteater","de":"ist Musiktheaterbearbeitung von (Expression)","de":"ist Musiktheaterbearbeitung von (Expression)","el":"είναι μουσικοθεατρική προσαρμογή της (έκφραση)","en":"is musical theatre adaptation of expression","es":"es una adaptación de expresión del teatro musical","et":"muusikaliversioon väljendusest","fi":"musikaalisovitus ekspressiosta","fr":"est une adaptation au théâtre musical d’une expression","hu":"zeneszínházi feldolgozása a következő kifejezési formának:","lv":"kā muzikāls iestudējums adaptētā izteiksme","nl":"is muziektheaterbewerking van expressie","no":"er bearbeidelse av uttrykk til musikal","tr":"anlatımın müzikal tiyatro uyarlamasıdır","vi":"có phỏng theo kịch bản âm nhạc của (biểu hiện)","zh-Hans-CN":"是内容表达的音乐戏剧改编"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل معالج كعمل مسرحي موسيقي."],"ca":["Relaciona una expressió amb una expressió d’una obra que s’adapta com una obra teatral musical."],"cs":["Vztahuje vyjádření k vyjádření díla, které je adaptováno jako muzikál (dílo)."],"da":["Relaterer et udtryk til et udtryk af et værk, som er bearbejdet til et musikteaterværk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Musiktheaterwerk bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Musiktheaterwerk bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως ένα μουσικο-θεατρικό έργο."],"en":["Relates an expression to an expression of a work that is adapted as a musical theatre work."],"es":["Relaciona una expresión con una expresión de una obra que está adaptada como obra de teatro musical."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud muusikalina."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sovitettu musikaaliteokseksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est adaptée en œuvre de théâtre musical."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet zeneszínházi műként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir adaptēta kā muzikāls iestudējums."],"nl":["Relateert een expressie aan een expressie van een werk dat is bewerkt als een muziektheaterwerk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til et musikalverk."],"tr":["Bir anlatımı, müzikal tiyatro eserine uyarlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được phỏng theo như là tác phẩm nhà hát âm nhạc."],"zh-Hans-CN":["将一种内容表达与被改编为一种音乐戏剧作品的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة مسرحية موسيقية لتعبيرة","ca":"adaptació per a teatre musical d’una expressió","cs":"muzikálová adaptace vyjádření","da":"bearbejdelse af udtryk til musikteater","de":"Musiktheaterbearbeitung von (Expression)","de":"Musiktheaterbearbeitung von (Expression)","el":"μουσικοθεατρική προσαρμογή της (έκφραση)","en":"musical theatre adaptation of expression","es":"adaptación al teatro musical de la expresión","et":"muusikaliversioon väljendusest","fi":"musikaalisovitus ekspressiosta","fr":"adaptation au théâtre musical d’une expression","hu":"kifejezési forma zenés színházi darabbá való átalakítása:","lv":"kā muzikāls iestudējums adaptētā izteiksme","nl":"muziektheaterbewerking van expressie","no":"bearbeidelse av uttrykk til musikal","tr":"ifadenin müzikal tiyatro uyarlaması","vi":"phỏng theo kịch bản âm nhạc của (biểu hiện)","zh-Hans-CN":"内容表达的音乐戏剧改编"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معالج كعمل مسرحي موسيقي.","ca":"Expressió d’una obra que s’adapta com una obra teatral musical.","cs":"Vyjádření díla, které je adaptováno jako muzikál (dílo).","da":"Udtryk af et værk, som er bearbejdet til et musikteaterværk.","de":"Eine Expression eines Werks, die als Musiktheaterwerk bearbeitet ist.","de":"Eine Expression eines Werks, die als Musiktheaterwerk bearbeitet ist.","el":"Μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως ένα μουσικο-θεατρικό έργο.","en":"An expression of a work that is adapted as a musical theatre work.","es":"Una expresión de una obra que está adaptada como obra de teatro musical.","et":"Teose väljendus, mis on adapteeritud muusikalina.","fi":"Teoksen ekspressio, joka on sovitettu musikaaliteokseksi.","fr":"Expression d’une œuvre qui est adaptée en œuvre de théâtre musical.","hu":"Egy mű kifejezési formája, amelyet zeneszínházi műként adaptáltak.","lv":"Darba izteiksme, kas ir adaptēta kā muzikāls iestudējums.","nl":"Een expressie van een werk dat is bewerkt als een muziektheaterwerk.","no":"Et uttrykk av et verk som er bearbeidet til et musikalverk.","tr":"Müzikal tiyatro çalışması olarak uyarlanmış bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được phỏng theo như là tác phẩm nhà hát âm nhạc.","zh-Hans-CN":"被改编为一种音乐戏剧作品