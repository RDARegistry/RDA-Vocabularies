                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/specialEffectsProviderPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20258", "lexicalAlias":"http://rdaregistry.info/Elements/e/specialEffectsProviderAgent.en", "label":"has special effects provider agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20360", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/specialEffectsProviderPerson.en", "label":"has special effects provider person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20360", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/specialEffectsProviderPerson.en", "label":"has special effects provider person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20167","label":{"ar":"هي منشطرة من تعبيرة","ca":"és escindit d’una expressió","cs":"je rozděleno z vyjádření","da":"er delt fra udtryk","de":"ist teilweise Fortsetzung von (Expression)","de":"ist teilweise Fortsetzung von (Expression)","el":"είναι συνέχεια σε μέρη της (έκφραση)","en":"is split from expression","es":"se divide de la expresión","et":"osaline jätk väljendusele","fi":"jakautunut ekspressiosta","fr":"est scindé à partir d’une expression","hu":"részleges folytatása a következő kifejezési formából:","lv":"ir daļējs turpinājums izteiksmei","nl":"is gesplitst uit expressie","no":"er skilt fra uttrykk","tr":"anlatımdan ayrılır","vi":"là tiếp tục một phần của (biểu hiện)","zh-Hans-CN":"被从内容表达分出"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل عبارة عن عمل ممتد زمنيًا، ومكتمل، ومحتواه الجزئي مستمر من خلال تعبيرة لعمل آخر ممتد زمنيًا."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una obra diacrònica que és completa el contingut parcial de la qual és continuat per una expressió d’una altra obra diacrònica."],"cs":["Vztahuje vyjádření k vyjádření díla, které je diachronním dílem, které bylo ukončeno a na jehož částečný obsah navazuje vyjádření jiného diachronního díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som er et fuldstændigt diakronisk værk, hvis delvise indhold er fortsat af et udtryk af et andet diakronisk værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines abgeschlossenen, diachronen Werks, deren Inhalt teilweise durch eine Expression eines anderen diachronen Werks fortgesetzt wird.,Setzt eine Expression in Beziehung zu einer Expression eines abgeschlossenen, diachronen Werks, deren Inhalt teilweise durch eine Expression eines anderen diachronen Werks fortgesetzt wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο χωρίζεται σε δύο ή περισσότερες διακριτές εκφράσεις με νέους τίτλους."],"en":["Relates an expression to an expression of a work that is a diachronic work that is completed whose partial content is continued by an expression of another diachronic work."],"es":["Relaciona una expresión con una expresión de una obra que es una obra diacrónica completa cuyo contenido parcial es continuado por una expresión de otra obra diacrónica."],"et":["Seostab väljenduse väljendusega diakroonilisest teosest, mis on lõpetatud ja mille sisu osaliselt jätkab teise diakroonilise teose väljendus."],"fi":["Liittää ekspression sellaisen teoksen ekspressioon, joka on valmis diakroninen teos, jonka osittaista sisältöä jatkaa toisen diakronisen teoksen ekspressio."],"fr":["Met une expression en relation avec une expression d’une œuvre diachronique qui est terminée et dont le contenu partiel est continué par une expression d’une autre œuvre diachronique."],"hu":["Hozzákapcsol egy kifejezési formát egy befejezett diakronikus mű kifejezési formájához, amelynek részleges tartalmát egy másik diakronikus mű kifejezési formája folytatja."],"lv":["Sasaista izteiksmi ar pabeigta diahroniska darba izteiksmi, kuras saturu daļēji turpina cita diahroniska darba izteiksme.elements vispārīgi attiecas uz secīga darba izteiksmi."],"nl":["Relateert een expressie aan een expressie van een werk dat een diachronisch werk is dat afgesloten is waarvan gedeeltelijke content voortgezet wordt door een expressie van een ander diachronisch werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er et avsluttet diakronisk verk hvor deler av innholdet fortsettes i et uttrykk av et annet diakronisk verk."],"tr":["Bir anlatımı, kısmi içeriği başka bir artzamanlı eserin anlatımıyla devam ettirilen tamamlanmış bir artzamanlı eser olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm phân chia thành hai hoặc nhiều hơn biểu hiện riêng rẽ với các nhan đề mới."],"zh-Hans-CN":["将一种内容表达与作为一种已完成的历时作品、其部分内容被另一种历时作品的一种内容表达继承的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"منشطرة من تعبيرة","ca":"escindit d’una expressió","cs":"rozděleno z vyjádření","da":"delt fra udtryk","de":"Teilweise Fortsetzung von (Expression)","de":"Teilweise Fortsetzung von (Expression)","el":"συνέχεια σε μέρη της (έκφραση)","en":"split from expression","es":"dividido de la expresión","et":"osaline jätk väljendusele","fi":"jakautunut ekspressiosta","fr":"scindé à partir d’une expression","hu":"részleges folytatása kifejezési formából:","lv":"daļējs turpinājums izteiksmei","nl":"gesplitst uit expressie","no":"skilt fra uttrykk","tr":"anlatımdan ayrılma","vi":"tiếp tục một phần của (biểu hiện)","zh-Hans-CN":"被从内容表达分出"},"ToolkitDefinition":{"ar":"تعبيرة لعمل عبارة عن عمل ممتد زمنيًا، ومكتمل، ومحتواه الجزئي مستمر من خلال تعبيرة لعمل آخر ممتد زمنيًا.","ca":"Expressió d’una obra que és una obra diacrònica que és completa el contingut parcial de la qual és continuat per una expressió d’una altra obra diacrònica.","cs":"Vyjádření díla, které je diachronním dílem, které bylo ukončeno a na jehož částečný obsah navazuje vyjádření jiného diachronního díla.","da":"Udtryk af et værk, som er et fuldstændigt diakronisk værk, hvis delvise indhold er fortsat af et udtryk af et andet diakronisk værk.","de":"Eine Expression eines abgeschlossenen, diachronen Werks, deren Inhalt teilweise durch eine Expression eines anderen diachronen Werks fortgesetzt wird.","de":"Eine Expression eines abgeschlossenen, diachronen Werks, deren Inhalt teilweise durch eine Expression eines anderen diachronen Werks fortgesetzt wird.","el":"Μια έκφραση ενός έργου το οποίο χωρίζεται σε δύο ή περισσότερες διακριτές εκφράσεις με νέους τίτλους.","en":"An expression of a work that is a diachronic work that is completed whose partial content is continued by an expression of another diachronic work.","es":"Una expresión de una obra que es una obra diacrónica completa cuyo contenido parcial es continuado por una expresión de otra obra diacrónica.","et":"Väljendus diakroonilisest teosest, mis on lõpetatud ja mille sisu osaliselt jätkab teise diakroonilise teose väljendus.","fi":"Sellaisen teoksen ekspressio, joka on valmis diakroninen teos, jonka osittaista sisältöä jatkaa toisen diakronisen teoksen ekspressio.","fr":"Expression d’une œuvre diachronique qui est terminée et dont le contenu partiel est continué par une expression d’une autre œuvre diachronique.","hu":"Egy befejezett diakronikus mű kifejezési formája, amelynek részleges tartalmát egy másik diakronikus mű kifejezési formája folytatja.","lv":"Pabeigta diahroniska darba izteiksme, kuras saturu daļēji turpina cita diahroniska darba izteiksme.","nl":"Een expressie van een werk dat een diachronisch werk is dat afgesloten is waarvan gedeeltelijke content voortgezet wordt door een expressie van een ander diachronisch werk.","no":"Et uttrykk av et verk som er et avsluttet diakronisk verk hvor deler av innholdet fortsettes i et uttrykk av et annet diakronisk verk.","tr":"Kısmi içeriği başka bir eşzamanlı eserin bir anlatımı tarafından devam ettirilen tamamlanmış bir eşzamanlı eserin anlatımı.","vi":"Biểu hiện của tác phẩm phân chia thành hai hoặc nhiều hơn biểu hiện riêng rẽ với các nhan đề mới.","zh-Hans-CN":"作为一种已完成的历时作品、其部分内容被另一种历时作品的一种内容表达继承的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل متتالٍ."],"ca":["En general, aquest element s’aplica a una expressió d’una obra successiva."],"cs":["Tento termín se obecně vztahuje na vyjádření postupně vydávaného díla."],"da":["Dette element gælder generelt for et udtryk af et fortløbende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu."],"el":["Αυτή η σχέση βρίσκει εφαρμογή γενικά στα περιοδικά."],"en":["This element applies in general to an expression of a successive work."],"es":["Este elemento se aplica en general a una expresión de una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre successive."],"hu":["Ezt az elemet általában egy folyamatos mű kifejezési formájára alkalmazzák."],"lv":["Elements vispārīgi attiecas uz secīga darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een successief werk."],"no":["Dette elementet gjelder som oftest for et uttrykk av et fortløpende verk."],"tr":["Bu öğe, genel olarak ardışık bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho ấn phẩm nhiều kỳ."],"zh-Hans-CN":["该元素一般适用于一种相继作品的一种内容表达。"]},"altLabel":{"ar":["استمرار في جزء من (تعبيرة)"],"ca":["continuació en part de (expressió)"],"cs":["částečné pokračování (čeho) (vyjádření)"],"da":["fortsættelse i del af (udtryk)"],"de":["Teilweise darin aufgegangen (Expression),Teilweise darin aufgegangen (Expression)"],"en":["continuation in part of (expression)"],"es":["continuación en parte de (expresión)"],"fi":["jatkaa osittain ekspressiota"],"fr":["continuation partielle de (expression)"],"hu":["részekbeni folytatása a következőnek (kifejezési forma):"],"nl":["gedeeltelijke voortzetting van (expressie)"],"no":["fortsetter i deler av uttrykk"],"tr":["(anlatımın) bir kısmının devamı"],"zh-Hans-CN":["……的部分继承（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
