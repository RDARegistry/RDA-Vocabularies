                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20543", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToPerformance.en", "label":"has contributor family to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20404", "lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerCollectiveAgent.en", "label":"has costume designer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20522", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/costumeDesignerFamily.en", "label":"has costume designer family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20522", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/costumeDesignerFamily.en", "label":"has costume designer family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20345","label":{"ar":"لها شخص مصمم أزياء","ca":"té com a persona dissenyadora de vestuari","cs":"má kostýmního výtvarníka (osobu)","da":"har person, som er kostumedesigner","de":"hat Kostümbildnerin/Kostümbildner (Person)","de":"hat Kostümbildnerin/Kostümbildner (Person)","en":"has costume designer person","es":"tiene persona diseñadora de vestuario","et":"kostüümikunstnik (isik)","fi":"puvustaja (henkilö)","fr":"a pour personne conceptrice de costumes","hu":"jelmeztervező személye a következő:","lv":"kostīmu mākslinieks (persona)","nl":"heeft kostuumontwerper-persoon","no":"har kostymedesigner (person)","tr":"kostüm tasarımcısı ile ilişkilidir","zh-Hans-CN":"有服装设计者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال تصميم أزياء لإنتاج فيلم، أو لعرض موسيقي، أو درامي، أو ترفيهي."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió amb el disseny del vestuari en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že navrhuje kostýmy při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer et udtryk til en person, der bidrager til et udtryk ved at designe kostumer til en produktion med levende billeder eller for en musikalsk eller dramatisk præsentation eller underholdning."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft."],"en":["Relates an expression to a person who contributes to an expression by designing costumes for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona una expresión con una persona que contribuye a una expresión diseñando vestuario para una producción de imágenes en movimiento o para una presentación musical o dramática, o entretenimiento."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, kujundades kostüüme filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en concevant des costumes pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki mozgókép-produkciók, zenei vagy drámai előadások vagy szórakoztató műsorok számára jelmezek tervezésével járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, veidojot tērpus filmai, muzikālam vai dramatiskam uzvedumam, vai sarīkojumam."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het ontwerpen van kostuums voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å designe kostymene for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning."],"tr":["Bir anlatımı, hareketli bir görüntü yapımı veya müzikal ya da dramatik bir sunum veya eğlence için kostümler tasarlayarak bir anlatıma katkıda bulunan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过为动态图像制作或者为音乐或戏剧呈现或娱乐设计服装而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مصمم أزياء","ca":"persona dissenyadora de vestuari","cs":"kostýmní výtvarník (osoba)","da":"person, som er kostumedesigner","de":"Kostümbildnerin/Kostümbildner (Person)","de":"Kostümbildnerin/Kostümbildner (Person)","en":"costume designer person","es":"persona diseñadora de vestuario","et":"kostüümikunstnik (isik)","fi":"puvustaja (henkilö)","fr":"personne conceptrice de costumes","hu":"jelmeztervező személy:","lv":"kostīmu mākslinieks (persona)","nl":"kostuumontwerper-persoon","no":"kostymedesigner (person)","tr":"kostüm tasarımcısı","zh-Hans-CN":"服装设计者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال تصميم أزياء تصميم أزياء لإنتاج صور متحركة، أو لعرض موسيقي، أو درامي، أو ترفيهي.","ca":"Persona que contribueix a una expressió amb el disseny del vestuari en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic.","cs":"Osoba, která přispívá k vyjádření tím, že navrhuje kostýmy při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Person, der bidrager til et udtryk ved at designe kostumer til en produktion med levende billeder eller for en musikalsk eller dramatisk præsentation eller underholdning.","de":"Eine Person, die zu einer Expression beiträgt, indem sie die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.","de":"Eine Person, die zu einer Expression beiträgt, indem sie die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.","en":"A person who contributes to an expression by designing costumes for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Una persona que contribuye a una expresión diseñando vestuario para una producción de imágenes en movimiento o para una presentación musical o dramática, o entretenimiento.","et":"Isik, kes annab panuse väljendusse, kujundades kostüüme filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Henkilö, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen.","fr":"Personne qui contribue à une expression en concevant des costumes pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy személy, aki mozgókép-produkciók, zenei vagy drámai előadások vagy szórakoztató műsorok számára jelmezek tervezésével járul hozzá egy kifejezési formához.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, veidojot tērpus filmai, muzikālam vai dramatiskam uzvedumam, vai sarīkojumam.","nl":"Een persoon die bijdraagt aan een expressie door het ontwerpen van kostuums voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak.","no":"En person som bidrar til et uttrykk ved å designe kostymene for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning.","tr":"Hareketli bir görüntü üretimi veya müzikal veya dramatik bir performans veya eğlence için kostümler tasarlayarak anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过为动态图像制作或者为音乐或戏剧呈现或娱乐设计服装而对一种内容表达有贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20036", "lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerAgent.en", "label":"has costume designer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20345", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/costumeDesignerPerson.en", "label":"has costume designer person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20345", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/costumeDesignerPerson.en", "label":"has costume designer person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20040","label":{"ar":"لها وكيل كاتب محكمة","ca":"té com a agent relator d’un tribunal","cs":"má soudního zpravodaje (agenta)","da":"har agent, som er retsstenograf","de":"hat Gerichtsstenografin/Gerichtsstenograf (Akteur)","de":"hat Gerichtsstenografin/Gerichtsstenograf (Akteur)","el":"έχει στενογράφο","en":"has court reporter agent","es":"tiene agente reportero judicial","et":"kohtureporter (tegija)","fi":"tuomioistuimen kirjuri (toimija)","fr":"a pour agent rapporteur judiciaire","hu":"bírósági jegyzőkönyvvezető ágense a következő:","lv":"tiesas sekretārs (aģents)","nl":"heeft rechtbankverslaggever-actor","no":"har protokollfører (agent)","tr":"yazman temsilci ile ilişkilidir","vi":"có người báo cáo toà án","zh-Hans-CN":"有法院书记官行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال إعداد رأي محكمة للنشر."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió preparant les opinions d’un tribunal per a la seva publicació."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření tím, že připravuje stanoviska soudu ke zveřejnění."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at klargøre en domstols afgørelser til publicering."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er die Urteilsbegründung zur Veröffentlichung vorbereitet.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er die Urteilsbegründung zur Veröffentlichung vorbereitet."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου προετοιμάζοντας τις δικαστικές αποφάσεις προς δημοσίευση."],"en":["Relates an expression to an agent who contributes to an expression by preparing the opinions of a court for publication."],"es":["Relaciona una expresión con un agente que contribuye a una expresión preparando las opiniones de un tribunal para su publicación."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, valmistades avaldamiseks ette kohtu seisukohad."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en préparant les opinions d’un tribunal aux fins de publication."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy egy bíróság ítéleteit készíti elő közlésre."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, sagatavojot tiesas atzinumus publicēšanai."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het voorbereiden van de oordelen van een rechtbank voor publicatie."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å klargjøre en domstols kjennelser for utgivelse."],"tr":["Bir anlatımı, bir mahkemenin görüşlerini yayınlanmak üzere hazırlayarak bir anlatıma katkıda bulunan temsilcyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách chuẩn bị quan điểm của toà án để công bố."],"zh-Hans-CN":["将一种内容表达与通过准备用于公布的法院意见而对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل كاتب محكمة","ca":"agent relator d’un tribunal","cs":"soudní zpravodaj (agent)","da":"agent, som er retsstenograf","de":"Gerichtsstenografin/Gerichtsstenograf (Akteur)","de":"Gerichtsstenografin/Gerichtsstenograf (Akteur)","el":"στενογράφος","en":"court reporter agent","es":"agente reportero judicial","et":"kohtureporter (tegija)","fi":"tuomioistuimen kirjuri (toimija)","fr":"agent rapporteur judiciaire","hu":"bírósági jegyzőkönyvvezető ágens:","lv":"tiesas sekretārs (aģents)","nl":"rechtbankverslaggever-actor","no":"protokollfører (agent)","tr":"yazman temsi̇lci̇si̇","vi":"người báo cáo toà án","zh-Hans-CN":"法院书记官行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال إعداد رأي محكمة للنشر.","ca":"Agent que contribueix a una expressió preparant les opinions d’un tribunal per a la seva publicació.","cs":"Agent, který přispívá k vyjádření tím, že připravuje stanoviska soudu ke zveřejnění.","da":"Agent, som bidrager til et udtryk ved at klargøre en domstols afgørelser til publicering.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er die Urteilsbegründung zur Veröffentlichung vorbereitet.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er die Urteilsbegründung zur Veröffentlichung vorbereitet.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου προετοιμάζοντας τις δικαστικές αποφάσεις προς δημοσίευση.","en":"An agent who contributes to an expression by preparing the opinions of a court for publication.","es":"Un agente que contribuye a una expresión preparando las opiniones de un tribunal para su publicación.","et":"Tegija, kes annab panuse väljendusse, valmistades avaldamiseks ette kohtu seisukohad.","fi":"Toimija, joka osallistuu teoksen ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi.","fr":"Agent qui contribue à une expression en préparant les opinions d’un tribunal aux fins de publication.","hu":"Egy ágens, amely hozzájárul egy kifejezési formához azzal, hogy egy bíróság ítéleteit készíti elő közlésre.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, sagatavojot tiesas atzinumus publicēšanai.","nl":"Een actor die bijdraagt aan een expressie door het voorbereiden van de oordelen van een rechtbank voor publicatie.","no":"En agent som bidrar til et uttrykk ved å klargjøre en domstols kjennelser for utgivelse.","tr":"Bir mahkemenin görüşlerini yayına hazırlayarak bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách chuẩn bị quan điểm của toà án để công bố.","zh-Hans-CN":"通过准备用于公布的法院意见而对一种内容表达有贡献的一个行为者"},"altLabel":{"ar":["كاتب محكمة"],"ca":["relator d’un tribunal"],"cs":["soudní zpravodaj"],"da":["retsstenograf"],"de":["Gerichtsstenograf,Gerichtsstenographin/Gerichtsstenograph,Gerichtsstenograf"],"en":["court reporter"],"es":["reportero judicial"],"et":["kohtureporter"],"fi":["tuomioistuimen kirjuri"],"fr":["rapporteur judiciaire"],"hu":["bírósági jegyzőkönyvvezető:"],"nl":["rechtbankverslaggever"],"no":["protokollfører"],"tr":["yazman"],"zh-Hans-CN":["法院书记官"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
