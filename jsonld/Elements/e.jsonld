                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20406", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserCollectiveAgent.en", "label":"has reviser collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20034", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberAgent.en", "label":"has transcriber agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20477", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberCorporateBody.en", "label":"has transcriber corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20536", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberFamily.en", "label":"has transcriber family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20418", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/transcriberCollectiveAgent.en", "label":"has transcriber collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20418", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/transcriberCollectiveAgent.en", "label":"has transcriber collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20477","label":{"ar":"لها هيئة ناسخة","ca":"té com a entitat corporativa transcriptora","cs":"má přepisovatele (korporaci)","da":"har korporation, som er transskribent","de":"hat Transkribiererin/Transkribierer (Körperschaft)","de":"hat Transkribiererin/Transkribierer (Körperschaft)","en":"has transcriber corporate body","es":"tiene organismo corporativo transcriptor","et":"transkribeerija (asutus)","fi":"transkriboija (yhteisö)","fr":"a pour collectivité transcriptrice","hu":"átíró testülete a következő:","lv":"transkribētājs (institūcija)","nl":"heeft transcribeerder-corporatie","no":"har avskriver (korporasjon)","tr":"yazıya aktaran tüzel kişi ile ilişkilidir","zh-Hans-CN":"有转写者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في تعبيرة بكتابة محتوى لم تسبق كتابته أو تدوينه، أو بتغييره من نظام تدوين لآخر."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření tím, že zapisuje nebo přepisuje nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer et udtryk til en korporation, som bidrager til et udtryk ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"en":["Relates an expression to a corporate body who contributes to an expression by writing down or notating unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión al escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro."],"et":["Seostab väljenduse asutusega, kes annab panuse väljendusse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää ekspression yhteisöön, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittaman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression en écrivant ou en notant un contenu auparavant non écrit ou non noté, ou bien en le transposant d’un système de notation à un autre."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely korábban le nem írt vagy le nem jegyzett tartalom leírásával vagy lejegyzésével, vagy egyik jelölési rendszerről a másikra történő átvitelével járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu izteiksmē, pierakstot mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie door het opschrijven of noteren van ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteem naar een ander."],"no":["Relaterer et uttrykk til en korporasjon som bidrar til et uttrykk ved å forkorte originalverket, men la originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir anlatımı, yazılı olmayan veya not edilmemiş içeriği yazarak veya not ederek veya bir notasyon sisteminden diğerine değiştirerek anlatıma katkıda bulunan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系而对一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة ناسخة","ca":"entitat corporativa transcriptora","cs":"přepisovatel (korporace)","da":"korporation, som er transskribent","de":"Transkribiererin/Transkribierer (Körperschaft)","de":"Transkribiererin/Transkribierer (Körperschaft)","en":"transcriber corporate body","es":"organismo corporativo transcriptor","et":"transkribeerija (asutus)","fi":"transkriboija (yhteisö)","fr":"collectivité transcriptrice","hu":"átíró testület:","lv":"transkribētājs (institūcija)","nl":"transcribeerder-corporatie","no":"avskriver (korporasjon)","tr":"yazıya aktaran tüzel kişi","zh-Hans-CN":"转写者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في تعبيرة بكتابة محتوى لم تسبق كتابته أو تدوينه، أو بتغييره من نظام تدوين لآخر.","ca":"Entitat corporativa que contribueix a una expressió escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Korporace, která přispívá k vyjádření tím, že zapisuje nebo přepisuje nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Korporation, som bidrager til et udtryk ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","en":"A corporate body who contributes to an expression by writing down or notating unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Un organismo corporativo que contribuye a una expresión al escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro.","et":"Asutus, kes annab panuse väljendusse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Yhteisö, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen.","fr":"Collectivité qui contribue à une expression en écrivant ou en notant un contenu auparavant non écrit ou non noté, ou bien en le transposant d’un système de notation à un autre.","hu":"Egy testület, amely korábban le nem írt vagy le nem jegyzett tartalom leírásával vagy lejegyzésével, vagy egyik jelölési rendszerről a másikra történő átvitelével járul hozzá egy kifejezési formához.","lv":"Institūcija, kas sniegusi ieguldījumu izteiksmē, pierakstot mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een corporatie die bijdraagt aan een expressie door het opschrijven of noteren van ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteem naar een ander.","no":"En korporasjon som bidrar til et uttrykk ved å forkorte originalverket, men la originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Yazılı olmayan veya notlanmamış içeriği yazarak veya not ederek veya bir not sisteminden diğerine değiştirerek bir ifadeye katkıda bulunan tüzel kişi.","zh-Hans-CN":"通过写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系而对一种内容表达有贡献的一个团体"},"note":{"ar":["يُستبعد نسخ عمل موسيقي إلى آلة موسيقية أو فرقة عزف مختلفة."],"ca":["S’exclou la transcripció d’una obra musical per a un instrument o un grup d’intèrprets diferent."],"cs":["Přepisování hudebního díla pro jiný nástroj nebo účinkující skupinu je vyloučeno."],"da":["Afskrift af et musikværk for et andet instrument, eller optrædende gruppe, er ikke omfattet."],"de":["Darunter fällt keine Transkription eines Musikwerks für ein anderes Instrument oder ein anderes aufführendes Ensemble.,Darunter fällt keine Transkription eines Musikwerks für ein anderes Instrument oder eine andere Besetzung."],"en":["Transcription of a musical work for a different instrument or performing group is excluded."],"es":["Transcripción de una obra musical para un instrumento o grupo intérprete diferente se excluye."],"et":["Ei hõlma muusikateose transkribeerimist teisele instrumendile või esituskoosseisule."],"fi":["Tähän ei kuulu musiikkiteoksen transkribointi eri soittimelle tai esitysryhmälle."],"fr":["La transcription d’une œuvre pour un instrument ou un groupe d’interprètes différents est exclue."],"hu":["Egy zenemű átirata egy másik hangszerre vagy előadói csoportra nem tartozik ide."],"lv":["Neietver mūzikas darba pārlikšanu (aranžēšanu) citam instrumentam vai izpildītājgrupai."],"nl":["Transcriptie van een muziekwerk voor een ander instrument of uitvoeringsgroep is uitgesloten."],"no":["Omskriving av et musikalsk verk for et annet instrument eller ensemble er ikke inkludert."],"tr":["Bir müzik eserinin farklı bir enstrüman ve performans grubu için transkripsiyonu hariçtir."],"zh-Hans-CN":["不包括将一种音乐作品转写用于不同的乐器或表演组合。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
