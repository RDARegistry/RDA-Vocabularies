                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20465", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserCorporateBody.en", "label":"has reviser corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20418", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberCollectiveAgent.en", "label":"has transcriber collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20477", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/transcriberCorporateBody.en", "label":"has transcriber corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20477", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/transcriberCorporateBody.en", "label":"has transcriber corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20536","label":{"ar":"لها عائلة ناسخة","ca":"té com a família transcriptora","cs":"má přepisovatele (rodinu)","da":"har familie, som er transskribent","de":"hat Transkribiererin/Transkribierer (Familie)","de":"hat Transkribiererin/Transkribierer (Familie)","en":"has transcriber family","es":"tiene familia transcriptora","et":"transkribeerija (perekond)","fi":"transkriboija (suku)","fr":"a pour famille transcriptrice","hu":"átíró családja a következő:","lv":"transkribētājs (dzimta/ģimene)","nl":"heeft transcribeerder-familie","no":"har avskriver (familie)","tr":"yazıya aktaran aile ile ilişkilidir","zh-Hans-CN":"有转写者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة بكتابة محتوى لم تسبق كتابته أو تدوينه، أو بتغييره من نظام تدوين لآخر."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že zapisuje nebo přepisuje nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"en":["Relates an expression to a family who contributes to an expression by writing down or notating unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittaman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en écrivant ou en notant un contenu auparavant non écrit ou non noté, ou bien en le transposant d’un système de notation à un autre."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely korábban le nem írt vagy le nem jegyzett tartalom leírásával vagy lejegyzésével, vagy egyik jelölési rendszerről a másikra történő átvitelével járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, pierakstot mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door het opschrijven of noteren van ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteem naar een ander."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å forkorte originalverket, men la originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir anlatımı, yazılı olmayan veya not edilmemiş içeriği yazarak veya not ederek veya bir not sisteminden diğerine değiştirerek anlatıma katkıda bulunan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة ناسخة","ca":"família transcriptora","cs":"přepisovatel (rodina)","da":"familie, som er transskribent","de":"Transkribiererin/Transkribierer (Familie)","de":"Transkribiererin/Transkribierer (Familie)","en":"transcriber family","es":"familia transcriptora","et":"transkribeerija (perekond)","fi":"transkriboija (suku)","fr":"famille transcriptrice","hu":"átíró család:","lv":"transkribētājs (dzimta/ģimene)","nl":"transcribeerder-familie","no":"avskriver (familie)","tr":"yazıya aktaran aile","zh-Hans-CN":"转写者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة بكتابة محتوى لم تسبق كتابته أو تدوينه، أو بتغييره من نظام تدوين لآخر.","ca":"Família que contribueix a una expressió escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Rodina, která přispívá k vyjádření tím, že zapisuje nebo přepisuje nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Familie, som bidrager til et udtryk ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","en":"A family who contributes to an expression by writing down or notating unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Una familia que contribuye a una expresión al escribir o anotar contenido no escrito o anotado previamente o cambiarlo de un sistema de notación a otro.","et":"Perekond, kes annab panuse väljendusse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Suku, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen.","fr":"Famille qui contribue à une expression en écrivant ou en notant un contenu auparavant non écrit ou non noté, ou bien en le transposant d’un système de notation à un autre.","hu":"Egy család, amely korábban le nem írt vagy le nem jegyzett tartalom leírásával vagy lejegyzésével, vagy egyik jelölési rendszerről a másikra történő átvitelével járul hozzá egy kifejezési formához.","lv":"Dzimta/ģimene, kas sniegusi ieguldījumu izteiksmē, pierakstot mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een familie die bijdraagt aan een expressie door het opschrijven of noteren van ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteem naar een ander.","no":"En familie som bidrar til et uttrykk ved å forkorte originalverket, men la originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Yazılı olmayan veya notlanmamış içeriği yazarak veya not ederek veya bir notasyon sisteminden diğerine değiştirerek bir anlatıma katkıda bulunan bir aile.","zh-Hans-CN":"通过写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系而对一种内容表达有贡献的一个家族"},"note":{"ar":["يُستبعد نسخ عمل موسيقي إلى آلة موسيقية أو فرقة عزف مختلفة."],"ca":["S’exclou la transcripció d’una obra musical per a un instrument o un grup d’intèrprets diferent."],"cs":["Přepisování hudebního díla pro jiný nástroj nebo účinkující skupinu je vyloučeno."],"da":["Afskrift af et musikværk for et andet instrument, eller optrædende gruppe, er ikke omfattet."],"de":["Darunter fällt keine Transkription eines Musikwerks für ein anderes Instrument oder ein anderes aufführendes Ensemble.,Darunter fällt keine Transkription eines Musikwerks für ein anderes Instrument oder eine andere Besetzung."],"en":["Transcription of a musical work for a different instrument or performing group is excluded."],"es":["Transcripción de una obra musical para un instrumento o grupo intérprete diferente se excluye."],"et":["Ei hõlma muusikateose transkribeerimist teisele instrumendile või esituskoosseisule."],"fi":["Tähän ei kuulu musiikkiteoksen transkribointi eri soittimelle tai esitysryhmälle."],"fr":["La transcription d’une œuvre pour un instrument ou un groupe d’interprètes différents est exclue."],"hu":["Egy zenemű átirata egy másik hangszerre vagy előadói csoportra nem tartozik ide."],"lv":["Neietver mūzikas darba pārlikšanu (aranžēšanu) citam instrumentam vai izpildītājgrupai."],"nl":["Transcriptie van een muziekwerk voor een ander instrument of uitvoeringsgroep is uitgesloten."],"no":["Omskriving av et musikalsk verk for et annet instrument eller ensemble er ikke inkludert."],"tr":["Bir müzik eserinin farklı bir enstrüman ve performans grubu için transkripsiyonu hariçtir."],"zh-Hans-CN":["不包括将一种音乐作品转写用于不同的乐器或表演组合。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
