                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/expandedAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20115", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/expandedAsExpression.en", "label":"is expanded as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20115", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/expandedAsExpression.en", "label":"is expanded as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20170","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يكثف تعبيرة مصدرية تكثيفا منهجيا وشاملا."],"ca":["Relaciona una expressió amb una expressió d’una obra que condensa sistemàticament i exhaustiva una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které systematicky a komplexně zhušťuje vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som systematisk og gennemgribende komprimerer indholdet i et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die eine Expression eines anderen Werks systematisch und umfassend zusammenfasst.http://rdaregistry.i,Eine Expression eines Werks, die eine Expression eines anderen Werks systematisch und umfassend zusammenfasst."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συστηματικά και περιεκτικά συμπυκνώνει μια έκφραση-πηγή."],"en":["Relates an expression to an expression of a work that systematically and comprehensively condenses an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que condensa de forma sistemática y comprensiva una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, milles seotud väljendus on süstemaatiliselt ja igakülgselt kokku võetud."],"fi":["Liittää ekspression teoksen ekspressioon, joka systemaattisesti ja kokonaisuudessaan tiivistää toisen teoksen ekspression."],"fr":["Met une expression en relation avec une expression d’une œuvre qui abrège une expression d’une autre œuvre de manière systématique et complète."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy forrás kifejezési formáját módszeresen és átfogóan tömöríti."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir sistemātisks un aptverošs pamatizteiksmes īss apskats."],"nl":["Relateert een expressie aan een expressie van een werk dat systematisch en alomvattend een expressie van een ander werk indikt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som systematisk forkorter et kildeuttrykk."],"tr":["Bir anlatımı, bir kaynak anlatımı sistematik ve kapsamlı bir şekilde özetleyen bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm làm súc tích một sách có hệ thống và toàn diện biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与系统而全面压缩一种源内容表达的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"موجزة كتعبيرة","ca":"compendiat com a expressió","cs":"digest (vyjádření)","da":"sammenfattet som udtryk","de":"Digest (Expression)","de":"Digest (Expression)","el":"αφομοιωμένη ως (έκφραση)","en":"digested as expression","es":"digerido como expresión","et":"refereeritud väljendusena","fi":"mukautettu lyhennelmä (ekspressio)","fr":"condensé comme une expression","hu":"kivonatolva kifejezési formaként:","lv":"īssavilkums (izteiksme)","nl":"digest als expressie","no":"sammenfattet til uttrykk","tr":"anlatım olarak özetlenmiş","vi":"được sắp đặt như là (biểu hiện)","zh-Hans-CN":"被编制文摘为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يكثف ت