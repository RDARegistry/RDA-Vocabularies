                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20329", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToPerformance.en", "label":"has contributor agent to performance"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20404", "lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerCollectiveAgent.en", "label":"has costume designer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20345", "lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerPerson.en", "label":"has costume designer person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20036", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/costumeDesignerAgent.en", "label":"has costume designer agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20036", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/costumeDesignerAgent.en", "label":"has costume designer agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20404","label":{"ar":"لها وكيل جماعي مصمم أزياء","ca":"té com a agent col·lectiu dissenyador de vestuari","cs":"má kostýmního výtvarníka (kolektivního agenta)","da":"har kollektiv agent, som er kostumedesigner","de":"hat Kostümbildnerin/Kostümbildner (Gemeinschaftlicher Akteur)","de":"hat Kostümbildnerin/Kostümbildner (Gemeinschaftlicher Akteur)","en":"has costume designer collective agent","es":"tiene agente colectivo diseñador de vestuario","et":"kostüümikunstnik (kollektiiv)","fi":"puvustaja (yhteistoimija)","fr":"a pour agent collectif concepteur de costumes","hu":"jelmeztervező kollektív ágense a következő:","lv":"kostīmu mākslinieks (grupa)","nl":"heeft kostuumontwerper-collectieve actor","no":"har kostymedesigner (kollektiv agent)","tr":"kostüm tasarımcısı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有服装设计者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يساهم في تعبيرة من خلال تصميم أزياء لإنتاج صور متحركة، أو لعرض موسيقي، أو درامي، أو ترفيهي."],"ca":["Relaciona una expressió amb un agent col·lectiu que contribueix a una expressió amb el disseny del vestuari en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který přispívá k vyjádření tím, že navrhuje kostýmy při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer et udtryk til en kollektiv agent, som bidrager til et udtryk ved at designe kostumer til en levende billedproduktion eller til en musikalsk eller dramatisk præsentation eller i underholdning."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft."],"en":["Relates an expression to a collective agent who contributes to an expression by designing costumes for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona una expresión con un agente colectivo que contribuye a una expresión al diseñar vestuarios para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática."],"et":["Seostab väljenduse kollektiiviga, kes annab panuse väljendusse, kujundades kostüüme filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää ekspression yhteistoimijaan, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen."],"fr":["Met une expression en relation avec un agent collectif qui contribue à une expression en concevant des costumes pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely mozgókép-produkciók, zenei vagy drámai előadások vagy szórakoztató műsorok számára jelmezek tervezésével járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar grupu, kas sniegusi ieguldījumu izteiksmē, veidojot tērpus filmai, muzikālam vai dramatiskam uzvedumam, vai sarīkojumam."],"nl":["Relateert een expressie aan een collectieve actor die bijdraagt aan een expressie door het ontwerpen van kostuums voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak."],"no":["Relaterer et uttrykk til en kollektiv agent som bidrar til et uttrykk ved å designe kostymene for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning."],"tr":["Bir anlatımı, hareketli bir görüntü yapımı veya müzikal ya da dramatik bir sunum veya eğlence için kostümler tasarlayarak bir anlatıma katkıda bulunan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过为动态图像制作或者为音乐或戏剧呈现或娱乐设计服装而对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مصمم أزياء","ca":"agent col·lectiu dissenyador de vestuari","cs":"kostýmní výtvarník (kolektivní agent)","da":"kollektiv agent, som er kostumedesigner","de":"Kostümbildnerin/Kostümbildner (Gemeinschaftlicher Akteur)","de":"Kostümbildnerin/Kostümbildner (Gemeinschaftlicher Akteur)","en":"costume designer collective agent","es":"agente colectivo diseñador de vestuario","et":"kostüümikunstnik (kollektiiv)","fi":"puvustaja (yhteistoimija)","fr":"agent collectif concepteur de costumes","hu":"jelmeztervező kollektív ágens:","lv":"kostīmu mākslinieks (grupa)","nl":"kostuumontwerper-collectieve actor","no":"kostymedesigner (kollektiv agent)","tr":"kostüm tasarımcısı kolektif temsilcisi","zh-Hans-CN":"服装设计者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يساهم في تعبيرة من خلال تصميم أزياء لإنتاج صور متحركة، أو لعرض موسيقي، أو درامي، أو ترفيهي.","ca":"Agent col·lectiu que contribueix a una expressió amb el disseny del vestuari en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic.","cs":"Kolektivní agent, který přispívá k vyjádření tím, že navrhuje kostýmy při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Kollektiv agent, som bidrager til et udtryk ved at designe kostumer til en levende billedproduktion eller til en musikalsk eller dramatisk præsentation eller i underholdning.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.","en":"A collective agent who contributes to an expression by designing costumes for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Un agente colectivo que contribuye a una expresión al diseñar vestuarios para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática.","et":"Kollektiiv, kes annab panuse väljendusse, kujundades kostüüme filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Yhteistoimija, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen.","fr":"Agent collectif qui contribue à une expression en concevant des costumes pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy kollektív ágens, amely mozgókép-produkciók, zenei vagy drámai előadások vagy szórakoztató műsorok számára jelmezek tervezésével járul hozzá egy kifejezési formához.","lv":"Grupa, kas sniegusi ieguldījumu izteiksmē, veidojot tērpus filmai, muzikālam vai dramatiskam uzvedumam, vai sarīkojumam.","nl":"Een collectieve actor die bijdraagt aan een expressie door het ontwerpen van kostuums voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak.","no":"En kollektiv agent som bidrar til et uttrykk ved å designe kostymene for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning.","tr":"Hareketli bir görüntü prodüksiyonu veya müzikal veya dramatik bir sunum veya eğlence için kostümler tasarlayarak bir ifadeye katkıda bulunan kolektif bir temsilci.","zh-Hans-CN":"通过为动态图像制作或者为音乐或戏剧呈现或娱乐设计服装而对一种内容表达有贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
