                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20484", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToPerformance.en", "label":"has contributor corporate body to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20404", "lexicalAlias":"http://rdaregistry.info/Elements/e/costumeDesignerCollectiveAgent.en", "label":"has costume designer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20463", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/costumeDesignerCorporateBody.en", "label":"has costume designer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20463", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/costumeDesignerCorporateBody.en", "label":"has costume designer corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20522","label":{"ar":"لها عائلة مصممة أزياء","ca":"té com a família dissenyadora de vestuari","cs":"má kostýmního výtvarníka (rodinu)","da":"har familie, som er kostumedesigner","de":"hat Kostümbildnerin/Kostümbildner (Familie)","de":"hat Kostümbildnerin/Kostümbildner (Familie)","en":"has costume designer family","es":"tiene familia diseñadora de vestuario","et":"kostüümikunstnik (perekond)","fi":"puvustaja (suku)","fr":"a pour famille conceptrice de costumes","hu":"jelmeztervező családja a következő:","lv":"kostīmu mākslinieks (dzimta/ģimene)","nl":"heeft kostuumontwerper-familie","no":"har kostymedesigner (familie)","tr":"kostüm tasarımcısı aile ile ilişkilidir","zh-Hans-CN":"有服装设计者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة من خلال تصميم أزياء لإنتاج فيلم، أو لعرض موسيقي، أو درامي، أو ترفيهي."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió amb el disseny del vestuari en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že navrhuje kostýmy při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at designe kostumer for en produktion med levende billeder eller for en musikalsk eller dramatisk præsentation eller underholdning."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie die Kostüme für eine Bewegtbildproduktion oder für eine musikalische oder dramatische Darbietung oder Aufführung entwirft."],"en":["Relates an expression to a family who contributes to an expression by designing costumes for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al diseñar vestuarios para una producción de imágenes en movimiento o para una presentación o entretenimiento musical o dramática."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, kujundades kostüüme filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen suunnittelemalla elokuvatuotannon tai musiikki- tai näytelmäesityksen puvustuksen."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en concevant des costumes pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely mozgókép-produkciók, zenei vagy drámai előadások vagy szórakoztató műsorok számára jelmezek tervezésével járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, veidojot tērpus filmai, muzikālam vai dramatiskam uzvedumam, vai sarīkojumam."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door het ontwerpen van kostuums voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å designe kostymene for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning."],"tr":["Bir anlatımı, hareketli bir görüntü yapımı veya müzikal ya da dramatik bir sunum veya eğlence için kostümler tasarlayarak bir anlatıma katkıda bulunan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过为动态图像制作或者为音乐或戏剧呈现或娱乐设计服装而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مصممة أزياء","ca":"família dissenyadora de vestuari","cs":"kostýmní výtvarník (rodina)","da":"familie, som er kostumedesigner","de":"Kostümbildnerin/Kostümbildner (Familie)","de":"Kostümbildnerin/Kostümbildner (Familie)","en":"costume designer family","es":"familia diseñadora de vestuario","et":"kostüümikunstnik (perekond)","fi":"puvustaja (suku)","fr":"famille conceptrice de costumes","hu":"jelmeztervező család:","lv":"kostīmu mākslinieks (dzimta/ģimene)","nl":"kostuumontwerper-familie","no":"kostymedesigner (familie)","tr":"kostüm tasarımcısı ailesi","zh-Hans-CN":"服装设计者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة من خلال تصميم أزياء تصميم أزياء لإنتاج صور متحركة، أو لعرض موسيقي، أو درامي، أو ترفيهي.","ca":"Família que contribueix a una expressió amb el disseny del vestuari en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic.","cs":"Rodi