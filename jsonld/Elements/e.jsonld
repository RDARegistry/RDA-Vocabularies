                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en", "label":"is adapted as expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedInVerseAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20077", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedInVerseAsExpression.en", "label":"is adapted in verse as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20077", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedInVerseAsExpression.en", "label":"is adapted in verse as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20256","label":{"ar":"هي تحويل روائي مصور لتعبيرة","ca":"és novel·lització gràfica d’una expressió","cs":"je adaptací vyjádření ve formě grafického románu","da":"er omskrivning af udtryk til graphic novel","de":"ist Bearbeitung als Graphic Novel von (Expression)","de":"ist Bearbeitung als Graphic Novel von (Expression)","el":"είναι μυθιστοριογράφηση σε μορφή κόμικ της (έκφραση)","en":"is graphic novelization of expression","es":"es una novela gráfica de expresión","et":"graafilise romaani versioon väljendusest","fi":"sarjakuvasovitus ekspressiosta","fr":"est une adaptation en roman graphique d’une expression","hu":"képregény-feldolgozása a következő kifejezési formának:","lv":"kā grafisks romāns adaptētā izteiksme","nl":"is stripboekversie van expressie","no":"er tegneserieroman basert på (uttrykk)","tr":"anlatımın çizgi romanlaştırılmasıdır","vi":"là viết thành tiểu thuyết đồ hoạ của (biểu hiện)","zh-Hans-CN":"是内容表达的图解小说化"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل معالج كرواية مصورة."],"ca":["Relaciona una expressió amb una expressió d’una obra que és adaptada com una novel·la gràfica."],"cs":["Vztahuje vyjádření k vyjádření díla, které je adaptováno jako grafický román."],"da":["Relaterer et udtryk til et udtryk af et værk, som er bearbejdet til graphic novel."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Graphic Novel bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Graphic Novel bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως μυθιστόρημα σε μορφή κόμικ."],"en":["Relates an expression to an expression of a work that is adapted as a graphic novel."],"es":["Relaciona una expresión con una expresión de una obra que está adaptada como novela gráfica."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud graafilise romaanina."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sovitettu sarjakuvaromaaniksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est adaptée en roman graphique."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet képregényként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir adaptēta kā grafiskais romāns."],"nl":["Relateert een expressie aan een expressie van een werk dat is bewerkt als een stripboek."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til en tegneserieroman."],"tr":["Bir anlatımı, grafik roman olarak uyarlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được phỏng theo như là tiểu thuyết đồ hoạ."],"zh-Hans-CN":["将一种内容表达与被改编为图解小说的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تحويل روائي مصور لتعبيرة","ca":"novel·lització gràfica d’una expressió","cs":"adaptace vyjádření ve formě grafického románu","da":"omskrivning af udtryk til graphic novel","de":"Bearbeitung als Graphic Novel von (Expression)","de":"Bearbeitung als Graphic Novel von (Expression)","el":"μυθιστοριογράφηση σε μορφή κόμικ της (έκφραση)","en":"graphic novelization of expression","es":"novelización gráfica de expresión.","et":"graafilise romaani versioon väljendusest","fi":"sarjakuvasovitus ekspressiosta","fr":"adaptation en roman graphique d’une expression","hu":"kifejezési forma képregényesítése:","lv":"kā grafisks romāns adaptētā izteiksme","nl":"stripboekversie van expressie","no":"tegneserieroman basert på (uttrykk)","tr":"anlatımın çizgi romanlaştırılması","vi":"viết thành tiểu thuyết đồ hoạ của (biểu hiện)","zh-Hans-CN":"内容表达的图解小说化"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معالج كرواية مصورة.","ca":"Expressió d’una obra que és adaptada com una novel·la gràfica.","cs":"Vyjádření díla, které je adaptováno jako grafický román.","da":"Udtryk af et værk, som er bearbejdet til graphic novel.","de":"Eine Expression eines Werks, die als Graphic Novel bearbeitet ist.","de":"Eine Expression eines Werks, die als Graphic Novel bearbeitet ist.","el":"Μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως μυθιστόρημα σε μορφή κόμικ.","en":"An expression of a work that is adapted as a graphic novel.","es":"Una expresión de una obra que está adaptada como novela gráfica.","et":"Teose väljendus, mis on adapteeritud graafilise romaanina.","fi":"Teoksen ekspressio, joka on sovitettu sarjakuvaromaaniksi.","fr":"Expression d’une œuvre qui est adaptée en roman graphique.","hu":"Egy mű kifejezési formája, amelyet képregényként adaptáltak.","lv":"Darba izteiksme, kas ir adaptēta kā grafiskais romāns.","nl":"Een expressie van een werk dat is bewerkt als een stripboek.","no":"Et uttrykk av et verk som er bearbeidet til en tegneserieroman.","tr":"Çizgi roman olarak uyarlanan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được phỏng theo như là tiểu thuyết đồ hoạ.","zh-Hans-CN":"被改编为图解小说的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
