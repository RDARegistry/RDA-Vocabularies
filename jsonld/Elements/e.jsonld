                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20425", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToPerformance.en", "label":"has contributor collective agent to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20279", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantAgent.en", "label":"has onscreen participant agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20481", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantCorporateBody.en", "label":"has onscreen participant corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20540", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenParticipantFamily.en", "label":"has onscreen participant family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20422", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/onscreenParticipantCollectiveAgent.en", "label":"has onscreen participant collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20422", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/onscreenParticipantCollectiveAgent.en", "label":"has onscreen participant collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20481","label":{"ar":"لها هيئة مشاركة في برامج على الشاشة","ca":"té com a entitat corporativa participant en pantalla","cs":"má vystupujícího na obrazovce (korporaci)","da":"har korporation, som er programmedvirkende","de":"hat On-Screen-Teilnehmerin/On-Screen-Teilnehmer (Körperschaft)","de":"hat On-Screen-Teilnehmerin/On-Screen-Teilnehmer (Körperschaft)","en":"has onscreen participant corporate body","es":"tiene organismo corporativo participante en pantalla","et":"ekraanil osaleja (asutus)","fi":"liikkuvaan kuvaan osallistuja (yhteisö)","fr":"a pour collectivité participante à l’écran","hu":"képernyőn megjelenő résztvevő testülete a következő:","lv":"ekrānā redzamais dalībnieks (institūcija)","nl":"heeft deelnemer in beeld-corporatie","no":"har deltaker i program (korporasjon)","tr":"ekran katılmıcısı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有屏幕参与者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في تعبيرة لعمل صور متحركة غير خيالية من خلال القيام بدور نشط كمشارك."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió d’una obra d’imatge en moviment de no ficció amb un paper actiu com a participant."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření naučného filmu tím, že v něm vystupuje jako aktivní účastník."],"da":["Relaterer et udtryk til en korporation, som bidrager til et udtryk af et levende billedværk af faktuel karakter ved at påtage sig en aktiv rolle som deltager."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression eines nicht-fiktionalen Bewegtbildwerks beiträgt, indem sie eine aktive Rolle als Teilnehmer einnimmt.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression eines nicht-fiktionalen Bewegtbildwerks beiträgt, indem sie eine aktive Rolle als Teilnehmer einnimmt."],"en":["Relates an expression to a corporate body who contributes to an expression of a nonfiction moving image work by taking an active role as a participant."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión de una obra de no ficción de imágenes en movimiento al asumir un rol activo como participante."],"et":["Seostab väljenduse asutusega, kes annab panuse mittefiktsioonilise filmiteose väljendusse, olles osalejana aktiivses rollis."],"fi":["Liittää ekspression yhteisöön, joka osallistuu ei-fiktiivisen liikkuvan kuvan teoksen ekspression tekemiseen ottamalla aktiivisen roolin osallistujana."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression d’une œuvre d’images animées de non fiction en jouant un rôle actif comme participant."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely egy dokumentarista vagy tényirodalmi mozgóképmű kifejezési formájhoz hozzájárul azzal, hogy résztvevőként aktív szerepet játszik benne."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu dokumentālās filmas, raidījuma u.tml. izteiksmē, aktīvi piedaloties kā dalībnieks."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie van een non-fictie bewegend beeldwerk door het nemen van een actieve rol als een deelnemer."],"no":["Relaterer et uttrykk til en korporasjon som bidrar til et uttrykk av et dokumentarverk i form av levende bilder ved å ha en aktiv rolle som deltaker."],"tr":["Bir anlatımı, katılımcı olarak aktif rol alarak kurgusal olmayan bir hareketli görüntü eserinin anlatımına katkıda bulunan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过积极参与而对一种非虚构动态图像作品的一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مشاركة في برامج على الشاشة","ca":"entitat corporativa participant en pantalla","cs":"vystupující na obrazovce (korporace)","da":"korporation, som er programmedvirkende","de":"On-Screen-Teilnehmerin/On-Screen-Teilnehmer (Körperschaft)","de":"On-Screen-Teilnehmerin/On-Screen-Teilnehmer (Körperschaft)","en":"onscreen participant corporate body","es":"organismo corporativo participante en pantalla","et":"ekraanil osaleja (asutus)","fi":"liikkuvaan kuvaan osallistuja (yhteisö)","fr":"collectivité participante à l’écran","hu":"képernyőn megjelenő résztvevő testület:","lv":"ekrānā redzamais dalībnieks (institūcija)","nl":"deelnemer in beeld-corporatie","no":"deltaker i program (korporasjon)","tr":"ekran katılımcısı tüzel kişi","zh-Hans-CN":"屏幕参与者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في تعبيرة لعمل صور متحركة غير خيالية من خلال القيام بدور نشط كمشارك.","ca":"Entitat corporativa que contribueix a una expressió d’una obra d’imatge en moviment de no ficció amb un paper actiu com a participant.","cs":"Korporace, která přispívá k vyjádření naučného filmu tím, že v něm vystupuje jako aktivní účastník.","da":"Korporation, som bidrager til et udtryk af et levende billedværk af faktuel karakter ved at påtage sig en aktiv rolle som deltager.","de":"Eine Körperschaft, die zu einer Expression eines nicht-fiktionalen Bewegtbildwerks beiträgt, indem sie eine aktive Rolle als Teilnehmer einnimmt.","de":"Eine Körperschaft, die zu einer Expression eines nicht-fiktionalen Bewegtbildwerks beiträgt, indem sie eine aktive Rolle als Teilnehmer einnimmt.","en":"A corporate body who contributes to an expression of a nonfiction moving image work by taking an active role as a participant.","es":"Un organismo corporativo que contribuye a una expresión de una obra de no ficción de imágenes en movimiento al asumir un rol activo como participante.","et":"Asutus, kes annab panuse mittefiktsioonilise filmiteose väljendusse, olles osalejana aktiivses rollis.","fi":"Yhteisö, joka osallistuu ei-fiktiivisen liikkuvan kuvan teoksen ekspression tekemiseen ottamalla aktiivisen roolin osallistujana.","fr":"Collectivité qui contribue à une expression d’une œuvre d’images animées de non fiction en jouant un rôle actif comme participant.","hu":"Egy testület, amely egy dokumentarista vagy tényirodalmi mozgóképmű kifejezési formájhoz hozzájárul azzal, hogy résztvevőként aktív szerepet játszik benne.","lv":"Institūcija, kas sniegusi ieguldījumu dokumentālās filmas, raidījuma u.tml. izteiksmē, aktīvi piedaloties kā dalībnieks.","nl":"Een corporatie die bijdraagt aan een expressie van een non-fictie bewegend beeldwerk door het nemen van een actieve rol als een deelnemer.","no":"En korporasjon som bidrar til et uttrykk av et dokumentarverk i form av levende bilder ved å ha en aktiv rolle som deltaker.","tr":"Kurgu dışı bir hareketli görüntü eserinin ifadesine, katılımcı olarak aktif bir rol üstlenerek katkıda bulunan bir tüzel kişi","zh-Hans-CN":"通过积极参与而对一种非虚构动态图像作品的一种内容表达有贡献的一个团体"},"note":{"ar":["يُستبعد الظهور على الشاشة لتقديم معلومات تتعلق بالسياق أو الخلفية."],"ca":["S’exclou l’aparició en pantalla per proporcionar informació contextual o dels antecedents."],"cs":["Vystupování na obrazovce za účelem poskytnutí informací o kontextu nebo pozadí je vyloučeno."],"da":["Optræden på skærmen for at give kontekstuel eller baggrundsinformation er ikke omfattet."],"de":["Darunter fallen keine Bildschirmauftritte, die Kontext- oder Hintergrundinformationen liefern.,Darunter fallen keine Bildschirmauftritte, die Kontext- oder Hintergrundinformationen liefern."],"en":["Appearance on screen to provide contextual or background information is excluded."],"es":["Aparición en pantalla para proveer información contextual o de fondo se excluye."],"et":["Ei hõlma ilmumist ekraanile pakkuma kontekstilist ja taustinfot."],"fi":["Ei koske esiintymistä lisä- tai taustatietojen kertojana."],"fr":["L’apparition à l’écran pour fournir de l’information contextuelle ou complémentaire est exclue."],"hu":["Az olyan képernyőn való megjelenés, amely környezetfüggő vagy háttérinformációkat nyújt, nem tartozik ide."],"lv":["Neattiecas uz raidījuma vadītājiem, komentētājiem u.tml., kas veido raidījuma kontekstu."],"nl":["In beeld verschijnen om contextuele of achtergrondinformatie te geven is uitgesloten."],"no":["Å vises på skjermen for å gi kontekst eller bakgrunnsinformasjon er ikke inkludert."],"tr":["Bağlamsal veya arka plan bilgisi sağlamak için ekranda görünme hariçtir."],"zh-Hans-CN":["不包括提供背景信息在屏幕上出现的情况。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
