                                                                                },"instructionNumber":"7.24","lexicalAlias":"http://rdaregistry.info/Elements/e/artisticAndOrTechnicalCredit.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20189","label":{"ar":"هي مراجعة لـ","ca":"és revisió de","cs":"je revizí (čeho)","da":"er revision af","de":"ist Überarbeitung von","de":"ist Überarbeitung von","el":"είναι αναθεώρηση της","en":"is revision of","es":"es revisión de","et":"uusversiooni alus","fi":"uudistetun version perusta","fr":"est une révision de","hu":"átdolgozása a következőnek:","lv":"ir pārstrādātā izteiksme","nl":"is herziening van","no":"er revisjon av","tr":"gözden geçirilmesidir.","vi":"là duyệt lại của","zh-Hans-CN":"是……的修订"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم كأساس لنسخة مُحدثة، أو مُصححة، أو مُوسعة."],"ca":["Relaciona una expressió amb una expressió que s’actualitza, es corregeix o s’amplia per crear una nova expressió de la mateixa obra."],"cs":["Vztahuje vyjádření k vyjádření, které je aktualizováno, opraveno nebo rozšířeno za účelem vytvoření nového vyjádření téhož díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvendes som grundlag for en opdateret, korrigeret eller udvidet version."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Grundlage für eine aktualisierte, korrigierte oder erweiterte Fassung verwendet wird.,Setzt eine Expression in Beziehung zu einem Wort oder einer Phrase, die dazu dient, eine Expression von einer anderen Expression desselben Werks zu unterscheiden."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο χρησιμοποιείται ως η βάση για μια ενημερωμένη/ανανεωμένη, διορθωμένη ή επεκταμένη εκδοχή."],"en":["Relates an expression to an expression that is updated, corrected, or expanded to create a new expression of the same work."],"es":["Relaciona una expresión con una expresión que se actualiza, corrige o expande para crear una nueva expresión del mismo trabajo."],"et":["Seostab väljenduse teose väljendusega, mis on aluseks uuendatud, parandatud või laiendatud versioonile."],"fi":["Liittää ekspression teoksen ekspressioon, jota on käytetty päivitetyn, korjatun tai laajennetun version perustana."],"fr":["Met une expression en relation avec une expression qui est mise à jour, corrigée ou augmentée pour créer une nouvelle expression de la même œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet egy frissített, korrigált vagy kiterjesztett verzió alapjaként használnak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas izmantota par pamatu atjauninātai, labotai vai paplašinātai versijai."],"nl":["Relateert een expressie aan een expressie van een werk dat is gebruikt als de basis voor een geüpdatete, gecorrigeerde of uitgebreide versie."],"no":["Relaterer et uttrykk til et uttrykk av et verk brukt som utgangspunkt for en oppdatert, korrigert eller utvidet versjon."],"tr":["Bir anlatımı, aynı eserin yeni bir ifadesini oluşturmak için güncellenen, düzeltilen veya genişletilen bir anlatımla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được sử dụng như là cơ sở cho phiên bản cập nhật, sửa lỗi, hoặc mở rộng."],"zh-Hans-CN":["将一种内容表达与被更新、更正或扩充以创建同一种作品的一种新的内容表达的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مراجعة لـ","ca":"revisió de","cs":"revize (čeho)","da":"revision af","de":"Überarbeitung von","de":"Überarbeitung von","el":"αναθεώρηση της","en":"revision of","es":"revisión de","et":"uusversiooni alus","fi":"uudistetun version perusta","fr":"révision de","hu":"átdolgozása:","lv":"pārstrādātā izteiksme","nl":"herziening van","no":"revisjon av","tr":"gözden geçirilmesi","vi":"duyệt lại của","zh-Hans-CN":"……的修订"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم كأساس لنسخة مُحدثة، أو مُصححة، أو مُوسعة.","ca":"Expressió que s’actualitza, es corregeix o s’amplia per crear una nova expressió de la mateixa obra.","cs":"Vyjádření, které je aktualizováno, opraveno nebo rozšířeno za účelem vytvoření nového vyjádření téhož díla.","da":"Udtryk af et værk, som anvendes som grundlag for en opdateret, korrigeret eller udvidet version.","de":"Eine Expression eines Werks, die als Grundlage für eine aktualisierte, korrigierte oder erweiterte Fassung verwendet wird.","de":"Setzt eine Expression in Beziehung zu einem Wort oder einer Phrase, die dazu dient, eine Expression von einer anderen Expression desselben Werks zu unterscheiden.","el":"Μια έκφραση ενός έργου το οποίο χρησιμοποιείται ως η βάση για μια ενημερωμένη/ανανεωμένη, διορθωμένη ή επεκταμένη εκδοχή.","en":"An expression that is updated, corrected, or expanded to create a new expression of the same work.","es":"Una expresión que se actualiza, corrige o expande para crear una nueva expresión del mismo trabajo.","et":"Teose väljendus, mis on aluseks uuendatud, parandatud või laiendatud versioonile.","fi":"Teoksen ekspressio, jota on käytetty päivitetyn, korjatun tai laajennetun version perustana.","fr":"Expression qui est mise à jour, corrigée ou augmentée pour créer une nouvelle expression de la même œuvre.","hu":"Egy mű kifejezési formája, amelyet egy frissített, korrigált vagy kiterjesztett verzió alapjaként használnak.","lv":"Darba izteiksme, kas izmantota par pamatu atjauninātai, labotai vai paplašinātai versijai.","nl":"Een expressie van een werk dat is gebruikt als de basis voor een geüpdatete, gecorrigeerde of uitgebreide versie.","no":"Et uttrykk av et verk brukt som utgangspunkt for en oppdatert, korrigert eller utvidet versjon.","tr":"Aynı eserin yeni bir anlamını oluşturmak için güncellenen, düzeltilen veya genişletilen bir anlatım.","vi":"Biểu hiện của tác phẩm được sử dụng như là cơ sở cho phiên bản cập nhật, sửa lỗi, hoặc mở rộng.","zh-Hans-CN":"被更新、更正或扩充以创建同一种作品的一种新的内容表达的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.in