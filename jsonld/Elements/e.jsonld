                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/mergedToFormExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20212", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/mergedToFormExpression.en", "label":"is merged to form expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20212", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/mergedToFormExpression.en", "label":"is merged to form expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20106","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يتكون من تلخيص موجز لمحتوى تعبيرة مصدرية."],"ca":["Relaciona una expressió amb una expressió d’una obra que consisteix en una recapitulació breu del contingut d’una expressió d’una altra obra."],"da":["Relaterer et udtryk til et udtryk af et værk, som består af en kortfattet gengivelse af udtrykket af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einer kurzen Wiederholung des Inhalts einer Expression eines anderen Werks besteht."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συνιστά μια σύντομη ανακεφαλαίωση του περιεχομένου μιας έκφρασης-πηγής."],"en":["Relates an expression to an expression of a work that consists of a brief recapitulation of the content of a source expression. (Deprecated)"],"et":["Seostab väljenduse teose väljendusega, milles on lühidalt kokku võetud allikväljenduse sisu"],"fi":["Liittää ekspression teoksen ekspressioon, joka koostuu lähteenä olevan ekspression sisällön lyhyestä koosteesta."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en une brève récapitulation du contenu d’une expression source."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy forrás tartalmának rövid összegzéséből áll."],"lv":["Sasaista izteiksmi ar darba izteiksmi - pamatdarba īss satura izklāsts."],"nl":["Relateert een expressie aan een expressie van een werk dat bestaat uit een korte herformulering van de content van een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som består av et kort sammendrag av innholdet fra et kildeuttrykk."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm có chứa bản tóm tắt lại của nội dung của biểu hiện nguồn."]},"ToolkitLabel":{"ar":"ملخصة كتعبيرة","ca":"sumaritzat com a expressió","da":"opsummeret som udtryk","de":"Zusammengefasst als (Expression)","el":"περίληψη ως (έκφραση)","en":"summarized as expression (Deprecated)","es":"sumarizada como (expresión)","et":"kokkuvõte väljendusena","fi":"yhteenveto (ekspressio)","fr":"résumé comme une expression","hu":"összefoglalva a következő kifejezési formában:","lv":"izteiksme: kopsavilkums","nl":"samengevat als expressie","no":"sammendrag som uttrykk","vi":"được tóm lược bằng (biểu hiện)"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يتكون من تلخيص موجز لمحتوى تعبيرة عمل آخر.","ca":"Expressió d’una obra que consisteix en una recapitulació breu del contingut d’una expressió d’una altra obra.","da":"Udtryk af et værk, som består af en kortfattet gengivelse af indholdet af udtrykket af et andet værk.","de":"Eine Expression eines Werks, die aus einer kurzen Wiederholung des Inhalts einer Expression eines anderen Werks besteht.","el":"Μια έκφραση ενός έργου το οποίο συνιστά μια σύντομη ανακεφαλαίωση του περιεχομένου μιας έκφρασης-πηγής.","en":"An expression of a work that consists of a brief recapitulation of the content of an expression of another work. (Deprecated)","es":"Una expresión de una obra que consiste en una recapitulación breve del contenido de la expresión fuente.","et":"Teose väljendus, milles on lühidalt kokku võetud allikväljenduse sisu","fi":"Teoksen ekspressio, joka koostuu toisen teoksen ekspression sisällön lyhyestä koosteesta.","fr":"Expression d’une œuvre qui consiste en une brève récapitulation du contenu d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formájához, amely egy forrás tartalmának rövid összegzéséből áll.","lv":"Darba izteiksme - pamatdarba īss satura izklāsts.","nl":"Een expressie van een werk dat bestaat uit een korte herformulering van de content van een expressie van een ander werk.","no":"Et uttrykk av et verk som består av et kort sammendrag av innholdet fra et kildeuttrykk.","vi":"Biểu hiện của tác phẩm có chứa bản tóm tắt lại của nội dung của biểu hiện nguồn."},"label":{"ar":"هي ملخصة كتعبيرة","ca":"és sumaritzat com a expressió","da":"er opsummeret som udtryk","de":"ist zusammengefasst als (Expression)","el":"είναι περίληψη ως (έκφραση)","en":"is summarized as expression (Deprecated)","et":"kokkuvõte väljendusena","fi":"yhteenveto (ekspressio)","fr":"est résumé comme une expression","hu":"összefoglalva mint kifejezési forma:","lv":"izteiksmes kopsavilkums","nl":"is samengevat als expressie","no":"er sammendrag som uttrykk","vi":"được tóm lược bằng (biểu hiện)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/summarizedAsExpression.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20106", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/summarizedAsExpression.en", "label":"is summarized as expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20106", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/summarizedAsExpression.en", "label":"is summarized as expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20019","label":{"ar":"لها وكيل مشارك في برامج","ca":"té com a agent panelista","cs":"má panelistu (agenta)","da":"har agent, som er paneldeltager","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Akteur)","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Akteur)","el":"έχει πανελίστα","en":"has panelist agent","es":"tiene agente panelista","et":"arutelust osavõtja (tegija)","fi":"panelisti (toimija)","fr":"a pour agent panéliste","hu":"vitafórumtag ágense a következő:","lv":"diskusijas dalībnieks (aģents)","nl":"heeft panellid-actor","no":"har paneldeltaker (agent)","tr":"panelist temsilcisi ile ilişkilidir","vi":"cóngười tham dự","zh-Hans-CN":"有访谈嘉宾行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش."],"ca":["Relaciona una expressió amb un agent que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió."],"cs":["Vztahuje vyjádření k agentovi, který je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí."],"da":["Relaterer et udtryk til en agent, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er eine Veranstaltung (meist eine Sendung) leitet, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Akteur), die/der zu einer Expression beiträgt, indem sie/er eine Veranstaltung (meist eine Sendung) leitet, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden."],"el":["Συνδέει μια έκφραση με έναν εκτελεστή ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της συμμετοχής του σε ένα πρόγραμμα, συχνά εκπομπή, όπου συζητώνται θέματα συνήθως με τη συμμετοχή ειδικών στον τομέα που είναι συναφής με τη συζήτηση."],"en":["Relates an expression to an agent who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion."],"es":["Relaciona una expresión con un agente que es un intérprete que contribuye a una expresión participando en un programa, muchas veces transmitido, donde se discuten temas, generalmente con la participación de expertos en campos relacionados con la discusión."],"et":["Seostab väljenduse tegijaga, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad."],"fi":["Liittää ekspression toimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa."],"fr":["Met une expression en relation avec un agent interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó ágenshez, amely egy programban, gyakran sugárzott műsorban, való részvételével, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével, hozzájárul egy kifejezési formához."],"lv":["Sasaista izteiksmi ar aģentu, kas ir izpildītājs, kas sniedzis ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos."],"nl":["Relateert een expressie aan een actor die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie."],"no":["Relaterer et uttrykk til en agent som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere."],"tr":["Bir anlatımı, genellikle tartışma ile ilgili alanlarda uzmanların katılımıyla konuların tartışıldığı, sıklıkla yayınlanan bir programa katılarak bir anlatıma katkıda bulunan bir sanatçı olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách tham gia vào chương trình, thường là chương trình phát sóng nơi mà đề tài được thảo luận, thường là với sự tham gia của các chuyên gia trong lĩnh vực liên quan tới cuộc thảo luận."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مشارك في برامج","ca":"agent panelista","cs":"panelista (agent)","da":"agent, som er paneldeltager","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Akteur)","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Akteur)","el":"πανελίστας","en":"panelist agent","es":"agente panelista","et":"arutelust osavõtja (tegija)","fi":"panelisti (toimija)","fr":"agent panéliste","hu":"vitafórumtag ágens:","lv":"diskusijas dalībnieks (aģents)","nl":"panellid-actor","no":"paneldeltaker (agent)","tr":"Panel katılımcı temsilci","vi":"người tham dự","zh-Hans-CN":"访谈嘉宾行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش.","ca":"Agent que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió.","cs":"Agent, který je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí.","da":"Agent, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er eine Veranstaltung (meist eine Sendung) leitet, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","de":"Eine Ausführende/Ein Ausführender (Akteur), die/der zu einer Expression beiträgt, indem sie/er eine Veranstaltung (meist eine Sendung) leitet, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","el":"Ένας εκτελεστής ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της συμμετοχής του σε ένα πρόγραμμα, συχνά εκπομπή, όπου συζητώνται θέματα συνήθως με τη συμμετοχή ειδικών στον τομέα που είναι συναφείς με τη συζήτηση.","en":"An agent who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion.","es":"Un agente que es un intérprete que contribuye a una expresión participando en un programa, muchas veces transmitido, donde se discuten temas, generalmente con la participación de expertos en campos relacionados con la discusión.","et":"Tegija, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad.","fi":"Toimija, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa.","fr":"Agent interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion.","hu":"Egy előadó ágens, amely egy programban, gyakran sugárzott műsorban, való részvételével, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével, hozzájárul egy kifejezési formához.","lv":"Aģents - izpildītājs, kas sniedzis ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos.","nl":"Een actor die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie.","no":"En agent som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere.","tr":"Genellikle tartışma ile ilgili alanlardaki uzmanların katılımıyla konuların tartışıldığı bir programa katılarak bir anlatıma katkıda bulunan bir sanatçı olan temsilci.","vi":"Người biểu diễn đóng góp cho biểu hiện của tác phẩm bằng cách tham gia vào chương trình, thường là chương trình phát sóng nơi mà đề tài được thảo luận, thường là với sự tham gia của các chuyên gia trong lĩnh vực liên quan tới cuộc thảo luận.","zh-Hans-CN":"作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个行为者"},"altLabel":{"ar":["مشارك في برامج"],"ca":["panelista"],"cs":["panelista"],"da":["paneldeltager"],"de":["Diskussionsteilnehmer,Diskussionteilnehmer"],"en":["panelist"],"es":["panelista"],"et":["arutelust osavõtja"],"fi":["panelisti"],"fr":["panéliste"],"hu":["vitafórumtag:"],"nl":["panellid"],"no":["paneldeltaker"],"tr":["panel katılımcısı"],"zh-Hans-CN":["访谈嘉宾"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/panelistAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20434", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCollectiveAgent.en", "label":"has panelist collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20375", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistPerson.en", "label":"has panelist person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20019", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/panelistAgent.en", "label":"has panelist agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20019", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/panelistAgent.en", "label":"has panelist agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20434","label":{"ar":"لها وكيل جماعي مشارك في برنامج","ca":"té com a agent col·lectiu panelista","cs":"má panelistu (kolektivního agenta)","da":"har kollektiv agent, som er paneldeltager","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Gemeinschaftlicher Akteur)","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Gemeinschaftlicher Akteur)","en":"has panelist collective agent","es":"tiene agente colectivo panelista","et":"arutelust osavõtja (kollektiiv)","fi":"panelisti (yhteistoimija)","fr":"a pour agent collectif panéliste","hu":"vitafórumtag kollektív ágense a következő:","lv":"diskusijas dalībnieks (grupa)","nl":"heeft panellid-collectieve actor","no":"har paneldeltaker (kollektiv agent)","tr":"panelist kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有访谈嘉宾集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش."],"ca":["Relaciona una expressió amb un agent col·lectiu que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí."],"da":["Relaterer et udtryk til en kollektiv agent, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden."],"en":["Relates an expression to a collective agent who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion."],"es":["Relaciona una expresión con un agente colectivo que es un intérprete que contribuye a una expresión al participar en un programa, muchas veces transmitido, en el que se discuten temas, comúnmente con la participación de expertos en áreas relacionadas con la discusión."],"et":["Seostab väljenduse kollektiiviga, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad."],"fi":["Liittää ekspression yhteistoimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa."],"fr":["Met une expression en relation avec un agent collectif interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó kollektív ágenshez, amely egy programban, gyakran sugárzott műsorban, való részvételével hozzájárul egy kifejezési formához, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével, hozzájárul egy kifejezési formához."],"lv":["Sasaista izteiksmi ar grupu, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos."],"nl":["Relateert een expressie aan een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie."],"no":["Relaterer et uttrykk til en kollektiv agent som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere."],"tr":["Bir anlatımı, genellikle tartışma ile ilgili alanlarda uzmanların katılımıyla konuların tartışıldığı, sıklıkla yayınlanan bir programa katılarak bir anlatıma katkıda bulunan bir sanatçı olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مشارك في برنامج","ca":"agent col·lectiu panelista","cs":"panelista (kolektivní agent)","da":"kollektiv agent, som er paneldeltager","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Gemeinschaftlicher Akteur)","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Gemeinschaftlicher Akteur)","en":"panelist collective agent","es":"agente colectivo panelista","et":"arutelust osavõtja (kollektiiv)","fi":"panelisti (yhteistoimija)","fr":"agent collectif panéliste","hu":"vitafórumtag kollektív ágens:","lv":"diskusijas dalībnieks (grupa)","nl":"panellid-collectieve actor","no":"paneldeltaker (kollektiv agent)","tr":"Panel katılımcı kolektif temsilci","zh-Hans-CN":"访谈嘉宾集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش.","ca":"Agent col·lectiu que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió.","cs":"Kolektivní agent, který je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí.","da":"Kollektiv agent, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","en":"A collective agent who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion.","es":"Un agente colectivo que es un intérprete que contribuye a una expresión al participar en un programa, muchas veces transmitido, en el que se discuten temas, comúnmente con la participación de expertos en áreas relacionadas con la discusión.","et":"Kollektiiv, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad.","fi":"Yhteistoimija, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa.","fr":"Agent collectif interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion.","hu":"Egy előadó kollektív ágens, amely egy programban, gyakran sugárzott műsorban, való részvételével hozzájárul egy kifejezési formához, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével, hozzájárul egy kifejezési formához.","lv":"Grupa - izpildītājs, kas sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos.","nl":"Een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie.","no":"En kollektiv agent som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere.","tr":"Genellikle tartışma ile ilgili alanlarda uzmanların katılımıyla konuların tartışıldığı, genellikle yayınlanan bir programa katılarak bir ifadeye katkıda bulunan bir sanatçı olan kolektif bir temsilci.","zh-Hans-CN":"作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20019", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistAgent.en", "label":"has panelist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20493", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCorporateBody.en", "label":"has panelist corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20552", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistFamily.en", "label":"has panelist family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20434", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/panelistCollectiveAgent.en", "label":"has panelist collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20434", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/panelistCollectiveAgent.en", "label":"has panelist collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20493","label":{"ar":"لها هيئة مشاركة في برنامج","ca":"té com a entitat corporativa panelista","cs":"má panelistu (korporaci)","da":"har korporation, som er paneldeltager","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Körperschaft)","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Körperschaft)","en":"has panelist corporate body","es":"tiene organismo corporativo panelista","et":"arutelust osavõtja (asutus)","fi":"panelisti (yhteisö)","fr":"a pour collectivité panéliste","hu":"vitafórumtag testülete a következő:","lv":"diskusijas dalībnieks (institūcija)","nl":"heeft panellid-corporatie","no":"har paneldeltaker (korporasjon)","tr":"panelist tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有访谈嘉宾团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تكون مؤديًا يساهم في تعبيرة من خلال إدارة برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش."],"ca":["Relaciona una expressió amb una entitat corporativa que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió."],"cs":["Vztahuje vyjádření ke korporaci, která je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí."],"da":["Relaterer et udtryk til en korporation, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden."],"en":["Relates an expression to a corporate body who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion."],"es":["Relaciona una expresión con un organismo corporativo que es un intérprete que contribuye a una expresión al participar en un programa, muchas veces transmitido, en el que se discuten temas, comúnmente con la participación de expertos en áreas relacionadas con la discusión."],"et":["Seostab väljenduse asutusega, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad."],"fi":["Liittää ekspression yhteisöön, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa."],"fr":["Met une expression en relation avec une collectivité interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó testülethez, amely egy programban, gyakran sugárzott műsorban, való részvételével hozzájárul egy kifejezési formához, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével."],"lv":["Sasaista izteiksmi ar institūciju, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos."],"nl":["Relateert een expressie aan een corporatie die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie."],"no":["Relaterer et uttrykk til en korporasjon som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere."],"tr":["Bir anlatımı, genellikle tartışma ile ilgili alanlarda uzmanların katılımıyla konuların tartışıldığı, sıklıkla yayınlanan bir programa katılarak bir anlatıma katkıda bulunan bir sanatçı olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مشاركة في برنامج","ca":"entitat corporativa panelista","cs":"panelista (korporace)","da":"korporation, som er paneldeltager","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Körperschaft)","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Körperschaft)","en":"panelist corporate body","es":"organismo corporativo panelista","et":"arutelust osavõtja (asutus)","fi":"panelisti (yhteisö)","fr":"collectivité panéliste","hu":"vitafórumtag testület:","lv":"diskusijas dalībnieks (institūcija)","nl":"panellid-corporatie","no":"paneldeltaker (korporasjon)","tr":"Panel katılımcı tüzel kişi","zh-Hans-CN":"访谈嘉宾团体"},"ToolkitDefinition":{"ar":"هيئة تكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش.","ca":"Entitat corporativa que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió.","cs":"Korporace, která je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí.","da":"Korporation, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","en":"A corporate body who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion.","es":"Un organismo corporativo que es un intérprete que contribuye a una expresión al participar en un programa, muchas veces transmitido, en el que se discuten temas, comúnmente con la participación de expertos en áreas relacionadas con la discusión.","et":"Asutus, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad.","fi":"Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa.","fr":"Collectivité interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion.","hu":"Egy előadó testület, amely egy programban, gyakran sugárzott műsorban, való részvételével hozzájárul egy kifejezési formához, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével.","lv":"Institūcija - izpildītājs, kas sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos.","nl":"Een corporatie die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie.","no":"En korporasjon som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere.","tr":"Genellikle yayınlanan konuların tartışıldığı, sıklıkla tartışmayla ilgili alanlardaki uzmanların bir programa katılımıyla bir ifadeye katkı sağlayan sanatçı olan bir tüzel kişidir.","zh-Hans-CN":"作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20434", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCollectiveAgent.en", "label":"has panelist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20493", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/panelistCorporateBody.en", "label":"has panelist corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20493", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/panelistCorporateBody.en", "label":"has panelist corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20552","label":{"ar":"لها عائلة مشاركة في برنامج","ca":"té com a família panelista","cs":"má panelistu (rodinu)","da":"har familie, som er paneldeltager","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Familie)","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Familie)","en":"has panelist family","es":"tiene familia panelista","et":"arutelust osavõtja (perekond)","fi":"panelisti (suku)","fr":"a pour famille panéliste","hu":"vitafórumtag családja a következő:","lv":"diskusijas dalībnieks (dzimta/ģimene)","nl":"heeft panellid-familie","no":"har paneldeltaker (familie)","tr":"panelist ailesi ile ilişkilidir","zh-Hans-CN":"有访谈嘉宾家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش."],"ca":["Relaciona una expressió amb una família que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió."],"cs":["Vztahuje vyjádření k rodině, která je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí."],"da":["Relaterer et udtryk til en familie, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden."],"en":["Relates an expression to a family who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion."],"es":["Relaciona una expresión con una familia que es un intérprete que contribuye a una expresión al participar en un programa, muchas veces transmitido, en el que se discuten temas, comúnmente con la participación de expertos en áreas relacionadas con la discusión."],"et":["Seostab väljenduse perekonnaga, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad."],"fi":["Liittää ekspression sukuun, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa."],"fr":["Met une expression en relation avec une famille interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó családhoz, amely egy programban, gyakran sugárzott műsorban, való részvételével hozzájárul egy kifejezési formához, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos."],"nl":["Relateert een expressie aan een familie die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie."],"no":["Relaterer et uttrykk til en familie som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere."],"tr":["Bir anlatımı, genellikle tartışma ile ilgili alanlarda uzmanların katılımıyla konuların tartışıldığı, sıklıkla yayınlanan bir programa katılarak bir anlatıma katkıda bulunan bir sanatçı olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مشاركة في برنامج","ca":"família panelista","cs":"panelista (rodina)","da":"familie, som er paneldeltager","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Familie)","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Familie)","en":"panelist family","es":"familia panelista","et":"arutelust osavõtja (perekond)","fi":"panelisti (suku)","fr":"famille panéliste","hu":"vitafórumtag család:","lv":"diskusijas dalībnieks (dzimta/ģimene)","nl":"panellid-familie","no":"paneldeltaker (familie)","tr":"Panel katılımcı aile","zh-Hans-CN":"访谈嘉宾家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش.","ca":"Família que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió.","cs":"Rodina, která je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí.","da":"Familie, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen.","de":"Eine Ausführende/ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","de":"Eine Ausführende/ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","en":"A family who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion.","es":"Una familia que es un intérprete que contribuye a una expresión al participar en un programa, muchas veces transmitido, en el que se discuten temas, comúnmente con la participación de expertos en áreas relacionadas con la discusión.","et":"Perekond, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad.","fi":"Suku, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa.","fr":"Famille interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion.","hu":"Egy előadó család, amely egy programban, gyakran sugárzott műsorban, való részvételével hozzájárul egy kifejezési formához, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével.","lv":"Dzimta/ģimene - izpildītājs, kas sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos.","nl":"Een familie die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie.","no":"En familie som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere.","tr":"Tartışmayla ilgili alanlardaki uzmanların katılımıyla konuların tartışıldığı, genellikle yayınlanan bir programda katılımcı olarak bir anlatıma katkıda bulunan sanatçı bir aile.","zh-Hans-CN":"作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/panelistFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20434", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistCollectiveAgent.en", "label":"has panelist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20552", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/panelistFamily.en", "label":"has panelist family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20552", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/panelistFamily.en", "label":"has panelist family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20375","label":{"ar":"لها شخص مشارك في برنامج","ca":"té com a persona panelista","cs":"má panelistu (osobu)","da":"har person, som er paneldeltager","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Person)","de":"hat Diskussionsteilnehmerin/Diskussionsteilnehmer (Person)","en":"has panelist person","es":"tiene persona panelista","et":"arutelust osavõtja (isik)","fi":"panelisti (henkilö)","fr":"a pour personne panéliste","hu":"vitafórumtag személye a következő:","lv":"diskusijas dalībnieks (persona)","nl":"heeft panellid-persoon","no":"har paneldeltaker (person)","tr":"panelist kişisi ile ilişkilidir","zh-Hans-CN":"有访谈嘉宾个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش."],"ca":["Relaciona una expressió amb una persona que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió."],"cs":["Vztahuje vyjádření k osobě, která je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí."],"da":["Relaterer et udtryk til en person, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden."],"en":["Relates an expression to a person who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion."],"es":["Relaciona una expresión con una persona que es un intérprete que contribuye a una expresión participando en un programa, muchas veces transmitido, donde se discuten temas, generalmente con la participación de expertos en campos relacionados con la discusión."],"et":["Seostab väljenduse isikuga, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad."],"fi":["Liittää ekspression henkilöön, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa."],"fr":["Met une expression en relation avec une personne interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion."],"hu":["Hozzákapcsol egy kifejezési formát egy egy előadó személyhez, aki egy programban, gyakran sugárzott műsorban, való részvételével, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével, hozzájárul egy kifejezési formához."],"lv":["Sasaista izteiksmi ar personu, kura ir izpildītājs, kura sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos."],"nl":["Relateert een expressie aan een persoon die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie."],"no":["Relaterer et uttrykk til en person som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere."],"tr":["Bir anlatımı, genellikle tartışma ile ilgili alanlarda uzmanların katılımıyla konuların tartışıldığı, sıklıkla yayınlanan bir programa katılarak bir anlatıma katkıda bulunan bir sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مشارك في برنامج","ca":"persona panelista","cs":"panelista (osoba)","da":"person, som er paneldeltager","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Person)","de":"Diskussionsteilnehmerin/Diskussionsteilnehmer (Person)","en":"panelist person","es":"persona panelista","et":"arutelust osavõtja (isik)","fi":"panelisti (henkilö)","fr":"personne panéliste","hu":"vitafórumtag személy:","lv":"diskusijas dalībnieks (persona)","nl":"panellid-persoon","no":"paneldeltaker (person)","tr":"Panel katılımcı kişi","zh-Hans-CN":"访谈嘉宾个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤديًا يساهم في تعبيرة من خلال المشاركة في برنامج، غالبا ما يجري بثه، وتُناقَش فيه موضوعات بمشاركة خبراء في المجالات المتعلقة بموضوع النقاش.","ca":"Persona que és un intèrpret que contribueix a una expressió participant en un programa, sovint emès, on es discuteixen temes, habitualment amb la participació d’experts en els camps relacionats amb la discussió.","cs":"Osoba, která je účinkujícím, který přispívá k vyjádření tím, že účinkuje v programu, často vysílání, v němž se diskutuje o různých tématech, obvykle s účastí odborníků z oborů souvisejících s diskusí.","da":"Person, som er en udøver, som bidrager til et udtryk ved at deltage i et program, ofte transmitteret, hvor emner diskuteres, normalt med deltagelse af fagfolk inden for felter relateret til diskussionen.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er an einer Veranstaltung (meist einer Sendung) teilnimmt, in der Themen üblicherweise mit Expertinnen/Experten diskutiert werden.","en":"A person who is a performer who contributes to an expression by participating in a program, often broadcast, where topics are discussed, usually with participation of experts in fields related to the discussion.","es":"Una persona que es un intérprete que contribuye a una expresión participando en un programa, muchas veces transmitido, donde se discuten temas, generalmente con la participación de expertos en campos relacionados con la discusión.","et":"Isik, kes esitajana annab panuse väljendusse, osaledes saates (sageli ringhäälingus), kus arutatakse mingeid teemasid ja kus tavaliselt osalevad arutatava teemavaldkonna asjatundjad.","fi":"Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen osallistumalla (usein lähetettyyn) ohjelmaan, jossa keskustellaan eri aiheista tavallisesti keskusteluun liittyvien aiheiden asiantuntijoiden kanssa.","fr":"Personne interprète qui contribue à une expression en participant à une activité, souvent diffusée à la radio, à la télévision, etc., où des sujets sont discutés, habituellement avec la participation d’experts dans les domaines reliés à la discussion.","hu":"Egy előadó személy, aki egy programban, gyakran sugárzott műsorban, való részvételével, ahol témákat vitatnak meg, rendszerint a beszélgetés témájában jártas szakértők részvételével, hozzájárul egy kifejezési formához.","lv":"Persona - izpildītājs, kura sniegusi ieguldījumu izteiksmē, piedaloties programmā, piemēram, radiopārraidē, kurā tiek apspriesti temati ar ekspertu piedalīšanos.","nl":"Een persoon die een uitvoerder is die bijdraagt aan een expressie door deel te nemen aan een programma, vaak uitgezonden, waar onderwerpen worden bediscussieerd, vaak met deelname van experts op gebieden gerelateerd aan de discussie.","no":"En person som er en utøver som bidrar til et uttrykk ved å delta i et program, gjerne kringkastet, der emner diskuteres, som regel med eksperter innen områder knyttet til diskusjonen, som deltakere.","tr":"Genellikle konuların tartışıldığı, tartışmayla ilgili alanlarda uzmanların katılımıyla yayınlanan bir programa katılarak anlatıma katkıda bulunan sanatçı olan kişi.","zh-Hans-CN":"作为一个表演者通过参与节目（经常是广播节目，其中讨论话题，通常有讨论相关领域专家参与）对一种内容表达有贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/panelistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20351", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en", "label":"has performer person"},{"@id":"http://rdaregistry.info/Elements/e/P20019", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistAgent.en", "label":"has panelist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20375", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/panelistPerson.en", "label":"has panelist person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20375", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/panelistPerson.en", "label":"has panelist person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20145","label":{"ar":"لها جزء تعبيرة","ca":"té com a expressió de part","cs":"má část (vyjádření)","da":"har deludtryk","de":"hat Teil (Expression)","de":"hat Teil (Expression)","el":"είναι περιέκτης της (έκφραση)","en":"has part expression","es":"tiene expresión parcial","et":"väljenduse osa","fi":"ekspression osa","fr":"a pour partie d’expression","hu":"rész-kifejezési formája a következő:","lv":"izteiksme: daļa","nl":"heeft deel-expressie","no":"har del av uttrykk","tr":"anlatım bileşeni ile ilişkilidir","vi":"là vỏ chứa của (biểu hiện)","zh-Hans-CN":"有部分内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة عبارة عن عنصر منفصل لتعبيرة أخرى."],"ca":["Relaciona una expressió amb una expressió que és un component discret d’una altra expressió."],"cs":["Vztahuje vyjádření k vyjádření, které je samostatnou částí jiného vyjádření."],"da":["Relaterer et udtryk til et udtryk, som er en adskilt komponent af et andet udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression, die ein eigenständiger Bestandteil einer anderen Expression ist.,Setzt eine Expression in Beziehung zu einer Expression, die ein eigenständiger Bestandteil einer anderen Expression ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συνιστά διακριτό συστατικό μιας μεγαλύτερης έκφρασης."],"en":["Relates an expression to an expression that is a discrete component of another expression."],"es":["Relaciona una expresión con una expresión que es un componente discreto de otra expresión."],"et":["Seostab väljenduse teose väljendusega, mis on teise väljenduse iseseisev koostisosa."],"fi":["Liittää ekspression ekspressioon, joka on itsenäinen osa toista ekspressiota."],"fr":["Met une expression en relation avec une expression qui constitue une composante distincte d’une autre expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amely egy másik kifejezési forma elkülöníthető alkotóeleme."],"lv":["Sasaista izteiksmi ar izteiksmi, kas ir atsevišķa lielākas izteiksmes sastāvdaļa."],"nl":["Relateert een expressie aan een expressie die een afzonderlijk onderdeel is van een andere expressie."],"no":["Relaterer et uttrykk til et uttrykk som er en avgrenset bestanddel av et annet uttrykk."],"tr":["Bir anlatımı, başka bir anlatımın ayrık bileşeni olan bir anlatımla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm là bộ phận cấu thành tách biệt của biểu hiện lớn hơn."],"zh-Hans-CN":["将一种内容表达与作为另一种内容表达之独立组成部分的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"جزء تعبيرة","ca":"expressió de part","cs":"část (vyjádření)","da":"deludtryk","de":"Teil (Expression)","de":"Teil (Expression)","el":"περιέκτης της (έκφραση)","en":"part expression","es":"expresión parcial","et":"väljenduse osa","fi":"ekspression osa","fr":"partie d’expression","hu":"rész-kifejezési formája:","lv":"izteiksme: daļa","nl":"deel-expressie","no":"del av uttrykk","tr":"bölüm anlatımı","vi":"vỏ chứa của (biểu hiện)","zh-Hans-CN":"部分内容表达"},"ToolkitDefinition":{"ar":"تعبيرة عبارة عن عنصر منفصل لتعبيرة أخرى.","ca":"Expressió que és un component discret d’una altra expressió.","cs":"Vyjádření, které je samostatnou částí jiného vyjádření.","da":"Udtryk af et værk, som er en adskilt komponent af et andet udtryk.","de":"Eine Expression, die ein eigenständiger Bestandteil einer anderen Expression ist.","de":"Eine Expression, die ein eigenständiger Bestandteil einer anderen Expression ist.","el":"Μια έκφραση ενός έργου το οποίο συνιστά διακριτό συστατικό μιας μεγαλύτερης έκφρασης.","en":"An expression that is a discrete component of another expression.","es":"Una expresión que es un componente discreto de otra expresión.","et":"Teose väljendus, mis on teise väljenduse iseseisev koostisosa.","fi":"Ekspressio, joka on itsenäinen osa toista ekspressiota.","fr":"Expression qui constitue une composante distincte d’une autre expression.","hu":"Egy kifejezési forma, amely egy másik kifejezési forma elkülöníthető alkotóeleme.","lv":"Izteiksme, kas ir atsevišķa lielākas izteiksmes sastāvdaļa.","nl":"Een expressie die een afzonderlijk onderdeel is van een andere expressie.","no":"Et uttrykk som er en avgrenset bestanddel av et annet uttrykk.","tr":"Başka bir anlatımın ayrı bir bileşeni olan bir anlatım.","vi":"Biểu hiện của tác phẩm là bộ phận cấu thành tách biệt của biểu hiện lớn hơn.","zh-Hans-CN":"作为另一种内容表达之独立组成部分的一种内容表达"},"altLabel":{"ar":["متضمنة لـ (تعبيرة)"],"ca":["contenidor de (expressió)"],"da":["container af (udtryk)"],"de":["Enthält (Expression),Enthalten in (Expression)"],"en":["container of (expression)"],"es":["contenedor de (expresión)"],"et":["sisaldab väljendust"],"fi":["sisältää (ekspressio)"],"fr":["conteneur de (expression)"],"hu":["tartalmazza a következő kifejezési formát:"],"nl":["houder van (expressie)"],"no":["inneholder uttrykk"],"tr":["(anlatım) kapsayıcısı"],"zh-Hans-CN":["……的容纳（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/partExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20145", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/partExpression.en", "label":"has part expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20145", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/partExpression.en", "label":"has part expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20074","label":{"ar":"هي جزء من تعبيرة","ca":"és part d’una expressió","cs":"je částí vyjádření","da":"er del af udtryk","de":"ist Teil von (Expression)","de":"ist Teil von (Expression)","el":"περιέχεται σε (έκφραση)","en":"is part of expression","es":"es parte de la expresión","et":"osa väljendusest","fi":"osa ekspressiota","fr":"est une partie d’expression de","hu":"része a következő kifejezési formának:","lv":"ir daļa izteiksmē","nl":"is deel van expressie","no":"er del av uttrykk","tr":"anlatımın bir bileşenidir","vi":"được chứa trong (biểu hiện)","zh-Hans-CN":"是内容表达的部分"},"definition":{"ar":["تربط تعبيرة بتعبيرة لها تعبيرة أخرى كجزء منفصل."],"ca":["Relaciona una expressió amb una expressió que té una altra expressió com a component discret."],"cs":["Vztahuje vyjádření k vyjádření, které obsahuje jiné vyjádření jako samostatnou část."],"da":["Relaterer et udtryk til et udtryk, som har et andet udtryk som en adskilt komponent."],"de":["Setzt eine Expression in Beziehung zu einer Expression, die eine andere Expression als eigenständigen Bestandteil enthält.,Setzt eine Expression in Beziehung zu einer Expression, die eine andere Expression als eigenständigen Bestandteil enthält."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μεγαλύτερου έργου του οποίου η έκφραση συνιστά ένα διακριτό συστατικό."],"en":["Relates an expression to an expression that has another expression as a discrete component."],"es":["Relaciona una expresión con una expresión que tiene otra expresión como componente discreto."],"et":["Seostab väljenduse väljendusega, millesse kuulub iseseisva koostisosana teine väljendus."],"fi":["Liittää ekspression ekspressioon, jolla on toinen ekspressio erillisenä osana."],"fr":["Met une expression en relation avec une expression qui a pour composante distincte une autre expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amelynek elkülöníthető alkotóelemként része egy másik kifejezési forma."],"lv":["Sasaista izteiksmi ar izteiksmi, kam ir cita izteiksme ka atsevišķa sastāvdaļa."],"nl":["Relateert een expressie aan een expressie die een andere expressie als afzonderlijk onderdeel heeft."],"no":["Relaterer et uttrykk til et uttrykk som har et annet uttrykk som en avgrenset bestanddel."],"tr":["Bir anlatımı, ayrık bileşen olarak başka bir anlatıma sahip bir anlatımla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm lớn hơn mà biểu hiện được đề cập là bộ phận cấu thành riêng lẻ."],"zh-Hans-CN":["将一种内容表达与有另一种内容表达作为独立组成部分的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"جزء من تعبيرة","ca":"part d’una expressió","cs":"část vyjádření","da":"del af udtryk","de":"Teil von (Expression)","de":"Teil von (Expression)","el":"περιέχεται σε (έκφραση)","en":"part of expression","es":"parte de la expresión","et":"osa väljendusest","fi":"osa ekspressiota","fr":"partie d’expression de","hu":"kifejezési forma része:","lv":"daļa izteiksmē","nl":"deel van expressie","no":"del av uttrykk","tr":"anlatımın bölümü","vi":"được chứa trong (biểu hiện)","zh-Hans-CN":"内容表达的部分"},"ToolkitDefinition":{"ar":"تعبيرة لها تعبيرة أخرى كجزء منفصل.","ca":"Expressió que té una altra expressió com a component discret.","cs":"Vyjádření, které obsahuje jiné vyjádření jako samostatnou část.","da":"Udtryk, som har et andet udtryk som en adskilt komponent.","de":"Eine Expression, die eine andere Expression als eigenständigen Bestandteil enthält.","de":"Eine Expression, die eine andere Expression als eigenständigen Bestandteil enthält.","el":"Μια έκφραση ενός μεγαλύτερου έργου του οποίου η έκφραση συνιστά ένα διακριτό συστατικό.","en":"An expression that has another expression as a discrete component.","es":"Una expresión que tiene otra expresión como componente discreto.","et":"Väljendus, millesse kuulub iseseisva koostisosana teine väljendus.","fi":"Ekspressio, jolla on toinen ekspressio erillisenä osana.","fr":"Expression qui a pour composante distincte une autre expression.","hu":"Egy kifejezési forma, amelynek elkülöníthető alkotóelemként része egy másik kifejezési forma.","lv":"Izteiksme, kam ir cita izteiksme ka atsevišķa sastāvdaļa.","nl":"Een expressie die een andere expressie als afzonderlijk onderdeel heeft.","no":"Et uttrykk som har et annet uttrykk som en avgrenset bestanddel.","tr":"Ayrık bir bileşen olarak başka bir anlatıma sahip bir anlatım.","vi":"Biểu hiện của tác phẩm lớn hơn mà biểu hiện được đề cập là bộ phận cấu thành riêng lẻ.","zh-Hans-CN":"有另一种内容表达作为独立组成部分的一种内容表达"},"altLabel":{"ar":["متضمنة في (تعبيرة)"],"ca":["contingut en (expressió)"],"cs":["obsaženo v (vyjádření)"],"da":["indeholdt i (udtryk)"],"de":["Enthalten in (Expression),Enthalten in (Expression)"],"en":["contained in (expression)"],"es":["contenido en (expresión)"],"fi":["sisältyy ekspressioon"],"fr":["contenu dans (expression)"],"hu":["tartalmazza a következő (kifejezési forma):"],"nl":["opgenomen in (expressie)"],"no":["omfattes av uttrykk"],"tr":["içinde bulunan (anlatım)"],"zh-Hans-CN":["包含于（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/partOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20074", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/partOfExpression.en", "label":"is part of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20074", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/partOfExpression.en", "label":"is part of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20039","label":{"ar":"لها وكيل مؤدٍ","ca":"té com a agent intèrpret","cs":"má účinkujícího (agenta)","da":"har agent, som er udøver","de":"hat Ausführende/Ausführenden (Akteur)","de":"hat Ausführende/Ausführenden (Akteur)","el":"έχει εκτελεστή","en":"has performer agent","es":"tiene agente intérprete","et":"esitaja (tegija)","fi":"esittäjä (toimija)","fr":"a pour agent interprète","hu":"előadó ágense a következő:","lv":"izpildītājs (aģents)","nl":"heeft uitvoerder-actor","no":"har utøver (agent)","tr":"sanatçı temsi̇lci̇si̇ ile ilişkilidir","vi":"có người biểu diễn","zh-Hans-CN":"有表演者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale og andre roller, ofte i en musikalsk eller dramatisk præsentation."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της μουσικής ερμηνείας, της υποκριτικής, του χορού, της ομιλίας κ.λπ., συχνά σε μια μουσική ή δραματική παρουσίαση κ.λπ."],"en":["Relates an expression to an agent who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation."],"es":["Relaciona una expresión con un agente que contribuye a una expresión interpretando música, actuando, bailando, hablando y otros roles, a menudo en una presentación musical o dramática."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å fremføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling."],"tr":["Bir anlatımı, genellikle müzikal veya dramatik bir performansta müzik yaparak, oyunculuk yaparak, dans ederek, konuşarak veya başka bir rolle anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách biểu diễn âm nhạc, hành động, nhảy múa, nói, v.v..., thường là trong trình diễn âm nhạc hoặc kích, v.v..."],"zh-Hans-CN":["将一种内容表达与通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل فنان أداء","ca":"agent intèrpret","cs":"účinkující (agent)","da":"agent, som er udøver","de":"Ausführende/Ausführender (Akteur)","de":"Ausführende/Ausführender (Akteur)","el":"εκτελεστής","en":"performer agent","es":"agente intérprete","et":"esitaja (tegija)","fi":"esittäjä (toimija)","fr":"agent interprète","hu":"előadó ágens:","lv":"izpildītājs (aģents)","nl":"uitvoerder-actor","no":"utøver (agent)","tr":"sanatçı temsi̇lci̇si̇","vi":"người biểu diễn","zh-Hans-CN":"表演者行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي.","ca":"Agent que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica.","cs":"Agent, který přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení.","da":"Agent, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale og andre roller, ofte i en musikalsk eller dramatisk præsentation.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","el":"Ένας φορέας, ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της μουσικής ερμηνείας, της υποκριτικής, του χορού, της ομιλίας κ.λπ., συχνά σε μια μουσική ή δραματική παρουσίαση κ.λπ.","en":"An agent who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation.","es":"Un agente que contribuye a una expresión interpretando música, actuando, bailando, hablando y otros roles, a menudo en una presentación musical o dramática.","et":"Tegija, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms.","fi":"Toimija, joka osallistuu teoksen ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla tai muissa rooleissa usein musiikki- tai näytelmäesityksessä.","fr":"Agent qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique.","hu":"Egy ágens, amely zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml.","nl":"Een actor die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie.","no":"En agent som bidrar til et uttrykk ved å fremføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling.","tr":"Genellikle müzikal veya dramatik bir sunumda müzik, oyunculuk, dans, konuşma ve diğer rolleri yerine getirerek bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách biểu diễn âm nhạc, hành động, nhảy múa, nói, v.v..., thường là trong trình diễn âm nhạc hoặc kích, v.v...","zh-Hans-CN":"通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个行为者"},"altLabel":{"ar":["فنان أداء"],"ca":["intèrpret"],"cs":["účinkující"],"da":["udøver"],"de":["Ausführende/Ausführender,Ausführende/Ausführender"],"en":["performer"],"es":["intérprete"],"et":["esitaja"],"fi":["esittäjä"],"fr":["interprète"],"hu":["előadó:"],"nl":["uitvoerder"],"no":["utøver"],"tr":["sanatçı"],"zh-Hans-CN":["表演者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20329", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToPerformance.en", "label":"has contributor agent to performance"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20012", "lexicalAlias":"http://rdaregistry.info/Elements/e/actorAgent.en", "label":"has actor agent"},{"@id":"http://rdaregistry.info/Elements/e/P20021", "lexicalAlias":"http://rdaregistry.info/Elements/e/commentatorAgent.en", "label":"has commentator agent"},{"@id":"http://rdaregistry.info/Elements/e/P20011", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorAgent.en", "label":"has conductor agent"},{"@id":"http://rdaregistry.info/Elements/e/P20014", "lexicalAlias":"http://rdaregistry.info/Elements/e/dancerAgent.en", "label":"has dancer agent"},{"@id":"http://rdaregistry.info/Elements/e/P20016", "lexicalAlias":"http://rdaregistry.info/Elements/e/hostAgent.en", "label":"has host agent"},{"@id":"http://rdaregistry.info/Elements/e/P20015", "lexicalAlias":"http://rdaregistry.info/Elements/e/instructorAgent.en", "label":"has instructor agent"},{"@id":"http://rdaregistry.info/Elements/e/P20020", "lexicalAlias":"http://rdaregistry.info/Elements/e/instrumentalistAgent.en", "label":"has instrumentalist agent"},{"@id":"http://rdaregistry.info/Elements/e/P20017", "lexicalAlias":"http://rdaregistry.info/Elements/e/moderatorAgent.en", "label":"has moderator agent"},{"@id":"http://rdaregistry.info/Elements/e/P20022", "lexicalAlias":"http://rdaregistry.info/Elements/e/narratorAgent.en", "label":"has narrator agent"},{"@id":"http://rdaregistry.info/Elements/e/P20013", "lexicalAlias":"http://rdaregistry.info/Elements/e/onscreenPresenterAgent.en", "label":"has onscreen presenter agent"},{"@id":"http://rdaregistry.info/Elements/e/P20019", "lexicalAlias":"http://rdaregistry.info/Elements/e/panelistAgent.en", "label":"has panelist agent"},{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20351", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en", "label":"has performer person"},{"@id":"http://rdaregistry.info/Elements/e/P20054", "lexicalAlias":"http://rdaregistry.info/Elements/e/presenterAgent.en", "label":"has presenter agent"},{"@id":"http://rdaregistry.info/Elements/e/P20018", "lexicalAlias":"http://rdaregistry.info/Elements/e/puppeteerAgent.en", "label":"has puppeteer agent"},{"@id":"http://rdaregistry.info/Elements/e/P20025", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerAgent.en", "label":"has singer agent"},{"@id":"http://rdaregistry.info/Elements/e/P20024", "lexicalAlias":"http://rdaregistry.info/Elements/e/speakerAgent.en", "label":"has speaker agent"},{"@id":"http://rdaregistry.info/Elements/e/P20023", "lexicalAlias":"http://rdaregistry.info/Elements/e/storytellerAgent.en", "label":"has storyteller agent"},{"@id":"http://rdaregistry.info/Elements/e/object/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/performerAgent.en", "label":"has performer agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/performerAgent.en", "label":"has performer agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20410","label":{"ar":"لها وكيل جماعي فنان أداء","ca":"té com a agent col·lectiu intèrpret","cs":"má účinkujícího (kolektivního agenta)","da":"har kollektiv agent, som er udøver","de":"hat Ausführende/Ausführenden (Gemeinschaftlicher Akteur)","de":"hat Ausführende/Ausführenden (Gemeinschaftlicher Akteur)","en":"has performer collective agent","es":"tiene agente colectivo intérprete","et":"esitaja (kollektiiv)","fi":"esittäjä (yhteistoimija)","fr":"a pour agent collectif interprète","hu":"előadó kollektív ágense a következő:","lv":"izpildītājs (grupa)","nl":"heeft uitvoerder-collectieve actor","no":"har utøver (kollektiv agent)","tr":"sanatçı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有表演者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي."],"ca":["Relaciona una expressió amb un agent col·lectiu que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení."],"da":["Relaterer et udtryk til en kollektiv agent, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale etc., ofte i en musikalsk eller dramatisk præsentation etc."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt."],"en":["Relates an expression to a collective agent who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation."],"es":["Relaciona una expresión con un agente colectivo que contribuye a una expresión al interpretar música, una actuación, un baile, discurso, etc."],"et":["Seostab väljenduse kollektiiviga, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms."],"fi":["Liittää ekspression yhteistoimijaan, joka osallistuu ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla tai muissa rooleissa usein musiikki- tai näytelmäesityksessä."],"fr":["Met une expression en relation avec un agent collectif qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban."],"lv":["Sasaista izteiksmi ar grupu, kas sniegusi ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml."],"nl":["Relateert een expressie aan een collectieve actor die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie."],"no":["Relaterer et uttrykk til en kollektiv agent som bidrar til et uttrykk ved å fremføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling."],"tr":["Bir anlatımı, genellikle müzikal veya dramatik bir performansta müzik yaparak, oyunculuk yaparak, dans ederek, konuşarak veya başka bir rolle anlatıma katkıda bulunan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فنان أداء","ca":"agent col·lectiu intèrpret","cs":"účinkující (kolektivní agent)","da":"kollektiv agent, som er udøver","de":"Ausführende/Ausführender (Gemeinschaftlicher Akteur)","de":"Ausführende/Ausführender (Gemeinschaftlicher Akteur)","en":"performer collective agent","es":"agente colectivo intérprete","et":"esitaja (kollektiiv)","fi":"esittäjä (yhteistoimija)","fr":"agent collectif interprète","hu":"előadó kollektív ágens:","lv":"izpildītājs (grupa)","nl":"uitvoerder-collectieve actor","no":"utøver (kollektiv agent)","tr":"sanatçı kolektif temsilci","zh-Hans-CN":"表演者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يساهم في تعبيرة من خلال أداء موسيقى، وتمثيل، ورقص، وحوار، وأدوار أخرى، غالبا في عرض موسيقي أو درامي.","ca":"Agent col·lectiu que contribueix a una expressió amb l’execució de música, actuant, dansant, parlant i amb altres papers, sovint en una representació musical o dramàtica.","cs":"Kolektivní agent, který přispívá k vyjádření tím, že účinkuje v hudebních, hereckých, tanečních, řečnických a dalších rolích, často jako součást hudebního nebo dramatického představení.","da":"Kollektiv agent, som bidrager til et udtryk ved at opføre musik, spille skuespil, danse, tale etc., ofte i en musikalsk eller dramatisk præsentation etc.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er, oftmals in einer musikalischen oder dramatischen Darbietung, Musik aufführt, schauspielt, tanzt, spricht oder eine andere Rolle übernimmt.","en":"A collective agent who contributes to an expression by performing music, acting, dancing, speaking, and other roles, often in a musical or dramatic presentation.","es":"Un agente colectivo que contribuye a una expresión al interpretar música, una actuación, un baile, discurso, etc.","et":"Kollektiiv, kes annab panuse väljendusse, esitades muusikat, näideldes, tantsides, kõneldes vms, sageli muusika- või draamaetenduses vms.","fi":"Yhteistoimija, joka osallistuu teoksen ekspression tekemiseen esittämällä musiikkia, näyttelemällä, tanssimalla, puhumalla ja muissa rooleissa usein musiikki- tai näytelmäesityksessä.","fr":"Agent collectif qui contribue à une expression en exécutant de la musique, en jouant, en dansant, en parlant et en assumant d’autres rôles, souvent dans une présentation musicale ou dramatique.","hu":"Egy kollektív ágens, amely zene, színjátszás, tánc, élőbeszéd stb. előadásával járul hozzá egy kifejezési formához, többnyire zenei vagy drámai bemutatóban.","lv":"Grupa, kas sniegusi ieguldījumu izteiksmē, izpildot mūziku, tēlojot, dejojot, runājot, u.tml, bieži mūzikas vai dramatiskā uzvedumā u.tml.","nl":"Een collectieve actor die bijdraagt aan een expressie door het uitvoeren van muziek, acteren, dansen, spreken en andere rollen, vaak in een muziek- of dramapresentatie.","no":"En kollektiv agent som bidrar til et uttrykk ved å fremføre musikk, skuespill, dans, tale, etc., ofte i en musikalsk eller dramatisk forestilling.","tr":"Genellikle müzikal veya dramatik bir sunumda müzik, oyunculuk, dans, konuşma ve diğer rollerde yer alarak bir ifadeye katkıda bulunan kolektif bir temsilci.","zh-Hans-CN":"通过表演音乐、扮演、舞蹈、说话和其他角色（经常是在音乐或戏剧呈现中）而对一种内容表达有贡献的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
