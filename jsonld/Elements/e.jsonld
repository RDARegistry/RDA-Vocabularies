                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/dubbingDirectorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20543", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToPerformance.en", "label":"has contributor family to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20452", "lexicalAlias":"http://rdaregistry.info/Elements/e/dubbingDirectorCollectiveAgent.en", "label":"has dubbing director collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20570", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dubbingDirectorFamily.en", "label":"has dubbing director family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20570", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dubbingDirectorFamily.en", "label":"has dubbing director family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20393","label":{"ar":"لها شخص مدير دبلجة","ca":"té com a persona directora de doblatge","cs":"má dabingového režiséra (osobu)","da":"har person, som er dubbinginstruktør","de":"hat Synchronregisseurin/Synchronregisseur (Person)","de":"hat Synchronregisseurin/Synchronregisseur (Person)","en":"has dubbing director person","es":"tiene persona directora de doblaje","et":"dublaaži režissöör (isik)","fi":"dubbausohjaaja (henkilö)","fr":"a pour personne directrice de doublage","hu":"szinkronrendező személye a következő:","lv":"dublāžas režisors (persona)","nl":"heeft stemregisseur-persoon","no":"har stemmeregissør (person)","tr":"dublaj yönetmeni kişisi ile ilişkilidir","zh-Hans-CN":"有混声导演个人"},"definition":{"ar":["تربط بين تعبيرة وشخص مسؤول عن الإدارة العامة والإشراف على عملية إضافة حوار جديد أو أصوات أخرى لإكمال مقطع صوتي لتعبيرة."],"ca":["Relaciona una expressió amb una persona que és responsable de la gestió i la supervisió general del procés d’afegir nou diàleg o altres sons per completar la banda sonora d’una expressió."],"cs":["Vztahuje vyjádření k osobě, která je odpovědná za obecné řízení a dohled nad procesem přidání nového dialogu nebo jiných zvuků, které doplňují zvukovou stopu vyjádření."],"da":["Relaterer et udtryk til en person, som er ansvarlig for den generelle ledelse af- og tilsyn med processen at tilføje ny dialog eller andre lyde for at fuldstændiggøre et udtryks soundtrack."],"de":["Setzt eine Expression in Beziehung zu einer Person, die für das allgemeine Management und die Leitung beim Hinzufügen von neuem Dialog oder anderen Geräuschen verantwortlich ist, um die Tonspur einer Expression zu vervollständigen.,Setzt eine Expression in Beziehung zu einer Person, die für das allgemeine Management und die Leitung beim Hinzufügen von neuem Dialog oder anderen Geräuschen verantwortlich ist, um die Tonspur einer Expression zu vervollständigen."],"en":["Relates an expression to a person who is responsible for the general management and supervision of the process of adding new dialogue or other sounds to complete a soundtrack for an expression."],"es":["Relaciona una expresión con una persona que es responsable de la gestión y supervisión general del proceso de añadir nuevo diálogo u otros sonidos para completar un soundtrack para una expresión."],"et":["Seostab väljenduse isikuga, kes vastutab väljenduse heliriba täiendamisel uue dialoogi või muude helide lisamise üldise juhtimise ja juhendamise eest."],"fi":["Liittää ekspression henkilöön, joka vastaa uuden dialogin tai muiden äänien lisäämisprosessin yleisestä johtamisesta ja valvonnasta ekspression ääniraidan täydentämiseksi."],"fr":["Met une expression en relation avec une personne qui est responsable de la gestion et de la supervision générales du processus consistant à ajouter de nouveaux dialogues ou d’autres sons pour compléter la piste sonore d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki felelős annak a folyamatnak az általános irányításáért és felügyeletéért, amelyben új dialógust vagy egyéb hangokat adnak hozzá egy kifejezési formához a hangsávja befejezése, teljessé tétele céljából."],"lv":["Sasaista izteiksmi ar personu, kura ir atbildīga par vispārējo vadību un uzraudzību jaunu dialogu vai citu skaņu pievienošanai pabeigtam izteiksmes skaņu celiņam."],"nl":["Relateert een expressie aan een persoon die verantwoordelijk is voor het algemeen beheer en toezicht van het proces van toevoegen van nieuwe dialoog of andere geluiden om een geluidsspoor voor een expressie te completeren."],"no":["Relaterer et uttrykk til en person som har ansvar for generell ledelse av prosessen med å legge til ny dialog eller andre lyder for å fullføre lydsporet til et uttrykk."],"tr":["Bir anlatımı, bir anlatımın film müziğini tamamlamak için yeni diyalog veya diğer seslerin eklenmesi sürecinin genel yönetimi ve denetiminden sorumlu olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对一种内容表达增加对话或其他声音以完成音轨的过程总体管理和监督负责的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مدير دبلجة","ca":"persona directora de doblatge","cs":"dabingový režisér (osoba)","da":"person, som er dubbinginstruktør","de":"Synchronregisseurin/Synchronregisseur (Person)","de":"Synchronregisseurin/Synchronregisseur (Person)","en":"dubbing director person","es":"persona directora de doblaje","et":"dublaaži režissöör (isik)","fi":"dubbausohjaaja (henkilö)","fr":"personne directrice de doublage","hu":"szinkronrendező személy:","lv":"dublāžas režisors (persona)","nl":"stemregisseur-persoon","no":"stemmeregissør (person)","tr":"dublaj yönetmeni","zh-Hans-CN":"混声导演个人"},"ToolkitDefinition":{"ar":"شخص مسؤول عن الإدارة العامة والإشراف على عملية إضافة حوار جديد أو أصوات أخرى لإكمال مقطع صوتي لتعبيرة.","ca":"Persona que és responsable de la gestió i la supervisió general del procés d’afegir nou diàleg o altres sons per completar la banda sonora d’una expressió.","cs":"Osoba, která je odpovědná za obecné řízení a dohled nad procesem přidání nového dialogu nebo jiných zvuků, které doplňují zvukovou stopu vyjádření.","da":"Person, som er ansvarlig for den generelle ledelse af- og tilsyn med processen at tilføje ny dialog eller andre lyde for at fuldstændiggøre et udtryks soundtrack.","de":"Eine Person, die für das allgemeine Management und die Leitung beim Hinzufügen von neuem Dialog oder anderen Geräuschen verantwortlich ist, um die Tonspur einer Expression zu vervollständigen.","de":"Eine Person, die für das allgemeine Management und die Leitung beim Hinzufügen von neuem Dialog oder anderen Geräuschen verantwortlich ist, um die Tonspur einer Expression zu vervollständigen.","en":"A person who is responsible for the general management and supervision of the process of adding new dialogue or other sounds to complete a soundtrack for an expression.","es":"Una persona que es responsable de la gestión y supervisión general del proceso de añadir nuevo diálogo u otros sonidos para completar un soundtrack para una expresión.","et":"Isik, kes vastutab väljenduse heliriba täiendamisel uue dialoogi või muude helide lisamise üldise juhtimise ja juhendamise eest.","fi":"Henkilö, joka vastaa uuden dialogin tai muiden äänien lisäämisprosessin yleisestä johtamisesta ja valvonnasta ekspression ääniraidan täydentämiseksi.","fr":"Personne qui est responsable de la gestion et de la supervision générales du processus consistant à ajouter de nouveaux dialogues ou d’autres sons pour compléter la piste sonore d’une expression.","hu":"Egy személy, aki felelős annak a folyamatnak az általános irányításáért és felügyeletéért, amelyben új dialógust vagy egyéb hangokat adnak hozzá egy kifejezési formához a hangsávja befejezése, teljessé tétele céljából.","lv":"Persona, kura ir atbildīga par vispārējo vadību un uzraudzību jaunu dialogu vai citu skaņu pievienošanai pabeigtam izteiksmes skaņu celiņam.","nl":"Een persoon die verantwoordelijk is voor het algemeen beheer en toezicht van het proces van toevoegen van nieuwe dialoog of andere geluiden om een geluidsspoor voor een expressie te completeren.","no":"En person som har ansvar for generell ledelse av prosessen med å legge til ny dialog eller andre lyder for å fullføre lydsporet til et uttrykk.","tr":"Bir anlatımın film müziğini tamamlamak için yeni diyalog veya başka sesler ekleme sürecinin genel yönetiminden ve denetiminden sorumlu olan kişi","zh-Hans-CN":"对一种内容表达增加对话或其他声音以完成音轨的过程总体管理和监督负责的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/dubbingDirectorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20295", "lexicalAlias":"http://rdaregistry.info/Elements/e/dubbingDirectorAgent.en", "label":"has dubbing director agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20393", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dubbingDirectorPerson.en", "label":"has dubbing director person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20393", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dubbingDirectorPerson.en", "label":"has dubbing director person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20330","label":{"ar":"لها وكيل محرر","ca":"té com a agent editor literari","cs":"má editora (agenta)","da":"har agent, som er redaktør til tekst","de":"hat Herausgeberin/Herausgeber (Akteur)","de":"hat Herausgeberin/Herausgeber (Akteur)","en":"has editor agent","es":"tiene agente editor","et":"tekstitoimetaja (tegija)","fi":"toimittaja (toimija)","fr":"a pour agent éditeur intellectuel","hu":"szerkesztő ágense a következő:","lv":"redaktors (aģents)","nl":"heeft redacteur-actor","no":"har redaktør av tekst (agent)","tr":"editör temsilcisi ile ilişkilidir","zh-Hans-CN":"有编者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen."],"en":["Relates an expression to an agent who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use."],"es":["Relaciona una expresión con un agente que contribuye a una expresión modificando el contenido creado por otros agentes para cumplir con los estándares de publicación u otro uso."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publiceren of ander gebruik."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil."],"tr":["Bir anlatımı, yayın veya başka bir kullanım için standartları karşılamak amacıyla diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkıda bulunan bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل محرر","ca":"editor literari","cs":"editor (agent)","da":"agent, som er redaktør til tekst","de":"Herausgeberin/Herausgeber (Akteur)","de":"Herausgeberin/Herausgeber (Akteur)","en":"editor agent","es":"agente editor","et":"tekstitoimetaja (tegija)","fi":"toimittaja (toimija)","fr":"agent éditeur intellectuel","hu":"szerkesztő ágens:","lv":"redaktors (aģents)","nl":"redacteur-actor","no":"redaktør av tekst (agent)","tr":"editör temsilci","zh-Hans-CN":"编者行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر.","ca":"Agent que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús.","cs":"Agent, který přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely.","da":"Agent, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","en":"An agent who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use.","es":"Un agente que contribuye a una expresión modificando el contenido creado por otros agentes para cumplir con los estándares de publicación u otro uso.","et":"Tegija, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele.","fi":"Toimija, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi.","fr":"Agent qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation.","hu":"Egy ágens, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem.","nl":"Een actor die bijdraagt aan een expressie door het aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publiceren of ander gebruik.","no":"En agent som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil.","tr":"Yayın veya başka bir kullanım için standartları karşılamak amacıyla diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkıda bulunan bir temsilci.","zh-Hans-CN":"通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个行为者"},"altLabel":{"ar":["وكيل محرر لنص"],"ca":[","],"cs":["editor,editor (agent) textu"],"da":["agent, som er redaktør til tekst"],"de":["Herausgeber,Herausgeberin/Herausgeber eines Texts (Akteur)"],"en":["editor,editor agent of text"],"es":["editor,agente editor de texto"],"et":["toimetaja,keeletoimetaja"],"fi":[","],"fr":["éditeur intellectuel,agent éditeur intellectuel de texte"],"hu":[","],"nl":["redacteur,redacteur-actor van tekst"],"no":["redaktør"],"tr":["editör,metnin editör temsilcisi"],"zh-Hans-CN":["编者,文本的编者行为者"],"zh-Hant-TW":[","]},"note":{"ar":["محتوى يتضمن حركات مدونة، وموسيقى مدونة، وحركة مدونة بصورة ملموسة، وموسيقى مدونة بصورة ملموسة، ونص ملموس، ونص."],"ca":["El contingut inclou moviment notat, música notada, moviment notat tàctil, música notada tàctil, text tàctil i text."],"cs":["Obsah zahrnuje zápis pohybu, zápis hudby, taktilní zápis pohybu, taktilní zápis hudby, taktilní text a text."],"da":["Indhold omfatter noteret beværelse, noteret musik, taktil noteret bevægelse, taktil noteret musik, taktil tekst og tekst."],"de":["Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text.,Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text."],"en":["Content includes notated movement, notated music, tactile notated movement, tactile notated music, tactile text, and text."],"es":["El contenido incluye movimiento anotado, música anotada, movimiento táctil anotado, música táctil anotada, texto táctil y texto."],"fi":["Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti."],"fr":["Le contenu comprend le mouvement noté, le mouvement noté tactile, la musique notée, la musique notée tactile, le texte et le texte tactile."],"hu":["A tartalom mozgásírás, zenei lejegyzés, tapintható mozgásírás, tapintható zenei lejegyzés, tapintható szöveg és szöveg lehet."],"lv":["Saturs ir: teksts, kustību pieraksts, notācija, taktils kustības pieraksts, taktila notācija, taktils teksts."],"nl":["Content omvat bewegingsnotatie, muzieknotatie, tactiele bewegingsnotatie, tactiele muzieknotatie, tactiele tekst en tekst."],"tr":["İçerik; notalı hareket, notalı müzik, dokunsal notalı hareket, dokunsal notalı müzik, dokunsal metin ve metin içerir."],"zh-Hans-CN":["内容包括动作谱、乐谱、触摸动作谱、触摸乐谱、触摸文本、以及文本"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20328", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToAmalgamation.en", "label":"has contributor agent to amalgamation"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20397", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgent.en", "label":"has editor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20338", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorPerson.en", "label":"has editor person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20330", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorAgent.en", "label":"has editor agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20330", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorAgent.en", "label":"has editor agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20055","label":{"ar":"لها وكيل محرر لعمل صور متحركة","ca":"té com a agent editor d’una obra d’imatge en moviment","cs":"má editora (agenta) pohyblivého obrazu (díla)","da":"har agent, som er klipper","de":"hat Filmeditorin/Filmeditor (Akteur)","de":"hat Filmeditorin/Filmeditor (Akteur)","el":"έχει επιμελητή έργου κινητής εικόνας","en":"has editor agent of moving image work","es":"tiene agente editor de trabajos de imágenes en movimiento.","et":"filmiteose monteerija (tegija)","fi":"leikkaaja (toimija)","fr":"a pour agent monteur d’une œuvre d’images animées","hu":"mozgóképművágó ágense a következő:","lv":"filmas montāžas redaktors (aģents)","nl":"heeft filmeditor-actor van bewegend beeldwerk","no":"har redigerer av verk i form av levende bilder (agent)","tr":"hareketli görüntü çalışmasının editör temsilcisi ile ilişkilidir","vi":"có người biên tập tác phẩm hình Ảnh động","zh-Hans-CN":"有动态图像作品的剪辑师行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مسئولا عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة."],"ca":["Relaciona una expressió amb un agent que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio."],"cs":["Vztahuje vyjádření k agentovi, který je odpovědný za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů."],"da":["Relaterer et udtryk til en agent, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.,Setzt eine Expression in Beziehung zu einem Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften."],"el":["Συνδέει μια έκφραση με έναν φορέα υπεύθυνο για τη συλλογή, την οργάνωση και προετοιμασία του φιλμ, του βίντεο ή άλλων μορφότυπων κινητής εικόνας, συμπεριλαμβανομένων των οπτικών και ακουστικών πτυχών."],"en":["Relates an expression to an agent who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects."],"es":["Relaciona una expresión con un agente que es responsable de ensamblar, organizar y recortar películas, videos u otros formatos de imágenes en movimiento, incluidos los aspectos visuales y de audio."],"et":["Seostab väljenduse tegijaga, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte."],"fi":["Liittää ekspression toimijaan, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta."],"fr":["Met une expression en relation avec un agent qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat."],"lv":["Sasaista izteiksmi ar aģentu, kas ir atbildīgs par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus."],"nl":["Relateert een expressie aan een actor die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten."],"no":["Relaterer et uttrykk til en agent som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter."],"tr":["Bir anlatımı, hem görsel hem işitsel yönlerini içeren, film, video veya diğer hareketli görüntü formatlarının montajı, düzenlemesi ve kırpılmasından sorumlu olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân có trách nhiệm về tập hợp, sắp đặt, tô điểm cho phim, video, hoặc định dạng hình ảnh động khác, bao gồm cả hai khía canh thị giác và audio."],"zh-Hans-CN":["将一种内容表达与对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل محرر لعمل صور متحركة","ca":"agent editor d’una obra d’imatge en moviment","cs":"editor (agent) pohyblivého obrazu (díla)","da":"agent, som er klipper","de":"Filmeditorin/Filmeditor (Akteur)","de":"Filmeditorin/Filmeditor (Akteur)","el":"επιμελητής έργου κινητής εικόνας","en":"editor agent of moving image work","es":"agente editor de trabajos de imágenes en movimiento.","et":"filmiteose monteerija (tegija)","fi":"leikkaaja (toimija)","fr":"agent monteur d’une œuvre d’images animées","hu":"mozgóképművágó ágens:","lv":"filmas montāžas redaktors (aģents)","nl":"filmeditor-actor van bewegend beeldwerk","no":"redigerer av verk i form av levende bilder (agent)","tr":"hareketli görüntü eserinin editör temsilcisi","vi":"người hiệu đính tác phẩm hình Ảnh động","zh-Hans-CN":"动态图像作品的剪辑师行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مسئولا عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة.","ca":"Agent que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio.","cs":"Agent, který je odpovědný za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů.","da":"Agent, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter.","de":"Ein Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Darunter fallen Video- und Audio-Eigenschaften.","de":"Ein Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Darunter fallen Video- und Audio-Eigenschaften.","el":"Ένας φορέας υπεύθυνος για τη συλλογή, την οργάνωση και προετοιμασία του φιλμ, του βίντεο ή άλλων μορφότυπων κινητής εικόνας, συμπεριλαμβανομένων των οπτικών και ακουστικών πτυχών.","en":"An agent who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects.","es":"Un agente que es responsable de ensamblar, organizar y recortar películas, videos u otros formatos de imágenes en movimiento, incluidos los aspectos visuales y de audio.","et":"Tegija, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte.","fi":"Toimija, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta.","fr":"Agent qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores.","hu":"Egy ágens, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat.","lv":"Aģents, kas ir atbildīgs par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus.","nl":"Een actor die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten.","no":"En agent som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter.","tr":"Film, video veya diğer hareketli görüntü formatlarının hem görsel hem de işitsel yönleri dahil olmak üzere bir araya getirilmesi, düzenlenmesi ve kırpılmasından sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm về tập hợp, sắp đặt, tô điểm cho phim, video, hoặc định dạng hình ảnh động khác, bao gồm cả hai khía canh thị giác và audio.","zh-Hans-CN":"对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个行为者"},"altLabel":{"ar":["وكيل محرر لعمل صور متحركة"],"ca":["editor d’una obra d’imatge en moviment"],"cs":["editor pohyblivého obrazu (díla)"],"da":["klipper"],"de":["Cutter,Cutter"],"en":["editor of moving image work"],"es":["editor de trabajos de imágenes en movimiento."],"et":["filmiteose monteerija"],"fi":["leikkaaja"],"fr":["monteur d’œuvre d’images animées"],"hu":["mozgóképművágó:"],"nl":["filmeditor van bewegend beeldwerk"],"no":["redigerer av verk i form av levende bilder"],"tr":["hareketli görüntü eserinin editörü"],"zh-Hans-CN":["动态图像作品的剪辑师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20329", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToPerformance.en", "label":"has contributor agent to performance"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/editorAgentOfMovingImageWork.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20449", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgentOfMovingImageWork.en", "label":"has editor collective agent of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/P20390", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorPersonOfMovingImageWork.en", "label":"has editor person of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/object/P20055", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorAgentOfMovingImageWork.en", "label":"has editor agent of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20055", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorAgentOfMovingImageWork.en", "label":"has editor agent of moving image work"}]},{"@id":"http://rdaregistry.info/Elements/e/P20397","label":{"ar":"لها وكيل جماعي محرر","ca":"té com a agent col·lectiu editor literari","cs":"má editora (kolektivního agenta)","da":"har kollektiv agent, som er redaktør af tekst","de":"hat Herausgeberin/Herausgeber (Gemeinschaftlicher Akteur)","de":"hat Herausgeberin/Herausgeber (Gemeinschaftlicher Akteur)","en":"has editor collective agent","es":"tiene agente colectivo editor","et":"tekstitoimetaja (kollektiiv)","fi":"toimittaja (yhteistoimija)","fr":"a pour agent collectif éditeur intellectuel","hu":"szerkesztő kollektív ágense a következő:","lv":"redaktors (grupa)","nl":"heeft redacteur-collectieve actor","no":"har redaktør av tekst (kollektiv agent)","tr":"editör kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有编者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر."],"ca":["Relaciona una expressió amb un agent col·lectiu que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely."],"da":["Relaterer et udtryk til en kollektiv agent, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen."],"en":["Relates an expression to a collective agent who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use."],"es":["Relaciona una expresión con un agente colectivo que contribuye a una expresión al enmendar contenido creado por otros agentes para cumplir estándares de publicación u otros usos."],"et":["Seostab väljenduse kollektiiviga, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele."],"fi":["Liittää ekspression yhteistoimijaan, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi."],"fr":["Met une expression en relation avec un agent collectif qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak."],"lv":["Sasaista izteiksmi ar grupu, kas sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem."],"nl":["Relateert een expressie aan een collectieve actor die bijdraagt aan een expressie door aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik."],"no":["Relaterer et uttrykk til en kollektiv agent som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil."],"tr":["Bir anlatımı, yayın veya diğer kullanım standartlarını karşılamak amacıyla diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkıda bulunan kolektif bir temsilciyle ilişkilendirir"],"zh-Hans-CN":["将一种内容表达与通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي محرر","ca":"agent col·lectiu editor literari","cs":"editor (kolektivní agent)","da":"kollektiv agent, som er redaktør af tekst","de":"Herausgeberin/Herausgeber (Gemeinschaftlicher Akteur)","de":"Herausgeberin/Herausgeber (Gemeinschaftlicher Akteur)","en":"editor collective agent","es":"agente colectivo editor","et":"tekstitoimetaja (kollektiiv)","fi":"toimittaja (yhteistoimija)","fr":"agent collectif éditeur intellectuel","hu":"szerkesztő kollektív ágens:","lv":"redaktors (grupa)","nl":"redacteur-collectieve actor","no":"redaktør av tekst (kollektiv agent)","tr":"editör kolektif temsilci","zh-Hans-CN":"编者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر.","ca":"Agent col·lectiu que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús.","cs":"Kolektivní agent, který přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely.","da":"Kollektiv agent, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","de":"Ein gemeinschaftlicher Akteur, der zu einer Expression beiträgt, indem er von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","en":"A collective agent who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use.","es":"Un agente colectivo que contribuye a una expresión al enmendar contenido creado por otros agentes para cumplir estándares de publicación u otros usos.","et":"Kollektiiv, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele.","fi":"Yhteistoimija, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi.","fr":"Agent collectif qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation.","hu":"Egy kollektív ágens, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak.","lv":"Grupa, kas sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem.","nl":"Een collectieve actor die bijdraagt aan een expressie door aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik.","no":"En kollektiv agent som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil.","tr":"Yayın veya diğer kullanım standartlarını karşılamak amacıyla diğer aracılar tarafından oluşturulan içeriği düzenleyerek bir ifadeye katkıda bulunan kolektif temsilci.","zh-Hans-CN":"通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个集体行为者"},"note":{"ar":["محتوى يتضمن حركات مدونة، وموسيقى مدونة، وحركة مدونة بصورة ملموسة، وموسيقى مدونة بصورة ملموسة، ونص ملموس، ونص."],"ca":["El contingut inclou moviment notat, música notada, moviment notat tàctil, música notada tàctil, text tàctil i text."],"cs":["Obsah zahrnuje zápis pohybu, zápis hudby, taktilní zápis pohybu, taktilní zápis hudby, taktilní text a text."],"da":["Indhold omfatter noteret beværelse, noteret musik, taktil noteret bevægelse, taktil noteret musik, taktil tekst og tekst."],"de":["Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text.,Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text."],"en":["Content includes notated movement, notated music, tactile notated movement, tactile notated music, tactile text, and text."],"es":["Contenido incluye movimiento notado, música notada, movimiento táctil notado, música táctil notada, texto táctil y texto."],"fi":["Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti."],"fr":["Le contenu comprend le mouvement noté, le mouvement noté tactile, la musique notée, la musique notée tactile, le texte et le texte tactile."],"hu":["A tartalom mozgásírás, zenei lejegyzés, tapintható mozgásírás, tapintható zenei lejegyzés, tapintható szöveg és szöveg lehet."],"lv":["Saturs ir: teksts, kustību pieraksts, notācija, taktils kustības pieraksts, taktila notācija, taktils teksts."],"nl":["Content omvat bewegingsnotatie, muzieknotatie, tactiele bewegingsnotatie, tactiele muzieknotatie, tactiele tekst en tekst."],"tr":["İçerik; notalı hareket, notalı müzik, dokunsal notalı hareket, dokunsal notalı müzik, dokunsal metin ve metin içerir."],"zh-Hans-CN":["内容包括动作谱、乐谱、触摸动作谱、触摸乐谱、触摸文本、以及文本"]},"altLabel":{"ar":["وكيل جماعي محرر لنص"],"ca":["agent col·lectiu editor de text"],"da":["kollektiv agent af tekst, som er udgiver."],"de":["Herausgeberin/Herausgeber von Text (Gemeinschaftlicher Akteur),Herausgeberin/Herausgeber von Text (Gemeinschaftlicher Akteur)"],"en":["editor collective agent of text"],"es":["agente colectivo editor de texto"],"fi":["tekstin toimittaja (yhteistoimija)"],"fr":["agent collectif éditeur intellectuel de texte"],"hu":["szöveg szerkesztő kollektív ágense:"],"nl":["redacteur-collectieve actor van tekst"],"tr":["metnin editör kolektif temsilcisi"],"zh-Hans-CN":["文本的编者集体行为者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20426", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToAmalgamation.en", "label":"has contributor collective agent to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20330", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorAgent.en", "label":"has editor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20456", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCorporateBody.en", "label":"has editor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20515", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorFamily.en", "label":"has editor family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20397", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorCollectiveAgent.en", "label":"has editor collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20397", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorCollectiveAgent.en", "label":"has editor collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20449","label":{"ar":"لها وكيل جماعي محرر لعمل صور متحركة","ca":"té com a agent col·lectiu editor d’una obra d’imatge en moviment","cs":"má editora (kolektivního agenta) pohyblivého obrazu (díla)","da":"har kollektiv agent, som er udgiver af et værk med levende billeder","de":"hat Filmeditorin/Filmeditor (Gemeinschaftlicher Akteur)","de":"hat Filmeditorin/Filmeditor (Gemeinschaftlicher Akteur)","en":"has editor collective agent of moving image work","es":"tiene agente colectivo editor de obra de imágenes en movimiento","et":"filmiteose monteerija (kollektiiv)","fi":"leikkaaja (yhteistoimija)","fr":"a pour agent collectif monteur d’une œuvre d’images animées","hu":"mozgóképművágó kollektív ágense a következő:","lv":"filmas montāžas redaktors (grupa)","nl":"heeft filmeditor-collectieve actor van bewegend beeldwerk","no":"har redaktør av tekst (kollektiv agent)","tr":"hareketli görüntü çalışmasının editör kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有动态图像作品的剪辑师集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مسئولا عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة."],"ca":["Relaciona una expressió amb un agent col·lectiu que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je odpovědný za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů."],"da":["Relaterer et udtryk til en kollektiv agent, som er ansvarlig for at samle, arrangere og trimme film-, video- aller andre formater med levende billeder, omfattende både visuelle aspekter og lydaspekter."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften."],"en":["Relates an expression to a collective agent who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects."],"es":["Relaciona una expresión con un agente colectivo que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio."],"et":["Seostab väljenduse kollektiiviga, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte."],"fi":["Liittää ekspression yhteistoimijaan, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta."],"fr":["Met une expression en relation avec un agent collectif qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat."],"lv":["Sasaista izteiksmi ar grupu, kas ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus."],"nl":["Relateert een expressie aan een collectieve actor die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten."],"no":["Relaterer et uttrykk til en kollektiv agent som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil."],"tr":["Bir anlatımı, hem görsel hem işitsel yönlerini içeren, film, video veya diğer hareketli görüntü formatlarının montajı, düzenlemesi ve kırpılmasından sorumlu olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي محرر لعمل صور متحركة","ca":"agent col·lectiu editor d’una obra d’imatge en moviment","cs":"editor (kolektivní agent) pohyblivého obrazu (díla)","da":"kolektiv agent, som er udgiver af et værk med levende billeder","de":"Filmeditorin/Filmeditor (Gemeinschaftlicher Akteur)","de":"Filmeditorin/Filmeditor (Gemeinschaftlicher Akteur)","en":"editor collective agent of moving image work","es":"agente colectivo editor de obra de imágenes en movimiento","et":"filmiteose monteerija (kollektiiv)","fi":"leikkaaja (yhteistoimija)","fr":"agent collectif monteur d’une œuvre d’images animées","hu":"mozgóképművágó kollektív ágens:","lv":"filmas montāžas redaktors (grupa)","nl":"filmeditor-collectieve actor van bewegend beeldwerk","no":"redaktør av tekst (kollektiv agent)","tr":"hareketli görüntü eserinin editör kolektif temsilcisi","zh-Hans-CN":"动态图像作品的剪辑师集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مسئولا عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة.","ca":"Agent col·lectiu que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio.","cs":"Kolektivní agent, který je odpovědný za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů.","da":"Kollektiv agent, som er ansvarlig for at samle, arrangere og trimme film-, video- aller andre formater med levende billeder, omfattende både visuelle aspekter og lydaspekter.","de":"Ein gemeinschaftlicher Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","de":"Ein gemeinschaftlicher Akteur, der für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","en":"A collective agent who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects.","es":"Un agente colectivo que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio.","et":"Kollektiiv, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte.","fi":"Yhteistoimija, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta.","fr":"Agent collectif qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores.","hu":"Egy kollektív ágens, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat.","lv":"Grupa, kas ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus.","nl":"Een collectieve actor die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten.","no":"En kollektiv agent som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil.","tr":"Film, video veya diğer hareketli görüntü formatlarını, görsel ve işitsel yönleriyle birlikte bir araya getirme, düzenleme ve montajından sorumlu olan bir kolektif temsilci.","zh-Hans-CN":"对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个集体行为者"},"altLabel":{"de":["Cutterin/Cutter (Gemeinschaftlicher Akteur)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgentOfMovingImageWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20425", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToPerformance.en", "label":"has contributor collective agent to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20055", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorAgentOfMovingImageWork.en", "label":"has editor agent of moving image work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20508", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCorporateBodyOfMovingImageWork.en", "label":"has editor corporate body of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/P20567", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorFamilyOfMovingImageWork.en", "label":"has editor family of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/object/P20449", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorCollectiveAgentOfMovingImageWork.en", "label":"has editor collective agent of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20449", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorCollectiveAgentOfMovingImageWork.en", "label":"has editor collective agent of moving image work"}]},{"@id":"http://rdaregistry.info/Elements/e/P20456","label":{"ar":"لها هيئة محررة","ca":"té com a entitat corporativa editora literària","cs":"má editora (korporaci)","da":"har korporation, som er redaktør af tekst","de":"hat Herausgeberin/Herausgeber (Körperschaft)","de":"hat Herausgeberin/Herausgeber (Körperschaft)","en":"has editor corporate body","es":"tiene organismo corporativo editor","et":"tekstitoimetaja (asutus)","fi":"toimittaja (yhteisö)","fr":"a pour collectivité éditrice intellectuelle","hu":"szerkesztő testülete a következő:","lv":"redaktors (institūcija)","nl":"heeft redacteur-corporatie","no":"har redaktør av tekst (korporasjon)","tr":"editör tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有编者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely."],"da":["Relaterer et udtryk til en korporation, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen."],"en":["Relates an expression to a corporate body who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión al enmendar contenido creado por otros agentes para cumplir estándares de publicación u otros usos."],"et":["Seostab väljenduse asutusega, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele."],"fi":["Liittää ekspression yhteisöön, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie door aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik."],"no":["Relaterer et uttrykk til en korporasjon som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil."],"tr":["Bir anlatımı, yayın veya diğer kullanım standartlarını karşılamak için diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkı sağlayan tüzel bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة محررة","ca":"entitat corporativa editora literària","cs":"editor (korporace)","da":"korporation, som er redaktør","de":"Herausgeberin/Herausgeber (Körperschaft)","de":"Herausgeberin/Herausgeber (Körperschaft)","en":"editor corporate body","es":"organismo corporativo editor","et":"tekstitoimetaja (asutus)","fi":"toimittaja (yhteisö)","fr":"collectivité éditrice intellectuelle","hu":"szerkesztő testület:","lv":"redaktors (institūcija)","nl":"redacteur-corporatie","no":"redaktør av tekst (korporasjon)","tr":"editör tüzel kişi","zh-Hans-CN":"编者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر.","ca":"Entitat corporativa que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús.","cs":"Korporace, která přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely.","da":"Korporation, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","en":"A corporate body who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use.","es":"Un organismo corporativo que contribuye a una expresión al enmendar contenido creado por otros agentes para cumplir estándares de publicación u otros usos.","et":"Asutus, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele.","fi":"Yhteisö, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi.","fr":"Collectivité qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation.","hu":"Egy testület, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak.","lv":"Institūcija, kas sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem.","nl":"Een corporatie die bijdraagt aan een expressie door aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik.","no":"En korporasjon som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil.","tr":"Tüzel bir kişi, yayımlama veya diğer kullanım standartları için başka temsilcilerle toplantı yapmak amacıyla bir ifadeyi değiştirerek içerik yaratmaya katkı sağlar.","zh-Hans-CN":"通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个团体"},"note":{"ar":["محتوى يتضمن حركات مدونة، وموسيقى مدونة، وحركة مدونة بصورة ملموسة، وموسيقى مدونة بصورة ملموسة، ونص ملموس، ونص."],"ca":["El contingut inclou moviment notat, música notada, moviment notat tàctil, música notada tàctil, text tàctil i text."],"cs":["Obsah zahrnuje zápis pohybu, zápis hudby, taktilní zápis pohybu, taktilní zápis hudby, taktilní text a text."],"da":["Indhold omfatter noteret beværelse, noteret musik, taktil noteret bevægelse, taktil noteret musik, taktil tekst og tekst."],"de":["Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text.,Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text."],"en":["Content includes notated movement, notated music, tactile notated movement, tactile notated music, tactile text, and text."],"es":["Contenido incluye movimiento notado, música notada, movimiento táctil notado, música táctil notada, texto táctil y texto."],"fi":["Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti."],"fr":["Le contenu comprend le mouvement noté, le mouvement noté tactile, la musique notée, la musique notée tactile, le texte et le texte tactile."],"hu":["A tartalom mozgásírás, zenei lejegyzés, tapintható mozgásírás, tapintható zenei lejegyzés, tapintható szöveg és szöveg lehet."],"lv":["Saturs ir: teksts, kustību pieraksts, notācija, taktils kustības pieraksts, taktila notācija, taktils teksts."],"nl":["Content omvat bewegingsnotatie, muzieknotatie, tactiele bewegingsnotatie, tactiele muzieknotatie, tactiele tekst en tekst."],"tr":["İçerik; notalı hareket, notalı müzik, dokunsal notalı hareket, dokunsal notalı müzik, dokunsal metin ve metin içerir."],"zh-Hans-CN":["内容包括动作谱、乐谱、触摸动作谱、触摸乐谱、触摸文本、以及文本"]},"altLabel":{"ar":["هيئة محررة لنص"],"ca":["entitat corporativa editora de text"],"da":["korporation, som er redaktør af tekst"],"de":["Herausgeberin/Herausgeber von Text (Körperschaft),Herausgeberin/Herausgeber von Text (Körperschaft)"],"en":["editor corporate body of text"],"es":["organismo corporativo editor de texto"],"fi":["tekstin toimittaja (yhteisö)"],"fr":["collectivité éditrice intellectuelle de texte"],"hu":["szöveg szerkesztő testülete:"],"nl":["redacteur-corporatie van tekst"],"tr":["metnin editör tüzel kişisi"],"zh-Hans-CN":["文本的编者团体"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20485", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToAmalgamation.en", "label":"has contributor corporate body to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20397", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgent.en", "label":"has editor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20456", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorCorporateBody.en", "label":"has editor corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20456", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorCorporateBody.en", "label":"has editor corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20508","label":{"ar":"لها هيئة محررة لعمل صور متحركة","ca":"té com a entitat corporativa editora d’una obra d’imatge en moviment","cs":"má editora (korporaci) pohyblivého obrazu (díla)","da":"har korporation, som er klipper","de":"hat Filmeditorin/Filmeditor (Körperschaft)","de":"hat Filmeditorin/Filmeditor (Körperschaft)","en":"has editor corporate body of moving image work","es":"tiene organismo corporativo editor de obra de imágenes en movimiento","et":"filmiteose monteerija (asutus)","fi":"leikkaaja (yhteisö)","fr":"a pour collectivité monteuse d’une œuvre d’images animées","hu":"mozgóképművágó testülete a következő:","lv":"filmas montāžas redaktors (institūcija)","nl":"heeft filmeditor-corporatie van bewegend beeldwerk","no":"har redigerer av verk i form av levende bilder (korporasjon)","tr":"hareketli görüntü çalışmasının editör tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有动态图像作品的剪辑师团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تكون مسئولة عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة."],"ca":["Relaciona una expressió amb una entitat corporativa que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio."],"cs":["Vztahuje vyjádření ke korporaci, která je odpovědná za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů."],"da":["Relaterer et udtryk til en korporation, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.,Setzt eine Expression in Beziehung zu einer Körperschaft, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften."],"en":["Relates an expression to a corporate body who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects."],"es":["Relaciona una expresión con un organismo corporativo que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio."],"et":["Seostab väljenduse asutusega, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte."],"fi":["Liittää ekspression yhteisöön, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta."],"fr":["Met une expression en relation avec une collectivité qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat."],"lv":["Sasaista izteiksmi ar institūciju, kas ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus."],"nl":["Relateert een expressie aan een corporatie die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten."],"no":["Relaterer et uttrykk til en korporasjon som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter."],"tr":["Bir anlatımı, hem görsel hem işitsel yönlerini içeren, film, video veya diğer hareketli görüntü formatlarının montajı, düzenlemesi ve kırpılmasından sorumlu olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة محررة لعمل صور متحركة","ca":"entitat corporativa editora d’una obra d’imatge en moviment","cs":"editor (korporace) pohyblivého obrazu (díla)","da":"korporation, som er klipper","de":"Filmeditorin/Filmeditor (Körperschaft)","de":"Filmeditorin/Filmeditor (Körperschaft)","en":"editor corporate body of moving image work","es":"organismo corporativo editor de obra de imágenes en movimiento","et":"filmiteose monteerija (asutus)","fi":"leikkaaja (yhteisö)","fr":"collectivité monteuse d’une œuvre d’images animées","hu":"mozgóképművágó testület:","lv":"filmas montāžas redaktors (institūcija)","nl":"filmeditor-corporatie van bewegend beeldwerk","no":"redigerer av verk i form av levende bilder (korporasjon)","tr":"hareketli görüntü eserinin editör tüzel kişisi","zh-Hans-CN":"动态图像作品的剪辑师团体"},"ToolkitDefinition":{"ar":"هيئة تكون مسئولة عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة.","ca":"Entitat corporativa que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio.","cs":"Korporace, která je odpovědná za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů.","da":"Korporation, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter.","de":"Eine Körperschaft, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","de":"Eine Körperschaft, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","en":"A corporate body who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects.","es":"Un organismo corporativo que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio.","et":"Asutus, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte.","fi":"Yhteisö, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta.","fr":"Collectivité qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores.","hu":"Egy testület, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat.","lv":"Institūcija, kas ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus.","nl":"Een corporatie die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten.","no":"En korporasjon som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter.","tr":"Film, video veya diğer hareketli görüntü formatlarının hem görsel hem de işitsel yönleri de dahil olmak üzere bir araya getirilmesinden, düzenlenmesinden ve kırpılmasından sorumlu olan tüzel kişi.","zh-Hans-CN":"对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个团体"},"altLabel":{"de":["Cutterin/Cutter (Körperschaft)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorCorporateBodyOfMovingImageWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20484", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToPerformance.en", "label":"has contributor corporate body to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20449", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgentOfMovingImageWork.en", "label":"has editor collective agent of moving image work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20508", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorCorporateBodyOfMovingImageWork.en", "label":"has editor corporate body of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20508", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorCorporateBodyOfMovingImageWork.en", "label":"has editor corporate body of moving image work"}]},{"@id":"http://rdaregistry.info/Elements/e/P20515","label":{"ar":"لها عائلة محررة","ca":"té com a família editora literària","cs":"má editora (rodinu)","da":"har familie, som er redaktør","de":"hat Herausgeberin/Herausgeber (Familie)","de":"hat Herausgeberin/Herausgeber (Familie)","en":"has editor family","es":"tiene familia editora","et":"tekstitoimetaja (perekond)","fi":"toimittaja (suku)","fr":"a pour famille éditrice intellectuelle","hu":"szerkesztő családja a következő:","lv":"redaktors (dzimta/ģimene)","nl":"heeft redacteur-familie","no":"har redaktør av tekst (familie)","tr":"editör ailesi ile ilişkilidir","zh-Hans-CN":"有编者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie Text verändert, der von anderen Akteuren erstellt wurde, um Publikationsstandards wie Konsistenz, Klarheit und Stil zu erfüllen.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie Text verändert, der von anderen Akteuren erstellt wurde, um Publikationsstandards wie Konsistenz, Klarheit und Stil zu erfüllen."],"en":["Relates an expression to a family who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al enmendar contenido creado por otros agentes para cumplir estándares de publicación u otros usos."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil."],"tr":["Bir anlatımı, yayın veya diğer kullanım standartlarını karşılamak için diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkı sağlayan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة محررة","ca":"família editora literària","cs":"editor (rodina)","da":"familie, som er redaktør","de":"Herausgeberin/Herausgeber (Familie)","de":"Herausgeberin/Herausgeber (Familie)","en":"editor family","es":"familia editora","et":"tekstitoimetaja (perekond)","fi":"toimittaja (suku)","fr":"famille éditrice intellectuelle","hu":"szerkesztő család:","lv":"redaktors (dzimta/ģimene)","nl":"redacteur-familie","no":"redaktør av tekst (familie)","tr":"editör aile","zh-Hans-CN":"编者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر.","ca":"Família que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús.","cs":"Rodina, která přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely.","da":"Relaterer et udtryk til en familie, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","en":"A family who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use.","es":"Una familia que contribuye a una expresión al enmendar contenido creado por otros agentes para cumplir estándares de publicación u otros usos.","et":"Perekond, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele.","fi":"Suku, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi.","fr":"Famille qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation.","hu":"Egy család, amely hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak.","lv":"Dzimta/ģimene, kas sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem.","nl":"Een familie die bijdraagt aan een expressie door aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik.","no":"En familie som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil.","tr":"Başka temsilciler tarafından oluşturulan içeriği yayımlama veya başka bir kullanım standardına uygun hale getirmek için düzelterek bir anlatıma katkıda bulunan bir aile.","zh-Hans-CN":"通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个家族"},"note":{"ar":["محتوى يتضمن حركات مدونة، وموسيقى مدونة، وحركة مدونة بصورة ملموسة، وموسيقى مدونة بصورة ملموسة، ونص ملموس، ونص."],"ca":["El contingut inclou moviment notat, música notada, moviment notat tàctil, música notada tàctil, text tàctil i text."],"cs":["Obsah zahrnuje zápis pohybu, zápis hudby, taktilní zápis pohybu, taktilní zápis hudby, taktilní text a text."],"da":["Indhold omfatter noteret beværelse, noteret musik, taktil noteret bevægelse, taktil noteret musik, taktil tekst og tekst."],"de":["Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text.,Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text."],"en":["Content includes notated movement, notated music, tactile notated movement, tactile notated music, tactile text, and text."],"es":["Contenido incluye movimiento notado, música notada, movimiento táctil notado, música táctil notada, texto táctil y texto."],"fi":["Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti."],"fr":["Le contenu comprend le mouvement noté, le mouvement noté tactile, la musique notée, la musique notée tactile, le texte et le texte tactile."],"hu":["A tartalom mozgásírás, zenei lejegyzés, tapintható mozgásírás, tapintható zenei lejegyzés, tapintható szöveg és szöveg lehet."],"lv":["Saturs ir: teksts, kustību pieraksts, notācija, taktils kustības pieraksts, taktila notācija, taktils teksts."],"nl":["Content omvat bewegingsnotatie, muzieknotatie, tactiele bewegingsnotatie, tactiele muzieknotatie, tactiele tekst en tekst."],"tr":["İçerik; notalı hareket, notalı müzik, dokunsal notalı hareket, dokunsal notalı müzik, dokunsal metin ve metin içerir."],"zh-Hans-CN":["内容包括动作谱、乐谱、触摸动作谱、触摸乐谱、触摸文本、以及文本"]},"altLabel":{"ar":["عائلة محرر لنص"],"ca":["família editora de text"],"cs":["editor (rodina) textu"],"da":["familie, som er redaktør af tekst"],"de":["Herausgeberin/Herausgeber von Text (Familie),Herausgeberin/Herausgeber von Text (Familie)"],"en":["editor family of text"],"es":["familia editora de texto"],"fi":["tekstin toimittaja (suku)"],"fr":["famille éditrice intellectuelle de texte"],"hu":["szöveg szerkesztő családja:"],"nl":["redacteur-familie van tekst"],"tr":["metnin editör ailesi"],"zh-Hans-CN":["文本的编者家族"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20544", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToAmalgamation.en", "label":"has contributor family to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20397", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgent.en", "label":"has editor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20515", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorFamily.en", "label":"has editor family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20515", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorFamily.en", "label":"has editor family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20567","label":{"ar":"لها عائلة محررة لعمل صور متحركة","ca":"té com a família editora d’una obra d’imatge en moviment","cs":"má editora (rodinu) pohyblivého obrazu (díla)","da":"har familie, som er klipper","de":"hat Filmeditorin/Filmeditor (Familie)","de":"hat Filmeditorin/Filmeditor (Familie)","en":"has editor family of moving image work","es":"tiene familia editora de obra de imágenes en movimiento","et":"filmiteose monteerija (perekond)","fi":"leikkaaja (suku)","fr":"a pour famille monteuse d’une œuvre d’images animées","hu":"mozgóképművágó családja a következő:","lv":"filmas montāžas redaktors (dzimta/ģimene)","nl":"heeft filmeditor-familie van bewegend beeldwerk","no":"har redigerer av verk i form av levende bilder (familie)","tr":"hareketli görüntü çalışmasının editör ailesi ile ilişkilidir","zh-Hans-CN":"有动态图像作品的剪辑师家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة مسئولة عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة."],"ca":["Relaciona una expressió amb una família que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio."],"cs":["Vztahuje vyjádření k rodině, která je odpovědná odpovědný za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů."],"da":["Relaterer et udtryk til en familie, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.,Setzt eine Expression in Beziehung zu einer Familie, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften."],"en":["Relates an expression to a family who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects."],"es":["Relaciona una expresión con una familia que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio."],"et":["Seostab väljenduse perekonnaga, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte."],"fi":["Liittää ekspression sukuun, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta."],"fr":["Met une expression en relation avec une famille qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus."],"nl":["Relateert een expressie aan een familie die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten."],"no":["Relaterer et uttrykk til en familie som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter."],"tr":["Bir anlatımı, hem görsel hem işitsel yönlerini içeren, film, video veya diğer hareketli görüntü formatlarının montajı, düzenlemesi ve kırpılmasından sorumlu olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة محررة لعمل صور متحركة","ca":"família editora d’una obra d’imatge en moviment","cs":"editor (rodina) pohyblivého obrazu (díla)","da":"familie, som er klipper","de":"Filmeditorin/Filmeditor (Familie)","de":"Filmeditorin/Filmeditor (Familie)","en":"editor family of moving image work","es":"familia editora de obra de imágenes en movimiento","et":"filmiteose monteerija (perekond)","fi":"leikkaaja (suku)","fr":"famille monteuse d’une œuvre d’images animées","hu":"mozgóképművágó család:","lv":"filmas montāžas redaktors (dzimta/ģimene)","nl":"filmeditor-familie van bewegend beeldwerk","no":"redigerer av verk i form av levende bilder (familie)","tr":"hareketli görüntü eserinin editör ailesi","zh-Hans-CN":"动态图像作品的剪辑师家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة.","ca":"Família que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio.","cs":"Rodina, která je odpovědná odpovědný za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů.","da":"Familie, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter.","de":"Eine Familie, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","de":"Eine Familie, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","en":"A family who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects.","es":"Una familia que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio.","et":"Perekond, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte.","fi":"Suku, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta.","fr":"Famille qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores.","hu":"Egy család, amely felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat.","lv":"Dzimta/ģimene, kas ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus.","nl":"Een familie die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten.","no":"En familie som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter.","tr":"Hem görsel hem de işitsel yönler dahil olmak üzere film, video veya diğer hareketli görüntü formatlarını bir araya getirmekten, düzenlemekten ve kırpmaktan sorumlu olan bir aile.","zh-Hans-CN":"对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个家族"},"altLabel":{"de":["Cutterin/Cutter (Familie)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorFamilyOfMovingImageWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20543", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToPerformance.en", "label":"has contributor family to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20449", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorCollectiveAgentOfMovingImageWork.en", "label":"has editor collective agent of moving image work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20567", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorFamilyOfMovingImageWork.en", "label":"has editor family of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20567", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorFamilyOfMovingImageWork.en", "label":"has editor family of moving image work"}]},{"@id":"http://rdaregistry.info/Elements/e/P20338","label":{"ar":"لها شخص محرر","ca":"té com a persona editora literària","cs":"má editora (osobu)","da":"har person, som er redaktør af tekst","de":"Herausgeberin/Herausgeber (Person)","de":"Herausgeberin/Herausgeber (Person)","en":"has editor person","es":"tiene persona editora","et":"tekstitoimetaja (isik)","fi":"toimittaja (henkilö)","fr":"a pour personne éditrice intellectuelle","hu":"szerkesztő személye a következő:","lv":"redaktors (persona)","nl":"heeft redacteur-persoon","no":"har redaktør av tekst (person)","tr":"editör kişisi ile ilişkilidir","zh-Hans-CN":"有编者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen."],"en":["Relates an expression to a person who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use."],"es":["Relaciona una expresión con una persona que contribuye a una expresión modificando el contenido creado por otros agentes para cumplir con los estándares de publicación u otro uso."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil."],"tr":["Bir anlatımı, yayın veya diğer kullanım standartlarını karşılamak amacıyla diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkıda bulunan kişiyle ilişkilendirir"],"zh-Hans-CN":["将一种内容表达与通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص محرر","ca":"persona editora literària","cs":"editor (osoba)","da":"person, som er redaktør","de":"Herausgeberin/Herausgeber (Person)","de":"Herausgeberin/Herausgeber (Person)","en":"editor person","es":"persona editora","et":"tekstitoimetaja (isik)","fi":"toimittaja (henkilö)","fr":"personne éditrice intellectuelle","hu":"szerkesztő személy:","lv":"redaktors (persona)","nl":"redacteur-persoon","no":"redaktør av tekst (person)","tr":"editör","zh-Hans-CN":"编者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال تعديل نص من تأليف وكلاء آخرين من أجل استيفاء معايير النشر أو لاستخدام آخر.","ca":"Persona que contribueix a una expressió esmenant el contingut creat per altres agents per tal de complir els estàndards de publicació o un altre ús.","cs":"Osoba, která přispívá k vyjádření tím, že upravuje obsah vytvořený jinými agenty tak, aby vyhovoval standardům pro zveřejnění nebo jiné účely.","da":"Person, som bidrager til et udtryk ved at ændre tekst skabt af andre agenter, for at opfylde publikationsstandarder som ensartethed, klarhed og stil.","de":"Eine Person, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","de":"Eine Person, die zu einer Expression beiträgt, indem sie von anderen Akteuren erstellte Inhalte so verändert, dass sie den Standards für die Veröffentlichung oder einer anderweitigen Verwendung entsprechen.","en":"A person who contributes to an expression by amending content created by other agents in order to meet standards for publication or other use.","es":"Una persona que contribuye a una expresión modificando el contenido creado por otros agentes para cumplir con los estándares de publicación u otro uso.","et":"Isik, kes annab panuse väljendusse, parandades teiste tegijate loodud teksti, et see vastaks loogilisuse, selguse ja stiili poolest avaldamisnõuetele.","fi":"Henkilö, joka osallistuu ekspression tekemiseen tarkistamalla muiden toimijoiden luomaa sisältöä julkaisu- tai muiden käyttöstandardien saavuttamiseksi.","fr":"Personne qui contribue à une expression en modifiant du contenu créé par d’autres agents afin de répondre à des normes pour la publication ou une autre utilisation.","hu":"Egy személy, aki hozzájárul egy kifejezési forma más ágensek által létrehozott tartalmának módosításával, hogy az megfeleljen a publikálás, vagy az egyéb célú felhasználás szabályainak.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, pielāgojot citu aģentu izveidoto saturu, lai tas atbilstu publicēšanas vai citādas izmantošanas standartiem.","nl":"Een persoon die bijdraagt aan een expressie door het aanpassen van content gecreëerd door andere actoren met de bedoeling te voldoen aan standaarden voor publicatie of ander gebruik.","no":"En person som bidrar til et uttrykk ved å gjøre endringer i tekst skrevet av andre agenter for å imøtekomme utgivelsesstandarder for sammenheng, tydelighet og stil.","tr":"Yayın veya diğer kullanım standartlarını karşılamak için diğer temsilciler tarafından oluşturulan içeriği değiştirerek bir anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过修正其他行为者创作的内容以满足出版标准或其他用途而对一种内容表达作出贡献的一个个人"},"note":{"ar":["محتوى يتضمن حركات مدونة، وموسيقى مدونة، وحركة مدونة بصورة ملموسة، وموسيقى مدونة بصورة ملموسة، ونص ملموس، ونص."],"ca":["El contingut inclou moviment notat, música notada, moviment notat tàctil, música notada tàctil, text tàctil i text."],"cs":["Obsah zahrnuje zápis pohybu, zápis hudby, taktilní zápis pohybu, taktilní zápis hudby, taktilní text a text."],"da":["Indhold omfatter noteret beværelse, noteret musik, taktil noteret bevægelse, taktil noteret musik, taktil tekst og tekst."],"de":["Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text.,Darunter fallen Bewegungsnotationen, Noten, Text, taktile Bewegungsnotationen, taktile Noten und taktiler Text."],"en":["Content includes notated movement, notated music, tactile notated movement, tactile notated music, tactile text, and text."],"es":["El contenido incluye movimiento anotado, música anotada, movimiento táctil anotado, música táctil anotada, texto táctil y texto."],"fi":["Sisältöön kuuluvat liikenotaatio, nuottikirjoitus, taktiili liikenotaatio, taktiili nuottikirjoitus, taktiili teksti ja teksti."],"fr":["Le contenu comprend le mouvement noté, le mouvement noté tactile, la musique notée, la musique notée tactile, le texte et le texte tactile."],"hu":["A tartalom mozgásírás, zenei lejegyzés, tapintható mozgásírás, tapintható zenei lejegyzés, tapintható szöveg és szöveg lehet."],"lv":["Saturs ir: teksts, kustību pieraksts, notācija, taktils kustības pieraksts, taktila notācija, taktils teksts."],"nl":["Content omvat bewegingsnotatie, muzieknotatie, tactiele bewegingsnotatie, tactiele muzieknotatie, tactiele tekst en tekst."],"tr":["İçerik; notalı hareket, notalı müzik, dokunsal notalı hareket, dokunsal notalı müzik, dokunsal metin ve metin içerir."],"zh-Hans-CN":["内容包括动作谱、乐谱、触摸动作谱、触摸乐谱、触摸文本、以及文本"]},"altLabel":{"ar":["شخص محرر لنص"],"ca":["persona editora de text"],"cs":["editor (osoba) textu"],"da":["person, som er redaktør af tekst"],"de":["Herausgeberin/Herausgeber von Text (Person),Herausgeberin/Herausgeber von Text (Person)"],"en":["editor person of text"],"es":["persona editora de texto"],"fi":["tekstin toimittaja (henkilö)"],"fr":["personne éditrice intellectuelle de texte"],"hu":["szöveg szerkesztő személye:"],"nl":["redacteur-persoon van tekst"],"tr":["metnin editörü"],"zh-Hans-CN":["文本的编者个人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20367", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToAmalgamation.en", "label":"has contributor person to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20330", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorAgent.en", "label":"has editor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20338", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorPerson.en", "label":"has editor person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20338", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorPerson.en", "label":"has editor person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20390","label":{"ar":"لها شخص محرر لعمل صور متحركة","ca":"té com a persona editora d’una obra d’imatge en moviment","cs":"má editora (osobu) pohyblivého obrazu (díla)","da":"har person, som er klipper","de":"hat Filmeditorin/Filmeditor (Person)","de":"hat Filmeditorin/Filmeditor (Person)","en":"has editor person of moving image work","es":"tiene persona editora de obra de imágenes en movimiento","et":"filmiteose monteerija (isik)","fi":"leikkaaja (henkilö)","fr":"a pour personne monteuse d’une œuvre d’images animées","hu":"mozgóképművágó személye a következő:","lv":"filmas montāžas redaktors (persona)","nl":"heeft filmeditor-persoon van bewegend beeldwerk","no":"har redaktør av verk i form av levende bilder (person)","tr":"hareketli görüntü çalışmasının editör kişisi ile ilişkilidir","zh-Hans-CN":"有动态图像作品的剪辑师个人"},"definition":{"ar":["تربط بين تعبيرة وشخص مسئول عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة."],"ca":["Relaciona una expressió amb una persona que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio."],"cs":["Vztahuje vyjádření k osobě, která je odpovědná za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů."],"da":["Relaterer et udtryk til en person, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter."],"de":["Setzt eine Expression in Beziehung zu einer Person, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.,Setzt eine Expression in Beziehung zu einer Person, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften."],"en":["Relates an expression to a person who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects."],"es":["Relaciona una expresión con una persona que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio."],"et":["Seostab väljenduse isikuga, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte."],"fi":["Liittää ekspression henkilöön, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta."],"fr":["Met une expression en relation avec une personne qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat."],"lv":["Sasaista izteiksmi ar personu, kura ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus."],"nl":["Relateert een expressie aan een persoon die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten."],"no":["Relaterer et uttrykk til en person som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter."],"tr":["Bir anlatımı, hem görsel hem işitsel yönlerini içeren, film, video veya diğer hareketli görüntü formatlarının montajı, düzenlemesi ve kırpılmasından sorumlu olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص محرر لعمل صور متحركة","ca":"persona editora d’una obra d’imatge en moviment","cs":"editor (osoba) pohyblivého obrazu (díla)","da":"person, som er klipper","de":"Filmeditorin/Filmeditor (Person)","de":"Filmeditorin/Filmeditor (Person)","en":"editor person of moving image work","es":"persona editora de obra de imágenes en movimiento","et":"filmiteose monteerija (isik)","fi":"leikkaaja (henkilö)","fr":"personne monteuse d’une œuvre d’images animées","hu":"mozgóképművágó személy:","lv":"filmas montāžas redaktors (persona)","nl":"filmeditor-persoon van bewegend beeldwerk","no":"redaktør av verk i form av levende bilder (person)","tr":"hareketli görüntü eserinin editörü","zh-Hans-CN":"动态图像作品的剪辑师个人"},"ToolkitDefinition":{"ar":"شخص مسئول عن تجميع فيلم، أو فيديو، أو شكل آخر من أشكال الصور المتحركة، وترتيبها، واقتطاعها، بما في ذلك الجوانب المرئية والمسموعة.","ca":"Persona que és responsable d’aplegar, arranjar i retallar pel·lícules, vídeos i altres formats d’imatge en moviment, inclosos tant els aspectes visuals com els d’àudio.","cs":"Osoba, která je odpovědná za sestavování, uspořádání a stříhání filmů, videa nebo jiných formátů pohyblivého obrazu, včetně vizuálních i zvukových aspektů.","da":"Person, som er ansvarlig for at sammensætte, arrangere og klippe film, video eller andre levende billedformater, inkl. både visuelle og lydmæssige aspekter.","de":"Eine Person, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","de":"Eine Person, die für das Zusammensetzen, Arrangieren und Nachschneiden von Film-, Video- oder anderen Bewegtbildformaten zuständig ist. Dies betrifft sowohl Video- als auch Audio-Eigenschaften.","en":"A person who is responsible for assembling, arranging, and trimming film, video, or other moving image formats, including both visual and audio aspects.","es":"Una persona que es responsable de ensamblar, disponer y recortar film, video u otros formatos de imagen en movimiento, incluyendo aspectos tanto visuales como de audio.","et":"Isik, kes vastutab filmi, video jm liikuvast pildist koosnevate formaatide monteerimise, järjestamise ja lõikamise eest, hõlmates nii visuaalseid kui ka heli aspekte.","fi":"Henkilö, joka vastaa filmin, videon tai muiden liikkuvan kuvan formaattien kokoamisesta, järjestämisestä ja leikkauksesta sekä kuvan että äänen osalta.","fr":"Personne qui est responsable de l’assemblage, de l’agencement et du découpage de film, de vidéo ou d’autres formats d’images animées, y compris les aspects visuels et sonores.","hu":"Egy személy, aki felelős film, videó vagy más mozgókép-formátum összeállításáért, elrendezéséért és vágásáért, beleértve mind a vizuális, mind az audió szempontokat.","lv":"Persona, kura ir atbildīga par filmas, video vai citu kustīgu attēlu formātu montāžu, pārkārtošanu un saīsināšanu, ietverot gan vizuālos, gan audio aspektus.","nl":"Een persoon die verantwoordelijk is voor het samenstellen, arrangeren en couperen van film, video, of andere bewegend beeld-vormen, inclusief zowel visuele als geluidsaspecten.","no":"En person som har ansvar for å sette sammen, arrangere og klippe film, video eller andre formater for levende bilder, inkludert både bilde- og lydaspekter.","tr":"Film, video veya diğer hareketli görüntü formatlarının hem görsel hem de işitsel yönleri dahil olmak üzere birleştirilmesinden, düzenlenmesinden ve kırpılmasından sorumlu olan kişi.","zh-Hans-CN":"对影片、视频或其他动态图像格式（包括视频和音频方面）的汇编、编排和剪辑负责的一个个人"},"altLabel":{"de":["Cutterin/Cutter (Person)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/editorPersonOfMovingImageWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20367", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToAmalgamation.en", "label":"has contributor person to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20055", "lexicalAlias":"http://rdaregistry.info/Elements/e/editorAgentOfMovingImageWork.en", "label":"has editor agent of moving image work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20390", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editorPersonOfMovingImageWork.en", "label":"has editor person of moving image work"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20390", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editorPersonOfMovingImageWork.en", "label":"has editor person of moving image work"}]},{"@id":"http://rdaregistry.info/Elements/e/P20041","definition":{"ca":["Relaciona una expressió amb un agent que contribueix a una expressió d’una obra proporcionant un prefaci a una obra original."],"da":["Relaterer et udtryk til en agent, der har bidraget til et udtryk af et værk ved at tilvejebringe et forord til det originale værk."],"de":["Setzt eine Expression mit einem Akteur, der an einer Expression eines Werks mitwirkt, indem er ein Geleitwort zum Originalwerk liefert, in Beziehung."],"el":["Συνδέεει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας έναν πρόλογο στο πρωτότυπο έργο."],"en":["Relates an expression to an agent who contributes to an expression by providing a preface to an original work. (Deprecated)"],"fi":["Liittää ekspression toimijaan, joka osallistuu teoksen ekspression tekemiseen kirjoittamalla esipuheen alkuperäiseen teokseen."],"fr":["Met une expression en relation avec un agent qui contribue à une expression d’une œuvre en fournissant une préface à une œuvre originale."],"hu":["Egy kifejezési formát hozzákapcsol egy ágenshez (személyhez, családhoz vagy testülethez), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy eredeti művet előszóval lát el."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp lời nói đầu cho tác phẩm nguyên gốc."]},"ToolkitLabel":{"ca":"escriptor d’un prefaci","da":"forfatter til forord","de":"Verfasser eines Geleitwortes","el":"συγγραφέας του προλόγου","en":"writer of preface (Deprecated)","es":"autor de prefacio","fi":"esipuheen kirjoittaja  ","fr":"préfacier","hu":"előszó írója","no":"forfatter av forord","vi":"người viết lời nói đầu"},"ToolkitDefinition":{"ca":"Agent que contribueix a una expressió d’una obra proporcionant un prefaci a una obra original.","da":"Agent, der har bidraget til et udtryk af et værk ved at tilvejebringe et forord til det originale værk.","de":"Ein Akteur, der an einer Expression eines Werks mitwirkt, indem er ein Geleitwort zum Originalwerk liefert.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας έναν πρόλογο στο πρωτότυπο έργο.","en":"An agent who contributes to an expression by providing a preface to an original work. (Deprecated)","es":"Una persona, familia o entidad corporativa que contribuye a una expresión de una obra ofreciendo un prefacio a la obra original.","fi":"Toimija, joka osallistuu teoksen ekspression tekemiseen kirjoittamalla esipuheen alkuperäiseen teokseen.","fr":"Agent qui contribue à une expression d’une œuvre en fournissant une préface à une œuvre originale.","hu":"Egy ágens (személy, család vagy testület), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy eredeti művet előszóval lát el.","no":"En agent som bidrar til et uttrykk av et verk ved å tilføre et forord til originalverket.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp lời nói đầu cho tác phẩm nguyên gốc."},"label":{"ca":"té com a escriptor d’un prefaci","da":"har forfatter til forord","de":"hat Verfasser eines Geleitworts","el":"έχει συγγραφέα του προλόγου","en":"has writer of preface (Deprecated)","fi":"esipuheen kirjoittaja  ","fr":"a pour préfacier","hu":"van előszóírója","vi":"có người viết lời nói đầu"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
