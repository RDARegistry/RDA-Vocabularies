                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20157", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayExpression.en", "label":"has screenplay expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureScreenplayExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20158", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/motionPictureScreenplayExpression.en", "label":"has motion picture screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20158", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/motionPictureScreenplayExpression.en", "label":"has motion picture screenplay expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20009","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل صورة متحركة مبني على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra d’imatge en moviment que es basa en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření pohyblivého obrazu (díla), založenému na vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk med levende billeder, som er baseret på et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Bewegtbildwerks, die auf einer Expression eines anderen Werks basiert.,Setzt eine Expression in Beziehung zu einer Expression eines Bewegtbildwerks, die auf einer Expression eines anderen Werks basiert."],"el":["Συνδέει μια έκφραση με μια κινηματογραφική ταινία βασισμένη σε μια έκφραση-πηγή."],"en":["Relates an expression to an expression of a moving image work that is based on an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra de imagen en movimiento que se basa en una expresión de otra obra."],"et":["Seostab väljenduse filmiga, mis põhineb allikväljendusel."],"fi":["Liittää ekspression liikkuvan kuvan teoksen ekspressioon, joka perustuu toisen teoksen ekspressioon."],"fr":["Met une expression en relation avec une expression d’une œuvre d’images animées qui est basée sur une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mozgókép kifejezési formájához, amely egy másik mű kifejezési formáján alapul."],"lv":["Sasaista izteiksmi ar kinofilmas izteiksmi, kas veidota pēc darba pamatizteiksmes."],"nl":["Relateert een expressie aan een expressie van een bewegend beeldwerk dat is gebaseerd op een expressie van een ander werk."],"no":["Relaterer et uttrykk til en spillefilm basert på et kildeuttrykk."],"tr":["Bir anlatımı, başka bir eserin anlatımına dayanan bir hareketli görüntü eserinin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với phim điện ảnh dựa trên biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与基于另一种作品的一种内容表达的一种动态图像作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة كعمل فيلم سينمائي","ca":"adaptat com a expressió de pel·lícula cinematogràfica","cs":"adaptováno jako film (vyjádření)","da":"bearbejdet til filmudtryk","de":"Bearbeitet als Film (Expression)","de":"Bearbeitet als Film (Expression)","el":"προσαρμοσμένη ως κινηματογραφική ταινία (έκφραση)","en":"adapted as motion picture expression","es":"adaptado como expresión cinematográfica","et":"adapteeritud filmina (väljendus)","fi":"elokuvasovitus (ekspressio)","fr":"adapté en film (expression)","hu":"mozgókép kifejezési formára átdolgozva:","lv":"adaptēts kā izteiksme: kinofilma","nl":"bewerkt als speelfilm-expressie","no":"bearbeidet som spillefilm (uttrykk)","tr":"Sinema filmi olarak uyarlanan","vi":"được phỏng theo như là điện ảnh (biểu hiện)","zh-Hans-CN":"被改编成电影内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل صورة متحركة مبني على تعبيرة لعمل آخر.","ca":"Expressió d’una obra d’imatge en mo