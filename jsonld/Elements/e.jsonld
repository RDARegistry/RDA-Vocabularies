                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/lettererCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20426", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToAmalgamation.en", "label":"has contributor collective agent to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20259", "lexicalAlias":"http://rdaregistry.info/Elements/e/lettererAgent.en", "label":"has letterer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20505", "lexicalAlias":"http://rdaregistry.info/Elements/e/lettererCorporateBody.en", "label":"has letterer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20564", "lexicalAlias":"http://rdaregistry.info/Elements/e/lettererFamily.en", "label":"has letterer family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20446", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/lettererCollectiveAgent.en", "label":"has letterer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20446", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/lettererCollectiveAgent.en", "label":"has letterer collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20505","label":{"ar":"لها هيئة رسَّامة حروف","ca":"té com a entitat corporativa retolista","cs":"má letrážistu (korporaci)","da":"har korporation, som er bogstavtegner","de":"hat Letterer (Körperschaft)","de":"hat Letterer (Körperschaft)","en":"has letterer corporate body","es":"tiene organismo corporativo rotulista","et":"tekstijoonistaja (asutus)","fi":"tekstaaja (yhteisö)","fr":"a pour collectivité lettreuse","hu":"betűrajzoló testülete a következő:","lv":"komiksa teksta rakstītājs (institūcija)","nl":"heeft letteraar-corporatie","no":"har letterer (korporasjon)","tr":"yazı tasarımcısı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有字母图案画者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في كتاب مصور، أو رواية مصورة، إلخ. من خلال رسم النص وتصميم المؤثرات الصوتية للرسومات."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió d’un còmic, una novel·la gràfica, etc., dibuixant el text i els efectes sonors gràfics."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření komiksu, grafického románu atd. tím, že kreslí text a grafické zvukové efekty."],"da":["Relaterer et udtryk til en korporation, som er illustrator, som bidrager til et udtryk af en tegneserie, en graphic novel etc. ved at tegne teksten og de grafiske lydeffekter."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression eines Comicbuchs, einer Graphic Novel und so weiter beiträgt, indem sie den Text und die grafischen Toneffekte zeichnet.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression eines Comicbuchs, einer Graphic Novel und so weiter beiträgt, indem sie den Text und die grafischen Toneffekte zeichnet."],"en":["Relates an expression to a corporate body who contributes to an expression of a comic book, graphic novel, etc., by drawing the text and graphic sound effects."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión de un libro de cómics, novela gráfica, etc., dibujar texto y efectos de sonido gráficos."],"et":["Seostab väljenduse asutusega, kes illustreerijana annab panuse koomiksi, graafilise romaani vms väljendusse, joonistades teksti ja graafilisi helijäljendusi."],"fi":["Liittää ekspression yhteisöön, joka osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression d’une bande dessinée, d’un roman graphique, etc. en dessinant le texte et les effets sonores graphiques."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely hozzájárul egy képregényhez, képregényalbumhoz, stb., azzal, hogy megrajzolja a szöveget és a grafikus hangeffektusokat."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu komiksu grāmatas, grafiskā romāna u.tml. izteiksmē, zīmējot tekstu un skaņu efektus grafiskā formā."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie van een comic, stripboek etc. door het tekenen van tekst en grafische geluidseffecten."],"no":["Relaterer et uttrykk til en korporasjon som er en illustratør som bidrar til et uttrykk av en tegneserie eller lignende ved å tegne tekst og grafiske lydeffekter."],"tr":["Bir anlatımı, metni ve grafik ses efektlerini çizerek bir çizgi roman, grafik roman vb. anlatımına katkıda bulunan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过绘制文字和图案声音效果的为漫画书、图解小说等的一种内容表达作出贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة رسَّامة حروف","ca":"entitat corporativa retolista","cs":"letrážista (korporace)","da":"korporation, som er bogstavtegner","de":"Letterer (Körperschaft)","de":"Letterer (Körperschaft)","en":"letterer corporate body","es":"organismo corporativo rotulista","et":"tekstijoonistaja (asutus)","fi":"tekstaaja (yhteisö)","fr":"collectivité lettreuse","hu":"betűrajzoló testület:","lv":"komiksa teksta rakstītājs (institūcija)","nl":"letteraar-corporatie","no":"letterer (korporasjon)","tr":"Hat sanatçısı tüzel kişisi","zh-Hans-CN":"字母图案画者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في كتاب مصور، أو رواية مصورة، إلخ. من خلال رسم النص وتصميم المؤثرات الصوتية للرسومات.","ca":"Entitat corporativa que contribueix a una expressió d’un còmic, una novel·la gràfica, etc., dibuixant el text i els efectes sonors gràfics.","cs":"Korporace, která přispívá k vyjádření komiksu, grafického románu atd. tím, že kreslí text a grafické zvukové efekty.","da":"Korporation, som er illustrator, som bidrager til et udtryk af en tegneserie, en graphic novel etc. ved at tegne teksten og de grafiske lydeffekter.","de":"Eine Körperschaft, die zu einer Expression eines Comicbuchs, einer Graphic Novel und so weiter beiträgt, indem sie den Text und die grafischen Toneffekte zeichnet.","de":"Eine Körperschaft, die zu einer Expression eines Comicbuchs, einer Graphic Novel und so weiter beiträgt, indem sie den Text und die grafischen Toneffekte zeichnet.","en":"A corporate body who contributes to an expression of a comic book, graphic novel, etc., by drawing the text and graphic sound effects.","es":"Un organismo corporativo que contribuye a una expresión de un libro de cómics, novela gráfica, etc., dibujar texto y efectos de sonido gráficos.","et":"Asutus, kes illustreerijana annab panuse koomiksi, graafilise romaani vms väljendusse, joonistades teksti ja graafilisi helijäljendusi.","fi":"Yhteisö, joka osallistuu sarjakuvan, sarjakuvaromaanin tms. ekspression tekemiseen piirtämällä tekstin ja graafiset äänitehosteet.","fr":"Collectivité qui contribue à une expression d’une bande dessinée, d’un roman graphique, etc. en dessinant le texte et les effets sonores graphiques.","hu":"Egy testület, amely hozzájárul egy képregényhez, képregényalbumhoz, stb., azzal, hogy megrajzolja a szöveget és a grafikus hangeffektusokat.","lv":"Institūcija, kas sniegusi ieguldījumu komiksu grāmatas, grafiskā romāna u.tml. izteiksmē, zīmējot tekstu un skaņu efektus grafiskā formā.","nl":"Een corporatie die bijdraagt aan een expressie van een comic, stripboek etc. door het tekenen van tekst en grafische geluidseffecten.","no":"En korporasjon som er en illustratør som bidrar til et uttrykk av en tegneserie eller lignende ved å tegne tekst og grafiske lydeffekter.","tr":"Bir çizgi roman, grafik roman vb. bir eserin ifadesine, metin ve grafik ses efektlerini çizerek katkıda bulunan bir tüzel kişi.","zh-Hans-CN":"通过绘制文字和图案声音效果的为漫画书、图解小说等的一种内容表达作出贡献的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "la