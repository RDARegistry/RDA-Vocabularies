                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20105", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentedByExpression.en", "label":"is augmented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/addendaExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20109", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/addendaExpression.en", "label":"has addenda expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20109", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/addendaExpression.en", "label":"has addenda expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20177","label":{"ar":"هي إضافة لتعبيرة","ca":"és addenda a una expressió","cs":"je addendy k vyjádření","da":"er tillæg til udtryk","de":"ist Ergänzung zu (Expression)","de":"ist Ergänzung zu (Expression)","el":"είναι προσθήκες στην (έκφραση)","en":"is addenda to expression","es":"es un complemento a la expresión","et":"lisa väljendusele","fi":"lisäykset ekspressioon","fr":"est un addenda d’une expression","hu":"pótlás a következő kifejezési formához:","lv":"ir saturisks pielikums izteiksmei","nl":"is toevoegingen bij expressie","no":"er tillegg til uttrykk","tr":"anlatıma ektir","vi":"là phần thêm của (biểu hiện)","zh-Hans-CN":"是内容表达的补遗"},"definition":{"ar":["تربط بين وتعبيرة وتعبيرة لعمل يكتمل محتواه بمحتوى موجز من تعبيرة عمل ذي صلة."],"ca":["Relaciona una expressió amb una expressió d’una obra el contingut de la qual es complementa amb un contingut breu d’una expressió d’una obra relacionada."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah je doplněn stručným obsahem sestávajícím z vyjádření souvisejícího díla."],"da":["Relaterer et udtryk til et udtryk af et værk, hvis indhold er fuldbragt med kortfattet indhold fra et udtryk af et relateret værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt durch kurzen Inhalt einer Expression eines in Beziehung stehenden Werks vervollständigt wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt durch kurzen Inhalt einer Expression eines in Beziehung stehenden Werks vervollständigt wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου του οποίου το περιεχόμενο συμπληρώνεται με σύντομο περιεχόμενο από μια έκφραση ενός άλλου έργου."],"en":["Relates an expression to an expression of a work whose content is completed with brief content from an expression of a related work."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido se completa con un contenido breve de una expresión de una obra relacionada."],"et":["Seostab väljenduse teose väljendusega, mille sisu saab terviklikuks koos seotud teose väljenduse lühikese sisuga."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisältöä täydennetään suppealla sisällöllä siihen liittyvän teoksen ekspressiosta."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu est complété par le bref contenu d’une expression d’une œuvre en relation."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek tartalmát egy kapcsolódó mű kifejezési formájának rövid tartalmával teszik teljessé."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kuras saturs ir pilnveidots ar īsu saturu no saistīta darba izteiksmes."],"nl":["Relateert een expressie aan een expressie van een werk waarvan de content gecompleteerd wordt met korte content uit een expressie van een gerelateerd werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk hvis innhold utfylles av kortfattet innhold fra et uttrykk av et relatert verk."],"tr":["Bir anlatımı, içeriği ilgili bir eserin anlatımından alınan kısa bir içerikle tamamlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm mà nội dung được hoàn thành với nội dung rút gọn từ biểu hiện của tác phẩm khác."],"zh-Hans-CN":["将一种内容表达与其内容加上一种相关作品的一种内容表达之简要内容后就完整的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"إضافة لتعبيرة","ca":"addenda a una expressió","cs":"addenda k vyjádření","da":"tillæg til udtryk","de":"Ergänzung zu (Expression)","de":"Ergänzung zu (Expression)","el":"προσθήκες στην (έκφραση)","en":"addenda to expression","es":"adiciones a la expresión","et":"lisa väljendusele","fi":"lisäykset ekspressioon","fr":"addenda d’une expression","hu":"pótlás kifejezési formához:","lv":"saturisks pielikums izteiksmei","nl":"toevoegingen bij expressie","no":"tillegg til uttrykk","tr":"Anlatıma ek","vi":"phần thêm của (biểu hiện)","zh-Hans-CN":"内容表达的补遗"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يكتمل محتواه بمحتوى موجز من تعبيرة عمل ذي صلة.","ca":"Expressió d’una obra el contingut de la qual es complementa amb un contingut breu d’una expressió d’una obra relacionada.","cs":"Vyjádření díla, jehož obsah je doplněn stručným obsahem sestávajícím z vyjádření souvisejícího díla.","da":"Udtryk af et værk, hvis indhold er fuldbragt med kortfattet indhold fra et udtryk af et relateret værk.","de":"Eine Expression eines Werks, deren Inhalt durch kurzen Inhalt einer Expression eines in Beziehung stehenden Werks vervollständigt wird.","de":"Eine Expression eines Werks, deren Inhalt durch kurzen Inhalt einer Expression eines in Beziehung stehenden Werks vervollständigt wird.","el":"Μια έκφραση ενός έργου του οποίου το περιεχόμενο συμπληρώνεται με σύντομο περιεχόμενο από μια έκφραση ενός άλλου έργου.","en":"An expression of a work whose content is completed with brief content from an expression of a related work.","es":"Una expresión de una obra cuyo contenido se completa con un contenido breve de una expresión de una obra relacionada.","et":"Teose väljendus, mille sisu saab terviklikuks koos seotud teose väljenduse lühikese sisuga.","fi":"Teoksen ekspressio, jonka sisältöä täydennetään suppealla sisällöllä siihen liittyvän teoksen ekspressiosta.","fr":"Expression d’une œuvre dont le contenu est complété par le bref contenu d’une expression d’une œuvre en relation.","hu":"Egy mű kifejezési formája, amelynek tartalmát egy kapcsolódó mű kifejezési formájának rövid tartalmával teszik teljessé.","lv":"Darba izteiksme, kuras saturs ir pilnveidots ar īsu saturu no saistīta darba izteiksmes.","nl":"Een expressie van een werk waarvan de content gecompleteerd wordt met korte content uit een expressie van een gerelateerd werk.","no":"Et uttrykk av et verk hvis innhold utfylles av kortfattet innhold fra et uttrykk av et relatert verk.","tr":"İçeriği, ilgili bir eserin anlatımından alınan kısa bir içerikle tamamlanan bir eserşn anlatımı.","vi":"Biểu hiện của tác phẩm mà nội dung được hoàn thành với nội dung rút gọn từ biểu hiện của tác phẩm khác.","zh-Hans-CN":"其内容加上一种相关作品的一种内容表达之简要内容后就完整的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
