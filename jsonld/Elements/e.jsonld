                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20448", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCollectiveAgentOfExpression.en", "label":"has creator collective agent of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20037", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorAgent.en", "label":"has translator agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20464", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCorporateBody.en", "label":"has translator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20523", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorFamily.en", "label":"has translator family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20405", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/translatorCollectiveAgent.en", "label":"has translator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20405", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/translatorCollectiveAgent.en", "label":"has translator collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20464","label":{"ar":"لها هيئة مترجمة","ca":"té com a entitat corporativa traductora","cs":"má překladatele (korporaci)","da":"har korporation, som er oversætter","de":"hat Übersetzerin/Übersetzer (Körperschaft)","de":"hat Übersetzerin/Übersetzer (Körperschaft)","en":"has translator corporate body","es":"tiene organismo corporativo traductor","et":"tõlkija (asutus)","fi":"kääntäjä (yhteisö)","fr":"a pour collectivité traductrice","hu":"fordító testülete a következő:","lv":"tulkotājs (institūcija)","nl":"heeft vertaler-corporatie","no":"har oversetter (korporasjon)","tr":"çevirmen tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有译者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla."],"da":["Relaterer et udtryk til en korporation, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet."],"en":["Relates an expression to a corporate body who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión al expresar el contenido lingüístico de la obra en un lenguaje diferente."],"et":["Seostab väljenduse asutusega, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest."],"fi":["Liittää ekspression yhteisöön, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáitól eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk."],"no":["Relaterer et uttrykk til en korporasjon som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket."],"tr":["Bir anlatımı, eserin dilsel içeriğini orijinal eserin önceki anlatımlarından farklı bir dilde ifade ederek anlatıma katkıda bulunan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مترجمة","ca":"entitat corporativa traductora","cs":"překladatel (korporace)","da":"korporation, som er oversætter","de":"Übersetzerin/Übersetzer (Körperschaft)","de":"Übersetzerin/Übersetzer (Körperschaft)","en":"translator corporate body","es":"organismo corporativo traductor","et":"tõlkija (asutus)","fi":"kääntäjä (yhteisö)","fr":"collectivité traductrice","hu":"fordító testület:","lv":"tulkotājs (institūcija)","nl":"vertaler-corporatie","no":"oversetter (korporasjon)","tr":"tercüman tüzel kişi","zh-Hans-CN":"译者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي.","ca":"Entitat corporativa que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original.","cs":"Korporace, která přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla.","da":"Korporation, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.","de":"Eine Körperschaft, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.","en":"A corporate body who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work.","es":"Un organismo corporativo que contribuye a una expresión al expresar el contenido lingüístico de la obra en un lenguaje diferente.","et":"Asutus, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest.","fi":"Yhteisö, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä.","fr":"Collectivité qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale.","hu":"Egy testület, amely egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáitól eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához.","lv":"Institūcija, kas sniegusi ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm.","nl":"Een corpora