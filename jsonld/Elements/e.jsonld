ressió."],"cs":["Vztahuje vyjádření k agentovi, který je spojený s vyjádřením."],"da":["Relaterer et udtryk til en agent, som er knyttet til udtryk."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der mit einer Expression in Verbindung steht.,Setzt eine Expression in Beziehung zu einem Akteur, der mit einer Expression in Verbindung steht."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνδέεται με μια περιγραφόμενη έκφραση."],"en":["Relates an expression to an agent who is associated with an expression."],"es":["Relaciona una expresión con un agente que está asociado con una expresión."],"et":["Seostab väljenduse väljendusega seotud tegijaga."],"fi":["Liittää ekspression toimijaan, joka liittyy ekspressioon."],"fr":["Met une expression en relation avec un agent qui est associé à une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához kapcsolódó ágenshez."],"lv":["Sasaista izteiksmi ar aģentu, kas saistīts ar izteiksmi."],"nl":["Relateert een expressie aan een actor die geassocieerd is met een expressie."],"no":["Relaterer et uttrykk til en agent som forbindes med et uttrykk."],"tr":["Bir anlatımı, anlatımla bağlantılı olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân liên quan tới biểu hiện đang được mô tả."],"zh-Hans-CN":["将一种内容表达与和一种内容表达有关的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مرتبط بتعبيرة","ca":"agent relacionat amb una expressió","cs":"agent související s vyjádřením","da":"agent relateret til udtryk","de":"mit Expression in Beziehung stehender Akteur","de":"mit Expression in Beziehung stehender Akteur","en":"related agent of expression","es":"agente de expresión relacionado","et":"väljendusega seotud tegija","fi":"ekspressioon liittyvä toimija","fr":"agent en relation avec une expression","hu":"kifejezési formához kapcsolódó ágens:","lv":"ar izteiksmi saistītais aģents","nl":"gerelateerde actor van expressie","no":"agent relatert til uttrykk","tr":"Anlatımla ilişkili temsilci","zh-Hans-CN":"内容表达的关联行为者"},"ToolkitDefinition":{"ar":"وكيل مرتبط بتعبيرة.","ca":"Agent que s’associa amb una expressió.","cs":"Agent, který je spojený s vyjádřením.","da":"Agent, som er knyttet til et udtryk.","de":"Ein Akteur, der mit einer Expression in Verbindung steht.","de":"Ein Akteur, der mit einer Expression in Verbindung steht.","en":"An agent who is associated with an expression.","es":"Un agente que está asociado con una expresión.","et":"Väljendusega seotud tegija.","fi":"Toimija, joka liittyy ekspressioon.","fr":"Agent qui est associé à une expression.","hu":"Egy kifejezési formához kapcsolódó ágens.","lv":"Aģents, kas saistīts ar izteiksmi.","nl":"Een actor die geassocieerd is met een expressie.","no":"En agent som forbindes med et uttrykk.","tr":"Bir ifade ile bağlantılı olan bir temsilci.","zh-Hans-CN":"和一种内容表达有关的一个行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
