                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/incidentalMusicExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20243", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicExpression.en", "label":"has music expression"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20085", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/incidentalMusicExpression.en", "label":"has incidental music expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20085", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/incidentalMusicExpression.en", "label":"has incidental music expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20103","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مثل مسرحية أو عمل منطوق آخر للمسرح يستخدم عمل موسيقي كموسيقى تصويرية."],"ca":["Relaciona una expressió amb una expressió d’una obra com ara una obra de teatre o qualsevol altra obra escènica parlada que usa una obra musical com a música incidental."],"cs":["Vztahuje vyjádření k vyjádření díla jako je divadelní hra nebo jiné slovesné dílo pro jeviště, které využívá hudební dílo jako scénickou hudbu."],"da":["Relaterer et udtryk til et udtryk af et værk, såsom et skuespil eller et andet talt sceneværk, som anvender et musikværk som ledsagemusik."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, zum Beispiel ein Drama oder ein anderes, gesprochenes Bühnenwerk, die ein Musikwerk als Bühnenmusik verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, zum Beispiel ein Drama oder ein anderes, gesprochenes Bühnenwerk, die ein Musikwerk als Bühnenmusik verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου, όπως ένα θεατρικό έργο ή άλλο έργο με προφορικό λόγο για τη σκηνή, το οποίο χρησιμοποιεί ένα μουσικό έργο ως μουσική του τυχαίου."],"en":["Relates an expression to an expression of a work such as a play or other spoken work for the stage that uses a musical work as incidental music."],"es":["Relaciona una expresión con una expresión de una obra como una obra de teatro u otra obra hablada para el escenario que utiliza una obra musical como música incidental."],"et":["Seostab väljenduse näidendi või muu kõnena realiseeritud lavateose väljendusega, milles on kasutatud muusikateost saatemuusikana."],"fi":["Liittää ekspression teoksen, kuten näytelmän tai muun puhutun näyttämöteoksen, ekspressioon, joka käyttää musiikkiteosta näytelmämusiikkina."],"fr":["Met une expression en relation avec une expression d’une œuvre telle qu’une pièce de théâtre ou une autre œuvre parlée pour la scène qui utilise une œuvre musicale comme musique de scène."],"hu":["Hozzákapcsol egy kifejezési formát egy olyan mű kifejezési formájához, mint például egy színdarab vagy egyéb színpadi beszélt mű, amely egy zeneművet kísérőzenének használ."],"lv":["Sasaista izteiksmi ar darba izteiksmi, piemēram, teātra izrāde vai cits skatuves darbs, kurā mūzikas darbs izmantots kā fona mūzika."],"nl":["Relateert een expressie aan een expressie van een werk zoals een toneelstuk of ander gesproken woord-werk voor het podium dat een muziekwerk gebruikt als toneelmuziek."],"no":["Relaterer et uttrykk til et uttrykk av et verk som et skuespill eller annet sceneverk for muntlig fremføring, som bruker et musikalsk verk som bakgrunnsmusikk."],"tr":["Bir anlatımı, bir müzik eserini fon müziği olarak kullanan sahne için bir tiyatro oyunu veya başka bir sözlü eser gibi bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm như là kịch hoặc tác phẩm nói khác cho sân khấu có sử dụng âm nhạc làm nhạc nền."],"zh-Hans-CN":["将一种内容表达与使用一种音乐作品作为配乐的诸如戏剧或其他舞台口头作品的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"موسيقي تصويرية لتعبيرة","ca":"música incidental per a una expressió","cs":"scénická hudba k vyjádření","da":"ledsagemusik til udtryk","de":"Bühnenmusik für (Expression)","de":"Bühnenmusik für (Expression)","el":"μουσική του τυχαίου για (έκφραση)","en":"incidental music for expression","es":"música incidental para la expresión","et":"näidendimuusika väljendusele","fi":"näytelmämusiikki ekspressioon","fr":"musique de scène pour une expression","hu":"kísérőzene a következő kifejezési formához:","lv":"uzveduma fona mūzika izteiksmei","nl":"toneelmuziek voor expressie","no":"bakgrunnsmusikk for uttrykk","tr":"anlatımın fon müziğidir","vi":"nhạc nền cho (biểu hiện)","zh-Hans-CN":"内容表达的配乐"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مثل مسرحية أو عمل منطوق آخر للمسرح يستخدم عمل موسيقي كموسيقى تصويرية.","ca":"Expressió d’una obra com ara una obra de teatre o qualsevol altra obra escènica parlada que usa una obra musical com a música incidental.","cs":"Vyjádření díla jako je divadelní hra nebo jiné slovesné dílo pro jeviště, které využívá hudební dílo jako scénickou hudbu.","da":"Udtryk af et værk, såsom et skuespil eller et andet talt sceneværk, som anvender et musikværk som ledsagemusik.","de":"Eine Expression eines Werks, zum Beispiel ein Drama oder ein anderes, gesprochenes Bühnenwerk, die ein Musikwerk als Bühnenmusik verwendet.","de":"Eine Expression eines Werks, zum Beispiel ein Drama oder ein anderes, gesprochenes Bühnenwerk, die ein Musikwerk als Bühnenmusik verwendet.","el":"Μια έκφραση ενός έργου, όπως ένα θεατρικό έργο ή άλλο έργο με προφορικό λόγο για τη σκηνή, το οποίο χρησιμοποιεί ένα μουσικό έργο ως μουσική του τυχαίου.","en":"An expression of a work such as a play or other spoken work for the stage that uses a musical work as incidental music.","es":"Una expresión de una obra como una obra de teatro u otra obra hablada para el escenario que utiliza una obra musical como música incidental.","et":"Näidendi või muu kõnena realiseeritud lavateose väljendus, milles on kasutatud muusikateost saatemuusikana.","fi":"Teoksen, kuten näytelmän tai muun puhutun näyttämöteoksen, ekspressio, joka käyttää musiikkiteosta näytelmämusiikkina.","fr":"Expression d’une œuvre telle qu’une pièce de théâtre ou une autre œuvre parlée pour la scène qui utilise une œuvre musicale comme musique de scène.","hu":"Egy olyan mű kifejezési formája, mint például egy színdarab vagy egyéb színpadi beszélt mű, amely egy zeneművet kísérőzenének használ.","lv":"Darba izteiksme, piemēram, teātra izrāde vai cits skatuves darbs, kurā mūzikas darbs izmantots kā fona mūzika.","nl":"Een expressie van een werk zoals een toneelstuk of ander gesproken woord-werk voor het podium dat een muziekwerk gebruikt als toneelmuziek.","no":"Et uttrykk av et verk som et skuespill eller annet sceneverk for muntlig fremføring, som bruker et musikalsk verk som bakgrunnsmusikk.","tr":"Sahne için bir müzik eserini tesadüfi müzik olarak kullanan bir oyun veya başka bir sözlü eser gibi bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm như là kịch hoặc tác phẩm nói khác cho sân khấu có sử dụng âm nhạc làm nhạc nền.","zh-Hans-CN":"使用一种音乐作品作为配乐的诸如戏剧或其他舞台口头作品的一种作品的一种内容表达"},"label":{"ar":"هي موسيقي تصويرية لتعبيرة","ca":"és música incidental per a una expressió","cs":"je scénickou hudbou k vyjádření","da":"er ledsagemusik til udtryk","de":"ist Bühnenmusik für (Expression)","de":"ist Bühnenmusik für (Expression)","el":"είναι μουσική του τυχαίου για (έκφραση)","en":"is incidental music for expression","es":"es música incidental para la expresión","et":"näidendimuusika väljendusele","fi":"näytelmämusiikki ekspressioon","fr":"est une musique de scène pour une expression","hu":"kísérőzene kifejezési formához:","lv":"ir uzveduma fona mūzika izteiksmei","nl":"is toneelmuziek voor expressie","no":"er bakgrunnsmusikk for uttrykk","tr":"anlatım için fon müziğidir","vi":"là nhạc nền cho (biểu hiện)","zh-Hans-CN":"是内容表达的配乐"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/incidentalMusicForExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForExpression.en", "label":"is music for expression"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20103", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/incidentalMusicForExpression.en", "label":"is incidental music for expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20103", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/incidentalMusicForExpression.en", "label":"is incidental music for expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20005","definition":{"ar":["تربط بين تعبيرة وإقرار رسمي بالامتياز أو مزية أخرى تقدمه هيئة مانحة للجوائز أو المنح، لمحتوى تعبيرة."],"ca":["Relaciona una expressió amb un reconeixement formal d’excel·lència o de qualsevol altre mèrit del contingut d’una expressió, concedit per un organisme amb capacitat de concedir premis."],"cs":["Vztahuje vyjádření k formálnímu uznání vynikající kvality nebo jiné hodnoty za obsah vyjádření, udělovanému orgánem, který uděluje ocenění nebo ceny."],"da":["Relaterer et udtryk til en formel anerkendelse af fortræffelig kvalitet eller anden fortjeneste, givet af en prisuddelende institution for indholdet af et udtryk."],"de":["Setzt eine Expression in Beziehung zu einer formalen Anerkennung von herausragenden Fähigkeiten oder Leistungen, die durch eine auszeichnende oder Preis vergebende Körperschaft für den Inhalt einer Expression verliehen wird.,Setzt eine Expression in Beziehung zu einer formalen Anerkennung von herausragenden Fähigkeiten oder Leistungen, die durch eine auszeichnende oder Preis vergebende Körperschaft für den Inhalt einer Expression verliehen wird."],"el":["Συνδέει μια έκφραση με μια επίσημη αναγνώριση της διάκρισης κ.λπ. η οποία δίνεται από έναν χορηγό βραβείου ή επάθλου για το περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to a formal recognition of excellence or other merit given by an award- or prize-granting body, for the content of an expression."],"es":["Relaciona una expresión con un reconocimiento formal de excelencia u otro mérito otorgado por un organismo que otorga un premio o reconocimiento, por el contenido de una expresión."],"et":["Seostab väljenduse ametliku tunnustusega, mille autasu määrav asutus on väljenduse sisu eest andnud."],"fi":["Liittää ekspression tunnustuksen tai palkinnon myöntävän yhteisön antamaan laadukkuuden tai muiden ansioiden muodolliseen tunnustukseen ekspression sisällöstä."],"fr":["Met une expression en relation avec une reconnaissance officielle d’excellence ou d’une autre forme de mérite accordée au contenu d’une expression par une collectivité octroyant une récompense ou un prix."],"hu":["Hozzákapcsol egy kifejezési formát a kiválóság vagy más érdem hivatalos elismeréséhez, amelyet egy kitüntetés- vagy díjosztó testület ad egy forrás tartalmáért."],"lv":["Sasaista izteiksmi ar oficiāla atzinību par resursa satura izcilību, u.tml., kur balvas vai godalgas pasniedz piešķirējinstitūcija."],"nl":["Relateert een expressie aan een formele erkenning van uitmuntendheid of andere verdienste gegeven door een prijsuitreikende instantie, voor de content van een expressie."],"no":["Relaterer et uttrykk til en formell anerkjennelse av høy kvalitet, etc., tildelt av en pristildelende korporasjon for innholdet i et uttrykk."],"tr":["Bir anlatımı, içeriği için bir ödül veren kuruluş tarafından verilen mükemmelliğin veya diğer meziyetlerin resmi olarak tanınmasıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với công nhận chính thức về thành tựu, v.v..., được đưa ra bởi cơ quan công nhận giải thưởng hoặc phần thưởng cho nội dung của biểu hiện."],"zh-Hans-CN":["将一种内容表达与颁奖或奖金发放机构对内容表达之内容的优秀性等给予的正式认可关联起来。"]},"ToolkitLabel":{"ar":"جائزة","ca":"premi","cs":"ocenění","da":"udmærkelse","de":"Auszeichnung","de":"Auszeichnung","el":"βραβείο","en":"award","es":"premio","et":"autasu","fi":"palkinto","fr":"prix","hu":"kitüntetése:","lv":"apbalvojums","nl":"prijs","no":"pris","sv":"utmärkelse","tr":"ödül","vi":"giải thưởng","zh-Hans-CN":"奖项"},"ToolkitDefinition":{"ar":"إقرار رسمي بالامتياز أو مزية أخرى تقدمه هيئة مانحة للجوائز أو المنح، لمحتوى تعبيرة.","ca":"Reconeixement formal d’excel·lència o de qualsevol altre mèrit del contingut d’una expressió, concedit per un organisme amb capacitat de concedir premis.","cs":"Formální uznání vynikající kvality nebo jiné hodnoty za obsah vyjádření, udělovanému orgánem, který uděluje ocenění nebo ceny.","da":"Formel anerkendelse af fortræffelig kvalitet eller anden fortjeneste, givet af en prisuddelende institution for indholdet af et udtryk.","de":"Eine formale Anerkennung von herausragenden Fähigkeiten oder Leistungen, die durch eine auszeichnende oder Preis vergebende Körperschaft für den Inhalt einer Expression verliehen wird.","de":"Eine formale Anerkennung von herausragenden Fähigkeiten oder Leistungen, die durch eine auszeichnende oder Preis vergebende Körperschaft für den Inhalt einer Expression verliehen wird.","el":"Μια επίσημη αναγνώριση της διάκρισης κ.λπ. η οποία δίνεται από έναν χορηγό βραβείου ή επάθλου για το περιεχόμενο μιας έκφρασης.","en":"A formal recognition of excellence or other merit given by an award- or prize-granting body, for the content of an expression.","es":"Un reconocimiento formal de excelencia u otro mérito otorgado por un organismo que otorga premios o reconocimientos, por el contenido de una expresión.","et":"Ametlik tunnustus, mille autasu määrav asutus on väljenduse sisu eest andnud.","fi":"Tunnustuksen tai palkinnon myöntävän yhteisön antama laadukkuuden tai muiden ansioiden muodollinen tunnustus ekspression sisällöstä.","fr":"Reconnaissance officielle d’excellence ou d’une autre forme de mérite accordée au contenu d’une expression par une collectivité octroyant une récompense ou un prix.","hu":"A kiválóság vagy más érdem hivatalos elismerése, amelyet egy kitüntetés- vagy díjosztó testület ad egy forrás tartalmáért.","lv":"Oficiāla atzinība par resursa satura izcilību, u.tml., kur balvas vai godalgas pasniedz piešķirējinstitūcija.","nl":"Een formele erkenning van uitmuntendheid of andere verdienste gegeven door een prijsuitreikende instantie, voor de content van een expressie.","no":"En formell anerkjennelse av høy kvalitet, etc., tildelt av en pristildelende korporasjon for innholdet i et uttrykk.","tr":"Bir anlatımın içeriği için, ödül veya yarışma düzenleyen bir kuruluş tarafından verilen mükemmeliyet ya da başka bir başarıya dair resmi bir takdir.","vi":"Công nhận chính thức về sự xuất sắc, vv..., đối với nội dung của một nguồn lực được đưa ra bởi một cơ quan tặng tài trợ giải thưởng hoặc phần thưởng.","zh-Hans-CN":"颁奖或奖金发放机构对内容表达之内容的优秀性等给予的正式认可"},"label":{"ar":"لها جائزة","ca":"té com a premi","cs":"má ocenění","da":"har udmærkelse","de":"hat Auszeichnung","de":"hat Auszeichnung","el":"έχει βραβείο","en":"has award","es":"tiene premio","et":"autasu","fi":"palkinto","fr":"a pour prix","hu":"kitüntetése a következő:","lv":"apbalvojums","nl":"heeft prijs","no":"har pris","sv":"har utmärkelse","tr":"ödül ile ilişkilidir","vi":"cógiải thưởng","zh-Hans-CN":"有奖项"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/award.en","instructionNumber":"7.28","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20005", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/award.en", "label":"has award"}]},{"@id":"http://rdaregistry.info/Elements/e/P20193","label":{"ar":"هي استخلاصات لتعبيرة","ca":"és resums per a una expressió","cs":"je abstraktem pro vyjádření","da":"er sammenfatninger af udtryk","de":"ist Abstracts für (Expression)","de":"ist Abstracts für (Expression)","el":"είναι επιτομές για (έκφραση)","en":"is abstracts for expression","es":"son resúmenes para expresión","et":"annotatsioonid väljendusele","fi":"abstraktit ekspressiosta","fr":"consiste en résumés analytiques pour une expression","hu":"kivonatok a következő kifejezési formához:","lv":"ir rezumējums izteiksmei","nl":"is abstracts voor expressie","no":"er sammendrag for uttrykk","tr":"anlatımı özetler","vi":"là tóm tắt của (biểu hiện)","zh-Hans-CN":"是内容表达的摘要"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل محتواه مضاف بواسطة تعبيرة ذات صلة."],"ca":["Relaciona una expressió amb una expressió d’una obra els continguts de la qual han estat resumits per un servei de resums i índexs."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah byl abstrahován abstrahujícím a indexačním aparátem."],"da":["Relaterer et udtryk til et udtryk af et værk, hvis indhold er blevet sammenfattet af en abstracts- og indekseringstjeneste."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalte durch einen Abstract- und Indexierungsdienst zusammengefasst wurden.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalte durch einen Abstract- und Indexierungsdienst zusammengefasst wurden."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου του οποίου τα περιεχόμενα συνοψίζονται από μια υπηρεσία επιτομής και ευρετηρίασης."],"en":["Relates an expression to an expression of a work whose contents have been abstracted by an abstracting and indexing service."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido ha sido resumido por un servicio de indexación y resúmenes."],"et":["Seostab väljenduse teose väljendusega, mille sisu on annoteeritud annoteerimis- ja indekseerimisteenuses."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisällön tiivistelmä- ja indeksointipalvelu on abstrahoinut."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu a été résumé par un service d’analyse et d’indexation."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek a tartalmát egy kivonatoló és indexáló szolgáltatás kivonatolta."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kuras saturu anotējis anotēšanas un indeksēšanas dienests."],"nl":["Relateert een expressie aan een expressie van een werk waarvan de inhoud is geabstraheerd door een samenvattings- en indexeerdienst."],"no":["Relaterer et uttrykk til et uttrykk av et verk hvis innhold en indekseringstjeneste eller en tjeneste som lager sammendrag, har laget sammendrag av."],"tr":["Bir anlatımı, içeriği özetleme ve dizinleme hizmeti tarafından özetlenmiş bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm mà nội dung được làm tóm tắt bởi dịch vụ làm tóm tắt và định chủ đề."],"zh-Hans-CN":["将一种内容表达与其内容已被文摘和索引服务编制摘要的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"استخلاصات لتعبيرة","ca":"resums per a una expressió","cs":"abstrakt pro vyjádření","da":"sammenfatninger af udtryk","de":"Abstracts für (Expression)","de":"Abstracts für (Expression)","el":"επιτομές για (έκφραση)","en":"abstracts for expression","es":"resúmenes para la expresión","et":"annotatsioonid väljendusele","