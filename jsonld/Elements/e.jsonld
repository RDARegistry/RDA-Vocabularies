                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20383", "lexicalAlias":"http://rdaregistry.info/Elements/e/conductorPerson.en", "label":"has conductor person"},{"@id":"http://rdaregistry.info/Elements/e/P20285", "lexicalAlias":"http://rdaregistry.info/Elements/e/choralConductorAgent.en", "label":"has choral conductor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20336", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/choralConductorPerson.en", "label":"has choral conductor person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20336", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/choralConductorPerson.en", "label":"has choral conductor person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20221","ToolkitDefinition":{"en":"The presence of colour, tone, etc., in a resource designed for persons with visual impairments. Colour content of resources designed for persons with visual impairments is also the specific colours, tones, etc., (excluding black and white) present in a resource designed for persons with visual impairments. (Deprecated)"},"ToolkitLabel":{"en":"Colour content of resource designed for persons with visual impairments (Deprecated)"},"definition":{"en":["Relates an expression to the presence of colour, tone, etc., in a resource designed for persons with visual impairments. colour content of resources designed for persons with visual impairments is also the specific colours, tones, etc., (excluding black and white) present in a resource designed for persons with visual impairments. (Deprecated)"]},"label":{"en":"has colour content of resource designed for persons with visual impairments (Deprecated)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20224", "lexicalAlias":"http://rdaregistry.info/Elements/e/colourContent.en", "label":"has colour content (Deprecated)"}],"instructionNumber":"7.17.5","lexicalAlias":"http://rdaregistry.info/Elements/e/colourContentOfResourceDesignedForPersonsWithVisualImpairments.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20283","label":{"ar":"لها وكيل رسام","ca":"té com a agent colorista","cs":"má koloristu (agenta)","da":"har agent, som er farvelægger","de":"hat Koloristin/Kolorist (Akteur)","de":"hat Koloristin/Kolorist (Akteur)","el":"έχει κολορίστα","en":"has colourist agent","es":"tiene agente colorista","et":"koloreerija (tegija)","fi":"värittäjä (toimija)","fr":"a pour agent coloriste","hu":"colorist ágense a következő:","lv":"kolorists (aģents)","nl":"heeft inkleurder-actor","no":"har fargelegger (agent)","tr":"renklendirici temsilci ile ilişkilidir","vi":"có người tô màu","zh-Hans-CN":"有着色者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال تلوين الرسومات، أو المطبوعات، أو الصور الفوتوغرافية، أو الخرائط، أو الصور المتحركة، أو أي محتوى آخر."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment o altre contingut."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření nanášením barev na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at farvelægge tegninger, tryk, fotos, kort, levende billeder eller andet indhold."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της εφαρμογής χρωμάτων στα σχέδια, τα σκίτσα, τις εκτυπώσεις, τις φωτογραφίες, τους χάρτες, τις κινητές εικόνες κ.λπ."],"en":["Relates an expression to an agent who contributes to an expression by applying colour to drawings, prints, photographs, maps, moving images, or other content."],"es":["Relaciona una expresión con un agente que contribuye a una expresión aplicando color a dibujos, impresiones, fotografías, mapas, imágenes en movimiento u otro contenido."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte vms."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, elokuvia tai muuta sisältöä."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en appliquant de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées ou d’autres contenus."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy színt hord fel rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más tartalmakra."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, izkrāsojot zīmējumus, gravīras, fotogrāfijas, kartes, kustīgus attēlus, u.tml."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden of andere content."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk ved å fargelegge tegninger, trykk, fotografier, kart, levende bilder, etc."],"tr":["Bir anlatımı çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere veya diğer içeriğe renk uygulayarak anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách tô màu cho bản vẽ, bản in, bức ảnh, bản đồ, hình ảnh động, v.v..."],"zh-Hans-CN":["将一种内容表达与通过将颜色施加于图画、印刷品、照片、地图、动态图像或其他内容上而对一种内容表达作出贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل رسام","ca":"agent colorista","cs":"kolorista (agent)","da":"agent, som er farvelægger","de":"Koloristin/Kolorist (Akteur)","de":"Koloristin/Kolorist (Akteur)","el":"κολορίστας","en":"colourist agent","es":"agente colorista","et":"koloreerija (tegija)","fi":"värittäjä (toimija)","fr":"agent coloriste","hu":"colorist ágens:","lv":"kolorists (aģents)","nl":"inkleurder-actor","no":"fargelegger (agent)","tr":"renklendirici temsilcisi","vi":"người tô màu","zh-Hans-CN":"着色者行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال تلوين الرسومات، أو المطبوعات، أو الصور الفوتوغرافية، أو الخرائط، أو الصور المتحركة، أو أي محتوى آخر.","ca":"Agent que contribueix a una expressió aplicant color a dibuixos, gravats, fotografies, mapes, imatges en moviment o altre contingut.","cs":"Agent, který přispívá k vyjádření nanášením barev na kresby, tisky, fotografie, mapy, filmy nebo jiný obsah.","da":"Agent, som bidrager til et udtryk ved at farvelægge tegninger, tryk, fotos, kort, levende billeder eller andet indhold.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er Farben auf Zeichnungen, Drucke, Fotografien, Karten, Bewegtbilder oder anderes aufbringt.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της εφαρμογής χρωμάτων στα σχέδια, τα σκίτσα, τις εκτυπώσεις, τις φωτογραφίες, τους χάρτες, τις κινητές εικόνες κ.λπ.","en":"An agent who contributes to an expression by applying colour to drawings, prints, photographs, maps, moving images, or other content.","es":"Un agente que contribuye a una expresión aplicando color a dibujos, impresiones, fotografías, mapas, imágenes en movimiento u otro contenido.","et":"Tegija, kes annab panuse väljendusse, värvides joonistusi, tõmmiseid, fotosid, kaarte, liikuvaid pilte vms.","fi":"Toimija, joka osallistuu ekspression tekemiseen värittämällä piirustuksia, vedoksia, valokuvia, karttoja, liikkuvia kuvia tai muuta sisältöä.","fr":"Agent qui contribue à une expression en appliquant de la couleur à des dessins, des images imprimées, des photographies, des cartes, des images animées ou d’autres contenus.","hu":"Egy ágens, amely hozzájárul egy kifejezési formához azzal, hogy színt hord fel rajzokra, nyomtatványokra, fényképekre, térképekre, mozgóképekre és más tartalmakra.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, izkrāsojot zīmējumus, gravīras, fotogrāfijas, kartes, kustīgus attēlus, u.tml.","nl":"Een actor die bijdraagt aan een expressie door het toevoegen van kleur aan tekeningen, afdrukken, foto's, kaarten, bewegende beelden of andere content.","no":"En agent som bidrar til et uttrykk ved å fargelegge tegninger, trykk, fotografier, kart, levende bilder, etc.","tr":"Çizimlere, baskılara, fotoğraflara, haritalara, hareketli görüntülere veya diğer içeriklere renk uygulayarak bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách tô màu cho bản vẽ, bản in, bức ảnh, bản đồ, hình ảnh động, v.v...","zh-Hans-CN":"通过将颜色施加于图画、印刷品、照片、地图、动态图像或其他内容上而对一种内容表达作出贡献的一个行为者"},"altLabel":{"ar":["رسام"],"ca":[",,"],"cs":[",,kolorista"],"da":["kolorist"],"de":["Colorist,Akteur als Coloristin/Colorist von,Koloristin/Kolorist von"],"en":["colorist,colorist agent,colourist"],"es":["colorista,agente colorista,colorista"],"et":["koloreerija"],"fi":[",,"],"fr":["coloriste"],"hu":[",,"],"nl":["inkleurder,inkleurder-actor,inkleurder"],"no":["fargelegge