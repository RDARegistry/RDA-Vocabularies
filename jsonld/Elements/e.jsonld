                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/translatorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20566", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorFamilyOfExpression.en", "label":"has creator family of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20405", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCollectiveAgent.en", "label":"has translator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20523", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/translatorFamily.en", "label":"has translator family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20523", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/translatorFamily.en", "label":"has translator family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20346","label":{"ar":"لها شخص مترجم","ca":"té com a persona traductora","cs":"má překladatele (osobu)","da":"har person, som er oversætter","de":"hat Übersetzerin/Übersetzer (Person)","de":"hat Übersetzerin/Übersetzer (Person)","en":"has translator person","es":"tiene persona traductora","et":"tõlkija (isik)","fi":"kääntäjä (henkilö)","fr":"a pour personne traductrice","hu":"fordító személye a következő:","lv":"tulkotājs (persona)","nl":"heeft vertaler-persoon","no":"har oversetter (person)","tr":"çevirmen kişisi ile ilişkilidir","zh-Hans-CN":"有译者个人"},"definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet."],"en":["Relates an expression to a person who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work."],"es":["Relaciona una expresión con una persona que contribuye a una expresión, expresando el contenido lingüístico de la obra en un idioma diferente al de expresiones anteriores de la obra original."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáinak eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket."],"tr":["Bir anlatımı, eserin dilsel içeriğini orijinal eserin önceki anlatımlarından farklı bir dilde ifade ederek anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مترجم","ca":"persona traductora","cs":"překladatel (osoba)","da":"person, som er oversætter","de":"Übersetzerin/Übersetzer (Person)","de":"Übersetzerin/Übersetzer (Person)","en":"translator person","es":"persona traductora","et":"tõlkija (isik)","fi":"kääntäjä (henkilö)","fr":"personne traductrice","hu":"fordító személy:","lv":"tulkotājs (persona)","nl":"vertaler-persoon","no":"oversetter (person)","tr":"tercüman kişi","zh-Hans-CN":"译者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة بالتعبير عن المحتوى اللغوي لعمل بلغة مختلفة عن لغة تعبيرات سابقة لعمل أصلي.","ca":"Persona que contribueix a una expressió expressant el contingut lingüístic de l’obra en una llengua diferent de la de les expressions anteriors de l’obra original.","cs":"Osoba, která přispívá k vyjádření tím, že vyjadřuje jazykový obsah díla jazykem odlišným od jazyka předcházejících vyjádření originálního díla.","da":"Person, som bidrager til et udtryk ved at udtrykke værkets lingvistiske indhold på et andet sprog end det, som er anvendt i tidligere udtryk af det oprindelige værk.","de":"Eine Person, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.","de":"Eine Person, die zu einer Expression beiträgt, indem sie den sprachlichen Inhalt des Werks in einer Sprache ausdrückt, die sich von früheren Expressionen des Werks unterscheidet.","en":"A person who contributes to an expression by expressing the linguistic content of the work in a language different from that of previous expressions of the original work.","es":"Una persona que contribuye a una expresión, expresando el contenido lingüístico de la obra en un idioma diferente al de expresiones anteriores de la obra original.","et":"Isik, kes annab panuse väljendusse, väljendades teose keelesisu keeles, mis erineb originaalteose varasemate väljenduste keelest.","fi":"Henkilö, joka osallistuu ekspression tekemiseen ilmaisemalla teoksen kielellisen sisällön alkuperäisen teoksen aiemmista ekspressioista poikkeavalla kielellä.","fr":"Personne qui contribue à une expression en exprimant le contenu linguistique de l’œuvre dans une langue différente de celles des expressions précédentes de l’œuvre originale.","hu":"Egy személy, aki egy mű nyelvi tartalmának az eredeti mű korábbi kifejezési formáinak eltérő nyelven történő kifejezésével járul hozzá a kifejezési formához.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, izsakot darba saturu valodā, kas atšķiras no oriģināldarba iepriekšējām izteiksmēm.","nl":"Een persoon die bijdraagt aan een expressie door het uitdrukken van taalkundige inhoud van het werk in een andere taal dan die van voorgaande expressies van het oorspronkelijke werk.","no":"En person som bidrar til et uttrykk ved å uttrykke verkets språklige innhold på et annet språk enn tidligere uttrykk av originalverket.","tr":"Bir eserin dil içeriğini orijinal dilinden farklı bil dile çevirerek, anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过用不同于原作品之先前内容表达的语言的另一种语言来表达作品语言内容而对一种内容表达有贡献的一个个人"},"note":{"ar":["يمكن للمترجم أيضًا ترجمة المحتوى اللغوي بين أشكال اللغة نفسها خلال فترات زمنية مختلفة."],"ca":["Un traductor també pot traduir un contingut lingüístic entre formes de la mateixa llengua de diferents períodes de temps."],"cs":["Překladatel může také překládat jazykový obsah mezi formami téhož jazyka z různých časových období."],"da":["Oversætter må også oversætte lingvistisk indhold mellem former af det samme sprog fra forskellige tidsperioder."],"de":["Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden.,Darunter fallen Übersetzungen sprachlichen Inhalts aus Formen derselben Sprache aus verschiedenen Zeitperioden."],"en":["A translator may also translate linguistic content between forms of the same language from different time periods."],"es":["Un traductor también puede traducir contenido lingüístico entre formas del mismo idioma de diferentes períodos de tiempo."],"et":["Tõlkija võib keelesisu tõlkida ka sama keele eri ajal kasutatud vormide vahel."],"fi":["Kääntäjä voi myös kääntää kielisisältöä saman kielen eri aikakausien muotojen välillä."],"fr":["Un traducteur peut également traduire un contenu linguistique dans une même langue depuis une forme datant d’une période donnée vers une forme datant d’une autre période."],"hu":["Egy fordító ugyanannak a nyelvnek a különböző időszakokból származó formái közötti nyelvi tartalmat is fordíthatja."],"lv":["Ietver satura tulkošanu no senākas valodas formas mūsdienu valodas formā vienas valodas ietvaros."],"nl":["Een vertaler kan ook taalkundige content vertalen tussen vormen van dezelfde taal uit verschillende tijdperiodes."],"no":["En oversetter kan også oversette språklig innhold mellom ulike former av det samme språket fra ulike tidsperioder."],"tr":["Bir çevirmen, aynı dilin farklı zaman dilimlerindeki biçimleri arasında da dilsel içerik çevirisi yapabilir."],"zh-Hans-CN":["译者还可以在同一种语言的不同时期的形式之间翻译语言内容。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
