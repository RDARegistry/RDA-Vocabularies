                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/courtReporterFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20544", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToAmalgamation.en", "label":"has contributor family to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20411", "lexicalAlias":"http://rdaregistry.info/Elements/e/courtReporterCollectiveAgent.en", "label":"has court reporter collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20529", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/courtReporterFamily.en", "label":"has court reporter family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20529", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/courtReporterFamily.en", "label":"has court reporter family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20352","label":{"ar":"لها شخص كاتب محكمة","ca":"té com a persona relatora d’un tribunal","cs":"má soudního zpravodaje (osobu)","da":"har person, som er retsstenograf","de":"hat Gerichtsstenografin/Gerichtsstenograf (Person)","de":"hat Gerichtsstenografin/Gerichtsstenograf (Person)","en":"has court reporter person","es":"tiene persona reportera judicial","et":"kohtureporter (isik)","fi":"tuomioistuimen kirjuri (henkilö)","fr":"a pour personne rapporteuse judiciaire","hu":"bírósági jegyzőkönyvvezető személye a következő:","lv":"tiesas sekretārs (persona)","nl":"heeft rechtbankverslaggever-persoon","no":"har protokollfører (person)","tr":"yazman ile ilişkilidir","zh-Hans-CN":"有法院书记官个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال إعداد رأي محكمة للنشر."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió preparant les opinions d’un tribunal per a la seva publicació."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že připravuje stanoviska soudu ke zveřejnění."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at klargøre en domstols afgørelser til publicering."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie die Urteilsbegründung zur Veröffentlichung vorbereitet.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie die Urteilsbegründung zur Veröffentlichung vorbereitet."],"en":["Relates an expression to a person who contributes to an expression by preparing the opinions of a court for publication."],"es":["Relaciona una expresión con una persona que contribuye a una expresión preparando las opiniones de un tribunal para su publicación."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, valmistades avaldamiseks ette kohtu seisukohad."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en préparant les opinions d’un tribunal aux fins de publication."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki hozzájárul egy kifejezési formához azzal, hogy egy bíróság ítéleteit készíti elő közlésre."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, sagatavojot tiesas atzinumus publicēšanai."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het voorbereiden van de oordelen van een rechtbank voor publicatie."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å klargjøre en domstols kjennelser for utgivelse."],"tr":["Bir anlatımı, bir mahkemenin kararlarını yayınlanmak üzere hazırlayarak bir anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过准备用于公布的法院意见而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص كاتب محكمة","ca":"persona relatora d’un tribunal","cs":"soudní zpravodaj (osoba)","da":"person, som er retsstenograf","de":"Gerichtsstenografin/Gerichtsstenograf (Person)","de":"Gerichtsstenografin/Gerichtsstenograf (Person)","en":"court reporter person","es":"persona reportera judicial","et":"kohtureporter (isik)","fi":"tuomioistuimen kirjuri (henkilö)","fr":"personne rapporteuse judiciaire","hu":"bírósági jegyzőkönyvvezető személy:","lv":"tiesas sekretārs (persona)","nl":"rechtbankverslaggever-persoon","no":"protokollfører (person)","tr":"yazman","zh-Hans-CN":"法院书记官个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال إعداد رأي محكمة للنشر.","ca":"Persona que contribueix a una expressió preparant les opinions d’un tribunal per a la seva publicació.","cs":"Osoba, která přispívá k vyjádření tím, že připravuje stanoviska soudu ke zveřejnění.","da":"Person, som bidrager til et udtryk ved at klargøre en domstols afgørelser til publicering.","de":"Eine Person, die zu einer Expression beiträgt, indem sie die Urteilsbegründung zur Veröffentlichung vorbereitet.","de":"Eine Person, die zu einer Expression beiträgt, indem sie die Urteilsbegründung zur Veröffentlichung vorbereitet.","en":"A person who contributes to an expression by preparing the opinions of a court for publication.","es":"Una persona que contribuye a una expresión preparando las opiniones de un tribunal para su publicación.","et":"Isik, kes annab panuse väljendusse, valmistades avaldamiseks ette kohtu seisukohad.","fi":"Henkilö, joka osallistuu teoksen ekspression tekemiseen valmistelemalla tuomioistuimen lausunnon julkaistavaksi.","fr":"Personne qui contribue à une expression en préparant les opinions d’un tribunal aux fins de publication.","hu":"Egy személy, aki hozzájárul egy kifejezési formához azzal, hogy egy bíróság ítéleteit készíti elő közlésre.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, sagatavojot tiesas atzinumus publicēšanai.","nl":"Een persoon die bijdraagt aan een expressie door het voorbereiden van de oordelen van een rechtbank voor publicatie.","no":"En person som bidrar til et uttrykk ved å klargjøre en domstols kjennelser for utgivelse.","tr":"Mahkeme kararlarını yayım için hazırlayarak bir anlatıma katkıda bulunan kişi","zh-Hans-CN":"通过准备用于公布的法院意见而对一种内容表达有贡献的一个个人"},"altLabel":{"de":["Gerichtsstenographin/Gerichtsstenograph (Person)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/courtReporterPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20367", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToAmalgamation.en", "label":"has contributor person to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20040", "lexicalAlias":"http://rdaregistry.info/Elements/e/courtReporterAgent.en", "label":"has court reporter agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20352", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/courtReporterPerson.en", "label":"has court reporter person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20352", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/courtReporterPerson.en", "label":"has court reporter person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20053","label":{"ar":"لها وكيل منشئ عمل لتعبيرة","ca":"té com a agent creador d’una expressió","cs":"má tvůrce vyjádření (agenta)","da":"har agent, som er ophav til udtryk","de":"hat Mitwirkende/Mitwirkenden (Akteur)","de":"hat Mitwirkende/Mitwirkenden (Akteur)","el":"έχει συντελεστή","en":"has creator agent of expression","es":"tiene agente creador de expresión.","et":"väljenduse looja (tegija)","fi":"ekspression tekijä (toimija)","fr":"a pour agent créateur d’une expression","hu":"kifejezési forma létrehozó ágense a következő:","lv":"izteiksmes radītājs (aģents)","nl":"heeft maker-actor van expressie","no":"har skaper for uttrykk (agent)","sv":"har bidragsgivare","tr":"anlatımın yaratıcı temsilcisi ile ilişkilidir","vi":"có người cộng tác","zh-Hans-CN":"有内容表达的创作者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل مسئول عن تحقيق لعمل."],"ca":["Relaciona una expressió amb un agent que és responsable d’una realització d’una obra."],"cs":["Vztahuje vyjádření k agentovi, který je odpovědný za realizaci díla."],"da":["Relaterer et udtryk til en agent, som er ansvarlig for en realisering af et værk."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der für die Realisierung eines Werks verantwortlich ist.,Setzt eine Expression in Beziehung zu einem Akteur, der für die Realisierung eines Werks verantwortlich ist."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση."],"en":["Relates an expression to an agent who is responsible for a realization of a work."],"es":["Relaciona una expresión con un agente que es responsable de la realización de una obra."],"et":["Seostab väljenduse tegijaga, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest)."],"fi":["Liittää ekspression toimijaan, joka on vastuussa teoksen toteutuksesta."],"fr":["Met une expression en relation avec un agent qui est responsable de la réalisation d’une œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely felelős egy mű megvalósításáért."],"lv":["Sasaista izteiksmi ar aģentu, kas ir atbildīgs par darba realizāciju."],"nl":["Relateert een expressie aan een actor die verantwoordelijk is voor een realisatie van een werk."],"no":["Relaterer et uttrykk til en agent som har ansvar å realisere et verk."],"tr":["Bir anlatımı, bir eserin gerçekleştirilmesinden sorumlu olan bir temsilci ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện."],"zh-Hans-CN":["将一种内容表达与对一种作品的实现负责的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل منشئ لتعبيرة","ca":"agent creador d’una expressió","cs":"tvůrce vyjádření (agent)","da":"agent, som er ophav til udtryk","de":"Mitwirkende/Mitwirkender (Akteur)","de":"Mitwirkende/Mitwirkender (Akteur)","el":"συντελεστής","en":"creator agent of expression","es":"agente creador de expresión.","et":"väljenduse looja (tegija)","fi":"ekspression tekijä (toimija)","fr":"agent créateur d’une expression","hu":"kifejezési forma létrehozó ágense:","lv":"izteiksmes radītājs (aģents)","nl":"maker-actor van expressie","no":"skaper for uttrykk (agent)","sv":"bidragsgivare","tr":"anlatımın yaratıcı temsilcisi","vi":"người cộng tác","zh-Hans-CN":"内容表达的创作者行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن تحقيق عمل.","ca":"Agent que és responsable d’una realització d’una obra.","cs":"Agent, který je odpovědný za realizaci díla.","da":"Agent, som er ansvarlig for en realisering af et værk.","de":"Ein Akteur, der für die Realisierung eines Werks verantwortlich ist.","de":"Ein Akteur, der für die Realisierung eines Werks verantwortlich ist.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση.","en":"An agent who is responsible for a realization of a work.","es":"Un agente que es responsable de la realización de una obra.","et":"Tegija, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest).","fi":"Toimija, joka on vastuussa teoksen toteutuksesta.","fr":"Agent qui est responsable de la réalisation d’une œuvre.","hu":"Egy ágens, amely felelős egy mű megvalósításáért.","lv":"Aģents, kas ir atbildīgs par darba realizāciju.","nl":"Een actor die verantwoordelijk is voor een realisatie van een werk.","no":"En agent som har ansvar for å realisere et verk.","tr":"Bir eserin gerçekleştirilmesinden sorumlu olan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện.","zh-Hans-CN":"对一种作品的实现负责的一个行为者"},"note":{"ar":["منشئ تعبيرة يشمل المترجمين، وموزعي الموسيقى، وفناني الأداء، إلخ. منشئ عمل تحقق بتعبيرة هو أيضًا منشئ تعبيرة."],"ca":["Un creador d’una expressió inclou un traductor, un arranjador de música, un intèrpret, etc. Un creador d’una obra que és realitzada per una expressió és també un creador d’una expressió."],"cs":["Tvůrce vyjádření zahrnuje překladatele, aranžéra hudby, účinkujícího atd. Tvůrce díla, které je realizováno vyjádřením, je také tvůrcem vyjádření."],"da":["Ophav til udtryk omfatter oversætter, musikarrangør, udøver etc. Ophav til et værk, der er realiseret af et udtryk er også ophav til udtrykket."],"de":["Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen.,Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen."],"el":["Οι συντελεστές περιλαμβάνουν τους επιμελητές, μεταφραστές, διασκευαστές μουσικής, εκτελεστές κ.λπ."],"en":["A creator of expression includes a translator, arranger of music, performer, etc. A creator of a work that is realized by an expression is also a creator of expression."],"es":["Un creador de expresión incluye un traductor, un arreglista musical, un intérprete, etc. Un creador de una obra realizada mediante una expresión también es un creador de expresión."],"et":["Väljenduse looja hõlmab tõlkijat, muusika seadjat, esitajat jne. Väljendusena realiseeritud teose looja on ka väljenduse looja."],"fi":["Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä."],"fr":["Un créateur d’une expression comprend un traducteur, un arrangeur de musique, un interprète, etc. Un créateur d’une œuvre réalisée par une expression est également un créateur d’une expression."],"hu":["Egy kifejezési forma létrehozója magában foglal egy fordítót, zenei hangszerelőt, előadóművészt stb. Egy kifejezési formában megvalósuló mű létrehozója, egyben a kifejezési forma létrehozója is."],"lv":["Izteiksmes radītāji ir arī tulki, mūzikas aranžētāji, izpildītāji u.tml. Darba, kuru realizē izteiksme, radītājs ir arī izteiksmes radītājs."],"nl":["Een maker van expressie omvat een vertaler, arrangeur van muziek, uitvoerder etc. Een maker van een werk dat gerealiseerd wordt door een expressie is ook een maker van expressie."],"no":["En skaper for uttrykk inkluderer en oversetter, arrangør av musikk, utøver etc."],"tr":["Bir anlatımın yaratıcısı, çevirmen, müzik aranjörü, sanatçı vb. içerir. Gerçekleşen bir eserin yaratıcısı, aynı zamanda anlatımın yaratıcısıdır."],"vi":["Người công tác bao gồm cả người hiệu đính, người dịch, người cải biên âm nhạc, người biểu diễn, v.v..."],"zh-Hans-CN":["内容表达的创作者包括译者、音乐改编者、表演者等。被一种内容表达实现的一种作品的创作者也是内容表达的创作者。"]},"altLabel":{"ar":["مساهم"],"ca":["contribuïdor"],"cs":["přispěvatel"],"da":["bidragsyder"],"de":["Mitwirkender,Mitwirkender"],"en":["contributor"],"es":["colaborador"],"et":["kaastööline,väljenduse looja"],"fi":["ekspression tekijä"],"fr":["contributeur"],"hu":["közreműködő:"],"nl":["bijdrager"],"no":["bidragsyter"],"tr":["katkıda bulunan"],"zh-Hans-CN":["贡献者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/creatorAgentOfExpression.en","instructionNumber":"20.2","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20301", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedAgentOfExpression.en", "label":"has related agent of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20328", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToAmalgamation.en", "label":"has contributor agent to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20448", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCollectiveAgentOfExpression.en", "label":"has creator collective agent of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20389", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorPersonOfExpression.en", "label":"has creator person of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20327", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserAgent.en", "label":"has reviser agent"},{"@id":"http://rdaregistry.info/Elements/e/P20037", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorAgent.en", "label":"has translator agent"},{"@id":"http://rdaregistry.info/Elements/e/object/P20053", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/creatorAgentOfExpression.en", "label":"has creator agent of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20053", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/creatorAgentOfExpression.en", "label":"has creator agent of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20448","label":{"ar":"لها وكيل جماعي منشئ لتعبيرة","ca":"té com a agent col·lectiu creador d’una expressió","cs":"má tvůrce vyjádření (kolektivního agenta)","da":"har kollektiv agent, som er ophav til udtryk","de":"hat Mitwirkende/Mitwirkenden (Gemeinschaftlicher Akteur)","de":"hat Mitwirkende/Mitwirkenden (Gemeinschaftlicher Akteur)","en":"has creator collective agent of expression","es":"tiene agente colectivo creador de expresión","et":"väljenduse looja (kollektiiv)","fi":"ekspression tekijä (yhteistoimija)","fr":"a pour agent collectif créateur d’une expression","hu":"kifejezési forma létrehozó kollektív ágense a következő:","lv":"izteiksmes radītājs (grupa)","nl":"heeft maker-collectieve actor van expressie","no":"har bidragsyter for uttrykk (kollektiv agent)","tr":"anlatımın yaratıcı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有内容表达的创作者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي مسئول عن تحقيق لعمل."],"ca":["Relaciona una expressió amb un agent col·lectiu que és responsable d’una realització d’una obra."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je odpovědný za realizaci díla."],"da":["Relaterer et udtryk til en kollektiv agent, som er ansvarlig for en realisering af et værk."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der für die Realisierung eines Werks verantwortlich ist.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der für die Realisierung eines Werks verantwortlich ist."],"en":["Relates an expression to a collective agent who is responsible for a realization of a work."],"es":["Relaciona una expresión con un agente colectivo que es responsable de la realización de una obra."],"et":["Seostab väljenduse kollektiiviga, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest)."],"fi":["Liittää ekspression yhteistoimijaan, joka on vastuussa teoksen toteutuksesta."],"fr":["Met une expression en relation avec un agent collectif qui est responsable de la réalisation d’une œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely felelős egy mű létrehozásáért."],"lv":["Sasaista izteiksmi ar grupu, kas ir atbildīga par darba realizāciju. Izteiksmes radītāji ir arī tulki, mūzikas aranžētāji, izpildītāji u.tml."],"nl":["Relateert een expressie aan een collectieve actor die verantwoordelijk is voor een realisatie van een werk."],"no":["Relaterer et uttrykk til en kollektiv agent som har ansvar for en realisering av et verk."],"tr":["Bir anlatımı, bir eserin gerçekleştirilmesinden sorumlu olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对一种作品的实现负责的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي منشئ لتعبيرة","ca":"agent col·lectiu creador d’una expressió","cs":"tvůrce vyjádření (kolektivní agent)","da":"kollektiv agent, som er ophav til udtryk","de":"Mitwirkende/Mitwirkender (Gemeinschaftlicher Akteur)","de":"Mitwirkende/Mitwirkender (Gemeinschaftlicher Akteur)","en":"creator collective agent of expression","es":"agente colectivo creador de expresión","et":"väljenduse looja (kollektiiv)","fi":"ekspression tekijä (yhteistoimija)","fr":"agent collectif créateur d’une expression","hu":"kifejezési forma létrehozó kollektív ágense:","lv":"izteiksmes radītājs (grupa)","nl":"maker-collectieve actor van expressie","no":"bidragsyter for uttrykk (kollektiv agent)","tr":"anlatımın yaratıcı kolektif temsilcisi","zh-Hans-CN":"内容表达的创作者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن تحقيق عمل.","ca":"Agent col·lectiu que és responsable d’una realització d’una obra.","cs":"Kolektivní agent, který je odpovědný za realizaci díla.","da":"Kollektiv agent, som er ansvarlig for en realisering af et værk.","de":"Ein gemeinschaftlicher Akteur, der für die Realisierung eines Werks verantwortlich ist.","de":"Ein gemeinschaftlicher Akteur, der für die Realisierung eines Werks verantwortlich ist.","en":"A collective agent who is responsible for a realization of a work.","es":"Un agente colectivo que es responsable de la realización de una obra.","et":"Kollektiiv, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest).","fi":"Yhteistoimija, joka on vastuussa teoksen toteutuksesta.","fr":"Agent collectif qui est responsable de la réalisation d’une œuvre.","hu":"Egy kollektív ágens, amely felelős egy mű létrehozásáért.","lv":"Grupa, kas ir atbildīga par darba realizāciju.","nl":"Een collectieve actor die verantwoordelijk is voor een realisatie van een werk.","no":"En kollektiv agent som har ansvar for en realisering av et verk.","tr":"Bir eserin gerçekleştirilmesinden sorumlu olan kolektif temsilci","zh-Hans-CN":"对一种作品的实现负责的一个集体行为者"},"note":{"ar":["منشئ تعبيرة يشمل المترجمين، وموزعي الموسيقى، وفناني الأداء، إلخ. منشئ عمل تحقق بتعبيرة هو أيضًا منشئ تعبيرة."],"ca":["Un creador d’una expressió inclou un traductor, un arranjador de música, un intèrpret, etc. Un creador d’una obra que és realitzada per una expressió és també un creador d’una expressió."],"cs":["Tvůrce vyjádření zahrnuje překladatele, aranžéra hudby, účinkujícího atd. Tvůrce díla, které je realizováno vyjádřením, je také tvůrcem vyjádření."],"da":["Ophav til udtryk omfatter oversætter, musikarrangør, udøver ect."],"de":["Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen.,Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen."],"en":["A creator of expression includes a translator, arranger of music, performer, etc. A creator of a work that is realized by an expression is also a creator of expression."],"es":["Un creador de expresión incluye un traductor, arreglista musical, intérprete, etc. Un creador de una obra que es realizada por una expresión es también un creador de expresión."],"et":["Väljenduse looja hõlmab tõlkijat, muusika seadjat, esitajat jne. Väljendusena realiseeritud teose autor on ka väljenduse looja."],"fi":["Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä."],"fr":["Un créateur d’une expression comprend un traducteur, un arrangeur de musique, un interprète, etc. Un créateur d’une œuvre réalisée par une expression est également un créateur d’une expression."],"hu":["Egy kifejezési forma létrehozója magában foglal egy fordítót, zenei hangszerelőt, előadóművészt stb. Egy kifejezési formában megvalósuló mű létrehozója, egyben a kifejezési forma létrehozója is."],"lv":["Izteiksmes radītāji ir arī tulki, mūzikas aranžētāji, izpildītāji u.tml. Darba, kuru realizē izteiksme, radītājs ir arī izteiksmes radītājs."],"nl":["Een maker van expressie omvat een vertaler, arrangeur van muziek, uitvoerder etc. Een maker van een werk dat gerealiseerd wordt door een expressie is ook een maker van expressie."],"no":["En bidragsyter for uttrykk inkluderer en oversetter, arrangør av musikk, utøver etc."],"tr":["Bir anlatımın yaratıcısı, çevirmen, müzik aranjörü, sanatçı vb. içerir. Gerçekleşen bir eserin yaratıcısı, aynı zamanda anlatımın yaratıcısıdır."],"zh-Hans-CN":["内容表达的创作者包括译者、音乐改编者、表演者等。被一种内容表达实现的一种作品的创作者也是内容表达的创作者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCollectiveAgentOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20305", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedCollectiveAgentOfExpression.en", "label":"has related collective agent of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20053", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorAgentOfExpression.en", "label":"has creator agent of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20426", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToAmalgamation.en", "label":"has contributor collective agent to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20507", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCorporateBodyOfExpression.en", "label":"has creator corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20566", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorFamilyOfExpression.en", "label":"has creator family of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20406", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserCollectiveAgent.en", "label":"has reviser collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20405", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCollectiveAgent.en", "label":"has translator collective agent"},{"@id":"http://rdaregistry.info/Elements/e/object/P20448", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/creatorCollectiveAgentOfExpression.en", "label":"has creator collective agent of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20448", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/creatorCollectiveAgentOfExpression.en", "label":"has creator collective agent of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20507","label":{"ar":"لها هيئة منشئة لتعبيرة","ca":"té com a entitat corporativa creadora d’una expressió","cs":"má tvůrce vyjádření (korporaci)","da":"har korporation, som er ophav til udtryk","de":"hat Mitwirkende/Mitwirkenden (Körperschaft)","de":"hat Mitwirkende/Mitwirkenden (Körperschaft)","en":"has creator corporate body of expression","es":"tiene organismo corporativo creador de expresión","et":"väljenduse looja (asutus)","fi":"ekspression tekijä (yhteisö)","fr":"a pour collectivité créatrice d’une expression","hu":"kifejezési forma létrehozó testülete a következő:","lv":"izteiksmes radītājs (institūcija)","nl":"heeft maker-corporatie van expressie","no":"har bidragsyter for uttrykk (korporasjon)","tr":"anlatımın yaratıcı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有内容表达的创作者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة مسئولة عن تحقيق لعمل."],"ca":["Relaciona una expressió amb una entitat corporativa que és responsable d’una realització d’una obra."],"cs":["Vztahuje vyjádření ke korporaci, která je odpovědná za realizaci díla."],"da":["Relaterer et udtryk til en korporation, som er ansvarlig for en realisering af et værk."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die für die Realisierung eines Werks verantwortlich ist.,Setzt eine Expression in Beziehung zu einer Körperschaft, die für die Realisierung eines Werks verantwortlich ist."],"en":["Relates an expression to a corporate body who is responsible for a realization of a work."],"es":["Relaciona una expresión con un organismo corporativo que es responsable de la realización de una obra."],"et":["Seostab väljenduse asutusega, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest)."],"fi":["Liittää ekspression yhteisöön, joka on vastuussa teoksen toteutuksesta."],"fr":["Met une expression en relation avec une collectivité qui est responsable de la réalisation d’une œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely felelős egy mű létrehozásáért."],"lv":["Sasaista izteiksmi ar institūciju, kas ir atbildīga par darba realizāciju."],"nl":["Relateert een expressie aan een corporatie die verantwoordelijk is voor een realisatie van een werk."],"no":["Relaterer et uttrykk til en korporasjon som har ansvar for en realisering av et verk."],"tr":["Bir anlatımı, bir eserin gerçekleştirilmesinden sorumlu olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对一种作品的实现负责的一个团体关联起来。'"]},"ToolkitLabel":{"ar":"هيئة منشئة لتعبيرة","ca":"entitat corporativa creadora d’una expressió","cs":"tvůrce vyjádření (korporace)","da":"korporation, som er ophav til udtryk","de":"Mitwirkende/Mitwirkender (Körperschaft)","de":"Mitwirkende/Mitwirkender (Körperschaft)","en":"creator corporate body of expression","es":"organismo corporativo creador de expresión","et":"väljenduse looja (asutus)","fi":"ekspression tekijä (yhteisö)","fr":"collectivité créatrice d’une expression","hu":"kifejezési forma létrehozó testülete:","lv":"izteiksmes radītājs (institūcija)","nl":"maker-corporatie van expressie","no":"bidragsyter for uttrykk (korporasjon)","tr":"anlatımın yaratıcı tüzel kişisi","zh-Hans-CN":"内容表达的创作者团体"},"ToolkitDefinition":{"ar":"هيئة مسئولة عن تحقيق عمل.","ca":"Entitat corporativa que és responsable d’una realització d’una obra.","cs":"Korporace, která je odpovědná za realizaci díla.","da":"Korporation, som er ansvarlig for en realisering af et værk.","de":"Eine Körperschaft, die für die Realisierung eines Werks verantwortlich ist.","de":"Eine Körperschaft, die für die Realisierung eines Werks verantwortlich ist.","en":"A corporate body who is responsible for a realization of a work.","es":"Un organismo corporativo que es responsable de la realización de una obra.","et":"Asutus, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest).","fi":"Yhteisö, joka on vastuussa teoksen toteutuksesta.","fr":"Collectivité qui est responsable de la réalisation d’une œuvre.","hu":"Egy testület, amely felelős egy mű létrehozásáért.","lv":"Institūcija, kas ir atbildīga par darba realizāciju.","nl":"Een corporatie die verantwoordelijk is voor een realisatie van een werk.","no":"En korporasjon som har ansvar for en realisering av et verk.","tr":"Bir esein gerçekleştirilmesinden sorumlu olan tüzel kişi.","zh-Hans-CN":"对一种作品的实现负责的一个团体"},"note":{"ar":["منشئ تعبيرة يشمل المترجمين، وموزعي الموسيقى، وفناني الأداء، إلخ. منشئ عمل تحقق بتعبيرة هو أيضًا منشئ تعبيرة."],"ca":["Un creador d’una expressió inclou un traductor, un arranjador de música, un intèrpret, etc. Un creador d’una obra que és realitzada per una expressió és també un creador d’una expressió."],"cs":["Tvůrce vyjádření zahrnuje překladatele, aranžéra hudby, účinkujícího atd. Tvůrce díla, které je realizováno vyjádřením, je také tvůrcem vyjádření."],"da":["Ophav til udtryk omfatter oversætter, musikarrangør, udøver ect."],"de":["Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen.,Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen."],"en":["A creator of expression includes a translator, arranger of music, performer, etc. A creator of a work that is realized by an expression is also a creator of expression."],"es":["Un creador de expresión incluye un traductor, arreglista musical, intérprete, etc. Un creador de una obra que es realizada por una expresión es también un creador de expresión."],"et":["Väljenduse looja hõlmab tõlkijat, muusika seadjat, esitajat jne. Väljendusena realiseeritud teose autor on ka väljenduse looja."],"fi":["Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä."],"fr":["Un créateur d’une expression comprend un traducteur, un arrangeur de musique, un interprète, etc. Un créateur d’une œuvre réalisée par une expression est également un créateur d’une expression."],"hu":["Egy kifejezési forma létrehozója magában foglal egy fordítót, zenei hangszerelőt, előadóművészt stb. Egy kifejezési formában megvalósuló mű létrehozója, egyben a kifejezési forma létrehozója is."],"lv":["Izteiksmes radītāji ir arī tulki, mūzikas aranžētāji, izpildītāji u.tml. Darba, kuru realizē izteiksme, radītājs ir arī izteiksmes radītājs."],"nl":["Een maker van expressie omvat een vertaler, arrangeur van muziek, uitvoerder etc. Een maker van een werk dat gerealiseerd wordt door een expressie is ook een maker van expressie."],"no":["En bidragsyter for uttrykk inkluderer en oversetter, arrangør av musikk, utøver etc."],"tr":["Bir anlatımın yaratıcısı, çevirmen, müzik aranjörü, sanatçı vb. içerir. Gerçekleşen bir eserin yaratıcısı, aynı zamanda anlatımın yaratıcısıdır."],"zh-Hans-CN":["内容表达的创作者包括译者、音乐改编者、表演者等。被一种内容表达实现的一种作品的创作者也是内容表达的创作者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCorporateBodyOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20304", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedCorporateBodyOfExpression.en", "label":"has related corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20448", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCollectiveAgentOfExpression.en", "label":"has creator collective agent of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20485", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToAmalgamation.en", "label":"has contributor corporate body to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20465", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserCorporateBody.en", "label":"has reviser corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20464", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorCorporateBody.en", "label":"has translator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/object/P20507", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/creatorCorporateBodyOfExpression.en", "label":"has creator corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20507", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/creatorCorporateBodyOfExpression.en", "label":"has creator corporate body of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20566","label":{"ar":"لها عائلة منشئة لتعبيرة","ca":"té com a família creadora d’una expressió","cs":"má tvůrce vyjádření (rodinu)","da":"har familie, som er ophav til udtryk","de":"hat Mitwirkende/Mitwirkenden (Familie)","de":"hat Mitwirkende/Mitwirkenden (Familie)","en":"has creator family of expression","es":"tiene familia creadora de expresión","et":"väljenduse looja (perekond)","fi":"ekspression tekijä (suku)","fr":"a pour famille créatrice d’une expression","hu":"kifejezési forma létrehozó családja a következő:","lv":"izteiksmes radītājs (dzimta/ģimene)","nl":"heeft maker-familie van expressie","no":"har bidragsyter for uttrykk (familie)","tr":"anlatımın yaratıcı ailesi ile ilişkilidir","zh-Hans-CN":"有内容表达的创作者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة مسئولة عن تحقيق عمل."],"ca":["Relaciona una expressió amb una família que és responsable d’una realització d’una obra."],"cs":["Vztahuje vyjádření k rodině, která je odpovědná za realizaci díla."],"da":["Relaterer et udtryk til en familie, som er ansvarlig for en realisering af et værk."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die für die Realisierung eines Werks verantwortlich ist.,Setzt eine Expression in Beziehung zu einer Familie, die für die Realisierung eines Werks verantwortlich ist."],"en":["Relates an expression to a family who is responsible for a realization of a work."],"es":["Relaciona una expresión con una familia que es responsable de la realización de una obra."],"et":["Seostab väljenduse perekonnaga, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest)."],"fi":["Liittää ekspression sukuun, joka on vastuussa teoksen toteutuksesta."],"fr":["Met une expression en relation avec une famille qui est responsable de la réalisation d’une œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely felelős egy mű létrehozásáért."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir atbildīga par darba realizāciju."],"nl":["Relateert een expressie aan een familie die verantwoordelijk is voor een realisatie van een werk."],"no":["Relaterer et uttrykk til en familie som har ansvar for en realisering av et verk."],"tr":["Bir anlatımı, bir eserin gerçekleştirilmesinden sorumlu olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对一种作品的实现负责的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة منشئة لتعبيرة","ca":"família creadora d’una expressió","cs":"tvůrce vyjádření (rodina)","da":"familie, som er ophav til udtryk","de":"Mitwirkende/Mitwirkender (Familie)","de":"Mitwirkende/Mitwirkender (Familie)","en":"creator family of expression","es":"familia creadora de expresión","et":"väljenduse looja (perekond)","fi":"ekspression tekijä (suku)","fr":"famille créatrice d’une expression","hu":"kifejezési forma létrehozó családja:","lv":"izteiksmes radītājs (dzimta/ģimene)","nl":"maker-familie van expressie","no":"bidragsyter for uttrykk (familie)","tr":"anlatımın yaratıcı ailesi","zh-Hans-CN":"内容表达的创作者家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن تحقيق عمل.","ca":"Família que és responsable d’una realització d’una obra.","cs":"Rodina, která je odpovědná za realizaci díla.","da":"Familie, som er ansvarlig for en realisering af et værk.","de":"Eine Familie, die für die Realisierung eines Werks verantwortlich ist.","de":"Eine Familie, die für die Realisierung eines Werks verantwortlich ist.","en":"A family who is responsible for a realization of a work.","es":"Una familia que es responsable de la realización de una obra.","et":"Perekond, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest).","fi":"Suku, joka on vastuussa teoksen toteutuksesta.","fr":"Famille qui est responsable de la réalisation d’une œuvre.","hu":"Egy család, amely felelős egy mű létrehozásáért.","lv":"Dzimta/ģimene, kas ir atbildīga par darba realizāciju.","nl":"Een familie die verantwoordelijk is voor een realisatie van een werk.","no":"En familie som har ansvar for en realisering av et verk.","tr":"Bir eserin oluşturulmasından sorumlu olan bir aile.","zh-Hans-CN":"对一种作品的实现负责的一个家族"},"note":{"ar":["منشئ تعبيرة يشمل المترجمين، وموزعي الموسيقى، وفناني الأداء، إلخ. منشئ عمل تحقق بتعبيرة هو أيضًا منشئ تعبيرة."],"ca":["Un creador d’una expressió inclou un traductor, un arranjador de música, un intèrpret, etc. Un creador d’una obra que és realitzada per una expressió és també un creador d’una expressió."],"cs":["Tvůrce vyjádření zahrnuje překladatele, aranžéra hudby, účinkujícího atd. Tvůrce díla, které je realizováno vyjádřením, je také tvůrcem vyjádření."],"da":["Ophav til udtryk omfatter oversætter, musikarrangør, udøver ect."],"de":["Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen.,Darunter fallen Übersetzerinnen/Übersetzer, Arrangeurinnen/Arrangeure von Musik, Ausführende und so weiter. Eine geistige Schöpferin/ein geistiger Schöpfer eines Werks, das durch eine Expression realisiert ist, wird ebenfalls als geistige Schöpferin/geistiger Schöpfer der Expression angesehen."],"en":["A creator of expression includes a translator, arranger of music, performer, etc. A creator of a work that is realized by an expression is also a creator of expression."],"es":["Un creador de expresión incluye un traductor, arreglista musical, intérprete, etc. Un creador de una obra que es realizada por una expresión es también un creador de expresión."],"et":["Väljenduse looja hõlmab tõlkijat, muusika seadjat, esitajat jne. Väljendusena realiseeritud teose autor on ka väljenduse looja."],"fi":["Ekspression tekijään kuuluvat kääntäjä, sovittaja, esittäjä jne. Ekspression toteuttaman teoksen tekijä on myös ekspression tekijä."],"fr":["Un créateur d’une expression comprend un traducteur, un arrangeur de musique, un interprète, etc. Un créateur d’une œuvre réalisée par une expression est également un créateur d’une expression."],"hu":["Egy kifejezési forma létrehozója magában foglal egy fordítót, zenei hangszerelőt, előadóművészt stb. Egy kifejezési formában megvalósuló mű létrehozója, egyben a kifejezési forma létrehozója is."],"lv":["Izteiksmes radītāji ir arī tulki, mūzikas aranžētāji, izpildītāji u.tml. Darba, kuru realizē izteiksme, radītājs ir arī izteiksmes radītājs."],"nl":["Een maker van expressie omvat een vertaler, arrangeur van muziek, uitvoerder etc. Een maker van een werk dat gerealiseerd wordt door een expressie is ook een maker van expressie."],"no":["En bidragsyter for uttrykk inkluderer en oversetter, arrangør av musikk, utøver etc."],"tr":["Bir anlatımın yaratıcısı, çevirmen, müzik aranjörü, sanatçı vb. içerir. Gerçekleşen bir eserin yaratıcısı, aynı zamanda anlatımın yaratıcısıdır."],"zh-Hans-CN":["内容表达的创作者包括译者、音乐改编者、表演者等。被一种内容表达实现的一种作品的创作者也是内容表达的创作者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/creatorFamilyOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20303", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedFamilyOfExpression.en", "label":"has related family of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20448", "lexicalAlias":"http://rdaregistry.info/Elements/e/creatorCollectiveAgentOfExpression.en", "label":"has creator collective agent of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20544", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToAmalgamation.en", "label":"has contributor family to amalgamation"},{"@id":"http://rdaregistry.info/Elements/e/P20524", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserFamily.en", "label":"has reviser family"},{"@id":"http://rdaregistry.info/Elements/e/P20523", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatorFamily.en", "label":"has translator family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20566", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/creatorFamilyOfExpression.en", "label":"has creator family of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20566", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/creatorFamilyOfExpression.en", "label":"has creator family of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20389","label":{"ar":"لها شخص أخصائي منشئ لتعبيرة","ca":"té com a persona creadora d’una expressió","cs":"má tvůrce vyjádření (osobu)","da":"har person, som er ophav til udtryk","de":"hat Mitwirkende/Mitwirkenden (Person)","de":"hat Mitwirkende/Mitwirkenden (Person)","en":"has creator person of expression","es":"tiene persona creadora de expresión","et":"väljenduse looja (isik)","fi":"ekspression tekijä (henkilö)","fr":"a pour personne créatrice d’une expression","hu":"kifejezési forma létrehozó személye a következő:","lv":"izteiksmes radītājs (persona)","nl":"heeft maker-persoon van expressie","no":"har skaper av uttrykk (person)","tr":"anlatımın yaratıcısı ile ilişkilidir","zh-Hans-CN":"有内容表达的创作者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص مسئول عن تحقيق عمل."],"ca":["Relaciona una expressió amb una persona que és responsable d’una realització d’una obra."],"cs":["Vztahuje vyjádření k osobě, která je odpovědná za realizaci díla."],"da":["Relaterer et udtryk til en person, som er ansvarlig for en realisering af et værk."],"de":["Setzt eine Expression in Beziehung zu einer Person, die für die Realisierung eines Werks verantwortlich ist.,Setzt eine Expression in Beziehung zu einer Person, die für die Realisierung eines Werks verantwortlich ist."],"en":["Relates an expression to a person who is responsible for a realization of a work."],"es":["Relaciona una expresión con una persona que es responsable de la realización de una obra."],"et":["Seostab väljenduse isikuga, kes vastutab teose väljenduse loomise eest (teose realiseerimise eest)."],"fi":["Liittää ekspression henkilöön, joka on vastuussa teoksen toteutuksesta."],"fr":["Met une expression en relation avec une personne qui est responsable de la réalisation d’une œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki felelős egy mű létrehozásáért."],"lv":["Sasaista izteiksmi ar personu, kura ir atbildīga par darba realizāciju."],"nl":["Relateert een expressie aan een persoon die verantwoordelijk is voor een realisatie van een werk."],"no":["Relaterer et uttrykk til en person som har ansvar for en realisering av et verk."],"tr":["Bir anlatımı, bir eserin gerçekleştirilmesinden sorumlu olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对一种作品的实现负责的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص أخصائي منشئ لتعبيرة","ca":"persona creadora d