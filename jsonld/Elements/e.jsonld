                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20484", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToPerformance.en", "label":"has contributor corporate body to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20396", "lexicalAlias":"http://rdaregistry.info/Elements/e/interviewerCollectiveAgentOfExpression.en", "label":"has interviewer collective agent of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/interviewerCorporateBodyOfExpression.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20455", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/interviewerCorporateBodyOfExpression.en", "label":"has interviewer corporate body of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20455", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/interviewerCorporateBodyOfExpression.en", "label":"has interviewer corporate body of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20514","label":{"ar":"لها عائلة محاورة لتعبيرة","ca":"té com a família entrevistadora d’una expressió","cs":"má tazatele vyjádření (rodinu)","da":"har familie, som er interviewer for udtryk","de":"hat Interviewerin/Interviewer einer Expression (Familie)","de":"hat Interviewerin/Interviewer einer Expression (Familie)","en":"has interviewer family of expression","es":"tiene familia entrevistadora de expresión","et":"väljenduse intervjueerija (perekond)","fi":"ekspression haastattelija (suku)","fr":"a pour famille intervieweuse d’une expression","hu":"kifejezési forma interjúkészítő családja a következő:","lv":"izteiksmē intervējis (dzimta/ģimene)","nl":"heeft interviewer-familie van expressie","no":"har intervjuer for uttrykk (familie)","tr":"anlatımın görüşmeci ailesi ile ilişkilidir","zh-Hans-CN":"有内容表达的采访者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة من خلال القيام بدور محاور، أو مراسل، أو مستطلع آراء، أو عائلة آخر يجمع معلومات."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió actuant com un entrevistador, un periodista, un enquestador o qualsevol altra família que recull informació."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že působí jako tazatel, zpravodaj, rodina provádějící průzkum veřejného mínění nebo jiný agent, který shromažďuje informace."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for familie, som indsamler information."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder anderer Akteur Informationen zusammenträgt.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder anderer Akteur Informationen zusammenträgt."],"en":["Relates an expression to a family who contributes to an expression by acting as an interviewer, reporter, pollster, or some other family who gathers information."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al actuar como una entrevistadora, reportera, encuestadora u otro tipo de agente que recolecta información."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva perekonnana."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre famille recueillant de l’information."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely hozzájárul egy kifejezési formához oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő családként cselekszik."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, darbojoties kā intervētājs, reportieris, aptaujātājs vai kāds cits aģents, kas apkopo informāciju."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door op te treden als een ondervrager, journalist, opinipeiler of een andere soort familie die informatie verzamelt."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon."],"tr":["Bir anlatımı, görüşmeci, muhabir, anketör veya bilgi toplayan başka bir tür aile olarak hareket ederek anlatıma katkı sağlayan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过担任一个采访者、报道者、民意调查员或其他某种信息收集的一个家族对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة محاورة لتعبيرة","ca":"família entrevistadora d’una expressió","cs":"tazatel vyjádření (rodina)","da":"familie, som er interviewer for udtryk","de":"Interviewerin/Interviewer einer Expression (Familie)","de":"Interviewerin/Interviewer einer Expression (Familie)","en":"interviewer family of expression","es":"organismo corporativo entrevistador de expresión","et":"väljenduse intervjueerija (perekond)","fi":"ekspression haastattelija (suku)","fr":"famille intervieweuse d’une expression","hu":"kifejezési forma interjúkészítő családja:","lv":"izteiksmē intervējis (dzimta/ģimene)","nl":"interviewer-familie van expressie","no":"intervjuer for uttrykk (familie)","tr":"anlatımın görüşmeci ailesi ile ilişkilidir","zh-Hans-CN":"内容表达的采访者家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة من خلال القيام بدور محاور، أو مراسل، أو مستطلع آراء، أو عائلة آخر يجمع معلومات.","ca":"Família que contribueix a una expressió actuant com un entrevistador, un periodista, un enquestador o qualsevol altra família que recull informació.","cs":"Rodina, která přispívá k vyjádření tím, že působí jako tazatel, zpravodaj, rodina provádějící průzkum veřejného mínění nebo jiný agent, který shromažďuje informace.","da":"Familie, som bidrager til et udtryk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for person, som indsamler information.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder anderer Akteur Informationen zusammenträgt.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder anderer Akteur Informationen zusammenträgt.","en":"A family who contributes to an expression by acting as an interviewer, reporter, pollster, or some other family who gathers information.","es":"Una familia que contribuye a una expresión al actuar como una entrevistadora, reportera, encuestadora u otro tipo de agente que recolecta información.","et":"Perekond, kes annab panuse väljendusse, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva perekonnana.","fi":"Suku, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja.","fr":"Famille qui contribue à une expression en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre famille recueillant de l’information.","hu":"Egy család, amely hozzájárul egy kifejezési formához oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő családként cselekszik.","lv":"Dzimta/ģimene, kas sniegusi ieguldījumu izteiksmē, darbojoties kā intervētājs, reportieris, aptaujātājs vai kāds cits aģents, kas apkopo informāciju.","nl":"Een familie die bijdraagt aan een expressie door op te treden als een ondervrager, journalist, opinipeiler of een andere soort familie die informatie verzamelt.","no":"En familie som bidrar til et uttrykk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.","tr":"Bir anlatıma röportajcı, muhabir, anketör veya bilgi toplayan başka bir aile olarak katkıda bulunan aile.","zh-Hans-CN":"通过担任一个采访者、报道者、民意调查员或其他某种信息收集的一个家族对一种内容表达有贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20543", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToPerformance.en", "label":"has contributor family to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20396", "lexicalAlias":"http://rdaregistry.info/Elements/e/interviewerCollectiveAgentOfExpression.en", "label":"has interviewer collective agent of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/interviewerFamilyOfExpression.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20514", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/interviewerFamilyOfExpression.en", "label":"has interviewer family of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20514", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/interviewerFamilyOfExpression.en", "label":"has interviewer family of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20337","label":{"ar":"لها شخص محاور لتعبيرة","ca":"té com a persona entrevistadora d’una expressió","cs":"má tazatele vyjádření (osobu)","da":"har person, som er interviewer for udtryk","de":"hat Interviewerin/Interviewer einer Expression (Person)","de":"hat Interviewerin/Interviewer einer Expression (Person)","en":"has interviewer person of expression","es":"tiene entrevistador persona de expresión.","et":"väljenduse intervjueerija (isik)","fi":"ekspression haastattelija (henkilö)","fr":"a pour personne intervieweuse d’une expression","hu":"kifejezési forma interjúkészítő személye a következő:","lv":"izteiksmē intervējis (persona)","nl":"heeft interviewer-persoon van expressie","no":"har intervjuer for uttrykk (person)","tr":"anlatımın görüşmeci kişisi ile ilişkilidir","zh-Hans-CN":"有内容表达的采访者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال قيامه بدور محاور، أو مراسل، أو مستطلع آراء، أو شخص آخر يجمع معلومات."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió actuant com un entrevistador, un periodista, un enquestador o qualsevol altra persona que recull informació."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že působí jako tazatel, zpravodaj, osoba provádějící průzkum veřejného mínění nebo jiný agent, který shromažďuje informace."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for person, som indsamler information."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie als Interviewer, Reporter, Meinungsforscher oder anderer Informationssammler tätig ist.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie als Interviewer, Reporter, Meinungsforscher oder anderer Informationssammler tätig ist."],"en":["Relates an expression to a person who contributes to an expression by acting as an interviewer, reporter, pollster, or some other person who gathers information."],"es":["Relaciona una expresión con una persona que contribuye a una expresión actuando como entrevistador, reportero, encuestador o alguna otra persona que recopila información."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva isikuna."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre personne recueillant de l’information."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki hozzájárul egy kifejezési formához oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő személyként cselekszik."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, darbojoties kā intervētājs, reportieris, aptaujātājs vai kāds cits aģents, kas apkopo informāciju."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door op te treden als een ondervrager, journalist, opinipeiler of een andere soort persoon die informatie verzamelt."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon."],"tr":["Bir anlatımı, görüşmeci, muhabir, anketör veya bilgi toplayan başka bir kişi olarak hareket ederek söz konusu anlatıma katkı sağlayan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过担当采访者、报道者、民意调查员或其他某种信息收集的个人而对一种内容表达作出贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص محاور لتعبيرة","ca":"persona entrevistadora d’una expressió","cs":"tazatel vyjádření (osoba)","da":"person, som er interviewer for udtryk","de":"Interviewerin/Interviewer einer Expression (Person)","de":"Interviewerin/Interviewer einer Expression (Person)","en":"interviewer person of expression","es":"entrevistador persona de expresión.","et":"väljenduse intervjueerija (isik)","fi":"ekspression haastattelija (henkilö)","fr":"personne intervieweuse d’une expression","hu":"kifejezési forma interjúkészítő személye:","lv":"izteiksmē intervējis (persona)","nl":"interviewer-persoon van expressie","no":"intervjuer for uttrykk (person)","tr":"anlatımın görüşmeci kişisi ile ilişkilidir","zh-Hans-CN":"内容表达的采访者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال قيامه بدور محاور، أو مراسل، أو مستطلع آراء، أو شخص آخر يجمع معلومات.","ca":"Persona que contribueix a una expressió actuant com un entrevistador, un periodista, un enquestador o qualsevol altra persona que recull informació.","cs":"Osoba, která přispívá k vyjádření tím, že působí jako tazatel, zpravodaj, osoba provádějící průzkum veřejného mínění nebo jiný agent, který shromažďuje informace.","da":"Person, som bidrager til et udtryk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for person, som indsamler information.","de":"Eine Person, die zu einer Expression beiträgt, indem sie als Interviewer, Reporter, Meinungsforscher oder anderer Informationssammler tätig ist.","de":"Eine Person, die zu einer Expression beiträgt, indem sie als Interviewer, Reporter, Meinungsforscher oder anderer Informationssammler tätig ist.","en":"A person who contributes to an expression by acting as an interviewer, reporter, pollster, or some other person who gathers information.","es":"Una persona que contribuye a una expresión actuando como entrevistador, reportero, encuestador o alguna otra persona que recopila información.","et":"Isik, kes annab panuse väljendusse, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva isikuna.","fi":"Henkilö, joka osallistuu ekspression tekemiseen toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonain muuna toimijana, joka kerää tietoja.","fr":"Personne qui contribue à une expression en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre personne recueillant de l’information.","hu":"Egy személy, aki hozzájárul egy kifejezési formához oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő személyként cselekszik.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, darbojoties kā intervētājs, reportieris, aptaujātājs vai kāds cits aģents, kas apkopo informāciju.","nl":"Een persoon die bijdraagt aan een expressie door op te treden als een ondervrager, journalist, opinipeiler of een andere soort persoon die informatie verzamelt.","no":"En person som bidrar til et uttrykk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.","tr":"Görüşmeci, muhabir, anketör veya bilgi toplayan başka bir kişi olarak hareket ederek söz konusu olan anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过担当采访者、报道者、民意调查员或其他某种信息收集的个人而对一种内容表达作出贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20032", "lexicalAlias":"http://rdaregistry.info/Elements/e/interviewerAgentOfExpression.en", "label":"has interviewer agent of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/interviewerPersonOfExpression.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20337", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/interviewerPersonOfExpression.en", "label":"has interviewer person of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20337", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/interviewerPersonOfExpression.en", "label":"has interviewer person of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20062","definition":{"ar":["تربط بين تعبيرة ومجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى تعبيرة."],"ca":["Relaciona una expressió amb un conjunt de caràcters o de símbols usat per expressar el contingut d’una expressió."],"cs":["Vztahuje vyjádření k souboru znaků nebo symbolů, používaných k vyjadřování obsahu vyjádření."],"da":["Relaterer et udtryk til et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks indhold."],"de":["Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to a set of characters or symbols used to express the content of an expression."],"es":["Relaciona una expresión con un conjunto de caracteres o símbolos utilizados para expresar el contenido de una expresión."],"et":["Seostab väljenduse märkide või sümbolite kogumiga, mida on kasutatud väljenduse sisu väljendamiseks."],"fi":["Liittää ekspression joukkoon merkkejä tai symboleja, joita käytetään ekspression sisällön ilmaisemiseen."],"fr":["Met une expression en relation avec un ensemble de caractères ou de symboles utilisé pour exprimer le contenu d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát karakterek vagy szimbólumok egy csoportjához, amelyet arra használnak, hogy egy kifejezési forma tartalmát kifejezze."],"lv":["Sasaista izteiksmi ar zīmju vai simbolu kopumu, kas tiek lietoti, lai atklātu izteiksmes saturu."],"nl":["Relateert een expressie aan een verzameling van karakters of symbolen gebruikt om de content van een expressie weer te geven."],"no":["Relaterer et uttrykk til et sett med tegn eller symboler som brukes til å uttrykke innholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung của biểu hiện."],"zh-Hans-CN":["将一种内容表达与用于表达一种内容表达的内容的字符或符号的集合关联起来。"]},"ToolkitLabel":{"ar":"شكل من أشكال التدوين","ca":"forma de notació","cs":"podoba zápisu","da":"notationsform","de":"Form der Notation","de":"Form der Notation","el":"μορφή της σημειογραφίας","en":"form of notation","es":"forma de notación","et":"notatsiooni vorm","fi":"merkkijärjestelmän tyyppi","fr":"forme de notation","hu":"lejegyzésformája:","lv":"pieraksta forma","nl":"vorm van notatie","no":"notasjonsform","sv":"form av notation","tr":"notasyon formu","vi":"hình thái của ký hiệu","zh-Hans-CN":"标记的形式"},"ToolkitDefinition":{"ar":"مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى تعبيرة.","ca":"Conjunt de caràcters o de símbols usat per expressar el contingut d’una expressió.","cs":"Soubor znaků nebo symbolů, používaných k vyjadřování obsahu vyjádření.","da":"Sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks indhold.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression auszudrücken.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression auszudrücken.","el":"Ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο μιας έκφρασης.","en":"A set of characters or symbols used to express the content of an expression.","es":"Conjunto de caracteres o símbolos utilizados para expresar el contenido de una expresión.","et":"Märkide või sümbolite kogum, mida on kasutatud väljenduse sisu väljendamiseks.","fi":"Joukko merkkejä tai symboleja, joita käytetään ekspression sisällön ilmaisemiseen.","fr":"Ensemble de caractères ou de symboles utilisé pour exprimer le contenu d’une expression.","hu":"Karakterek vagy szimbólumok egy csoportja, amelyet arra használnak, hogy egy kifejezési forma tartalmát kifejezze.","lv":"Zīmju vai simbolu kopums, kas tiek lietoti, lai atklātu izteiksmes saturu.","nl":"Een verzameling van karakters of symbolen gebruikt om de content van een expressie weer te geven.","no":"Et sett med tegn eller symboler som brukes til å uttrykke innholdet i et uttrykk.","tr":"Bir anlatımın içeriğini ifade etmek için kullanılan karakterler veya semboller kümesi.","vi":"Chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung của biểu hiện.","zh-Hans-CN":"用于表达一种内容表达的内容的字符或符号的集合"},"label":{"ar":"لها شكل من أشكال التدوين","ca":"té com a forma de notació","cs":"má podobu zápisu","da":"har notationsform","de":"hat Form der Notation","de":"hat Form der Notation","el":"έχει μορφή της σημειογραφίας","en":"has form of notation","es":"tiene forma de notación","et":"notatsiooni vorm","fi":"merkkijärjestelmän tyyppi","fr":"a pour forme de notation","hu":"lejegyzésformája a következő:","lv":"pieraksta forma","nl":"heeft vorm van notatie","no":"har notasjonsform","sv":"har form av notation","tr":"notasyon biçimi ile ilişkilidir","vi":"có hình thái của ký hiệu","zh-Hans-CN":"有标记的形式"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotation.en","instructionNumber":"7.13","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20065", "lexicalAlias":"http://rdaregistry.info/Elements/e/script.en", "label":"has script"},{"@id":"http://rdaregistry.info/Elements/e/P20063", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotatedMovement.en", "label":"has form of notated movement"},{"@id":"http://rdaregistry.info/Elements/e/P20061", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfTactileNotation.en", "label":"has form of tactile notation"},{"@id":"http://rdaregistry.info/Elements/e/P20064", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfMusicalNotation.en", "label":"has form of musical notation"},{"@id":"http://rdaregistry.info/Elements/e/object/P20062", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/formOfNotation.en", "label":"has form of notation"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20062", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/formOfNotation.en", "label":"has form of notation"}]},{"@id":"http://rdaregistry.info/Elements/e/P20080","label":{"ar":"لها تعبيرة كادنزا","ca":"té com a expressió de cadència","cs":"má kadenci (vyjádření)","da":"har kadenceudtryk","de":"ist Kadenz (Expression)","de":"ist Kadenz (Expression)","el":"είναι καντέντσα (έκφραση)","en":"has cadenza expression","es":"tiene expresión de cadencia","et":"kadents (väljendus)","fi":"kadenssi (ekspressio)","fr":"a pour cadence (expression)","hu":"kádencia kifejezési formája a következő:","lv":"izteiksme: kadence","nl":"heeft cadens-expressie","no":"har kadens (uttrykk)","tr":"kadans anlatımı ile ilişkilidir","vi":"là cadenza (biểu hiện)","zh-Hans-CN":"有华彩内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل موسيقي يحتوي على فقرة مصاحبة لعازف منفرد، مضافة إلى عمل موسيقي؛ مثل كونشرتو للملحن نفسه أو لملحن مختلف."],"ca":["Relaciona una expressió amb una expressió d’una obra musical que consisteix en un passatge ornamental per a un solista, afegit a una expressió d’una obra musical, com ara un concert, ja sigui pel mateix compositor o per un compositor diferent."],"cs":["Vztahuje vyjádření k vyjádření hudebního díla, které sestává z ozdobné pasáže pro sólistu, přidané k hudebnímu dílu, jako je koncert, od stejného nebo jiného skladatele."],"da":["Relaterer et udtryk til et udtryk af et musikværk, som består af en ornamental passage for en solist, som er tilføjet et musikværks udtryk såsom en koncert, enten af den samme komponist eller af en anden."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks, die aus einer ausgeschmückten Passage für eine Solistin/einen Solisten besteht, die einem Musikwerk (zum Beispiel einem Konzert) entweder von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten hinzugefügt wird.,Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks, die aus einer ausgeschmückten Passage für eine Solistin/einen Solisten besteht, die einem Musikwerk (zum Beispiel einem Konzert) entweder von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten hinzugefügt wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μουσικού έργου που συνίσταται από ένα διακοσμητικό πέρασμα για έναν σολίστα, το οποίο προστίθεται σε ένα μουσικό έργο όπως ένα κοντσέρτο είτε επό τον ίδιο είτε από έναν διαφορετικό συνθέτη."],"en":["Relates an expression to an expression of a musical work that consists of an ornamental passage, for a soloist, added to an expression of a musical work such as a concerto either by the same or a different composer."],"es":["Relaciona una expresión con una expresión de una obra musical que consiste en un pasaje ornamental, para un solista, agregado a una expresión de una obra musical como un concierto ya sea del mismo o diferente compositor."],"et":["Seostab väljenduse muusikateose väljendusega, milleks on muusikateose väljendusele, nt instrumentaalkontserdile lisatud ornamentaalne soololõik samalt või teiselt heliloojalt."],"fi":["Liittää ekspression musiikkiteoksen ekspressioon, joka koostuu solistille tarkoitetusta koristeellisesta osasta ja on lisätty saman tai eri säveltäjän musiikkiteoksen, kuten konserton, ekspressioon."],"fr":["Met une expression en relation avec une expression d’une œuvre musicale qui consiste en un passage ornemental pour soliste, ajouté à une expression d’une œuvre musicale telle qu’un concerto, soit par le même compositeur, soit par un compositeur différent."],"hu":["Hozzákapcsol egy kifejezési formát egy zenemű kifejezési formájához, amely egy szólista számára alkotott díszítő szakaszból áll, amelyet egy versenyműhöz hasonló zenemű kifejezési formájához ad hozzá ugyanaz vagy egy másik zeneszerző."],"lv":["Sasaista izteiksmi ar mūzikas darba izteiksmi, kas ir solistam komponēta ornamentāla pasāža, kas pievienota citam muzikas darbam, piemēram, koncertam, kas ir vai nu tā paša, vai cita komponista radīts."],"nl":["Relateert een expressie aan een expressie van een muziekwerk dat bestaat uit een versierende passage, voor een soloïst, toegevoegd aan een expressie van een muziekwerk zoals een concerto door dezelfde of een andere componist."],"no":["Relaterer et uttrykk til et uttrykk av et musikalsk verk som en konsert, som enten den samme komponisten eller en annen komponist har komponert en solistisk passasje for."],"tr":["Bir anlatımı, aynı veya farklı bir bestecinin konçerto gibi bir müzik eserinin anlatımına eklenen, solist için bir süsleme pasajından oluşan bir müzik eserinin anlatımı ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm âm nhạc có chứa một đoạn mang tính trang hoàng cho nghệ sỹ độc tấu, thêm vào tác phẩm âm nhạc như là côngxéctô, bởi cùng hoặc khác người soạn."],"zh-Hans-CN":["将一种内容表达与由同一个或不同的作曲家附加在诸如协奏曲等一种音乐作品的一种内容表达中由独奏（唱）表演的装饰性乐段组成的一种音乐作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة كادنزا","ca":"expressió de cadència","cs":"kadence (vyjádření)","da":"kadenceudtryk","de":"Kadenz (Expression)","de":"Kadenz (Expression)","el":"καντέντσα (έκφραση)","en":"cadenza expression","es":"expresión de cadencia","et":"kadents (väljendus)","fi":"kadenssi (ekspressio)","fr":"cadence (expression)","hu":"kádencia kifejezési forma:","lv":"izteiksme: kadence","nl":"cadens-expressie","no":"kadens (uttrykk)","tr":"kadans anlatımı","vi":"cadenza (biểu hiện)","zh-Hans-CN":"华彩内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل موسيقي يحتوي على فقرة مصاحبة لعازف منفرد، مضافة إلى عمل موسيقي؛ مثل كونشرتو للملحن نفسه أو لملحن مختلف.","ca":"Expressió d’una obra musical que consisteix en un passatge ornamental per a un solista, afegit a una expressió d’una obra musical, com ara un concert, ja sigui pel mateix compositor o per un compositor diferent.","cs":"Vyjádření hudebního díla, které sestává z ozdobné pasáže pro sólistu, přidané k hudebnímu dílu, jako je koncert, od stejného nebo jiného skladatele.","da":"Udtryk af et musikværk, som består af en ornamental passage for en solist, som er tilføjet et musikværks udtryk såsom en koncert, enten af den samme komponist eller af en anden.","de":"Eine Expression eines Musikwerks, die aus einer ausgeschmückten Passage für eine Solistin/einen Solisten besteht, die einem Musikwerk (zum Beispiel einem Konzert) entweder von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten hinzugefügt wird.","de":"Eine Expression eines Musikwerks, die aus einer ausgeschmückten Passage für eine Solistin/einen Solisten besteht, die einem Musikwerk (zum Beispiel einem Konzert) entweder von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten hinzugefügt wird.","el":"Μια έκφραση ενός μουσικού έργου που συνίσταται από ένα διακοσμητικό πέρασμα για έναν σολίστα, το οποίο προστίθεται σε ένα μουσικό έργο, όπως ένα κοντσέρτο είτε επό τον ίδιο είτε από έναν διαφορετικό συνθέτη.","en":"An expression of a musical work that consists of an ornamental passage, for a soloist, added to an expression of a musical work such as a concerto either by the same or a different composer.","es":"Una expresión de una obra musical que consiste en un pasaje ornamental, para un solista, agregado a una expresión de una obra musical como un concierto ya sea del mismo o diferente compositor.","et":"Muusikateose väljendus, milleks on muusikateose väljendusele, nt instrumentaalkontserdile lisatud ornamentaalne soololõik samalt või teiselt heliloojalt.","fi":"Musiikkiteoksen ekspressio, joka koostuu solistille tarkoitetusta koristeellisesta osasta ja on lisätty saman tai eri säveltäjän musiikkiteoksen, kuten konserton, ekspressioon.","fr":"Expression d’une œuvre musicale qui consiste en un passage ornemental pour soliste, ajouté à une expression d’une œuvre musicale telle qu’un concerto, soit par le même compositeur, soit par un compositeur différent.","hu":"Egy zenemű kifejezési formája, amely egy szólista számára alkotott díszítő szakaszból áll, amelyet egy versenyműhöz hasonló zenemű kifejezési formájához ad hozzá ugyanaz vagy egy másik zeneszerző.","lv":"Muzikas darba izteiksme, kas ir solistam komponēta ornamentāla pasāža, kas pievienota citam muzikas darbam, piemēram, koncertam, kas ir vai nu tā paša, vai cita komponista radīts.","nl":"Een expressie van een muziekwerk dat bestaat uit een versierende passage, voor een soloïst, toegevoegd aan een expressie van een muziekwerk zoals een concerto door dezelfde of een andere componist.","no":"Et uttrykk av et musikalsk verk som en konsert, som enten den samme komponisten eller en annen komponist har komponert en solistisk passasje for.","tr":"Aynı ya da farklı bir besteciye ait konçerto gibi bir müzik eserinin anlatımına eklenen, solist için süslü bir pasajdan oluşan bir müzik eseri anlatımı.","vi":"Biểu hiện của tác phẩm âm nhạc có chứa một đoạn mang tính trang hoàng cho nghệ sỹ độc tấu, thêm vào tác phẩm âm nhạc như là côngxéctô, bởi cùng hoặc khác người soạn.","zh-Hans-CN":"由同一个或不同的作曲家附加在诸如协奏曲等一种音乐作品的一种内容表达中由独奏（唱）表演的装饰性乐段组成的一种音乐作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20105", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentedByExpression.en", "label":"is augmented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/cadenzaExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20080", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/cadenzaExpression.en", "label":"has cadenza expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20080", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/cadenzaExpression.en", "label":"has cadenza expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20083","label":{"ar":"هي كادنزا مؤلَفة لتعبيرة","ca":"és cadència composta per a una expressió","cs":"je kadencí zkomponovanou pro vyjádření","da":"er kadence komponeret til udtryk","de":"ist Kadenz komponiert für (Expression)","de":"ist Kadenz komponiert für (Expression)","el":"είναι καντέντσα που συντέθηκε ως (έκφραση)","en":"is cadenza composed for expression","es":"Es cadencia compuesta para la expresión","et":"kadents väljendusele","fi":"kadenssi ekspressioon","fr":"est une cadence composée pour une expression","hu":"kadencia a következő kifejezési formához komponálva:","lv":"ir kadence izteiksmei","nl":"is cadens gecomponeerd voor expressie","no":"er kadens komponert for uttrykk","tr":"anlatım için bestelenmiş kadanstır","vi":"là cadenza được soạn cho (biểu hiện)","zh-Hans-CN":"是为内容表达作曲的华彩段"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل موسيقي؛ مثل كونشرتو يضاف إلى تعبيرة لعمل موسيقي متمثل في فقرة مصاحبة لعازف منفرد للملحن نفسه أو لملحن مختلف."],"ca":["Relaciona una expressió amb una expressió d’una obra musical, com ara un concert, a la qual s’ha afegit una expressió d’una obra musical que és un passatge ornamental per a un solista, ja sigui pel mateix compositor o per un compositor diferent."],"cs":["Vztahuje vyjádření k vyjádření hudebního díla, jako je koncert, k němuž bylo přidáno vyjádření hudebního díla, které je ozdobnou pasáží pro sólistu od stejného nebo jiného skladatele."],"da":["Relaterer et udtryk til et udtryk af et musikværk, såsom en koncert, hvortil der er tilføljet et udtryk af et musikværk, som er en ornamental passage for en soloist, enten af den samme komponist eller af en anden."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks (zum Beispiel einem Konzert), für die von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten eine ausgeschmückte Passage für eine Solistin/einen Solisten hinzugefügt wurde.,Setzt eine Expression in Beziehung zu einer Expression eines Musikwerks (zum Beispiel einem Konzert), für die von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten eine ausgeschmückte Passage für eine Solistin/einen Solisten hinzugefügt wurde."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μουσικού έργου, όπως ένα κοντσέρτο, για το οποίο έχει συντεθεί ένα διακοσμητικό πέρασμα για έναν σολίστα είτε από τον ίδιο είτε από έναν διαφορετικό συνθέτη."],"en":["Relates an expression to an expression of a musical work, such as a concerto, to which is added an expression of musical work that is an ornamental passage for a soloist by the same or a different composer."],"es":["Relaciona una expresión con una expresión de una obra musical, como un concierto, al que se le añade una expresión de obra musical que es un pasaje ornamental para un solista del mismo o diferente compositor."],"et":["Seostab väljenduse muusikateose väljendusega, nt instrumentaalkontserdiga, millele on lisatud sama või teise helilooja muusikateos, milleks on ornamentaalne soololõik."],"fi":["Liittää ekspression musiikkiteoksen, kuten konserton, ekspressioon, johon on lisätty musiikkiteoksen ekspressio, joka on solistille tarkoitettu koristeellinen osa samalta tai eri säveltäjältä."],"fr":["Met une expression en relation avec une expression d’une œuvre musicale telle qu’un concerto à laquelle est ajoutée une expression d’une œuvre musicale consistant en un passage ornemental pour soliste composé par le même compositeur ou un compositeur différent."],"hu":["Hozzákapcsol egy kifejezési formát egy versenyműhöz hasonló zenemű kifejezési formájához, amelyhez egy szólistának szánt díszítő szakaszt alkotott ugyanaz vagy egy másik zeneszerző."],"lv":["Sasaista izteiksmi ar mūzikas darba izteiksmi, piemēram, koncerts, kuram ir pievienota cita mūzikas darba izteiksme, kas ir solistam komponēta ornamentāla pasāža, kas ir vai nu tā paša, vai cita komponista radīta."],"nl":["Relateert een expressie aan een expressie van een muziekwerk, zoals een concerto, waaraan een expressie van muziekwerk is toegevoegd dat een versierende passage is voor een soloïst door dezelfde of een andere componist."],"no":["Relaterer et uttrykk til et uttrykk av et musikalsk verk som en konsert, som består av en solistisk passasje for en soloist som er lagt til i et uttrykk av et musikalsk verk av samme eller en annen komponist."],"tr":["Bir anlatımı, aynı veya farklı bir bestecinin bir solist için süsleme pasajı olan bir müzik eseri anlatımının eklendiği konçerto gibi bir müzik eserinin anlatımyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm âm nhạc như là côngxéctô mà một đoạn mang tính trang hoàng cho nghệ sỹ độc tấu đã được soạn, bởi cùng hoặc khác người soạn."],"zh-Hans-CN":["将一种内容表达与由同一个或不同的作曲家附加由独奏（唱）表演的装饰性乐段组成的一种音乐作品的一种内容表达于其中的诸如协奏曲等一种音乐作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"كادنزا مؤلَفة لتعبيرة","ca":"cadència composta per a una expressió","cs":"kadence zkomponovaná pro vyjádření","da":"kadence komponeret til udtryk","de":"Kadenz komponiert für (Expression)","de":"Kadenz komponiert für (Expression)","el":"καντέντσα που συντέθηκε ως (έκφραση)","en":"cadenza composed for expression","es":"cadencia compuesta para la expresión","et":"kadents väljendusele","fi":"kadenssi ekspressioon","fr":"cadence composée pour une expression","hu":"kadencia kifejezési formához komponálva:","lv":"kadence izteiksmei","nl":"cadens gecomponeerd voor expressie","no":"kadens komponert for uttrykk","tr":"anlatım için bestelenen kadans","vi":"cadenza được soạn cho (biểu hiện)","zh-Hans-CN":"为内容表达作曲的华彩段"},"ToolkitDefinition":{"ar":"تعبيرة لعمل موسيقي؛ مثل كونشرتو يضاف إلى تعبيرة لعمل موسيقي متمثل في فقرة مصاحبة لعازف منفرد للملحن نفسه أو لملحن مختلف.","ca":"Expressió d’una obra musical, com ara un concert, a la qual s’ha afegit una expressió d’una obra musical que és un passatge ornamental per a un solista, ja sigui pel mateix compositor o per un compositor diferent.","cs":"Vyjádření hudebního díla, jako je koncert, k němuž bylo přidáno vyjádření hudebního díla, které je ozdobnou pasáží pro sólistu od stejného nebo jiného skladatele.","da":"Udtryk af et musikværk, såsom en koncert, hvortil der er tilføljet et udtryk af et musikværk, som er en ornamental passage for en soloist, enten af den samme komponist eller af en anden.","de":"Eine Expression eines Musikwerks (zum Beispiel einem Konzert), für die von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten eine ausgeschmückte Passage für eine Solistin/einen Solisten hinzugefügt wurde.","de":"Eine Expression eines Musikwerks (zum Beispiel einem Konzert), für die von derselben/demselben oder einer anderen Komponistin/einem anderen Komponisten eine ausgeschmückte Passage für eine Solistin/einen Solisten hinzugefügt wurde.","el":"Μια έκφραση ενός μουσικού έργου, όπως ένα κοντσέρτο, για το οποίο έχει συντεθεί ένα διακοσμητικό πέρασμα για έναν σολίστα είτε από τον ίδιο είτε από έναν διαφορετικό συνθέτη.","en":"An expression of a musical work, such as a concerto, to which is added an expression of musical work that is an ornamental passage for a soloist by the same or a different composer.","es":"Una expresión de una obra musical, como un concierto, a la que se añade una expresión de una obra musical que es un pasaje ornamental para un solista del mismo compositor o de otro diferente.","et":"Muusikateose väljendus, nt instrumentaalkontsert, millele on lisatud sama või teise helilooja muusikateos, milleks on ornamentaalne soololõik.","fi":"Musiikkiteoksen, kuten konserton, ekspressio, johon on lisätty musiikkiteoksen ekspressio, joka on solistille tarkoitettu koristeellinen osa samalta tai eri säveltäjältä.","fr":"Expression d’une œuvre musicale telle qu’un concerto à laquelle est ajoutée une expression d’une œuvre musicale consistant en un passage ornemental pour soliste composé par le même compositeur ou un compositeur différent.","hu":"Egy versenyműhöz hasonló zenemű kifejezési formája, amelyhez egy szólistának szánt díszítő szakaszt alkotott ugyanaz vagy egy másik zeneszerző.","lv":"Muzikas darba izteiksme, piemēram, koncerts, kuram ir pievienota cita mūzikas darba izteiksme, kas ir solistam komponēta ornamentāla pasāža, kas ir vai nu tā paša, vai cita komponista radīta.","nl":"Een expressie van een muziekwerk, zoals een concerto, waaraan een expressie van muziekwerk is toegevoegd dat een versierende passage is voor een soloïst door dezelfde of een andere componist.","no":"Et uttrykk av et musikalsk verk som en konsert, som består av en solistisk passasje for en soloist som er lagt til i et uttrykk av et musikalsk verk av samme eller en annen komponist.","tr":"Konçerto gibi bir müzik eserinin anlatımına, aynı veya farklı bir besteci tarafından solist için bir süsleme pasajı olan bir müzik eserinin anlatımının eklendiği bir müzik eserinin anlatımı.","vi":"Biểu hiện của tác phẩm âm nhạc như là côngxéctô mà một đoạn mang tính trang hoàng cho nghệ sỹ độc tấu đã được soạn, bởi cùng hoặc khác người soạn.","zh-Hans-CN":"由同一个或不同的作曲家附加由独奏（唱）表演的装饰性乐段组成的一种音乐作品的一种内容表达于其中的诸如协奏曲等一种音乐作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentationOfExpression.en", "label":"is augmentation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/cadenzaComposedForExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20083", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/cadenzaComposedForExpression.en", "label":"is cadenza composed for expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20083", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/cadenzaComposedForExpression.en", "label":"is cadenza composed for expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20107","label":{"ar":"لها تعبيرة فهرسية","ca":"té com a expressió de catàleg","da":"har katalogudtryk","de":"ist Katalog (Expression)","el":"είναι κατάλογος (έκφραση)","en":"has catalogue expression (Deprecated)","et":"kataloog (väljendus)","fi":"luettelo (ekspressio)","fr":"a pour catalogue (expression)","hu":"katalógusa a következő kifejezési forma:","lv":"izteiksme: katalogs","nl":"heeft catalogus-expressie","no":"har katalog (uttrykk)","vi":"là mục lục (biểu hiện)"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يتكون من حصر كامل لمفردات مرتبة ترتيبا منهجيا."],"ca":["Relaciona una expressió amb una expressió d’una obra que consisteix en una enumeració completa d’ítems arranjats sistemàticament."],"da":["Relaterer et udtryk til et udtryk af et værk, som består af en komplet fortegnelse over eksemplarer, som er arrangeret systematisk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einer vollständigen Aufzählung von Exemplaren besteht, die systematisch angeordnet sind."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συνιστά μια πλήρη απαρίθμηση οργανωμένων συστηματικά αντιτύπων."],"en":["Relates an expression to an expression of a work that consists of a complete enumeration of items arranged systematically. (Deprecated)"],"et":["Seostab väljenduse teose väljendusega, mis sisaldab tervikliku loetelu süstematiseeritud sissekandeid."],"fi":["Liittää ekspression teoksen ekspressioon, joka koostuu täydellisestä systemaattisesti järjestetystä yksiköiden listauksesta."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en une énumération complète d’items classés systématiquement."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely szisztematikusan elrendezett példányok teljes felsorolásából áll."],"lv":["Sasaista izteiksmi ar darba izteiksmi - pilnīgs sistemātiski kārtots vienību uzskaitījums."],"nl":["Relateert een expressie aan een expressie van een werk dat bestaat uit een complete opsomming van systematisch geordende items."],"no":["Relaterer et uttrykk til et uttrykk av et verk som består av en fullstendig og systematisk ordnet liste over innholdselementer."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm có chứa bảng liệt kê đầy đủ các hạng mục được sắp xếp có hệ thống."]},"ToolkitLabel":{"ar":"تعبيرة فهرسية","ca":"expressió de catàleg","da":"katalogudtryk","de":"Katalog (Expression)","el":"κατάλογος (έκφραση)","en":"catalogue expression (Deprecated)","es":"catálogo (expresión)","et":"kataloog (väljendus)","fi":"luettelo (ekspressio)","fr":"catalogue (expression)","hu":"katalógus kifejezési forma:","lv":"izteiksme: katalogs","nl":"catalogus-expressie","no":"katalog (uttrykk)","vi":"mục lục (biểu hiện)"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يتكون من حصر كامل لمفردات مرتبة ترتيبا منهجيا.","ca":"Expressió d’una obra que consisteix en una enumeració completa d’ítems arranjats sistemàticament.","da":"Udtryk af et værk, som består af en komplet fortegnelse over eksemplarer, som er arrangeret systematisk.","de":"Eine Expression eines Werks, die aus einer vollständigen Aufzählung von Exemplaren besteht, die systematisch angeordnet sind.","el":"Μια έκφραση ενός έργου το οποίο συνιστά μια πλήρη απαρίθμηση οργανωμένων συστηματικά αντιτύπων.","en":"An expression of a work that consists of a complete enumeration of items arranged systematically. (Deprecated)","es":"Una expresión de una obra que consiste en una enumeración completa de ítems ordenados sistemáticamente.","et":"Teose väljendus, mis sisaldab tervikliku loetelu süstematiseeritud sissekandeid.","fi":"Teoksen ekspressio, joka koostuu täydellisestä systemaattisesti järjestetystä yksiköiden listauksesta.","fr":"Expression d’une œuvre qui consiste en une énumération complète d’items classés systématiquement.","hu":"Egy mű kifejezési formája, amely szisztematikusan elrendezett példányok teljes felsorolásából áll.","lv":"Darba izteiksme - pilnīgs sistemātiski kārtots vienību uzskaitījums.","nl":"Een expressie van een werk dat bestaat uit een complete opsomming van systematisch geordende items.","no":"Et uttrykk av et verk som består av en fullstendig og systematisk ordnet liste over innholdselementer.","vi":"Biểu hiện của tác phẩm có chứa bảng liệt kê đầy đủ các hạng mục được sắp xếp có hệ thống."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20105", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentedByExpression.en", "label":"is augmented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/catalogueExpression.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20107", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/catalogueExpression.en", "label":"has catalogue expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20107", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/catalogueExpression.en", "label":"has catalogue expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20255","definition":{"ar":["تربط تعبيرة بتعبيرة لرواية مصورة مبنية على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una novel·la gràfica que es basa en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření grafického románu, který je založený na vyjádření jiného díla."],"da":["Relaterer et udtryk af en graphic novel, som er baseret på et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression einer Graphic Novel, die auf einer Expression eines anderen Werks basiert.,Setzt eine Expression in Beziehung zu einer Expression einer Graphic Novel, die auf einer Expression eines anderen Werks basiert."],"el":["Συνδέει μια έκφραση με ένα μυθιστόρημα σε μορφή κόμικ βασισμένο σε μια έκφραση-πηγή."],"en":["Relates an expression to an expression of a graphic novel that is based on an expression of another work."],"es":["Relaciona una expresión con una expresión de una novela gráfica que se basa en una expresión de otra obra."],"et":["Seostab väljenduse graafilise romaaniga, mis põhineb allikväljendusel."],"fi":["Liittää ekspression sarjakuvaromaanin ekspressioon, joka perustuu toisen teoksen ekspressioon."],"fr":["Met une expression en relation avec une expression d’un roman graphique qui est basée sur une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy képregény kifejezési formájához, amely egy másik mű kifejezési formáján alapul."],"lv":["Sasaista izteiksmi ar grafiskas noveles izteiksmi, kas veidota pēc pamatizteiksmes."],"nl":["Relateert een expressie aan een expressie van een stripboek dat is gebaseerd op een expressie van een ander werk."],"no":["Relaterer et uttrykk til en tegneserieroman basert på et kildeuttrykk."],"tr":["Bir anlatımı, başka bir eserin anlatımına dayanan bir grafik romanın anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu tiểu thuyết đồ hoạ dựa trên biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与基于另一种作品的一种内容表达的一种图解小说的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة كتعبيرة رواية مصورة","ca":"adaptat com a expressió de novel·la gràfica","cs":"adaptováno jako grafický román (vyjádření)","da":"bearbejdet til graphic novel-udtryk","de":"Bearbeitet als Graphic Novel (Expression)","de":"Bearbeitet als Graphic Novel (Expression)","el":"προσαρμοσμένο ως μυθιστόρημα σε μορφή κόμικ (έκφραση)","en":"adapted as graphic novel expression","es":"adaptado como expresión de novela gráfica","et":"adapteeritud graafilise romaanina (väljendus)","fi":"sarjakuvasovitus (ekspressio)","fr":"adapté en roman graphique (expression)","hu":"képregényként való feldolgozása a következő kifejezési formának:","lv":"adaptēts kā izteiksme: grafisks romāns","nl":"bewerkt als stripboek-expressie","no":"bearbeidet som tegneserieroman (uttrykk)","tr":"Çizgi roman anlatımı olarak uyarlanan","vi":"được phỏng theo như là biểu hiện tiểu thuyết đồ hoạ","zh-Hans-CN":"被改编为图解小说内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لرواية مصورة مبنية على تعبيرة لعمل آخر.","ca":"Expressió d’una novel·la gràfica que es basa en una expressió d’una altra obra.","cs":"Vyjádření grafického románu, který je založený na vyjádření jiného díla.","da":"Udtryk af en graphic novel, som er baseret på et udtryk af et andet værk.","de":"Eine Expression einer Graphic Novel, die auf einer Expression eines anderen Werks basiert.","de":"Eine Expression einer Graphic Novel, die auf einer Expression eines anderen Werks basiert.","el":"Ένα μυθιστόρημα σε μορφή κόμικ βασισμένο σε μια έκφραση-πηγή.","en":"An expression of a graphic novel that is based on an expression of another work.","es":"Una expresión de una novela gráfica que se basa en una expresión de otra obra.","et":"Graafiline romaan, mis põhineb allikväljendusel.","fi":"Sarjakuvaromaanin ekspressio, joka perustuu toisen teoksen ekspressioon.","fr":"Expression d’un roman graphique qui est basée sur une expression d’une autre œuvre.","hu":"Egy képregény kifejezési formája, amely egy másik mű kifejezési formáján alapul.","lv":"Romāns, izdots grafiskā variantā, veidots pēc pamatizteiksmes.","nl":"Een expressie van een stripboek dat is gebaseerd op een expressie van een ander werk.","no":"En tegneserieroman basert på et kildeuttrykk.","tr":"Bir çizgi romanın başka bir eserin anlatımına dayanan anlatımı.","vi":"Tiểu thuyết đồ hoạ dựa trên biểu hiện nguồn.","zh-Hans-CN":"基于另一种作品的一种内容表达的一种图解小说的一种内容表达"},"label":{"ar":"هي معالجة كتعبيرة رواية مصورة","ca":"és adaptat com a expressió de novel·la gràfica","cs":"je adaptováno jako grafický román (vyjádření)","da":"er bearbejdet til graphic novel-udtryk","de":"ist bearbeitet als Graphic Novel (Expression)","de":"ist bearbeitet als Graphic Novel (Expression)","el":"είναι προσαρμοσμένη ως μυθιστήρημα σε μορφή κόμικ (έκφραση)","en":"is adapted as graphic novel expression","es":"está adaptado como expresión de novela gráfica","et":"adapteeritud graafilise romaanina (väljendus)","fi":"sarjakuvasovitus (ekspressio)","fr":"est adapté en roman graphique (expression)","hu":"képregényként való feldolgozása a következő kifejezési formának:","lv":"ir adaptēts kā grafisks romāns (izteiksme)","nl":"is bewerkt als stripboek-expressie","no":"er bearbeidet som tegneserieroman (uttrykk)","tr":"çizgi roman anlatımı olarak uyarlanmıştır","vi":"được phỏng theo như là tiểu thuyết đồ hoạ (biểu hiện)","zh-Hans-CN":"被改编为图解小说内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsGraphicNovelExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en", "label":"is adapted as expression"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20255", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsGraphicNovelExpression.en", "label":"is adapted as graphic novel expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20255", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsGraphicNovelExpression.en", "label":"is adapted as graphic novel expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20155","label":{"ar":"لها تعبيرة معينات البحث","ca":"té com a expressió d’instrument de descripció","da":"har hjælpeværktøjsudtryk","de":"hat Findmittel (Expression)","el":"είναι εργαλείο έρευνας (έκφραση)","en":"has finding aid expression (Deprecated)","et":"arhiivinimistu (väljendus)","fi":"arkistokokoelman hakemisto (ekspressio)","fr":"a pour instrument de recherche (expression)","hu":"keresési segédlete a következő kifejezési forma:","lv":"izteiksme: meklēšanas palīglīdzeklis","nl":"heeft vind-hulpmiddel-expressie","no":"har veiledning (uttrykk)","vi":"là hỗ trợ tìm kiếm (biểu hiện)"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يوفر دليلًا إرشاديا لتنظيم مجموعة أرشيفية، وترتيبها، ومحتوياتها."],"ca":["Relaciona una expressió amb una expressió d’una obra que proporciona una guia a l’organització, l’arranjament i els continguts d’una col·lecció arxivística."],"da":["Relaterer et udtryk til et udtryk af et værk, som giver en vejledning til organiseringen, opsætningen og indholdet af en arkivsamling."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die eine Orientierungshilfe zum Aufbau, zur Anordnung und zu den Inhalten einer Archivsammlung enthält."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο παρέχει έναν οδηγό για την οργάνωση, την κατάταξη και τα περιεχόμενα μιας αρχειακής συλλογής."],"en":["Relates an expression to an expression of a work that provides a guide to the organization, arrangement, and contents of an archival collection. (Deprecated)"],"et":["Seostab väljenduse teose väljendusega, mis tutvustab arhiivikogu korrastuspõhimõtteid ja sisu."],"fi":["Liittää ekspression teoksen ekspressioon, joka opastaa arkistokokoelman järjestämisperiaatteisiin ja sisältöön."],"fr":["Met une expression en relation avec une expression d’une œuvre qui fournit un guide de l’organisation, du classement et du contenu d’une collection ou d’un fonds d’archives."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely útmutató egy levéltári gyűjtemény szervezetéhez, elrendezéséhez és tartalmához."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas nodrošina meklēšanas palīglīdzekli arhīva kolekcijā."],"nl":["Relateert een expressie aan een expressie van een werk dat een gids voor de organisatie, ordening en inhoud van een archiefcollectie levert."],"no":["Relaterer et uttrykk til et uttrykk av et verk som gir veiledning til innholdet i en arkivsamling og hvordan den er organisert."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm cung cấp chỉ dẫn về tổ chức, sắp xếp, và nội dung của bộ sưu tập lưu trữ."]},"ToolkitLabel":{"ar":"تعبيرة معينات البحث","ca":"expressió d’instrument de descripció","da":"hjælpeværktøjsudtryk","de":"Findmittel (Expression)","el":"εργαλείο έρευνας (έκφραση)","en":"finding aid expression (Deprecated)","es":"guía de búsqueda (expresión)","et":"arhiivinimistu (väljendus)","fi":"arkistokokoelman hakemisto (ekspressio)","fr":"instrument de recherche (expression)","hu":"keresési segédlet kifejezési formája:","lv":"izteiksme: meklēšanas palīglīdzeklis","nl":"vind-hulpmiddel-expressie","no":"veiledning (uttrykk)","vi":"hỗ trợ tìm kiếm (biểu hiện)"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يوفر دليلًا إرشاديا لتنظيم مجموعة أرشيفية، وترتيبها، ومحتوياتها.","ca":"Expressió d’una obra que proporciona una guia a l’organització, l’arranjament i els continguts d’una col·lecció arxivística.","da":"Udtryk af et værk, som giver en vejledning til organiseringen, opsætningen og indholdet af en arkivsamling.","de":"Eine Expression eines Werks, die eine Orientierungshilfe zum Aufbau, zur Anordnung und zu den Inhalten einer Archivsammlung enthält.","el":"Μια έκφραση ενός έργου το οποίο παρέχει έναν οδηγό για την οργάνωση,την κατάταξη και τα περιεχόμενα μιας αρχειακής συλλογής.","en":"An expression of a work that provides a guide to the organization, arrangement, and contents of an archival collection. (Deprecated)","es":"Una expresión de una obra que proporciona una guía para la organización, ordenación y contenido de una colección archivística.","et":"Teose väljendus, mis tutvustab arhiivikogu korrastuspõhimõtteid ja sisu.","fi":"Teoksen ekspressio, joka opastaa arkistokokoelman järjestämisperiaatteisiin ja sisältöön.","fr":"Expression d’une œuvre qui fournit un guide de l’organisation, du classement et du contenu d’une collection ou d’un fonds d’archives.","hu":"Egy mű kifejezési formája, amely útmutató egy levéltári gyűjtemény szervezetéhez, elrendezéséhez és tartalmához.","lv":"Darba izteiksme, kas nodrošina meklēšanas palīglīdzekli arhīva kolekcijā.","nl":"Een expressie van een werk dat een gids voor de organisatie, ordening en inhoud van een archiefcollectie levert.","no":"Et uttrykk av et verk som gir veiledning til innholdet i en arkivsamling og hvordan den er organisert.","vi":"Biểu hiện của tác phẩm cung cấp chỉ dẫn về tổ chức, sắp xếp, và nội dung của bộ sưu tập lưu trữ."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20105", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentedByExpression.en", "label":"is augmented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/findingAidExpression.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20155", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/findingAidExpression.en", "label":"has finding aid expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20155", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/findingAidExpression.en", "label":"has finding aid expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20197","label":{"ar":"هي معينات بحث لتعبيرة","ca":"és instrument de descripció per a una expressió","da":"er hjælpeværktøj til udtryk","de":"ist Findmittel für (Expression)","el":"είναι εργαλείο έρευνας για (έκφραση)","en":"is finding aid for expression (Deprecated)","et":"arhiivinimistu väljendusele","fi":"arkistokokoelman hakemisto ekspressiolle","fr":"est un instrument de recherche pour une expression","hu":"keresési segédlet a következő kifejezési formához::","lv":"ir meklēšanas palīglīdzeklis izteiksmei","nl":"is vind-hulpmiddel voor expressie","no":"er veiledning til uttrykk","vi":"là hỗ trợ tìm kiếm của (biểu hiện)"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل عبارة عن مجموعة أرشيفية موصوفة في دليل إرشادي لتنظيم المجموعة، وترتيبها، ومحتوياتها."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una col·lecció arxivística descrita per una guia a l’organització, l’arranjament i els continguts de la col·lecció."],"da":["Relaterer et udtryk til et udtryk af et værk, som er en arkivsamling, som beskreven en vejledning om organisering, opsætning og indhold af samlingen."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, bei der es sich um eine Archivsammlung handelt, die in einer Orientierungshilfe zum Aufbau, zur Anordnung und zu den Inhalten der Sammlung beschrieben ist."],"el":["Συνδέει μια έκφραση με μια έκφραση μιας αρχειακής συλλογής η οποία περιγράφεται σε ένα εργαλείο έρευνας, δηλαδή ένας οδηγός για τον οργανισμό, την οργάνωση και τα περιεχόμενα της συλλογής."],"en":["Relates an expression to an expression of a work that is an archival collection described by a guide to the organization, arrangement, and contents of the collection. (Deprecated)"],"et":["Seostab väljenduse väljendusega arhiivikogust, mida kirjeldatakse arhiivinimistus, st teatmikus, kus tutvustatakse kogu korrastuspõhimõtteid ja sisu."],"fi":["Liittää ekspression teoksen ekspressioon, joka on kokoelman järjestelyä ja sisältöä käsittelevän oppaan kuvaama arkistokokoelma."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en une collection ou un fonds d’archives décrit par un guide de l’organisation, du classement et du contenu de la collection ou du fonds."],"hu":["Hozzákapcsol egy kifejezési formát egy levéltári gyűjteménybe tartozó mű kifejezési formájához, amelyet leírnak a gyűjtemény szervezetének, elrendezésének és tartalmának a kalauzában."],"lv":["Sasaista izteiksmi ar arhīvu kolekcijas izteiksmi, kurai izveidota meklēšanas palīglīdzeklis."],"nl":["Relateert een expressie aan een expressie van een werk dat is een archiefcollectie die is beschreven in een gids voor de organisatie, ordening en inhoud van de collectie."],"no":["Relaterer et uttrykk til et uttrykk av en arkivsamling som beskrives i en veiledning, dvs. en veiledning til innholdet i samlingen og hvordan den er organisert."],"vi":["Liên kết một biểu hiện với biểu hiện của bộ sưu tập lưu trữ được mô tả trong hỗ trợ tìm kiếm, nghĩa là, chỉ dẫn về tổ chức, sắp xếp, và nội dung của bộ sưu tập đó."]},"ToolkitLabel":{"ar":"معينات بحث لتعبيرة","ca":"instrument de descripció per a una expressió","da":"hjælpeværktøj til udtryk","de":"Findmittel für (Expression)","el":"εργαλείο έρευνας για (έκφραση)","en":"finding aid for expression (Deprecated)","es":"guía de búsqueda de (expresión)","et":"arhiivinimistu väljendusele","fi":"arkistokokoelman hakemisto ekspressiolle","fr":"instrument de recherche pour une expression","hu":"keresési segédlet a következő kifejezési formához::","lv":"meklēšanas palīglīdzeklis izteiksmei","nl":"vind-hulpmiddel voor expressie","no":"veiledning til uttrykk","vi":"hỗ trợ tìm kiếm của (biểu hiện)"},"ToolkitDefinition":{"ar":"تعبيرة لعمل عبارة عن مجموعة أرشيفية موصوفة في دليل إرشادي لتنظيم المجموعة، وترتيبها، ومحتوياتها.","ca":"Expressió d’una obra que és una col·lecció arxivística descrita per una guia a l’organització, l’arranjament i els continguts de la col·lecció.","da":"Udtryk af et værk, som er en arkivsamling, som beskreven en vejledning om organisering, opsætning og indhold af samlingen.","de":"Eine Expression eines Werks, bei der es sich um eine Archivsammlung handelt, die in einer Orientierungshilfe zum Aufbau, zur Anordnung und zu den Inhalten der Sammlung beschrieben ist.","el":"Μια έκφραση μιας αρχειακής συλλογής η οποία περιγράφεται σε ένα εργαλείο έρευνας, δηλαδή ένας οδηγός για τον οργανισμό, την οργάνωση και τα περιεχόμενα της συλλογής.","en":"An expression of a work that is an archival collection described by a guide to the organization, arrangement, and contents of the collection. (Deprecated)","es":"Una expresión de una colección archivística que está descrita en una guía de búsqueda, i.e., una guía para la organización, ordenación y contenido de la colección.","et":"Väljendus arhiivikogust, mida kirjeldatakse arhiivinimistus, st teatmikus, kus tutvustatakse kogu korrastuspõhimõtteid ja sisu.","fi":"Teoksen ekspressio, joka on kokoelman järjestelyä ja sisältöä käsittelevän oppaan kuvaama arkistokokoelma.","fr":"Expression d’une œuvre qui consiste en une collection ou un fonds d’archives décrit par un guide de l’organisation, du classement et du contenu de la collection ou du fonds.","hu":"Egy levéltári gyűjteménybe tartozó mű kifejezési formája, amelyet leírnak a gyűjtemény szervezetének, elrendezésének és tartalmának a kalauzában.","lv":"Arhīvu kolekcijas izteiksme, kurai izveidots meklēšanas palīglīdzeklis.","nl":"Een expressie van een werk dat is een archiefcollectie die is beschreven in een gids voor de organisatie, ordening en inhoud van de collectie.","no":"Et uttrykk av en arkivsamling som beskrives i en veiledning, dvs. en veiledning til innholdet i samlingen og hvordan den er organisert.","vi":"Biểu hiện của bộ sưu tập lưu trữ được mô tả trong hỗ trợ tìm kiếm, nghĩa là, chỉ dẫn về tổ chức, sắp xếp, và nội dung của bộ sưu tập đó."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentationOfExpression.en", "label":"is augmentation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/findingAidForExpression.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20197", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/findingAidForExpression.en", "label":"is finding aid for expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20197", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/findingAidForExpression.en", "label":"is finding aid for expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20326","label":{"ar":"لها مفتاح موسيقي لتعبيرة","ca":"té com a tonalitat d’una expressió","cs":"má tóninu vyjádření","da":"har toneart af udtryk","de":"hat Tonart einer Expression","de":"hat Tonart einer Expression","en":"has key of expression","es":"tiene clave de expresión","et":"väljenduse helistik","fi":"ekspression sävellaji","fr":"a pour tonalité d’une expression","hu":"kifejezési forma kulcsa a következő:","lv":"izteiksmes tonalitāte","nl":"heeft toonsoort van expressie","no":"har toneart for uttrykk","tr":"anlatımın tonu ile ilişkilidir","zh-Hans-CN":"有内容表达的调"},"ToolkitLabel":{"ar":"مفتاح موسيقي لتعبيرة","ca":"tonalitat d’una expressió","cs":"tónina vyjádření","da":"toneart af udtryk","de":"Tonart einer Expression","de":"Tonart einer Expression","en":"key of expression","es":"clave de expresión","et":"väljenduse helistik","fi":"ekspression sävellaji","fr":"tonalité d’une expression","hu":"kifejezési forma kulcsa:","lv":"izteiksmes tonalitāte","nl":"toonsoort van expressie","no":"toneart for uttrykk","tr":"ifadenin anahtarı","zh-Hans-CN":"内容表达的调"},"ToolkitDefinition":{"ar":"مجموعة من علاقات النغمات التي تؤسس مركز النغمات أو مركز النغمات الرئيسي المستخدم أو المزمع استخدامه لأداء محتوى موسيقي لتعبيرة.","ca":"Conjunt de les relacions entre les altures de sons que determina el centre tonal o el centre tonal principal, usat o concebut per ser usat, per a una execució de contingut musical d’una expressió.","cs":"Soubor vztahů mezi tóny, tvořícímu tonální centrum nebo hlavní tonální centrum, které se používá nebo má být použito pro provedení hudebního obsahu vyjádření.","da":"Sæt af intervaller, som fastlægger den toneart, eller det tonale udgangspunkt, som er brugt, eller som er beregnet til brug, til opførelse af et udtryks musikalske indhold.","de":"Ein Satz an Tonhöhenbeziehungen, der das tonale Zentrum oder das hauptsächliche tonale Zentrum begründet, das für eine Darbietung musikalischen Inhalts einer Expression verwendet wird oder verwendet werden soll.","de":"Ein Satz an Tonhöhenbeziehungen, der das tonale Zentrum oder das hauptsächliche tonale Zentrum begründet, das für eine Darbietung musikalischen Inhalts einer Expression verwendet wird oder verwendet werden soll.","en":"A set of pitch relationships that establishes the tonal centre, or principal tonal centre, used, or intended to be used, for performance of musical content of an expression.","es":"Un conjunto de relaciones tonales que establece el centro tonal, o centro tonal principal, utilizado, o que se pretende utilizar, para la interpretación del contenido musical de una expresión.","et":"Helikõrguste suhete kogum, mis määrab väljenduse muusikalise sisu esitamiseks kasutatud või esitamiseks mõeldud toonika või peamise toonika.","fi":"Sävelsuhteiden joukko, johon ekspression musiikillisen sisällön esityksessä käytetty tai käytettäväksi tarkoitettu tonaalinen keskus tai pääasiallinen tonaalinen keskus perustuu.","fr":"Ensemble des rapports entre les hauteurs de sons qui détermine le centre tonal ou le principal centre tonal utilisé ou destiné à être utilisé dans une exécution d’un contenu musical d’une expression.","hu":"Hangmagassági kapcsolatok halmaza, amely tonális központot vagy fő tonális központot hoz létre, amelyet a kifejezési forma zenei tartalmának előadásához használnak vagy használni kívánnak.","lv":"Izteiksmes skaņkārta ar noteiktu toniku. Tonalitāte iegūst nosaukumu no savas tonikas un vārda, kas apzīmē skaņkārtu. (Mūzikas elementārteorija, 1981 Krasinska, Utkins)","nl":"Een verzameling van toonhoogterelaties die het tonaal centrum vormen, of belangrijkste tonale centrum, gebruikt of bedoeld om te gebruiken, voor uitvoering van muzikale content van een expressie.","no":"Et sett med forhold mellom tonehøyder som bestemmer sentraltonen som er brukt eller tenkt brukt for framføring av musikalsk innhold av et uttrykk.","tr":"Bir anlatımın müzikal içeriğinin icrası için kullanılan veya kullanılması amaçlanan tonal merkezini veya ana tonal merkezini belirleyen bir dizi perde ilişkisi.","zh-Hans-CN":"为一种内容表达的音乐内容之表演建立所用或计划所用的调性中心或主调性中心的一组音高关系"},"definition":{"ar":["تربط بين تعبيرة ومجموعة من علاقات النغمات التي تؤسس مركز النغمات أو مركز النغمات الرئيسي المستخدم أو المزمع استخدامه لأداء محتوى موسيقي لتعبيرة."],"ca":["Relaciona una expressió amb un conjunt de les relacions entre les altures de sons que determina el centre tonal o el centre tonal principal, usat o concebut per ser usat, per a una execució de contingut musical d’una expressió."],"cs":["Vztahuje vyjádření k souboru vztahů mezi tóny, tvořícímu tonální centrum nebo hlavní tonální centrum, které se používá nebo má být použito pro provedení hudebního obsahu vyjádření."],"da":["Relaterer et udtryk til et sæt af intervaller, som fastlægger den toneart, eller det tonale udgangspunkt, som er brugt, eller som er beregnet til brug, til opførelse af et udtryks musikalske indhold."],"de":["Setzt eine Expression in Beziehung zu einem Satz an Tonhöhenbeziehungen, der das tonale Zentrum oder das hauptsächliche tonale Zentrum begründet, das für eine Darbietung musikalischen Inhalts einer Expression verwendet wird oder verwendet werden soll.,Setzt eine Expression in Beziehung zu einem Satz an Tonhöhenbeziehungen, der das tonale Zentrum oder das hauptsächliche tonale Zentrum begründet, das für eine Darbietung musikalischen Inhalts einer Expression verwendet wird oder verwendet werden soll."],"en":["Relates an expression to a set of pitch relationships that establishes the tonal centre, or principal tonal centre, used, or intended to be used, for performance of musical content of an expression."],"es":["Relaciona una expresión con un conjunto de relaciones tonales que establece el centro tonal, o centro tonal principal, utilizado, o que se pretende utilizar, para la interpretación del contenido musical de una expresión."],"et":["Seostab väljenduse helikõrguste suhete kogumiga, mis määrab väljenduse muusikalise sisu esitamiseks kasutatud või esitamiseks mõeldud toonika või peamise toonika."],"fi":["Liittää ekspression sävelsuhteiden joukkoon, johon ekspression musiikillisen sisällön esityksessä käytetty tai käytettäväksi tarkoitettu tonaalinen keskus tai pääasiallinen tonaalinen keskus perustuu."],"fr":["Met une expression en relation avec un ensemble des rapports entre les hauteurs de sons qui détermine le centre tonal ou le principal centre tonal utilisé ou destiné à être utilisé dans une exécution d’un contenu musical d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát hangmagassági kapcsolatok halmazához, amely tonális központot vagy fő tonális központot hoz létre, amelyet a kifejezési forma zenei tartalmának előadásához használnak vagy használni kívánnak."],"lv":["Sasaista izteiksmi ar izteiksmes skaņkārtu ar noteiktu toniku. Tonalitāte iegūst nosaukumu no savas tonikas un vārda, kas apzīmē skaņkārtu. (Mūzikas elementārteorija, 1981 Krasinska, Utkins)."],"nl":["Relateert een expressie aan een verzameling van toonhoogterelaties die het tonaal centrum vormen, of belangrijkste tonale centrum, gebruikt of bedoeld om te gebruiken, voor uitvoering van muzikale content van een expressie."],"no":["Relaterer et uttrykk til et sett med forhold mellom tonehøyder som bestemmer sentraltonen som er brukt eller tenkt brukt for framføring av musikalsk innhold av et uttrykk."],"tr":["Bir anlatımı, anlatımın müzikal içeriğinin performansı için kullanılan veya kullanılması amaçlanan tonal merkezi veya ana tonal merkezi belirleyen bir dizi perde ilişkisiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与为一种内容表达的音乐内容之表演建立所用或计划所用的调性中心或主调性中心的一组音高关系关联起来。"]},"altLabel":{"ar":["مفتاح موسيقي"],"ca":["tonalitat"],"cs":["tónina"],"de":["Tonart,die Tonart"],"en":["key"],"es":["clave"],"fi":["sävellaji"],"fr":["tonalité"],"hu":["kulcs"],"nl":["toonsoort"],"tr":["Anahtar"],"zh-Hans-CN":["调"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/keyOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20326", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/keyOfExpression.en", "label":"has key of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20326", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/keyOfExpression.en", "label":"has key of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20046","definition":{"ca":["Relaciona una expressió amb un agent que contribueix a una expressió d’una obra proporcionant un contingut textual suplementari, com ara una introducció o un prefaci a una obra original."],"da":["Relaterer et udtryk til en agent, der har bidraget til et udtryk af et værk ved at tilvejebringe supplerende tekstindhold, fx en indledning eller et forord til det originale værk."],"de":["Setzt eine Expression mit einem Akteur, der an einer Expression eines Werks mitwirkt, indem er ergänzenden Text zum Originalwerk liefert, z. B. eine Einführung, ein Vorwort, in Beziehung."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας συνοδευτικό κειμενικό περιεχόμενο όπως εισαγωγή ή πρόλογο σε ένα πρωτότυπο έργο."],"en":["Relates an expression to an agent who contributes to an expression by providing supplementary textual content, such as an introduction or a preface, to an original work. (Deprecated)"],"fi":["Liittää ekspression toimijaan, joka osallistuu teoksen ekspression tekemiseen tuottamalla täydentävää tekstiä (esim. johdannon, esipuheen) alkuperäiseen teokseen."],"fr":["Met une expression en relation avec un agent qui contribue à une expression d’une œuvre en fournissant du contenu textuel supplémentaire tel qu’une introduction ou une préface à une œuvre originale."],"hu":["Egy kifejezési formát hozzákapcsol egy ágenshez (személyhez, családhoz vagy testülethez), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy eredeti művet kiegészítő szöveges tartalommal, például bevezetéssel vagy előszóval lát el."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp nội dung văn bản phụ thêm, như là lời giới thiệu hoặc lời nói đầu, cho tác phẩm nguyên gốc."]},"ToolkitLabel":{"ca":"escriptor de contingut textual suplementari","da":"forfatter til supplerende tekstindhold","de":"Verfasser von ergänzendem Text","el":"συγγραφέας του συμπληρωματικού κειμενικού περιεχομένου","en":"writer of supplementary textual content (Deprecated)","es":"autor de contenido textual suplementario","fi":"oheistekstin kirjoittaja","fr":"auteur de contenu textuel supplémentaire","hu":"kiegészítő szöveges tartalom írója","no":"forfatter av supplerende tekstinnhold","vi":"người viết nội dung văn bản phụ lục"},"ToolkitDefinition":{"ca":"Agent que contribueix a una expressió d’una obra proporcionant un contingut textual suplementari, com ara una introducció o un prefaci a una obra original.","da":"Agent, der har bidraget til et udtryk af et værk ved at tilvejebringe supplerende tekstindhold, fx en indledning eller et forord, til det originale værk.","de":"Ein Akteur, der an einer Expression eines Werks mitwirkt, indem er ergänzenden Text zum Originalwerk liefert, z. B. eine Einführung, ein Vorwort.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου παρέχοντας συνοδευτικό κειμενικό περιεχόμενο, όπως εισαγωγή ή πρόλογο σε ένα πρωτότυπο έργο.","en":"An agent who contributes to an expression by providing supplementary textual content, such as an introduction or a preface, to an original work. (Deprecated)","es":"Una persona, familia o entidad corporativa que contribuye a una expresión de una obra ofreciendo contenido textual suplementario (por ej., una introducción, un prefacio) a la obra original.","fi":"Toimija, joka osallistuu teoksen ekspression tekemiseen tuottamalla täydentävää tekstiä (esim. johdannon, esipuheen) alkuperäiseen teokseen.","fr":"Agent qui contribue à une expression d’une œuvre en fournissant du contenu textuel supplémentaire tel qu’une introduction ou une préface à une œuvre originale.","hu":"Egy ágens (személy, család vagy testület), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy eredeti művet kiegészítő szöveges tartalommal, mint például bevezetéssel vagy előszóval lát el.","no":"En agent som bidrar til et uttrykk av et verk ved å tilføre supplerende tekstinnhold til originalverket, for eksempel et forord eller en innledning.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp nội dung văn bản phụ thêm, như là lời giới thiệu hoặc lời nói đầu, cho tác phẩm nguyên gốc."},"label":{"ca":"té com a escriptor de contingut textual suplementari","da":"har forfatter til supplerende tekstindhold","de":"hat Verfasser von ergänzendem Text","el":"έχει συγγραφέα του συμπληρωματικού κειμενικού περιεχομένου","en":"has writer of supplementary textual content (Deprecated)","fi":"oheistekstin kirjoittaja","fr":"a pour auteur de contenu textuel supplémentaire","hu":"van kiegészító szövegestartalom-írója","vi":"có người viết nội dung văn bản phụ lục"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20332", "lexicalAlias":"http://rdaregistry.info/Elements/e/authorOfExpression.en", "label":"has author of expression (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfSupplementaryTextualContent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20045", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfIntroduction.en", "label":"has writer of introduction (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20041", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfPreface.en", "label":"has writer of preface (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20275", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfForeword.en", "label":"has writer of foreword (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20044", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfAddedCommentary.en", "label":"has writer of added commentary (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20030", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfAddedText.en", "label":"has writer of added text (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20238", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfPostface.en", "label":"has writer of postface (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20237", "lexicalAlias":"http://rdaregistry.info/Elements/e/writerOfAfterword.en", "label":"has writer of afterword (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/object/P20046", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/writerOfSupplementaryTextualContent.en", "label":"has writer of supplementary textual content (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20046", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/writerOfSupplementaryTextualContent.en", "label":"has writer of supplementary textual content (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20206","definition":{"ca":["Relaciona una expressió amb una indicació del contingut que actualitza o complementa el contingut principal d’una expressió."],"da":["Relaterer et udtryk til en indikation af indhold der opdaterer eller supplerer et udtryks primære indhold."],"de":["Setzt eine Expression in Beziehung zu einer Angabe über den Inhalt, die den primären Inhalt einer Expression aktualisiert oder ergänzt."],"el":["Συνδέει μια έκφραση με μια δήλωση του περιεχομένου η οποία ενημερώνει ή συμπληρώνει το κύριο περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to an indication of content that updates or complements the primary content of an expression. (Deprecated)"],"et":["Seostab väljenduse osutusega sisule, mis uuendab või täiendab väljenduse esmast sisu."],"fi":["Liittää ekspression sisältöön, joka päivittää tai täydentää ekspression varsinaista sisältöä."],"fr":["Met une expression en relation avec une indication d’un contenu qui met à jour ou complète le contenu principal d’une expression."],"hu":["Egy kifejezési formát hozzákapcsol egy olyan tartalom jelzéséhez, amely egy kifejezési forma elsődleges tartalmát frissíti vagy kiegészíti."],"nl":["Relateert een expressie aan een aanduiding van content dat de primaire content van een expressie updatet of complementeert."],"no":["Relaterer et uttrykk til en angivelse av innhold som oppdaterer eller på annen måte utfyller hovedinnholdet i et uttrykk."],"vi":["Liên kết một biểu hiện với chỉ dẫn nội dung cập nhật hoặc bổ sung cho nội dung chính của biểu hiện."]},"ToolkitLabel":{"ca":"contingut suplementari","da":"supplerende indhold","de":"Ergänzender Inhalt","el":"συμπληρωματικό περιεχόμενο","en":"supplementary content (Deprecated)","es":"contenido suplementario","et":"täiendav sisu","fi":"lisätty sisältö","fr":"contenu supplémentaire","hu":"kiegészítő tartalom","nl":"supplementaire content","no":"supplerende innhold","sv":"bihang","vi":"nội dung phụ trợ"},"ToolkitDefinition":{"ca":"Indicació del contingut que actualitza o complementa el contingut principal d’una expressió.","da":"Indikation af indhold der opdaterer eller supplerer et udtryks primære indhold.","de":"Eine Angabe über den Inhalt, die den primären Inhalt einer Expression aktualisiert oder ergänzt.","el":"Μια δήλωση του περιεχομένου η οποία ενημερώνει ή συμπληρώνει το κύριο περιεχόμενο μιας έκφρασης.","en":"An indication of content that updates or complements the primary content of an expression. (Deprecated)","es":"Contenido (por j., un índice, una bibliografía, un apéndice) destinado a suplementar el contenido primario de un recurso.","et":"Osutus sisule, mis uuendab või täiendab väljenduse esmast sisu.","fi":"Sisältö, jokan päivittää tai täydentää ekspression varsinaista sisältöä.","fr":"Indication d’un contenu qui met à jour ou complète le contenu principal d’une expression.","hu":"Tartalmi jelzés, amely egy kifejezési forma elsődleges tartalmát frissíti vagy kiegészíti.","nl":"Een aanduiding van content dat de primaire content van een expressie updatet of complementeert.","no":"En angivelse av innhold som oppdaterer eller på annen måte utfyller hovedinnholdet i et uttrykk.","vi":"Chỉ dẫn nội dung cập nhật hoặc bổ sung cho nội dung chính của biểu hiện."},"note":{"ca":["El contingut suplementari inclou un índex, una bibliografia, un apèndix, etc."],"da":["Supplerende indhold omfatter et indeks, en bibliografi, et bilag ect."],"de":["Unter ergänzenden Inhalt fällt ein Register, eine Bibliografie, ein Anhang und so weiter."],"el":["Το συμπληρωματικό περιεχόμενο μπορεί να περιλαμβάνει ένα ευρετήριο, μια βιβλιογραφία ή ένα παράρτημα."],"en":["Supplementary content includes an index, a bibliography, an appendix, etc. (Deprecated)"],"et":["Täiendav sisu hõlmab registrit, bibliograafiat, apendiksit vms."],"fi":["Lisättyyn sisältöön kuuluvat hakemisto, bibliografia, liite yms."],"fr":["Un contenu supplémentaire comprend un index, une bibliographie, une annexe, etc."],"hu":["A kiegészítő tartalom magába foglalhat egy indexet, bibliográfiát, vagy függeléket."],"nl":["Supplementaire content omvat een index, een bibliografie, een appendix etc."],"no":["Supplerende innhold kan inkludere en indeks, en bibliografi, et tillegg etc."],"vi":["Nội dung phụ trợ có thể bao gồm cả chỉ mục, thư mục, hoặc phụ bản."]},"label":{"ca":"té com a contingut suplementari","da":"har supplerende indhold","de":"hat ergänzenden Inhalt","el":"έχει συμπληρωματικό περιεχόμενο","en":"has supplementary content (Deprecated)","et":"täiendav sisu","fi":"lisätty sisältö","fr":"a pour contenu supplémentaire","hu":"kiegészítő tartalma","nl":"heeft supplementaire content","no":"har supplerende innhold","sv":"har bihang","vi":"có nội dung phụ trợ"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/supplementaryContent.en","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20206", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/supplementaryContent.en", "label":"has supplementary content (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20100","label":{"ar":"هي مكملة بتعبيرة","ca":"és complementat per una expressió","cs":"je komplementováno vyjádřením","da":"er komplementeret af udtryk","de":"ist vervollständigt durch (Expression)","de":"ist vervollständigt durch (Expression)","el":"είναι συμπληρωμένη από (έκφραση)","en":"is complemented by expression","es":"se complementa con la expresión","et":"täiendatud väljendusega","fi":"täydentävä ekspressio","fr":"est complété par une expression","hu":"kiegészíti a következő kifejezési forma:","lv":"ir kopā ar izteiksmi","nl":"is gecomplementeerd door expressie","no":"er utfylt av uttrykk","tr":"anlatım ile tamamlanmıştır","vi":"được bổ sung bằng (biểu hiện)","zh-Hans-CN":"被一种内容表达补充"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مقترن بتعبيرة ذات صلة دون اعتبار أي منهما التعبيرة السائدة."],"ca":["Relaciona una expressió amb una expressió d’una obra que s’aparella amb una expressió relacionada sense que cap de les expressions es consideri que predomina."],"cs":["Vztahuje vyjádření k vyjádření díla, které je spárováno se souvisejícím vyjádřením, aniž by se některé z vyjádření považovalo za hlavní."],"da":["Relaterer et udtryk til et udtryk af et værk, som er parret med et relateret udtryk, uden at ét af udtrykkene betragtes som værende hovedudtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die mit einer in Beziehung stehenden Expression zusammengebracht wird, ohne dass eine der beiden als Haupt-Expression angesehen wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die mit einer in Beziehung stehenden Expression zusammengebracht wird, ohne dass eine der beiden als Haupt-Expression angesehen wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συνδυάζεται με κάποια άλλη έκφραση χωρίς να θεωρείται οποιαδήποτε εξ αυτών ως κύρια [έκφραση]."],"en":["Relates an expression to an expression of a work that is paired with a related expression without either expression being considered to be predominate."],"es":["Relaciona una expresión con una expresión de una obra que está emparejada con una expresión relacionada sin que ninguna de las expresiones se considere predominante."],"et":["Seostab väljenduse teose väljendusega, mis on paaristatud seotud väljendusega, ilma et kumbagi väljendust peetaks dominantseks."],"fi":["Liittää ekspression teoksen ekspressioon, joka on yhdistetty siihen liittyvään ekspressioon ilman, että kumpaakaan ekspressiota pidetään ensisijaisena."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est jumelée à une expression en relation sans qu’aucune des deux expressions ne soit considérée comme prédominante."],"hu":["Hozzákapcsol egy kifejezési formát egy kapcsolódó kifejezési formával párosított mű kifejezési formájához, anélkül, hogy bármelyiket dominánsnak kellene tekinteni."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kura saistīta ar citu izteiksmi, kur neviena no tām nav uzskatāma par dominējošo."],"nl":["Relateert een expressie aan een expressie van een werk dat is gecombineerd met een gerelateerde expressie zonder dat een van beide gezien wordt als de belangrijkste."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er kombinert med et relatert uttrykk uten at ett av uttrykkene dominerer."],"tr":["Bir anlatımı, her iki anlatımın da baskın olduğu düşünülmeksizin ilgili bir anlatımla eşleştirilen bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm ghép đôi với biểu hiện khác mà không có biểu hiện nào được xem là nổi trội."],"zh-Hans-CN":["将一种内容表达与和一种相关内容表达配对而两者都不被认为占主导地位的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مكملة بتعبيرة","ca":"complementat per una expressió","cs":"komplementováno vyjádřením","da":"komplementeret af udtryk","de":"Vervollständigt durch (Expression)","de":"Vervollständigt durch (Expression)","el":"συμπληρωμένη από (έκφραση)","en":"complemented by expression","es":"complementado por la expresión","et":"täiendatud väljendusega","fi":"täydentävä ekspressio","fr":"complété par une expression","hu":"kifejezési formával kiegészítve:","lv":"kopā ar izteiksmi","nl":"gecomplementeerd door expressie","no":"utfylt av uttrykk","tr":"anlatımla tamamlanır","vi":"được bổ sung bằng (biểu hiện)","zh-Hans-CN":"被一种内容表达补充"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مقترن بتعبيرة ذات صلة دون اعتبار أي منهما التعبيرة السائدة.","ca":"Expressió d’una obra que s’aparella amb una expressió relacionada sense que cap de les expressions es consideri que predomina.","cs":"Vyjádření díla, které je spárováno se souvisejícím vyjádřením, aniž by se některé z vyjádření považovalo za hlavní.","da":"Udtryk af et værk, som er parret med et relateret udtryk, uden at ét af udtrykkene betragtes som værende hovedudtryk.","de":"Eine Expression eines Werks, die mit einer in Beziehung stehenden Expression zusammengebracht wird, ohne dass eine der beiden als Haupt-Expression angesehen wird.","de":"Eine Expression eines Werks, die mit einer in Beziehung stehenden Expression zusammengebracht wird, ohne dass eine der beiden als Haupt-Expression angesehen wird.","el":"Μια έκφραση ενός έργου το οποίο συνδυάζεται με κάποια άλλη έκφραση χωρίς να θεωρείται οποιαδήποτε εξ αυτών ως κύρια [έκφραση].","en":"An expression of a work that is paired with a related expression without either expression being considered to be predominate.","es":"Una expresión de una obra que está emparejada con una expresión relacionada sin que ninguna de las expresiones se considere predominante.","et":"Teose väljendus, mis on paaristatud seotud väljendusega, ilma et kumbagi väljendust peetaks dominantseks.","fi":"Teoksen ekspressio, joka on yhdistetty siihen liittyvään ekspressioon ilman, että kumpaakaan ekspressiota pidetään ensisijaisena.","fr":"Expression d’une œuvre qui est jumelée à une expression en relation sans qu’aucune des deux expressions ne soit considérée comme prédominante.","hu":"Egy kapcsolódó kifejezési formával párosított mű kifejezési forma, anélkül, hogy bármelyiket dominánsnak kellene tekinteni.","lv":"Darba izteiksme, kura saistīta ar citu izteiksmi, kur neviena no tām nav uzskatāma par dominējošo.","nl":"Een expressie van een werk dat is gecombineerd met een gerelateerde expressie zonder dat een van beide gezien wordt als de belangrijkste.","no":"Et uttrykk av et verk som er kombinert med et relatert uttrykk uten at ett av uttrykkene dominerer.","tr":"Her iki anlatımın da baskın olduğu düşünülmeksizin ilgili bir anlatım ile eşleştirilen bir eser anlatımı.","vi":"Biểu hiện của tác phẩm ghép đôi với biểu hiện khác mà không có biểu hiện nào được xem là nổi trội.","zh-Hans-CN":"和一种相关内容表达配对而两者都不被认为占主导地位的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20157", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayExpression.en", "label":"has screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/P20102", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayForExpression.en", "label":"is screenplay for expression"},{"@id":"http://rdaregistry.info/Elements/e/P20176", "lexicalAlias":"http://rdaregistry.info/Elements/e/scriptForRadioProgramExpression.en", "label":"is script for radio program expression"},{"@id":"http://rdaregistry.info/Elements/e/P20253", "lexicalAlias":"http://rdaregistry.info/Elements/e/choreographyExpression.en", "label":"has choreography expression"},{"@id":"http://rdaregistry.info/Elements/e/P20254", "lexicalAlias":"http://rdaregistry.info/Elements/e/choreographyForExpression.en", "label":"is choreography for expression"},{"@id":"http://rdaregistry.info/Elements/e/P20163", "lexicalAlias":"http://rdaregistry.info/Elements/e/librettoExpression.en", "label":"has libretto expression"},{"@id":"http://rdaregistry.info/Elements/e/P20084", "lexicalAlias":"http://rdaregistry.info/Elements/e/librettoForExpression.en", "label":"is libretto for expression"},{"@id":"http://rdaregistry.info/Elements/e/P20160", "lexicalAlias":"http://rdaregistry.info/Elements/e/radioScriptExpression.en", "label":"has radio script expression"},{"@id":"http://rdaregistry.info/Elements/e/P20243", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicExpression.en", "label":"has music expression"},{"@id":"http://rdaregistry.info/Elements/e/P20244", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicForExpression.en", "label":"is music for expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/complementedByExpression.en", "label":"is complemented by expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/complementedByExpression.en", "label":"is complemented by expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20273","definition":{"ar":["تربط بين تعبيرة وعمل يفحص تعبيرة أو يحكم عليها."],"ca":["Relaciona una expressió amb una obra que és un examen o un judici d’una expressió."],"cs":["Vztahuje vyjádření k dílu, které je přezkoumáváním nebo hodnocením vyjádření."],"da":["Relaterer et udtryk til et værk, som undersøger eller bedømmer et udtryk."],"de":["Setzt eine Expression in Beziehung zu einem Werk, das eine Expression untersucht oder beurteilt.,Setzt eine Expression in Beziehung zu einem Werk, bei dem es sich um eine Reihe von erläuternden oder kritischen Anmerkungen zu einer Expression handelt."],"el":["Συνδέει μια έκφραση με ένα έργο το οποίο εξετάζει ή κρίνει μια περιγραφόμενη έκφραση."],"en":["Relates an expression to a work that is an examination or judgement of an expression."],"es":["Relaciona una expresión con una obra que es un examen o juicio de una expresión."],"et":["Seostab väljenduse teosega, milles kontrollitakse või hinnatakse väljendust."],"fi":["Liittää ekspression teokseen, joka tutkii tai arvioi ekspressiota."],"fr":["Met une expression en relation avec une œuvre qui consiste en un examen ou en un jugement d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy műhöz, amely egy kifejezési formát vizsgál és ítél meg."],"lv":["Sasaista izteiksmi ar darbu, kas analizē vai novērtē konkrēto izteiksmi."],"nl":["Relateert een expressie aan een werk dat een onderzoek of beoordeling is van een expressie."],"no":["Relaterer et uttrykk til et verk som utforsker eller vurderer et uttrykk."],"tr":["Bir anlatımı, bir anlatımı incelenmesi veya yargılanması olan bir eserle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác phẩm kiểm tra hoặc đánh giá biểu hiện được mô tả."],"zh-Hans-CN":["将一种内容表达与作为一种内容表达之检查和评判的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة مقيَّمة في","ca":"expressió avaluada per","cs":"vyjádření hodnocené (čím)","da":"udtryk evalueret i","de":"Expression evaluiert in","de":"Expression evaluiert in","el":"αξιολογείται στην (έκφραση)","en":"expression evaluated by","es":"expresión evaluada por","et":"väljenduse hinnang","fi":"ekspression arviointi","fr":"expression évaluée par","hu":"kifejezési forma értékelve a következőben:","lv":"izteiksmes novērtējums","nl":"expressie beschouwd door","no":"uttrykk evaluert i","tr":"tarafından değerlendirilen anlatım","vi":"được đánh giá trong (biểu hiện)","zh-Hans-CN":"被……评价的内容表达"},"ToolkitDefinition":{"ar":"عمل يفحص تعبيرة أو يحكم عليها.","ca":"Obra que és un examen o un judici d’una expressió.","cs":"Dílo, které je přezkoumáváním nebo hodnocením vyjádření.","da":"Værk, som undersøger eller bedømmer et udtryk.","de":"Ein Werk, das eine Expression untersucht oder beurteilt.","de":"Ein Werk, bei dem es sich um eine Reihe von erläuternden oder kritischen Anmerkungen zu einer Expression handelt.","el":"Ένα έργο το οποίο εξετάζει ή κρίνει μια περιγραφόμενη έκφραση.","en":"A work that is an examination or judgement of an expression.","es":"Una obra que es un examen o juicio de una expresión.","et":"Teos, milles kontrollitakse või hinnatakse väljendust.","fi":"Teos, joka tutkii tai arvioi ekspressiota.","fr":"Œuvre qui consiste en un examen ou en un jugement d’une expression.","hu":"Egy mű, mely egy kifejezési formát vizsgál és ítél meg.","lv":"Darbs, kas analizē vai novērtē konkrēto izteiksmi.","nl":"Een werk dat een onderzoek of beoordeling is van een expressie.","no":"Et verk som utforsker eller vurderer et uttrykk.","tr":"Bir anlatımın incelemesi veya değerlendirmesi olan bir çalışma.","zh-Hans-CN":"作为一种内容表达之检查和评判的一种作品"},"label":{"ar":"هي تعبيرة مقيَّمة في","ca":"és expressió avaluada per","cs":"je vyjádřením hodnoceným (čím)","da":"er udtryk evalueret i","de":"ist Expression evaluiert in","de":"ist Expression evaluiert in","el":"αξιολογείται στην (έκφραση)","en":"is expression evaluated by","es":"es la expresión evaluada por","et":"väljenduse hinnang","fi":"ekspression arviointi","fr":"est une expression évaluée par","hu":"kifejezési forma értékelve a következőben:","lv":"ir izteiksmes novērtējums","nl":"is expressie beschouwd door","no":"er uttrykk evaluert i","tr":"tarafından değerlendirilmiş anlatımdır","vi":"được đánh giá trong (biểu hiện)","zh-Hans-CN":"是被……评价的内容表达"},"altLabel":{"ar":["مقيَّمة في (تعبيرة)"],"ca":["avaluat en (expressió)"],"cs":["hodnoceno v (vyjádření)"],"da":["evalueret i udtryk"],"de":["Evaluierung von (Expression),Evaluierung von (Expression)"],"en":["evaluated in (expression)"],"es":["evaluado en (expresión)"],"fi":["arvioitu teoksessa (ekspressio)"],"fr":["évalué dans (expression),expression évaluée dans"],"hu":["értékelve a következőben (kifejezési forma):"],"nl":["beschouwd in (expressie)"],"no":["evaluert i (uttrykk)"],"tr":["(anlatım) içinde değerlendirilen"],"zh-Hans-CN":["被评价于（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"23.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20268", "lexicalAlias":"http://rdaregistry.info/Elements/e/subjectExpressionOf.en", "label":"is subject expression of"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/expressionEvaluatedBy.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20274", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionReviewedBy.en", "label":"is expression reviewed by"},{"@id":"http://rdaregistry.info/Elements/e/P20272", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionCritiquedBy.en", "label":"is expression critiqued by"},{"@id":"http://rdaregistry.info/Elements/e/object/P20273", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/expressionEvaluatedBy.en", "label":"is expression evaluated by"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20273", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/expressionEvaluatedBy.en", "label":"is expression evaluated by"}]},{"@id":"http://rdaregistry.info/Elements/e/P20152","label":{"ar":"هي تكييف لتعبيرة","ca":"és adaptació d’una expressió","cs":"je adaptací vyjádření","da":"er bearbejdelse af udtryk","de":"ist Bearbeitung von (Expression)","de":"ist Bearbeitung von (Expression)","el":"είναι προσαρμογή της (έκφραση)","en":"is adaptation of expression","es":"es adaptación de expresión","et":"adapteeritud väljendusest","fi":"mukaelma ekspressiosta","fr":"est une adaptation d’une expression","hu":"kifejezési forma feldolgozása:","lv":"ir adaptētā izteiksme","nl":"is bewerking van expressie","no":"er bearbeidelse av uttrykk","tr":"anlatımının uyarlamasıdır","vi":"là phỏng theo của (biểu hiện)","zh-Hans-CN":"是内容表达的改编"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل معدل لغرض، أو استخدام، أو وسيلة أخرى غير ما كان معنيًّا في الأصل."],"ca":["Relaciona una expressió amb una expressió d’una obra que és modificada per un objectiu, un ús o un suport diferent d’aquell per al qual va ser concebuda originalment."],"cs":["Vztahuje vyjádření k vyjádření díla, které je modifikováno pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno."],"da":["Relaterer et udtryk til et udtryk af et værk, som er tilpasset til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür sie ursprünglich konzipiert wurde, bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür sie ursprünglich konzipiert wurde, bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει τροποποιηθεί για έναν σκοπό, μια χρήση ή ένα μέσο άλλο από εκείνο για το οποίο αρχικά προοριζόταν."],"en":["Relates an expression to an expression of a work that is modified for a purpose, use, or medium other than that for which it was originally intended."],"es":["Relaciona una expresión con una expresión de una obra que se modifica para un propósito, uso o medio distinto a aquel para el que fue destinada originalmente."],"et":["Seostab väljenduse teose väljendusega, mida on muudetud algupärasest erineva otstarbe, kasutamise või meediumi jaoks."],"fi":["Liittää ekspression teoksen ekspressioon, jota on muokattu jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est modifiée pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet olyan célra, használatra vagy médiumra módosítottak, amely eltér az eredetileg tervezettől."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kura mainīta citam nolūkam, lietojumam vai medijam."],"nl":["Relateert een expressie aan een expressie van een werk dat is aangepast voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til et annet formål, bruksområde eller medium enn det opprinnelig var ment for."],"tr":["Bir anlatımı, başlangıçta amaçlanandan başka bir amaç, kullanım veya ortam için değiştirilen bir eserin anlatımıyla ilişkilendirilmesi."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được sửa chữa theo mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc."],"zh-Hans-CN":["将一种内容表达与以不同于起初意图的目的、使用或媒介被修改的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تكييف لتعبيرة","ca":"adaptació d’una expressió","cs":"adaptace vyjádření","da":"bearbejdelse af udtryk","de":"Bearbeitung von (Expression)","de":"Bearbeitung von (Expression)","el":"προσαρμογή της (έκφραση)","en":"adaptation of expression","es":"adaptación de la expresión","et":"adapteeritud väljendusest","fi":"mukaelma ekspressiosta","fr":"adaptation d’une expression","hu":"feldolgozása a következő kifejezési formának:","lv":"adaptētā izteiksme","nl":"bewerking van expressie","no":"bearbeidelse av uttrykk","tr":"Anlatımın uyarlaması","vi":"phỏng theo của (biểu hiện)","zh-Hans-CN":"内容表达的改编"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معدل لغرض، أو استخدام، أو وسيلة أخرى غير ما كان معنيًّا في الأصل.","ca":"Expressió d’una obra que és modificada per un objectiu, un ús o un suport diferent d’aquell per al qual va ser concebuda originalment.","cs":"Vyjádření díla, které je modifikováno pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno.","da":"Udtryk af et værk, som er tilpasset til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til.","de":"Eine Expression eines Werks, die für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür sie ursprünglich konzipiert wurde, bearbeitet ist.","de":"Eine Expression eines Werks, die für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür sie ursprünglich konzipiert wurde, bearbeitet ist.","el":"Μια έκφραση ενός έργου το οποίο έχει τροποποιηθεί για έναν σκοπό, μια χρήση ή ένα μέσο άλλο από εκείνο για το οποίο αρχικά προοριζόταν.","en":"An expression of a work that is modified for a purpose, use, or medium other than that for which it was originally intended.","es":"Una expresión de una obra que se modifica para un propósito, uso o medio distinto a aquel para el que fue destinada originalmente.","et":"Teose väljendus, mida on muudetud algupärasest erineva otstarbe, kasutamise või meediumi jaoks.","fi":"Teoksen ekspressio, jota on muokattu jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten.","fr":"Expression d’une œuvre qui est modifiée pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine.","hu":"Egy mű kifejezési formája, amelyet olyan célra, használatra vagy médiumra módosítottak, amely eltér az eredetileg tervezettől.","lv":"Darba izteiksme, kura mainīta citam nolūkam, lietojumam vai medijam.","nl":"Een expressie van een werk dat is aangepast voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was.","no":"Et uttrykk av et verk som er bearbeidet til et annet formål, bruksområde eller medium enn det opprinnelig var ment for.","tr":"Bir eserin orijinal olarak tasarlandığı amaç, kullanım veya ortam dışında bir amaç, kullanım veya ortam için değiştirilmiş bir anlatımı.","vi":"Biểu hiện của tác phẩm được sửa chữa theo mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc.","zh-Hans-CN":"以不同于起初意图的目的、使用或媒介被修改的一种作品的一种内容表达"},"note":{"fi":["Kattaa sekä teoksen muotoon kohdistuvat muutokset että samassa muodossa kokonaan uudelleenmuokatut teokset."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20204", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfSourceWork.en", "label":"has expression of source work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20123", "lexicalAlias":"http://rdaregistry.info/Elements/e/dramatizationOfExpression.en", "label":"is dramatization of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20256", "lexicalAlias":"http://rdaregistry.info/Elements/e/graphicNovelizationOfExpression.en", "label":"is graphic novelization of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20183", "lexicalAlias":"http://rdaregistry.info/Elements/e/choreographicAdaptationOfExpression.en", "label":"is choreographic adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20125", "lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureAdaptationOfExpression.en", "label":"is motion picture adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20129", "lexicalAlias":"http://rdaregistry.info/Elements/e/screenplayBasedOnExpression.en", "label":"is screenplay based on expression"},{"@id":"http://rdaregistry.info/Elements/e/P20190", "lexicalAlias":"http://rdaregistry.info/Elements/e/librettoBasedOnExpression.en", "label":"is libretto based on expression"},{"@id":"http://rdaregistry.info/Elements/e/P20133", "lexicalAlias":"http://rdaregistry.info/Elements/e/radioScriptBasedOnExpression.en", "label":"is radio script based on expression"},{"@id":"http://rdaregistry.info/Elements/e/P20240", "lexicalAlias":"http://rdaregistry.info/Elements/e/operaAdaptationOfExpression.en", "label":"is opera adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20281", "lexicalAlias":"http://rdaregistry.info/Elements/e/oratorioAdaptationOfExpression.en", "label":"is oratorio adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20127", "lexicalAlias":"http://rdaregistry.info/Elements/e/radioAdaptationOfExpression.en", "label":"is radio adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20126", "lexicalAlias":"http://rdaregistry.info/Elements/e/novelizationOfExpression.en", "label":"is novelization of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20128", "lexicalAlias":"http://rdaregistry.info/Elements/e/televisionAdaptationOfExpression.en", "label":"is television adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20124", "lexicalAlias":"http://rdaregistry.info/Elements/e/verseAdaptationOfExpression.en", "label":"is verse adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20134", "lexicalAlias":"http://rdaregistry.info/Elements/e/videoAdaptationOfExpression.en", "label":"is video adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20239", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicalTheatreAdaptationOfExpression.en", "label":"is musical theatre adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptationOfExpression.en", "label":"is adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptationOfExpression.en", "label":"is adaptation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20191","label":{"ar":"هي مستمرة من خلال تعبيرة","ca":"és continuat per una expressió","cs":"je pokračováno vyjádřením","da":"er fortsat af udtryk","de":"ist fortgesetzt von (Expression)","de":"ist fortgesetzt von (Expression)","el":"συνεχίζεται από (έκφραση)","en":"is continued by expression","es":"continúa con la expresión","et":"jätkub väljendusena","fi":"seuraaja (ekspressio)","fr":"est continué par une expression","hu":"folytatása a következő kifejezési formaként:","lv":"ir turpinājumizteiksme","nl":"is voortgezet door expressie","no":"er fortsatt i uttrykk","tr":"anlatım ile devam ettirilmiştir","vi":"được tiếp tục bằng (biểu hiện)","zh-Hans-CN":"被内容表达继承"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل عبارة عن عمل ممتد زمنيًا يُكْمل محتوى عمل آخر ممتد زمنيًا ومستمر."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una obra diacrònica que continua el contingut d’una altra obra diacrònica que és completa."],"cs":["Vztahuje vyjádření k vyjádření díla, které je diachronním dílem, které navazuje na obsah jiného diachronního díla, které bylo ukončeno."],"da":["Relaterer et udtryk til et udtryk af et værk, som er et diakronisk værk, som fortsætter indholdet af et andet diakronisk værk, som er fuldstændigt."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines diachronen Werks, die den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt.,Setzt eine Expression in Beziehung zu einer Expression eines diachronen Werks, die den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου του οποίου το περιεχόμενο συνεχίζει μια έκφραση ενός προηγούμενου έργου."],"en":["Relates an expression to an expression of a work that is a diachronic work that continues the content of another diachronic work that is completed."],"es":["Relaciona una expresión con una expresión de una obra que es una obra diacrónica que continúa el contenido de otra obra diacrónica que está completa."],"et":["Seostab väljenduse väljendusega diakroonilisest teosest, mis jätkab teise, lõpetatud diakroonilise teose sisu."],"fi":["Liittää ekspression sellaisen teoksen ekspressioon, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen sisältöä."],"fr":["Met une expression en relation avec une expression d’une œuvre diachronique qui continue le contenu d’une autre œuvre diachronique qui est terminée."],"hu":["Hozzákapcsol egy kifejezési formát egy diakronikus mű kifejezési formájához, amely egy másik, befejezett diakronikus mű tartalmát folytatja."],"lv":["Sasaista izteiksmi ar diahroniska darba izteiksmi, kas ir diahronisks darbs, kas turpina cita pabeigta diahroniska darba saturu."],"nl":["Relateert een expressie aan een expressie van een werk dat een diachronisch werk is dat de content voortzet van een ander diachronisch werk dat is afgesloten."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er et diakronisk verk som fortsetter innholdet av et annet diakronisk verk som er komplett."],"tr":["Bir anlatımı, tamamlanmış başka bir artzamanlı eserin içeriğini devam ettiren artzamanlı bir eser olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm mà nội dung tiếp tục biểu hiện của tác phẩm trước đó."],"zh-Hans-CN":["将一种内容表达与作为一种历时作品并继承另一种已经完成了的历时作品的内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مستمرة من خلال تعبيرة","ca":"continuat per una expressió","cs":"pokračuje ve vyjádření","da":"fortsat af udtryk","de":"Fortgesetzt von (Expression)","de":"Fortgesetzt von (Expression)","el":"συνεχίζεται από (έκφραση)","en":"continued by expression","es":"continuado por expresión","et":"jätkub väljendusena","fi":"seuraaja (ekspressio)","fr":"continué par une expression","hu":"folytatása kifejezési formaként:","lv":"turpinājumizteiksme","nl":"voortgezet door expressie","no":"fortsettes i uttrykk","tr":"anlatım ile devam edilir","vi":"được tiếp tục bằng (biểu hiện)","zh-Hans-CN":"被内容表达继承"},"ToolkitDefinition":{"ar":"تعبيرة لعمل ممتد زمنيًا يُكْمل المحتوى الجزئي لعمل آخر ممتد زمنيًا ومستمر.","ca":"Expressió d’una obra que és una obra diacrònica que continua el contingut d’una altra obra diacrònica que és completa.","cs":"Vyjádření díla, které je diachronním dílem, které navazuje na obsah jiného diachronního díla, které bylo ukončeno.","da":"Udtryk af et værk, som er et diakronisk værk, som fortsætter indholdet af et andet diakronisk værk, som er fuldstændigt.","de":"Eine Expression eines diachronen Werks, die den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt.","de":"Eine Expression eines diachronen Werks, die den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt.","el":"Μια έκφραση ενός έργου του οποίου το περιεχόμενο συνεχίζει μια έκφραση ενός προηγούμενου έργου.","en":"An expression of a work that is a diachronic work that continues the content of another diachronic work that is completed.","es":"Una expresión de una obra que es una obra diacrónica que continúa el contenido de otra obra diacrónica que está completa.","et":"Väljendus diakroonilisest teosest, mis jätkab teise, lõpetatud diakroonilise teose sisu.","fi":"Sellaisen teoksen ekspressio, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen sisältöä.","fr":"Expression d’une œuvre diachronique qui continue le contenu d’une autre œuvre diachronique qui est terminée.","hu":"Egy diakronikus mű kifejezési formája, amely egy másik, befejezett diakronikus mű tartalmát folytatja.","lv":"Diahroniska darba izteiksme, kas ir diahronisks darbs, kas turpina cita pabeigta diahroniska darba saturu.","nl":"Een expressie van een werk dat een diachronisch werk is dat de content voortzet van een ander diachronisch werk dat is afgesloten.","no":"Et uttrykk av et verk som er et diakronisk verk som fortsetter innholdet av et annet diakronisk verk som er komplett.","tr":"Tamamlanmış başka bir artzamanlı eserin içeriğini devam ettiren artzamanlı bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm mà nội dung tiếp tục biểu hiện của tác phẩm trước đó.","zh-Hans-CN":"作为一种历时作品并继承另一种已经完成了的历时作品的内容的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل متتالٍ."],"ca":["En general, aquest element s’aplica a una expressió d’una obra successiva."],"cs":["Tento prvek se obecně vztahuje na vyjádření postupně vydávaného díla."],"da":["Dette element gælder generelt for et udtryk af et fortløbende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu."],"el":["Αυτή η σχέση βρίσκει γενικά εφαρμογή στα περιοδικά. ."],"en":["This element applies in general to an expression of a successive work."],"es":["Este elemento se aplica en general a una expresión de una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre successive."],"hu":["Ezt az elemet általában egy folyamatos mű kifejezési formájára alkalmazzák."],"lv":["Šis elements parasti attiecas uz secīgā darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een successief werk."],"no":["Dette elementet gjelder som oftest for et uttrykk av et påfølgende verk."],"tr":["Bu öğe, genel olarak ardışık bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho ấn phẩm nhiều kỳ."],"zh-Hans-CN":["该元素一般适用于一种相继作品的一种内容表达。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/continuedByExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20191", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/continuedByExpression.en", "label":"is continued by expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20191", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/continuedByExpression.en", "label":"is continued by expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20076","definition":{"ar":["تربط بين وتعبيرة وتعبيرة لعمل يحل محتواه محل محتوى تعبيرة لعمل آخر، ويجعله متقادما."],"ca":["Relaciona una expressió amb una expressió d’una obra el contingut de la qual substitueix i converteix en obsolet el contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah nahrazuje obsah vyjádření jiného díla a činí ho zastaralým."],"da":["Relaterer et udtryk til et udtryk af et værk, hvis indhold overflødiggør og forælder indholdet af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks ersetzt und überflüssig macht.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks ersetzt und überflüssig macht."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μεταγενέστερου έργου το οποίο χρησιμοποιείται στη θέση μιας προηγούμενης έκφρασης συνήθως λόγω του ότι το μεταγενέστερο έργο περιέχει ενημερωμένη/ανανεωμένη ή νέα πληροφορία, η οποία καθιστά την προηγούμενη έκφραση παρωχημένη."],"en":["Relates an expression to an expression of a work whose content supersedes and renders obsolete the content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido reemplaza y deja obsoleto el contenido de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mille sisu asendab ja tühistab teise teose väljenduse sisu."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisältö korvaa ja tekee vanhentuneeksi toisen teoksen ekspression sisällön."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu remplace et rend périmé le contenu d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek tartalma túlhaladja és elavulttá teszi egy másik mű kifejezési formájának tartalmát."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kuras saturs aizstāj un padara par novecojušu kāda cita darba izteiksmes saturu."],"nl":["Relateert een expressie aan een expressie van een werk waarvan de content overschrijft en achterhaalt de content van een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk hvis innhold erstatter og gjør innholdet i et annet uttrykk av et verk foreldet."],"tr":["Bir anlatımı, içeriği başka bir eserin bir anlatımın içeriğinin değiştiren ve geçersiz kılan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sau này dùng tại vị trí của biểu thị trước đây thường là do tác phẩm sau này có chứa thông tin cập nhật hoặc mới làm cho biểu hiện trước đây bị lỗi thời."],"zh-Hans-CN":["将一种内容表达与其内容替代并废止另一种作品的一种内容表达之内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مستبدلة بتعبيرة","ca":"reemplaçat per una expressió","cs":"nahrazeno vyjádřením","da":"erstattet af udtryk","de":"Ersetzt durch (Expression)","de":"Ersetzt durch (Expression)","el":"αντικαθίσταται από (έκφραση)","en":"replaced by expression","es":"reemplazado por expresión","et":"asendatud väljendusega","fi":"korvaava ekspressio","fr":"remplacé par une expression","hu":"helyettesítő kifejezési forma:","lv":"aizstājošā izteiksme","nl":"vervangen door expressie","no":"erstattet av uttrykk","tr":"anlatım ile değiştirilmiş","vi":"được thay thế bằng (biểu hiện)","zh-Hans-CN":"被内容表达替代"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يحل محتواه محل محتوى تعبيرة لعمل آخر، ويجعله متقادما.","ca":"Expressió d’una obra el contingut de la qual substitueix i converteix en obsolet el contingut d’una expressió d’una altra obra.","cs":"Vyjádření díla, jehož obsah nahrazuje obsah vyjádření jiného díla a činí ho zastaralým.","da":"Udtryk af et værk, hvis indhold overflødiggør og forælder indholdet af et udtryk for et andet værk.","de":"Eine Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks ersetzt und überflüssig macht.","de":"Eine Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks ersetzt und überflüssig macht.","el":"Μια έκφραση ενός μεταγενέστερου έργου το οποίο χρησιμοποιείται στη θέση μιας προηγούμενης έκφρασης συνήθως λόγω του ότι το μεταγενέστερο έργο περιέχει ενημερωμένη/ανανεωμένη ή νέα πληροφορία, η οποία καθιστά την προηγούμενη έκφραση παρωχημένη.","en":"An expression of a work whose content supersedes and renders obsolete the content of an expression of another work.","es":"Una expresión de una obra cuyo contenido reemplaza y vuelve obsoleto el contenido de una expresión de otra obra.","et":"Teose väljendus, mille sisu asendab ja tühistab teise teose väljenduse sisu.","fi":"Teoksen ekspressio, jonka sisältö korvaa ja tekee vanhentuneeksi toisen teoksen ekspression sisällön.","fr":"Expression d’une œuvre dont le contenu remplace et rend périmé le contenu d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amelynek tartalma túlhaladja és elavulttá teszi egy másik mű kifejezési formájának tartalmát.","lv":"Darba izteiksme, kuras saturs aizstāj un padara par novecojušu kāda cita darba izteiksmes saturu.","nl":"Een expressie van een werk waarvan de content overschrijft en achterhaalt de content van een expressie van een ander werk.","no":"Et uttrykk av et verk hvis innhold erstatter og gjør innholdet i et annet uttrykk av et verk foreldet.","tr":"İçeriği başka bir eserin anlatımın içeriğinin yerini alan ve onu geçersiz kılan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sau này dùng tại vị trí của biểu thị trước đây thường là do tác phẩm sau này có chứa thông tin cập nhật hoặc mới làm cho biểu hiện trước đây bị lỗi thời.","zh-Hans-CN":"其内容替代并废止另一种作品的一种内容表达之内容的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل ثابت أو عمل متكامل."],"ca":["En general, aquest element s’aplica a una expressió d’una obra estàtica o d’una obra integrant."],"cs":["Tento termín se obecně vztahuje na vyjádření statického nebo integračního díla."],"da":["Dette element gælder generelt for et udtryk af et statisk værk eller et integrerende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines statischen Werks oder eines integrierenden Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines statischen Werks oder eines integrierenden Werks zu."],"el":["Αυτή η σχέση βρίσκει εφαρμογή γενικά σε μονομερείς μονάδες, πολυμερείς μονογραφίες και ενσωματωμένους πόρους ή πόρους διαρκούς ενημέρωσης/ανανέωσης. ."],"en":["This element applies in general to an expression of a static work or an integrating work."],"es":["Este elemento se aplica en general a una expresión de una obra estática o de una obra integradora."],"et":["Elementi rakendatakse peamiselt staatilise teose või lõimteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä staattisen teoksen tai päivittyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre statique ou d’une œuvre intégratrice."],"hu":["Ezt az elemet általában a statikus, vagy integráló művek kifejezési formáira alkalmazzák."],"lv":["Elements attiecas galvenokārt uz statiska vai integrēta darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een statisch werk of een geïntegreerd werk."],"no":["Dette elementet gjelder som regel for uttrykk av et statisk verk eller uttrykk av et integrerende verk."],"tr":["Bu öğe, genel olarak durağan bir eserin veya bütünleştirici bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho đơn vị một phần, chuyên khảo nhiều phần, và tài nguyên tích hợp."],"zh-Hans-CN":["该元素一般适用于一种静态作品或集成性作品的一种内容表达。"]},"label":{"ar":"هي مستبدلة بتعبيرة","ca":"és reemplaçat per una expressió","cs":"je nahrazeno vyjádřením","da":"er erstattet af udtryk","de":"ist ersetzt durch (Expression)","de":"ist ersetzt durch (Expression)","el":"αντικαθίσταται από (έκφραση)","en":"is replaced by expression","es":"se reemplaza por la expresión","et":"asendatud väljendusega","fi":"korvaava ekspressio","fr":"est remplacé par une expression","hu":"helyettesíti a következő kifejezési forma:","lv":"ir aizstājošā izteiksme","nl":"is vervangen door expressie","no":"er erstattet av uttrykk","tr":"anlatım ile değiştirilmiştir","vi":"được thay thế bằng (biểu hiện)","zh-Hans-CN":"被内容表达替代"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/replacedByExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20076", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/replacedByExpression.en", "label":"is replaced by expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20076", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/replacedByExpression.en", "label":"is replaced by expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20169","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل سابق؛ أي يسبق تعبيرة لاحقة زمنيا أو من حيث السرد، إلخ."],"ca":["Relaciona una expressió amb una expressió d’una obra que segueix una expressió precedent, és a dir, posterior en el temps o en una narració."],"cs":["Vztahuje vyjádření k vyjádření díla, které následuje po předcházejícím vyjádření, tj. je novější nebo popisuje následující děj."],"da":["Relaterer et udtryk til et udtryk af et værk, som følger efter et forudgående udtryk, dvs. på et senere tidspunkt eller efter noget i en fortælling etc."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die einer vorangestellten Expression folgt, zeitlich später oder dem Erzählstrang nachgelagert.,Setzt ein Werk in Beziehung zu einem Werk, dessen zeitliches Geschehen nach dem eines anderen Werks liegt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου που διαδέχεται, δηλαδή ακολουθεί χρονικά σε μια αφήγηση κ.λπ. μια προηγούμενη έκφραση."],"en":["Relates an expression to an expression of a work whose chronological coverage is after that of another expression"],"es":["Relaciona una expresión con una expresión de una obra que sucede, es decir, es posterior en el tiempo o después en una narración, etc., a una expresión precedente."],"et":["Seostab väljenduse teose väljendusega, mis järgneb eelnevale väljendusele, s.t on sellest ajaliselt või narratiivilt hilisem."],"fi":["Liittää ekspression teoksen ekspressioon, jonka kronologinen kattavuus on myöhempi kuin toisella ekspressiolla"],"fr":["Met une expression en relation avec une expression d’une œuvre qui succède à une expression précédente, c’est-à-dire qui lui est ultérieure dans le temps ou dans un récit, etc."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy korábbi kifejezési formát követ, azaz később vagy utána történik a narratívában stb."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas turpina iepriekšējo izteiksmi (piemēram, ir vēlāka laika vai notikumu ziņā)."],"nl":["Relateert een expressie aan een expressie van een werk wiens chronologisch bereik ligt na dat van een andere expressie."],"no":["Relaterer et uttrykk til et uttrykk av et verk som avløser, dvs. kommer senere i tid eller i historien enn, et forutgående uttrykk."],"tr":["Bir anlatımı, önceki bir anlatımdan sonra gelen, yani zamanda daha sonra gelen veya bir anlatımda daha sonra gelen, vb. bir eserin bir anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm tiếp sau, nghĩa là, sau về thời gian hoặc sau về chuyện kể, v.v..., biểu hiện đi trước."],"zh-Hans-CN":["将一种内容表达与先前内容表达之后（即时间较晚或叙述在后）的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"متبوعة بتعبيرة","ca":"seguit d’una expressió","cs":"následováno vyjádřením","da":"efterfulgt af udtryk","de":"Gefolgt von (Expression)","de":"Gefolgt von (Expression)","el":"ακολουθείται από (έκφραση)","en":"succeeded by expression","es":"sucedido por expresión","et":"järgnev väljendus","fi":"myöhempi ekspressio","fr":"suivi d’une expression","hu":"követő kifejezési forma:","lv":"izteiksme: vēlāki notikumi","nl":"gevolgd door expressie","no":"avløst av uttrykk","tr":"anlatım ile başarılı","vi":"được kế tiếp bởi (biểu hiện)","zh-Hans-CN":"被内容表达后继"},"ToolkitDefinition":{"ar":"تعبيرة لعمل سابق؛ أي يسبق تعبيرة لاحقة زمنيا أو من حيث السرد، إلخ.","ca":"Expressió d’una obra que segueix una expressió precedent, és a dir, posterior en el temps o en una narració.","cs":"Vyjádření díla, které následuje po předcházejícím vyjádření, tj. je novější nebo popisuje následující děj.","da":"Udtryk af et værk, som følger efter et forudgående udtryk, dvs. på et senere tidspunkt eller efter noget i en fortælling etc.","de":"Eine Expression eines Werks, die einer vorangestellten Expression folgt, zeitlich später oder dem Erzählstrang nachgelagert.","de":"Ein Werk, dessen zeitliches Geschehen nach dem eines anderen Werks liegt.","el":"Μια έκφραση ενός έργου το οποίο διαδέχεται, δηλαδή ακολουθεί χρονικά σε μια αφήγηση κ.λπ. μια προηγούμενη έκφραση.","en":"An expression of a work whose chronological coverage is after that of another expression","es":"Una expresión de una obra que sucede, es decir, es posterior en el tiempo o después en una narración, etc., a una expresión precedente.","et":"Teose väljendus, mis järgneb eelnevale väljendusele, s.t on sellest ajaliselt või narratiivilt hilisem.","fi":"Teoksen ekspressio, jonka kronologinen kattavuus on myöhempi kuin toisella ekspressiolla","fr":"Expression d’une œuvre qui succède à une expression précédente, c’est-à-dire qui lui est ultérieure dans le temps ou dans un récit, etc.","hu":"Egy mű kifejezési formája, amely egy megelőző kifejezési formát követ, azaz időben későbbi vagy azt követi egy narratívában stb.","lv":"Darba izteiksme, kas turpina iepriekšējo izteiksmi (piemēram, ir vēlāka laika vai notikumu ziņā).","nl":"Een expressie van een werk wiens chronologisch bereik ligt na dat van een andere expressie.","no":"Et uttrykk av et verk som avløser, dvs. kommer senere i tid eller i historien enn, et forutgående uttrykk.","tr":"Önceki bir anlatımın ardından gelen, yani zaman açısından daha sonra ya da anlatıda sonrasında yer alan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm tiếp sau, nghĩa là, sau về thời gian hoặc sau về chuyện kể, v.v..., biểu hiện đi trước.","zh-Hans-CN":"先前内容表达之后（即时间较晚或叙述在后）的一种作品的一种内容表达"},"label":{"ar":"هي متبوعة بتعبيرة","ca":"és seguit d’una expressió","cs":"je následováno vyjádřením","da":"er efterfulgt af udtryk","de":"ist gefolgt von (Expression)","de":"ist gefolgt von (Expression)","el":"ακολουθείται από (έκφραση)","en":"is succeeded by expression","es":"es sucedido por la expresión","et":"järgnev väljendus","fi":"myöhempi ekspressio","fr":"est suivi d’une expression","hu":"a következő kifejezési forma követi:","lv":"izteiksmes vēlāki notikumi","nl":"is gevolgd door expressie","no":"er avløst av uttrykk","tr":"ifadesi tarafından yerine getirilmiştir","vi":"được kế tiếp bởi (biểu hiện)","zh-Hans-CN":"被内容表达后继"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20200", "lexicalAlias":"http://rdaregistry.info/Elements/e/splitIntoExpression.en", "label":"is split into expression"},{"@id":"http://rdaregistry.info/Elements/e/P20191", "lexicalAlias":"http://rdaregistry.info/Elements/e/continuedByExpression.en", "label":"is continued by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20076", "lexicalAlias":"http://rdaregistry.info/Elements/e/replacedByExpression.en", "label":"is replaced by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20075", "lexicalAlias":"http://rdaregistry.info/Elements/e/replacedInPartByExpression.en", "label":"is replaced in part by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20143", "lexicalAlias":"http://rdaregistry.info/Elements/e/absorbedByExpression.en", "label":"is absorbed by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20144", "lexicalAlias":"http://rdaregistry.info/Elements/e/absorbedInPartByExpression.en", "label":"is absorbed in part by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20212", "lexicalAlias":"http://rdaregistry.info/Elements/e/mergedToFormExpression.en", "label":"is merged to form expression"},{"@id":"http://rdaregistry.info/Elements/e/P20101", "lexicalAlias":"http://rdaregistry.info/Elements/e/separatedIntoExpression.en", "label":"is separated into expression"},{"@id":"http://rdaregistry.info/Elements/e/P20335", "lexicalAlias":"http://rdaregistry.info/Elements/e/sequelExpression.en", "label":"has sequel expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/succeededByExpression.en", "label":"is succeeded by expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/succeededByExpression.en", "label":"is succeeded by expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20154","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل سابق؛ أي يسبق تعبيرة لاحقة زمنيا أو من حيث السرد، إلخ."],"ca":["Relaciona una expressió amb una expressió d’una obra que precedeix una expressió que va a continuació, és a dir, és anterior en el temps o en una narració, etc."],"cs":["Vztahuje vyjádření k vyjádření díla, které předchází následujícímu vyjádření, tj. je starší nebo popisuje předcházející děj."],"da":["Relaterer et udtryk til et udtryk af et værk, som går forud for det efterfølgende udtryk på et tidligere tidspunkt eller før noget i en fortælling etc."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die einer nachfolgenden Expression zeitlich oder erzählerisch vorausgeht.,Setzt ein Werk in Beziehung zu einem Werk, dessen zeitliches Geschehen vor dem eines anderen Werks liegt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο προηγείται, δηλαδή είναι προγενέστερο χρονικά ή αφηγηματικά κ.λπ. μιας διάδοχης έκφρασης."],"en":["Relates an expression to an expression of a work whose chronological coverage is before that of another expression"],"es":["Relaciona una expresión con una expresión de una obra que precede, es decir, es anterior en el tiempo o anterior en la narrativa, etc., a una expresión sucesora."],"et":["Seostab väljenduse teose väljendusega, mis eelneb järgnevale väljendusele, s.t on sellest ajaliselt või narratiivilt varasem."],"fi":["Liittää ekspression teoksen ekspressioon, jonka kronologinen kattavuus on varhaisempi kuin toisella ekspressiolla"],"fr":["Met une expression en relation avec une expression d’une œuvre qui précède une expression suivante, c’est-à-dire qui lui est antérieure dans le temps ou dans un récit, etc."],"hu":["Egy mű kifejezési formája, amely egy másik mű kifejezési formáját olyan célra, használatra vagy médiumra módosítja, amely eltér az eredetileg tervezettől."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kura ievada tālāk sekojošo izteiksmi, piemēram, ir agrāka laika vai notikumu ziņā."],"nl":["Relateert een expressie aan een expressie van een werk wiens chronologisch bereik ligt voor dat van een andere expressie."],"no":["Relaterer et uttrykk til et uttrykk av et verk som kommer før, enten i tid eller i historien, et påfølgende uttrykk."],"tr":["Bir anlatımı, kendinden önce gelen, yani zamanda daha önce olan veya anlatımda daha önce olan, vb. bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm đi trước, nghĩa là, trước đây theo thời gian hoặc trước trong chuyện kể, v.v..., biểu đi sau."],"zh-Hans-CN":["将一种内容表达与后继内容表达之前（即时间较早或叙述在前）的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مسبوقة بتعبيرة","ca":"precedit d’una expressió","cs":"předcházeno vyjádřením","da":"forudgået af udtryk","de":"Vorangegangen ist (Expression)","de":"Vorangegangen ist (Expression)","el":"προηγείται από (έκφραση)","en":"preceded by expression","es":"precedido de expresion","et":"eelnev väljendus","fi":"edeltävä ekspressio","fr":"précédé d’une expression","hu":"megelőzi a következő kifejezési forma:","lv":"izteiksme: agrāki notikumi","nl":"voorafgegaan door expressie","no":"etterfulgt av uttrykk","tr":"anlatımında önce","vi":"được đi trước bởi (biểu hiện)","zh-Hans-CN":"被内容表达作为先前"},"ToolkitDefinition":{"ar":"تعبيرة لعمل سابق؛ أي يسبق تعبيرة لاحقة زمنيا أو من حيث السرد، إلخ.","ca":"Expressió d’una obra que precedeix una expressió que va a continuació, és a dir, és anterior en el temps o en una narració, etc.","cs":"Vyjádření díla, které předchází následujícímu vyjádření, tj. je starší nebo popisuje předcházející děj.","da":"Udtryk af et værk, som går forud for det efterfølgende udtryk dvs. på et tidligere tidspunkt eller før noget i en fortælling etc.","de":"Eine Expression eines Werks, die einer nachfolgenden Expression zeitlich oder erzählerisch vorausgeht.","de":"Ein Werk, dessen zeitliches Geschehen vor dem eines anderen Werks liegt.","el":"Μια έκφραση ενός έργου το οποίο προηγείται, δηλαδή είναι προγενέστερο χρονικά ή αφηγηματικά κ.λπ. μιας διάδοχης έκφρασης.","en":"An expression of a work whose chronological coverage is before that of another expression","es":"Una expresión de una obra que precede, es decir, es anterior en el tiempo o anterior en la narrativa, etc., a una expresión sucesora.","et":"Teose väljendus, mis eelneb järgnevale väljendusele, s.t on sellest ajaliselt või narratiivilt varasem.","fi":"Teoksen ekspressio, jonka kronologinen kattavuus on varhaisempi kuin toisella ekspressiolla","fr":"Expression d’une œuvre qui précède une expression suivante, c’est-à-dire qui lui est antérieure dans le temps ou dans un récit, etc.","hu":"Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely megelőz egy azt követő kifejezési formát, azaz időben korábban vagy narratívában stb. előtte áll.","lv":"Darba izteiksme, kura ievada tālāk sekojošo izteiksmi, piemēram, ir agrāka laika vai notikumu ziņā.","nl":"Een expressie van een werk wiens chronologisch bereik ligt voor dat van een andere expressie.","no":"Et uttrykk av et verk som kommer før, enten i tid eller i historien, et påfølgende uttrykk.","tr":"Sonraki bir anlatımın öncesinde gelen, yani zaman açısından daha önce ya da anlatıda öncesinde yer alan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm đi trước, nghĩa là, trước đây theo thời gian hoặc trước trong chuyện kể, v.v..., biểu đi sau.","zh-Hans-CN":"后继内容表达之前（即时间较早或叙述在前）的一种作品的一种内容表达"},"label":{"ar":"هي مسبوقة بتعبيرة","ca":"és precedit d’una expressió","cs":"je předcházeno vyjádřením","da":"er forudgået af udtryk","de":"ist vorangegangen ist (Expression)","de":"ist vorangegangen ist (Expression)","el":"προηγείται από (έκφραση)","en":"is preceded by expression","es":"es precedido por la expresión","et":"eelnev väljendus","fi":"edeltävä ekspressio","fr":"est précédé d’une expression","hu":"megelőzi a következő kifejezési forma:","lv":"izteiksmes agrāki notikumi","nl":"is voorafgegaan door expressie","no":"er etterfulgt av uttrykk","tr":"anlatımı takip eder","vi":"được đi trước bởi (biểu hiện)","zh-Hans-CN":"被内容表达作为先前"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/precededByExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20137", "lexicalAlias":"http://rdaregistry.info/Elements/e/absorptionOfExpression.en", "label":"is absorption of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20199", "lexicalAlias":"http://rdaregistry.info/Elements/e/replacementOfExpression.en", "label":"is replacement of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20149", "lexicalAlias":"http://rdaregistry.info/Elements/e/continuationOfExpression.en", "label":"is continuation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20201", "lexicalAlias":"http://rdaregistry.info/Elements/e/mergerOfExpression.en", "label":"is merger of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20138", "lexicalAlias":"http://rdaregistry.info/Elements/e/absorptionInPartOfExpression.en", "label":"is absorption in part of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20198", "lexicalAlias":"http://rdaregistry.info/Elements/e/replacementInPartOfExpression.en", "label":"is replacement in part of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20168", "lexicalAlias":"http://rdaregistry.info/Elements/e/separatedFromExpression.en", "label":"is separated from expression"},{"@id":"http://rdaregistry.info/Elements/e/P20334", "lexicalAlias":"http://rdaregistry.info/Elements/e/prequelExpression.en", "label":"has prequel expression"},{"@id":"http://rdaregistry.info/Elements/e/P20167", "lexicalAlias":"http://rdaregistry.info/Elements/e/splitFromExpression.en", "label":"is split from expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20154", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/precededByExpression.en", "label":"is preceded by expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20154", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/precededByExpression.en", "label":"is preceded by expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20075","definition":{"ar":["تربط بين وتعبيرة وتعبيرة لعمل يحل محتواه محل محتوى تعبيرة لعمل آخر جزئيا، ويجعله متقادما."],"ca":["Relaciona una expressió amb una expressió d’una obra el contingut de la qual substitueix parcialment i converteix en obsolet el contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah částečně nahrazuje obsah vyjádření jiného díla a činí ho zastaralým."],"da":["Relaterer et udtryk til et udtryk af et værk, hvis indhold delvis overflødiggør og forælder indholdet af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks teilweise ersetzt und überflüssig macht.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks teilweise ersetzt und überflüssig macht."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μεταγενέστερου έργου το οποίο χρησιμοποιείται μερικώς στη θέση μιας προηγούμενης έκφρασης συνήθως λόγω του ότι το μεταγενέστερο έργο περιέχει ενημερωμένη/ανανεωμένη ή νέα πληροφορία, η οποία καθιστά μέρος της προηγούμενης έκφρασης παρωχημένο."],"en":["Relates an expression to an expression of a work whose content partially supersedes and renders obsolete the content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido reemplaza parcialmente y deja obsoleto el contenido de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mille sisu osaliselt asendab ja tühistab teise teose väljenduse sisu."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisältö osittain korvaa ja tekee vanhentuneeksi toisen teoksen ekspression sisällön."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu remplace partiellement et rend périmé le contenu d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek tartalma részben túlhaladja és elavulttá teszi egy másik mű kifejezési formájának tartalmát."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kuras saturs daļēji aizstāj un padara par novecojušu kāda cita darba izteiksmes saturu. Elements attiecas galvenokārt uz statiska vai integrēta darba izteiksmi."],"nl":["Relateert een expressie aan een expressie van een werk waarvan de content gedeeltelijk overschrijft en achterhaald maakt de content van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk hvis innhold delvis erstatter og gjør innholdet i et annet verk foreldet."],"tr":["Bir anlatımı, içeriği başka bir eserin bir anlatımın içeriğinin kısmen değiştiren ve geçersiz kılan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sau này dùng một phần tại vị trí của biểu thị trước đây thường là do tác phẩm sau này có chứa thông tin cập nhật hoặc mới làm cho phần của biểu hiện trước đây bị lỗi thời."],"zh-Hans-CN":["将一种内容表达与其内容部分地替代并废止另一种作品的一种内容表达之内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مستبدَلة جزئيًا بتعبيرة","ca":"reemplaçat en part per una expressió","cs":"částečně nahrazeno vyjádřením","da":"delvis erstattet af udtryk","de":"Teilweise ersetzt durch (Expression)","de":"Teilweise ersetzt durch (Expression)","el":"αντικαθίσταται μερικώς από (έκφραση)","en":"replaced in part by expression","es":"reemplazado en parte por la expresión","et":"asendatud osaliselt väljendusega","fi":"osittain korvattu ekspressiolla","fr":"remplacé en partie par une expression","hu":"részben helyettesíti a következő kifejezési forma:","lv":"daļēji aizstājošā izteiksme","nl":"gedeeltelijk vervangen door expressie","no":"delvis erstattet av uttrykk","tr":"anlatım ile kısmen değiştirilmiş","vi":"được thay thế một phần bằng (biểu hiện)","zh-Hans-CN":"被内容表达部分地替代"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يحل محتواه محل محتوى تعبيرة لعمل آخر جزئيا، ويجعله متقادما.","ca":"Expressió d’una obra el contingut de la qual substitueix parcialment i converteix en obsolet el contingut d’una expressió d’una altra obra.","cs":"Vyjádření díla, jehož obsah částečně nahrazuje obsah vyjádření jiného díla a činí ho zastaralým.","da":"Udtryk af et værk, hvis indhold delvis overflødiggør og forælder indholdet af et udtryk for et andet værk.","de":"Eine Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks teilweise ersetzt und überflüssig macht.","de":"Eine Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks teilweise ersetzt und überflüssig macht.","el":"Μια έκφραση ενός μεταγενέστερου έργου το οποίο χρησιμοποιείται μερικώς στη θέση μιας προηγούμενης έκφρασης συνήθως λόγω του ότι το μεταγενέστερο έργο περιέχει ενημερωμένη/ανανεωμένη ή νέα πληροφορία, η οποία καθιστά μέρος της προηγούμενης έκφρασης παρωχημένο.","en":"An expression of a work whose content partially supersedes and renders obsolete the content of an expression of another work.","es":"Una expresión de una obra cuyo contenido reemplaza parcialmente y deja obsoleto el contenido de una expresión de otra obra.","et":"Teose väljendus, mille sisu osaliselt asendab ja tühistab teise teose väljenduse sisu.","fi":"Teoksen ekspressio, jonka sisältö osittain korvaa ja tekee vanhentuneeksi toisen teoksen ekspression sisällön.","fr":"Expression d’une œuvre dont le contenu remplace partiellement et rend périmé le contenu d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amelynek tartalma részben túlhaladja és elavulttá teszi egy másik mű kifejezési formájának tartalmát.","lv":"Darba izteiksme, kuras saturs daļēji aizstāj un padara par novecojušu kāda cita darba izteiksmes saturu. Elements attiecas galvenokārt uz statiska vai integrēta darba izteiksmi.","nl":"Een expressie van een werk waarvan de content gedeeltelijk overschrijft en achterhaald maakt de content van een ander werk.","no":"Et uttrykk av et verk hvis innhold delvis erstatter og gjør innholdet i et annet verk foreldet.","tr":"İçeriği, başka bir eserin anlatım içeriğinin kısmen yerini alan ve onu geçersiz kılan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sau này dùng một phần tại vị trí của biểu thị trước đây thường là do tác phẩm sau này có chứa thông tin cập nhật hoặc mới làm cho phần của biểu hiện trước đây bị lỗi thời.","zh-Hans-CN":"其内容部分地替代并废止另一种作品的一种内容表达之内容的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على عمل ثابت."],"ca":["En general, aquest element s’aplica a una expressió d’una obra estàtica."],"cs":["Tento termín se obecně vztahuje na vyjádření statického díla."],"da":["Dette element gælder generelt for et udtryk af et statisk værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines statischen Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines statischen Werks zu."],"el":["Αυτή η σχέση βρίσκει εφαρμογή γενικά σε μονομερείς μονάδες, πολυμερείς μονογραφίες και ενσωματωμένους πόρους ή πόρους διαρκούς ενημέρωσης/ανανέωσης."],"en":["This element applies in general to an expression of a static work."],"es":["Este elemento se aplica en general a una expresión de una obra estática."],"et":["Elementi rakendatakse peamiselt staatilise teose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä staattisen teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre statique."],"hu":["Ezt az elemet általában egy statikus mű kifejezési formájára alkalmazzák."],"lv":["Elements attiecas galvenokārt uz statiska darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een statisch werk."],"no":["Dette elementet gjelder som regel for uttrykk av et statisk verk."],"tr":["Bu öğe, genel olarak durağan bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho đơn vị một phần, chuyên khảo nhiều phần, và tài nguyên tích hợp."],"zh-Hans-CN":["该元素一般适用于一种静态作品的一种内容表达"]},"label":{"ar":"مستبدلة جزئيًا بتعبيرة","ca":"és reemplaçat en part per una expressió","cs":"je částečně nahrazeno vyjádřením","da":"er delvis erstattet af udtryk","de":"ist teilweise ersetzt durch (Expression)","de":"ist teilweise ersetzt durch (Expression)","el":"αντικαθίσταται μερικώς από (έκφραση)","en":"is replaced in part by expression","es":"es reemplazado en parte por la expresión","et":"asendatud osaliselt väljendusega","fi":"osittain korvattu ekspressiolla","fr":"est remplacé en partie par une expression","hu":"részben helyettesíti a következő kifejezési forma:","lv":"ir daļēji aizstājošā izteiksme","nl":"is gedeeltelijk vervangen door expressie","no":"er delvis erstattet av uttrykk","tr":"anlatım ile kısmen değiştirilmiştir","vi":"được thay thế một phần bằng (biểu hiện)","zh-Hans-CN":"被内容表达部分地替代"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
