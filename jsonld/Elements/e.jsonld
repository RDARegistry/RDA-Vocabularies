                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/narratorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20437", "lexicalAlias":"http://rdaregistry.info/Elements/e/narratorCollectiveAgent.en", "label":"has narrator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20555", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/narratorFamily.en", "label":"has narrator family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20555", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/narratorFamily.en", "label":"has narrator family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20378","label":{"ar":"لها شخص راوي","ca":"té com a persona narradora","cs":"má vypravěče-komentátora (osobu)","da":"har person, som er fortæller/indlæser","de":"hat Erzählerin/Erzähler (Person)","de":"hat Erzählerin/Erzähler (Person)","en":"has narrator person","es":"tiene persona narradora","et":"jutustaja (isik)","fi":"kertoja (henkilö)","fr":"a pour personne narratrice","hu":"narrátor személye a következő:","lv":"teicējs (persona)","nl":"heeft verteller-persoon","no":"har forteller (person)","tr":"anlatıcı kişisi ile ilişkilidir","zh-Hans-CN":"有旁白者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مؤديًا يساهم في تعبيرة من خلال القراءة بصوت مرتفع، أو سرد فصل من مسرحية، أو واقعة، أو حدث آخر."],"ca":["Relaciona una expressió amb una persona que és un intèrpret que contribueix a una expressió llegint en veu alta o explicant una acció, una situació o qualsevol altre esdeveniment."],"cs":["Vztahuje vyjádření k osobě, která je účinkujícím, který přispívá k vyjádření tím, že nahlas předčítá nebo slovně popisuje činnost, děj nebo jinou událost."],"da":["Relaterer et udtryk til en person, som er en udøver, som bidrager til et udtryk ved at læse højt eller berette om en handling, en hændelse, et begivenhedsforløb etc."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert."],"en":["Relates an expression to a person who is a performer who contributes to an expression by reading aloud or giving an account of an act, occurrence, or other event."],"es":["Relaciona una expresión con una persona que es un intérprete que contribuye a una expresión al leer en voz alta o dar cuenta de un acto, suceso u otro evento."],"et":["Seostab väljenduse isikuga, kes esitajana annab panuse väljendusse, valjusti lugedes või jutustades mingist tegevusest, juhtumist, sündmuste käigust vms."],"fi":["Liittää ekspression henkilöön, joka on esittäjä, joka osallistuu ekspression tekemiseen lukemalla ääneen tai kertomalla toiminnasta, tapauksesta tai muusta tapahtumasta."],"fr":["Met une expression en relation avec une personne interprète qui contribue à une expression en lisant à voix haute ou en rendant compte d’une action, d’une situation ou d’un autre événement."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó személyhez, aki hozzájárul egy kifejezési formához egy cselekményről, történésről vagy más eseményről szóló beszámoló hangos felolvasásával."],"lv":["Sasaista izteiksmi ar personu, kura ir izpildītājs, kura sniegusi ieguldījumu izteiksmē, skaļi nolasot tekstu vai informējot par darbību, notikumu, notikumu gaitu u.tml."],"nl":["Relateert een expressie aan een persoon die een uitvoerder is die bijdraagt aan een expressie door het hardop lezen of verslag geven van een daad, voorval, of andere gebeurtenis."],"no":["Relaterer et uttrykk til en person som er en utøver som bidrar til et uttrykk ved å lese høyt eller fortelle om en handling, hendelse, historie etc."],"tr":["Bir anlatımı, bir eylemi, oluşumu veya başka bir olayı anlatarak veya yüksek sesle okuyarak anlatıma katkıda bulunan bir sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过朗读或描述行为、事情或其他事件而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص راوي","ca":"persona narradora","cs":"vypravěč-komentátor (osoba)","da":"person, som er fortæller/indlæser","de":"Erzählerin/Erzähler (Person)","de":"Erzählerin/Erzähler (Person)","en":"narrator person","es":"persona narradora","et":"jutustaja (isik)","fi":"kertoja (henkilö)","fr":"personne narratrice","hu":"narrátor személy:","lv":"teicējs (persona)","nl":"verteller-persoon","no":"forteller (person)","tr":"anlatıcı","zh-Hans-CN":"旁白者个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤديًا يساهم في تعبيرة من خلال القراءة بصوت مرتفع، أو سرد فصل من مسرحية، أو واقعة، أو حدث آخر.","ca":"Persona que és un intèrpret que contribueix a una expressió llegint en veu alta o explicant una acció, una situació o qualsevol altre esdeveniment.","cs":"Osoba, která je účinkujícím, který přispívá k vyjádření tím, že nahlas předčítá nebo slovně popisuje činnost, děj nebo jinou událost.","da":"Person, som er en udøver, som bidrager til et udtryk ved at læse højt eller berette om en handling, en hændelse, et begivenhedsforløb etc.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er eine Handlung, ein Geschehnis oder ein anderes Ereignis laut vorliest oder schildert.","en":"A person who is a performer who contributes to an expression by reading aloud or giving an account of an act, occurrence, or other event.","es":"Una persona que un intérprete que contribuye a una expresión al leer en voz alta o dar cuenta de un acto, suceso u otro evento.","et":"Isik, kes esitajana annab panuse väljendusse, valjusti lugedes või jutustades mingist tegevusest, juhtumist, sündmuste käigust vms.","fi":"Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen lukemalla ääneen tai kertomalla toiminnasta, tapauksesta tai muusta tapahtumasta.","fr":"Personne interprète qui contribue à une expression en lisant à voix haute ou en rendant compte d’une action, d’une situation ou d’un autre événement.","hu":"Egy előadó személy, aki hozzájárul egy kifejezési formához egy cselekményről, történésről vagy más eseményről szóló beszámoló hangos felolvasásával.","lv":"Persona - izpildītājs, kura sniegusi ieguldījumu izteiksmē, skaļi nolasot tekstu vai informējot par darbību, notikumu, notikumu gaitu u.tml.","nl":"Een persoon die een uitvoerder is die bijdraagt aan een expressie door het hardop lezen of verslag geven van een daad, voorval, of andere gebeurtenis.","no":"En person som er en utøver som bidrar til et uttrykk ved å lese høyt eller fortelle om en handling, hendelse, historie etc.","tr":"Bir eylemi, olayı veya başka bir durumu anlatarak ya da yüksek sesle okuyarak bir anlatıma katkıda bulunan sanatçı olan kişi.","zh-Hans-CN":"作为一个表演者通过朗读或描述行为、事情或其他事件而对一种内容表达有贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
