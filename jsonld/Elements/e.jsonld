                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/augmentationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20089", "lexicalAlias":"http://rdaregistry.info/Elements/e/appendixToExpression.en", "label":"is appendix to expression"},{"@id":"http://rdaregistry.info/Elements/e/P20146", "lexicalAlias":"http://rdaregistry.info/Elements/e/errataToExpression.en", "label":"is errata to expression"},{"@id":"http://rdaregistry.info/Elements/e/P20148", "lexicalAlias":"http://rdaregistry.info/Elements/e/illustrationsForExpression.en", "label":"is illustrations for expression"},{"@id":"http://rdaregistry.info/Elements/e/P20188", "lexicalAlias":"http://rdaregistry.info/Elements/e/indexToExpression.en", "label":"is index to expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20083", "lexicalAlias":"http://rdaregistry.info/Elements/e/cadenzaComposedForExpression.en", "label":"is cadenza composed for expression"},{"@id":"http://rdaregistry.info/Elements/e/P20197", "lexicalAlias":"http://rdaregistry.info/Elements/e/findingAidForExpression.en", "label":"is finding aid for expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20180", "lexicalAlias":"http://rdaregistry.info/Elements/e/catalogueOfExpression.en", "label":"is catalogue of expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20151", "lexicalAlias":"http://rdaregistry.info/Elements/e/supplementToExpression.en", "label":"is supplement to expression"},{"@id":"http://rdaregistry.info/Elements/e/P20177", "lexicalAlias":"http://rdaregistry.info/Elements/e/addendaToExpression.en", "label":"is addenda to expression"},{"@id":"http://rdaregistry.info/Elements/e/P20147", "lexicalAlias":"http://rdaregistry.info/Elements/e/guideToExpression.en", "label":"is guide to expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/augmentationOfExpression.en", "label":"is augmentation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/augmentationOfExpression.en", "label":"is augmentation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20184","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم كأساس لعمل مشتق يتوسع في محتوى تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra que s’usa com a base d’una obra derivada que amplia el contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které je použito jako základ pro odvozené dílo, které je zvětšeným obsahem vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvendes som grundlag for et afledt værk, som uddyber indholdet i et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Grundlage für ein abgeleitetes Werk verwendet wird, welche den Inhalt einer Expression eines anderen Werks näher erläutert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Grundlage für ein abgeleitetes Werk verwendet wird, welche den Inhalt einer Expression eines anderen Werks näher erläutert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου που χρησιμοποιείται ως η βάση για ένα παράγωγο έργο το οποίο αυξάνει την έκταση του περιεχομένου ενός έργου-πηγής."],"en":["Relates an expression to an expression of a work that is used as the basis for a derivative work that enlarges upon the content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que se utiliza como base para una obra derivada que amplía el contenido de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mis on aluseks tuletatud teosele, milles on avardatud allikteose sisu."],"fi":["Liittää ekspression teoksen ekspressioon, jota on käytetty toisen teoksen ekspression sisältöä laajentavan johdannaisteoksen perustana."],"fr":["Met une expression en relation avec une expression d’une œuvre qui sert de base à une œuvre dérivée qui accroît le contenu d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet olyan származékos mű alapjaként használtak, amely egy másik mű kifejezési formájának tartalmát megnöveli."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas izmantota par pamatu atvasinātam darbam, kas ir saturisks paplašinājums pamatdarbam."],"nl":["Relateert een expressie aan een expressie van een werk dat is gebruikt als de basis voor een afgeleid werk dat de content van een expressie van een ander werk uitbreidt."],"no":["Relaterer et uttrykk til et uttrykk av et verk brukt som utgangspunkt for et avledet verk som utvider innholdet fra et kildeverk."],"tr":["Bir anlatımı, başka bir eserin anlatımının içeriğini genişleten türev bir eser için temel olarak kullanılan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được sử dụng như là cơ sở cho tác phẩm dẫn xuất mở rộng nội dung của tác phẩm nguồn."],"zh-Hans-CN":["将一种内容表达与被用作在另一种作品的一种内容表达之内容基础上扩充的一种衍生作品的基础的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"إصدارة موسعة لتعبيرة","ca":"versió ampliada d’una expressió","cs":"rozšířená verze vyjádření","da":"udvidet version af udtryk","de":"Erweiterte Ausgabe von (Expression)","de":"Erweiterte Ausgabe von (Expression)","el":"εκτεταμένη εκδοχή της (έκφραση)","en":"expanded version of expression","es":"versión ampliada de expresión","et":"laiendatud versioon väljendusest","fi":"laajennettu versio ekspressiosta","fr":"version augmentée d’une expression","hu":"kifejezési forma bővített változata:","lv":"paplašinājums izteiksmei","nl":"uitgebreide versie van expressie","no":"utvidet versjon av uttrykk","tr":"anlatımın genişletilmiş hali","vi":"phiên bản mở rộng của (biểu hiện)","zh-Hans-CN":"内容表达的扩充版"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم كأساس لعمل مشتق يتوسع في محتوى تعبيرة لعمل آخر.","ca":"Expressió d’una obra que s’usa com a base d’una obra derivada que amplia el contingut d’una expressió d’una altra obra.","cs":"Vyjádření díla, které je použito jako základ pro odvozené dílo, které je zvětšeným obsahem vyjádření jiného díla.","da":"Udtryk af et værk, som anvendes som grundlag for et afledt værk, som uddyber indholdet i et udtryk af et andet værk.","de":"Eine Expression eines Werks, die als Grundlage für ein abgeleitetes Werk verwendet wird, welche den Inhalt einer Expression eines anderen Werks näher erläutert.","de":"Eine Expression eines Werks, die als Grundlage für ein abgeleitetes Werk verwendet wird, welche den Inhalt einer Expression eines anderen Werks näher erläutert.","el":"Μια έκφραση ενός έργου που χρησιμοποιείται ως η βάση για ένα παράγωγο έργο το οποίο αυξάνει την έκταση του περιεχομένου ενός έργου-πηγής.","en":"An expression of a work that is used as the basis for a derivative work that enlarges upon the content of an expression of another work.","es":"Una expresión de una obra que se utiliza como base para una obra derivada que amplía el contenido de una expresión de otra obra.","et":"Teose väljendus, mis on aluseks tuletatud teosele, milles on avardatud allikteose sisu.","fi":"Teoksen ekspressio, jota on käytetty toisen teoksen ekspression sisältöä laajentavan johdannaisteoksen perustana.","fr":"Expression d’une œuvre qui sert de base à une œuvre dérivée qui accroît le contenu d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amelyet olyan származékos mű alapjaként használtak, amely egy másik mű kifejezési formájának tartalmát megnöveli.","lv":"Darba izteiksme, kas izmantota par pamatu atvasinātam darbam, kas ir saturisks paplašinājums pamatdarbam.","nl":"Een expressie van een werk dat is gebruikt als de basis voor een afgeleid werk dat de content van een expressie van een ander werk uitbreidt.","no":"Et uttrykk av et verk brukt som utgangspunkt for et avledet verk som utvider innholdet fra et kildeverk.","tr":"Başka bir eserin ifadesinin içeriğini genişleten bir türetilmiş eser için temel olarak kullanılan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được sử dụng như là cơ sở cho tác phẩm dẫn xuất mở rộng nội dung của tác phẩm nguồn.","zh-Hans-CN":"被用作在另一种作品的一种内容表达之内容基础上扩充的一种衍生作品的基础的一种作品的一种内容表达"},"label":{"ar":"هي إصدارة موسعة لتعبيرة","ca":"és versió ampliada d’una expressió","cs":"je rozšířenou verzí vyjádření","da":"er udvidet version af udtryk","de":"ist erweiterte Ausgabe von (Expression)","de":"ist erweiterte Ausgabe von (Expression)","el":"είναι εκτεταμένη εκδοχή της (έκφραση)","en":"is expanded version of expression","es":"es la versión ampliada de la expresión","et":"laiendatud versioon väljendusest","fi":"laajennettu versio ekspressiosta","fr":"est une version augmentée d’une expression","hu":"bővített változata a következő kifejezési formának:","lv":"ir paplašinājums izteiksmei","nl":"is uitgebreide versie van expressie","no":"er utvidet versjon av uttrykk","tr":"anlatımın genişletilmiş sürümüdür","vi":"là phiên bản mở rộng của (biểu hiện)","zh-Hans-CN":"是内容表达的扩充版"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20204", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfSourceWork.en", "label":"has expression of source work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/expandedVersionOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20184", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/expandedVersionOfExpression.en", "label":"is expanded version of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20184", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/expandedVersionOfExpression.en", "label":"is expanded version of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20199","label":{"ar":"هي مستبدلة بتعبيرة","ca":"és reemplaçament d’una expressió","cs":"je náhradou vyjádření","da":"er erstatning af udtryk","de":"ist Ersatz von (Expression)","de":"ist Bezeichnung für eine Expression von","el":"είναι αντικατάσταση της (έκφραση)","en":"is replacement of expression","es":"es reemplazo de expresión","et":"asendab väljenduse","fi":"korvaa ekspression","fr":"est un remplacement d’une expression","hu":"cseréje a következő kifejezési formának:","lv":"ir aizstātā izteiksme","nl":"is vervanging van expressie","no":"er erstatning av uttrykk","tr":"anlatımın değiştirilmesidir","vi":"là thay thế của (biểu hiện)","zh-Hans-CN":"是内容表达的替代"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يُستبدَل محتواه ويصبح متقادمًا في وجود محتوى تعبيرة عمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra el contingut de la qual és substituït i convertit en obsolet pel contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah je nahrazen obsahem vyjádření jiného díla a stává se zastaralým."],"da":["Relaterer et udtryk til et udtryk af værk, hvis indhold er overflødiggjort og forældet af indholdet af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt durch Inhalt einer Expression eines anderen Werks ersetzt und überflüssig wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks ersetzt und überflüssig macht."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός προηγούμενου έργου του οποίου το περιεχόμενο έχει αντικατασταθεί από μια μεταγενέστερη έκφραση, συνήθως γιατί το μεταγενέστερο έργο περιέχει ενημερωμένη ή νέα πληροφόρηση η οποία καθιστά την προηγούμενη έκφραση παρωχημένη."],"en":["Relates an expression to an expression of a work whose content is superseded and rendered obsolete by the content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido es reemplazado y vuelto obsoleto por el contenido de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mille sisu on asendatud ja tühistatud teise teose väljenduse sisuga."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisällön toisen teoksen ekspression sisältö korvaa ja tekee vanhentuneeksi."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu est remplacé et rendu périmé par le contenu d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek tartalmát túlhaladja és elavulttá teszi egy másik mű kifejezési formájának tartalma."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kuras saturu aizstāj un padara par novecojušu kāda cita darba izteiksmes saturs."],"nl":["Relateert een expressie aan een expressie van een werk waarvan de content is overschreven en achterhaald door de content van een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk med innhold som er erstattet og foreldet av innholdet i et uttrykk av et annet verk."],"tr":["Bir anlatımı, içeriği başka bir eserin anlatımının içeriği tarafından değiştirilen ve geçersiz kılınan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm trước đây mà nội dung được thay thế bởi biểu hiện sau này, thường là vì tác phẩm sau này chứa đựng thông tin mới hoặc cập nhật làm biểu hiện trước đây bị lỗi thời."],"zh-Hans-CN":["将一种内容表达与其内容被另一种作品的一种内容表达之内容替代并废止的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"استبدال لتعبيرة","ca":"reemplaçament d’una expressió","cs":"náhrada vyjádření","da":"erstatning af udtryk","de":"Ersatz von (Expression)","de":"Datum einer Expression","el":"αντικατάσταση της (έκφραση)","en":"replacement of expression","es":"reemplazo de expresión","et":"asendab väljenduse","fi":"korvaa ekspression","fr":"remplacement d’une expression","hu":"kifejezési forma cseréje:","lv":"aizstātā izteiksme","nl":"vervanging van expressie","no":"erstatning av uttrykk","tr":"anlatımın değiştirilmesi","vi":"thay thế của (biểu hiện)","zh-Hans-CN":"内容表达的替代"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يُستبدَل محتواه ويصبح متقادمًا في وجود محتوى تعبيرة عمل آخر.","ca":"Expressió d’una obra el contingut de la qual és substituït i convertit en obsolet pel contingut d’una expressió d’una altra obra.","cs":"Vyjádření díla, jehož obsah je nahrazen obsahem vyjádření jiného díla a stává se zastaralým.","da":"Udtryk af et tidligere værk, hvis indhold er overflødiggjort og forældet af indholdet af et udtryk af et andet værk.","de":"Eine Expression eines Werks, deren Inhalt durch Inhalt einer Expression eines anderen Werks ersetzt und überflüssig wird.","de":"Eine Expression eines Werks, deren Inhalt den Inhalt einer Expression eines anderen Werks ersetzt und überflüssig macht.","el":"Μια έκφραση ενός προηγούμενου έργου του οποίου το περιεχόμενο έχει αντικατασταθεί από μια μεταγενέστερη έκφραση, συνήθως γιατί το μεταγενέστερο έργο περιέχει ενημερωμένη ή νέα πληροφόρηση η οποία καθιστά την προηγούμενη έκφραση παρωχημένη.","en":"An expression of a work whose content is superseded and rendered obsolete by the content of an expression of another work.","es":"Una expresión de una obra cuyo contenido es reemplazado y vuelto obsoleto por el contenido de una expresión de otra obra.","et":"Teose väljendus, mille sisu on asendatud ja tühistatud teise teose väljenduse sisuga.","fi":"Teoksen ekspressio, jonka sisällön toisen teoksen ekspression sisältö korvaa ja tekee vanhentuneeksi.","fr":"Expression d’une œuvre dont le contenu est remplacé et rendu périmé par le contenu d’une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amelynek tartalmát túlhaladja és elavulttá teszi egy másik mű kifejezési formájának tartalma.","lv":"Darba izteiksme, kuras saturu aizstāj un padara par novecojušu kāda cita darba izteiksmes saturs.","nl":"Een expressie van een werk waarvan de content is overschreven en achterhaald door de content van een expressie van een ander werk.","no":"Et uttrykk av et verk med innhold som er erstattet og foreldet av innholdet i et uttrykk av et annet verk.","tr":"İçeriği, başka bir eserin anlatımının içeriği tarafından değiştirilen ve eskimiş hale getirilen bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm trước đây mà nội dung được thay thế bởi biểu hiện sau này, thường là vì tác phẩm sau này chứa đựng thông tin mới hoặc cập nhật làm biểu hiện trước đây bị lỗi thời.","zh-Hans-CN":"其内容被另一种作品的一种内容表达之内容替代并废止的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل ثابت أو عمل متكامل."],"ca":["En general, aquest element s’aplica a una expressió d’una obra estàtica o d’una obra integrant."],"cs":["Tento prvek se obecně vztahuje na vyjádření statického díla nebo integračního díla."],"da":["Dette element gælder generelt for et udtryk af et statisk værk eller et integrerende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines statischen Werks oder eines integrierenden Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines statischen Werks oder eines integrierenden Werks zu."],"el":["Αυτή η σχέση βρίσκει εφαρμογή γενικά σε μονομερείς μονάδες, πολυμερείς μονογραφίες και ενσωματωμένους πόρους ή πόρους διαρκούς ενημέρωσης/ανανέωσης."],"en":["This element applies in general to an expression of a static work or an integrating work."],"es":["Este elemento se aplica en general a una expresión de una obra estática o de una obra integradora."],"et":["Elementi rakendatakse peamiselt staatilise teose või lõimteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä staattisen teoksen tai päivittyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre statique ou d’une œuvre intégratrice."],"hu":["Ezt az elemet általában a statikus, vagy integráló művek kifejezési formáira alkalmazzák."],"lv":["Elements attiecas galvenokārt uz statiska vai integrēta darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een statisch werk of een geïntegreerd werk."],"no":["Dette elementet gjelder som oftest for et uttrykk av et statisk eller integrerende verk."],"tr":["Bu öğe, genel olarak durağan bir eserin veya bütünleştirici bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho đơn vị một phần, chuyên khảo nhiều phần, và tài nguyên tích hợp."],"zh-Hans-CN":["该元素一般适用于一种静态作品或一种集成性作品的一种内容表达"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20154", "lexicalAlias":"http://rdaregistry.info/Elements/e/precededByExpression.en", "label":"is preceded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/replacementOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20199", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/replacementOfExpression.en", "label":"is replacement of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20199", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/replacementOfExpression.en", "label":"is replacement of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20123","label":{"ar":"هي معالجة مسرحية لتعبيرة","ca":"és dramatització d’una expressió","cs":"je dramatizací vyjádření","da":"er dramatisering af udtryk","de":"ist Bühnenbearbeitung von (Expression)","de":"ist Bühnenbearbeitung von (Expression)","el":"είναι δραματοποίηση της (έκφραση)","en":"is dramatization of expression","es":"es dramatización de la expresión","et":"dramatiseering väljendusest","fi":"dramatisointi ekspressiosta","fr":"est une adaptation au théâtre d’une expression","hu":"kifejezési forma dramatizált változata:","lv":"kā luga adaptētā izteiksme","nl":"is dramatisering van expressie","no":"er dramatisering av uttrykk","tr":"anlatımın dramatize edilmesidir","vi":"là kịch hoá của (biểu hiện)","zh-Hans-CN":"是内容表达的戏剧化"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل درامي معالج كمسرحية."],"ca":["Relaciona una expressió amb una expressió d’una obra que és adaptada a teatre."],"cs":["Vztahuje vyjádření k vyjádření díla, které je adaptováno jako a drama."],"da":["Relaterer et udtryk til et udtryk af et værk, som er bearbejdet til et drama."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Theaterstück bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Theaterstück bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως δράμα."],"en":["Relates an expression to an expression of a work that is adapted as a drama."],"es":["Relaciona una expresión con una expresión de una obra que está adaptada como drama."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud draamana."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sovitettu näytelmäksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est adaptée en pièce de théâtre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet drámaként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir adaptēta kā luga."],"nl":["Relateert een expressie aan een expressie van een werk dat is bewerkt als een toneelstuk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til et drama."],"tr":["Bir anlatımı, drama olarak uyarlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được phỏng theo như là kịch."],"zh-Hans-CN":["将一种内容表达与被改编为戏剧的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة مسرحية لتعبيرة","ca":"dramatització d’una expressió","cs":"dramatizace vyjádření","da":"dramatisering af udtryk","de":"Bühnenbearbeitung von (Expression)","de":"Bühnenbearbeitung von (Expression)","el":"δραματοποίηση της (έκφραση)","en":"dramatization of expression","es":"dramatización de la expresión","et":"dramatiseering väljendusest","fi":"dramatisointi ekspressiosta","fr":"adaptation au théâtre d’une expression","hu":"kifejezési forma dramatizált változata:","lv":"kā luga adaptētā izteiksme","nl":"dramatisering van expressie","no":"dramatisering av uttrykk","tr":"anlatımın dramatize edilmesi","vi":"kịch hoá của (biểu hiện)","zh-Hans-CN":"内容表达的戏剧化"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معالج كمسرحية.","ca":"Expressió d’una obra que és adaptada a teatre.","cs":"Vyjádření díla, které je adaptováno jako a drama.","da":"Udtryk af et værk, som er bearbejdet til et drama.","de":"Eine Expression eines Werks, die als Theaterstück bearbeitet ist.","de":"Eine Expression eines Werks, die als Theaterstück bearbeitet ist.","el":"Μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί ως δράμα.","en":"An expression of a work that is adapted as a drama.","es":"Una expresión de una obra que está adaptada como drama.","et":"Teose väljendus, mis on adapteeritud draamana.","fi":"Teoksen ekspressio, joka on sovitettu näytelmäksi.","fr":"Expression d’une œuvre qui est adaptée en pièce de théâtre.","hu":"Egy mű kifejezési formája, amelyet drámaként adaptáltak.","lv":"Darba izteiksme, kas ir adaptēta kā luga.","nl":"Een expressie van een werk dat is bewerkt als een toneelstuk.","no":"Et uttrykk av et verk som er bearbeidet til et drama.","tr":"Drama olarak uyarlanan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được phỏng theo như là kịch.","zh-Hans-CN":"被改编为戏剧的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/dramatizationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20123", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dramatizationOfExpression.en", "label":"is dramatization of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20123", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dramatizationOfExpression.en", "label":"is dramatization of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20095","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يتكون من سيناريو فيلم سينمائي لعمل صور متحركة مبني على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra que consisteix en un guió d’una obra d’imatge en moviment, basada en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které sestává ze scénáře pro pohyblivý obraz (dílo), založenému na vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som består af manuskript til en værk med levende billeder, baseret på et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einem Drehbuch für ein Bewegtbildwerk besteht und auf einer Expression eines anderen Werks basiert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einem Drehbuch für ein Bewegtbildwerk besteht und auf einer Expression eines anderen Werks basiert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου που συνίσταται από ένα σενάριο για μια κινηματογραφική ταινία βασισμένο σε ένα έργο-πηγή."],"en":["Relates an expression to an expression of a work that consists of a screenplay for a moving image work, based on an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que consta de un guión para una obra de imagen en movimiento, basado en una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mis on allikteosel põhinev stsenaarium filmi jaoks."],"fi":["Liittää ekspression teoksen ekspressioon, joka koostuu toisen teoksen ekspressioon perustuvasta liikkuvan kuvan teoksen käsikirjoituksesta."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en un scénario d’œuvre d’images animées, basée sur une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy mozgóképmű másik mű kifejezési formáján alapuló forgatókönyve."],"lv":["Sasaista izteiksmi ar darba izteiksmi - kinofilmas scenārijs veidots pēc pamatdarba."],"nl":["Relateert een expressie aan een expressie van een werk dat bestaat uit een scenario voor een speelfilm gebaseerd op een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som består av et manuskript for en spillefilm, basert på et kildeverk."],"tr":["Bir anlatımı, başka bir eserin anlatımına dayanan hareketli bir görüntü eseri için senaryodan oluşan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm có chứa kịch bản của phim điện ảnh, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种内容表达与由基于另一种作品的一种内容表达的一种动态图像作品的剧本组成的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة كتعبيرة سيناريو فيلم سينمائي","ca":"adaptat com a expressió de guió de pel·lícula cinematogràfica","cs":"adaptováno jako scénář pohyblivého obrazu (vyjádření)","da":"bearbejdet til filmmanuskriptudtryk","de":"Bearbeitet als Filmdrehbuch (Expression)","de":"Bearbeitet als Filmdrehbuch (Expression)","el":"προσαρμοσμένη ως σενάριο κινηματογραφικής ταινίας (έκφραση)","en":"adapted as motion picture screenplay expression","es":"adaptado como expresión de guión cinematográfico","et":"adapteeritud filmistsenaariumina (väljendus)","fi":"sovitettu elokuvakäsikirjoitukseksi (ekspressio)","fr":"adapté en scénario de film (expression)","hu":"mozgóképforgatókönyvként való feldolgozása kifejezési formaként:","lv":"adaptēts kā izteiksme: kinoscenārijs","nl":"bewerkt als speelfilmscenario-expressie","no":"bearbeidet som manus for spillefilm (uttrykk)","tr":"sinema filmi senaryo anlatımı olarak uyarlanan","vi":"được phỏng theo như là kịch bản điện ảnh (biểu hiện)","zh-Hans-CN":"被改编为电影剧本内容表达"},"ToolkitDefinition":{"ar":"تربط بين تعبيرة وعمل يتكون من سيناريو فيلم سينمائي لعمل صور متحركة مبني على تعبيرة لعمل آخر.","ca":"Expressió d’una obra que consisteix en un guió d’una obra d’imatge en moviment, basada en una expressió d’una altra obra.","cs":"Vyjádření díla, které sestává ze scénáře pro pohyblivý obraz (dílo), založenému na vyjádření jiného díla.","da":"Udtryk af et værk, som består af manuskript til en værk med levende billeder, baseret på et udtryk af et andet værk.","de":"Eine Expression eines Werks, die aus einem Drehbuch für ein Bewegtbildwerk besteht und auf einer Expression eines anderen Werks basiert.","de":"Eine Expression eines Werks, die aus einem Drehbuch für ein Bewegtbildwerk besteht und auf einer Expression eines anderen Werks basiert.","el":"Μια έκφραση ενός έργου που συνίσταται από ένα σενάριο για μια κινηματογραφική ταινία βασισμένο σε ένα έργο-πηγή.","en":"An expression of a work that consists of a screenplay for a moving image work, based on an expression of another work.","es":"Una expresión de una obra que consta de un guión para una obra de imagen en movimiento, basado en una expresión de otra obra.","et":"Teose väljendus, mis on allikteosel põhinev stsenaarium filmi jaoks.","fi":"Teoksen ekspressio, joka koostuu toisen teoksen ekspressioon perustuvasta liikkuvan kuvan teoksen käsikirjoituksesta.","fr":"Expression d’une œuvre qui consiste en un scénario d’œuvre d’images animées, basée sur une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amely egy mozgóképmű másik mű kifejezési formáján alapuló forgatókönyve.","lv":"Darba izteiksme - kinofilmas scenārijs veidots pēc pamatdarba.","nl":"Een expressie van een werk dat bestaat uit een scenario voor een speelfilm gebaseerd op een expressie van een ander werk.","no":"Et uttrykk av et verk som består av et manuskript for en spillefilm, basert på et kildeverk.","tr":"Başka bir eserin anlatımına dayanan hareketli bir görüntü eserinin senaryosundan oluşan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm có chứa kịch bản của phim điện ảnh, dựa trên tác phẩm nguồn.","zh-Hans-CN":"由基于另一种作品的一种内容表达的一种动态图像作品的剧本组成的一种作品的一种内容表达"},"label":{"ar":"هي معالجة كتعبيرة سيناريو فيلم سينمائي","ca":"és adaptat com a expressió de guió de pel·lícula cinematogràfica","cs":"je adaptováno jako scénář pohyblivého obrazu (vyjádření)","da":"er bearbejdet til filmmanuskriptudtryk","de":"ist bearbeitet als Filmdrehbuch (Expression)","de":"ist bearbeitet als Filmdrehbuch (Expression)","el":"είναι προσαρμοσμένη ως σενάριο κινηματογραφικής ταινίας (έκφραση)","en":"is adapted as motion picture screenplay expression","es":"está adaptado como expresión de guión cinematográfico","et":"adapteeritud filmistsenaariumina (väljendus)","fi":"sovitettu elokuvakäsikirjoitukseksi (ekspressio)","fr":"est adapté en scénario de film (expression)","hu":"mozgóképforgatókönyvként való feldolgozása a következő kifejezési formaként:","lv":"ir adaptēts kā kinoscenārijs (izteiksme)","nl":"is bewerkt als speelfilmscenario-expressie","no":"er bearbeidet som manus for spillefilm (uttrykk)","tr":"sinema filmi senaryosu anlatımı olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản điện ảnh (biểu hiện)","zh-Hans-CN":"被改编为电影剧本内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20096", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsScreenplayExpression.en", "label":"is adapted as screenplay expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsMotionPictureScreenplayExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20095", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsMotionPictureScreenplayExpression.en", "label":"is adapted as motion picture screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20095", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsMotionPictureScreenplayExpression.en", "label":"is adapted as motion picture screenplay expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20149","label":{"ar":"هي استمرار لتعبيرة","ca":"és continuació d’una expressió","cs":"je pokračováním vyjádření","da":"er fortsættelse af udtryk","de":"ist Fortsetzung von (Expression)","de":"ist Fortsetzung von (Expression)","el":"είναι συνέχεια της (έκφραση)","en":"is continuation of expression","es":"es continuación de la expresión","et":"jätk väljendusele","fi":"jatkoa ekspressiolle","fr":"est une continuation d’une expression","hu":"folytatása a következő kifejezési formának:","lv":"ir turpinājums izteiksmei","nl":"is voortzetting van expressie","no":"er fortsettelse av uttrykk","tr":"anlatımın devamıdır","vi":"là tiếp tục của (biểu hiện)","zh-Hans-CN":"是内容表达的继承"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل ممتد زمنيًا ومكتمل، ومحتواه مستمر من خلال تعبيرة عمل آخر ممتد زمنيًا."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una obra diacrònica completa el contingut de la qual és continuat per una expressió d’una altra obra diacrònica."],"cs":["Vztahuje vyjádření k vyjádření díla, které je ukončeným diachronním dílem, na jehož obsah navazuje vyjádření jiného diachronního díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som er et fuldstændigt diakronisk værk, hvis indhold er fortsat af et udtryk af et andet diakronisk værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines abgeschlossenen diachronen Werks, dessen Inhalt durch eine Expression eines anderen diachronen Werks fortgesetzt wird.,Setzt eine Expression in Beziehung zu einer Expression eines abgeschlossenen diachronen Werks, dessen Inhalt durch eine Expression eines anderen diachronen Werks fortgesetzt wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο συνεχίζεται από το περιεχόμενο μιας έκφρασης ενός μεταγενέστερου έργου."],"en":["Relates an expression to an expression of a work that is a completed diachronic work whose content is continued by an expression of another diachronic work."],"es":["Relaciona una expresión con una expresión de una obra que es una obra diacrónica completada cuyo contenido es continuado por una expresión de otra obra diacrónica."],"et":["Seostab väljenduse diakroonilise lõpetatud teose väljendusega, mille sisu jätkab teise diakroonilise teose väljendus."],"fi":["Liittää ekspression teoksen ekspressioon, joka on valmis diakroninen teos, jonka sisältöä jatkaa toisen diakronisen teoksen ekspressio."],"fr":["Met une expression en relation avec une expression d’une œuvre diachronique qui est terminée et dont le contenu est continué par une expression d’une autre œuvre diachronique."],"hu":["Hozzákapcsol egy kifejezési formát egy folyamatos diakronikus mű kifejezési formájához, amely egy másik diakronikus mű kifejezési formájának a tartalmával folytatódik."],"lv":["Sasaista izteiksmi ar diahroniska darba izteiksmi, kas turpina cita pabeigta diahroniska darba saturu."],"nl":["Relateert een expressie aan een expressie van een werk dat een afgesloten diachronisch werk is waarvan de content voortgezet wordt door een expressie van een ander diachronisch werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er et komplett diakronisk verk hvis innhold fortsettes i et uttrykk av et annet diakronisk verk."],"tr":["Bir anlatımı, içeriği başka bir artzamanlı eserin anlatımıyla devam eden tamamlanmış bir artzamanlı eser olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được tiếp tục bởi nội dung của biểu hiện của tác phẩm trước đây."],"zh-Hans-CN":["将一种内容表达与作为一种已完成的历时作品而且其内容被另一种历时作品的一种内容表达继承的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"استمرار لتعبيرة","ca":"continuació d’una expressió","cs":"pokračování vyjádření","da":"fortsættelse af udtryk","de":"Fortsetzung von (Expression)","de":"Fortsetzung von (Expression)","el":"συνέχεια της (έκφραση)","en":"continuation of expression","es":"continuación de la expresión","et":"jätk väljendusele","fi":"jatkoa ekspressiolle","fr":"continuation d’une expression","hu":"kifejezési forma folytatása:","lv":"turpinājums izteiksmei","nl":"voortzetting van expressie","no":"fortsettelse av uttrykk","tr":"anlatımın devamı","vi":"tiếp tục của (biểu hiện)","zh-Hans-CN":"内容表达的继承"},"ToolkitDefinition":{"ar":"تعبيرة لعمل ممتد زمنيًا ومكتمل، ومحتواه مستمر من خلال تعبيرة عمل آخر ممتد زمنيًا.","ca":"Expressió d’una obra que és una obra diacrònica completa el contingut de la qual és continuat per una expressió d’una altra obra diacrònica.","cs":"Vyjádření díla, které je ukončeným diachronním dílem, na jehož obsah navazuje vyjádření jiného diachronního díla.","da":"Udtryk af et værk, som er et fuldstændigt diakronisk værk, hvis indhold er fortsat af et udtryk af et andet diakronisk værk.","de":"Eine Expression eines abgeschlossenen diachronen Werks, dessen Inhalt durch eine Expression eines anderen diachronen Werks fortgesetzt wird.","de":"Eine Expression eines abgeschlossenen diachronen Werks, dessen Inhalt durch eine Expression eines anderen diachronen Werks fortgesetzt wird.","el":"Μια έκφραση ενός έργου το οποίο συνεχίζεται από το περιεχόμενο μιας έκφρασης ενός μεταγενέστερου έργου.","en":"An expression of a work that is a completed diachronic work whose content is continued by an expression of another diachronic work.","es":"Una expresión de una obra que es una obra diacrónica completada cuyo contenido es continuado por una expresión de otra obra diacrónica.","et":"Diakroonilise lõpetatud teose väljendus, mille sisu jätkab teise diakroonilise teose väljendus.","fi":"Teoksen ekspressio, joka on valmis diakroninen teos, jonka sisältöä jatkaa toisen diakronisen teoksen ekspressio.","fr":"Expression d’une œuvre diachronique qui est terminée et dont le contenu est continué par une expression d’une autre œuvre diachronique.","hu":"Egy folyamatos diakronikus mű kifejezési formája, amely egy másik diakronikus mű kifejezési formájának a tartalmával folytatódik.","lv":"Diahroniska darba izteiksme, kas turpina cita pabeigta diahroniska darba saturu.","nl":"Een expressie van een werk dat een afgesloten diachronisch werk is waarvan de content voortgezet wordt door een expressie van een ander diachronisch werk.","no":"Et uttrykk av et verk som er et komplett diakronisk verk hvis innhold fortsettes i et uttrykk av et annet diakronisk verk.","tr":"İçeriği başka bir artzamanlı eserin anlatımıyla devam eden tamamlanmış bir artzamanlı eserin anlatımı.","vi":"Biểu hiện của tác phẩm được tiếp tục bởi nội dung của biểu hiện của tác phẩm trước đây.","zh-Hans-CN":"作为一种已完成的历时作品而且其内容被另一种历时作品的一种内容表达继承的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل متتالٍ."],"ca":["En general, aquest element s’aplica a una expressió d’una obra successiva."],"cs":["Tento termín se obecně vztahuje na vyjádření postupně vydávaného díla."],"da":["Dette element gælder generelt for et udtryk af et fortløbende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu."],"el":["Αυτή η σχέση βρίσκει εφαρμογή γενικά στα περιοδικά."],"en":["This element applies in general to an expression of a successive work."],"es":["Este elemento se aplica en general a una expresión de una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre successive."],"hu":["Ezt az elemet általában egy folyamatos mű kifejezési formájára alkalmazzák."],"lv":["Šis elements parasti attiecas uz secīgā darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een successief werk."],"no":["Dette elementet gjelder som oftest for et uttrykk av et fortløpende verk."],"tr":["Bu öğe, genel olarak ardışık bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho ấn phẩm nhiều kỳ."],"zh-Hans-CN":["该元素一般适用于一种相继作品的一个容表达。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20154", "lexicalAlias":"http://rdaregistry.info/Elements/e/precededByExpression.en", "label":"is preceded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/continuationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20149", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/continuationOfExpression.en", "label":"is continuation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20149", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/continuationOfExpression.en", "label":"is continuation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20096","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يتكون من سيناريو لعمل فيلم سينمائي، أو برنامج تليفزيوني، أو فيديو مبني على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra que consisteix en un guió d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo, basada en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které sestává ze scénáře pro film, televizní program nebo video, založenému na vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som består af et manuskript til en spillefilm, tv-program eller video, baseret på et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht und auf einer Expression eines anderen Werks basiert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht und auf einer Expression eines anderen Werks basiert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου που συνίσταται από ένα σενάριο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο βασισμένο σε ένα έργο-πηγή."],"en":["Relates an expression to an expression of a work that consists of a screenplay for a motion picture, television program, or video, based on an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que consta de un guión para una película, programa de televisión o video, basado en una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mis on allikteosel põhinev stsenaarium filmi, telesaate või video jaoks."],"fi":["Liittää ekspression teoksen ekspressioon, joka koostuu toisen teoksen ekspressioon perustuvasta elokuvan, televisio-ohjelman tai videon käsikirjoituksesta."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en un scénario de film, d’émission de télévision ou de vidéo, basée sur une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy másik mű kifejezési formáján alapuló mozgókép, televízióműsor vagy videó forgatókönyvéből áll."],"lv":["Sasaista izteiksmi ar darba izteiksmi - kinofilmas, televīzijas uzveduma vai video scenārijs veidots pēc pamatdarba."],"nl":["Relateert een expressie aan een expressie van een werk dat bestaat uit een scenario voor een speelfilm, televisieprogramma of video, gebaseerd op een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som består av et manuskript for en spillefilm, et fjernsynsprogram eller en video, basert på et kildeverk."],"tr":["Bir anlatımı, başka bir eserin anlatımına dayanan bir sinema filmi, televizyon programı veya video için senaryodan oluşan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm có chứa kịch bản của phim điện ảnh, chương trình truyền hình, hoặc video, dựa trên tác phẩm nguồn"],"zh-Hans-CN":["将一种内容表达与由基于另一种作品的一种内容表达的一种电影、电视节目或视频的剧本组成的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة كتعبيرة سيناريو","ca":"adaptat com a expressió de guió","cs":"adaptováno jako scénář (vyjádření)","da":"bearbejdet til manuskriptudtryk","de":"Bearbeitet als Drehbuch (Expression)","de":"Bearbeitet als Drehbuch (Expression)","el":"προσαρμοσμένη ως σενάριο (έκφραση)","en":"adapted as screenplay expression","es":"adaptado como expresión de guión.","et":"adapteeritud stsenaariumina (väljendus)","fi":"sovitettu käsikirjoitukseksi (ekspressio)","fr":"adapté en scénario (expression)","hu":"forgatókönyvként való feldolgozása kifejezési formaként:","lv":"adaptēts kā izteiksme: scenārijs","nl":"bewerkt als scenario-expressie","no":"bearbeidet som filmmanus (uttrykk)","tr":"Senaryo anlatımı olarak uyarlanan","vi":"được phỏng theo như là kịch bản (biểu hiện)","zh-Hans-CN":"被改编为影视剧本内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يتكون من سيناريو لعمل فيلم سينمائي، أو برنامج تليفزيوني، أو فيديو مبني على تعبيرة لعمل آخر.","ca":"Expressió d’una obra que consisteix en un guió d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo, basada en una expressió d’una altra obra.","cs":"Vyjádření díla, které sestává ze scénáře pro film, televizní program nebo video, založenému na vyjádření jiného díla.","da":"Udtryk af et værk, som består af manuskriptet til en spillefilm, tv-program eller video, baseret på et udtryk af et andet værk.","de":"Eine Expression eines Werks, die aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht und auf einer Expression eines anderen Werks basiert.","de":"Eine Expression eines Werks, die aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht und auf einer Expression eines anderen Werks basiert.","el":"Μια έκφραση ενός έργου που συνίσταται από ένα σενάριο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο βασισμένο σε ένα έργο-πηγή.","en":"An expression of a work that consists of a screenplay for a motion picture, television program, or video, based on an expression of another work.","es":"Una expresión de una obra que consta de un guión para una película, programa de televisión o video, basado en una expresión de otra obra.","et":"Teose väljendus, mis on allikteosel põhinev stsenaarium filmi, telesaate või video jaoks.","fi":"Teoksen ekspressio, joka koostuu toisen teoksen ekspressioon perustuvasta elokuvan, televisio-ohjelman tai videon käsikirjoituksesta.","fr":"Expression d’une œuvre qui consiste en un scénario de film, d’émission de télévision ou de vidéo, basée sur une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amely egy másik mű kifejezési formáján alapuló mozgókép, televízióműsor vagy videó forgatókönyvéből áll.","lv":"Darba izteiksme - kinofilmas, televīzijas uzveduma vai video scenārijs veidots pēc pamatdarba.","nl":"Een expressie van een werk dat bestaat uit een scenario voor een speelfilm, televisieprogramma of video, gebaseerd op een expressie van een ander werk.","no":"Et uttrykk av et verk som består av et manuskript for en spillefilm, et fjernsynsprogram eller en video, basert på et kildeverk.","tr":"Başka bir eserin anlatımına dayanan bir sinema filmi, televizyon programı veya video için bir senaryodan oluşan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm có chứa kịch bản của phim điện ảnh, chương trình truyền hình, hoặc video, dựa trên tác phẩm nguồn","zh-Hans-CN":"由基于另一种作品的一种内容表达的一种电影、电视节目或视频的剧本组成的一种作品的一种内容表达"},"label":{"ar":"هي معالجة كتعبيرة سيناريو","ca":"és adaptat com a expressió de guió","cs":"je adaptováno jako scénář (vyjádření)","da":"er bearbejdet til manuskriptudtryk","de":"ist bearbeitet als Drehbuch (Expression)","de":"ist bearbeitet als Drehbuch (Expression)","el":"είναι προσαρμοσμένη ως σενάριο (έκφραση)","en":"is adapted as screenplay expression","es":"está adaptado como expresión de guión.","et":"adapteeritud stsenaariumina (väljendus)","fi":"sovitettu käsikirjoitukseksi (ekspressio)","fr":"est adapté en scénario (expression)","hu":"forgatókönyvként való feldolgozása a következő kifejezési formaként:","lv":"ir adaptēts kā scenārijs (izteiksme)","nl":"is bewerkt als scenario-expressie","no":"er bearbeidet som filmmanus (uttrykk)","tr":"senaryo anlatımı olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản (biểu hiện)","zh-Hans-CN":"被改编为影视剧本内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en", "label":"is adapted as expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsScreenplayExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20095", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsMotionPictureScreenplayExpression.en", "label":"is adapted as motion picture screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/P20097", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsTelevisionScreenplayExpression.en", "label":"is adapted as television screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/P20098", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsVideoScreenplayExpression.en", "label":"is adapted as video screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20096", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsScreenplayExpression.en", "label":"is adapted as screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20096", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsScreenplayExpression.en", "label":"is adapted as screenplay expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20214","label":{"ar":"لها تاريخ لتعبيرة","ca":"té com a data d’expressió","cs":"má datum vyjádření","da":"har dato for udtryk","de":"hat Datum einer Expression","de":"hat Datum einer Expression","el":"έχει χρονολογία της έκφρασης","en":"has date of expression","es":"tiene fecha de expresión","et":"väljenduse daatum","fi":"ekspression ajankohta","fr":"a pour date d’une expression","hu":"kifejezési forma időpontja a következő:","lv":"izteiksmes datējums","nl":"heeft datum van expressie","no":"har tidspunkt for uttrykk","tr":"ifade tarihi ile ilişkilidir","vi":"có ngày của biểu hiện","zh-Hans-CN":"有内容表达的日期"},"definition":{"ar":["تربط بين تعبيرة وفترة زمنية تمثل أقدم تاريخ مرتبط بتعبيرة."],"ca":["Relaciona una expressió amb un interval de temps que és el més antic associat amb una expressió."],"cs":["Vztahuje vyjádření k časovému vymezení, které je s vyjádřením spojeno nejdříve."],"da":["Relaterer et udtryk til en tidsperiode, som er den tidligste knyttet til et udtryk."],"de":["Setzt eine Expression in Beziehung zu dem frühesten Zeitraum, der mit einer Expression in Verbindung steht.,Setzt eine Expression in Beziehung zu dem frühesten Zeitraum, der mit einer Expression in Verbindung steht."],"el":["Συνδέει μια έκφραση με μια προηγούμενη χρονολογία συνδεδεμένη με μια έκφραση."],"en":["Relates an expression to a timespan that is the earliest associated with an expression."],"es":["Relaciona una expresión con un período de tiempo que es el primero asociado con una expresión."],"et":["Seostab väljenduse ajavahemikuga, milleks on väljendusega seotud varaseim daatum."],"fi":["Liittää ekspression varhaisimpaan ekspressioon liittyvään ajanjaksoon."],"fr":["Met une expression en relation avec un laps de temps qui est le plus ancien associé à une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy legkorábbi időtartamhoz, ami egy kifejezési formával társítható."],"lv":["Sasaista izteiksmi ar laikposmu, kas ir izteiksmes sākotnējais datējums."],"nl":["Relateert een expressie aan een tijdspanne die de vroegste is geassocieerd met een expressie."],"no":["Relaterer et uttrykk til det tidligste tidsrommet som kan forbindes med et uttrykk."],"tr":["Bir anlatımı, anlatımla bağlantılı olan en erken zaman aralığıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với ngày sớm nhất liên quan tới biểu hiện."],"zh-Hans-CN":["将一种内容表达与和一种内容表达有关的最早的时间段关联起来。"]},"ToolkitLabel":{"ar":"تاريخ لتعبيرة","ca":"data d’expressió","cs":"datum vyjádření","da":"dato for udtryk","de":"Datum einer Expression","de":"Datum einer Expression","el":"χρονολογία της έκφρασης","en":"date of expression","es":"fecha de expresión","et":"väljenduse daatum","fi":"ekspression ajankohta","fr":"date d’une expression","hu":"kifejezési forma időpontja:","lv":"izteiksmes datējums","nl":"datum van expressie","no":"tidspunkt for uttrykk","tr":"anlatım tarihi","vi":"ngày của biểu hiện","zh-Hans-CN":"内容表达的日期"},"ToolkitDefinition":{"ar":"فترة زمنية تمثل أقدم تاريخ مرتبط بتعبيرة.","ca":"Interval de temps que és el més antic associat amb una expressió.","cs":"Časové vymezení, které je s vyjádřením spojeno nejdříve.","da":"Tidsperiode tidligst knyttet til et udtryk.","de":"Der früheste Zeitraum, der mit einer Expression in Verbindung steht.","de":"Der früheste Zeitraum, der mit einer Expression in Verbindung steht.","el":"Μια προηγούμενη χρονολογία συνδεδεμένη με μια έκφραση.","en":"A timespan that is the earliest associated with an expression.","es":"Un intervalo de tiempo que es el primero asociado con una expresión.","et":"Ajavahemik, milleks on väljendusega seotud varaseim daatum.","fi":"Varhaisin ekspressioon liittyvä ajanjakso.","fr":"Laps de temps qui est le plus ancien associé à une expression.","hu":"Egy legkorábbi időtartam, ami egy kifejezési formával társítható.","lv":"Izteiksmes sākotnējais datējums.","nl":"Een tijdspanne die de vroegste is geassocieerd met een expressie.","no":"Det tidligste tidsrommet som kan forbindes med et uttrykk.","tr":"Bir anlatımla bağlantılı olan en erken zaman aralığı.","vi":"Ngày sớm nhất liên quan tới biểu hiện.","zh-Hans-CN":"和一种内容表达有关的最早的时间段"},"note":{"ar":["تاريخ لتعبيرة قد يتضمن تاريخ لنص مكتوب، أو تاريخ لتحرير نهائي لفيلم سينمائي، أو تاريخ لأول بث لبرنامج تليفزيوني أو إذاعي، أو تاريخ لتدوين مدونة، أو تاريخ لتسجيل حدث، إلخ."],"ca":["Una data d’expressió pot incloure una data en què va ser escrit un text, una data d’edició final d’una obra d’imatge en moviment, una data de la primera emissió d’un programa de televisió o d’un programa radiofònic, una data de notació d’una partitura, la data de l’enregistrament d’un esdeveniment, etc."],"cs":["Datum vyjádření může zahrnovat datum sepsání textu, datum posledních úprav díla pohyblivého obrazu, datum prvního vysílání pro televizní nebo rozhlasový program, datum zápisu partitury, datum zaznamenání (nahrání) události, atd."],"da":["Dato for udtryk kan omfatte et dato for hvornår en tekst blev skrevet, en dato for endelig redigering af et værk med levende billeder, en dato for første udsendelse for et tv- eller radioprogram, en dato for notation af et partitur, en dato for optagelsen af en begivenhed, etc."],"de":["Darunter können ein Datum, an dem ein Text geschrieben wurde, ein Datum der Endbearbeitung eines Bewegtbildwerks, ein Datum der Erstausstrahlung einer Ferseh- oder Hörfunksendung, ein Datum der Notation einer Partitur, ein Datum einer Aufnahme eines Ereignisses und so weiter fallen.,Darunter können ein Datum, an dem ein Text geschrieben wurde, ein Datum der Endbearbeitung eines Bewegtbildwerks, ein Datum der Erstausstrahlung einer Ferseh- oder Hörfunksendung, ein Datum der Notation einer Partitur, ein Datum einer Aufnahme eines Ereignisses und so weiter fallen."],"en":["A date of expression may include a date a text was written, a date of final editing of a moving image work, a date of first broadcast for a television or radio program, a date of notation for a score, the date of the recording of an event, etc."],"es":["Una fecha de expresión puede incluir una fecha en que se escribió un texto, una fecha de edición final de una obra de imágenes en movimiento, una fecha de primera transmisión para un programa de radio o televisión, una fecha de anotación para una partitura, la fecha de grabación de un evento, etc"],"et":["Väljenduse daatum võib olla teksti kirjutamise daatum, liikuvast pildist koosneva teose lõppviimistluse daatum, tele- või raadiosaate esimese eetrisse saatmise daatum, partituuri kirjapaneku daatum, sündmuse salvestamise daatum jne."],"fi":["Ekspression ajankohta voi sisältää ajankohdan, jolloin teksti kirjoitettiin, liikkuvan kuvan teoksen lopullisen leikkauksen ajankohdan, televisio- tai radio-ohjelman ensimmäisen lähetyksen ajankohdan, partituurin nuotinnoksen ajankohdan, tapahtuman taltioinnin ajankohdan jne."],"fr":["Une date d’une expression peut comprendre la date de rédaction d’un texte, la date du montage final d’une œuvre d’images animées, la date de la première diffusion d’une émission de radio ou de télévision, la date de la notation d’une partition, la date d’enregistrement d’un événement, etc."],"hu":["Egy kifejezési forma időpontja magában foglalhatja a szöveg megírásának, a mozgóképmű végleges megszerkesztésének, a televízió- vagy rádióműsor első sugárzásának, a kotta lejegyezésének, egy esemény felvételének, stb. időpontját."],"lv":["Izteiksmes datējums var ietvert datējumu, kad teksts ir uzrakstīts, kad veica kustīgā attēla galīgo rediģēšanu, televīzijas vai radio raidījuma pirmās pārraides datumu, partitūras pierakstīšanas datumu, notikuma ierakstīšanas datumu u.tml."],"nl":["Een datum van expressie kan omvatten een datum dat een tekst geschreven werd, een datum van laatste edit van een bewegend beeldwerk, een datum van eerste uitzending voor een televisie- of radioprogramma, een datum van notatie voor een partituur, de datum van het vastleggen van een gebeurtenis etc."],"tr":["İfade tarihi, bir metnin yazıldığı tarihi, bir hareketli görüntü çalışmasının son düzenleme tarihini, bir televizyon veya radyo programının ilk yayın tarihini, bir partisyonun notasyon tarihini, bir olayın kayıt tarihini, vb. içerebilir"],"zh-Hans-CN":["内容表达的日期可以包括文字写作的日期、动态图像作品最后编辑的日期、电视节目或广播节目第一次播出的日期、总谱的记谱日期、事件记录过程的日期等。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/dateOfExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20307", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedTimespanOfExpression.en", "label":"has related timespan of expression"}],"instructionNumber":"6.1","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20004", "lexicalAlias":"http://rdaregistry.info/Elements/e/dateOfCapture.en", "label":"has date of capture"},{"@id":"http://rdaregistry.info/Elements/e/object/P20214", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dateOfExpression.en", "label":"has date of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20214", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dateOfExpression.en", "label":"has date of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20205","label":{"ar":"لها تعبيرة ذات صلة بتعبيرة","ca":"té com a expressió relacionada amb una expressió","cs":"má vyjádření vztahující se k vyjádření","da":"har udtryk relateret til udtryk","de":"hat mit Expression in Beziehung stehende Expression","de":"hat mit Expression in Beziehung stehende Expression","el":"έχει σχετική έκφραση (έκφραση)","en":"has related expression of expression","es":"tiene expresión relacionada de expresión","et":"väljendusega seotud väljendus","fi":"ekspressioon liittyvä ekspressio","fr":"a pour expression en relation avec une expression","hu":"egy kifejezési forma kapcsolódó kifejezési formája:","lv":"ar izteiksmi saistītā izteiksme","nl":"heeft gerelateerde expressie van expressie","no":"har relatert uttrykk av uttrykk","sv":"har relaterat uttryck","tr":"anlatımın ilgili anlatımı ile ilişkilidir","vi":"có biểu hiện liên quan (biểu hiện)","zh-Hans-CN":"有内容表达的关联内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة مرتبطة بتعبيرة."],"ca":["Relaciona una expressió amb una expressió que s’associa amb una expressió."],"cs":["Vztahuje vyjádření k vyjádření, které je spojené s vyjádřením."],"da":["Relaterer et udtryk til et udtryk, som er knyttet til et udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression, die mit einer Expression in Verbindung steht.,Setzt eine Expression in Beziehung zu einer Entität, die mit einer Expression in Verbindung steht."],"el":["Συνδέει μια έκφραση με μια έκφραση που συνδέεται με μια περιγραφόμενη έκφραση."],"en":["Relates an expression to an expression that is associated with an expression."],"es":["Relaciona una expresión con una expresión que está asociada con una expresión."],"et":["Seostab väljenduse väljendusega seotud väljendusega."],"fi":["Liittää ekspression ekspressioon, joka liittyy ekspressioon."],"fr":["Met une expression en relation avec une expression qui est associée à une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amelyet egy kifejezési formához kapcsolódik."],"lv":["Sasaista izteiksmi ar izteiksmi, kas ir saistīta ar izteiksmi."],"nl":["Relateert een expressie aan een expressie die geassocieerd is met een expressie."],"no":["Relaterer et uttrykk til et uttrykk som forbindes med et uttrykk."],"tr":["Bir anlatımı, bir ifadeyle bağlantılı olan bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与和一种内容表达有关的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة ذات صلة بتعبيرة","ca":"expressió relacionada amb una expressió","cs":"vyjádření vztahující se k vyjádření","da":"udtryk relateret til udtryk","de":"mit Expression in Beziehung stehende Expression","de":"mit Expression in Beziehung stehende Expression","en":"related expression of expression","es":"expresión relacionada de expresión","et":"väljendusega seotud väljendus","fi":"ekspressioon liittyvä ekspressio","fr":"expression en relation avec une expression","hu":"kifejezési forma kapcsolódó kifejezési formája:","lv":"ar izteiksmi saistītā izteiksme","nl":"gerelateerde expressie van expressie","no":"relatert uttrykk av uttrykk","sv":"relaterat uttryck","tr":"Anlatımın ilişkili olduğu anlatım","zh-Hans-CN":"内容表达的关联内容表达"},"ToolkitDefinition":{"ar":"تعبيرة مرتبطة بتعبيرة.","ca":"Expressió que s’associa amb una expressió.","cs":"Vyjádření, které je spojené s vyjádřením.","da":"Udtryk, som er knyttet til et udtryk.","de":"Eine Expression, die mit einer Expression in Verbindung steht.","de":"Eine Expression, die mit einem Akteur in Verbindung steht.","en":"An expression that is associated with an expression.","es":"Una expresión que está asociada con una expresión.","et":"Väljendusega seotud väljendus.","fi":"Ekspressio, joka liittyy ekspressioon","fr":"Expression qui est associée à une expression.","hu":"Egy kifejezési forma, amely egy kifejezési formához kapcsolódik.","lv":"Izteiksme, kas ir saistīta ar izteiksmi.","nl":"Een expressie die geassocieerd is met een expressie.","no":"Et uttrykk som forbindes med et uttrykk.","tr":"Bir ifadeyle bağlantılı olan bir anlatım.","zh-Hans-CN":"和一种内容表达有关的一种内容表达"},"altLabel":{"ar":["علاقة مشتقة لتعبيرة"],"ca":[",,"],"cs":[",,"],"de":["Teil-Ganzes-Beziehung auf Expressionsebene,Nachfolge-Beziehung auf Expressionsebene,Abgeleitete Beziehung auf Expressionsebene"],"en":["whole-part expression relationship,sequential expression relationship,derivative expression relationship"],"es":["relación de expresión todo-parte,relación de expresión secuencial,relación de expresión"],"fi":[",,"],"fr":["relation d’expression tout-partie,relation d’expression séquentielle,relation d’expression dérivée"],"hu":[",,"],"nl":["geheel-deel expressierelatie,opeenvolgende expressierelatie,afgeleide expressierelatie"],"tr":["bütün-parça anlatım ilişkisi,dizisel anlatım ilişkisi,türetilmiş ifade ilişkisi"],"zh-Hans-CN":["整体-部分内容表达关系,顺序内容表达关系,衍生内容表达关系"],"zh-Hant-TW":[",,"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20297", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedRDAEntityOfExpression.en", "label":"has related RDA entity of expression"},{"@id":"http://rdaregistry.info/Elements/x/P00003", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedExpressionOfRDAEntity.en", "label":"has related expression of RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20232", "lexicalAlias":"http://rdaregistry.info/Elements/e/accompanyingExpressionRelationship.en", "label":""},{"@id":"http://rdaregistry.info/Elements/e/P20320", "lexicalAlias":"http://rdaregistry.info/Elements/e/aggregatedBy.en", "label":"is aggregated by"},{"@id":"http://rdaregistry.info/Elements/e/P20319", "lexicalAlias":"http://rdaregistry.info/Elements/e/aggregates.en", "label":"aggregates"},{"@id":"http://rdaregistry.info/Elements/e/P20105", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentedByExpression.en", "label":"is augmented by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20234", "lexicalAlias":"http://rdaregistry.info/Elements/e/descriptiveExpressionRelationship.en", "label":"has descriptive expression relationship with (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20154", "lexicalAlias":"http://rdaregistry.info/Elements/e/precededByExpression.en", "label":"is preceded by expression"},{"@id":"http://rdaregistry.info/Elements/e/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentationOfExpression.en", "label":"is augmentation of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20204", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfSourceWork.en", "label":"has expression of source work"},{"@id":"http://rdaregistry.info/Elements/e/P20145", "lexicalAlias":"http://rdaregistry.info/Elements/e/partExpression.en", "label":"has part expression"},{"@id":"http://rdaregistry.info/Elements/e/P20074", "lexicalAlias":"http://rdaregistry.info/Elements/e/partOfExpression.en", "label":"is part of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"},{"@id":"http://rdaregistry.info/Elements/e/P20575", "lexicalAlias":"http://rdaregistry.info/Elements/e/derivativeExpression.en", "label":"has derivative expression"},{"@id":"http://rdaregistry.info/Elements/e/P20574", "lexicalAlias":"http://rdaregistry.info/Elements/e/sourceExpression.en", "label":"has source expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/relatedExpressionOfExpression.en", "label":"has related expression of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/relatedExpressionOfExpression.en", "label":"has related expression of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20180","label":{"ar":"هي فهرس لتعبيرة","ca":"és catàleg d’una expressió","da":"er katalog af udtryk","de":"ist Katalog von (Expression)","el":"είναι κατάλογος της (έκφραση)","en":"is catalogue of expression (Deprecated)","et":"kataloog väljendusele","fi":"luettelo ekspressiosta","fr":"est un catalogue d’une expression","hu":"katalógusa a következő kifejezési formának:","lv":"ir katalogs izteiksmei","nl":"is catalogus van expressie","no":"er katalog over uttrykk","vi":"là mục lục của (biểu hiện)"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يستخدم كأساس لفهرس؛ أي حصر كامل لمفردات مرتبة ترتيبا منهجيا."],"ca":["Relaciona una expressió amb una expressió d’una obra que s’usa com la base d’un catàleg, és a dir, una enumeració completa d’ítems arranjats sistemàticament."],"da":["Relaterer et udtryk til et udtryk af et værk, som anvendes som grundlag for et katalog, dvs. en komplet fortegnelse over eksemplarer, som er arrangeret systematisk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Grundlage für einen Index aller oder ausgewählter Wörter verwendet wird, die in einer Realisierung eines textlichen Werks vorkommen."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο χρησιμοποιείται ως η βάση για έναν κατάλογο, μια πλήρη δηλαδή απαρίθμηση των αντιτύπων που οργανώνονται συστηματικά."],"en":["Relates an expression to an expression of a work that is used as the basis for a catalogue, i.e., a complete enumeration of items arranged systematically. (Deprecated)"],"et":["Seostab väljenduse teose väljendusega, mis on aluseks kataloogile, s.t süstematiseeritud sissekannete terviklikule loetelule."],"fi":["Liittää ekspression teoksen ekspressioon, jota on käytetty luettelon eli systemaattisesti järjestetyn kohteiden täydellisen listauksen perustana."],"fr":["Met une expression en relation avec une expression d’une œuvre qui sert de base à un catalogue, c’est-à-dire une énumération complète d’items classés systématiquement."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet egy katalógusnak, azaz szisztematikusan elrendezett példányok teljes felsorolásának az alapjaként használnak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas izmantota par pamatu katalogam, t.i., sistemātiski sakārtotu vienību pilnīgam uzskaitījumam."],"nl":["Relateert een expressie aan een expressie van een werk dat is gebruikt als de basis voor een catalogus, in feite een complete opsomming van systematisch geordende items."],"no":["Relaterer et uttrykk til et uttrykk av et verk brukt som utgangspunkt for en katalog, dvs. en fullstendig og systematisk ordnet liste over eksemplarer."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được sử dụng như là cơ sở cho mục lục, nghĩa là, liệt kê hoàn chỉnh các hạng mục được sắp đặt một cách hệ thống."]},"ToolkitLabel":{"ar":"فهرس لتعبيرة","ca":"catàleg d’una expressió","da":"katalog af udtryk","de":"Katalog von (Expression)","el":"κατάλογος της (έκφραση)","en":"catalogue of expression (Deprecated)","es":"catálogo de (expresión)","et":"kataloog väljendusele","fi":"luettelo ekspressiosta","fr":"catalogue d’une expression","hu":"kifejezési forma katalógusa:","lv":"katalogs izteiksmei","nl":"catalogus van expressie","no":"katalog over uttrykk","vi":"mục lục của (biểu hiện)"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يستخدم كأساس لفهرس؛ أي حصر كامل لمفردات مرتبة ترتيبا منهجيا.","ca":"Expressió d’una obra que s’usa com la base d’un catàleg, és a dir, una enumeració completa d’ítems arranjats sistemàticament.","da":"Udtryk af et værk, som anvendes som grundlag for et katalog, dvs. en komplet fortegnelse over eksemplarer, som er arrangeret systematisk.","de":"Expression eines Werks, die als Grundlage für einen Katalog, das heißt eine vollständige Aufzählung von systematisch angeordneten Elementen, verwendet wird.","el":"Μια έκφραση ενός έργου το οποίο χρησιμοποιείται ως η βάση για έναν κατάλογο, μια πλήρη δηλαδή απαρίθμηση των αντιτύπων που οργανώνονται συστηματικά.","en":"An expression of a work that is used as the basis for a catalogue, i.e., a complete enumeration of items arranged systematically. (Deprecated)","es":"Una expresión de una obra utilizada como base para un catálogo, i.e., una enumeración completa de ítems ordenados sistemáticamente.","et":"Teose väljendus, mis on aluseks kataloogile, s.t süstematiseeritud sissekannete terviklikule loetelule.","fi":"Teoksen ekspressio, jota on käytetty luettelon eli systemaattisesti järjestetyn kohteiden täydellisen listauksen perustana.","fr":"Expression d’une œuvre qui sert de base à un catalogue, c’est-à-dire une énumération complète d’items classés systématiquement.","hu":"Egy mű kifejezési formája, amelyet egy katalógusnak, azaz szisztematikusan elrendezett példányok teljes felsorolásának az alapjaként használnak.","lv":"Darba izteiksme, kas izmantota par pamatu katalogam, t.i., sistemātiski sakārtotu vienību pilnīgam uzskaitījumam.","nl":"Een expressie van een werk dat is gebruikt als de basis voor een catalogus, in feite een complete opsomming van systematisch geordende items.","no":"Et uttrykk av et verk brukt som utgangspunkt for en katalog, dvs. en fullstendig og systematisk ordnet liste over eksemplarer.","vi":"Biểu hiện của tác phẩm được sử dụng như là cơ sở cho mục lục, nghĩa là, liệt kê hoàn chỉnh các hạng mục được sắp đặt một cách hệ thống."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentationOfExpression.en", "label":"is augmentation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/catalogueOfExpression.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20180", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/catalogueOfExpression.en", "label":"is catalogue of expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20180", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/catalogueOfExpression.en", "label":"is catalogue of expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20153","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يعدل تعبيرة عمل آخر لغرض، أو استخدام، أو وسيلة أخرى غير ما كان معنيًّا في الأصل."],"ca":["Relaciona una expressió amb una expressió d’una obra que modifica una expressió d’una altra obra per a un objectiu, un ús o un suport diferent d’aquell per al qual es va concebre originalment."],"cs":["Vztahuje vyjádření k vyjádření díla, které modifikuje vyjádření jiného díla pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno."],"da":["Relaterer et udtryk til et udtryk af et værk, som tilpasser et udtryk af et andet værk til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die eine Expression eines anderen Werks für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet, als den/die/das, wofür sie ursprünglich konzipiert war.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die eine Expression eines anderen Werks für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet, als den/die/das, wofür sie ursprünglich konzipiert war."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου βασισμένου στην έκφραση-πηγή."],"en":["Relates an expression to an expression of a work that modifies an expression of another work for a purpose, use, or medium other than that for which it was originally intended."],"es":["Relaciona una expresión con una expresión de una obra que modifica una expresión de otra obra para un propósito, uso o medio distinto a aquel para el que fue destinada originalmente."],"et":["Seostab väljenduse teose väljendusega, mis muudab teise teose väljendust algupärasest erineva otstarbe, kasutamise või meediumi jaoks."],"fi":["Liittää ekspression teoksen ekspressioon, joka muokkaa toisen teoksen ekspressiota jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten."],"fr":["Met une expression en relation avec une expression d’une œuvre qui modifie une expression d’une autre œuvre pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy másik mű kifejezési formáját olyan célra, használatra vagy médiumra módosítja, amely eltér az eredetileg tervezettől."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kurā mainīts pamatizteiksmes nolūks, lietojums vai medijs."],"nl":["Relateert een expressie aan een expressie van een werk dat een expressie van een ander werk aangepast voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was."],"no":["Relaterer et uttrykk til et uttrykk av et verk som bearbeider et kildeuttrykk til et annet formål, bruksområde eller medium enn det opprinnelig var ment for."],"tr":["Bir anlatımı, başlangıçta amaçlanandan farklı bir amaç, kullanım veya ortam için başka bir eserin anlatımını değiştiren bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm sửa chữa biểu hiện nguồn theo mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc"],"zh-Hans-CN":["将一种内容表达与以不同于起初意图的目的、使用或媒介修改另一种作品的一种内容表达的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالج كتعبيرة","ca":"adaptat com a expressió","cs":"adaptováno jako vyjádření","da":"bearbejdet til udtryk","de":"Bearbeitet als (Expression)","de":"Bearbeitet als (Expression)","el":"προσαρμοσμένη ως (έκφραση)","en":"adapted as expression","es":"adaptado como expresión","et":"adapteeritud väljendusena","fi":"mukaelma (ekspressio)","fr":"adapté comme une expression","hu":"kifejezési formaként való feldolgozása a következő:","lv":"adaptēts kā izteiksme","nl":"bewerkt als expressie","no":"bearbeidet som uttrykk","tr":"Anlatım olarak uyarlanan","vi":"được phỏng theo như là (biểu hiện)","zh-Hans-CN":"被改编为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يعدل تعبيرة عمل آخر لغرض، أو استخدام، أو وسيلة أخرى غير ما كان معنيًّا في الأصل.","ca":"Expressió d’una obra que modifica una expressió d’una altra obra per a un objectiu, un ús o un suport diferent d’aquell per al qual es va concebre originalment.","cs":"Vyjádření díla, které modifikuje vyjádření jiného díla pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno.","da":"Udtryk af et værk, som tilpasser et udtryk af et andet værk til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til.","de":"Eine Expression eines Werks, die eine Expression eines anderen Werks für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet, als den/die/das, wofür sie ursprünglich konzipiert war.","de":"Eine Expression eines Werks, die eine Expression eines anderen Werks für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet, als den/die/das, wofür sie ursprünglich konzipiert war.","el":"Μια έκφραση ενός έργου το οποίο τροποποιεί μιε έκφραση-πηγή για έναν σκοπό, μια χρήση ή ένα μέσο άλλο από εκείνο για το οποίο προοριζόταν αρχικά το έργο.","en":"An expression of a work that modifies an expression of another work for a purpose, use, or medium other than that for which it was originally intended.","es":"Una expresión de una obra que modifica una expresión de otra obra para un propósito, uso o medio distinto a aquel para el que fue destinada originalmente.","et":"Teose väljendus, mis muudab teise teose väljendust algupärasest erineva otstarbe, kasutamise või meediumi jaoks.","fi":"Teoksen ekspressio, joka muokkaa toisen teoksen ekspressiota jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten.","fr":"Expression d’une œuvre qui modifie une expression d’une autre œuvre pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine.","hu":"Egy mű kifejezési formája, amelyet olyan célra, használatra vagy médiumra módosítottak, amely eltér az eredetileg tervezettől.","lv":"Darba izteiksme, kurā mainīts pamatizteiksmes nolūks, lietojums vai medijs.","nl":"Een expressie van een werk dat een expressie van een ander werk aangepast voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was.","no":"Et uttrykk av et verk som bearbeider et kildeuttrykk til et annet formål, bruksområde eller medium enn det opprinnelig var ment for.","tr":"Başka bir eserin anlatımını, başlangıçta amaçlanandan farklı bir amaç, kullanım veya ortam için değiştiren bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm sửa chữa biểu hiện nguồn theo mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc","zh-Hans-CN":"以不同于起初意图的目的、使用或媒介修改另一种作品的一种内容表达的一种作品的一种内容表达"},"label":{"ar":"هي معالجة كتعبيرة","ca":"és adaptat com a expressió","cs":"je adaptováno jako vyjádření","da":"er bearbejdet til udtryk","de":"ist bearbeitet als (Expression)","de":"ist bearbeitet als (Expression)","el":"είναι προσαρμοσμένη ως (έκφραση)","en":"is adapted as expression","es":"se adapta como expresión","et":"adapteeritud väljendusena","fi":"mukaelma (ekspressio)","fr":"est adapté comme une expression","hu":"kifejezési formára feldolgozva:","lv":"ir adaptēts kā izteiksme","nl":"is bewerkt als expressie","no":"er bearbeidet som uttrykk","tr":"anlatım olarak uyarlanmıştır","vi":"được phỏng theo như là (biểu hiện)","zh-Hans-CN":"被改编为内容表达"},"note":{"fi":["Kattaa sekä teoksen muotoon kohdistuvat muutokset että samassa muodossa kokonaan uudelleenmuokatut teokset."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20073", "lexicalAlias":"http://rdaregistry.info/Elements/e/dramatizedAsExpression.en", "label":"is dramatized as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20009", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsMotionPictureExpression.en", "label":"is adapted as motion picture expression"},{"@id":"http://rdaregistry.info/Elements/e/P20255", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsGraphicNovelExpression.en", "label":"is adapted as graphic novel expression"},{"@id":"http://rdaregistry.info/Elements/e/P20096", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsScreenplayExpression.en", "label":"is adapted as screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/P20077", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedInVerseAsExpression.en", "label":"is adapted in verse as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20092", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsChoreographyExpression.en", "label":"is adapted as choreography expression"},{"@id":"http://rdaregistry.info/Elements/e/P20099", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsRadioScriptExpression.en", "label":"is adapted as radio script expression"},{"@id":"http://rdaregistry.info/Elements/e/P20088", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsNovelExpression.en", "label":"is adapted as novel expression"},{"@id":"http://rdaregistry.info/Elements/e/P20110", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsLibrettoExpression.en", "label":"is adapted as libretto expression"},{"@id":"http://rdaregistry.info/Elements/e/P20242", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsOperaExpression.en", "label":"is adapted as opera expression"},{"@id":"http://rdaregistry.info/Elements/e/P20282", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsOratorioExpression.en", "label":"is adapted as oratorio expression"},{"@id":"http://rdaregistry.info/Elements/e/P20060", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsRadioProgramExpression.en", "label":"is adapted as radio program expression"},{"@id":"http://rdaregistry.info/Elements/e/P20066", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsTelevisionProgramExpression.en", "label":"is adapted as television program expression"},{"@id":"http://rdaregistry.info/Elements/e/P20067", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsVideoExpression.en", "label":"is adapted as video expression"},{"@id":"http://rdaregistry.info/Elements/e/P20241", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsMusicalTheatreExpression.en", "label":"is adapted as musical theatre expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsExpression.en", "label":"is adapted as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsExpression.en", "label":"is adapted as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20143","label":{"ar":"هي مستوعبة بتعبيرة","ca":"és absorbit per una expressió","cs":"je absorbováno vyjádřením","da":"er indlemmet af udtryk","de":"ist aufgegangen in (Expression)","de":"ist aufgegangen in (Expression)","el":"απορροφήθηκε από (έκφραση)","en":"is absorbed by expression","es":"es absorbido por la expresión","et":"sulandunud väljendusega","fi":"sulautunut ekspressioon","fr":"est absorbé par une expression","hu":"beolvasztja a következő kifejezési forma:","lv":"ir iekļaujošā izteiksme","nl":"is opgenomen door expressie","no":"er innlemmet i uttrykk","tr":"anlatım tarafından kapsanmıştır","vi":"được hấp thụ bởi (biểu hiện)","zh-Hans-CN":"被内容表达吸收"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يكون محتواه مدمجًا في محتوى تعبيرة عمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra el contingut de la qual incorpora el contingut d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, jehož obsah zahrnuje obsah vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, hvis indhold inkorporerer indholdet af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt durch den Inhalt einer Expression eines anderen Werks erweitert wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, deren Inhalt durch den Inhalt einer Expression eines anderen Werks erweitert wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο ενσωματώνει μια άλλη έκφραση."],"en":["Relates an expression to an expression of a work whose content incorporates the content of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra cuyo contenido incorpora el contenido de una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mille sisu haarab endasse teise teose väljenduse sisu."],"fi":["Liittää ekspression teoksen ekspressioon, jonka sisältöön toisen teoksen ekspression sisältö on yhdistynyt."],"fr":["Met une expression en relation avec une expression d’une œuvre dont le contenu intègre le contenu d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelynek tartama egy másik mű kifejezési formájának tar