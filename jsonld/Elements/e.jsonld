                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/formatOfNotatedMusic.en","instructionNumber":"7.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20209", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/formatOfNotatedMusic.en", "label":"has format of notated music"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20209", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/formatOfNotatedMusic.en", "label":"has format of notated music"}]},{"@id":"http://rdaregistry.info/Elements/e/P20272","definition":{"ar":["تربط بين تعبيرة وعمل عبارة عن تقييم نقدي لتعبيرة."],"ca":["Relaciona una expressió amb una obra que és una avaluació crítica d’una expressió."],"cs":["Vztahuje vyjádření k dílu, které je kritickým hodnocením vyjádření."],"da":["Relaterer et udtryk til et værk, som er en kritisk vurdering af et udtryk."],"de":["Setzt eine Expression in Beziehung zu einem Werk, bei dem es sich um eine kritische Untersuchung einer Expression handelt.,Setzt eine Expression in Beziehung zu einem Werk, bei dem es sich um eine kritische Untersuchung einer Expression handelt."],"el":["Συνδέει μια έκφραση με ένα έργο το οποίο περιέχει μια κριτική αξιολόγηση μιας περιγραφόμενης έκφρασης."],"en":["Relates an expression to a work that is a critical evaluation of an expression."],"es":["Relaciona una expresión con una obra que es una evaluación crítica de una expresión."],"et":["Seostab väljenduse teosega, mis sisaldab kriitilist hinnangut väljendusele."],"fi":["Liittää ekspression teokseen, joka on ekspression kriittinen arviointi."],"fr":["Met une expression en relation avec une œuvre qui consiste en une évaluation critique d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy műhöz, amely egy kifejezési forma kritikai értékelése."],"lv":["Sasaista izteiksmi ar darbu, kas satur aprakstītās izteiksmes kritisku novērtējumu."],"nl":["Relateert een expressie aan een werk dat is een kritische evaluatie van een expressie."],"no":["Relaterer et uttrykk til et verk som inneholder en kritisk evaluering av et uttrykk."],"tr":["Bir anlatımı, bir anlatımın eleştirel bir değerlendirmesi olan bir eserle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tác phẩm có chứa đánh giá phê bình về biểu hiện được mô tả."],"zh-Hans-CN":["将一种内容表达与作为一种内容表达之批评性评价的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة منتقدة في","ca":"expressió criticada per","cs":"vyjádření kritizované v","da":"udtryk kritiseret i","de":"Kritik einer Expression in","de":"Kritik einer Expression in","el":"κρίνεται στην (έκφραση)","en":"expression critiqued by","es":"expresión criticada por","et":"väljenduse arvustus","fi":"ekspression kritiikki","fr":"expression critiquée par","hu":"kifejezési forma bírálva a következőben:","lv":"izteiksmes kritika","nl":"expressie bekritiseerd door","no":"uttrykk kritisert i","tr":"tarafından eleştirilen anlatım","vi":"được phê bình trong (biểu hiện)","zh-Hans-CN":"被……批评的内容表达"},"ToolkitDefinition":{"ar":"عمل عبارة عن تقييم نقدي لتعبيرة.","ca":"Obra que és una avaluació crítica d’una expressió.","cs":"Dílo, které je kritickým hodnocením vyjádření.","da":"Værk, som er en kritisk vurdering af et udtryk.","de":"Ein Werk, bei dem es sich um eine kritische Untersuchung einer Expression handelt.","de":"Ein Werk, bei dem es sich um eine kritische Untersuchung einer Expression handelt.","el":"Ένα έργο το οποίο περιέχει μια κριτική αξιολόγηση μιας περιγραφόμενης έκφρασης.","en":"A work that is a critical evaluation of an expression.","es":"Una obra que es una evaluación crítica de una expresión.","et":"Teos, mis sisaldab kriitilist hinnangut väljendusele.","fi":"Teos, joka on ekspression kriittinen arviointi.","fr":"Œuvre qui consiste en une évaluation critique d’une expression.","hu":"Egy mű, amely egy kifejezési forma kritikai értékelése.","lv":"Darbs, kas satur aprakstītās izteiksmes kritisku novērtējumu.","nl":"Een werk dat is een kritische evaluatie van een expressie.","no":"Et verk som inneholder en kritisk evaluering av et uttrykk.","tr":"Bir anlatımın eleştirel bir değerlendirmesi olan bir eser.","vi":"Tác phẩm có chứa đánh giá phê bình về biểu hiện được mô tả.","zh-Hans-CN":"作为一种内容表达之批评性评价的一种作品"},"label":{"ar":"هي تعبيرة منتقدة في","ca":"és expressió criticada per","cs":"je vyjádřením kritizovaným (čím)","da":"er udtryk kritiseret i","de":"ist Kritik einer Expression in","de":"ist Kritik einer Expression in","el":"κρίνεται στην (έκφραση)","en":"is expression critiqued by","es":"es expresión criticada por","et":"väljenduse arvustus","fi":"ekspression kritiikki","fr":"est une expression critiquée par","hu":"kifejezési forma bírálva a következőben:","lv":"ir izteiksmes kritika","nl":"is expressie bekritiseerd door","no":"er uttrykk kritisert i","tr":"tarafından eleştirilmiş anlatımdır","vi":"được phê bình trong (biểu hiện)","zh-Hans-CN":"是被……批评的内容表达"},"altLabel":{"ar":["منتقدة في (تعبيرة)"],"ca":["criticat en (expressió)"],"cs":["kritizováno v (vyjádření)"],"da":["kritiseret i udtryk"],"de":["Kritik von (Expression),Kritik von (Expression)"],"en":["critiqued in (expression)"],"es":["criticado en (expresión)"],"fi":["kritisoitu teoksessa (ekspressio)"],"fr":["critiqué dans (expression),expression critiquée dans"],"hu":["bírálva a következőben (kifejezési forma):"],"nl":["bekritiseerd in (expressie)"],"no":["kritikk i (uttrykk)"],"tr":["(anlatım) içinde eleştirilen"],"zh-Hans-CN":["被批评于（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
