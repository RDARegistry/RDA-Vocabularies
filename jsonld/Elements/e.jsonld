                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20425", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCollectiveAgentToPerformance.en", "label":"has contributor collective agent to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20294", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerAgent.en", "label":"has music programmer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20480", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerCorporateBody.en", "label":"has music programmer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20539", "lexicalAlias":"http://rdaregistry.info/Elements/e/musicProgrammerFamily.en", "label":"has music programmer family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20421", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/musicProgrammerCollectiveAgent.en", "label":"has music programmer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20421", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/musicProgrammerCollectiveAgent.en", "label":"has music programmer collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20480","label":{"ar":"لها هيئة مبرمجة موسيقية","ca":"té com a entitat corporativa programadora de música","cs":"má hudebního programátora (korporaci)","da":"har korporation, som er musikprogrammør","de":"hat Musik-Programmiererin/Musik-Programmierer (Körperschaft)","de":"hat Musik-Programmiererin/Musik-Programmierer (Körperschaft)","en":"has music programmer corporate body","es":"tiene organismo corporativo programador musical","et":"muusikaprogrammeerija (asutus)","fi":"musiikkiohjelmoija (yhteisö)","fr":"a pour collectivité programmeuse musicale","hu":"zeneprogramozó testülete a következő:","lv":"mūzikas programmētājs (institūcija)","nl":"heeft muziekprogrammeur-corporatie","no":"har musikkprogrammerer (korporasjon)","tr":"müzik programcısı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有音乐编程者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تساهم في تعبيرة لعمل موسيقي باستخدام أجهزة الصوت الإلكترونية أو برمجيات الحاسب لتوليد أصوات."],"ca":["Relaciona una expressió amb una entitat corporativa que contribueix a una expressió d’una obra musical usant mecanismes electrònics àudio o programari d’ordinador per generar sons."],"cs":["Vztahuje vyjádření ke korporaci, která přispívá k vyjádření hudebního díla tím, že používá elektronická zvuková zařízení nebo počítačový software k vytváření zvuků."],"da":["Relaterer et udtryk til en korporation, som bidrager til et udtryk af et musikværk ved at bruge elektronisk lydudstyr eller computersoftware til at generere lyd."],"de":["Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression eines Musikwerks beiträgt, indem sie durch das Einsetzen elektronischer Audio-Geräte oder von Computerprogrammen Klangeffekte erzeugt.,Setzt eine Expression in Beziehung zu einer Körperschaft, die zu einer Expression eines Musikwerks beiträgt, indem sie durch das Einsetzen elektronischer Audio-Geräte oder von Computerprogrammen Klangeffekte erzeugt."],"en":["Relates an expression to a corporate body who contributes to an expression of a musical work by using electronic audio devices or computer software to generate sounds."],"es":["Relaciona una expresión con un organismo corporativo que contribuye a una expresión de una obra musical al utilizar dispositivos electrónicos de audio o software de computadora para generar sonidos."],"et":["Seostab väljenduse asutusega, kes annab panuse muusikateose väljendusse, tekitades helisid elektrooniliste audioseadmete või arvutitarkvara abil."],"fi":["Liittää ekspression yhteisöön, joka osallistuu musiikkiteoksen ekspression tekemiseen tuottamalla ääniä sähköisillä äänilaitteilla tai tietokoneohjelmilla."],"fr":["Met une expression en relation avec une collectivité qui contribue à une expression d’une œuvre musicale en utilisant des appareils audio électroniques ou un logiciel pour générer des sons."],"hu":["Hozzákapcsol egy kifejezési formát egy testülethez, amely egy zenemű kifejezési formájához hozzájárul azzal, hogy hangok előállítására elektronikus audiókészülékeket és/vagy számítógépes szoftvert használ."],"lv":["Sasaista izteiksmi ar institūciju, kas sniegusi ieguldījumu mūzikas darba izteiksmē, izmantojot elektroniskas audioierīces un/vai datora programmatūru, lai radītu skaņu."],"nl":["Relateert een expressie aan een corporatie die bijdraagt aan een expressie van een muziekwerk door het gebruiken van elektronische geluidsapparatuur of computersoftware om geluiden te genereren."],"no":["Relaterer et uttrykk til en korporasjon som bidrar til et uttrykk av et musikalsk verk ved å bruke elektroniske lydenheter eller programvare til å lage lyder."],"tr":["Bir anlatımı, ses üretmek için elektronik ses cihazları veya bilgisayar yazılımı kullanarak bir müzik eserinin anlatımına katkıda bulunan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过使用电子音频设备或计算机软件产生声音而对一种音乐作品的一种内容表达作出贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مبرمجة موسيقية","ca":"entitat corporativa programadora de música","cs":"hudební programátor (korporace)","da":"korporation, som er musikprogrammør","de":"Musik-Programmiererin/Musik-Programmierer (Körperschaft)","de":"Musik-Programmiererin/Musik-Programmierer (Körperschaft)","en":"music programmer corporate body","es":"organismo corporativo programador musical","et":"muusikaprogrammeerija (asutus)","fi":"musiikkiohjelmoija (yhteisö)","fr":"collectivité programmeuse musicale","hu":"zeneprogramozó testület:","lv":"mūzikas programmētājs (institūcija)","nl":"muziekprogrammeur-corporatie","no":"musikkprogrammerer (korporasjon)","tr":"müzik programcı tüzel kişi","zh-Hans-CN":"音乐编程者团体"},"ToolkitDefinition":{"ar":"هيئة تساهم في تعبيرة لعمل موسيقي باستخدام أجهزة الصوت الإلكترونية أو برمجيات الحاسب لتوليد أصوات.","ca":"Entitat corporativa que contribueix a una expressió d’una obra musical usant mecanismes electrònics àudio o programari d’ordinador per generar sons.","cs":"Korporace, která přispívá k vyjádření hudebního díla tím, že používá elektronická zvuková zařízení nebo počítačový software k vytváření zvuků.","da":"Korporation, som bidrager til et udtryk af et musikværk ved at bruge elektronisk lydudstyr eller computersoftware til at generere lyd.","de":"Eine Körperschaft, die zu einer Expression eines Musikwerks beiträgt, indem sie durch das Einsetzen elektronischer Audio-Geräte oder von Computerprogrammen Klangeffekte erzeugt.","de":"Eine Körperschaft, die zu einer Expression eines Musikwerks beiträgt, indem sie durch das Einsetzen elektronischer Audio-Geräte oder von Computerprogrammen Klangeffekte erzeugt.","en":"A corporate body who contributes to an expression of a musical work by using electronic audio devices or computer software to generate sounds.","es":"Un organismo corporativo que contribuye a una expresión de una obra musical al utilizar dispositivos electrónicos de audio o software de computadora para generar sonidos.","et":"Asutus, kes annab panuse muusikateose väljendusse, tekitades helisid elektrooniliste audioseadmete või arvutitarkvara abil.","fi":"Yhteisö, joka osallistuu musiikkiteoksen ekspression tekemiseen tuottamalla ääniä sähköisillä äänilaitteilla tai tietokoneohjelmilla.","fr":"Collectivité qui contribue à une expression d’une œuvre musicale en utilisant des appareils audio électroniques ou un logiciel pour générer des sons.","hu":"Egy testület, amely egy zenemű kifejezési formájához hozzájárul azzal, hogy hangok előállítására elektronikus audiókészülékeket és/vagy számítógépes szoftvert használ.","lv":"Institūcija, kas sniegusi ieguldījumu mūzikas darba izteiksmē, izmantojot elektroniskas audioierīces un/vai datora programmatūru, lai radītu skaņu.","nl":"Een corporatie die bijdraagt aan een expressie van een muziekwerk door het gebruiken van elektronische geluidsapparatuur of computersoftware om geluiden te genereren.","no":"En korporasjon som bidrar til et uttrykk av et musikalsk verk ved å bruke elektroniske lydenheter eller programvare til å lage lyder.","tr":"Elektronik ses cihazları veya bilgisayar yazılımı kullanarak sesler üreterek bir müzik eserinin ifadesine katkıda bulunan bir tüzel kişi.","zh-Hans-CN":"通过使用电子音频设备或计算机软件产生声音而对一种音乐作品的一种内容表达作出贡献的一个团体"},"note":{"ar":["يُستبعد إنشاء عمل موسيقي جديد."],"ca":["S’exclou la creació d’una obra musical nova."],"cs":["Vytvoření nového hudebního díla je vyloučeno."],"da":["Skabelse af et nyt musikværk er ikke omfattet."],"de":["Darunter fällt nicht das Schaffen eines neuen Musikwerks.,Darunter fällt nicht das Schaffen eines neuen Musikwerks."],"en":["The creation of a new musical work is excluded."],"es":["La creación de una nueva obra musical se excluye."],"et":["Ei hõlma uue muusikateose loomist."],"fi":["Ei koske uuden musiikkiteoksen luomista."],"fr":["La création d’une nouvelle œuvre musicale est exclue."],"hu":["Egy új zenemű létrehozása nem tartozik ide."],"lv":["Neietver jauna mūzikas darba radīšanu."],"nl":["De creatie van een nieuw muziekwerk is uitgesloten."],"no":["Det å skape et nytt musikalsk verk er ikke inkludert."],"tr":["Yeni bir müzik eserinin oluşturulması hariçtir."],"zh-Hans-CN":["不包括新音乐作品的创作。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
