                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/makeupArtistFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20543", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorFamilyToPerformance.en", "label":"has contributor family to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20400", "lexicalAlias":"http://rdaregistry.info/Elements/e/makeupArtistCollectiveAgent.en", "label":"has makeup artist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20518", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/makeupArtistFamily.en", "label":"has makeup artist family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20518", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/makeupArtistFamily.en", "label":"has makeup artist family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20341","label":{"ar":"لها شخص فنان مكياج","ca":"té com a persona maquilladora","cs":"má maskéra (osobu)","da":"har person, som er sminkør","de":"hat Maskenbildnerin/Maskenbildner (Person)","de":"hat Maskenbildnerin/Maskenbildner (Person)","en":"has makeup artist person","es":"tiene persona maquilladora","et":"grimmikunstnik (isik)","fi":"maskeeraaja (henkilö)","fr":"a pour personne maquilleuse","hu":"sminkmester személye a következő:","lv":"grima mākslinieks (persona)","nl":"heeft make-upartiest-persoon","no":"har sminkør (person)","tr":"makyaj sanatçısı kişisi ile ilişkilidir","zh-Hans-CN":"有化妆艺术家个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة من خلال وضع مكياج وأطراف صناعية لإنتاج فيلم أو في عرض موسيقي أو درامي أو ترفيهي."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió aplicant maquillatge i pròtesis en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že aplikuje make-up a protetiku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at lægge makeup og påsætte proteser til en levende billedproduktion eller til en musikalsk eller dramatisk præsentation eller i underholdning."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie Schminke und Prothetik für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung aufträgt.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie Schminke und Prothetik für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung aufträgt."],"en":["Relates an expression to a person who contributes to an expression by applying makeup and prosthetics for a moving image production or for a musical or dramatic presentation or entertainment."],"es":["Relaciona una expresión con una persona que contribuye a una expresión aplicando maquillaje y prótesis para una producción de imágenes en movimiento o para una presentación musical o dramática, o entretenimiento."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, tehes grimmi ja proteesgrimmi filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen vastaamalla elokuvan, musikaalin tai näyttämöteoksen maskeerauksesta."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en appliquant du maquillage et des prothèses pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki hozzájárul egy kifejezési formához azzal, hogy makeupot és protéziseket alkalmaz egy mozgókép-produkcióhoz, zenei vagy drámai bemutatóhoz, vagy szórakoztató műsorhoz."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, izmantojot dekoratīvo kosmētiku un protezēšanu (filmu veidošanā, mūzikas vai dramatiskā uzvedumā vai izklaides pasākumā)."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het aanbrengen van make-up en protheses voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å bruke sminke og proteser for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning."],"tr":["Bir anlatımı, hareketli bir görüntü yapımı veya müzikal ya da dramatik bir sunum veya eğlence için makyaj ve protez uygulayarak bir anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过为动态图像制作或者为音乐或戏剧呈现或娱乐施加化妆品或假体而对一种内容表达作出贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص فنان مكياج","ca":"persona maquilladora","cs":"maskér (osoba)","da":"person, som er sminkør","de":"Maskenbildnerin/Maskenbildner (Person)","de":"Maskenbildnerin/Maskenbildner (Person)","en":"makeup artist person","es":"persona maquilladora","et":"grimmikunstnik (isik)","fi":"maskeeraaja (henkilö)","fr":"personne maquilleuse","hu":"sminkmester személy:","lv":"grima mākslinieks (persona)","nl":"make-upartiest-persoon","no":"sminkør (person)","tr":"makyaj sanatçısı olan kişi","zh-Hans-CN":"化妆艺术家个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة من خلال وضع مكياج أو أطراف صناعية لإنتاج فيلم، أو لعرض موسيقي، أو درامي، أو ترفيهي.","ca":"Persona que contribueix a una expressió aplicant maquillatge i pròtesis en el cas d’una producció d’imatge en moviment o una representació o un espectacle musical o dramàtic.","cs":"Osoba, která přispívá k vyjádření tím, že aplikuje make-up a protetiku při výrobě pohyblivého obrazu nebo hudebního nebo dramatického vystoupení nebo zábavného programu.","da":"Person, som bidrager til et udtryk ved at lægge makeup og påsætte proteser til en levende billedproduktion eller til en musikalsk eller dramatisk præsentation eller i underholdning.","de":"Eine Person, die zu einer Expression beiträgt, indem sie Schminke und Prothetik für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung aufträgt.","de":"Eine Person, die zu einer Expression beiträgt, indem sie Schminke und Prothetik für eine Bewegtbildproduktion oder eine musikalische oder dramatische Darbietung oder Aufführung aufträgt.","en":"A person who contributes to an expression by applying makeup and prosthetics for a moving image production or for a musical or dramatic presentation or entertainment.","es":"Una persona que contribuye a una expresión aplicando maquillaje y prótesis para una producción de imágenes en movimiento o para una presentación musical o dramática, o entretenimiento.","et":"Isik, kes annab panuse väljendusse, tehes grimmi ja proteesgrimmi filmi tootmise, muusika- või draamaetenduse või meelelahutusürituse jaoks.","fi":"Henkilö, joka osallistuu ekspression tekemiseen vastaamalla elokuvan, musikaalin tai näyttämöteoksen maskeerauksesta.","fr":"Personne qui contribue à une expression en appliquant du maquillage et des prothèses pour une production d’images animées ou bien pour une présentation ou un spectacle musical ou dramatique.","hu":"Egy személy, aki hozzájárul egy kifejezési formához azzal, hogy makeupot és protéziseket alkalmaz egy mozgókép-produkcióhoz, zenei vagy drámai bemutatóhoz, vagy szórakoztató műsorhoz.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, izmantojot dekoratīvo kosmētiku un protezēšanu (filmu veidošanā, mūzikas vai dramatiskā uzvedumā vai izklaides pasākumā).","nl":"Een persoon die bijdraagt aan een expressie door het aanbrengen van make-up en protheses voor een bewegend beeld-productie of voor een muzikale of dramatische presentatie of vermaak.","no":"En person som bidrar til et uttrykk ved å bruke sminke og proteser for en produksjon med levende bilder eller en musikalsk eller dramatisk forestilling eller form for underholdning.","tr":"Hareketli bir görüntü üretimi, müzikal, dramatik bir sunum veya eğlence amacıyla makyaj ve protez uygulayarak bir anlatıma katkıda bulunan kişi.","zh-Hans-CN":"通过为动态图像制作或者为音乐或戏剧呈现或娱乐施加化妆品或假体而对一种内容表达作出贡献的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/makeupArtistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20284", "lexicalAlias":"http://rdaregistry.info/Elements/e/makeupArtistAgent.en", "label":"has makeup artist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20341", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/makeupArtistPerson.en", "label":"has makeup artist person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20341", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/makeupArtistPerson.en", "label":"has makeup artist person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20324","label":{"ar":"لها وسيط أداء لمحتوى رقصات","ca":"té com a repartiment d’execució d’un contingut coreogràfic","cs":"má obsazení choreografického obsahu","da":"har besætning for koreografisk indhold","de":"hat Besetzung für choreografischen Inhalt","de":"hat Besetzung für choreografischen Inhalt","en":"has medium of performance of choreographic content","es":"tiene medio de ejecución de contenido coreográfico","et":"koreograafilise sisu esituskoosseis","fi":"koreografisen sisällön esityskokoonpano","fr":"a pour distribution d’exécution d’un contenu chorégraphique","hu":"koreográfiai tartalom előadásmédiuma a következő:","lv":"horeogrāfiskā satura izpildījuma veids","nl":"heeft uitvoeringsmedium van choreografische content","no":"har besetning for koreografisk innhold","tr":"koreografik içeriğin performans ortamı ile ilişkilidir","zh-Hans-CN":"有编舞内容的表演媒介"},"ToolkitLabel":{"ar":"وسيط أداء لمحتوى رقصات","ca":"repartiment d’execució d’un contingut coreogràfic","cs":"obsazení choreografického obsahu","da":"har besætning for koreografisk indhold","de":"Besetzung für choreografischen Inhalt","de":"Besetzung für choreografischen Inhalt","en":"medium of performance of choreographic content","es":"medio de ejecución de contenido coreográfico","et":"koreograafilise sisu esituskoosseis","fi":"koreografisen sisällön esityskokoonpano","fr":"distribution d’exécution d’un contenu chorégraphique","hu":"koreográfiai tartalom előadásmédiuma:","lv":"horeogrāfiskā satura izpildījuma veids","nl":"uitvoeringsmedium van choreografische content","no":"besetning for koreografisk innhold","tr":"koreografik içeriğin performans ortamı","zh-Hans-CN":"编舞内容的表演媒介"},"ToolkitDefinition":{"ar":"نوع من فناني الأداء أو مجموعة من المؤدين الذين يشاركون، أو يعتزمون المشاركة، في أداء محتوى دراما راقصة أو غير موسيقية.","ca":"Tipus d’intèrpret o grup d’intèrprets participant, o concebut per participar, en una representació de contingut coreogràfic o dramàtic no musical.","cs":"Typ účinkujícího nebo skupiny účinkujících, kteří vystupují nebo mají vystupovat v představení s choreografickým nebo nehudebním dramatickým obsahem.","da":"Type udøver eller gruppe af udøvere, som deltager, eller er tiltænkt at deltage, i en forestilling af koreografisk eller ikke-musikalsk dramatisk indhold.","de":"Eine Kategorisierung der Ausführenden/des Ausführenden oder einer Gruppe von Ausführenden, die an einer Darbietung eines choreografischen oder nicht musikalischen, dramatischen Inhalts teilnehmen oder teilnehmen sollen.","de":"Eine Kategorisierung der Ausführenden/des Ausführenden oder einer Gruppe von Ausführenden, die an einer Darbietung eines choreografischen oder nicht musikalischen, dramatischen Inhalts teilnehmen oder teilnehmen sollen.","en":"A type of performer or group of performers participating, or intended to participate, in a performance of choreographic or non-musical dramatic content.","es":"Un tipo de intérprete o grupo de intérpretes que participan, o pretenden participar, en una representación de contenido dramático coreográfico o no musical.","et":"Esitaja või esitajate rühma tüüp, kes osalevad või on mõeldud osalema koreograafilise või mittemuusikalise draamavormis sisu esituses.","fi":"Koreografiseen tai ei-musiikilliseen draamasisältöön osallistuvan tai osallistuvaksi tarkoitetun esittäjän tai esittäjien ryhmän tyyppi.","fr":"Type d’interprète ou de groupe d’interprètes qui participe ou est destiné à participer à une prestation d’un contenu chorégraphique ou dramatique non musical.","hu":"Egy koreográfiai vagy nem zenei drámai tartalom előadásában részt vevő vagy részt venni szándékozó előadói típus vagy előadói csoport.","lv":"Izpildītājs vai izpildītāju grupa, kas piedalās vai kam paredzēts piedalīties horeogrāfiska vai ar mūziku nesaistīta dramatiska satura uzvedumā.","nl":"Een type uitvoerder of groep van uitvoerders deelnemend aan, of bedoeld om deel te nemen aan, een uitvoering van choreografische of niet-muzikale dramatische content.","no":"En type utøver eller gruppe av utøvere som deltar, eller er ment å delta, i en framføring av koreografisk eller ikke-musikalsk dramatisk innhold.","tr":"Koreografik veya müzikal olmayan dramatik içerikli bir performansa katılan veya katılmayı amaçlayan bir tür sanatçı veya sanatçı grubu.","zh-Hans-CN":"在编舞或非音乐戏剧内容的一种表演中参与或计划参与的表演者或表演者群体的类型"},"definition":{"ar":["تربط بين تعبيرة ونوع من فناني الأداء أو مجموعة من المؤدين الذين يشاركون، أو يعتزمون المشاركة، في أداء محتوى دراما راقصة أو غير موسيقية."],"ca":["Relaciona una expressió amb un tipus d’intèrpret o grup d’intèrprets participant, o concebut per participar, en una representació de contingut coreogràfic o dramàtic no musical."],"cs":["Vztahuje vyjádření k typu účinkujícího nebo skupiny účinkujících, kteří vystupují nebo mají vystupovat v představení s choreografickým nebo nehudebním dramatickým obsahem."],"da":["Relaterer et udtryk til en type udøver eller gruppe af udøvere, som deltager, eller er tiltænkt at deltage, i en forestilling af koreografisk eller ikke-musikalsk dramatisk indhold."],"de":["Setzt eine Expression in Beziehung zu einer Kategorisierung der Ausführenden/des Ausführenden oder einer Gruppe von Ausführenden, die an einer Darbietung eines choreografischen oder nicht musikalischen, dramatischen Inhalts teilnehmen oder teilnehmen sollen.,Setzt eine Expression in Beziehung zu einer Kategorisierung der Ausführenden/des Ausführenden oder einer Gruppe von Ausführenden, die an einer Darbietung eines choreografischen oder nicht musikalischen, dramatischen Inhalts teilnehmen oder teilnehmen sollen."],"en":["Relates an expression to a type of performer or group of performers participating, or intended to participate, in a performance of choreographic or non-musical dramatic content."],"es":["Relaciona una expresión con un tipo de intérprete o grupo de intérpretes que participan, o pretenden participar, en una representación de contenido dramático coreográfico o no musical."],"et":["Seostab väljenduse esitaja või esitajate rühma tüübiga, kes osalevad või on mõeldud osalema koreograafilise või mittemuusikalise draamavormis sisu esituses."],"fi":["Liittää ekspression koreografiseen tai ei-musiikilliseen draamasisältöön osallistuvan tai osallistuvaksi tarkoitetun esittäjän tai esittäjien ryhmän tyyppiin."],"fr":["Met une expression en relation avec un type d’interprète ou de groupe d’interprètes qui participe ou est destiné à participer à une prestation d’un contenu chorégraphique ou dramatique non musical."],"hu":["Hozzákapcsol egy kifejezési formát egy koreográfiai vagy nem zenei drámai tartalom előadásában részt vevő vagy részt venni szándékozó előadói típushoz vagy előadói csoporthoz."],"lv":["Sasaista izteiksmi ar izpildītāju vai izpildītāju grupu, kas piedalās vai kam paredzēts piedalīties horeogrāfiska vai ar mūziku nesaistīta dramatiska satura uzvedumā."],"nl":["Relateert een expressie aan een type uitvoerder of groep van uitvoerders deelnemend aan, of bedoeld om deel te nemen aan, een uitvoering van choreografische of niet-muzikale dramatische content."],"no":["Relaterer et uttrykk til en type utøver eller gruppe av utøvere som deltar, eller er ment å delta, i en framføring av koreografisk eller ikke-musikalsk dramatisk innhold."],"tr":["Bir anlatımı, koreografik veya müzikal olmayan dramatik içeriğinin bir performansına katılan veya katılmayı amaçlayan bir sanatçı türü veya sanatçı grubuyla ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与在编舞或非音乐戏剧内容的一种表演中参与或计划参与的表演者或表演者群体的类型关联起来。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/mediumOfPerformanceOfChoreographicContent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20324", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/mediumOfPerformanceOfChoreographicContent.en", "label":"has medium of performance of choreographic content"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20324", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/mediumOfPerformanceOfChoreographicContent.en", "label":"has medium of performance of choreographic content"}]},{"@id":"http://rdaregistry.info/Elements/e/P20071","label":{"ar":"لها تبصرة عن تعبيرة","ca":"té com a nota sobre una expressió","cs":"má poznámku o vyjádření","da":"har note om udtryk","de":"hat Anmerkung zur Expression","de":"hat Anmerkung zur Expression","el":"έχει σημείωση στην έκφραση","en":"has note on expression","es":"tiene nota sobre la expresión","et":"märkus väljenduse kohta","fi":"huomautus ekspressiosta","fr":"a pour note sur une expression","hu":"kifejezési formára vonatkozó megjegyzése a következő:","lv":"piezīme par izteiksmi","nl":"heeft noot bij expressie","no":"har note om uttrykk","tr":"anlatım hakkında not ile ilişkilidir","vi":"có ghi chú về biểu hiện","zh-Hans-CN":"有关于内容表达的附注"},"definition":{"ar":["تربط بين تعبيرة ووصف عام غير محدد لسمة واحدة أو أكثر من سمات تعبيرة."],"ca":["Relaciona una expressió amb una descripció no estructurada àmplia d’un o més atributs d’una expressió."],"cs":["Vztahuje vyjádření k obecnému nestrukturovanému popisu jednoho nebo více atributů vyjádření."],"da":["Relaterer et udtryk til en bred, ustruktureret beskrivelse af en eller flere af et udtryks attributter."],"de":["Setzt eine Expression in Beziehung zu einer umfassenden, unstrukturierten Beschreibung eines Merkmals oder mehrerer Merkmale einer Expression.,Setzt eine Entität in Beziehung zu einer umfassenden, unstrukturierten Beschreibung eines Merkmals oder mehrerer Merkmale einer Entität."],"el":["Συνδέει μια έκφραση με μια σημείωση που παρέχει πρόσθετες πληροφορίες σχετικά με περιεχόμενο καταχωρισμένο ως ιδιότητα μιας έκφρασης."],"en":["Relates an expression to a broad unstructured description of one or more attributes of an expression."],"es":["Relaciona una expresión con una descripción amplia y no estructurada de uno o más atributos de una expresión."],"et":["Seostab väljenduse üldise struktureerimata kirjeldusega, mis iseloomustab üht või mitut väljenduse omadust."],"fi":["Liittää ekspression ekspression yhden tai useamman attribuutin yleisluonteiseen rakenteistamattomaan kuvailuun."],"fr":["Met une expression en relation avec une description non structurée générale d’un ou plusieurs attributs d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma egy vagy több ismérvének átfogó strukturálatlan leírásához."],"lv":["Sasaista izteiksmi ar plašu nestrukturētu izteiksmes viena vai vairāku atribūtu aprakstu."],"nl":["Relateert een expressie aan een algemene ongestructureerde beschrijving van één of meer attributen van een expressie."],"no":["Relaterer et uttrykk til en bred ustrukturert beskrivelse av ett eller flere attributter til et uttrykk."],"tr":["Bir anlatımı, bir anlatımın bir veya daha fazla özelliğinin yapılandırılmamış geniş bir tanımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với ghi chú cung cấp thông tin phụ trợ về nội dung được ghi như là thuộc tính biểu hiện."],"zh-Hans-CN":["将一种内容表达与关于一种内容表达的一个或多个属性的宽泛的非结构化描述关联起来。"]},"ToolkitLabel":{"ar":"تبصرة عن تعبيرة","ca":"nota sobre una expressió","cs":"poznámka o vyjádření","da":"note om udtryk","de":"Anmerkung zur Expression","de":"Anmerkung zur Expression","el":"σημείωση στην έκφραση","en":"note on expression","es":"nota sobre la expresión","et":"märkus väljenduse kohta","fi":"huomautus ekspressiosta","fr":"note sur une expression","hu":"kifejezési formára vonatkozó megjegyzése:","lv":"piezīme par izteiksmi","nl":"noot bij expressie","no":"note om uttrykk","tr":"İfade üzerine not","vi":"ghi chú về biểu hiện","zh-Hans-CN":"关于内容表达的附注"},"ToolkitDefinition":{"ar":"وصف عام غير محدد لسمة واحدة أو أكثر من سمات تعبيرة.","ca":"Descripció no estructurada àmplia d’un o més atributs d’una expressió.","cs":"Obecný nestrukturovaný popis jednoho nebo více atributů vyjádření.","da":"Bred, ustruktureret beskrivelse af en eller flere af et udtryks attributter.","de":"Eine umfassende, unstrukturierte Beschreibung eines Merkmals oder mehrerer Merkmale einer Expression.","de":"Eine umfassende, unstrukturierte Beschreibung eines Merkmals oder mehrerer Merkmale einer Expression.","el":"Μια σημείωση που παρέχει πρόσθετες πληροφορίες σχετικά με περιεχόμενο καταχωρισμένο ως ιδιότητα μιας έκφρασης.","en":"A broad unstructured description of one or more attributes of an expression.","es":"Una descripción amplia y no estructurada de uno o más atributos de una expresión.","et":"Üldine struktureerimata kirjeldus, mis iseloomustab üht või mitut väljenduse omadust.","fi":"Ekspression yhden tai useamman attribuutin yleisluonteinen rakenteistamaton kuvailu.","fr":"Description non structurée générale d’un ou plusieurs attributs d’une expression.","hu":"Egy kifejezési forma egy vagy több ismérvének átfogó strukturálatlan leírása.","lv":"Plašs nestrukturēts izteiksmes viena vai vairāku atribūtu apraksts.","nl":"Een algemene ongestructureerde beschrijving van één of meer attributen van een expressie.","no":"En bred ustrukturert beskrivelse av ett eller flere attributter til et uttrykk.","tr":"Bir anlatımın bir veya daha fazla niteliğinin yapılandırılmamış geniş tanımı.","vi":"Ghi chú cung cấp thông tin phụ trợ về nội dung được ghi như là thuộc tính biểu hiện.","zh-Hans-CN":"关于一种内容表达的一个或多个属性的宽泛的非结构化描述"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/noteOnExpression.en","instructionNumber":"7.29","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/x/P00015", "lexicalAlias":"http://rdaregistry.info/Elements/x/noteOnRDAEntity.en", "label":"has note on RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20010", "lexicalAlias":"http://rdaregistry.info/Elements/e/noteOnChangesInContentCharacteristics.en", "label":"has note on changes in content characteristics"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20071", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/noteOnExpression.en", "label":"has note on expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20309","label":{"ar":"لها تبصرة عن التقاط","ca":"té com a nota sobre captura","cs":"má poznámku o zaznamenání","da":"har note om optagelse","de":"hat Anmerkung zur Aufzeichnung","de":"hat Anmerkung zur Aufzeichnung","el":"έχει σημείωση στη σύλληψη","en":"has note on capture","es":"tiene nota sobre la captura","et":"märkus jäädvustamise kohta","fi":"huomautus tallennuksesta","fr":"a pour note sur la captation","hu":"megjegyzése a rögzítésről a következő:","lv":"piezīme par tveršanu","nl":"heeft noot bij vastleggen","no":"har note om opptak","tr":"kayıt hakkında not ile ilişkilidir","vi":"có ghi chú về thu nạp","zh-Hans-CN":"有关于摄录的附注"},"definition":{"ar":["تربط بين تعبيرة وتبصرة عن تعبيرة توفر معلومات مرتبطة بتسجيل محتوى تعبيرة، أو تصويره، إلخ."],"ca":["Relaciona una expressió amb una nota sobre una expressió que proporciona informació associada amb l’enregistrament, la filmació, etc. del contingut d’una expressió."],"cs":["Vztahuje vyjádření k poznámce o vyjádření, která poskytuje informaci spojenou s nahráním, natočením atd., obsahu vyjádření."],"da":["Relaterer et udtryk til en note om udtryk, som giver information knyttet til optagelse, indspilning etc. af indholdet af et udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Anmerkung zur Expression, die Informationen liefert, die mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung stehen.,Setzt eine Expression in Beziehung zu einer Anmerkung zur Expression, die Informationen liefert, die mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung stehen."],"el":["Συνδέει μια έκφραση με μια σημείωση που παρέχει πληροφορίες σχετικές με την ηχογράφηση, την κινηματογράφηση κ.λπ. του περιεχομένου μιας έκφρασης."],"en":["Relates an expression to a note on expression that provides information associated with the recording, filming, etc., of the content of an expression."],"es":["Relaciona una expresión con una nota sobre expresión que proporciona información asociada a la grabación, filmación, etc., del contenido de una expresión."],"et":["Seostab väljenduse märkusega väljenduse kohta, mis sisaldab väljenduse sisu salvestamise, filmimise vms jäädvustamisega seotud infot."],"fi":["Liittää ekspression ekspressiota koskevaan huomautukseen, joka sisältää ekspression sisällön äänitykseen, kuvaukseen tms. liittyviä tietoja."],"fr":["Met une expression en relation avec une note sur une expression qui fournit de l’information associée à l’enregistrement, au tournage, etc. du contenu d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formára tett megjegyzéshez, amely információt nyújt egy formában tartalmának felvételével, filmezésével, stb. társított információkról."],"lv":["Sasaista izteiksmi ar piezīmi par izteiksmes satura ierakstīšanu, filmēšanu u.tml."],"nl":["Relateert een expressie aan een noot bij expressie die informatie levert geassocieerd met het opnemen, filmen etc. van de content van een expressie."],"no":["Relaterer et uttrykk til en note for uttrykk som gir informasjon som forbindes med innspilling, opptak, etc. av innholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın içeriğinin, filme alınması, kaydedilmesi vb. ile bağlantılı olan bilgiyi sağlayan anlatımla ilgili notla ilişkilendirir."],"vi":["Ghi chú cung cấp thông tin liên quan tới ghi, làm phim, v.v..., của nội dung của biểu hiện."],"zh-Hans-CN":["将一种内容表达与提供关于内容表达之内容的和录制、摄制等有关信息的一个关于内容表达的附注关联起来。"]},"note":{"ar":["تبصرة عن التقاط تشمل الظروف مثل التسجيل المباشر، أو التسجيل في ستوديو، والمعدات المستخدمة، إلخ."],"ca":["La nota sobre una captura inclou les circumstàncies com ara un enregistrament en directe o en un estudi, l’equipament que s’usa, etc."],"cs":["Poznámka o vyjádření, která poskytuje informaci spojenou s nahráním, natočením atd., obsahu vyjádření."],"da":["Note om optagelse omfatter forhold såsom live- eller studieoptagelse, anvendt udstyr etc."],"de":["Darunter fallen auch die Umstände einer Aufzeichnung wie zum Beispiel, ob es sich um eine Live- oder Studioaufnahme handelt, welches Equipment verwendet wurde und so weiter.,Darunter fallen auch die Umstände einer Aufzeichnung wie zum Beispiel, ob es sich um eine Live- oder Studioaufnahme handelt, welches Equipment verwendet wurde und so weiter."],"el":["Η σημείωση αναφορικά με τη σύλληψη περιέχει τις συνθήκες, όπως μια ζωντανή ηχογράφηση ή σε studio, τον εξοπλισμό που χρησιμοποιήθηκε κ.λπ."],"en":["Note on capture includes the circumstances such as a live or studio recording, the equipment used, etc."],"es":["La nota sobre la captura incluye circunstancias como una grabación en vivo o en estudio, el equipo utilizado, etc."],"et":["Märkus jäädvustamise kohta hõlmab selliseid tingimusi nagu elav või stuudiosalvestus, kasutatud aparatuur jne."],"fi":["Tallennusta koskevaan huomautukseen kuuluvat sellaiset tapaukset kuin live- tai studioäänitys, käytetty laitteisto jne."],"fr":["Une note sur la captation comprend les circonstances telles que le fait qu’un enregistrement a été effectué en direct ou en studio, l’équipement utilisé, etc."],"hu":["A felvételrögzítésről szóló megjegyzésbe olyan körülmények tartoznak, mint az élő adás vagy stúdiófelvétel, a használt eszközök stb."],"lv":["Piezīme ietver tādus gadījumus kā dzīvais vai studijas ieraksts, izmantotais aprīkojums u.tml."],"nl":["Noot bij vastleggen omvat de omstandigheden zoals een live of studio-opname, de gebruikte apparatuur etc."],"tr":["Görüntü alımı ile ilgili not Örneğin; canlı veya stüdyo kaydı, kullanılan ekipman vb. durumları içerir."],"vi":["Ghi chú về thu nạp bao gồm các trường hợp như là ghi trực tiếp hoặc studio, thiết bị được dùng, v.v..."],"zh-Hans-CN":["关于摄录的附注包括诸如实况录制或工作室录制、所用的设备等条件。"]},"ToolkitLabel":{"ar":"تبصرة عن التقاط","ca":"nota sobre captura","cs":"poznámka o zaznamenání","da":"note om optagelse","de":"Anmerkung zur Aufzeichnung","de":"Anmerkung zur Aufzeichnung","el":"σημείωση στη σύλληψη","en":"note on capture","es":"nota sobre la captura","et":"märkus jäädvustamise kohta","fi":"huomautus tallennuksesta","fr":"note sur la captation","hu":"megjegyzése a rögzítésről:","lv":"piezīme par tveršanu","nl":"noot bij vastleggen","no":"note om opptak","tr":"Görüntü alma hakkında not","vi":"ghi chú về thu nạp","zh-Hans-CN":"关于摄录的附注"},"ToolkitDefinition":{"ar":"تبصرة عن تعبيرة توفر معلومات مرتبطة بتسجيل محتوى تعبيرة، أو تصويره، إلخ.","ca":"Nota sobre una expressió que proporciona informació associada amb l’enregistrament, la filmació, etc. del contingut d’una expressió.","cs":"Poznámka o vyjádření, která poskytuje informaci spojenou s nahráním, natočením atd., obsahu vyjádření.","da":"Note om udtryk, som giver information knyttet til optagelse, indspilning etc. af indholdet af et udtryk.","de":"Eine Anmerkung zur Expression, die Informationen liefert, die mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung stehen.","de":"Eine Anmerkung zur Expression, die Informationen liefert, die mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung stehen.","el":"Μια σημείωση που παρέχει πληροφορίες σχετικές με την ηχογράφηση, την κινηματογράφηση κ.λπ. του περιεχομένου μιας έκφρασης.","en":"A note on expression that provides information associated with the recording, filming, etc., of the content of an expression.","es":"Una nota sobre expresión que proporciona información asociada a la grabación, filmación, etc., del contenido de una expresión.","et":"Märkus väljenduse kohta, mis sisaldab väljenduse sisu salvestamise, filmimise vms jäädvustamisega seotud infot.","fi":"Ekspressiota koskeva huomautus, joka sisältää ekspression sisällön äänitykseen, kuvaukseen tms. liittyviä tietoja.","fr":"Note sur une expression qui fournit de l’information associée à l’enregistrement, au tournage, etc. du contenu d’une expression.","hu":"Egy kifejezési formára tett megjegyzés, amely információt nyújt egy formában tartalmának felvételével, filmezésével, stb. társított információkról.","lv":"Piezīme par izteiksmes satura ierakstīšanu, filmēšanu u.tml.","nl":"Een noot bij expressie die informatie levert geassocieerd met het opnemen, filmen etc. van de content van een expressie.","no":"En note for uttrykk som gir informasjon som forbindes med innspilling, opptak, etc. av innholdet i et uttrykk.","tr":"Bir anlatımın içeriğinin kaydedilmesi, filme alınması vb. ile ilişkili bilgi sağlayan ifade notu.","vi":"Ghi chú cung cấp thông tin liên quan tới ghi, làm phim, v.v..., của nội dung của biểu hiện.","zh-Hans-CN":"提供关于内容表达之内容的和录制、摄制等有关信息的一个关于内容表达的附注"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20217", "lexicalAlias":"http://rdaregistry.info/Elements/e/captureInformation.en", "label":"has capture information"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/noteOnCapture.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.11.4","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20309", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/noteOnCapture.en", "label":"has note on capture"}]},{"@id":"http://rdaregistry.info/Elements/e/P20010","definition":{"ar":["تربط بين تعبيرة وتبصرة عن تعبيرة تعطي معلومات عن التغيرات في سمات محتوى التعبيرات المتمثلة في الأجزاء، أو الأعداد، أو إعادة الإصدار الخاص بعمل تعاقبي."],"ca":["Relaciona una expressió amb una nota sobre una expressió que proporciona informació sobre variacions en les característiques de contingut d’expressions de parts, números o iteracions d’una obra diacrònica."],"cs":["Vztahuje vyjádření k poznámce o vyjádření, která poskytuje informaci o změnách v charakteristice obsahu vyjádření částí, čísel nebo iterací diachronního díla."],"da":["Relaterer et udtryk til en note om udtryk, som informerer om variationer i indholdskarakteristika af udtryk af dele, numre eller iterationer af et diakronisk værk."],"de":["Setzt eine Expression in Beziehung zu einer Anmerkung zur Expression, die Informationen über Veränderungen in den Inhaltseigenschaften bei Expressionen von Teilen, Ausgaben oder Iterationen eines diachronen Werks enthält.,Setzt eine Expression in Beziehung zu einer Anmerkung zur Expression, die Informationen über Veränderungen in den Inhaltseigenschaften bei Expressionen von Teilen, Ausgaben oder Iterationen eines diachronen Werks enthält."],"el":["Συνδέει μια έκφραση με μια σημείωση σχετικά με αλλαγές στα χαρακτηριστικά του περιεχομένου που εντοπίζονται σε διαδοχικά τεύχη ή μέρη μιας έκφρασης που εκδίδεται σε διαδοχικά μέρη ή [εκδίδεται] μεταξύ ενημερώσεων/ανανεώσεων ενός ενσωματωμένου πόρου."],"en":["Relates an expression to a note on expression that provides information on variations in the content characteristics of expressions of parts, issues, or iterations of a diachronic work."],"es":["Relaciona una expresión con una nota sobre expresión que proporciona información sobre variaciones en las características de contenido de expresiones de partes, temas o iteraciones de una obra diacrónica."],"et":["Seostab väljenduse märkusega väljenduse kohta, mis annab infot diakroonilise teose osade, numbrite või seisude väljenduste sisu iseloomus toimunud muutustest."],"fi":["Liittää ekspression ekspressiota koskevaan huomaukseen, jossa annetaan tietoja vaihteluista diakronisen teoksen osien, numeroiden tai iteraatioiden ekspressioiden sisällön ominaisuuksissa."],"fr":["Met une expression en relation avec une note sur une expression qui fournit de l’information sur les variantes dans les caractéristiques du contenu d’expressions de parties, livraisons ou itérations d’une œuvre diachronique."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formára tett megjegyzéshez, amely információt nyújt egy diakronikus mű részeinek, számainak, vagy iterációinak tartalmi jellemzőiben történt változásokról."],"lv":["Sasaista izteiksmi ar piezīmi par izteiksmi, kurā ir ziņas par izmaiņām satura izteiksmju raksturojumā, kas sastopama daļās, laidienos vai atkārtojumos."],"nl":["Relateert een expressie aan een noot bij expressie die informatie levert over variaties in de karakteristieken van content van expressies van delen, afleveringen of iteraties van een diachronisch werk."],"no":["Relaterer et uttrykk til en note om endringer som gir informasjon om variasjoner av innholdsegenskapene for uttrykk for deler, hefter eller versjoner av et diakronisk verk."],"tr":["Bir anlatımı, artzamanlı bir eserin parçalarının, konularının veya yinelemelerinin anlatımlarının içerik özelliklerindeki değişimler hakkında bilgi sağlayan anlatımla ilgili bir notla ilişkilendirir."],"vi":["Liên kết một biểu hiện với ghi chú về thay đổi trong đặc trưng nội dung trong các số hoặc phần tiếp sau của biểu hiện được công bố thành các phần liên tiếp hoặc giữa các lần lặp của nguồn lực tích hợp."],"zh-Hans-CN":["将一种内容表达与提供一种历时作品的部分、期、或更新后的整体的内容表达的内容特征的变化信息的一个关于内容表达的附注关联起来。"]},"ToolkitLabel":{"ar":"تبصرة عن التغييرات في سمات محتوى","ca":"nota sobre canvis de característiques de contingut","cs":"poznámka o změnách v charakteristice obsahu","da":"note om ændringer i indholdskarakteristika","de":"Anmerkung zu Änderungen von Inhaltseigenschaften","de":"Anmerkung zu Änderungen der Inhaltseigenschaften","el":"σημείωση για αλλαγές σε χαρακτηριστικά περιεχομένου","en":"note on changes in content characteristics","es":"nota sobre cambios en las características del contenido","et":"märkus muutuste kohta sisu iseloomus","fi":"huomautus muutoksista sisällön ominaisuuksissa","fr":"note sur les changements dans les caractéristiques du contenu","hu":"tartalmi jellemzők változásairól szóló megjegyzése:","lv":"piezīme par izmaiņām satura raksturojumā","nl":"noot bij veranderingen in karakteristieken van content","no":"note om endringer i innholdsegenskapene","sv":"anmärkning om förändringar i innehållsegenskaper","tr":"içerik özelliklerindeki değişikliklere ilişkin not","vi":"ghi chú về thay đổi trong đặc tính nội dung","zh-Hans-CN":"关于内容特征变化的附注"},"ToolkitDefinition":{"ar":"تبصرة عن تعبيرة تعطي معلومات عن التغيرات في سمات محتوى التعبيرات المتمثلة في الأجزاء، أو الأعداد، أو إعادة الإصدار الخاص بعمل تعاقبي.","ca":"Nota sobre una expressió que proporciona informació sobre variacions en les característiques de contingut d’expressions de parts, números o iteracions d’una obra diacrònica.","cs":"Poznámka o vyjádření, která poskytuje informaci o změnách v charakteristice obsahu vyjádření částí, čísel nebo iterací diachronního díla.","da":"Note om udtryk, som informerer om variationer i indholdskarakteristika af udtryk af dele, numre eller iterationer af et diakronisk værk.","de":"Eine Anmerkung zur Expression, die Informationen über Veränderungen in den Inhaltseigenschaften bei Expressionen von Teilen, Ausgaben oder Iterationen eines diachronen Werks enthält.","de":"Eine Anmerkung zur Expression, die Informationen über Veränderungen in den Inhaltseigenschaften bei Expressionen von Teilen, Ausgaben oder Iterationen eines diachronen Werks enthält.","el":"Μια σημείωση σχετικά με αλλαγές στα χαρακτηριστικά του περιεχομένου τα οποία εντοπίζονται σε διαδοχικά τεύχη ή μέρη μιας έκφρασης που εκδίδεται σε διαδοχικά μέρη ή [εκδίδεται] μεταξύ ενημερώσεων/ανανεώσεων ενός ενσωματωμένου πόρου.","en":"A note on expression that provides information on variations in the content characteristics of expressions of parts, issues, or iterations of a diachronic work.","es":"Una nota sobre expresión que proporciona información sobre variaciones en las características de contenido de expresiones de partes, temas o iteraciones de una obra diacrónica.","et":"Märkus väljenduse kohta, mis annab infot diakroonilise teose osade, numbrite või seisude väljenduste sisu iseloomus toimunud muutustest.","fi":"Ekspressiota koskeva huomautus, jossa annetaan tietoja vaihteluista diakronisen teoksen osien, numeroiden tai iteraatioiden ekspressioiden sisällön ominaisuuksissa.","fr":"Note sur une expression qui fournit de l’information sur les variantes dans les caractéristiques du contenu d’expressions de parties, livraisons ou itérations d’une œuvre diachronique.","hu":"Egy kifejezési formára tett megjegyzés, amely információt nyújt egy diakronikus mű részeinek, számainak, vagy iterációinak tartalmi jellemzőiben történt változásokról.","lv":"Piezīme par izteiksmi, kurā ir ziņas par izmaiņām satura izteiksmju raksturojumā, kas sastopama daļās, laidienos vai atkārtojumos.","nl":"Een noot bij expressie die informatie levert over variaties in de karakteristieken van content van expressies van delen, afleveringen of iteraties van een diachronisch werk.","no":"En note om endringer som gir informasjon om variasjoner av innholdsegenskapene for uttrykk for deler, hefter eller versjoner av et diakronisk verk.","tr":"Art zamanlı bir çalışmanın bölümlerinin, sorunlarının veya yinelemelerinin ifadelerinin içerik özelliklerindeki farklılıklar hakkında bilgi sağlayan ifade üzerine bir not.","vi":"Ghi chú về thay đổi trong đặc tính vật mang tin xuất hiện ở các số hoặc phần tiếp sau của một biểu hiện được công bố trong các phần liên tiếp hoặc giữa tính lặp của một nguồn lực tích hợp.","zh-Hans-CN":"提供一种历时作品的部分、期、或更新后的整体的内容表达的内容特征的变化信息的一个关于内容表达的附注"},"label":{"ar":"لها تبصرة عن التغييرات في سمات محتوى","ca":"té com a nota sobre canvis de característiques de contingut","cs":"má poznámku o změnách v charakteristice obsahu","da":"har note om ændringer i indholdskarakteristika","de":"hat Anmerkung zu Änderungen von Inhaltseigenschaften","de":"hat Anmerkung zu Änderungen von Inhaltseigenschaften","el":"έχει σημείωση για αλλαγές σε χαρακτηριστικά περιεχομένου","en":"has note on changes in content characteristics","es":"tiene nota sobre cambios en las características del contenido","et":"märkus muutuste kohta sisu iseloomus","fi":"huomautus muutoksista sisällön ominaisuuksissa","fr":"a pour note sur les changements dans les caractéristiques du contenu","hu":"tartalmi jellemzők változásairól szóló megjegyzése a következő:","lv":"piezīme par izmaiņām satura raksturojumā","nl":"heeft noot bij veranderingen in karakteristieken van content","no":"har note om endringer i innholdsegenskapene","sv":"har anmärkning om förändringar i innehållsegenskaper","tr":"içerik özelliklerindeki değişiklikler hakkında not ile ilişkilidir","vi":"cóghi chú về thay đổi trong đặc tính nội dung","zh-Hans-CN":"有关于内容特征变化的附注"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20071", "lexicalAlias":"http://rdaregistry.info/Elements/e/noteOnExpression.en", "label":"has note on expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/noteOnChangesInContentCharacteristics.en","instructionNumber":"7.29.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20010", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/noteOnChangesInContentCharacteristics.en", "label":"has note on changes in content characteristics"}]},{"@id":"http://rdaregistry.info/Elements/e/P20087","definition":{"ar":["تربط بين وتعبيرة وتعبيرة لعمل موسيقي غير درامي، بخلاف الموسيقى الدينية، التي تستخدم نص تعبيرة عمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra musical no teatral, diferent d’un oratori, que usa el text d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření nedramatického hudebního díla jiného než oratorium, které využívá text vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et ikke-dramatisk musikværk, bortset fra et oratorium, som anvender teksten til et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines nicht dramatischen Musikwerks, bei dem es sich nicht um ein Oratorium handelt, die den Text einer Expression eines anderen Werks verwendet.,Setzt eine Expression in Beziehung zu einer Expression eines nicht dramatischen Musikwerks, bei dem es sich nicht um ein Oratorium handelt, die den Text einer Expression eines anderen Werks verwendet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός μη δραματικού μουσικού έργου, άλλο από ορατόριο, το οποίο χρησιμοποιεί το κείμενο ενός έργου-πηγής."],"en":["Relates an expression to an expression of a non-dramatic musical work, other than an oratorio, that uses the text of an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra musical no dramática, distinta de un oratorio, que utiliza el texto de una expresión de otra obra."],"et":["Seostab väljenduse mittedramaatilise muusikateose (v.a oratoorium) väljendusega, milles kasutatakse allikteose teksti."],"fi":["Liittää ekspression ei-näytelmällisen musiikkiteoksen (muun kuin oratorion) ekspressioon, jonka teksti on peräisin toisen teoksen ekspressiosta."],"fr":["Met une expression en relation avec une expression d’une œuvre musicale non dramatique, autre qu’un oratorio, qui utilise le texte d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy nem-drámai zenemű kifejezési formájához, amely nem oratórium, és amely egy másik mű kifejezési formájának szövegét használja."],"lv":["Sasaista izteiksmi ar ne-dramatiska mūzikas darba izteiksmi, kas nav oratorija, kurā izmantots pamatdarba teksts."],"nl":["Relateert een expressie aan een expressie van een niet-dramatisch muziekwerk, anders dan een oratorium, dat de tekst van een expressie van een ander werk gebruikt."],"no":["Relaterer et uttrykk til et uttrykk av et ikke-dramatisk musikalsk verk, bortsett fra et oratorium, som bruker teksten fra et kildeverk."],"tr":["Bir anlatımı, başka bir eserin anlatımının metnini kullanan oratoryo dışındaki dramatik olmayan bir müzik eserinin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm âm nhạc phi kịch khác với oratorio có sử dụng văn bản của tác phẩm nguồn."],"zh-Hans-CN":["将一种内容表达与不同于清唱剧、使用另一种作品的一种内容表达的文本的一种非戏剧音乐作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معدة لتصاحبها موسيقى كتعبيرة","ca":"musicat com a expressió","cs":"zhudebněno jako vyjádření","da":"sat til musik som udtryk","de":"Vertont als (Expression)","de":"Vertont als (Expression)","el":"προσαρμοσμένη ως μυθιστόρημα (έκφραση)","en":"set to music as expression","es":"poner música como expresión.","et":"viisistatud väljendusena","fi":"tekstiin perustuva musiikki (ekspressio)","fr":"mis en musique comme une expression","hu":"megzenésítése kifejezési formaként:","lv":"izteiksme: tekstam komponētā mūzika","nl":"op muziek gezet als expressie","no":"satt til musikk som uttrykk","tr":"anlatım olarak müziğe ayarlanmış","vi":"được đặt thành âm nhạc như là (biểu hiện)","zh-Hans-CN":"配乐为内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل موسيقي غير درامي، بخلاف الموسيقى الدينية، التي تستخدم نص تعبيرة عمل آخر.","ca":"Expressió d’una obra musical no teatral, diferent d’un oratori, que usa el text d’una expressió d’una altra obra.","cs":"Vyjádření nedramatického hudebního díla jiného než oratorium, které využívá text vyjádření jiného díla.","da":"Udtryk af et ikke-dramatisk musikværk, bortset fra et oratorium, som anvender teksten til et udtryk af et andet værk.","de":"Eine Expression eines nicht dramatischen Musikwerks, bei dem es sich nicht um ein Oratorium handelt, die den Text einer Expression eines anderen Werks verwendet.","de":"Eine Expression eines nicht dramatischen Musikwerks, bei dem es sich nicht um ein Oratorium handelt, die den Text einer Expression eines anderen Werks verwendet.","el":"Μια έκφραση ενός μη δραματικού μουσικού έργου, άλλο από ορατόριο, το οποίο χρησιμοποιεί το κείμενο ενός έργου-πηγής.","en":"An expression of a non-dramatic musical work, other than an oratorio, that uses the text of an expression of another work.","es":"Una expresión de una obra musical no dramática, distinta de un oratorio, que utiliza el texto de una expresión de otra obra.","et":"Mittedramaatilise muusikateose (v.a oratoorium) väljendus, milles kasutatakse allikteose teksti.","fi":"Ei-näytelmällisen musiikkiteoksen (muun kuin oratorion) ekspressio, jonka teksti on peräisin toisen teoksen ekspressiosta.","fr":"Expression d’une œuvre musicale non dramatique, autre qu’un oratorio, qui utilise le texte d’une expression d’une autre œuvre.","hu":"Egy nem-drámai zenemű kifejezési formája, amely nem oratórium, és amely egy másik mű kifejezési formájának szövegét használja.","lv":"Ne-dramatiska mūzikas darba izteiksme, kas nav oratorija, kurā izmantots pamatdarba teksts.","nl":"Een expressie van een niet-dramatisch muziekwerk, anders dan een oratorium, dat de tekst van een expressie van een ander werk gebruikt.","no":"Et uttrykk av et ikke-dramatisk musikalsk verk, bortsett fra et oratorium, som bruker teksten fra et kildeverk.","tr":"Oratoryo dışındaki dramatik olmayan bir müzik eserinin, başka bir eserin metnini kullanan bir anlatımı.","vi":"Biểu hiện của tác phẩm âm nhạc phi kịch khác vớioratorio có sử dụng văn bản của tác phẩm nguồn.","zh-Hans-CN":"不同于清唱剧、使用另一种作品的一种内容表达的文本的一种非戏剧音乐作品的一种内容表达"},"label":{"ar":"معدة لتصاحبها موسيقى كتعبيرة","ca":"és musicat com a expressió","cs":"je zhudebněno jako vyjádření","da":"er sat til musik som udtryk","de":"ist vertont als (Expression)","de":"ist vertont als (Expression)","el":"είναι μελοποιημένη ως (έκφραση)","en":"is set to music as expression","es":"se pone música como expresión","et":"viisistatud väljendusena","fi":"tekstiin perustuva musiikki (ekspressio)","fr":"est mis en musique comme une expression","hu":"megzenésítése a következő kifejezési formaként:","lv":"izteiksmes tekstam komponētā mūzika","nl":"is op muziek gezet als expressie","no":"er satt til musikk som uttrykk","tr":"anlatım olarak müziğe ayarlanmıştır","vi":"được đặt thành âm nhạc như là (biểu hiện)","zh-Hans-CN":"是配乐为内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/setToMusicAsExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20087", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/setToMusicAsExpression.en", "label":"is set to music as expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20087", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/setToMusicAsExpression.en", "label":"is set to music as expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20172","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يحدث تعبيرة سائدة، أو، خلاف ذلك، يستكملها."],"ca":["Relaciona una expressió amb una expressió d’una obra que actualitza o altrament complementa una expressió predominant."],"cs":["Vztahuje vyjádření k vyjádření díla, které aktualizuje nebo jiným způsobem komplementuje hlavní vyjádření."],"da":["Relaterer et udtryk til et udtryk af et værk, som opdaterer eller på anden måde komplementerer et fremtrædende udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die eine Haupt-Expression aktualisiert oder auf andere Weise ergänzt.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die eine Haupt-Expression aktualisiert oder auf andere Weise ergänzt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο ενημερώνει ή αλλιώς συμπληρώνει μια κύρια έκφραση."],"en":["Relates an expression to an expression of a work that updates or otherwise complements a predominant expression."],"es":["Relaciona una expresión con una expresión de una obra que actualiza o complementa de otro modo una expresión predominante."],"et":["Seostab väljenduse teose väljendusega, milles dominantset väljendust on uuendatud või muul viisil täiendatud."],"fi":["Liittää ekspression teoksen ekspressioon, joka päivittää tai muuten täydentää vallitsevaa ekspressiota."],"fr":["Met une expression en relation avec une expression d’une œuvre qui met à jour ou complète d’une autre façon une expression prédominante."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely frissít vagy más módon kiegészít egy domináns kifejezési formát."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas atjauno vai citādi papildina pamatizteiksmi."],"nl":["Relateert een expressie aan een expressie van een werk dat een hoofdexpressie updatet of anderszins complementeert."],"no":["Relaterer et uttrykk til et uttrykk av et verk som oppdaterer eller på annen måte utfyller et mer framtredende uttrykk."],"tr":["Bir anlatımı, baskın bir anlatımı güncelleyen veya başka bir şekilde tamamlayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm cập nhật hoặc nếu không thì bổ sung cho biểu hiện nổi trội."],"zh-Hans-CN":["将一种内容表达与更新或补充一种主要内容表达的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة ملحقة","ca":"expressió de suplement","cs":"suplement (vyjádření)","da":"supplementudtryk","de":"Supplement (Expression)","de":"Supplement (Expression)","el":"συμπλήρωμα (έκφραση)","en":"supplement expression","es":"expresión suplementaria","et":"suplement (väljendus)","fi":"suplementti (ekspressio)","fr":"supplément (expression)","hu":"melléklet kifejezési formája:","lv":"izteiksme: pieaugums","nl":"supplement-expressie","no":"supplement (uttrykk)","tr":"tamamlayıcı anlatım","vi":"phụ bản (biểu hiện)","zh-Hans-CN":"补编内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يحدث تعبيرة سائدة، أو، خلاف ذلك، يستكملها.","ca":"Expressió d’una obra que actualitza o altrament complementa una expressió predominant.","cs":"Vyjádření díla, které aktualizuje nebo jiným způsobem komplementuje hlavní vyjádření.","da":"Udtryk af et værk, som opdaterer eller på anden måde komplementerer et fremtrædende udtryk.","de":"Eine Expression eines Werks, die eine Haupt-Expression aktualisiert oder auf andere Weise ergänzt.","de":"Eine Expression eines Werks, die eine Haupt-Expression aktualisiert oder auf andere Weise ergänzt.","el":"Μια έκφραση ενός έργου το οποίο ενημερώνει ή αλλιώς συμπληρώνει μια κύρια έκφραση.","en":"An expression of a work that updates or otherwise complements a predominant expression.","es":"Una expresión de una obra que actualiza o complementa de otro modo una expresión predominante.","et":"Teose väljendus, milles dominantset väljendust on uuendatud või muul viisil täiendatud.","fi":"Teoksen ekspressio, joka päivittää tai muuten täydentää vallitsevaa ekspressiota.","fr":"Expression d’une œuvre qui met à jour ou complète d’une autre façon une expression prédominante.","hu":"Egy mű kifejezési formája, amely frissít vagy más módon kiegészít egy domináns kifejezési formát.","lv":"Darba izteiksme, kas atjauno vai citādi papildina pamatizteiksmi.","nl":"Een expressie van een werk dat een hoofdexpressie updatet of anderszins complementeert.","no":"Et uttrykk av et verk som oppdaterer eller på annen måte utfyller et mer framtredende uttrykk.","tr":"Baskın bir anlatımı güncelleyen veya başka bir şekilde tamamlayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm cập nhật hoặc nếu không thì bổ sung cho biểu hiện nổi trội.","zh-Hans-CN":"更新或补充一种主要内容表达的一种作品的一种内容表达"},"label":{"ar":"لها تعبيرة ملحقة","ca":"té com a expressió de suplement","cs":"má suplement (vyjádření)","da":"har supplementudtryk","de":"hat Supplement (Expression)","de":"hat Supplement (Expression)","el":"είναι συμπλήρωμα (έκφραση)","en":"has supplement expression","es":"tiene expresión suplementaria","et":"suplement (väljendus)","fi":"suplementti (ekspressio)","fr":"a pour supplément (expression)","hu":"melléklet kifejezési formája a következő:","lv":"izteiksme: pieaugums","nl":"heeft supplement-expressie","no":"har supplement (uttrykk)","tr":"ek anlatım ile ilişkilidir","vi":"là phụ bản (biểu hiện)","zh-Hans-CN":"有补编内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20105", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentedByExpression.en", "label":"is augmented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/supplementExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20172", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/supplementExpression.en", "label":"has supplement expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20172", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/supplementExpression.en", "label":"has supplement expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20228","definition":{"ar":["تربط بين تعبيرة ونسبة أبعاد تعبيرة صورة ثابتة أو شكل ثلاثي الأبعاد لأبعاد الشيء الذي تمثله."],"ca":["Relaciona una expressió amb una relació entre les dimensions d’una expressió d’una imatge o d’una forma tridimensional i les dimensions de la cosa que es representa."],"cs":["Vztahuje vyjádření k poměru rozměrů vyjádření obrazu nebo trojrozměrné formy a rozměrů znázorňované věci."],"da":["Relaterer et udtryk til et forhold mellem dimensionerne af et udtryk af et billede eller en tredimensionel form og dimensionerne for den ting, billedet eller formen repræsenterer."],"de":["Setzt eine Expression in Beziehung zu einem Verhältnis der Maße eines Bilds oder einer dreidimensionalen Form zu den Maßen der Sache, die es/sie repräsentiert.,Setzt eine Expression in Beziehung zu einem Verhältnis der Maße eines Bilds oder einer dreidimensionalen Form zu den Maßen der Sache, die es/sie repräsentiert."],"el":["Συνδέει μια έκφραση με τον λόγο των διαστάσεων του περιεχομένου μιας εικόνας ή μιας τρισδιάστατης μορφής προς τις διαστάσεις του πράγματος που αναπαρίσταται."],"en":["Relates an expression to a ratio of the dimensions of an expression of an image or three-dimensional form to the dimensions of the thing that is represented."],"es":["Relaciona una expresión con una relación de las dimensiones de una expresión de una imagen o forma tridimensional con las dimensiones de la cosa que se representa."],"et":["Seostab väljenduse pildi või kolmemõõtmelise vormi väljenduse mõõtmete ja kujutatud asja mõõtmete suhtega."],"fi":["Liittää ekspression kuvan tai kolmiulotteisen muodon ekspression mittojen suhteeseen sen esittämän kohteen mittoihin."],"fr":["Met une expression en relation avec un rapport entre les dimensions d’une expression d’une image ou d’une forme tridimensionnelle et les dimensions de la chose représentée."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formában megtestesített kép vagy háromdimenziós forma méretének és a kifejezési forma által ábrázolt dolog méretének viszonyításához."],"lv":["Sasaista izteiksmi ar resursā ietvertā attēla vai trīsdimensiju modeļa izmēru attiecību pret izmēriem dabā."],"nl":["Relateert een expressie aan een verhouding van de afmetingen van een expressie van een beeld of driedimensionale vorm tot de afmetingen van het ding dat vertegenwoordigd wordt."],"no":["Relaterer et uttrykk til et forhold mellom størrelsen på et uttrykk av et bilde eller en tredimensjonal form og størrelsen på det som gjengis."],"tr":["Bir anlatımı, bir görüntünün veya üç boyutlu şeklin anlatımının boyutlarının temsil edilen şeyin boyutlarına oranıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với tỷ số của kích thước của nội dung của hình ảnh tính hoặc hình thái ba chiều với kích thước của vật được trình bày."],"zh-Hans-CN":["将一种内容表达与一种图像或三维形式的一种内容表达的尺寸与其所代表的事物的尺寸之比关联起来。"]},"note":{"ar":["يمكن تطبيق المقياس على القياسات الأفقية، أو الرأسية، أو غيرها من القياسات الممثلة في تعبيرة."],"ca":["L’escala es pot aplicar a mesures horitzontals, verticals, angulars o a altres mesures representades en una expressió."],"cs":["Měřítko se může vztahovat na vodorovné, svislé, úhlové nebo jiné měření reprezentované ve vyjádření."],"da":["Målestoksforhold kan gælde for horisontale, vertikale, kantede eller andre mål repræsenterede i et udtryk."],"de":["Ein Maßstab kann auf horizontale, vertikale, winklige oder andere Maße angewendet werden, die in einer Expression repräsentiert sind.,Ein Maßstab kann auf horizontale, vertikale, winklige oder andere Maße angewendet werden, die in einer Expression repräsentiert sind."],"el":["Η κλίμακα μπορεί να βρει εφαρμογή σε οριζόντιες, κάθετες, γωνιώδεις ή/και άλλες μετρήσεις που αναπαρίστανται σε μια έκφραση."],"en":["Scale can apply to horizontal, vertical, angular, or other measurements represented in an expression."],"es":["La escala se puede aplicar a medidas horizontales, verticales, angulares u otras medidas representadas en una expresión."],"et":["Mõõtkava võib käia väljenduses kujutatud horisontaalsete, vertikaalsete, nurga- või muude mõõtude kohta."],"fi":["Mittakaava voi koskea ekspressiossa esitettyjä horisontaalisia, vertikaalisia, kulma- tai muita mittoja."],"fr":["Une échelle peut s’appliquer à des mesures horizontales, verticales, angulaires ou à d’autres mesures représentées dans une expression."],"hu":["A méretarány alkalmazható egy kifejezési formában reprezentált vízszintes, függőleges, ferde és/vagy más méretekre."],"lv":["Mērogs var tikt piemērots horizontāliem, vertikāliem, leņķa un/vai citiem izteiksmē atspoguļotiem mērījumiem."],"nl":["Schaal kan betrekking hebben op horizontale, verticale, hoekmetingen of andere metingen vertegenwoordigd in een expressie."],"no":["Målestokk kan gjelde horisontale eller vertikale mål eller vinkelmål, eller andre mål som gjengis i et uttrykk."],"tr":["Ölçek, bir anlatımda temsil edilen yatay, dikey, açısal veya diğer ölçümlere uygulanabilir."],"vi":["Tỷ lệ có thể áp dụng cho chiều nganh, chiều dọc, góc, và/hoặc độ đo khác được trình bày trong biểu hiện."],"zh-Hans-CN":["比例尺可应用于内容表达中所表现的水平、垂直、角度或其他测量。"]},"ToolkitLabel":{"ar":"مقياس","ca":"escala","cs":"měřítko","da":"målestoksforhold","de":"Maßstab","de":"Maßstab","el":"κλίμακα","en":"scale","es":"escala","et":"mõõtkava","fi":"mittakaava","fr":"échelle","hu":"méretaránya:","lv":"mērogs","nl":"schaal","no":"målestokk","sv":"skala","tr":"ölçek","vi":"tỷ lệ","zh-Hans-CN":"比例尺"},"ToolkitDefinition":{"ar":"نسبة أبعاد تعبيرة صورة ثابتة أو شكل ثلاثي الأبعاد لأبعاد الشيء الذي تمثله.","ca":"Relació entre les dimensions d’una expressió d’una imatge o d’una forma tridimensional i les dimensions de la cosa que es representa.","cs":"Poměr rozměrů vyjádření obrazu nebo trojrozměrné formy a rozměrů znázorňované věci.","da":"Forhold mellem dimensionerne af et udtryk af et billede eller en tredimensionel form og dimensionerne for den ting, billedet eller formen repræsenterer.","de":"Ein Verhältnis der Maße eines Bilds oder einer dreidimensionalen Form zu den Maßen der Sache, die es/sie repräsentiert.","de":"Ein Verhältnis der Maße eines Bilds oder einer dreidimensionalen Form zu den Maßen der Sache, die es/sie repräsentiert.","el":"Ο λόγος των διαστάσεων του περιεχομένου μιας εικόνας ή μιας τρισδιάστατης μορφής προς τις διαστάσεις του πράγματος που αναπαρίσταται.","en":"A ratio of the dimensions of an expression of an image or three-dimensional form to the dimensions of the thing that is represented.","es":"Una relación de las dimensiones de una expresión de una imagen o forma tridimensional con las dimensiones de la cosa que se representa.","et":"Pildi või kolmemõõtmelise vormi väljenduse mõõtmete ja kujutatud asja mõõtmete suhe.","fi":"Kuvan tai kolmiulotteisen muodon ekspression mittojen suhde sen esittämän kohteen mittoihin.","fr":"Rapport entre les dimensions d’une expression d’une image ou d’une forme tridimensionnelle et les dimensions de la chose représentée.","hu":"Egy kifejezési formában megtestesített kép vagy háromdimenziós forma méretének és a kifejezési forma által ábrázolt dolog méretének viszonyítása.","lv":"Resursā ietvertā attēla vai trīsdimensiju modeļa izmēru attiecība pret izmēriem dabā.","nl":"Een verhouding van de afmetingen van een expressie van een beeld of driedimensionale vorm tot de afmetingen van het ding dat vertegenwoordigd wordt.","no":"Et forhold mellom størrelsen på et uttrykk av et bilde eller en tredimensjonal form og størrelsen på det som gjengis.","tr":"Bir görüntünün veya üç boyutlu şeklin anlatımının boyutlarının temsil edilen şeyin boyutlarına oranı.","vi":"Tỷ số của kích thước của nội dung của hình ảnh tính hoặc hình thái ba chiều với kích thước của vật được trình bày.","zh-Hans-CN":"一种图像或三维形式的一种内容表达的尺寸与其所代表的事物的尺寸之比"},"label":{"ar":"لها مقياس","ca":"té com a escala","cs":"má měřítko","da":"har målestoksforhold","de":"hat Maßstab","de":"hat Maßstab","el":"έχει κλίμακα","en":"has scale","es":"tiene escala","et":"mõõtkava","fi":"mittakaava","fr":"a pour échelle","hu":"méretaránya a következő:","lv":"mērogs","nl":"heeft schaal","no":"har målestokk","sv":"har skala","tr":"ölçek ile ilişkilidir","vi":"có tỷ lệ","zh-Hans-CN":"有比例尺"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/scale.en","instructionNumber":"7.25","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20227", "lexicalAlias":"http://rdaregistry.info/Elements/e/scaleOfStillImageOrThreeDimensionalForm.en", "label":"has scale of still image or three-dimensional form"},{"@id":"http://rdaregistry.info/Elements/e/P20230", "lexicalAlias":"http://rdaregistry.info/Elements/e/verticalScaleOfCartographicContent.en", "label":"has vertical scale of cartographic content"},{"@id":"http://rdaregistry.info/Elements/e/P20226", "lexicalAlias":"http://rdaregistry.info/Elements/e/horizontalScaleOfCartographicContent.en", "label":"has horizontal scale of cartographic content"},{"@id":"http://rdaregistry.info/Elements/e/P20213", "lexicalAlias":"http://rdaregistry.info/Elements/e/additionalScaleInformation.en", "label":"has additional scale information"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20228", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/scale.en", "label":"has scale"}]},{"@id":"http://rdaregistry.info/Elements/e/P20291","definition":{"ar":["تربط بين تعبيرة وتعيين عام لنقص نسبة أبعاد محتوى صورة أو شكل ثلاثي الأبعاد لأبعاد الشيء الذي تمثله."],"ca":["Relaciona una expressió amb una designació general de la manca d’una relació entre les dimensions del contingut d’una imatge o forma tridimensional i les dimensions de la cosa que es representa."],"cs":["Vztahuje vyjádření k obecnému označení nepoměru mezi rozměry obsahu obrazu nebo třírozměrné formy k rozměrům věci, kterou reprezentují."],"da":["Relaterer et udtryk til en almindelig betegnelse for manglen på forhold mellem indholdet af et billede eller en tredimensionel form, og dimensionerne for den ting, billedet eller formen repræsenterer."],"de":["Setzt eine Expression in Beziehung zu einer allgemeinen Bezeichnung für das fehlende Verhältnis der Abmessungen des Inhalts eines Bilds oder einer dreidimensionalen Form zu den Abmessungen der Sache, das es/sie repräsentiert.,Setzt eine Expression in Beziehung zu einer allgemeinen Bezeichnung für das fehlende Verhältnis der Abmessungen des Inhalts eines Bilds oder einer dreidimensionalen Form zu den Abmessungen der Sache, das es/sie repräsentiert."],"el":["Συνδέει μια έκφραση με έναν γενικό προσδιορισμό της απουσίας του λόγου των διαστάσεων του περιεχομένου μιας εικόνας ή μιας τρισδιάστατης μορφής προς τις διαστάσεις του πράγματος που αναπαρίσταται."],"en":["Relates an expression to a general designation of the lack of a ratio of the dimensions of the content of an image or three-dimensional form to the dimensions of the thing that is represented."],"es":["Relaciona una expresión con una designación general de la falta de una relación entre las dimensiones del contenido de una imagen o forma tridimensional y las dimensiones de la cosa que se representa."],"et":["Seostab väljenduse üldise tähistusega pildi või kolmemõõtmelise vormi sisu mõõtmete ja kujutatud asja mõõtmete suhte puudumise kohta."],"fi":["Liittää ekspression yleiseen määritteeseen kuvan tai kolmiulotteisen muodon ja niiden esittämän asian mittojen välisten mittasuhteiden puuttumisesta."],"fr":["Met une expression en relation avec une désignation générale de l’absence de rapport entre les dimensions du contenu d’une image ou d’une forme tridimensionnelle et les dimensions de la chose représentée."],"hu":["Hozzákapcsol egy kifejezési formát egy általános megjelöléshez, amely egy kép vagy egy háromdimenziós forma tartalmának méretére és az általa ábrázolt dolog méretének viszonyítására vonatkozik."],"lv":["Sasaista izteiksmi ar vispārēju attēla vai trīsdimensiju formas izmēru attiecības apzīmējumu pret attēloto lietu izmēriem, nenorādot šo attiecību ar skaitļiem."],"nl":["Relateert een expressie aan een algemene aanduiding van het ontbreken van de verhouding van de afmetingen van de content van een beeld of driedimensionale vorm tot de afmetingen van het ding dat vertegenwoordigd wordt."],"no":["Relaterer et uttrykk til en generell betegnelse som angir manglende målestokk for forholdet mellom målene til innholdet i et bilde eller en tredimensjonal form og målene til det som gjengis."],"tr":["Bir anlatımı, Bir görüntünün veya üç boyutlu formun içeriğinin boyutlarının temsil edilen şeyin boyutlarına oranının eksikliğinin genel bir belirteci ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với định danh chung của sự thiếu tỷ số giữa kích thước của nội dung của hình ảnh hoặc hình thái ba chiều với kích thước của vật được trình bày,"],"zh-Hans-CN":["将一种内容表达与关于一个图像或三维形式之内容的尺寸与其所表示的事物之尺寸之比缺失的一般标识关联起来。"]},"ToolkitLabel":{"ar":"تعيين مقياس","ca":"designació d’escala","cs":"označení měřítka","da":"målestoksbetegnelse","de":"Maßstabsbezeichnung","de":"Maßstabsbezeichnung","el":"προσδιορισμός κλίμακας","en":"scale designation","es":"designación de escala","et":"mõõtkava tähistus","fi":"mittakaavan määrite","fr":"désignation d’échelle","hu":"méretarány-jelölése:","lv":"mēroga apzīmējums","nl":"schaalaanduiding","no":"betegnelse for målestokk","tr":"ölçek belirteci","vi":"định danh tỷ lệ","zh-Hans-CN":"比例尺标识"},"ToolkitDefinition":{"ar":"تعيين عام لنقص نسبة أبعاد محتوى صورة أو شكل ثلاثي الأبعاد لأبعاد الشيء الذي تمثله.","ca":"Designació general de la manca d’una relació entre les dimensions del contingut d’una imatge o forma tridimensional i les dimensions de la cosa que es representa.","cs":"Obecné označení nepoměru mezi rozměry obsahu obrazu nebo třírozměrné formy k rozměrům věci, kterou reprezentují.","da":"Almindelig betegnelse for manglen på forhold mellem indholdet af et billede eller en tredimensionel form, og dimensionerne for den ting, billedet eller formen repræsenterer.","de":"Eine allgemeine Bezeichnung für das fehlende Verhältnis der Abmessungen des Inhalts eines Bilds oder einer dreidimensionalen Form zu den Abmessungen der Sache, das es/sie repräsentiert.","de":"Eine allgemeine Bezeichnung für das fehlende Verhältnis der Abmessungen des Inhalts eines Bilds oder einer dreidimensionalen Form zu den Abmessungen der Sache, das es/sie repräsentiert.","el":"Ένας γενικός προσδιορισμός της απουσίας του λόγου των διαστάσεων του περιεχομένου μιας εικόνας ή μιας τρισδιάστατης μορφής προς τις διαστάσεις του πράγματος που αναπαρίσταται.","en":"A general designation of the lack of a ratio of the dimensions of the content of an image or three-dimensional form to the dimensions of the thing that is represented.","es":"Una designación general de la falta de una relación entre las dimensiones del contenido de una imagen o forma tridimensional y las dimensiones de la cosa que se representa.","et":"Üldine tähistus pildi või kolmemõõtmelise vormi sisu mõõtmete ja kujutatud asja mõõtmete suhte puudumise kohta.","fi":"Yleinen määrite kuvan tai kolmiulotteisen muodon ja niiden esittämän asian mittojen välisten mittasuhteiden puuttumisesta.","fr":"Désignation générale de l’absence de rapport entre les dimensions du contenu d’une image ou d’une forme tridimensionnelle et les dimensions de la chose représentée.","hu":"Egy általános megjelölés, amely egy kép vagy egy háromdimenziós forma tartalmának méretére és az általa ábrázolt dolog méretének viszonyítására vonatkozik.","lv":"Vispārējs attēla vai trīsdimensiju formas izmēru attiecības apzīmējums pret attēloto lietu izmēriem, nenorādot šo attiecību ar skaitļiem.","nl":"Een algemene aanduiding van het ontbreken van de verhouding van de afmetingen van de content van een beeld of driedimensionale vorm tot de afmetingen van het ding dat vertegenwoordigd wordt.","no":"En generell betegnelse som angir manglende målestokk for forholdet mellom målene til innholdet i et bilde eller en tredimensjonal form og målene til det som gjengis.","tr":"Bir görüntünün veya üç boyutlu formun içeriğinin boyutlarının temsil edilen şeyin boyutlarına oranının eksikliğinin genel bir tanımı.","vi":"Định danh chung của sự thiếu tỷ số giữa kích thước của nội dung của hình ảnh hoặc hình thái ba chiều với kích thước của vật được trình bày,","zh-Hans-CN":"关于一个图像或三维形式之内容的尺寸与其所表示的事物之尺寸之比缺失的一般标识"},"label":{"ar":"لها تعيين مقياس","ca":"té com a designació d’escala","cs":"má označení měřítka","da":"har målestoksbetegnelse","de":"hat Maßstabsbezeichnung","de":"hat Maßstabsbezeichnung","el":"έχει προσδιορισμό κλίμακας","en":"has scale designation","es":"tiene designación de escala","et":"mõõtkava tähistus","fi":"mittakaavan määrite","fr":"a pour désignation d’échelle","hu":"méretarány-jelölése a következő:","lv":"mēroga apzīmējums","nl":"heeft schaalaanduiding","no":"har betegnelse for målestokk","tr":"ölçek tanımlaması ile ilişkilidir","vi":"có định danh tỷ lệ","zh-Hans-CN":"有比例尺标识"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/scaleDesignation.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.25.6","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20291", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/scaleDesignation.en", "label":"has scale designation"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20291", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/scaleDesignation.en", "label":"has scale designation"}]},{"@id":"http://rdaregistry.info/Elements/e/P20058","label":{"ar":"لها وكيل مدون محاضر اجتماعات","ca":"té com a agent responsable de notes","cs":"má zapisovatele jednání (agenta)","da":"har agent, som er referent","de":"hat Protokollantin/Protokollanten (Akteur)","de":"hat Protokollantin/Protokollanten (Akteur)","el":"έχει πρακτικογράφο","en":"has minute taker agent","es":"tiene agente tomador de minutas","et":"protokollija (tegija)","fi":"pöytäkirjan laatija (toimija)","fr":"a pour agent procès-verbaliste","hu":"jegyzőkönyvvezető ágense a következő:","lv":"protokolētājs (aģents)","nl":"heeft notulist-actor","no":"har referent (agent)","tr":"zabıt katibi temsilcisi ile ilişkilidir","vi":"có người ghi biên bản","zh-Hans-CN":"有会议记录者行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل مسئول عن تدوين محضر اجتماع."],"ca":["Relaciona una expressió amb un agent que és responsable d’enregistrar les notes d’una reunió."],"cs":["Vztahuje vyjádření k agentovi, který je odpovědný za zápis průběhu jednání."],"da":["Relaterer et udtryk til en agent, som er ansvarlig for at tage referat ved et møde."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.,Setzt eine Expression in Beziehung zu einem Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist."],"el":["Συνδέει μια έκφραση με έναν φορέα υπεύθυνο για την καταγραφή των πρακτικών μιας συνάντησης."],"en":["Relates an expression to an agent who is responsible for recording the minutes of a meeting."],"es":["Relaciona una expresión con un agente que se encarga de levantar la minuta de una reunión."],"et":["Seostab väljenduse tegijaga, kes vastutab kohtumise protokollimise eest."],"fi":["Liittää ekspression toimijaan, joka vastaa kokouksen pöytäkirjan laatimisesta."],"fr":["Met une expression en relation avec un agent qui est responsable de rédiger le procès-verbal d’une réunion."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely felelős egy értekezlet jegyzőkönyvének a rögzítéséért."],"lv":["Sasaista izteiksmi ar aģentu, kas ir atbildīgs par sanāksmes protokola rakstīšanu."],"nl":["Relateert een expressie aan een actor die verantwoordelijk is voor het vastleggen van de notulen van een bijeenkomst."],"no":["Relaterer et uttrykk til en agent som har ansvar for å skrive møtereferater."],"tr":["Bir anlatımı, bir toplantının tutanaklarını kaydetmekten sorumlu olan bir temsilci ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân có trách nhiệm về ghi biên bản của cuộc họp."],"zh-Hans-CN":["将一种内容表达与对写会议记录负责的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مدون محاضر اجتماعات","ca":"agent responsable de notes","cs":"zapisovatel jednání (agent)","da":"agent, som er referent","de":"Protokollantin/Protokollant (Akteur)","de":"Protokollantin/Protokollant (Akteur)","el":"πρακτικογράφος","en":"minute taker agent","es":"agente tomador de minutas","et":"protokollija (tegija)","fi":"pöytäkirjan laatija (toimija)","fr":"agent procès-verbaliste","hu":"jegyzőkönyvvezető ágens:","lv":"protokolētājs (aģents)","nl":"notulist-actor","no":"referent (agent)","tr":"toplantıyı kayda geçiren temsilci","vi":"người ghi biên bản","zh-Hans-CN":"会议记录者行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن تدوين محضر اجتماع.","ca":"Agent que és responsable d’enregistrar les notes d’una reunió.","cs":"Agent, který je odpovědný za zápis průběhu jednání.","da":"Agent, som er ansvarlig for at tage referat ved et møde.","de":"Ein Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.","de":"Ein Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για την καταγραφή των πρακτικών μιας συνάντησης.","en":"An agent who is responsible for recording the minutes of a meeting.","es":"Un agente que se encarga de levantar la minuta de una reunión.","et":"Tegija, kes vastutab kohtumise protokollimise eest.","fi":"Toimija, joka vastaa kokouksen pöytäkirjan laatimisesta.","fr":"Agent qui est responsable de rédiger le procès-verbal d’une réunion.","hu":"Egy ágens, amely felelős egy értekezlet jegyzőkönyvének a rögzítéséért.","lv":"Aģents, kas ir atbildīgs par sanāksmes protokola rakstīšanu.","nl":"Een actor die verantwoordelijk is voor het vastleggen van de notulen van een bijeenkomst.","no":"En agent som har ansvar for å skrive møtereferater.","tr":"Bir toplantının tutanaklarını kaydetmekten sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm về ghi biên bản của cuộc họp.","zh-Hans-CN":"对写会议记录负责的一个行为者"},"altLabel":{"ar":["مدون محاضر اجتماعات"],"ca":["responsable de notes"],"cs":["zapisovatel jednání"],"da":["referent"],"de":["Protokollant,Protokollant"],"en":["minute taker"],"es":["tomador de minutas"],"et":["protokollija"],"fi":["pöytäkirjan laatija"],"fr":["procès-verbaliste"],"hu":["jegyzőkönyvvezető:"],"nl":["notulist"],"no":["referent"],"tr":["toplantıyı kayda geçiren"],"zh-Hans-CN":["会议记录者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20328", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorAgentToAmalgamation.en", "label":"has contributor agent to amalgamation"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/minuteTakerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20451", "lexicalAlias":"http://rdaregistry.info/Elements/e/minuteTakerCollectiveAgent.en", "label":"has minute taker collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20392", "lexicalAlias":"http://rdaregistry.info/Elements/e/minuteTakerPerson.en", "label":"has minute taker person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20058", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/minuteTakerAgent.en", "label":"has minute taker agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20058", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/minuteTakerAgent.en", "label":"has minute taker agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20451","label":{"ar":"لها وكيل جماعي مدون محاضر اجتماعات","ca":"té com a agent col·lectiu responsable de notes","cs":"má zapisovatele jednání (kolektivního agenta)","da":"har kollektiv agent, som er referent","de":"hat Protokollantin/Protokollant (Gemeinschaftlicher Akteur)","de":"hat Protokollantin/Protokollant (Gemeinschaftlicher Akteur)","en":"has minute taker collective agent","es":"tiene agente colectivo tomador de minutas","et":"protokollija (kollektiiv)","fi":"pöytäkirjan laatija (yhteistoimija)","fr":"a pour agent collectif procès-verbaliste","hu":"jegyzőkönyvvezető kollektív ágense a következő:","lv":"protokolētājs (grupa)","nl":"heeft notulist-collectieve actor","no":"har referent (kollektiv agent)","tr":"zabıt katibi kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有会议记录者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي مسئول عن تدوين محضر اجتماع."],"ca":["Relaciona una expressió amb un agent col·lectiu que és responsable d’enregistrar les notes d’una reunió."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je odpovědný za zápis průběhu jednání."],"da":["Relaterer et udtryk til en kollektiv agent, som er ansvarlig for at tage referat ved et møde."],"de":["Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.,Setzt eine Expression in Beziehung zu einem gemeinschaftlichen Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist."],"en":["Relates an expression to a collective agent who is responsible for recording the minutes of a meeting."],"es":["Relaciona una expresión con un agente colectivo que es responsable de registrar las minutas de una reunión."],"et":["Seostab väljenduse kollektiiviga, kes vastutab kohtumise protokollimise eest."],"fi":["Liittää ekspression yhteistoimijaan, joka vastaa kokouksen pöytäkirjan laatimisesta."],"fr":["Met une expression en relation avec un agent collectif qui est responsable de rédiger le procès-verbal d’une réunion."],"hu":["Hozzákapcsol egy kifejezési formát egy kollektív ágenshez, amely felelős egy értekezlet jegyzőkönyvének a rögzítéséért."],"lv":["Sasaista izteiksmi ar grupu, kas ir atbildīga par sanāksmes protokola rakstīšanu."],"nl":["Relateert een expressie aan een collectieve actor die verantwoordelijk is voor het vastleggen van de notulen van een bijeenkomst."],"no":["Relaterer et uttrykk til en kollektiv agent som har ansvar for å ta møtereferater."],"tr":["Bir anlatımı, bir toplantı tutanaklarının kaydından sorumlu olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与对写会议记录负责的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مدون محاضر اجتماعات","ca":"agent col·lectiu responsable de notes","cs":"zapisovatel jednání (kolektivní agent)","da":"kollektiv agent, som er referent","de":"Protokollantin/Protokollant (Gemeinschaftlicher Akteur)","de":"Protokollantin/Protokollant (Gemeinschaftlicher Akteur)","en":"minute taker collective agent","es":"agente colectivo tomador de minutas","et":"protokollija (kollektiiv)","fi":"pöytäkirjan laatija (yhteistoimija)","fr":"agent collectif procès-verbaliste","hu":"jegyzőkönyvvezető kollektív ágens:","lv":"protokolētājs (grupa)","nl":"notulist-collectieve actor","no":"referent (kollektiv agent)","tr":"toplantıyı kayda geçiren kolektif temsilci","zh-Hans-CN":"会议记录者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن تدوين محضر اجتماع.","ca":"Agent col·lectiu que és responsable d’enregistrar les notes d’una reunió.","cs":"Kolektivní agent, který je odpovědný za zápis průběhu jednání.","da":"Kollektiv agent, som er ansvarlig for at tage referat ved et møde.","de":"Ein gemeinschaftlicher Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.","de":"Ein gemeinschaftlicher Akteur, der für das Aufzeichnen des Protokolls einer Sitzung verantwortlich ist.","en":"A collective agent who is responsible for recording the minutes of a meeting.","es":"Un agente colectivo que es responsable de registrar las minutas de una reunión.","et":"Kollektiiv, kes vastutab kohtumise protokollimise eest.","fi":"Yhteistoimija, joka vastaa kokouksen pöytäkirjan laatimisesta.","fr":"Agent collectif qui est responsable de rédiger le procès-verbal d’une réunion.","hu":"Egy kollektív ágens, amely felelős egy értekezlet jegyzőkönyvének a rögzítéséért.","lv":"Grupa, kas ir atbildīga par sanāksmes protokola rakstīšanu.","nl":"Een collectieve actor die verantwoordelijk is voor het vastleggen van de notulen van een bijeenkomst.","no":"En kollektiv agent som har ansvar for å ta møtereferater.","tr":"Bir toplantı tutanaklarının kaydından sorumlu olan kolektif bir temsilcidir.","zh-Hans-CN":"对写会议记录负责的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
