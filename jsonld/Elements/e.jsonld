                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/radioScriptExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20160", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/radioScriptExpression.en", "label":"has radio script expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20160", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/radioScriptExpression.en", "label":"has radio script expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20050","label":{"ar":"لها وكيل مهندس تسجيل","ca":"té com a agent enginyer de so","cs":"má technika záznamu (agenta)","da":"har agent, som er indspilningstekniker","de":"hat Aufnahmetechnikerin/Aufnahmetechniker (Akteur)","de":"hat Aufnahmetechnikerin/Aufnahmetechniker (Akteur)","el":"έχει μηχανικό ηχογράφησης","en":"has recording engineer agent","es":"tiene agente ingeniero de grabación","et":"salvestusinsener (tegija)","fi":"äänittäjä (toimija)","fr":"a pour agent preneur de son","hu":"hangrögzítő ágense a következő:","lv":"ierakstu inženieris (aģents)","nl":"heeft opnametechnicus-actor","no":"har innspillingstekniker (agent)","tr":"kayıt mühendisi temsilcisi ile ilişkilidir","vi":"có kỹ sư ghi","zh-Hans-CN":"有录制工程师行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل يكون مهندس تسجيل يساهم في محتوى صوتي لتعبيرة بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل."],"ca":["Relaciona una expressió amb un agent que és un enginyer d’àudio que contribueix al contingut àudio d’una expressió amb la supervisió dels aspectes tècnics d’una sessió d’enregistrament."],"cs":["Vztahuje vyjádření k agentovi, který je zvukovým technikem, který přispívá ke zvukovému obsahu vyjádření tím, že dohlíží na technické aspekty nahrávání."],"da":["Relaterer et udtryk til en agent, som er en lydtekniker, som bidrager til lydindholdet af et udtryk ved at føre tilsyn med de tekniske aspekter af en lyd- eller videooptagelse."],"de":["Setzt eine Expression in Beziehung zu einer Tontechnikerin/einem Tontechniker (Akteur), die/der zum Toninhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht.,Setzt eine Expression in Beziehung zu einer Tontechnikerin/einem Tontechniker (Akteur), die/der zum Toninhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht."],"el":["Συνδέει μια έκφραση με έναν μηχανικό ήχου ο οποίος συνεισφέρει στο ακουστικό περιεχόμενο μιας έκφρασης μέσω της εποπτείας των τεχνικών πτυχών μιας ηχογράφησης."],"en":["Relates an expression to an agent who is an audio engineer who contributes to the audio content of an expression by supervising the technical aspects of a recording session."],"es":["Relaciona una expresión con un agente que es un ingeniero de audio que contribuye al contenido de audio de una expresión supervisando los aspectos técnicos de una sesión de grabación."],"et":["Seostab väljenduse tegijaga, kes heliinsenerina annab panuse väljenduse helisisusse, juhendades salvestamise tehnilisi aspekte."],"fi":["Liittää ekspression toimijaan, joka on ääniteknikko, joka osallistuu ekspression äänisisällön tekemiseen valvomalla äänityksen teknistä toteutusta."],"fr":["Met une expression en relation avec un agent ingénieur du son qui contribue au contenu audio d’une expression en supervisant les aspects techniques d’une séance d’enregistrement."],"hu":["Hozzákapcsol egy kifejezési formát egy hangmester ágenshez, amely egy felvétel technikai vonatkozásainak felügyeletével hozzájárul egy kifejezési forma audio-tartalmához ."],"lv":["Sasaista izteiksmi ar aģentu, kas ir audio inženieris, kurš sniedz ieguldījumu izteiksmes audio saturā, uzraugot tehniskos parametrus ieraksta laikā."],"nl":["Relateert een expressie aan een actor die een geluidstechnicus is die bijdraagt aan de geluidscontent van een expressie door het toezicht houden op de technische aspecten van een opnamesessie."],"no":["Relaterer et uttrykk til en agent som er en lydtekniker som bidrar til lydinnholdet i et uttrykk ved å styre de tekniske aspektene ved en innspilling."],"tr":["Bir anlatımı, bir kayıt oturumunun teknik yönlerini denetleyerek anlatımın ses içeriğine katkıda bulunan bir ses mühendisi olan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với kỹ sư audio đóng góp cho nội dung audio của biểu hiện bằng cách kiểm soát các khía cạnh kỹ thuật của buổi ghi."],"zh-Hans-CN":["将一种内容表达与作为一个音频工程师通过监督一个录制过程中的技术方面而对一种内容表达的音频内容有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مهندس تسجيل","ca":"agent enginyer de so","cs":"technik záznamu (agent)","da":"agent, som er indspilningstekniker","de":"Aufnahmetechnikerin/Aufnahmetechniker (Akteur)","de":"Aufnahmetechnikerin/Aufnahmetechniker (Akteur)","el":"μηχανικός ηχογράφησης","en":"recording engineer agent","es":"agente ingeniero de grabación","et":"salvestusinsener (tegija)","fi":"äänittäjä (toimija)","fr":"agent preneur de son","hu":"hangrögzítő ágens:","lv":"ierakstu inženieris (aģents)","nl":"opnametechnicus-actor","no":"innspillingstekniker (agent)","tr":"kayıt mühendisi temsilcisi","vi":"kỹ sư ghi","zh-Hans-CN":"录制工程师行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مهندس تسجيل يساهم في محتوى صوتي لتعبيرة بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل.","ca":"Agent que és un enginyer d’àudio que contribueix al contingut àudio d’una expressió amb la supervisió dels aspectes tècnics d’una sessió d’enregistrament.","cs":"Agent, který je zvukovým technikem, který přispívá ke zvukovému obsahu vyjádření tím, že dohlíží na technické aspekty nahrávání.","da":"Agent, som er en lydtekniker, som bidrager til lydindholdet af et udtryk ved at føre tilsyn med de tekniske aspekter af en lyd- eller videooptagelse.","de":"Eine Tontechnikerin/Ein Tontechniker (Akteur), die/der zum Toninhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht.","de":"Eine Tontechnikerin/Ein Tontechniker (Akteur), die/der zum Toninhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht.","el":"Ένας μηχανικός ήχου ο οποίος συνεισφέρει στο ακουστικό περιεχόμενο μιας έκφρασης μέσω της εποπτείας των τεχνικών πτυχών μιας ηχογράφησης.","en":"An agent who is an audio engineer who contributes to the audio content of an expression by supervising the technical aspects of a recording session.","es":"Un agente que es un ingeniero de audio que contribuye al contenido de audio de una expresión supervisando los aspectos técnicos de una sesión de grabación.","et":"Tegija, kes heliinsenerina annab panuse väljenduse helisisusse, juhendades salvestamise tehnilisi aspekte.","fi":"Toimija, joka on ääniteknikko, joka osallistuu ekspression äänisisällön tekemiseen valvomalla äänityksen teknistä toteutusta.","fr":"Agent ingénieur du son qui contribue au contenu audio d’une expression en supervisant les aspects techniques d’une séance d’enregistrement.","hu":"Egy hangmester ágens, amely egy felvétel technikai vonatkozásainak felügyeletével hozzájárul egy kifejezési forma audio-tartalmához.","lv":"Aģents - audio inženieris, kurš sniedz ieguldījumu izteiksmes audio saturā, uzraugot tehniskos parametrus ieraksta laikā.","nl":"Een actor die een geluidstechnicus is die bijdraagt aan de geluidscontent van een expressie door het toezicht houden op de technische aspecten van een opnamesessie.","no":"En agent som er en lydtekniker som bidrar til lydinnholdet i et uttrykk ved å styre de tekniske aspektene ved en innspilling.","tr":"Bir kayıt oturumunun teknik yönlerini denetleyerek bir anlatımın ses içeriğine katkıda bulunan bir ses mühendisi olan temsilci.","vi":"Kỹ sư audio đóng góp cho nội dung audio của biểu hiện bằng cách kiểm soát các khía cạnh kỹ thuật của buổi ghi.","zh-Hans-CN":"作为一个音频工程师通过监督一个录制过程中的技术方面而对一种内容表达的音频内容有贡献的一个行为者"},"altLabel":{"ar":["مهندس تسجيل"],"ca":["enginyer de so"],"cs":["technik záznamu"],"da":["indspilningstekniker"],"de":["Aufnahmetechniker,Aufnahmetechniker"],"en":["recording engineer"],"es":["ingeniero de grabación"],"et":["salvestusinsener"],"fi":["äänittäjä"],"fr":["preneur de son"],"hu":["hangrögzítő:"],"nl":["opnametechnicus"],"no":["innspillingstekniker"],"tr":["kayıt mühendisi"],"zh-Hans-CN":["录制工程师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
