                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/storytellerCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20438", "lexicalAlias":"http://rdaregistry.info/Elements/e/storytellerCollectiveAgent.en", "label":"has storyteller collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20497", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/storytellerCorporateBody.en", "label":"has storyteller corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20497", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/storytellerCorporateBody.en", "label":"has storyteller corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20556","label":{"ar":"لها عائلة راوية قصص","ca":"té com a família rondallaire","cs":"má vypravěče příběhů (rodinu)","da":"har familie, som er historiefortæller","de":"hat Geschichtenerzählerin/Geschichtenerzähler (Familie)","de":"hat Geschichtenerzählerin/Geschichtenerzähler (Familie)","en":"has storyteller family","es":"es familia cuentista","et":"jutuvestja (perekond)","fi":"tarinankertoja (suku)","fr":"a pour famille conteuse","hu":"történetmesélő családja a következő:","lv":"stāstnieks (dzimta/ģimene)","nl":"heeft verhalenverteller-familie","no":"har historieforteller (familie)","tr":"hikaye anlatıcısı ailesi ile ilişkilidir","zh-Hans-CN":"有说书人家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تكون مؤديًا يساهم في تعبيرة من خلال نقل قصة أصلية ووصفها بصورة درامية أو مسرحية."],"ca":["Relaciona una expressió amb una família que és un intèrpret que contribueix a una expressió explicant un conte amb una interpretació dramàtica o teatral."],"cs":["Vztahuje vyjádření k rodině, která je účinkujícím, který přispívá k vyjádření tím, že podává příběh s dramatickou nebo divadelní interpretací."],"da":["Relaterer et udtryk til en familie, som er en udøver, som bidrager til et udtryk ved at gengive en ophavspersons oprindelige historie med dramatisk eller teatralsk fortolkning."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt."],"en":["Relates an expression to a family who is a performer who contributes to an expression by relaying a story with dramatic or theatrical interpretation."],"es":["Relaciona una expresión con una familia que es un intérprete que contribuye a una expresión al transmitir una historia con una interpretación dramática o teatral."],"et":["Seostab väljenduse perekonnaga, kes esitajana annab panuse väljendusse, esitades autori originaallugu draama- või teatritõlgenduses."],"fi":["Liittää ekspression sukuun, joka on esittäjä, joka osallistuu ekspression tekemiseen kertomalla tarinan draamallisella tai teatraalisella tulkinnalla."],"fr":["Met une expression en relation avec une famille interprète qui contribue à une expression en racontant une histoire au moyen d’une interprétation dramatique ou théâtrale."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó családhoz, amely hozzájárul egy kifejezési formához azzal, hogy egy alkotó eredeti történetét drámai vagy színházi értelmezéssel tolmácsolja."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, pasniedzot radītāja sākotnējo stāstu ar dramatisku vai teatrālu interpretāciju."],"nl":["Relateert een expressie aan een familie die een uitvoerder is die bijdraagt aan een expressie door het doorvertellen van een verhaal met dramatische of theatrale vertolking."],"no":["Relaterer et uttrykk til en familie som er en utøver som bidrar til et uttrykk ved å lese forfatterens originalhistorie med innlevelse eller dramatisk tolkning."],"tr":["Bir anlatımı, dramatik veya teatral bir yorumla bir hikaye aktararak bir anlatıma katkıda bulunan bir sanatçı olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过用戏剧化解释转达故事而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة راوية قصص","ca":"família rondallaire","cs":"vypravěč příběhů (rodina)","da":"familie, som er historiefortæller","de":"Geschichtenerzählerin/Geschichtenerzähler (Familie)","de":"Geschichtenerzählerin/Geschichtenerzähler (Familie)","en":"storyteller family","es":"familia cuentista","et":"jutuvestja (perekond)","fi":"tarinankertoja (suku)","fr":"famille conteuse","hu":"történetmesélő család:","lv":"stāstnieks (dzimta/ģimene)","nl":"verhalenverteller-familie","no":"historieforteller (familie)","tr":"hikaye anlatıcısı aile","zh-Hans-CN":"说书人家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤديًا يساهم في تعبيرة من خلال نقل قصة أصلية ووصفها بصورة درامية أو مسرحية.","ca":"Família que és un intèrpret que contribueix a una expressió explicant un conte amb una interpretació dramàtica o teatral.","cs":"Rodina, která je účinkujícím, který přispívá k vyjádření tím, že podává příběh s dramatickou nebo divadelní interpretací.","da":"Familie, som er en udøver, som bidrager til et udtryk ved at gengive en ophavspersons oprindelige historie med dramatisk eller teatralsk fortolkning.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er eine Geschichte mit dramatischer oder theatralischer Interpretation wiedergibt.","en":"A family who is a performer who contributes to an expression by relaying a story with dramatic or theatrical interpretation.","es":"Una familia que es un intérprete que contribuye a una expresión al transmitir una historia con una interpretación dramática o teatral.","et":"Perekond, kes esitajana annab panuse väljendusse, esitades autori originaallugu draama- või teatritõlgenduses.","fi":"Suku, joka on esittäjä, joka osallistuu ekspression tekemiseen kertomalla tarinan draamallisella tai teatraalisella tulkinnalla.","fr":"Famille interprète qui contribue à une expression en racontant une histoire au moyen d’une interprétation dramatique ou théâtrale.","hu":"Egy előadó család, amely hozzájárul egy kifejezési formához azzal, hogy egy alkotó eredeti történetét drámai vagy színházi értelmezéssel tolmácsolja.","lv":"Dzimta/ģimene - izpildītājs, kas sniegusi ieguldījumu izteiksmē, pasniedzot radītāja sākotnējo stāstu ar dramatisku vai teatrālu interpretāciju.","nl":"Een familie die een uitvoerder is die bijdraagt aan een expressie door het doorvertellen van een verhaal met dramatische of theatrale vertolking.","no":"En familie som er en utøver som bidrar til et uttrykk ved å lese forfatterens originalhistorie med innlevelse eller dramatisk tolkning.","tr":"Dramatik veya teatral yorumla bir hikayeyi aktararak anlatıma katkıda bulunan sanatçı bir aile.","zh-Hans-CN":"作为一个表演者通过用戏剧化解释转达故事而对一种内容表达有贡献的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
