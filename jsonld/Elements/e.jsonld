                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/recordistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20366", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorPersonToPerformance.en", "label":"has contributor person to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20052", "lexicalAlias":"http://rdaregistry.info/Elements/e/recordistAgent.en", "label":"has recordist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20358", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/recordistPerson.en", "label":"has recordist person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20358", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/recordistPerson.en", "label":"has recordist person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20333","label":{"ar":"لها كيان مرتبط بتعبيرة","ca":"té com a entitat relacionada amb una expressió","cs":"má související entitu (vyjádření)","da":"har entitet relateret til udtryk","de":"hat mit Expression in Beziehung stehende Entität","de":"hat mit Expression in Beziehung stehende Entität","en":"has related entity of expression","es":"tiene entidad de expresión relacionada","et":"väljendusega seotud olem","fi":"ekspressioon liittyvä entiteetti","fr":"a pour entité en relation avec une expression","hu":"kifejezési forma kapcsolódó entitása a következő:","lv":"ar izteiksmi saistītā entīte","nl":"heeft gerelateerde entiteit van expressie","no":"har relatert entitet for uttrykk","tr":"anlatımın ilgili varlığı ile ilişkilidir","zh-Hans-CN":"有内容表达的关联实体"},"definition":{"ar":["تربط بين تعبيرة ومفردة مرتبطة بتعبيرة."],"ca":["Relaciona una expressió amb una entitat que s’associa amb una expressió."],"cs":["Vztahuje vyjádření k entitě, která je spojená s vyjádřením."],"da":["Relaterer et udtryk til en entitet, som er knyttet til et udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Entität, die mit einer Expression in Verbindung steht.,Setzt eine Expression in Beziehung zu einer Entität, die mit einer Expression in Verbindung steht."],"en":["Relates an expression to an entity that is associated with an expression."],"es":["Relaciona una expresión con una entidad asociada a una expresión."],"et":["Seostab väljenduse väljendusega seotud olemiga."],"fi":["Liittää ekspression entiteettiin, joka liittyy ekspressioon."],"fr":["Met une expression en relation avec une entité qui est associée à une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy entitáshoz, amelyet egy kifejezési formához társítanak."],"lv":["Sasaista izteiksmi ar entīti, kas saistīta ar izteiksmi."],"nl":["Relateert een expressie aan een entiteit die geassocieerd is met een expressie."],"no":["Relaterer et uttrykk til en entitet som forbindes med et uttrykk."],"tr":["Bir anlatımı, anlatımla ile bağlantılı olan bir varlık ile ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与和一种内容表达有关的一个实体关联起来。"]},"ToolkitLabel":{"ar":"كيان مرتبط بتعبيرة","ca":"entitat relacionada amb una expressió","cs":"související entita","da":"har entitet relateret til udtryk","de":"mit Expression in Beziehung stehende Entität","de":"mit Expression in Beziehung stehende Entität","en":"related entity of expression","es":"entidad de expresión relacionada","et":"väljendusega seotud olem","fi":"ekspressioon liittyvä entiteetti","fr":"entité en relation avec une expression","hu":"kifejezési forma kapcsolódó entitása:","lv":"ar izteiksmi saistītā entīte","nl":"gerelateerde entiteit van expressie","no":"relatert entitet for uttrykk","tr":"Anlatımın ilişkili olduğu varlık","zh-Hans-CN":"内容表达的关联实体"},"ToolkitDefinition":{"ar":"مفردة مرتبطة بتعبيرة.","ca":"Entitat que s’associa amb una expressió.","cs":"Entita, která je spojená s vyjádřením.","da":"Entite