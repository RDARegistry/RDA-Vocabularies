                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/placeOfCapture.en","instructionNumber":"7.11.2","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20306", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedPlaceOfExpression.en", "label":"has related place of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20217", "lexicalAlias":"http://rdaregistry.info/Elements/e/captureInformation.en", "label":"has capture information"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20218", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/placeOfCapture.en", "label":"has place of capture"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20218", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/placeOfCapture.en", "label":"has place of capture"}]},{"@id":"http://rdaregistry.info/Elements/e/P20101","label":{"ar":"هي منفصلة إلى تعبيرة","ca":"és separat en una expressió","cs":"oddělilo se vyjádření","da":"er separeret ind i udtryk","de":"ist teilweise fortgesetzt von (Expression)","de":"ist teilweise fortgesetzt von (Expression)","el":"συνεχίζεται μερικώς από (έκφραση)","en":"is separated into expression","es":"se separa en expresión","et":"eraldunud väljendus","fi":"eronnut ekspressioksi","fr":"est continué en partie par une expression","hu":"szétválva a következő kifejezési formára:","lv":"ir atdalītā izteiksme","nl":"is afgesplitst in expressie","no":"fortsettes delvis i uttrykk","tr":"anlatıma ayrılmıştır","vi":"được tiếp tục theo phần bằng (biểu hiện)","zh-Hans-CN":"被分离出而成的内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل ممتد زمنيًا يُكْمل المحتوى الجزئي لعمل آخر ممتد زمنيًا ومستمر."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una obra diacrònica que continua el contingut parcial d’una altra obra diacrònica que és contínua."],"cs":["Vztahuje vyjádření k vyjádření díla, které je diachronním dílem, které navazuje částečný obsah jiného diachronního díla, které pokračuje."],"da":["Relaterer et udtryk til et udtryk af et værk, som er et diakronisk værk, som fortsætter det delvise indhold af et andet diakronisk værk, som er fortløbende."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines diachronen Werks, die den Teilinhalt eines anderen fortlaufenden, diachronen Werks fortsetzt.,Setzt eine Expression in Beziehung zu einer Expression eines diachronen Werks, die den Teilinhalt eines anderen fortlaufenden, diachronen Werks fortsetzt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου μέρος του περιεχομένου του οποίου διαχωρίστηκε από μια προηγούμενη έκφραση για να σχηματίσει μια νέα έκφραση."],"en":["Relates an expression to an expression of a work that is a diachronic work that continues the partial content of another diachronic work that is continuing."],"es":["Relaciona una expresión con la expresión de una obra que es una obra diacrónica que continúa el contenido parcial de otra obra diacrónica que continúa."],"et":["Seostab väljenduse väljendusega diakroonilisest teosest, mis jätkab osaliselt teise, jätkuva diakroonilise teose sisu."],"fi":["Liittää ekspression teoksen ekspressioon, joka on diakroninen teos, joka jatkaa toisen diakronisen jatkuvan teoksen sisältöä osittain."],"fr":["Met une expression en relation avec une expression d’une œuvre diachronique qui continue le contenu partiel d’une autre œuvre diachronique qui se poursuit."],"hu":["Hozzákapcsol egy kifejezési formát egy diakronikus mű kifejezési formához, amely egy másik folytatódó diakronikus forrás részleges tartalmát folytatja."],"lv":["Sasaista izteiksmi ar diahroniska darba izteiksmi, kas turpina cita diahroniska darba daļēju saturu, kas turpinās.šis elements vispārīgi attiecas uz secīga darba izteiksmi."],"nl":["Relateert een expressie aan een expressie van een werk dat een diachronisch werk is dat de gedeeltelijke content voortzet van een ander diachronisch werk dat voortgezet wordt."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er et diakronisk verk som er en delvis fortsettelse av innholdet i et annet løpende diakronisk verk."],"tr":["Bir anlatımı, devam etmekte olan başka bir artzamanlı eserin kısmi içeriğini devam ettiren artzamanlı bir eser olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm mà phần của nội dung được phân tách từ biểu hiện trước đây để hình thành biểu hiện mới."],"zh-Hans-CN":["将一种内容表达与作为一种历时作品、继承另一种现行的历时作品的部分内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"منفصلة إلى تعبيرة","ca":"separat en una expressió","cs":"odděleno do vyjádření","da":"separeret ind i udtryk","de":"Teilweise fortgesetzt von (Expression)","de":"Teilweise fortgesetzt von (Expression)","el":"συνεχίζεται μερικώς από (έκφραση)","en":"separated into expression","es":"separado en expresión","et":"eraldunud väljendus","fi":"eronnut ekspressioksi","fr":"continué en partie par une expression","hu":"szétválva a következő kifejezési formára:","lv":"atdalītā izteiksme","nl":"afgesplitst in expressie","no":"fortsettes delvis i uttrykk","tr":"anlatıma ayrılmış","vi":"được tiếp tục theo phần bằng (biểu hiện)","zh-Hans-CN":"被分离出而成的内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل ممتد زمنيًا يُكْمل المحتوى الجزئي لعمل آخر ممتد زمنيًا ومستمر.","ca":"Expressió d’una obra que és una obra diacrònica que continua el contingut parcial d’una altra obra diacrònica que és contínua.","cs":"Vyjádření díla, které je diachronním dílem, které navazuje částečný obsah jiného diachronního díla, které pokračuje.","da":"Udtryk af et værk, som er et diakronisk værk, som fortsætter det delvise indhold af et andet diakronisk værk, som er fortløbende.","de":"Eine Expression eines diachronen Werks, die den Teilinhalt eines anderen fortlaufenden, diachronen Werks fortsetzt.","de":"Eine Expression eines diachronen Werks, die den Teilinhalt eines anderen fortlaufenden, diachronen Werks fortsetzt.","el":"Μια έκφραση ενός έργου μέρος του περιεχομένου του οποίου διαχωρίστηκε από μια προηγούμενη έκφραση για να σχηματίσει μια νέα έκφραση.","en":"An expression of a work that is a diachronic work that continues the partial content of another diachronic work that is continuing.","es":"Una expresión de una obra que es una obra diacrónica que continúa el contenido parcial de otra obra diacrónica que continúa.","et":"Väljendus diakroonilisest teosest, mis jätkab osaliselt teise, jätkuva diakroonilise teose sisu.","fi":"Sellaisen teoksen ekspressio, joka on diakroninen teos, joka jatkaa toisen diakronisen jatkuvan teoksen sisältöä osittain.","fr":"Expression d’une œuvre diachronique qui continue le contenu partiel d’une autre œuvre diachronique qui se poursuit.","hu":"Egy diakronikus mű kifejezési formához, amely egy másik folytatódó diakronikus forrás részleges tartalmát folytatja.","lv":"Diahroniska darba izteiksme, kas turpina cita diahroniska darba daļēju saturu, kas turpinās.","nl":"Een expressie van een werk dat een diachronisch werk is dat de gedeeltelijke content voortzet van een ander diachronisch werk dat voortgezet wordt.","no":"Et uttrykk av et verk som er et diakronisk verk som er en delvis fortsettelse av innholdet i et annet løpende diakronisk verk.","tr":"Devam etmekte olan başka bir artzamanlı eserin kısmi içeriğini devam ettiren artzamanlı bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm mà phần của nội dung được phân tách từ biểu hiện trước đây để hình thành biểu hiện mới.","zh-Hans-CN":"作为一种历时作品、继承另一种现行的历时作品的部分内容的一种作品的一种内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل متتالٍ."],"ca":["En general, aquest element s’aplica a una expressió d’una obra successiva."],"cs":["Tento termín se obecně vztahuje na postupně vydávané dílo."],"da":["Dette element gælder generelt for et udtryk af et fortløbende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu."],"el":["Αυτή η σχέση βρίσκει εφαρμογή γενικά στα περιοδικά."],"en":["This element applies in general to an expression of a successive work."],"es":["Este elemento se aplica en general a una expresión de una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre successive."],"hu":["Ezt az elemet általában egymást követő mű kifejezési formájára alkalmazzák."],"lv":["Šis elements vispārīgi attiecas uz secīga darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een successief werk."],"no":["Dette elementet gjelder som oftest for et uttrykk av et fortløpende verk."],"tr":["Bu öğe, genel olarak ardışık bir eserin anlatımı için geçerlidir."],"vi":["Mối quan hệ này áp dụng nói chung cho ấn phẩm nhiều kỳ."],"zh-Hans-CN":["该元素一般适用于一种相继作品的一种内容表达。"]},"altLabel":{"ar":["مستمرة جزئيًا بـ (تعبيرة)"],"ca":["continuat en part per (expressió)"],"cs":["pokračováno částečně v (vyjádření)"],"da":["fortsat delvis af (udtryk)"],"de":["Teilweise aufgegangen in (Expression),Teilweise aufgegangen in (Expression)"],"en":["continued in part by (expression)"],"es":["continuado en parte por (expresión)"],"fi":["jatkuu osittain ekspressiossa"],"fr":["continué en partie par (expression)"],"hu":["részben folytatja a következő (kifejezési forma):"],"nl":["deels voorgezet door (expressie)"],"no":["fortsettes delvis i uttrykk"],"tr":["(anlatımın) bir kısmı ile devam edilir"],"zh-Hans-CN":["部分被继承（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/separatedIntoExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20101", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/separatedIntoExpression.en", "label":"is separated into expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20101", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/separatedIntoExpression.en", "label":"is separated into expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20335","label":{"ar":"لها تعبيرة تتمة","ca":"té com a expressió de seqüela","cs":"má sequel (vyjádření)","da":"har udtryk, som er efterfølger","de":"hat Sequel (Expression)","de":"hat Sequel (Expression)","en":"has sequel expression","es":"tiene expresión de secuela","et":"järg (väljendus)","fi":"jatko-osa (ekspressio)","fr":"a pour suite (expression)","hu":"folytatás kifejezési formája a következő:","lv":"izteiksme: pēcstāsts","nl":"heeft sequel-expressie","no":"har etterfølger (uttrykk)","tr":"sonraki anlatım ile ilişkilidir","zh-Hans-CN":"有续篇内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يمتد من خلاله سرد تعبيرة لعمل آخر للأمام عبر الزمن."],"ca":["Relaciona una expressió amb una expressió d’una obra que amplia la narrativa d’una expressió d’una altra obra cap endavant en el temps."],"cs":["Vztahuje vyjádření k vyjádření díla, které rozšiřuje děj vyjádření jiného díla kupředu v čase."],"da":["Relaterer et udtryk til et udtryk af et værk, som forlænger et udtryks fortælling af et andet værk frem i tid."],"de":["Setzt eine Expression in Beziehung zu Expression eines Werks, die den Erzählstrang einer Expression eines anderen Werks zeitlich vorwärts erweitert.,Setzt eine Expression in Beziehung zu Expression eines Werks, die den Erzählstrang einer Expression eines anderen Werks zeitlich vorwärts erweitert."],"en":["Relates an expression to an expression of a work that extends the narrative of an expression of another work forwards in time."],"es":["Relaciona una expresión con una expresión de una obra que extiende la narrativa de una expresión de otra obra hacia adelante en el tiempo."],"et":["Seostab väljenduse teose väljendusega, mis laiendab teise teose väljenduse sündmuste esitust ajas edasi."],"fi":["Liittää ekspression teoksen ekspressioon, joka laajentaa toisen teoksen ekspression kerrontaa ajassa eteenpäin."],"fr":["Met une expression en relation avec une expression d’une œuvre qui prolonge le récit d’une expression d’une autre œuvre sur une période plus récente dans le temps."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amely időben előre terjeszti ki egy másik mű kifejezési formájának narratíváját."],"lv":["Sasaista izteiksmi ar darba izteiksmi (sīkvels), kas paplašina cita darba stāstījumu pēc sākotnējā notikuma."],"nl":["Relateert een expressie aan een expressie van een werk dat de narratie van een expresssie van een ander werk voorwaarts in de tijd uitbreidt."],"no":["Relaterer et uttrykk til et uttrykk av et verk hvor hendelsesforløpet fra et annet verk fortsetter i tid."],"tr":["Bir anlatımı, başka bir eserin anlatımını zamanda ileriye doğru genişleten bir eserin anlatımıyla ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与把另一种作品的一种内容表达的叙述在时间上往前延伸的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة تتمة","ca":"expressió de seqüela","cs":"sequel (vyjádření)","da":"udtryk, som er efterfølger","de":"Sequel (Expression)","de":"Sequel (Expression)","en":"sequel expression","es":"expresión de secuela","et":"järg (väljendus)","fi":"jatko-osa (ekspressio)","fr":"suite (expression)","hu":"folytatás kifejezési formája:","lv":"izteiksme: pēcstāsts","nl":"sequel-expressie","no":"etterfølger (uttrykk)","tr":"devam anlatımı","zh-Hans-CN":"续篇内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يمتد من خلاله سرد تعبيرة لعمل آخر للأمام عبر الزمن.","ca":"Expressió d’una obra que amplia la narrativa d’una expressió d’una altra obra cap endavant en el temps.","cs":"Vyjádření díla, které rozšiřuje děj vyjádření jiného díla kupředu v čase.","da":"Udtryk af et værk, som forlænger et udtryks fortælling af et andet værk frem i tid.","de":"Eine Expression eines Werks, die den Erzählstrang einer Expression eines anderen Werks zeitlich vorwärts erweitert.","de":"Eine Expression eines Werks, die den Erzählstrang einer Expression eines anderen Werks zeitlich vorwärts erweitert.","en":"An expression of a work that extends the narrative of an expression of another work forwards in time.","es":"Una expresión de una obra que extiende la narrativa de una expresión de otra obra hacia adelante en el tiempo.","et":"Teose väljendus, mis laiendab teise teose väljenduse sündmuste esitust ajas edasi.","fi":"Teoksen ekspressio, joka laajentaa toisen teoksen ekspression kerrontaa ajassa eteenpäin.","fr":"Expression d’une œuvre qui prolonge le récit d’une expression d’une autre œuvre sur une période plus récente dans le temps.","hu":"Egy kifejezési forma, amely időben előre terjeszti ki egy másik mű kifejezési formájának narratíváját.","lv":"Darba izteiksme (sīkvels), kas paplašina cita darba stāstījumu pēc sākotnējā notikuma.","nl":"Een expressie van een werk dat de narratie van een expresssie van een ander werk voorwaarts in de tijd uitbreidt.","no":"Et uttrykk av et verk hvor hendelsesforløpet fra et annet verk fortsetter i tid.","tr":"Zamanda ileriye dönük başka bir eserin anlatımını genişleten bir eserin anlatımı.","zh-Hans-CN":"把另一种作品的一种内容表达的叙述在时间上往前延伸的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
