 cao của hình ảnh động.","zh-Hans-CN":"一种动态图像的宽和高的比之细节"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfAspectRatioDesignation.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.19.1.4.1.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20260", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfAspectRatioDesignation.en", "label":"has details of aspect ratio designation (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20162","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يقدم نصًا لفيديو."],"ca":["Relaciona una expressió amb una expressió d’una obra que proporciona el text d’un vídeo."],"cs":["Vztahuje vyjádření k vyjádření díla, které poskytuje text pro video."],"da":["Relaterer et udtryk af et udtryk af et værk, som angiver tekst til en video."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für ein Video liefert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für ein Video liefert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο παρέχει κείμενο για ένα βίντεο."],"en":["Relates an expression to an expression of a work that provides text for a video."],"es":["Relaciona una expresión con una expresión de una obra que proporciona texto para un vídeo."],"et":["Seostab väljenduse teose väljendusega, mis annab teksti videofilmile."],"fi":["Liittää ekspression teoksen ekspressioon, joka on videon käsikirjoitus."],"fr":["Met une expression en relation avec une expression d’une œuvre qui fournit un texte pour une vidéo."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely szöveget szolgáltat egy videóhoz."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas nodrošina tekstu video resursam."],"nl":["Relateert een expressie aan een expressie van een werk dat tekst voor een video levert."],"no":["Relaterer et uttrykk til et uttrykk av et verk som tilfører tekst til en video."],"tr":["Bir anlatımı, bir video için metin sağlayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm