                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/animatorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20484", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorCorporateBodyToPerformance.en", "label":"has contributor corporate body to performance"},{"@id":"http://rdaregistry.info/Elements/e/P20453", "lexicalAlias":"http://rdaregistry.info/Elements/e/animatorCollectiveAgent.en", "label":"has animator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20512", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/animatorCorporateBody.en", "label":"has animator corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20512", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/animatorCorporateBody.en", "label":"has animator corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20571","label":{"ar":"لها عائلة فنانة رسوم متحركة","ca":"té com a família animadora","cs":"má animátora (rodinu)","da":"har familie, som er animator","de":"hat Trickfilmzeichnerin/Trickfilmzeichner (Familie)","de":"hat Trickfilmzeichnerin/Trickfilmzeichner (Familie)","en":"has animator family","es":"tiene familia animadora","et":"animaator (perekond)","fi":"animaattori (suku)","fr":"a pour famille animatrice","hu":"animátor családja a következő:","lv":"animators (dzimta/ģimene)","nl":"heeft animator-familie","no":"har animatør (familie)","tr":"animatör aile ile ilişkilidir","zh-Hans-CN":"有动画师家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تساهم في تعبيرة من خلال جعل كائنات أو رسومات جامدة تتحرك حركة واضحة."],"ca":["Relaciona una expressió amb una família que contribueix a una expressió donant l’aparença de moviment a objectes o dibuixos inanimats."],"cs":["Vztahuje vyjádření k rodině, která přispívá k vyjádření tím, že dodává zdání pohybu neživým předmětům nebo kresbám."],"da":["Relaterer et udtryk til en familie, som bidrager til et udtryk ved at give en illusion af bevægelse til livløse objekter eller tegninger."],"de":["Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.,Setzt eine Expression in Beziehung zu einer Familie, die zu einer Expression beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt."],"en":["Relates an expression to a family who contributes to an expression by giving apparent movement to inanimate objects or drawings."],"es":["Relaciona una expresión con una familia que contribuye a una expresión al dar movimiento aparente a objetos o dibujos inanimados."],"et":["Seostab väljenduse perekonnaga, kes annab panuse väljendusse, pannes näiliselt liikuma elutud esemed või joonistused."],"fi":["Liittää ekspression sukuun, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin."],"fr":["Met une expression en relation avec une famille qui contribue à une expression en donnant l’illusion du mouvement à des objets inanimés ou à des dessins."],"hu":["Hozzákapcsol egy kifejezési formát egy családhoz, amely élettelen tárgyak vagy rajzok látszólagos mozgatásával járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas sniegusi ieguldījumu izteiksmē, piešķirot redzamu kustību nekustīgiem objektiem vai zīmējumiem."],"nl":["Relateert een expressie aan een familie die bijdraagt aan een expressie door het geven van schijnbare beweging aan levenloze objecten of tekeningen."],"no":["Relaterer et uttrykk til en familie som bidrar til et uttrykk ved å gi tilsynelatende bevegelse til tegninger eller figurer."],"tr":["Bir anlatımı, hareketsiz nesnelere veya çizimlere belirgin hareket vererek anlatıma katkıda bulunan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过给予无生命对象或绘画以貌似运动而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة فنانة رسوم متحركة","ca":"família animadora","cs":"animátor (rodina)","da":"familie, som er animator","de":"Trickfilmzeichnerin/Trickfilmzeichner (Familie)","de":"Trickfilmzeichnerin/Trickfilmzeichner (Familie)","en":"animator family","es":"familia animadora","et":"animaator (perekond)","fi":"animaattori (suku)","fr":"famille animatrice","hu":"animátor család:","lv":"animators (dzimta/ģimene)","nl":"animator-familie","no":"animatør (familie)","tr":"animatör aile","zh-Hans-CN":"动画师家族"},"ToolkitDefinition":{"ar":"عائلة تساهم في تعبيرة من خلال جعل كائنات أو رسومات جامدة تتحرك حركة واضحة.","ca":"Família que contribueix a una expressió donant l’aparença de moviment a objectes o dibuixos inanimats.","cs":"Rodina, která přispívá k vyjádření tím, že dodává zdání pohybu neživým předmětům nebo kresbám.","da":"Familie, som bidrager til et udtryk ved at give en illusion af bevægelse til livløse objekter eller tegninger.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","de":"Eine Familie, die zu einer Expression beiträgt, indem sie unbelebte Objekte oder Zeichnungen in scheinbare Bewegung versetzt.","en":"A family who contributes to an expression by giving apparent movement to inanimate objects or drawings.","es":"Una familia que contribuye a una expresión al dar movimiento aparente a objetos o dibujos inanimados.","et":"Perekond, kes annab panuse väljendusse, pannes näiliselt liikuma elutud esemed või joonistused.","fi":"Suku, joka osallistuu ekspression tekemiseen tuottamalla näennäistä liikettä elottomiin esineisiin tai piirroksiin.","fr":"Famille qui contribue à une expression en donnant l’illusion du mouvement à des objets inanimés ou à des dessins.","hu":"Egy család, amely élettelen tárgyak vagy rajzok látszólagos mozgatásával járul hozzá egy kifejezési formához.","lv":"Dzimta/ģimene, kas sniegusi ieguldījumu izteiksmē, piešķirot redzamu kustību nekustīgiem objektiem vai zīmējumiem.","nl":"Een familie die bijdraagt aan een expressie door het geven van schijnbare beweging aan levenloze objecten of tekeningen.","no":"En familie som bidrar til et uttrykk ved å gi tilsynelatende bevegelse til tegninger eller figurer.","tr":"Cansız nesnelere veya çizimlere görünür bir hareket vererek ifadeye katkıda bulunan bir aile.","zh-Hans-CN":"通过给予无生命对象或绘画以貌似运动而对一种内容表达有贡献的一个家族"},"note":{"ar":["يُستبعد رسم الرسوم الكرتونية."],"ca":["S’exclou la creació dels dibuixos animats."],"cs":["Tvorba kreseb, které jsou animovány, je vyloučena."],"da":["Skabelse af tegningerne, som er animeret, er ikke omfattet."],"de":["Darunter fällt nicht die Schaffung der Zeichnungen, die animiert werden.,Darunter fällt nicht die Schaffung der Zeichnungen, die animiert werden."],"en":["Creation of the drawings that are animated is excluded."],"es":["La creación de los dibujos que son animados se excluye."],"et":["Ei hõlma liikuma pandavate joonistuste loomist."],"fi":["Ei koske animaatiopiirrosten tekijää."],"fr":["La création des dessins qui sont animés est exclue."],"hu":["Az animált rajzok megalkotása nem tartozik ide."],"lv":["Neietver animētu zīmējumu radīšanu."],"nl":["Creatie van de tekeningen die geanimeerd zijn is uitgesloten."],"no":["Det å skape tegningene som animeres, er ikke inkludert."],"tr":["Animasyonlu çizimlerin oluşturulması hariçtir."],"zh-Hans-CN":["不包括动画图的创作。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
