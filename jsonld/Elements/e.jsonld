                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/subjectExpressionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20298", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedWorkOfExpression.en", "label":"has related work of expression"},{"@id":"http://rdaregistry.info/Elements/x/P00014", "lexicalAlias":"http://rdaregistry.info/Elements/x/subjectRDAEntityOf.en", "label":"is subject RDA entity of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20273", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionEvaluatedBy.en", "label":"is expression evaluated by"},{"@id":"http://rdaregistry.info/Elements/e/P20269", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionDescribedBy.en", "label":"is expression described by"},{"@id":"http://rdaregistry.info/Elements/e/object/P20268", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/subjectExpressionOf.en", "label":"is subject expression of"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20268", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/subjectExpressionOf.en", "label":"is subject expression of"}]},{"@id":"http://rdaregistry.info/Elements/e/P20203","label":{"ar":"لها تعبيرة مشتقة","ca":"té expressió d’obra derivada","cs":"má vyjádření odvozeného díla","da":"har afledt udtryk","de":"hat abgeleitete Expression","de":"hat Expression eines Werks","el":"είναι παράγωγη (έκφραση)","en":"has expression of derivative work","es":"tiene expresión de obra derivada","et":"tuletatud väljendus","fi":"johdannaisteoksen ekspressio","fr":"a pour expression d’une œuvre dérivée","hu":"származékos kifejezési formája a következő:","lv":"atvasinātā izteiksme","nl":"heeft expressie van afgeleid werk","no":"har avledet uttrykk","tr":"türev eserin anlatımı ile ilişkilidir","vi":"là dẫn xuất (biểu hiện)","zh-Hans-CN":"有衍生作品的内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة عبارة عن تعديل لتعبيرة مصدرية."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una modificació d’una expressió font d’una obra diferent."],"cs":["Vztahuje vyjádření k vyjádření díla, které je modifikací zdrojového vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som er en tilpasning af et oprindeligt udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Expression, die eine Variante einer ursprünglichen Expression ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die den Inhalt des ursprünglichen Werks in einer anderen Form neu darstellt."],"el":["Συνδέει μια έκφραση με μια έκφραση η οποία συνιστά τροποποίηση μιας έκφρασης-πηγής."],"en":["Relates an expression to an expression of a work that is a modification of a source expression of a different work."],"es":["Relaciona una expresión con una expresión de una obra que es una modificación de una expresión fuente de una obra diferente."],"et":["Seostab väljenduse väljendusega, mis on allikväljenduse teisendus."],"fi":["Liittää ekspression teoksen ekspressioon, joka on eri teoksen lähde-ekspression muunnos."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en une modification d’une expression source d’une œuvre différente."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amely egy forrás kifejezési formájának módosítása."],"lv":["Sasaista izteiksmi ar izteiksmi, kas ir pamatizteiksmes modifikācija."],"nl":["Relateert een expressie aan een expressie van een werk dat een aanpassing is van een bronexpressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk som er en endring av et kildeuttrykk."],"tr":["Bir anlatımı, farklı bir eserin kaynak anlatımının değiştirilmiş hali olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện là bản sửa đổi của biểu hiện nguồn."],"zh-Hans-CN":["将一种内容表达与作为一种不同作品的一个源内容表达的修改的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة مشتقة","ca":"expressió d’obra derivada","cs":"vyjádření odvozeného díla","da":"afledt udtryk","de":"Abgeleitete Expression","de":"Expression eines Werks","el":"παράγωγη (έκφραση)","en":"expression of derivative work","es":"expresión de obra derivada","et":"tuletatud väljendus","fi":"johdannaisteoksen ekspressio","fr":"expression d’une œuvre dérivée","hu":"származékos kifejezési forma:","lv":"atvasinātā izteiksme","nl":"expressie van afgeleid werk","no":"avledet uttrykk","tr":"türetilmiş eserin anlatımı","vi":"dẫn xuất (biểu hiện)","zh-Hans-CN":"衍生作品的内容表达"},"ToolkitDefinition":{"ar":"تعبيرة عبارة عن تعديل لتعبيرة مصدرية.","ca":"Expressió d’una obra que és una modificació d’una expressió font d’una obra diferent.","cs":"Vyjádření díla, které je modifikací zdrojového vyjádření jiného díla.","da":"Udtryk af et værk, som er en tilpasning af et oprindeligt udtryk.","de":"Eine Expression, die eine Variante einer ursprünglichen Expression ist.","de":"Eine Expression eines Werks, die den Inhalt des ursprünglichen Werks in einer anderen Form neu darstellt.","el":"Μια έκφραση η οποία συνιστά τροποποίηση μιας έκφρασης-πηγής.","en":"An expression of a work that is a modification of a source expression of a different work.","es":"Una expresión de una obra que es una modificación de una expresión fuente de una obra diferente.","et":"Väljendus, mis on allikväljenduse teisendus.","fi":"Teoksen ekspressio, joka on eri teoksen lähde-ekspression muunnos.","fr":"Expression d’une œuvre qui consiste en une modification d’une expression source d’une œuvre différente.","hu":"Egy kifejezési forma, amely egy forrás kifejezési formájának módosítása.","lv":"Izteiksme, kas ir pamatizteiksmes modifikācija.","nl":"Een expressie van een werk dat een aanpassing is van een bronexpressie van een ander werk.","no":"Et uttrykk som er en endring av et kildeuttrykk.","tr":"Farklı bir eserin kaynak ifadesinin değiştirilmiş hali olan bir eserin anlatımı.","vi":"Biểu hiện là bản sửa đổi của biểu hiện nguồn.","zh-Hans-CN":"作为一种不同作品的一个源内容表达的修改的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20205", "lexicalAlias":"http://rdaregistry.info/Elements/e/relatedExpressionOfExpression.en", "label":"has related expression of expression"}],"instructionNumber":"24.5","lexicalAlias":"http://rdaregistry.info/Elements/e/expressionOfDerivativeWork.en","See Also":[{"@id":"http://rdaregistry.info/Elements/e/P20575", "lexicalAlias":"http://rdaregistry.info/Elements/e/derivativeExpression.en", "label":"has derivative expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20091", "lexicalAlias":"http://rdaregistry.info/Elements/e/indexedInExpression.en", "label":"is indexed in expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en", "label":"is adapted as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20115", "lexicalAlias":"http://rdaregistry.info/Elements/e/expandedAsExpression.en", "label":"is expanded as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20170", "lexicalAlias":"http://rdaregistry.info/Elements/e/digestedAsExpression.en", "label":"is digested as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20164", "lexicalAlias":"http://rdaregistry.info/Elements/e/paraphrasedAsExpression.en", "label":"is paraphrased as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20166", "lexicalAlias":"http://rdaregistry.info/Elements/e/abridgedAsExpression.en", "label":"is abridged as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20119", "lexicalAlias":"http://rdaregistry.info/Elements/e/freelyTranslatedAsExpression.en", "label":"is freely translated as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20086", "lexicalAlias":"http://rdaregistry.info/Elements/e/remadeAsExpression.en", "label":"is remade as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20114", "lexicalAlias":"http://rdaregistry.info/Elements/e/imitatedAsExpression.en", "label":"is imitated as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20181", "lexicalAlias":"http://rdaregistry.info/Elements/e/concordanceToExpression.en", "label":"is concordance to expression"},{"@id":"http://rdaregistry.info/Elements/e/P20090", "lexicalAlias":"http://rdaregistry.info/Elements/e/abstractedInExpression.en", "label":"is abstracted in expression"},{"@id":"http://rdaregistry.info/Elements/e/P20104", "lexicalAlias":"http://rdaregistry.info/Elements/e/abstractedAsExpression.en", "label":"is abstracted as expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20087", "lexicalAlias":"http://rdaregistry.info/Elements/e/setToMusicAsExpression.en", "label":"is set to music as expression"},{"@id":"http://rdaregistry.info/Elements/e/P20106", "lexicalAlias":"http://rdaregistry.info/Elements/e/summarizedAsExpression.en", "label":"is summarized as expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20082", "lexicalAlias":"http://rdaregistry.info/Elements/e/modifiedByVariationAsExpression.en", "label":"is modified by variation as expression"},{"@id":"http://rdaregistry.info/Elements/e/object/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/expressionOfDerivativeWork.en", "label":"has expression of derivative work"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20203", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/expressionOfDerivativeWork.en", "label":"has expression of derivative work"}]},{"@id":"http://rdaregistry.info/Elements/e/P20048","label":{"ca":"té com a editor literari","da":"har redaktør","de":"hat Herausgeber","el":"έχει επιμελητή","en":"has editor (Deprecated)","fi":"toimittaja","fr":"a pour éditeur intellectuel","hu":"van szerkesztője","vi":"có người biên tập"},"definition":{"ca":["Relaciona una expressió amb un agent que contribueix a una expressió d’una obra revisant o aclarint el contingut, o seleccionant i aplegant obres, o parts d’obres, d’un o més creadors."],"da":["Relaterer et udtryk til en agent, der har bidraget til et udtryk af et værk ved at revidere eller præcisere indholdet, eller ved at udvælge og sammensætte værker eller dele af værker, af en eller flere ophavspersoner."],"de":["Setzt eine Expression mit einem Akteur, der zu einer Expression eines Werks beiträgt, indem er den Inhalt überarbeitet oder erläutert oder Werke oder Teile von Werken von einem oder mehreren geistigen Schöpfern auswählt und zusammenstellt, in Beziehung."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της αναθεώρησης ή της αποσαφήνισης του περιεχομένου ή μέσω της επιλογής και της συγκέντρωσης έργων ή μερών έργων από έναν ή περισσότερους δημιουργούς."],"en":["Relates an expression to an agent who contributes to an expression by revising or clarifying the content, or by selecting and putting together works, or parts of works, by one or more creators. (Deprecated)"],"fi":["Liittää ekspression toimijaan, joka osallistuu teoksen ekspression tekemiseen tarkistamalla tai selkeyttämällä sisältöä, tai valitsemalla ja kokoamalla yhden tai useamman teoksen tekijän teoksia tai niiden osia julkaistavaksi."],"fr":["Met une expression en relation avec un agent qui contribue à une expression d’une œuvre en révisant ou en clarifiant le contenu, ou bien en choisissant et en rassemblant des œuvres, ou des parties d’œuvres, d’un ou plusieurs créateurs."],"hu":["Egy kifejezési formát hozzákapcsol egy ágenshez (személyhez, családhoz vagy testülethez), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy vagy több alkotó által készített tartalmat átdolgoz vagy pontosít, illetve hogy egy vagy több alkotó művét vagy műrészét kiválogatja és összeállítja."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách xem lại hoặc làm rõ nội dung, hoặc bằng cách lựa chọn và sắp đặt các tác phẩm, hoặc phần của các tác phẩm, bởi một hoặc nhiều người sáng tạo, với nhau"]},"note":{"ca":["Inclou una introducció, de notes, o de qualsevol altre material crític, o la preparació d’una expressió d’una obra per a la producció, la publicació o la distribució. S’exclouen les revisions, les adaptacions, etc., majors, que canvien substancialment la natura i el contingut de l’obra original, i que donen com a resultat una obra nova."],"da":["Tilføjelse af en indledning, noter eller andet vigtigt materiale, eller forberedelse af et udtryk af et værk til produktion, publicering eller distribution er omfattet. Større revisioner, bearbejdelser etc., der ændrer originalværkets karakter og indhold væsentligt, så der opstår et nyt værk, er ikke omfattet."],"de":["Dazu gehören eine Einleitung, Anmerkungen oder sonstiges kritisches Material hinzuzufügen oder eine Expression eines Werks für die Herstellung, die Veröffentlichung oder den Vertrieb vorzubereiten. Größere Überarbeitungen, Adaptionen usw., die die Beschaffenheit und den Inhalt des Originalwerks wesentlich ändern, so dass ein neues Werk entsteht, sind hiervon ausgenommen."],"el":["Περιλαμβάνεται η προσθήκη μιας εισαγωγής, σημειώσεων ή άλλου κριτικού περιεχομένου ή η προετοιμασία μιας έκφρασης ενός έργου για παραγωγή, δημοσίευση ή διάθεση. Σημαντική αναθεώρηση, προσαρμογή κ.λπ. η οποία συνεπάγεται ένα νέο έργο αποκλείεται."],"en":["Addition of an introduction, notes, or other critical matter, or preparing an expression of a work for production, publication, or distribution is included. Major revision, adaptation, etc., that substantially changes the nature and content of the original work, resulting in a new work, is excluded."],"fi":["Toimittaja voi osallistua ekspression tekoon lisäämällä johdannon, huomautuksia tai muuta kriittistä sisältöä. Toimittaja voi myös valmistella ekspression tuotantoa, julkaisemista tai jakelua varten. Tähän ei sisälly suuret muutokset, muokkaamiset jne., jotka merkittävästi muuttavat teoksen sisältöä ja luonnetta niin, että syntyy uusi teos."],"fr":["L’ajout d’une introduction, de notes ou d’autres textes critiques, ou bien la préparation d’une expression d’une œuvre aux fins de production, de publication ou de diffusion/distribution sont inclus. Les révisions, les adaptations, etc. majeures qui changent considérablement la nature et le contenu de l’œuvre originale et entraînent la création d’une nouvelle œuvre sont exclues."],"hu":["Bevezető, jegyzetek vagy egyéb kritikai anyag hozzáadása, vagy egy mű kifejezési formájának előkészítése produkcióhoz, kiadáshoz vagy terjesztéshez bele tartozik. Nagyobb átdolgozás, adaptálás stb., amely lényegesen megváltoztatja az eredeti mű sajátosságát és tartalmát és egy új művet eredménynez, nem tartozik bele."],"vi":["Bao gồm cả thêm lời giới thiệu, ghi chú, hoặc nội dung phê bình khác, hoặc chuẩn bị một biểu hiện khác của tác phẩm để sản xuất, xuất bản, hoặc phân phối. Không bao gồm sửa chữa, phóng tác lớn thay đổi cơ bản bản chất của nội dung của tác phẩm nguyên gốcmà kết quả tạo ra tác phẩm mới."]},"ToolkitLabel":{"ca":"editor literari","da":"redaktør","de":"Herausgeber","el":"επιμελητής","en":"editor (Deprecated)","es":"editor","fi":"toimittaja","fr":"éditeur intellectuel","hu":"szerkesztő","no":"redaktør","vi":"người biên tập"},"ToolkitDefinition":{"ca":"Agent que contribueix a una expressió d’una obra revisant o aclarint el contingut, o seleccionant i aplegant obres, o parts d’obres, d’un o més creadors.","da":"Agent, der har bidraget til et udtryk af et værk ved at revidere eller præcisere indholdet, eller ved at udvælge og sammensætte værker eller dele af værker, af en eller flere ophavspersoner.","de":"Ein Akteur, der zu einer Expression eines Werks beiträgt, indem er den Inhalt überarbeitet oder erläutert oder Werke oder Teile von Werken von einem oder mehreren geistigen Schöpfern auswählt und zusammenstellt.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της αναθεώρησης ή της αποσαφήνισης του περιεχομένου ή μέσω της επιλογής και της συγκέντρωσης έργων ή μερών έργων από έναν ή περισσότερους δημιουργούς.","en":"An agent who contributes to an expression by revising or clarifying the content, or by selecting and putting together works, or parts of works, by one or more creators. (Deprecated)","es":"Una persona, familia o entidad corporativa que contribuye a una expresión de una obra revisando o aclarando el contenido, por ej., agregando una introducción, notas u otro material crítico.","fi":"Toimija, joka osallistuu teoksen ekspression tekemiseen tarkistamalla tai selkeyttämällä sisältöä, tai valitsemalla ja kokoamalla yhden tai useamman teoksen tekijän teoksia tai niiden osia julkaistavaksi.","fr":"Agent qui contribue à une expression d’une œuvre en révisant ou en clarifiant le contenu, ou bien en choisissant et en rassemblant des œuvres, ou des parties d’œuvres, d’un ou plusieurs créateurs.","hu":"Egy ágens (személy, család vagy testület), aki/amely egy mű kifejezési formájához hozzájárul azzal, hogy egy vagy több alkotó által készített művek vagy műrészek tartalmát átnézi vagy pontosítja, ill. azokat kiválogatja és összeállítja.","no":"En agent som bidrar til et uttrykk av et verk ved å redigere innholdet eller gjøre det klarere, eller ved å velge ut og kombinere verk, eller deler av verk, av én eller flere opphavspersoner.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách xem lại hoặc làm rõ nội dung, hoặc bằng cách lựa chọn và sắp đặt các tác phẩm, hoặc phần của các tác phẩm, bởi một hoặc nhiều người sáng tạo, với nhau"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/editor.en","See Also":[{"@id":"http://rdaregistry.info/Elements/w/P10061", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorAgent.en", "label":"has author agent"}],"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20578", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorToAggregatedContent.en", "label":"has contributor to aggregated content (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20048", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/editor.en", "label":"has editor (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20048", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/editor.en", "label":"has editor (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20079","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل صور متحركة يُترجَم فيها حوار منطوق إلى لغة مختلفة عن لغة المصدر الأصلي."],"ca":["Relaciona una expressió amb una expressió d’una obra d’imatge en moviment que tradueix el diàleg parlat d’una altra expressió de la mateixa obra a una llengua diferent."],"cs":["Vztahuje vyjádření k vyjádření pohyblivého obrazu (díla), které překládá mluvený dialog jiného vyjádření téhož díla do jiného jazyka."],"da":["Relaterer et udtryk til et udtryk af et levende billedværk, som oversætter det originale værks talte dialog til et andet sprog."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Bewegtbildwerks, die die Dialoge des Originalwerks in eine andere Sprache übersetzt.,Setzt eine Expression in Beziehung zu einer Expression eines Bewegtbildwerks, die die Dialoge des Originalwerks in eine andere Sprache übersetzt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου κινητής εικόνας στο οποίο οι προφορικοί διάλογοι του πρωτότυπου έργου μεταφράζονται σε μια διαφορετική γλώσσα."],"en":["Relates an expression to an expression of a moving image work that translates spoken dialogue of another expression of the same work into a different language."],"es":["Relaciona una expresión con una expresión de una obra de imagen en movimiento que traduce el diálogo hablado de otra expresión de la misma obra a un idioma diferente."],"et":["Seostab väljenduse liikuvast pildist koosneva teose väljendusega, milles suuline dialoog on tõlgitud originaalteose keelest erinevasse keelde."],"fi":["Liittää ekspression elokuvateoksen ekspressioon, jossa alkuperäisteoksen puhuttu dialogi on käännetty toiselle kielelle."],"fr":["Met une expression en relation avec une expression d’une œuvre d’images animées qui traduit les dialogues parlés d’une autre expression de la même œuvre dans une langue différente."],"hu":["Hozzákapcsol egy kifejezési formát egy mozgóképmű kifejezési formájához, amely az eredeti mű beszélt dialógusát egy másik nyelvre fordítja."],"lv":["Sasaista izteiksmi ar filmas (darba) izteiksmi, kurā sākotnējā (oriģināldarba) darba runātais teksts tulkots citā valodā."],"nl":["Relateert een expressie aan een expressie van een bewegend beeldwerk dat gesproken dialoog van het oorspronkelijke werk in een andere taal vertaalt."],"no":["Relaterer et uttrykk til et uttrykk av et verk i form av levende bilder der dialog fra originalverket oversettes til et annet språk."],"tr":["Bir anlatımı, aynı eserin başka bir anlatımının sözlü diyaloğunu farklı bir dile çeviren hareketli görüntü eserinin bir anlatımı ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm hình ảnh động mà hội thoại của tác phẩm nguyên gốc đã được dịch sang ngôn ngữ khác."],"zh-Hans-CN":["将一种内容表达与把同一种作品的另一种内容表达的口语对话翻译成另一种不同语言的一种动态图像作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"نسخة مدبلجة من","ca":"versió doblada","cs":"dabovaná verze","da":"synkroniseret version","de":"Synchronfassung","de":"Synchronfassung","el":"μεταγλωττισμένη εκδοχή","en":"dubbed version","es":"versión doblada","et":"dubleeritud versioon","fi":"dubattu versio","fr":"version doublée","hu":"szinkronizált verziója:","lv":"dublētā versija","nl":"nagesynchroniseerde versie","no":"dubbet versjon","tr":"dublajlı versiyon","vi":"phiên bản ngôn ngữ khác","zh-Hans-CN":"配音版"},"ToolkitDefinition":{"ar":"تعبيرة لعمل صور متحركة يُترجَم فيها حوار منطوق إلى لغة مختلفة عن لغة المصدر الأصلي.","ca":"Expressió d’una obra d’imatge en moviment que tradueix el diàleg parlat d’una altra expressió de la mateixa obra a una llengua diferent.","cs":"Vyjádření pohyblivého obrazu (díla), které překládá mluvený dialog jiného vyjádření téhož díla do jiného jazyka.","da":"Udtryk af et levende billedværk, som oversætter det originale værks talte dialog til et andet sprog.","de":"Eine Expression eines Bewegtbildwerks, die die Dialoge des Originalwerks in eine andere Sprache übersetzt.","de":"Eine Expression eines Bewegtbildwerks, die die Dialoge des Originalwerks in eine andere Sprache übersetzt.","el":"Μια έκφραση ενός έργου κινητής εικόνας στο οποίο οι προφορικοί διάλογοι του πρωτότυπου έργου μεταφράζονται σε μια διαφορετική γλώσσα.","en":"An expression of a moving image work that translates spoken dialogue of another expression of the same work into a different language.","es":"Una expresión de una obra de imagen en movimiento que traduce el diálogo hablado de otra expresión de la misma obra a un idioma diferente.","et":"Liikuvast pildist koosneva teose väljendus, milles suuline dialoog on tõlgitud originaalteose keelest erinevasse keelde.","fi":"Elokuvateoksen ekspressio, jossa alkuperäisteoksen puhuttu dialogi on käännetty toiselle kielelle.","fr":"Expression d’une œuvre d’images animées qui traduit les dialogues parlés d’une autre expression de la même œuvre dans une langue différente.","hu":"Egy mozgóképmű kifejezési forméja, amely az eredeti mű beszélt dialógusát egy másik nyelvre fordítja.","lv":"Filmas (darba) izteiksme, kurā sākotnējā (oriģināldarba) darba runātais teksts tulkots citā valodā.","nl":"Een expressie van een bewegend beeldwerk dat gesproken dialoog van het oorspronkelijke werk in een andere taal vertaalt.","no":"Et uttrykk av et verk i form av levende bilder der dialog fra originalverket oversettes til et annet språk.","tr":"Bir hareketli görüntü eserinin, aynı eserin başka bir anlatımının sözlü diyaloğunu farklı bir dile çeviren bir anlatımı.","vi":"Biểu hiện của tác phẩm hình ảnh động mà hội thoại của tác phẩm nguyên gốc đã được dịch sang ngôn ngữ khác.","zh-Hans-CN":"把同一种作品的另一种内容表达的口语对话翻译成另一种不同语言的一种动态图像作品的一种内容表达"},"label":{"ar":"لها نسخة مدبلجة","ca":"té com a versió doblada","cs":"má dabovanou verzi","da":"har synkroniseret version","de":"ist Synchronfassung","de":"ist Synchronfassung","el":"είναι μεταγλωττισμένη εκδοχή","en":"has dubbed version","es":"tiene versión doblada","et":"dubleeritud versioon","fi":"dubattu versio","fr":"a pour version doublée","hu":"szinkronizált verziója a következő:","lv":"dublētā versija","nl":"heeft nagesynchroniseerde versie","no":"har dubbet versjon","tr":"dublajlı sürüm ile ilişkilidir","vi":"là phiên bản ngôn ngữ khác","zh-Hans-CN":"有配音版"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20171", "lexicalAlias":"http://rdaregistry.info/Elements/e/translatedAs.en", "label":"is translated as"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/dubbedVersion.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20079", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dubbedVersion.en", "label":"has dubbed version"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20079", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dubbedVersion.en", "label":"has dubbed version"}]},{"@id":"http://rdaregistry.info/Elements/e/P20078","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل صور متحركة يُترجَم فيها حوار منطوق إلى لغة مختلفة عن لغة المصدر الأصلي."],"ca":["Relaciona una expressió amb una expressió d’una obra d’imatge en moviment el diàleg parlat de la qual es tradueix a una llengua diferent d’una altra expressió de la mateixa obra."],"cs":["Vztahuje vyjádření k vyjádření pohyblivého obrazu (díla), jehož mluvený dialog je přeložen do jazyka odlišného od jiného vyjádření téhož díla."],"da":["Relaterer et udtryk til et udtryk af et levende billedværk, hvori den talte dialog er oversat til et andet sprog end det, som er anvendt i det originale værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Bewegtbildwerks, in der die Dialoge in eine Sprache übersetzt wurden, die sich von der des Originalwerks unterscheidet.,Setzt eine Expression in Beziehung zu einer Expression eines Bewegtbildwerks, in der die Dialoge in eine Sprache übersetzt wurden, die sich von der des Originalwerks unterscheidet."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου κινητής εικόνας στο οποίο οι προφορικοί διάλογοι έχουν μεταφραστεί σε μια γλώσσα διαφορετική από εκείνη του πρωτότυπου έργου."],"en":["Relates an expression to an expression of a moving image work whose spoken dialogue is translated into a language different from another expression of the same work."],"es":["Relaciona una expresión con una expresión de una obra de imagen en movimiento cuyo diálogo hablado se traduce a un idioma diferente a otra expresión de la misma obra."],"et":["Seostab väljenduse liikuvast pildist koosneva teose väljendusega, mille suuline dialoog on tõlgitud originaalteose keelest erinevasse keelde."],"fi":["Liittää ekspression elokuvateoksen ekspressioon, josta puhuttu dialogi on käännetty alkuperäisteoksesta poikkeavalle kielelle"],"fr":["Met une expression en relation avec une expression d’une œuvre d’images animées dont les dialogues parlés ont été traduits dans une langue différente de celle d’une autre expression de la même œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mozgóképmű kifejezési formájához, amelyben a beszélt dialógus az eredeti mű nyelvétől eltérő nyelvre van fordítva."],"lv":["Sasaista izteiksmi ar filmas (darba) izteiksmi, kuras runātais teksts tulkots citā valodā, kas nav darba oriģinālā valoda."],"nl":["Relateert een expressie aan een expressie van een bewegend beeldwerk waarin gesproken dialoog is vertaald in een andere taal dan die van het oorspronkelijke werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk i form av levende bilder der dialogen er oversatt til et annet språk enn i originalverket."],"tr":["Bir anlatımı, sözlü diyaloğu aynı eserin başka bir anlatımından farklı bir dile çevrilen hareketli görüntü eserinin bir anlatımı ile ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm hình ảnh động trong đó hội thoại đã được dịch sang ngôn ngữ khác với ngôn ngữ của tác phẩm nguyên gốc."],"zh-Hans-CN":["将一种内容表达与其口语对话被翻译成同一种作品的另一种内容表达的不同语言的一种动态图像作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"نسخة مدبلجة من","ca":"versió doblada de","cs":"dabovaná verze (čeho)","da":"synkroniseret version af","de":"Synchronfassung von","de":"Synchronfassung von","el":"μεταγλωττισμένη εκδοχή του","en":"dubbed version of","es":"versión doblada de","et":"dubleeritud versiooni alus","fi":"dubatun version perusta","fr":"version doublée de","hu":"szinkronizált verziója:","lv":"dublēta no","nl":"nagesynchroniseerde versie van","no":"dubbet versjon av","tr":"dublajlı versiyon","vi":"phiên bản ngôn ngữ khác của","zh-Hans-CN":"……的配音版"},"ToolkitDefinition":{"ar":"تعبيرة لعمل صور متحركة يُترجَم فيها حوار منطوق إلى لغة مختلفة عن لغة المصدر الأصلي.","ca":"Expressió d’una obra d’imatge en moviment el diàleg parlat de la qual es tradueix a una llengua diferent d’una altra expressió de la mateixa obra.","cs":"Vyjádření pohyblivého obrazu (díla), jehož mluvený dialog je přeložen do jazyka odlišného od jiného vyjádření téhož díla.","da":"Udtryk af et levende billedværk, hvori den talte dialog er oversat til et andet sprog end det, som er anvendt i det originale værk.","de":"Eine Expression eines Bewegtbildwerks, in der die Dialoge in eine Sprache übersetzt wurden, die sich von der des Originalwerks unterscheidet.","de":"Eine Expression eines Bewegtbildwerks, in der die Dialoge in eine Sprache übersetzt wurden, die sich von der des Originalwerks unterscheidet.","el":"Μια έκφραση ενός έργου κινητής εικόνας στο οποίο οι προφορικοί διάλογοι έχουν μεταφραστεί σε μια γλώσσα διαφορετική από εκείνη του πρωτότυπου έργου.","en":"An expression of a moving image work whose spoken dialogue is translated into a language different from another expression of the same work.","es":"Una expresión de una obra de imagen en movimiento cuyo diálogo hablado se traduce a un idioma diferente a otra expresión de la misma obra.","et":"Liikuvast pildist koosneva teose väljendus, mille suuline dialoog on tõlgitud originaalteose keelest erinevasse keelde.","fi":"Elokuvateoksen ekspressio, josta puhuttu dialogi on käännetty alkuperäisteoksesta poikkeavalle kielelle","fr":"Expression d’une œuvre d’images animées dont les dialogues parlés ont été traduits dans une langue différente de celle d’une autre expression de la même œuvre.","hu":"Egy mozgóképmű kifejezési formája, amelyben a beszélt dialógus az eredeti mű nyelvétől eltérő nyelvre van fordítva.","lv":"Filmas (darba) izteiksme, kuras runātais teksts tulkots citā valodā, kas nav darba oriģinālā valoda.","nl":"Een expressie van een bewegend beeldwerk waarin gesproken dialoog is vertaald in een andere taal dan die van het oorspronkelijke werk.","no":"Et uttrykk av et verk i form av levende bilder der dialogen er oversatt til et annet språk enn i originalverket.","tr":"Bir hareketli görüntü eserinin, aynı eserin başka bir anlatımından farklı bir dile çevrilmiş olan anlatımı.","vi":"Biểu hiện của tác phẩm hình ảnh động trong đó hội thoại đã được dịch sang ngôn ngữ khác với ngôn ngữ của tác phẩm nguyên gốc.","zh-Hans-CN":"其口语对话被翻译成同一种作品的另一种内容表达的不同语言的一种动态图像作品的一种内容表达"},"label":{"ar":"هي نسخة مدبلجة من","ca":"és versió doblada de","cs":"je dabovanou verzí (čeho)","da":"er synkroniseret version af","de":"ist Synchronfassung von","de":"ist Synchronfassung von","el":"είναι μεταγλωττισμένη εκδοχή του","en":"is dubbed version of","es":"es la versión doblada de","et":"dubleeritud versiooni alus","fi":"dubatun version perusta","fr":"est une version doublée de","hu":"szinkronizált verziója a következőnek:","lv":"ir dublēta no","nl":"is nagesynchroniseerde versie van","no":"er dubbet versjon av","tr":"dublajlı sürümüdür","vi":"là phiên bản ngôn ngữ khác của","zh-Hans-CN":"是……的配音版"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20141", "lexicalAlias":"http://rdaregistry.info/Elements/e/translationOf.en", "label":"is translation of"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/dubbedVersionOf.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20078", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dubbedVersionOf.en", "label":"is dubbed version of"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20078", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dubbedVersionOf.en", "label":"is dubbed version of"}]},{"@id":"http://rdaregistry.info/Elements/e/P20224","definition":{"ca":["Relaciona una expressió amb una presència de color, de tonalitat, etc., en el contingut d’una expressió."],"da":["Relaterer et udtryk til en tilstedeværelse af farve, nuance etc. i et udtryks indhold."],"de":["Setzt eine Expression in Beziehung zu einem Vorhandensein von Farbe, Tönung und so weiter im Inhalt einer Expression."],"el":["Συνδέει μια έκφραση με μια παρουσία χρώματος, τόνου κ.λπ. στο περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to a presence of colour, tone, etc., in the content of an expression. (Deprecated)"],"et":["Seostab väljenduse värvi, tooni vms olemasoluga väljenduse sisus."],"fi":["Liittää ekspression värin, sävyn tms. läsnäoloon ekspression sisällössä."],"fr":["Met une expression en relation avec une présence de couleur, de teinte, etc. dans le contenu d’une expression."],"hu":["Egy kifejezési formát hozzákapcsol egy szín, tónus, hangnem stb. jelenlétéhez egy kifejezési forma tartalmában."],"nl":["Relateert een expressie aan een aanwezigheid van kleur, tint etc. in de content van een expressie."],"no":["Relaterer et uttrykk til en tilstedeværelse av farge, tone etc. i innholdet i et uttrykk."],"vi":["Liên kết một biểu hiện với hiện diện của màu, sắc thái, v.v..., của nội dung của biểu hiện."]},"ToolkitLabel":{"ca":"contingut de color","da":"farveindhold","de":"Farbinhalt","el":"χρώμα περιεχομένου","en":"colour content (Deprecated)","es":"contenido a color","et":"värvisisu","fi":"värisisältö","fr":"contenu de couleur","hu":"színtartalom","nl":"kleurencontent","no":"fargeinnhold","sv":"färginnehåll","vi":"nội dung màu"},"ToolkitDefinition":{"ca":"Presència de color, de tonalitat, etc., en el contingut d’una expressió.","da":"Tilstedeværelse af farve, nuance etc. i et udtryks indhold.","de":"Ein Vorhandensein von Farbe, Tönung und so weiter im Inhalt einer Expression.","el":"Η παρουσία χρώματος, τόνου κ.λπ. στο περιεχόμενο μιας έκφρασης.","en":"A presence of colour, tone, etc., in the content of an expression. (Deprecated)","es":"La presencia de color, tono, etc., en el contenido de un recurso.","et":"Värvi, tooni vms olemasolu väljenduse sisus.","fi":"Värin, sävyn tms. läsnäolo ekspression sisällössä.","fr":"Présence de couleur, de teinte, etc. dans le contenu d’une expression.","hu":"Szín, színárnyalat, tónus stb. egy kifejezési forma tartalmában.","nl":"Een aanwezigheid van kleur, tint etc. in de content van een expressie.","no":"En tilstedeværelse av farge, tone etc. i innholdet i et uttrykk.","vi":"Hiện diện của màu, sắc thái, v.v..., của nội dung của biểu hiện."},"note":{"ca":["El blanc, el negre, els ombrejats d’un sol color de negre, els matisos d’un sol color de blanc, les tonalitats d’un sol color de gris, es considera que són un sol color."],"da":["Sort, hvid, enkeltfarvede skygger af sort, enkeltfarvede nuancer af hvidt og enkeltfarvede toner af gråt er anset for at være enkeltfarver."],"de":["Schwarz, Weiß, einfarbige Schwarztöne, einfarbige Weißtönungen und einfarbige Grauschattierungen werden als einfarbig angesehen."],"el":["Οι μαύρες, λευκές, μονόχρωμες μαύρες σκιές, οι μονόχρωμες αποχρώσεις του λευκού και οι μονόχρωμοι τόνοι του γκρι θεωρούνται μοναδικά χρώματα."],"en":["Black, white, single colour shades of black, single colour tints of white, and single colour tones of gray are considered to be single colours."],"et":["Must, valge, musta ühevärvilised varjundid, valge ühevärvilised varjundid ja halli ühevärvilised varjundid loetakse ühevärviliseks."],"fi":["Musta, valkoinen, yksiväriset mustan sävyt, yksiväriset valkoisen sävyt sekä yksiväriset harmaan sävyt lasketaan yksivärisiksi."],"fr":["Le noir et le blanc sont considérés comme étant des couleurs ; les différents tons d’une même couleur obtenus en ajoutant du noir, du blanc ou du gris sont considérés comme étant une seule couleur."],"hu":["A fekete, a fehér, a fekete egyszínű árnyalatai, a fehér egyszínű színmintái és a szürke egyszínű tónusai egy színnek számítanak."],"nl":["Zwart, wit, schakeringen van enkel zwart, schakeringen van enkel wit en tinten van enkel grijs worden gezien als enkele kleuren."],"no":["Svart, hvitt, enkeltnyanser av svart, enkeltnyanser av hvitt og enkeltnyanser av grått regnes som enkeltfarger."],"vi":["Đen, trắng, màu đơn lẻ, sắc màu đen, sắc thái đơn màu trắng, và gam mày xám đơn lẻ được xem là màu đơn."]},"label":{"ca":"té com a contingut de color","da":"har farveindhold","de":"hat Farbinhalt","el":"έχει χρώμα περιεχομένου","en":"has colour content (Deprecated)","et":"värvisisu","fi":"värisisältö","fr":"a pour contenu de couleur","hu":"színes tartalma","nl":"heeft kleurencontent","no":"har fargeinnhold","sv":"har färginnehåll","vi":"có nội dung màu"},"altLabel":{"ca":["contingut de color"],"da":["farveindhold"],"en":["color content"],"hu":["színtartalom"],"no":["fargeinnhold"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/colourContent.en","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20221", "lexicalAlias":"http://rdaregistry.info/Elements/e/colourContentOfResourceDesignedForPersonsWithVisualImpairments.en", "label":"has colour content of resource designed for persons with visual impairments (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20220", "lexicalAlias":"http://rdaregistry.info/Elements/e/colourOfMovingImage.en", "label":"has colour of moving image (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20222", "lexicalAlias":"http://rdaregistry.info/Elements/e/colourOfStillImage.en", "label":"has colour of still image (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/P20223", "lexicalAlias":"http://rdaregistry.info/Elements/e/colourOfThreeDimensionalForm.en", "label":"has colour of three-dimensional form (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20224", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/colourContent.en", "label":"has colour content (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20261","definition":{"ca":["Relaciona una expressió amb les particularitats d'una presència de color, de tonalitat, etc., en el contingut d’una expressió, i els colors, les tonalitats, etc., específics, inclosos el blanc i el negre, presents en el contingut."],"da":["Relaterer et udtryk til detaljer om en tilstedeværelse af farve, nuance etc. i et udtryks indhold, samt de specifikke farver, nuancer etc., inkl. sort og hvid, som er til stede."],"de":["Setzt eine Expression in Beziehung zu Details zum Vorhandensein von Farbe, Tönung und so weiter im Inhalt einer Expression und den spezifischen vorhandenen Farben, Tönungen und so weiter (einschließlich Schwarz und Weiß)."],"el":["Συνδέει μια έκφραση με τις λεπτομέρειες της παρουσίας χρώματος, τόνου κ.λπ. στο περιεχόμενο της έκφρασης και τα συγκεκριμένα χρώματα, τόνοι κ.λπ. περιλαμβανομένης της παρουσίας του μαύρου και του λευκού."],"en":["Relates an expression to details of a presence of colour, tone, etc., in the content of an expression, and the specific colours, tones, etc., including black and white, present. (Deprecated)"],"et":["Seostab väljenduse täpsemate andmetega värvi, tooni vms olemasolu kohta väljenduse sisus ning olemasolevate värvuste, toonide jms kohta, kaasa arvatud must ja valge."],"fi":["Liittää ekspression tarkempiin tietoihin ekspression sisällön värillisyydestä, sävytyksestä tms., yksityiskohtaisista väreistä, sävyistä tms. mukaan lukien musta ja valkoinen."],"fr":["Met une expression en relation avec des particularités d’une présence de couleur, de teinte, etc. dans le contenu d’une expression ainsi que des couleurs, des teintes, etc. spécifiques présentes, y compris le noir et le blanc."],"hu":["Egy kifejezési formát hozzákapcsol a szín, színárnyalat, tónus stb. jelenlétének a részleteihez egy kifejezési forma tartalmában, a specifikus színek, tónusok stb. jelenlétével, beleértve a fehéret-feketét is."],"nl":["Bijzonderheden van een aanwezigheid van kleur, tint etc. in de content van een expressie, en de specifieke kleuren, tinten etc., inclusief zwart en wit, aanwezig."],"no":["Relaterer et uttrykk til detaljer vedrørende tilstedeværelse av farge, tone etc. i innholdet i et uttrykk, samt de spesifikke fargene, tonene etc. som finnes, inkludert svart og hvitt."],"vi":["Liên kết một biểu hiện với chi tiết của sự hiện diện của màu, sắc thái, v.v..., trong nội dung của biểu hiện, và màu, sắc thái.v.v... cụ thể, bao gồm cả đen và trắng, trình bày."]},"ToolkitLabel":{"ca":"particularitats de contingut de color","da":"detaljer om farveindhold","de":"Details zum Farbinhalt","el":"λεπτομέρειες του χρωματικού περιεχομένου","en":"details of colour content (Deprecated)","es":"detalles del contenido a color","et":"värvisisu täpsustus","fi":"värisisällön tarkemmat tiedot","fr":"particularités d’un contenu de couleur","hu":"színtartalom részletei","nl":"details van kleurencontent","no":"detaljer vedrørende fargeinnhold","sv":"detaljerad information om färginnehåll","vi":"chi tiết của nội dung màu"},"ToolkitDefinition":{"ca":"Particularitats d'una presència de color, de tonalitat, etc., en el contingut d’una expressió, i els colors, les tonalitats, etc., específics, inclosos el blanc i el negre, presents en el contingut.","da":"Detaljer om en tilstedeværelse af farve, nuance etc. i et udtryks indhold, samt de specifikke farver, nuancer etc., inkl. sort og hvid, som er til stede.","de":"Details zum Vorhandensein von Farbe, Tönung und so weiter im Inhalt einer Expression und den spezifischen vorhandenen Farben, Tönungen und so weiter (einschließlich Schwarz und Weiß).","el":"Οι λεπτομέρειες της παρουσίας χρώματος, τόνου κ.λπ. στο περιεχόμενο της έκφρασης και τα συγκεκριμένα χρώματα, τόνοι κ.λπ. περιλαμβανομένης της παρουσίας του μαύρου και του λευκού.","en":"Details of a presence of colour, tone, etc., in the content of an expression, and the specific colours, tones, etc., including black and white, present. (Deprecated)","es":"Detalles de la presencia de color, tono, etc., y los colores específicos, tonos, etc. (incluyendo blanco y negro) presentes en el contenido de un recurso.","et":"Täpsemad andmed värvi, tooni vms olemasolu kohta väljenduse sisus ning olemasolevate värvuste, toonide jms kohta, kaasa arvatud must ja valge.","fi":"Tarkemmat tiedot ekspression sisällön värillisyydestä, sävytyksestä tms., yksityiskohtaisista väreistä, sävyistä tms. mukaan lukien musta ja valkoinen.","fr":"Particularités d’une présence de couleur, de teinte, etc. dans le contenu d’une expression ainsi que des couleurs, des teintes, etc. spécifiques présentes, y compris le noir et le blanc.","hu":"Szín, színárnyalat, tónus stb. jelenlétének a részletei egy kifejezési forma tartalmában, a specifikus színek, színárnyalatok stb. jelenlétével, beleértve a feketét és fehéret is.","nl":"Bijzonderheden van een aanwezigheid van kleur, tint etc. in de content van een expressie, en de specifieke kleuren, tinten etc., inclusief zwart en wit, aanwezig.","no":"Detaljer vedrørende tilstedeværelse av farge, tone etc. i innholdet i et uttrykk, samt de spesifikke fargene, tonene etc. som finnes, inkludert svart og hvitt.","vi":"Chi tiết của sự hiện diện của màu, sắc thái, v.v..., trong nội dung của biểu hiện, và màu, sắc thái.v.v... cụ thể, bao gồm cả đen và trắng, trình bày."},"label":{"ca":"té com a particularitats de contingut de color","da":"har detaljer om farveindhold","de":"hat Details zum Farbinhalt","el":"έχει λεπτομέρειες του χρωματικού περιεχομένου","en":"has details of colour content (Deprecated)","et":"värvisisu täpsustus","fi":"värisisällön tarkemmat tiedot","fr":"a pour particularités d’un contenu de couleur","hu":"színtartalom részletei","nl":"heeft details van kleurencontent","no":"har detaljer vedrørende fargeinnhold","sv":"har detaljerad information om färginnehåll","vi":"có chi tiết của nội dung màu"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfColourContent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.17.1.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20261", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfColourContent.en", "label":"has details of colour content (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20266","ToolkitLabel":{"ar":"تفاصيل عن نص","ca":"particularitats d’escriptura","cs":"podrobnosti o písmu","da":"detaljer om skriftsystem","de":"Details zur Schrift","de":"Details zur Schrift","el":"λεπτομέρειες της γραφής","en":"details of script (Deprecated)","es":"detalles del guión","et":"kirjasüsteemi täpsustus","fi":"kirjoitusjärjestelmän tarkemmat tiedot","fr":"particularités d’une écriture","hu":"szövegkönyv részletei a következők:","lv":"detalizēti par rakstību","nl":"details van schrift","no":"detaljer vedrørende skriftsystem","sv":"detaljerad information om skriftart","tr":"senaryonun ayrıntıları","vi":"chi tiết của hệ thống viết","zh-Hans-CN":"文字的细节"},"ToolkitDefinition":{"ar":"تفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى لغوي مكتوب لتعبيرة.","ca":"Particularitats d’un conjunt de caràcters o de símbols usat per expressar el contingut lingüístic escrit d’una expressió.","cs":"Podrobnosti o souboru znaků nebo symbolů použitých k vyjadřování psaného jazykového obsahu vyjádření.","da":"Detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks skriftlige sprogindhold.","de":"Details zu dem Satz von Buchstaben oder Zeichen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken.","de":"Details zu dem Satz von Buchstaben oder Zeichen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken.","el":"Οι λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για να εκφράσουν το γραπτό γλωσσικό περιεχόμενο μιας έκφρασης.","en":"Details of a set of characters or symbols used to express written language content of an expression. (Deprecated)","es":"Detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido del lenguaje escrito de una expresión.","et":"Täpsemad andmed märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse kirjutatud keeles sisu väljendamiseks.","fi":"Tarkemmat tiedot merkki- tai symbolijärjestelmästä, jolla ekspression kirjoitettu kielellinen sisältö on kirjoitettu.","fr":"Particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer un contenu linguistique écrit d’une expression.","hu":"Egy kifjeezési forma nyelvi tartalmát kifejező karakterek vagy szimbólumok egy csoportjának részletei.","lv":"Sīkāka informācija par rakstzīmju un/vai simbolu kopumu, ko lieto, lai izteiktu izteiksmes saturu rakstzīmju valodā.","nl":"Details van een verzameling van tekens of symbolen gebruikt om geschreven taalcontent van een expressie uit te drukken.","no":"Detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke det skriftlige tekstinnholdet i et uttrykk.","tr":"Bir anlatımın yazılı dil içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntıları.","vi":"Chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung ngôn ngữ viết của biểu hiện","zh-Hans-CN":"用于表达一种内容表达的书写语言内容的字符或符号的集合的细节"},"label":{"ar":"لها تفاصيل عن سيناريو","ca":"té com a particularitats d’escriptura","cs":"má podrobnosti o písmu","da":"har detaljer om skriftsystem","de":"hat Details zur Schrift","de":"hat Details zur Schrift","el":"έχει λεπτομέρειες της γραφής","en":"has details of script (Deprecated)","es":"tiene detalles del guión","et":"kirjasüsteemi täpsustus","fi":"kirjoitusjärjestelmän tarkemmat tiedot","fr":"a pour particularités d’une écriture","hu":"szövegkönyv részletei:","lv":"detalizēti par rakstību","nl":"heeft details van schrift","no":"har detaljer vedrørende skriftsystem","sv":"har detaljerad information om skriftart","tr":"alfabenin ayrıntıları ile ilişkilidir","vi":"có chi tiết của hệ thống viết","zh-Hans-CN":"有文字的细节"},"definition":{"ar":["تربط بين تعبيرة ومجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى لغوي مكتوب لتعبيرة."],"ca":["Relaciona una expressió amb les particularitats del conjunt de caràcters o de símbols usat per expressar el contingut lingüístic escrit d’una expressió."],"cs":["Vztahuje vyjádření k podrobnostem o souboru znaků nebo symbolů použitých k vyjadřování psaného jazykového obsahu vyjádření."],"da":["Relaterer et udtryk til detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks skriftlige sprogindhold."],"de":["Setzt eine Expression in Beziehung zu Details zu dem Satz von Buchstaben oder Zeichen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken.,Setzt eine Expression in Beziehung zu Details zu dem Satz von Buchstaben oder Zeichen der verwendet wird, um den geschriebenen Sprachinhalt einer Expression auszudrücken."],"el":["Συνδέει μια έκφραση με τις λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για να εκφράσουν το γραπτό γλωσσικό περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to details of a set of characters or symbols used to express written language content of an expression. (Deprecated)"],"es":["Relaciona una expresión con detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido del lenguaje escrito de una expresión."],"et":["Seostab väljenduse täpsemate andmetega märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse kirjutatud keeles sisu väljendamiseks."],"fi":["Liittää ekspression tarkempiin tietoihin merkki- tai symbolijärjestelmästä, jolla ekspression kirjoitettu kielellinen sisältö on kirjoitettu."],"fr":["Met une expression en relation avec des particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer un contenu linguistique écrit d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy kifjeezési forma nyelvi tartalmát kifejező karakterek vagy szimbólumok egy csoportjának részleteihez."],"lv":["Sasaista izteiksmi ar sīkāku informāciju par rakstzīmju un/vai simbolu kopumu, ko lieto, lai izteiktu izteiksmes saturu rakstzīmju valodā."],"nl":["Bijzonderheden van een verzameling van tekens of symbolen gebruikt om geschreven taalcontent van een expressie uit te drukken."],"no":["Relaterer et uttrykk til detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke det skriftlige tekstinnholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın yazılı dil içeriğini ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntılarıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung ngôn ngữ viết của biểu hiện"],"zh-Hans-CN":["将一种内容表达与用于表达一种内容表达的书写语言内容的字符或符号的集合的细节关联起来。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfScript.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.13.2.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20266", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfScript.en", "label":"has details of script (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20061","definition":{"ar":["تربط بين تعبيرة ومجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى تعبيرة في شكل يمكن تصوره من خلال اللمس."],"ca":["Relaciona una expressió amb un conjunt de caràcters o de símbols usat per expressar el contingut d’una expressió en una forma que es pot percebre mitjançant el tacte."],"cs":["Vztahuje vyjádření k souboru znaků nebo symbolů, používaných k vyjadřování obsahu vyjádření ve formě, kterou lze vnímat hmatem."],"da":["Relaterer et udtryk til et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks indhold på en måde, som kan opfattes ved berøring."],"de":["Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann.,Setzt eine Expression in Beziehung zu einem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann."],"el":["Συνδέει μια έκφραση με ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο μιας έκφρασης σε μια μορφή που γίνεται αντιληπτή μέσω της αφής."],"en":["Relates an expression to a set of characters or symbols used to express the content of an expression in a form that can be perceived through touch."],"es":["Relaciona una expresión con un conjunto de caracteres o símbolos utilizados para expresar el contenido de una expresión en una forma que puede percibirse a través del tacto."],"et":["Seostab väljenduse märkide või sümbolite kogumiga, mida on kasutatud väljenduse sisu väljendamiseks, nii et seda saab tajuda kompimise teel."],"fi":["Liittää ekspression joukkoon merkkejä tai symboleja, joita käytetään kosketeltavassa muodossa olevan ekspression sisällön ilmaisemiseen."],"fr":["Met une expression en relation avec un ensemble de caractères ou de symboles utilisé pour exprimer le contenu d’une expression sous une forme perceptible au toucher."],"hu":["Hozzákapcsol egy kifejezési formát karakterek vagy szimbólumok egy csoportjához, amelyet arra használnak, hogy egy kifejezési forma tartalmát érintés útján felfogató formában fejezze ki."],"lv":["Sasaista izteiksmi ar zīmju vai simbolu kopumu, kas tiek lietoti, lai atklātu izteiksmes saturu formā, kas var tikt uztverta ar tausti."],"nl":["Relateert een expressie aan een verzameling van karakters of symbolen gebruikt om de content van een expressie weer te geven op een wijze die kan worden waargenomen door tast."],"no":["Relaterer et uttrykk til et sett med tegn eller symboler som brukes til å uttrykke innholdet i et uttrykk i en form som kan oppfattes ved berøring."],"tr":["Bir anlatımı, anlatımın içeriğini dokunma yoluyla algılanabilecek bir biçimde ifade etmek için kullanılan bir dizi karakter veya sembolle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung của biểu hiện dưới hình thái có thể cảm nhận được qua xúc giác."],"zh-Hans-CN":["将一种内容表达与用于通过触摸感知的形式来表达一种内容表达的内容的字符或符号的集合关联起来。"]},"ToolkitLabel":{"ar":"شكل من أشكال التدوين الملموس","ca":"forma de notació tàctil","cs":"podoba taktilního zápisu","da":"taktil notationsform","de":"Form der taktilen Notation","de":"Form der taktilen Notation","el":"μορφή της απτικής σημειογραφίας","en":"form of tactile notation","es":"forma de notación táctil","et":"taktiilse notatsiooni vorm","fi":"taktiilin merkkijärjestelmän tyyppi","fr":"forme de notation tactile","hu":"tapintható lejegyzési formája:","lv":"taktila pieraksta forma","nl":"vorm van tactiele notatie","no":"taktil notasjonsform","sv":"form av taktil notation","tr":"dokunsal notasyon formu","vi":"hình thái của ký hiệu xúc giác","zh-Hans-CN":"触摸标记的形式"},"ToolkitDefinition":{"ar":"مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى تعبيرة في شكل يمكن تصوره من خلال اللمس.","ca":"Conjunt de caràcters o de símbols usat per expressar el contingut d’una expressió en una forma que es pot percebre mitjançant el tacte.","cs":"Soubor znaků nebo symbolů, používaných k vyjadřování obsahu vyjádření ve formě, kterou lze vnímat hmatem.","da":"Sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks indhold på en måde, som kan opfattes ved berøring.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann.","de":"Ein Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann.","el":"Ένα σύνολο χαρακτήρων ή συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο μιας έκφρασης σε μια μορφή που γίνεται αντιληπτή μέσω της αφής.","en":"A set of characters or symbols used to express the content of an expression in a form that can be perceived through touch.","es":"Conjunto de caracteres o símbolos utilizados para expresar el contenido de una expresión de una forma que puede percibirse mediante el tacto.","et":"Märkide või sümbolite kogum, mida on kasutatud väljenduse sisu väljendamiseks, nii et seda saab tajuda kompimise teel.","fi":"Joukko merkkejä tai symboleja, joita käytetään kosketeltavassa muodossa olevan ekspression sisällön ilmaisemiseen.","fr":"Ensemble de caractères ou de symboles utilisé pour exprimer le contenu d’une expression sous une forme perceptible au toucher.","hu":"Karakterek vagy szimbólumok egy csoportja, amelyet arra használnak, hogy egy kifejezési forma tartalmát érintés útján felfogató formában fejezze ki.","lv":"Zīmju vai simbolu kopums, kas tiek lietoti, lai atklātu izteiksmes saturu formā, kas var tikt uztverta ar tausti.","nl":"Een verzameling van karakters of symbolen gebruikt om de content van een expressie weer te geven op een wijze die kan worden waargenomen door tast.","no":"Et sett med tegn eller symboler som brukes til å uttrykke innholdet i et uttrykk i en form som kan oppfattes ved berøring.","tr":"Bir anlatımın içeriğini dokunsal olarak algılanabilen bir biçimde ifade etmek için kullanılan karakterler veya semboller kümesi.","vi":"Chuỗi ký tự hoặc ký hiệu được dùng để thể hiện nội dung của biểu hiện dưới hình thái có thể cảm nhận được qua xúc giác.","zh-Hans-CN":"用于通过触摸感知的形式来表达一种内容表达的内容的字符或符号的集合"},"label":{"ar":"لها شكل من أشكال التدوين الملموس","ca":"té com a forma de notació tàctil","cs":"má podobu taktilního zápisu","da":"har taktil notationsform","de":"hat Form der taktilen Notation","de":"hat Form der taktilen Notation","el":"έχει μορφή της απτικής σημειογραφίας","en":"has form of tactile notation","es":"tiene forma de notación táctil","et":"taktiilse notatsiooni vorm","fi":"taktiilin merkkijärjestelmän tyyppi","fr":"a pour forme de notation tactile","hu":"tapintható lejegyzési formája a következő:","lv":"taktila pieraksta forma","nl":"heeft vorm van tactiele notatie","no":"har taktil notasjonsform","sv":"har form av taktil notation","tr":"dokunsal notasyon biçimi ile ilişkilidir","vi":"có hình thái của ký hiệu xúc giác","zh-Hans-CN":"有触摸标记的形式"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20062", "lexicalAlias":"http://rdaregistry.info/Elements/e/formOfNotation.en", "label":"has form of notation"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/formOfTactileNotation.en","instructionNumber":"7.13.4","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20061", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/formOfTactileNotation.en", "label":"has form of tactile notation"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20061", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/formOfTactileNotation.en", "label":"has form of tactile notation"}]},{"@id":"http://rdaregistry.info/Elements/e/P20265","definition":{"ar":["تربط بين تعبيرة وتفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى تعبيرة في شكل يمكن تصوره من خلال اللمس."],"ca":["Relaciona una expressió amb les particularitats d’un conjunt de caràcters o de símbols usat per expressar el contingut d’una expressió en una forma que es pot percebre a partir del tacte."],"cs":["Vztahuje vyjádření k podrobnostem o souboru znaků nebo symbolů použitých k vyjadřování obsahu vyjádření ve formě, kterou lze vnímat hmatem."],"da":["Relaterer et udtryk til detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks indhold på en måde, som kan opfattes ved berøring."],"de":["Setzt eine Expression in Beziehung zu Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann.,Setzt eine Expression in Beziehung zu Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann."],"el":["Συνδέει μια έκφραση με τις λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο μιας έκφρασης σε μια μορφή που μπορεί να γίνει αντιληπτή μέσω της αφής."],"en":["Relates an expression to details of a set of characters or symbols used to express the content of an expression in a form that can be perceived through touch. (Deprecated)"],"es":["Relaciona una expresión con detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido de una expresión en una forma que puede percibirse a través del tacto."],"et":["Seostab väljenduse täpsemate andmetega märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse sisu väljendamiseks, nii et seda saab tajuda kompimise teel."],"fi":["Liittää ekspression tarkempiin tietoihin merkeistä ja symboleista, joilla ekspression sisältö on ilmaistu kosketeltavassa muodossa."],"fr":["Met une expression en relation avec des particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer le contenu d’une expression sous une forme perceptible au toucher."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési forma tartalmát érintés útján felfogható formában kifejező karakterek vagy szimbólumok egy csoportjának részleteihez."],"lv":["Sasaista izteiksmi ar sīkāku informāciju par zīmju vai simbolu kopumu, kas ticis lietots, lai atklātu izteiksmes saturu formā, kas var tikt uztverta ar tausti."],"nl":["Relateert een expressie aan details van een verzameling van tekens of symbolen gebruikt om de content van een expressie uit te drukken in een vorm die kan worden waargenomen door tast."],"no":["Relaterer et uttrykk til detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke innholdet i et uttrykk i en form som kan oppfattes ved berøring."],"tr":["Bir anlatımı, içeriğini dokunma yoluyla algılanabilecek bir biçimde ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntılarıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung của biểu hiện dưới hình thái có thể cảm nhận bằng xúc giác."],"zh-Hans-CN":["将一种内容表达与用于通过触摸感知的形式来表达一种内容表达的内容的字符或符号的集合的细节关联起来。"]},"ToolkitLabel":{"ar":"تفاصيل شكل من أشكال التدوين","ca":"particularitats de forma de notació tàctil","cs":"podrobnosti o formě taktilního zápisu","da":"detaljer om taktil notationsform","de":"Details zur Form der taktilen Notation","de":"Details zur Form der taktilen Notation","el":"λεπτομέρειες της μορφής της απτικής σημειογραφίας","en":"details of form of tactile notation (Deprecated)","es":"detalles de la forma de notación táctil","et":"taktiilse notatsiooni vormi täpsustus","fi":"taktiilin merkkijärjestelmän tyypin tarkemmat tiedot","fr":"particularités d’une forme de notation tactile","hu":"tapintható lejegyzés formájának részletei a következők:","lv":"detalizēti par taktilā pieraksta formu","nl":"details van vorm van tactiele notatie","no":"detaljer vedrørende taktil notasjonsform","sv":"detaljerad information om form av taktil notation","tr":"dokunsal notasyon biçiminin ayrıntıları","vi":"chi tiết của hình thái ký hiệu xúc giác","zh-Hans-CN":"触摸标记的形式的细节"},"ToolkitDefinition":{"ar":"تفاصيل مجموعة تمثيلات أو رموز مستخدمة للتعبير عن محتوى تعبيرة في شكل يمكن تصوره من خلال اللمس.","ca":"Particularitats d’un conjunt de caràcters o de símbols usat per expressar el contingut d’una expressió en una forma que es pot percebre a partir del tacte.","cs":"Podrobnosti o souboru znaků nebo symbolů použitých k vyjadřování obsahu vyjádření ve formě, kterou lze vnímat hmatem.","da":"Detaljer om et sæt af tegn eller symboler, som anvendes til at udtrykke et udtryks indhold på en måde, som kan opfattes ved berøring.","de":"Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann.","de":"Details zu dem Satz von Zeichen oder Symbolen der verwendet wird, um den Inhalt einer Expression in einer Form auszudrücken, die über den Tastsinn wahrgenommen werden kann.","el":"Οι λεπτομέρειες του συνόλου των χαρακτήρων ή των συμβόλων που χρησιμοποιούνται για να εκφράσουν το περιεχόμενο μιας έκφρασης σε μια μορφή που μπορεί να γίνει αντιληπτή μέσω της αφής.","en":"Details of a set of characters or symbols used to express the content of an expression in a form that can be perceived through touch. (Deprecated)","es":"Detalles de un conjunto de caracteres o símbolos utilizados para expresar el contenido de una expresión en una forma que puede percibirse a través del tacto.","et":"Täpsemad andmed märkide või sümbolite kogumi kohta, mida on kasutatud väljenduse sisu väljendamiseks, nii et seda saab tajuda kompimise teel.","fi":"Tarkemmat tiedot merkeistä ja symboleista, joilla ekspression sisältö on ilmaistu kosketeltavassa muodossa.","fr":"Particularités d’un ensemble de caractères ou de symboles utilisé pour exprimer le contenu d’une expression sous une forme perceptible au toucher.","hu":"Egy kifejezési forma tartalmát érintés útján felfogható formában kifejező karakterek vagy szimbólumok egy csoportjának részletei.","lv":"Sīkāka informācija par zīmju vai simbolu kopumu, kas ticis lietots, lai atklātu izteiksmes saturu formā, kas var tikt uztverta ar tausti.","nl":"Details van een verzameling van tekens of symbolen gebruikt om de content van een expressie uit te drukken in een vorm die kan worden waargenomen door tast.","no":"Detaljer vedrørende et sett med tegn eller symboler brukt til å uttrykke innholdet i et uttrykk i en form som kan oppfattes ved berøring.","tr":"Bir anlatımın içeriğini dokunma yoluyla algılanabilecek bir biçimde ifade etmek için kullanılan bir dizi karakter veya sembolün ayrıntıları.","vi":"Chi tiết của bộ ký tự hoặc ký hiệu được sử dụng để thể hiện nội dung của biểu hiện dưới hình thái có thể cảm nhận bằng xúc giác.","zh-Hans-CN":"用于通过触摸感知的形式来表达一种内容表达的内容的字符或符号的集合的细节"},"label":{"ar":"لها تفاصيل شكل من أشكال التدوين","ca":"té com a particularitats de forma de notació tàctil","cs":"má podrobnosti o formě taktilního zápisu","da":"har detaljer om taktil notationsform","de":"hat Details zur Form der taktilen Notation","de":"hat Details zur Form der taktilen Notation","el":"έχει λεπτομέρειες της μορφής της απτικής σημειογραφίας","en":"has details of form of tactile notation (Deprecated)","es":"tiene detalles de forma de notación táctil","et":"taktiilse notatsiooni vormi täpsustus","fi":"taktiilin merkkijärjestelmän tyypin tarkemmat tiedot","fr":"a pour particularités d’une forme de notation tactile","hu":"tapintható lejegyzés formájának részletei:","lv":"detalizēti par taktilā pieraksta formu","nl":"heeft details van vorm van tactiele notatie","no":"har detaljer vedrørende taktil notasjonsform","sv":"har detaljerad information om form av taktil notation","tr":"dokunsal notasyon biçiminin ayrıntıları ile ilişkilidir","vi":"có chi tiết của hình thái ký hiệu xúc giác","zh-Hans-CN":"有触摸标记的形式的细节"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"lexicalAlias":"http://rdaregistry.info/Elements/e/detailsOfFormOfTactileNotation.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"instructionNumber":"7.13.4.4","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20265", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/detailsOfFormOfTactileNotation.en", "label":"has details of form of tactile notation (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20007","definition":{"ca":["Relaciona una expressió amb una llengua usada per expressar el contingut d’una expressió."],"da":["Relaterer et udtryk til et sprog, der anvendes til at udtrykke en ressources indhold."],"de":["Setzt eine Expression mit einer Sprache, die verwendet wird, um den Inhalt einer Expression auszudrücken, in Beziehung."],"el":["Συνδέει μια έκφραση με μια γλώσσα η οποία χρησιμοποιείται για να εκφράσει το περιεχόμενο μιας έκφρασης."],"en":["Relates an expression to a language used to express the content of an expression. (Deprecated)"],"fi":["Liittää ekspression kieleen, jota on käytetty aineiston sisällön ilmaisemiseen."],"fr":["Met une expression en relation avec une langue utilisée pour exprimer le contenu d’une expression."],"hu":["Egy kifejezési formát hozzákapcsol egy nyelvhez, amelyet egy kifejezési forma tartalmának kifejezésére használnak."],"vi":["Liên kết một biểu hiện với ngôn ngữ được dùng để thể hiện nội dung của hiểu hiện."]},"ToolkitLabel":{"ca":"llengua de contingut","da":"indholdets sprog","de":"Sprache des Inhalts","el":"γλώσσα του περιεχομένου","en":"language of content (Deprecated)","es":"lengua del contenido","fi":"sisällön kieli","fr":"langue du contenu","hu":"tartalom nyelve","no":"språk i innhold","vi":"ngôn ngữ của nội dung"},"ToolkitDefinition":{"ca":"Llengua usada per expressar el contingut d’una expressió.","da":"Sprog, der anvendes til at udtrykke en ressources indhold.","de":"Eine Sprache, die verwendet wird, um den Inhalt einer Expression auszudrücken.","el":"Μια γλώσσα η οποία χρησιμοποιείται για να εκφράσει το περιεχόμενο μιας εκφρασης.","en":"A language used to express the content of an expression. (Deprecated)","es":"Una lengua utilizada para expresar el contenido de un recurso.","fi":"Kieli, jota on käytetty aineiston sisällön ilmaisemiseen.","fr":"Langue utilisée pour exprimer le contenu d’une expression.","hu":"Egy nyelv, amelyet egy kifejezési forma tartalmának a kifejezésére használnak.","no":"Et språk brukt til å uttrykke innholdet i et uttrykk.","vi":"Ngôn ngữ được dùng để biểu hiện nội dung của một biểu hiện."},"label":{"ca":"té com a llengua de contingut","da":"har indholdets sprog","de":"hat Sprache des Inhalts","el":"έχει γλώσσα του περιεχομένου","en":"has language of content (Deprecated)","fi":"sisällön kieli","fr":"a pour langue du contenu","hu":"van tartalmi nyelve","vi":"có ngôn ngữ của nội dung"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
