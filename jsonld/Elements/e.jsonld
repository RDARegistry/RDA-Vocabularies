                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/motionPictureAdaptationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20125", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/motionPictureAdaptationOfExpression.en", "label":"is motion picture adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20125", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/motionPictureAdaptationOfExpression.en", "label":"is motion picture adaptation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20204","label":{"ar":"هي مبنية على تعبيرة","ca":"té expressió d’obra font","cs":"má vyjádření zdrojového díla","da":"er baseret på udtryk","de":"ist basiert auf (Expression)","de":"hat Expression eines Werks","el":"βασίζεται στην (έκφραση)","en":"has expression of source work","es":"tiene expresión del trabajo original","et":"põhineb väljendusel","fi":"lähdeteoksen ekspressio","fr":"a pour expression d’une œuvre source","hu":"alapja a következő kifejezési forma:","lv":"ir veidots pēc izteiksmes","nl":"heeft expressie van bronwerk","no":"er basert på uttrykk","tr":"kaynak eserin anlatımı ile ilişkilidir","vi":"được dựa trên (biểu hiện)","zh-Hans-CN":"有源作品的内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة تستخدم كأساس لتعبيرة مشتقة."],"ca":["Relaciona una expressió amb una expressió d’una obra que es modifica per crear una expressió d’una obra derivada."],"cs":["Vztahuje vyjádření k vyjádření díla, které je modifikováno za účelem vyjádření odvozeného díla."],"da":["Relaterer et udtryk til et udtryk, som anvendes som grundlag for et afledt udtryk."],"de":["Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine abgeleitete Expression verwendet wird.,Supplement (Expression) Eine Expression eines Werks, die die Haupt-Expression aktualisiert oder in anderer Weise vervollständigt."],"el":["Συνδέει μια έκφραση με μια έκφραση που χρησιμοποιείται ως η βάση για μια παράγωγη έκφραση."],"en":["Relates an expression to an expression of a work that is modified to create an expression of a derivative work."],"es":["Relaciona una expresión con una expresión de una obra que se modifica para crear una expresión de una obra derivada."],"et":["Seostab väljenduse väljendusega, mis on aluseks tuletatud väljendusele."],"fi":["Liittää ekspression teoksen ekspressioon, jota on muokattu johdannaisteoksen ekspression luomiseksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est modifiée pour créer une expression d’une œuvre dérivée."],"hu":["Hozzákapcsol egy kifejezési formát egy kifejezési formához, amelyet egy származékos kifejezési forma alapjaként használnak."],"lv":["Sasaista izteiksmi ar izteiksmi, kas izmantota par pamatu atvasinātai izteiksmei."],"nl":["Relateert een expressie aan een expressie van een werk dat is aangepast om te creëren een expressie van een afgeleid werk."],"no":["Relaterer et uttrykk til et uttrykk brukt som utgangspunkt for et avledet uttrykk."],"tr":["Bir anlatımı, türev bir eserin anlatımını oluşturmak üzere değiştirilen bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện được sử dạng làm cơ sở cho biểu hiện dẫn xuất."],"zh-Hans-CN":["将一种内容表达与被修改以创建一种衍生作品的一种内容表达的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مبنية على تعبيرة","ca":"expressió d’obra font","cs":"vyjádření zdrojového díla","da":"baseret på udtryk","de":"Basiert auf (Expression)","de":"Expression eines Werks","el":"βασίζεται στην (έκφραση)","en":"expression of source work","es":"expresión de la obra fuente","et":"põhineb väljendusel","fi":"lähdeteoksen ekspressio","fr":"expression d’une œuvre source","hu":"kifejezési formán alapul:","lv":"veidots pēc izteiksmes","nl":"expressie van bronwerk","no":"basert på uttrykk","tr":"kaynak eserin anlatımı","vi":"được dựa trên (biểu hiện)","zh-Hans-CN":"源作品的内容表达"},"ToolkitDefinition":{"ar":"تعبيرة تستخدم كأساس لتعبيرة مشتقة.","ca":"Expressió d’una obra que es modifica per crear una expressió d’una obra derivada.","cs":"Vyjádření díla, které je modifikováno za účelem vyjádření odvozeného díla.","da":"Udtryk, som anvendes som grundlag for et afledt udtryk.","de":"Eine Expression, die als Grundlage für eine abgeleitete Expression verwendet wird.","de":"Gesplittet in (Expression) Eine Expression eines Werks von mehreren Werken, die aus der Teilung einer früheren Expression in getrennte Expressionen entstanden ist.","el":"Μια έκφραση που χρησιμοποιείται ως η βάση για μια παράγωγη έκφραση.","en":"An expression of a work that is modified to create an expression of a derivative work.","es":"Una expresión de una obra que se modifica para crear una expresión de una obra derivada.","et":"Väljendus, mis on aluseks tuletatud väljendusele.","fi":"Teoksen ekspressio, jota on muokattu johdannaisteoksen ekspression luomiseksi.","fr":"Expression d’une œuvre qui est modifiée pour créer une expression d’une œuvre dérivée.","hu":"Egy kifejezési forma, amelyet egy származékos kifejezési forma alapjaként használnak.","lv":"Izteiksme, kas izmantota par pamatu atvasinātai izteiksmei.","nl":"Een expressie van een werk dat is aangepast om te creëren een expressie van een afgeleid werk.","no":"Et uttrykk brukt som utgangspunkt for et avledet uttrykk.","tr":"Türetilmiş bir eserin anlatımını oluşturmak için değiştirilen bir eserin anlatımı.","vi":"Biểu hiện được sử dạng làm cơ sở cho biểu hiện dẫn xuất.","zh-Hans-CN":"被修改以创建一种衍生作品的一种内容表达的一种作品的一种内容表达"},"altLabel":{"ca":["basat en l’expressió"],"cs":["založeno na vyjádření"],"de":