                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20100", "lexicalAlias":"http://rdaregistry.info/Elements/e/complementedByExpression.en", "label":"is complemented by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/scriptForRadioProgramExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20176", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/scriptForRadioProgramExpression.en", "label":"is script for radio program expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20176", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/scriptForRadioProgramExpression.en", "label":"is script for radio program expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20174","label":{"ar":"هي سيناريو لتعبيرة برنامج تليفزيوني","ca":"és expressió de guió per a programa de televisió","cs":"je scénářem pro televizní program (vyjádření)","da":"er manuskript til tv-programudtryk","de":"ist Drehbuch für Fernsehsendung (Expression)","de":"ist Drehbuch für Fernsehsendung (Expression)","el":"είναι σενάριο για τηλεοπτικό πρόγραμμα (έκφραση)","en":"is screenplay for television program expression","es":"es guión para expresión de programa de televisión","et":"stsenaarium telesaate väljendusele","fi":"käsikirjoitus televisio-ohjelmaan (ekspressio)","fr":"est un scénario pour une émission de télévision (expression)","hu":"forgatókönyv televízióműsor a következő kifejezési formájához:","lv":"ir televīzijas raidījuma scenārijs izteiksmei","nl":"is scenario voor televisieprogramma-expressie","no":"er manus for fjernsynsprogram (uttrykk)","tr":"televizyon programı anlatımı için senaryodur","vi":"là kịch bản cho chương trình truyền hình (biểu hiện)","zh-H