                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20039", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerAgent.en", "label":"has performer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/singerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20441", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerCollectiveAgent.en", "label":"has singer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20382", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerPerson.en", "label":"has singer person"},{"@id":"http://rdaregistry.info/Elements/e/object/P20025", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/singerAgent.en", "label":"has singer agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20025", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/singerAgent.en", "label":"has singer agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20441","label":{"ar":"لها وكيل جماعي مغنٍ","ca":"té com a agent col·lectiu cantant","cs":"má zpěváka (kolektivního agenta)","da":"har kollektiv agent, som er syngere","de":"hat Sängerin/Sänger (Gemeinschaftlicher Akteur)","de":"hat Sängerin/Sänger (Gemeinschaftlicher Akteur)","en":"has singer collective agent","es":"tiene agente colectivo cantante","et":"laulja (kollektiiv)","fi":"laulaja (yhteistoimija)","fr":"a pour agent collectif chanteur","hu":"énekes kollektív ágense a következő:","lv":"dziedātājs (grupa)","nl":"heeft zanger-collectieve actor","no":"har sanger (kollektiv agent)","tr":"şarkıcı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有演唱者集体行为者"},"definition":{"ar":["تربط بين تعبيرة ووكيل جماعي يكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج أغنية."],"ca":["Relaciona una expressió amb un agent col·lectiu que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música."],"cs":["Vztahuje vyjádření ke kolektivnímu agentovi, který je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj."],"da":["Relaterer et udtryk til en kollektiv agent, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkompagnement, for at producere musik."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt."],"en":["Relates an expression to a collective agent who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music."],"es":["Relaciona una expresión con un agente colectivo que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música."],"et":["Seostab väljenduse kollektiiviga, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma."],"fi":["Liittää ekspression yhteistoimijaan, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia."],"fr":["Met une expression en relation avec un agent collectif interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó kollektív ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására."],"lv":["Sasaista izteiksmi ar grupu, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma."],"nl":["Relateert een expressie aan een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het gebruik van zijn stem, met of zonder instrumentale begeleiding, om muziek te produceren."],"no":["Relaterer et uttrykk til en kollektiv agent som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk."],"tr":["Bir anlatımı, müzik üretmek için enstrüman eşliğinde veya eşliksiz sesini kullanarak bir anlatıma katkıda bulunan sanatçı olan kolektif bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مغنٍ","ca":"agent col·lectiu cantant","cs":"zpěvák (kolektivní agent)","da":"kollektiv agent, som er syngere","de":"Sängerin/Sänger (Gemeinschaftlicher Akteur)","de":"Sängerin/Sänger (Gemeinschaftlicher Akteur)","en":"singer collective agent","es":"agente colectivo cantante","et":"laulja (kollektiiv)","fi":"laulaja (yhteistoimija)","fr":"agent collectif chanteur","hu":"énekes kollektív ágens:","lv":"dziedātājs (grupa)","nl":"zanger-collectieve actor","no":"sanger (kollektiv agent)","tr":"şarkıcı kolektif temsilci","zh-Hans-CN":"演唱者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج أغنية.","ca":"Agent col·lectiu que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música.","cs":"Kolektivní agent, který je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj.","da":"Kollektiv agent, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkompagnement, for at producere musik.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme mit oder ohne instrumentale Begleitung Musik erzeugt.","de":"Eine Ausführende/Ein Ausführender (Gemeinschaftlicher Akteur), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme mit oder ohne instrumentale Begleitung Musik erzeugt.","en":"A collective agent who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music.","es":"Un agente colectivo que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música.","et":"Kollektiiv, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma.","fi":"Yhteistoimija, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia.","fr":"Agent collectif interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique.","hu":"Egy előadó kollektív ágens, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására.","lv":"Grupa - izpildītājs, kas sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma.","nl":"Een collectieve actor die een uitvoerder is die bijdraagt aan een expressie door het gebruik van zijn stem, met of zonder instrumentale begeleiding, om muziek te produceren.","no":"En kollektiv agent som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk.","tr":"Müzik yapımı için enstrüman eşliğinde veya eşliksiz olarak sesini kullanarak bir ifadeye katkıda bulunan bir sanatçı olan kolektif temsilci","zh-Hans-CN":"作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个集体行为者"},"note":{"ar":["قد يشتمل أداء المغني أو لا يشتمل على كلمات فعلية."],"ca":["Una actuació d’un cantant pot incloure paraules reals o no incloure-les."],"cs":["Účinkování zpěváka může, ale nemusí obsahovat skutečná slova."],"da":["Performance med en sanger, kan eller ikke indeholde faktiske ord."],"de":["Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht.,Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht."],"en":["A performance of a singer may or may not include actual words."],"es":["Una presentación de un cantante puede o no incluir palabras propiamente dichas."],"et":["Laulja esitus võib sisaldada või mitte sisaldada tegelikult olemasolevaid sõnu."],"fi":["Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja."],"fr":["Une prestation d’un chanteur peut inclure ou non des paroles."],"hu":["Egy énekes előadása tartalmazhat vagy nem tartalmazhat tényleges szavakat."],"lv":["Dziedātāja sniegumā var būt vai nebūt iekļauts teksts."],"nl":["Een uitvoering van een zanger kan al dan niet werkelijke woorden omvatten."],"no":["Sangerens framføring kan være med eller uten ord."],"tr":["Bir şarkıcının performansı gerçek sözleri içerebilir veya içermebilir."],"zh-Hans-CN":["演唱者的表演可以包括或可以不包括歌词"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
