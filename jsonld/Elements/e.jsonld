                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/languageOfContent.en","instructionNumber":"7.12","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20007", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/languageOfContent.en", "label":"has language of content (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20069","definition":{"ar":["تربط بين تعبيرة ومستخلص، أو ملخص، أو موجز، أو وصف آخر لمحتوى تعبيرة."],"ca":["Relaciona una expressió amb una síntesi, sumari, sinopsi o una altra descripció del contingut d’una expressió."],"cs":["Vztahuje vyjádření k abstraktu, resumé, synopsi nebo jinému popisu obsahu vyjádření."],"da":["Relaterer et udtryk til et abstrakt, et resumé, en synopsis eller anden beskrivelse af et udtryks indhold."],"de":["Setzt eine Expression in Beziehung zu einem Abstract, einer Zusammenfassung, einer Synopse oder einer anderen Beschreibung des Inhalts einer Expression.,Setzt eine Expression in Beziehung zu einem Abstract, einer Zusammenfassung, einer Synopse oder einer anderen Beschreibung des Inhalts einer Expression."],"el":["Συνδέει μια έκφραση με μια επιτομή, περίληψη, σύνοψη κ.λπ. του περιεχομένου μιας έκφρασης."],"en":["Relates an expression to an abstract, summary, synopsis, or other description of the content of an expression."],"es":["Relaciona una expresión con un resumen, sumario, sinopsis u otra descripción del contenido de una expresión."],"et":["Seostab väljenduse väljenduse sisu annotatsiooniga, kokkuvõttega, sünopsisega vms."],"fi":["Liittää ekspression tiivistelmään, yhteenvetoon, synopsikseen tai muuhun ekspression sisällön kuvaukseen."],"fr":["Met une expression en relation avec une synthèse, un résumé, un synopsis ou une autre description du contenu d’une expression."],"hu":["Hozzákapcsol egy kifejezési formátt egy kifejezési forma tartalmának a referátumához, összefoglalásához, szinopszisához, vagy egyéb leírásához."],"lv":["Sasaista izteiksmi ar izteiksmes satura kopsavilkumu, konspekts, u.tml."],"nl":["Relateert een expressie aan een abstract, samenvatting, synopsis of andere beschrijving van de content van een expressie."],"no":["Relaterer et uttrykk til et resymé, et sammendrag, en synopsis etc. av innholdet i et uttrykk."],"tr":["Bir anlatımı, anlatımın içeriğinin öz, özet, sinopsis veya başka bir tanımlamasıyla ilişkilendirir."],"vi":["Tóm tắt, tóm lược, toát yếu, v.v..., của nội dung của biểu hiện."],"zh-Hans-CN":["将一种内容表达与一种内容表达的内容的摘要、概要、大纲或其他描述关联起来。"]},"ToolkitLabel":{"ar":"تلخيص لمحتوى","ca":"resum de contingut","cs":"shrnutí obsahu","da":"opsummering af indhold","de":"Zusammenfassung eines Inhalts","de":"Zusammenfassung eines Inhalts","el":"σύνοψη του περιεχομένου","en":"summarization of content","es":"resumen del contenido","et":"sisukokkuvõte","fi":"sisällön yhteenveto","fr":"résumé du contenu","hu":"tartalom összefoglalása:","lv":"satura kopsavilkums","nl":"samenvatting van content","no":"sammendrag av innhold","sv":"innehållsbeskrivning","tr":"içeriğin özetlenmesi","vi":"tóm lược nội dung","zh-Hans-CN":"内容的概述"},"ToolkitDefinition":{"ar":"مستخلص، أو ملخص، أو موجز، أو وصف آخر لمحتوى تعبيرة.","ca":"Síntesi, sumari, sinopsi o una altra descripció del contingut d’una expressió.","cs":"Abstrakt, resumé, synopse nebo jiný popis obsahu vyjádření.","da":"Abstrakt, et resumé, en synopsis eller anden beskrivelse af et udtryks indhold.","de":"Ein Abstract, einer Zusammenfassung, einer Synopse oder einer anderen Beschreibung des Inhalts einer Expression.","de":"Ein Abstract, einer Zusammenfassung, einer Synopse oder einer anderen Beschreibung des Inhalts einer Expression.","el":"Μια επιτομή, περίληψη, σύνοψη κ.λπ. του περιεχομένου μιας έκφρασης.","en":"An abstract, summary, synopsis, or other description of the content of an expression.","es":"Un resumen, sumario, sinopsis u otra descripción del contenido de una expresión.","et":"Väljenduse sisu annotatsioon, kokkuvõte, sünopsis vms.","fi":"Tiivistelmä, yhteenveto, synopsis tai muu ekspression sisällön kuvaus.","fr":"Synthèse, résumé, synopsis ou autre description du contenu d’une expression.","hu":"Egy kifejezési forma tartalmának a referátumához, összefoglalásához, szinopszisához, vagy egyéb leírása.","lv":"Izteiksmes satura kopsavilkums, konspekts, u.tml.","nl":"Een abstract, samenvatting, synopsis of andere beschrijving van de content van een expressie.","no":"Et resymé, et sammendrag, en synopsis etc. av innholdet i et uttrykk.","tr":"Bir anlatımın içeriğinin özü, özeti, sinopsisi veya başka bir açıklaması.","vi":"Tóm tắt, tóm lược, toát yếu, v.v..., của nội dung của biểu hiện.","zh-Hans-CN":"一种内容表达的内容的摘要、概要、大纲或其他描述"},"label":{"ar":"تلخيص لمحتوى","ca":"té com a resum de contingut","cs":"má shrnutí obsahu","da":"har opsummering af indhold","de":"hat Zusammenfassung eines Inhalts","de":"hat Zusammenfassung eines Inhalts","el":"έχει σύνοψη του περιεχομένου","en":"has summarization of content","es":"tiene un resumen del contenido","et":"sisukokkuvõte","fi":"sisällön yhteenveto","fr":"a pour résumé du contenu","hu":"tartalom összefoglalása a következő:","lv":"satura kopsavilkums","nl":"heeft samenvatting van content","no":"har sammendrag av innhold","sv":"har innehållsbeskrivning","tr":"içeriğin özetlenmesi ile ilişkilidir","vi":"có tóm lược nội dung","zh-Hans-CN":"有内容的概述"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/summarizationOfContent.en","instructionNumber":"7.1","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/datatype/P20069", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/summarizationOfContent.en", "label":"has summarization of content"}]},{"@id":"http://rdaregistry.info/Elements/e/P20001","label":{"ar":"لها نوع محتوى","ca":"té com a tipus de contingut","cs":"má typ obsahu","da":"har indholdstype","de":"hat Inhaltstyp","de":"hat Inhaltstyp","el":"έχει τύπο περιεχομένου","en":"has content type","es":"tiene tipo de contenido","et":"sisu tüüp","fi":"sisältötyyppi","fr":"a pour type de contenu","hu":"tartalomtípusa a következő:","lv":"satura veids","nl":"heeft type content","no":"har innholdstype","sv":"har innehållstyp","tr":"içerik türü ile ilişkilidir","vi":"có loại nội dung","zh-Hans-CN":"有内容类型"},"definition":{"ar":["تربط بين تعبيرة وتصنيف يعكس الشكل الأساسي للتواصل، الذي يتم التعبير فيه عن المحتوى والحس الإنساني، الذي يُقصد تصوره من خلاله."],"ca":["Relaciona una expressió amb una categorització que reflecteix la forma fonamental de comunicació en què s’expressa el contingut i el sentit humà per mitjà del qual s’ha de percebre."],"cs":["Vztahuje vyjádření ke kategorizaci, která odráží základní formu komunikace, v níž je vyjádřen obsah, a smysl, jímž by se měla vnímat."],"da":["Relaterer et udtryk til en kategorisering, som afspejler den grundlæggende kommunikationsform, hvorigennem indholdet udtrykkes, og den menneskelige sans, hvorigennem det er meningen, at det skal opfattes."],"de":["Setzt eine Expression in Beziehung zu einer Kategorisierung, die zum einen die grundlegende Form der Kommunikation widerspiegelt, in der der Inhalt ausgedrückt wird, und zum andern die menschliche Wahrnehmung wiedergibt, durch die diese wahrgenommen werden soll.,Setzt eine Expression in Beziehung zu einer Kategorisierung, die zum einen die grundlegende Form der Kommunikation widerspiegelt, in der der Inhalt ausgedrückt wird, und zum andern die menschliche Wahrnehmung wiedergibt, durch die diese wahrgenommen werden soll."],"el":["Συνδέει μια έκφραση με μια κατηγοριοποίηση η οποία αντανακλά τη θεμελιώδη μορφή της επικοινωνίας με την οποία εκφράζεται το περιεχόμενο και τις ανθρώπινες αισθήσεις μέσω των οποίων προσλαμβάνεται."],"en":["Relates an expression to a categorization that reflects the fundamental form of communication in which the content is expressed and the human sense through which it is intended to be perceived."],"es":["Relaciona una expresión con una categorización que refleja la forma fundamental de comunicación en la que se expresa el contenido y el sentido humano a través del cual se pretende percibirlo."],"et":["Seostab väljenduse kategooriaga, mis kajastab kommunikatsiooni põhivormi, milles sisu on väljendatud, ja inimmeelt, mille kaudu seda tajutakse."],"fi":["Liittää ekspression jaotteluun, joka ilmaisee sisällön esitysmuodon ja sen, minkä aistin välityksellä sisältö on tarkoitus vastaanottaa."],"fr":["Met une expression en relation avec une catégorisation qui reflète la forme fondamentale de communication sous laquelle le contenu est exprimé et le sens humain par lequel il est destiné à être perçu."],"hu":["Hozzákapcsol egy kifejezési formát egy kategorizáláshoz, amely tükrözi a kommunikáció azon alapvető formáját, melyen a tartalom kifejezésre kerül, és amelyet emberi érzékszerven keresztüli érzékelésére szántak."],"lv":["Sasaista izteiksmi ar kategorizāciju, kas atspoguļo saziņas pamatformu, kurā saturs ir izteikts, ar to, kā cilvēks to uztver un saprot (maņas)."],"nl":["Relateert een expressie aan een categorisatie die weerspiegelt de fundamentele vorm van communicatie waarin de content uitgedrukt is en het menselijke zintuig waarmee het bedoeld is waargenomen te worden."],"no":["Relaterer et uttrykk til en inndeling som gjenspeiler den opprinnelige kommunikasjonsformen som innholdet er uttrykt i, og den menneskelige sansen som det er ment å oppfattes gjennom."],"tr":["Bir anlatımı, içeriğin ifade edildiği temel iletişim biçimini ve algılanması amaçlanan insan duyusunu yansıtan bir sınıflandırmayla ilişkilendirir."],"vi":["Liên kết một biểu hiện với chia loại phản ánh hình thái cơ bản của giao tiếp trong đó nội dung được thể hiện và giác quan của con người dự kiến cảm nhận thông qua đó."],"zh-Hans-CN":["将一种内容表达与反映其内容被表达所用交流的基本形式和设计被感知的人类感觉的分类关联起来。"]},"note":{"ar":["نوع محتوى يعكس عدد الأبعاد المكانية ووجود الحركة أو عدم وجودها؛ حيث يُقصد تصور المحتوى الذي يتم التعبير عنه فيها في شكل صورة أو صور."],"ca":["El tipus de contingut també reflecteix el nombre de dimensions espacials i la presència o l’absència de moviment en què el contingut expressat en la forma d’una o més imatges s’ha de percebre."],"cs":["Typ obsahu také odráží počet prostorových dimenzí a přítomnost či nepřítomnost pohybu, v jakém má být obsah vyjádřený formou obrazu či obrazů vnímán."],"da":["Hvad angår indhold, som udtrykkes i form af et eller flere billeder, afspejler indholdstype desuden antallet af rumlige dimensioner, som indholdet skal opfattes i, samt opfattelsen af tilstedeværelse eller fravær af bevægelse."],"de":["Für Inhalt, der in Form eines Bilds oder mehrerer Bilder ausgedrückt wird, spiegelt der Inhaltstyp auch die Anzahl räumlicher Dimensionen wider, in denen der Inhalt wahrgenommen werden soll, sowie die Wahrnehmung von vorhandener oder nicht vorhandener Bewegung.,Für Inhalt, der in Form eines Bilds oder mehrerer Bilder ausgedrückt wird, spiegelt der Inhaltstyp auch die Anzahl räumlicher Dimensionen wider, in denen der Inhalt wahrgenommen werden soll, sowie die Wahrnehmung von vorhandener oder nicht vorhandener Bewegung."],"el":["Ο τύπος περιεχομένου αντανακλά επίσης τον αριθμό των χωρικών διαστάσεων και την παρουσία ή την απουσία κίνησης μέσω της οποίας προσλαμβάνεται το το περιεχόμενο το οποίο εκφράζεται στη μορφή μιας εικόνας ή εικόνων."],"en":["Content type also reflects the number of spatial dimensions and the presence or absence of movement in which content expressed in the form of an image or images is intended to be perceived."],"es":["El tipo de contenido también refleja el número de dimensiones espaciales y la presencia o ausencia de movimiento en el que se pretende percibir el contenido expresado en forma de imagen o imágenes."],"et":["Pildi või piltidena väljendatud sisu puhul kajastab sisu tüüp ka sisu tajumist määravat ruumiliste mõõtmete arvu ja liikumise olemasolu või puudumist."],"fi":["Sisältötyyppi kertoo myös kuvan tai kuvien kaksi- tai kolmiulotteisuudesta ja sen, onko kyseessä liikkuva kuva vai stillkuva."],"fr":["Dans le cas d’un contenu exprimé sous la forme d’une ou plusieurs images, un type de contenu reflète également le nombre de dimensions spatiales au travers desquelles le contenu doit être perçu et la présence ou l’absence perceptibles de mouvement."],"hu":["A tartalomtípus a térbeli dimenziók számát és a mozgás jelenlétét vagy hiányát is tükrözi, amelyben kép vagy képek alakjában kifejezett tartalmat kívánnak érzékeltetni."],"lv":["Saturs, kas izteikts kā attēls vai attēli, atspoguļo vairākas telpiskas dimensijas, kurās saturu paredzēts uztvert ar vai bez kustību klātbūtnes."],"nl":["Type content geeft ook het aantal ruimtelijke dimensies weer en de aanwezigheid of afwezigheid van beweging waarmee content uitgedrukt in de vorm van een beeld of beelden geacht wordt waargenomen."],"no":["Innholdstypen gjenspeiler også antallet romlige dimensjoner og tilstedeværelse eller fravær av bevegelse som innhold uttrykt i form av ett eller flere bilder, er ment å oppfattes gjennom."],"tr":["İçerik türü, ayrıca bir veya birden fazla görüntü biçiminde ifade edilen içeriğin algılanması amacıyla tasarlandığı mekânsal boyut sayısını ve hareketin varlığını veya yokluğunu yansıtır."],"vi":["Loại nội dung cũng phản ánh số lượng kích thước không gian và sự có hoặc không của động thái mà trong đó nội dung được thể hiện dưới hình thái của hình ảnh hoặc các hình ảnh có ý định để cảm nhận."],"zh-Hans-CN":["对于被设计以一种或多种被感知图像形式表达的内容，内容类型还反映空间维度数以及感知运动是否存在。"]},"ToolkitLabel":{"ar":"نوع محتوى","ca":"tipus de contingut","cs":"typ obsahu","da":"indholdstype","de":"Inhaltstyp","de":"Inhaltstyp","el":"τύπος περιεχομένου","en":"content type","es":"tipo de contenido","et":"sisu tüüp","fi":"sisältötyyppi","fr":"type de contenu","hu":"tartalomtípusa:","lv":"satura veids","nl":"type content","no":"innholdstype","sv":"innehållstyp","tr":"içerik türü","vi":"loại nội dung","zh-Hans-CN":"内容类型"},"ToolkitDefinition":{"ar":"تصنيف يعكس الشكل الأساسي للتواصل، الذي يتم التعبير فيه عن المحتوى والحس الإنساني، الذي يُقصد تصوره من خلاله.","ca":"Categorització que reflecteix la forma fonamental de comunicació en què s’expressa el contingut i el sentit humà per mitjà del qual s’ha de percebre.","cs":"Kategorizace, která odráží základní formu komunikace, v níž je vyjádřen obsah, a smysl, jímž by se měla vnímat.","da":"Kategorisering, som afspejler den grundlæggende kommunikationsform, hvorigennem indholdet udtrykkes, og den menneskelige sans, hvorigennem det er meningen, at det skal opfattes.","de":"Eine Kategorisierung, die zum einen die grundlegende Form der Kommunikation widerspiegelt, in der der Inhalt ausgedrückt wird, und zum andern die menschliche Wahrnehmung wiedergibt, durch die diese wahrgenommen werden soll.","de":"Eine Kategorisierung, die zum einen die grundlegende Form der Kommunikation widerspiegelt, in der der Inhalt ausgedrückt wird, und zum andern die menschliche Wahrnehmung wiedergibt, durch die diese wahrgenommen werden soll.","el":"Μια κατηγοριοποίηση η οποία αντανακλά τη θεμελιώδη μορφή της επικοινωνίας με την οποία εκφράζεται το περιεχόμενο και [η οποία αντανακλά] τις ανθρώπινες αισθήσεις μέσω των οποίων προσλαμβάνεται.","en":"A categorization that reflects the fundamental form of communication in which the content is expressed and the human sense through which it is intended to be perceived.","es":"Una categorización que refleja la forma fundamental de comunicación en la que se expresa el contenido y el sentido humano a través del cual se pretende percibirlo.","et":"Kategooria, mis kajastab kommunikatsiooni põhivormi, milles sisu on väljendatud, ja inimmeelt, mille kaudu seda tajutakse.","fi":"Jaottelu, joka ilmaisee sisällön esitysmuodon ja sen, minkä aistin välityksellä sisältö on tarkoitus vastaanottaa.","fr":"Catégorisation qui reflète la forme fondamentale de communication sous laquelle le contenu est exprimé et le sens humain par lequel il est destiné à être perçu.","hu":"Egy kategorizáció, amely tükrözi a kommunikáció azon alapvető formáját, melyen a tartalom kifejezésre kerül, és amelyet emberi érzékszerven keresztüli érzékelésére szántak.","lv":"Kategorizācija, kas atspoguļo saziņas pamatformu, kurā saturs ir izteikts, ar to, kā cilvēks to uztver un saprot (maņas).","nl":"Een categorisatie die weerspiegelt de fundamentele vorm van communicatie waarin de content uitgedrukt is en het menselijke zintuig waarmee het bedoeld is waargenomen te worden.","no":"En inndeling som gjenspeiler den opprinnelige kommunikasjonsformen som innholdet er uttrykt i, og den menneskelige sansen som det er ment å oppfattes gjennom.","tr":"İçeriğin ifade edildiği temel iletişim biçimini ve algılanması amaçlanan insan duyusunu yansıtan bir sınıflandırma.","vi":"Chia loại phản ánh hình thái cơ bản của giao tiếp mà trong đó nội dung được thể hiện và giác quan của con người qua đó dự định được cảm nhận.","zh-Hans-CN":"反映内容被表达所用交流的基本形式和设计被感知的人类感觉的分类"},"altLabel":{"ar":["نوع لمحتوى"],"ca":["tipus de contingut"],"da":["type af indhold"],"en":["type of content"],"es":["tipo de contenido"],"fi":["sisällön tyyppi"],"fr":["catégorie de contenu"],"hu":["tartalom típusa:"],"nl":["type van content"],"no":["type innhold"],"tr":["içeriğin türü"],"zh-Hans-CN":["内容的类型"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/contentType.en","instructionNumber":"6.9","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20001", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/contentType.en", "label":"has content type"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20001", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/contentType.en", "label":"has content type"}]},{"@id":"http://rdaregistry.info/Elements/e/P20066","label":{"ar":"هي معالجة كتعبيرة برنامج تليفزيوني","ca":"és adaptat com a expressió de programa de televisió","cs":"je adaptováno jako televizní program (vyjádření)","da":"er bearbejdet til tv-programudtryk","de":"ist bearbeitet als Fernsehsendung (Expression)","de":"ist bearbeitet als Fernsehsendung (Expression)","el":"είναι προσαρμοσμένη ως τηλεοπτικό πρόγραμμα (έκφραση)","en":"is adapted as television program expression","es":"está adaptado como expresión de un programa de televisión.","et":"adapteeritud telesaatena (väljendus)","fi":"televisiosovitus (ekspressio)","fr":"est adapté en émission de télévision (expression)","hu":"televízióműsor kifejezési formaként való feldolgozása a következő:","lv":"ir adaptēts kā televīzijas raidījums (izteiksme)","nl":"is bewerkt als televisieprogramma-expressie","no":"er bearbeidet som fjernsynsprogram (uttrykk)","tr":"televizyon programı anlatımı olarak uyarlanmıştır","vi":"được phỏng theo như là chương trình truyền hình (biểu hiện)","zh-Hans-CN":"被改编为电视节目内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لبرنامج تليفزيوني مبني على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’un programa de televisió que es basa en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření televizn