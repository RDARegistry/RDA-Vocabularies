                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/singerCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20410", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCollectiveAgent.en", "label":"has performer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20025", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerAgent.en", "label":"has singer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20500", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerCorporateBody.en", "label":"has singer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20559", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerFamily.en", "label":"has singer family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20441", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/singerCollectiveAgent.en", "label":"has singer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20441", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/singerCollectiveAgent.en", "label":"has singer collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20500","label":{"ar":"لها هيئة مغنية","ca":"té com a entitat corporativa cantant","cs":"má zpěváka (korporaci)","da":"har koproration, som er sanger","de":"hat Sängerin/Sänger (Körperschaft)","de":"hat Sängerin/Sänger (Körperschaft)","en":"has singer corporate body","es":"tiene organismo corporativo cantante","et":"laulja (asutus)","fi":"laulaja (yhteisö)","fr":"a pour collectivité chanteuse","hu":"énekes testülete a következő:","lv":"dziedātājs (institūcija)","nl":"heeft zanger-corporatie","no":"har sanger (korporasjon)","tr":"şarkıcı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有演唱者团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج موسيقى."],"ca":["Relaciona una expressió amb una entitat corporativa que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música."],"cs":["Vztahuje vyjádření ke korporaci, která je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj."],"da":["Relaterer et udtryk til en korporation, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkompagnement, til at producere musik."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt."],"en":["Relates an expression to a corporate body who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music."],"es":["Relaciona una expresión con un organismo corporativo que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música."],"et":["Seostab väljenduse asutusega, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma."],"fi":["Liittää ekspression yhteisöön, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia."],"fr":["Met une expression en relation avec une collectivité interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó testülethez, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására."],"lv":["Sasaista izteiksmi ar institūciju, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma."],"nl":["Relateert een expressie aan een corporatie die een uitvoerder is die bijdraagt aan een expressie door het gebruik van haar stem, met of zonder instrumentale begeleiding, om muziek te produceren."],"no":["Relaterer et uttrykk til en korporasjon som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk."],"tr":["Bir anlatımı, müzik üretmek için enstrüman eşliğinde veya eşliksiz sesini kullanarak bir anlatıma katkıda bulunan sanatçı olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مغنية","ca":"entitat corporativa cantant","cs":"zpěvák (korporace)","da":"korporation som er sanger","de":"Sängerin/Sänger (Körperschaft)","de":"Sängerin/Sänger (Körperschaft)","en":"singer corporate body","es":"organismo corporativo cantante","et":"laulja (asutus)","fi":"laulaja (yhteisö)","fr":"collectivité chanteuse","hu":"énekes testület:","lv":"dziedātājs (institūcija)","nl":"zanger-corporatie","no":"sanger (korporasjon)","tr":"şarkıcı tüzel kişi","zh-Hans-CN":"演唱者团体"},"ToolkitDefinition":{"ar":"هيئة تكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج موسيقى.","ca":"Entitat corporativa que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música.","cs":"Korporace, která je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj.","da":"Korporation, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkompagnement, til at producere musik.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","de":"Eine Ausführende/Ein Ausführender (Körperschaft), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","en":"A corporate body who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music.","es":"Un organismo corporativo que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música.","et":"Asutus, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma.","fi":"Yhteisö, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia.","fr":"Collectivité interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique.","hu":"Egy előadó testület, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására.","lv":"Institūcija - izpildītājs, kas sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma.","nl":"Een corporatie die een uitvoerder is die bijdraagt aan een expressie door het gebruik van haar stem, met of zonder instrumentale begeleiding, om muziek te produceren.","no":"En korporasjon som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk.","tr":"Enstrüman eşliğinde veya enstrümansız olarak sesini kullanarak müzik üretmek için bir anlatıma, ifadeye katkıda bulunan bir sanatçı olan tüzel kişi","zh-Hans-CN":"作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个团体"},"note":{"ar":["قد يشتمل أداء المغني أو لا يشتمل على كلمات فعلية."],"ca":["Una actuació d’un cantant pot incloure paraules reals o no incloure-les."],"cs":["Účinkování zpěváka může, ale nemusí obsahovat skutečná slova."],"da":["Performance med en sanger, kan eller ikke indeholde faktiske ord."],"de":["Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht.,Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht."],"en":["A performance of a singer may or may not include actual words."],"es":["Una presentación de un cantante puede o no incluir palabras propiamente dichas."],"et":["Laulja esitus võib sisaldada või mitte sisaldada tegelikult olemasolevaid sõnu."],"fi":["Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja."],"fr":["Une prestation d’un chanteur peut inclure ou non des paroles."],"hu":["Egy énekes előadása tartalmazhat vagy nem tartalmazhat tényleges szavakat."],"lv":["Dziedātāja sniegumā var būt vai nebūt iekļauts teksts."],"nl":["Een uitvoering van een zanger kan al dan niet werkelijke woorden omvatten."],"no":["Sangerens framføring kan være med eller uten ord."],"tr":["Bir şarkıcının performansı gerçek sözleri içerebilir veya içermebilir."],"zh-Hans-CN":["演唱者的表演可以包括或可以不包括歌词"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/singerCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20469", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerCorporateBody.en", "label":"has performer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20441", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerCollectiveAgent.en", "label":"has singer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20500", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/singerCorporateBody.en", "label":"has singer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20500", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/singerCorporateBody.en", "label":"has singer corporate body"}]},{"@id":"http://rdaregistry.info/Elements/e/P20559","label":{"ar":"لها عائلة مغنية","ca":"té com a família cantant","cs":"má zpěváka (rodinu)","da":"har familie, som er sanger","de":"hat Sängerin/Sänger (Familie)","de":"hat Sängerin/Sänger (Familie)","en":"has singer family","es":"tiene familia cantante","et":"laulja (perekond)","fi":"laulaja (suku)","fr":"a pour famille chanteuse","hu":"énekes családja a következő:","lv":"dziedātājs (dzimta/ģimene)","nl":"heeft zanger-familie","no":"har sanger (familie)","tr":"şarkıcı ailesi ile ilişkilidir","zh-Hans-CN":"有演唱者家族"},"definition":{"ar":["تربط بين تعبيرة وعائلة تكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج موسيقى."],"ca":["Relaciona una expressió amb una família que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música."],"cs":["Vztahuje vyjádření k rodině, která je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj."],"da":["Relaterer et udtryk til en familie, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkomagnement, for at producere musik."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Familie), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt."],"en":["Relates an expression to a family who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music."],"es":["Relaciona una expresión con una familia que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música."],"et":["Seostab väljenduse perekonnaga, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma."],"fi":["Liittää ekspression sukuun, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia."],"fr":["Met une expression en relation avec une famille interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó családhoz, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására."],"lv":["Sasaista izteiksmi ar dzimtu/ģimeni, kas ir izpildītājs, kas sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma."],"nl":["Relateert een expressie aan een familie die een uitvoerder is die bijdraagt aan een expressie door het gebruik van haar stem, met of zonder instrumentale begeleiding, om muziek te produceren."],"no":["Relaterer et uttrykk til en familie som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk."],"tr":["Bir anlatımı, müzik üretmek için enstrüman eşliğinde veya eşliksiz sesini kullanarak bir anlatıma katkıda bulunan sanatçı olan aileyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مغنية","ca":"família cantant","cs":"zpěvák (rodina)","da":"famile, som er sanger","de":"Sängerin/Sänger (Familie)","de":"Sängerin/Sänger (Familie)","en":"singer family","es":"familia cantante","et":"laulja (perekond)","fi":"laulaja (suku)","fr":"famille chanteuse","hu":"énekes család:","lv":"dziedātājs (dzimta/ģimene)","nl":"zanger-familie","no":"sanger (familie)","tr":"şarkıcı aile","zh-Hans-CN":"演唱者家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج موسيقى.","ca":"Família que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música.","cs":"Rodina, která je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj.","da":"Familie, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkomagnement, for at producere musik.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","de":"Eine Ausführende/Ein Ausführender (Familie), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","en":"A family who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music.","es":"Una familia que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música.","et":"Perekond, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma.","fi":"Suku, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia.","fr":"Famille interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique.","hu":"Egy előadó család, amely hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására.","lv":"Dzimta/ģimene - izpildītājs, kas sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma.","nl":"Een familie die een uitvoerder is die bijdraagt aan een expressie door het gebruik van haar stem, met of zonder instrumentale begeleiding, om muziek te produceren.","no":"En familie som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk.","tr":"Müzik üretmek için enstrüman eşliğinde veya enstrümansız seslerini kullanarak bir anlatıma katkıda bulunan bir sanatçı bir aile.","zh-Hans-CN":"作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个家族"},"note":{"ar":["قد يشتمل أداء المغني أو لا يشتمل على كلمات فعلية."],"ca":["Una actuació d’un cantant pot incloure paraules reals o no incloure-les."],"cs":["Účinkování zpěváka může, ale nemusí obsahovat skutečná slova."],"da":["Performance af en sanger kan eller ikke inkludere faktiske ord."],"de":["Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht.,Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht."],"en":["A performance of a singer may or may not include actual words."],"es":["Una presentación de un cantante puede o no incluir palabras propiamente dichas."],"et":["Laulja esitus võib sisaldada või mitte sisaldada tegelikult olemasolevaid sõnu."],"fi":["Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja."],"fr":["Une prestation d’un chanteur peut inclure ou non des paroles."],"hu":["Egy énekes előadása tartalmazhat vagy nem tartalmazhat tényleges szavakat."],"lv":["Dziedātāja sniegumā var būt vai nebūt iekļauts teksts."],"nl":["Een uitvoering van een zanger kan al dan niet werkelijke woorden omvatten."],"no":["Sangerens framføring kan være med eller uten ord."],"tr":["Bir şarkıcının performansı gerçek sözleri içerebilir veya içermebilir."],"zh-Hans-CN":["演唱者的表演可以包括或可以不包括歌词"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/singerFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20528", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerFamily.en", "label":"has performer family"},{"@id":"http://rdaregistry.info/Elements/e/P20441", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerCollectiveAgent.en", "label":"has singer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20559", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/singerFamily.en", "label":"has singer family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20559", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/singerFamily.en", "label":"has singer family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20382","label":{"ar":"لها شخص مغنٍ","ca":"té com a persona cantant","cs":"má zpěváka (osobu)","da":"har person, som er sanger","de":"hat Sängerin/Sänger (Person)","de":"hat Sängerin/Sänger (Person)","en":"has singer person","es":"tiene persona cantante","et":"laulja (isik)","fi":"laulaja (henkilö)","fr":"a pour personne chanteuse","hu":"énekes személye a következő:","lv":"dziedātājs (persona)","nl":"heeft zanger-persoon","no":"har sanger (person)","tr":"şarkıcı kişisi ile ilişkilidir","zh-Hans-CN":"有演唱者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج موسيقى."],"ca":["Relaciona una expressió amb una persona que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música."],"cs":["Vztahuje vyjádření k osobě, která je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj."],"da":["Relaterer et udtryk til en person, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkompagnement, for at skabe musik."],"de":["Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.,Setzt eine Expression in Beziehung zu einer Ausführenden/einem Ausführenden (Person), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt."],"en":["Relates an expression to a person who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music."],"es":["Relaciona una expresión con una persona que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música."],"et":["Seostab väljenduse isikuga, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma."],"fi":["Liittää ekspression henkilöön, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia."],"fr":["Met une expression en relation avec une personne interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique."],"hu":["Hozzákapcsol egy kifejezési formát egy előadó személyhez, aki hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására."],"lv":["Sasaista izteiksmi ar personu, kura ir izpildītājs, kura sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma."],"nl":["Relateert een expressie aan een persoon die een uitvoerder is die bijdraagt aan een expressie door het gebruik van zijn stem, met of zonder instrumentale begeleiding, om muziek te produceren."],"no":["Relaterer et uttrykk til en person som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk."],"tr":["Bir anlatımı, müzik üretmek için enstrüman eşliğinde veya eşliksiz sesini kullanarak bir anlatıma katkıda bulunan sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مغنٍ","ca":"persona cantant","cs":"zpěvák (osoba)","da":"person, som er sanger","de":"Sängerin/Sänger (Person)","de":"Sängerin/Sänger (Person)","en":"singer person","es":"persona cantante","et":"laulja (isik)","fi":"laulaja (henkilö)","fr":"personne chanteuse","hu":"énekes személy:","lv":"dziedātājs (persona)","nl":"zanger-persoon","no":"sanger (person)","tr":"şarkıcı kişi","zh-Hans-CN":"演唱者个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤديًا يساهم في تعبيرة باستخدام صوته، بمصاحبة آلة موسيقية أو بدون، لإنتاج موسيقى.","ca":"Persona que és un intèrpret que contribueix a una expressió usant la seva veu, amb acompanyament instrumental o sense, per produir música.","cs":"Osoba, která je účinkujícím, který přispívá k vyjádření tím, že k produkci hudby využívá svůj hlas s hudebním doprovodem nebo bez něj.","da":"Person, som er en performer, der bidrager til et udtryk ved at bruge sin stemme, med eller uden instrumentalakkompagnement, for at skabe musik.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","de":"Eine Ausführende/Ein Ausführender (Person), die/der zu einer Expression beiträgt, indem sie/er durch ihre/seine Singstimme, mit oder ohne instrumentale Begleitung, Musik erzeugt.","en":"A person who is a performer who contributes to an expression by using their voice, with or without instrumental accompaniment, to produce music.","es":"Una persona que es un intérprete que contribuye a una expresión al utilizar su voz, con o sin un acompañamiento instrumental, para producir música.","et":"Isik, kes esitajana annab panuse väljendusse, kasutades muusika tegemiseks oma häält, kas instrumentaalsaatega või ilma.","fi":"Henkilö, joka on esittäjä, joka osallistuu ekspression tekemiseen käyttämällä ääntään, soitinsäestyksellä tai ilman, tuottaakseen musiikkia.","fr":"Personne interprète qui contribue à une expression en utilisant sa voix, avec ou sans accompagnement instrumental, pour produire de la musique.","hu":"Egy előadó személy, aki hozzájárul egy kifejezési formához azzal, hogy hangszeres kísérettel vagy anélkül a hangját használja zene előállítására.","lv":"Persona - izpildītājs, kura sniegusi ieguldījumu izteiksmē, dziedot ar vai bez instrumentāla pavadījuma.","nl":"Een persoon die een uitvoerder is die bijdraagt aan een expressie door het gebruik van zijn stem, met of zonder instrumentale begeleiding, om muziek te produceren.","no":"En person som er en utøver som bidrar til et uttrykk ved bruke å stemmen sin, med eller uten akkompagnement fra instrumenter, til å lage musikk.","tr":"Müzik üretmek için enstrüman eşliğinde veya enstrümansız sesini kullanarak bir anlatıma katkıda bulunan sanatçı olan bir kişidir.","zh-Hans-CN":"作为一个表演者通过用其人声（不管是否有乐器伴奏）产生音乐而对一种内容表达有贡献的一个个人"},"note":{"ar":["قد يشتمل أداء المغني أو لا يشتمل على كلمات فعلية."],"ca":["Una actuació d’un cantant pot incloure paraules reals o no incloure-les."],"cs":["Účinkování zpěváka může, ale nemusí obsahovat skutečná slova."],"da":["Performance med en sanger, kan eller ikke indeholde faktiske ord."],"de":["Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht.,Die Darbietung einer Sängerin/eines Sängers kann richtige Worte enthalten oder nicht."],"en":["A performance of a singer may or may not include actual words."],"es":["Una presentación de un cantante puede o no incluir palabras propiamente dichas."],"et":["Laulja esitus võib sisaldada või mitte sisaldada tegelikult olemasolevaid sõnu."],"fi":["Laulajan esitys voi sisältää tai olla sisältämättä todellisia sanoja."],"fr":["Une prestation d’un chanteur peut inclure ou non des paroles."],"hu":["Egy énekes előadása tartalmazhat vagy nem tartalmazhat tényleges szavakat."],"lv":["Dziedātāja sniegumā var būt vai nebūt iekļauts teksts."],"nl":["Een uitvoering van een zanger kan al dan niet werkelijke woorden omvatten."],"no":["Sangerens framføring kan være med eller uten ord."],"tr":["Bir şarkıcının performansı gerçek sözleri içerebilir veya içermebilir."],"zh-Hans-CN":["演唱者的表演可以包括或可以不包括歌词"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/singerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20351", "lexicalAlias":"http://rdaregistry.info/Elements/e/performerPerson.en", "label":"has performer person"},{"@id":"http://rdaregistry.info/Elements/e/P20025", "lexicalAlias":"http://rdaregistry.info/Elements/e/singerAgent.en", "label":"has singer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20382", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/singerPerson.en", "label":"has singer person"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20382", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/singerPerson.en", "label":"has singer person"}]},{"@id":"http://rdaregistry.info/Elements/e/P20280","definition":{"ar":["تربط بين تعبيرة ووكيل يساهم في تعبيرة من خلال البحث في البرمجيات، أو تصميمها، أو تنفيذها، أو اختبارها."],"ca":["Relaciona una expressió amb un agent que contribueix a una expressió amb la recerca, el disseny, la posada en marxa o l’examen de programari."],"cs":["Vztahuje vyjádření k agentovi, který přispívá k vyjádření výzkumem, navrhováním, implementací nebo testováním softwaru."],"da":["Relaterer et udtryk til en agent, som bidrager til et udtryk ved at researche, designe, implementere eller teste software."],"de":["Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er Software untersucht, konzipiert, implementiert oder testet.,Setzt eine Expression in Beziehung zu einem Akteur, der zu einer Expression beiträgt, indem er Software untersucht, konzipiert, implementiert oder testet."],"el":["Συνδέει μια έκφραση με έναν φορέα ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της έρευνας, του σχεδιασμού, της εφαρμογής ή της δοκιμής του λογισμικού."],"en":["Relates an expression to an agent who contributes to an expression by researching, designing, implementing, or testing software."],"es":["Relaciona una expresión con un agente que contribuye a una expresión investigando, diseñando, implementando o probando software."],"et":["Seostab väljenduse tegijaga, kes annab panuse väljendusse, uurides, kavandades, juurutades või testides tarkvara."],"fi":["Liittää ekspression toimijaan, joka osallistuu ekspression tekemiseen tutkimalla, suunnittelemalla, toteuttamalla tai testaamalla ohjelmistoa."],"fr":["Met une expression en relation avec un agent qui contribue à une expression en effectuant des travaux de recherche, de conception, de mise en œuvre ou de mise à l’essai d’un logiciel."],"hu":["Hozzákapcsol egy kifejezési formát egy ágenshez, amely hozzájárul egy kifejezési formához azzal, hogy szoftvereket kutat, tervez, implementál vagy tesztel."],"lv":["Sasaista izteiksmi ar aģentu, kas sniedzis ieguldījumu izteiksmē, izpētot, izstrādājot, ieviešot vai testējot programmatūru."],"nl":["Relateert een expressie aan een actor die bijdraagt aan een expressie door het onderzoeken, ontwerpen, toepassen of testen van software."],"no":["Relaterer et uttrykk til en agent som bidrar til et uttrykk av et verk ved å undersøke, designe, implementere eller teste programvare."],"tr":["Bir anlatımı, yazılım araştırarak, tasarlayarak, uygulayarak veya test ederek bir anlatıma katkıda bulunan temsilciyle ilişkilendirir."],"vi":["Liên kết một biểu hiện với tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách nghiên cứu, thiết kế, thực hiện, hoặc thử nghiệm phần mềm."],"zh-Hans-CN":["将一种内容表达与通过研究、设计、实施或测试软件而对一种内容表达有贡献的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مطور برمجيات","ca":"agent desenvolupador de programari","cs":"vývojář softwaru (agent)","da":"agent, som er softwareudvikler","de":"Softwareentwicklerin/Softwareentwickler (Akteur)","de":"Softwareentwicklerin/Softwareentwickler (Akteur)","el":"μηχανικός λογισμικού","en":"software developer agent","es":"agente desarrollador de software","et":"tarkvaraarendaja (tegija)","fi":"ohjelmistokehittäjä (toimija)","fr":"agent développeur de logiciel","hu":"szoftverfejlesztő ágens:","lv":"programmatūras izstrādātājs (aģents)","nl":"softwareontwikkelaar-actor","no":"programvareutvikler (agent)","tr":"yazılım geliştirici temsilci","vi":"người phát triển phần mềm","zh-Hans-CN":"软件开发者行为者"},"ToolkitDefinition":{"ar":"وكيل يساهم في تعبيرة من خلال البحث في البرمجيات، أو تصميمها، أو تنفيذها، أو اختبارها.","ca":"Agent que contribueix a una expressió amb la recerca, el disseny, la posada en marxa o l’examen de programari.","cs":"Agent, který přispívá k vyjádření výzkumem, navrhováním, implementací nebo testováním softwaru.","da":"Agent, som bidrager til et udtryk ved at researche, designe, implementere eller teste software.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er Software untersucht, konzipiert, implementiert oder testet.","de":"Ein Akteur, der zu einer Expression beiträgt, indem er Software untersucht, konzipiert, implementiert oder testet.","el":"Ένας φορέας ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της έρευνας, του σχεδιασμού, της εφαρμογής ή της δοκιμής του λογισμικού.","en":"An agent who contributes to an expression by researching, designing, implementing, or testing software.","es":"Un agente que contribuye a una expresión investigando, diseñando, implementando o probando software.","et":"Tegija, kes annab panuse väljendusse, uurides, kavandades, juurutades või testides tarkvara.","fi":"Toimija, joka osallistuu ekspression tekemiseen tutkimalla, suunnittelemalla, toteuttamalla tai testaamalla ohjelmistoa.","fr":"Agent qui contribue à une expression en effectuant des travaux de recherche, de conception, de mise en œuvre ou de mise à l’essai d’un logiciel.","hu":"Egy ágens, amely hozzájárul egy kifejezési formához azzal, hogy szoftvereket kutat, tervez, implementál vagy tesztel.","lv":"Aģents, kas sniedzis ieguldījumu izteiksmē, izpētot, izstrādājot, ieviešot vai testējot programmatūru.","nl":"Een actor die bijdraagt aan een expressie door het onderzoeken, ontwerpen, toepassen of testen van software.","no":"En agent som bidrar til et uttrykk av et verk ved å undersøke, designe, implementere eller teste programvare.","tr":"Yazılım araştırarak, tasarlayarak, uygulayarak veya test ederek bir anlatıma katkıda bulunan bir temsilci.","vi":"Tác nhân đóng góp cho biểu hiện của tác phẩm bằng cách nghiên cứu, thiết kế, thực hiện, hoặc thử nghiệm phần mềm.","zh-Hans-CN":"通过研究、设计、实施或测试软件而对一种内容表达有贡献的一个行为者"},"label":{"ar":"لها وكيل مطور برمجيات","ca":"té com a agent desenvolupador de programari","cs":"má vývojáře softwaru (agenta)","da":"har agent, som er softwareudvikler","de":"hat Softwareentwicklerin/Softwareentwickler (Akteur)","de":"hat Softwareentwicklerin/Softwareentwickler (Akteur)","el":"έχει μηχανικό λογισμικού","en":"has software developer agent","es":"tiene agente desarrollador de software","et":"tarkvaraarendaja (tegija)","fi":"ohjelmistokehittäjä (toimija)","fr":"a pour agent développeur de logiciel","hu":"szoftverfejlesztő ágense a következő:","lv":"programmatūras izstrādātājs (aģents)","nl":"heeft softwareontwikkelaar-actor","no":"har programvareutvikler (agent)","tr":"yazılımcı temsilcisi ile ilişkilidir","vi":"có người phát triển phần mềm","zh-Hans-CN":"有软件开发者行为者"},"altLabel":{"ar":["مطور برمجيات"],"ca":["desenvolupador de programari"],"cs":["vývojář softwaru"],"da":["softwareudvikler"],"de":["Softwareentwickler,Softwareentwickler"],"en":["software developer"],"es":["desarrollador de software"],"et":["tarkvaraarendaja"],"fi":["ohjelmistokehittäjä"],"fr":["développeur de logiciel"],"hu":["szoftverfejlesztője:"],"nl":["softwareontwikkelaar"],"no":["programvareutvikler"],"tr":["yazılım geliştirici"],"zh-Hans-CN":["软件开发者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
