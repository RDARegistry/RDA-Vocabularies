                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsOratorioExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20153", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsExpression.en", "label":"is adapted as expression"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20282", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsOratorioExpression.en", "label":"is adapted as oratorio expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20282", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsOratorioExpression.en", "label":"is adapted as oratorio expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20212","label":{"ar":"هي مدمجة لتشكيل تعبيرة","ca":"és fusionat per formar una expressió","cs":"sloučením vzniklo vyjádření","da":"er sammenlagt til udtryk","de":"ist vereinigt, um ... zu bilden (Expression)","de":"ist vereinigt, um ... zu bilden (Expression)","el":"είναι συγχωνευμένη για να σχηματίσει (έκφραση)","en":"is merged to form expression","es":"se fusiona para formar la expresión","et":"ühendatud väljenduseks","fi":"yhdistynyt ekspressioksi","fr":"est fusionné pour former une expression","hu":"egyesül a következő kifejezési formákkal:","lv":"ir sapludināts izteiksmē","nl":"is samengevoegd om expressie te vormen","no":"er slått sammen til uttrykk","tr":"anlatım olarak birleştirilmiştir","vi":"được kết hợp thành (biểu hiện)","zh-Hans-CN":"被合并而形成内容表达"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل مكون من تجميع لتعبيرتين أو أكثر معًا."],"ca":["Relaciona una expressió amb una expressió d’una obra que es forma per la reunió de dues o més expressions."],"cs":["Vztahuje vyjádření k vyjádření díla, které vzniklo spojením dvou nebo více vyjádření."],"da":["Relaterer et udtryk til et udtryk af et værk, som er dannet ved at lægge to eller flere udtryk sammen."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die durch das Zusammenführen von zwei oder mehreren Expressionen gebildet wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die durch das Zusammenführen von zwei oder mehreren Expressionen gebildet wird."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο διαμορφώνεται από τη συνένωση δύο ή περισσότερων εκφράσεων."],"en":["Relates an expression to an expression of a work that is formed from the coming together of two or more expressions."],"es":["Relaciona una expresión con una expresión de una obra que se forma a partir de la unión de dos o más expresiones."],"et":["Seostab väljenduse teose väljendusega, mis on moodustatud kahe või enama väljenduse kokkupaneku teel."],"fi":["Liittää ekspression teoksen ekspressioon, joka on muodostunut kahden tai useamman ekspression yhdistymisestä."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est formée par la combinaison de deux ou plusieurs expressions."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely két vagy több kifejezési forma egyesüléséből jött létre."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas izveidota no divām vai vairākām izteiksmēm."],"nl":["Relateert een expressie aan een expressie van een werk dat is gevormd door het samenkomen van twee of meer expressies."],"no":["Relaterer et uttrykk til et uttrykk av et verk skapt ved å kombinere to eller flere uttrykk."],"tr":["Bir anlatımı, iki veya daha fazla anlatımın bir araya gelmesiyle oluşan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được hình thành từ kết hợp hai hoặc nhiều hơn biểu hiện."],"zh-Hans-CN":["将一种内容表达与两个或多个内容表达一起形成的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مدمجة لتشكيل تعبيرة","ca":"fusionat per formar una expressió","cs":"sloučeno za účelem vzniku vyjádření","da":"sammenlagt til udtryk","de":"Vereinigt, um ... zu bilden (Expression)","de":"Vereinigt, um ... zu bilden (Expression)","el":"συγχωνευμένη για να σχηματίσει (έκφραση)","en":"merged to form expression","es":"fusionado para formar expresión","et":"ühendatud väljenduseks","fi":"yhdistynyt ekspressioksi","fr":"fusionné pour former une expression","hu":"egyesül kifejezési formákkal:","lv":"sapludināts izteiksmē","nl":"samengevoegd tot expressie","no":"slått sammen til uttrykk","tr":"Birden fazla ifadenin birleştirilmesi","vi":"được kết hợp thành (biểu hiện)","zh-Hans-CN":"被合并而形成内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل مكون من تجميع لتعبيرتين أو أكثر معًا.","ca":"Expressió d’una obra que es forma per la reunió de dues o més expressions.","cs":"Vyjádření díla, které vzniklo spojením dvou nebo více vyjádření.","da":"Udtryk af et værk, som er dannet ved at lægge to eller flere udtryk sammen.","de":"Eine Expression eines Werks, die durch das Zusammenführen von zwei oder mehreren Expressionen gebildet wird.","de":"Eine Expression eines Werks, die durch das Zusammenführen von zwei oder mehreren Expressionen gebildet wird.","el":"Μια έκφραση ενός έργου το οποίο διαμορφώνεται από τη συνένωση δύο ή περισσότερων εκφράσεων.","en":"An expression of a work that is formed from the coming together of two or more expressions.","es":"Una expresión de una obra que se forma a partir de la unión de dos o más expresiones.","et":"Teose väljendus, mis on moodustatud kahe või enama väljenduse kokkupaneku teel.","fi":"Teoksen ekspressio, joka on muodostunut kahden tai useamman ekspression yhdistymisestä.","fr":"Expression d’une œuvre qui est formée par la combinaison de deux ou plusieurs expressions.","hu":"Egy mű kifejezési formája, amely két vagy több kifejezési forma egyesüléséből jött létre.","lv":"Darba izteiksme, kas izveidota no divām vai vairākām izteiksmēm.","nl":"Een expressie van een werk dat is gevormd door het samenkomen van twee of meer expressies.","no":"Et uttrykk av et verk skapt ved å kombinere to eller flere uttrykk.","tr":"İki veya daha fazla ifadenin bir araya gelmesiyle oluşan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được hình thành từ kết hợp hai hoặc nhiều hơn biểu hiện.","zh-Hans-CN":"两种或多种内容表达一起形成的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
