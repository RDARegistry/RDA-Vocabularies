                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/expressionAnalysedIn.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20269", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionDescribedBy.en", "label":"is expression described by"}],"instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20270", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/expressionAnalysedIn.en", "label":"is expression analysed in"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20270", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/expressionAnalysedIn.en", "label":"is expression analysed in"}]},{"@id":"http://rdaregistry.info/Elements/e/P20321","label":{"ar":"لها امتداد لتعبيرة","ca":"té com a extensió d’una expressió","cs":"má rozsah vyjádření","da":"har omfang af udtryk","de":"hat Umfang einer Expression","de":"hat Umfang einer Expression","en":"has extent of expression","es":"tiene extensión de expresión","et":"väljenduse maht","fi":"ekspression laajuus","fr":"a pour étendue d’une expression","hu":"kifejezési forma terjedelme a következő:","lv":"izteiksmes apjoms","nl":"heeft omvang van expressie","no":"har omfang for uttrykk","tr":"anlatım kapsamı ile ilişkilidir","zh-Hans-CN":"有内容表达的数量"},"ToolkitLabel":{"ar":"امتداد لتعبيرة","ca":"extensió d’una expressió","cs":"rozsah vyjádření","da":"omfang af udtryk","de":"Umfang einer Expression","de":"Umfang einer Expression","en":"extent of expression","es":"extensión de expresión","et":"väljenduse maht","fi":"ekspression laajuus","fr":"étendue d’une expression","hu":"kifejezési forma terjedelme:","lv":"izteiksmes apjoms","nl":"omvang van expressie","no":"omfang for uttrykk","tr":"anlatım kapsamı","zh-Hans-CN":"内容表达的数量"},"ToolkitDefinition":{"ar":"نوع، ورقم، ووحدة قياس تحدد جانبًا من امتداد تعبيرة.","ca":"Tipus, número i unitat de mesura que quantifica un aspecte de l’extensió d’una expressió.","cs":"Typ, množství a měrná jednotka, které kvantifikují rozsah vyjádření.","da":"Type, tal og måleenhed, som kvantificerer et aspekt af omfanget af et udtryk.","de":"Eine Art, Nummer und Maßeinheit, die eine Eigenschaft des Umfangs einer Expression beziffert.","de":"Eine Art, Nummer und Maßeinheit, die eine Eigenschaft des Umfangs einer Expression beziffert.","en":"A type, number, and measurement unit that quantify an aspect of the extent of an expression.","es":"Un tipo, número y unidad de medida que cuantifica un aspecto de la extensión de una expresión.","et":"Tüüp, arv ja mõõtühik, mis näitavad kvantitatiivselt väljenduse mahu tunnuseid.","fi":"Tyyppi, luku ja mittayksikkö, joka ilmaisee ekspression laajuutta.","fr":"Type, nombre et unité de mesure qui quantifient un aspect de l’étendue d’une expression.","hu":"Egy típus, szám és mértékegység, amely egy kifejezési forma terjedelmének számszerű aspektusa.","lv":"Mērvienība, daudzums un izmērs, kas nosaka izteiksmes apjoma aspektu.","nl":"Een type, nummer en meeteenheid die een aspect van de omvang van een expressie kwantificeren.","no":"En type, nummer og måleenhet som kvantifiserer et aspekt av omfanget for et uttrykk.","tr":"Bir anlatımın kapsamının bir yönünü ölçen bir tür, sayı ve ölçüm birimi.","zh-Hans-CN":"把一种内容表达的一个数量方面定量化的一个类型、数字和计量单位"},"definition":{"ar":["تربط بين تعبيرة ونوع، ورقم، ووحدة قياس تحدد جانبًا من امتداد تعبيرة."],"ca":["Relaciona una expressió amb un tipus, número i unitat de mesura que quantifica un aspecte de l’extensió d’una expressió."],"cs":["Vztahuje vyjádření k typu, množství a měrné jednotce, které kvantifikují rozsah vyjádření."],"da":["Relaterer et udtryk til en type, et tal og en måleenhed, som kvantificerer et aspekt af omfanget af et udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Art, Nummer und Maßeinheit, die eine Eigenschaft des Umfangs einer Expression beziffert.,Setzt eine Expression in Beziehung zu einer Art, Nummer und Maßeinheit, die eine Eigenschaft des Umfangs einer Expression beziffert."],"en":["Relates an expression to a type, number, and measurement unit that quantify an aspect of the extent of an expression."],"es":["Relaciona una expresión con un tipo, número y unidad de medida que cuantifica un aspecto de la extensión de una expresión."],"et":["Seostab väljenduse tüübi, arvu ja mõõtühikuga, mis näitavad kvantitatiivselt väljenduse mahu tunnuseid."],"fi":["Liittää ekspression tyyppiin, lukuun ja mittayksikköön, joka ilmaisee ekspression laajuutta."],"fr":["Met une expression en relation avec un type, un nombre et une unité de mesure qui quantifient un aspect de l’étendue d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy típushoz, számhoz és mértékegységhez, amely egy kifejezési forma terjedelmének számszerű aspektusa."],"lv":["Sasaista izteiksmi ar mērvienību, daudzumu un izmēru, kas nosaka izteiksmes apjoma aspektu."],"nl":["Relateert een expressie aan een type, nummer en meeteenheid die een aspect van de omvang van een expressie kwantificeren."],"no":["Relaterer et uttrykk til en type, nummer og måleenhet som kvantifiserer et aspekt av omfanget for et uttrykk."],"tr":["Bir anlatımı, bir anlatımın kapsamının bir yönünü ölçen bir tür, sayı ve ölçüm birimiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与把一种内容表达的一个数量方面定量化的一个类型、数字和计量单位关联起来。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/extentOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20219", "lexicalAlias":"http://rdaregistry.info/Elements/e/duration.en", "label":"has duration"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20321", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/extentOfExpression.en", "label":"has extent of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20200","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل عبارة عن عمل ممتد زمنيًا يُكْمل محتوى جزئي لعمل آخر ممتد زمنيًا ومستمر."],"ca":["Relaciona una expressió amb una expressió d’una obra que és una obra diacrònica que continua el contingut parcial d’una altra obra diacrònica que és completa."],"cs":["Vztahuje vyjádření k vyjádření díla, které je diachronním dílem, které navazuje na čístečný obsah jiného diachronního díla, které bylo ukončeno."],"da":["Relaterer et udtryk til et udtryk af værk, som er et diakronisk værk, som fortsætter det delvise indhold af et andet diakronisk værk, som er fuldstændigt."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines diachronen Werks, die teilweise den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt.,Setzt eine Expression in Beziehung zu einer Expression eines diachronen Werks, die den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου προερχόμενου από δύο ή περισσότερα έργα τα οποία προκύπτουν από τη διαίρεση μιας προηγούμενης έκφρασης σε χωριστές εκφράσεις."],"en":["Relates an expression to an expression of a work that is a diachronic work that continues the partial content of another diachronic work that is completed."],"es":["Relaciona una expresión con una expresión de una obra que es una obra diacrónica que continúa el contenido parcial de otra obra diacrónica que se completa."],"et":["Seostab väljenduse väljendusega diakroonilisest teosest, mis osaliselt jätkab teise, lõpetatud diakroonilise teose sisu."],"fi":["Liittää ekspression sellaisen teoksen ekspressioon, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen osittaista sisältöä."],"fr":["Met une expression en relation avec une expression d’une œuvre diachronique qui continue le contenu partiel d’une autre œuvre diachronique qui est terminée."],"hu":["Hozzákapcsol egy kifejezési formát egy diakronikus mű kifejezési formájához, amely egy másik, befejezett mű részleges tartalmát folytatja."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir diahronisks darbs, kas turpina daļu cita diahroniska darba saturu, kas ir pabeigts."],"nl":["Relateert een expressie aan een expressie van een werk dat een diachronisch werk is dat de gedeeltelijke content voortzet van een ander diachronisch werk dat afgesloten is."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er et diakronisk verk som fortsetter deler av innholdet av et annet diakronisk verk som er komplett."],"tr":["Bir anlatımı, tamamlanmış başka bir artzamanlı eserin kısmi içeriğini devam ettiren artzamanlı bir eser olan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của hai hoặc nhiều hơn tác phẩm được tạo ra từ việc phân chia biểu hiện trước đây thành các biểu hiện tách biệt."],"zh-Hans-CN":["将一种内容表达与作为一种历时作品继承另一种已完成的历时作品的部分内容的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"منشطرة إلى تعبيرة","ca":"escindit en una expressió","cs":"rozděleno na vyjádření","da":"opdelt i udtryk","de":"Gesplittet in (Expression)","de":"Teilweise Fortsetzung von (Expression)","el":"χωρισμένη σε (έκφραση)","en":"split into expression","es":"dividir en expresión","et":"jätkub osaliselt väljendusena","fi":"jakautunut ekspressioon","fr":"scindé en une expression","hu":"kettévált kifejezési formába:","lv":"izteiksme: daļējs turpinājums","nl":"gesplitst in expressie","no":"delt opp i uttrykk","tr":"anlatıma ayrılma","vi":"được tách thành (biểu hiện)","zh-Hans-CN":"被分成内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل ممتد زمنيًا يُكْمل المحتوى الجزئي لعمل آخر ممتد زمنيًا ومستمر.","ca":"Expressió d’una obra que és una obra diacrònica que continua el contingut parcial d’una altra obra diacrònica que és completa.","cs":"Vyjádření díla, které je diachronním dílem, které navazuje na částečný obsah jiného diachronního díla, které bylo ukončeno.","da":"Udtryk af et værk, som fortsætter det delvise indhold af et andet diakronisk værk, som er fuldstændigt.","de":"Eine Expression eines diachronen Werks, die teilweise den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt.","de":"Eine Expression eines diachronen Werks, die den Inhalt eines anderen abgeschlossenen, diachronen Werks fortsetzt.","el":"Μια έκφραση ενός [έργου προερχόμενου] από δύο ή περισσότερα έργα τα οποία προκύπτουν από τη διαίρεση μιας προηγούμενης έκφρασης σε χωριστές εκφράσεις.","en":"An expression of a work that is a diachronic work that continues the partial content of another diachronic work that is completed.","es":"Una expresión de una obra que es una obra diacrónica que continúa el contenido parcial de otra obra diacrónica que se completa.","et":"Väljendus diakroonilisest teosest, mis osaliselt jätkab teise, lõpetatud diakroonilise teose sisu.","fi":"Sellaisen teoksen ekspressio, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen osittaista sisältöä.","fr":"Expression d’une œuvre diachronique qui continue le contenu partiel d’une autre œuvre diachronique qui est terminée.","hu":"Egy diakronikus mű kifejezési formája, amely egy másik, befejezett mű részleges tartalmát folytatja.","lv":"Darba izteiksme, kas ir diahronisks darbs, kas turpina daļu cita diahroniska darba saturu, kas ir pabeigts.","nl":"Een expressie van een werk dat een diachronisch werk is dat de gedeeltelijke content voortzet van een ander diachronisch werk dat afgesloten is.","no":"Et uttrykk av et verk som er et diakronisk verk som fortsetter deler av innholdet av et annet diakronisk verk som er komplett.","tr":"Tamamlanmış başka bir artzamanlı eserin kısmi içeriğini devam ettiren artzamanlı bir eserin anlatımı.","vi":"Biểu hiện của hai hoặc nhiều hơn tác phẩm được tạo ra từ việc phân chia biểu hiện trước đây thành các biểu hiện tách biệt.","zh-Hans-CN":"作为一种历时作品继承另一种已完成的历时作品的部分内容的一种作品的一种内容表达"},"label":{"ar":"هي منشطرة إلى تعبيرة","ca":"és escindit en una expressió","cs":"je rozděleno na vyjádření","da":"er opdelt i udtryk","de":"ist gesplittet in (Expression)","de":"ist teilweise Fortsetzung von (Expression)","el":"είναι χωρισμένη σε (έκφραση)","en":"is split into expression","es":"se divide en expresión","et":"jätkub osaliselt väljendusena","fi":"jakautunut ekspressioon","fr":"est scindé en une expression","hu":"szétvált a következő kifejezési formába:","lv":"izteiksmes daļējs turpinājums","nl":"is gesplitst in expressie","no":"er delt opp i uttrykk","tr":"ifadeye bölünür","vi":"được tách thành (biểu hiện)","zh-Hans-CN":"被分成内容表达"},"note":{"ar":["هذا العنصر ينطبق عامة على تعبيرة لعمل متتالٍ."],"ca":["En general, aquest element s’aplica a una expressió d’una obra successiva."],"cs":["Tento prvek se obecně vztahuje na vyjádření postupně vydávaného díla."],"da":["Dette element gælder generelt for et udtryk af et fortløbende værk."],"de":["Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu.,Im Allgemeinen trifft dieses Element auf eine Expression eines sukzessiven Werks zu."],"en":["This element applies in general to an expression of a successive work."],"es":["Este elemento se aplica en general a una expresión de una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose väljenduse puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvän teoksen ekspressioon."],"fr":["Cet élément s’applique généralement à une expression d’une œuvre successive."],"hu":["Ezt az elemet általában egy folyamatos mű kifejezési formájára alkalmazzák."],"lv":["Elements vispārīgi attiecas uz secīga darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing bij een expressie van een successief werk."],"no":["Dette elementet gjelder som oftest for et uttrykk av et påfølgende verk."],"tr":["Bu öğe, genel olarak ardışık bir eserin anlatımı için geçerlidir."],"zh-Hans-CN":["该元素一般适用于一种相继作品的一种内容表达。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20169", "lexicalAlias":"http://rdaregistry.info/Elements/e/succeededByExpression.en", "label":"is succeeded by expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/splitIntoExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20200", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/splitIntoExpression.en", "label":"is split into expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20200", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/splitIntoExpression.en", "label":"is split into expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20004","definition":{"ar":["تربط بين تعبيرة يوصف وفترة زمنية مرتبطة بتسجيل محتوى تعبيرة ممثِلة، أو تصويره، إلخ."],"ca":["Relaciona una expressió amb un interval de temps que s’associa amb l’enregistrament, la filmació, etc., del contingut d’una expressió."],"cs":["Vztahuje vyjádření k časovému vymezení, které souvisí s nahráním, natočením (atd.) obsahu vyjádření."],"da":["Relaterer et udtryk til en tidsperiode knyttet til en indspilning, filmoptagelse, etc., af et indholdet af et udtryk"],"de":["Setzt eine Expression in Beziehung zu einem Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.,Setzt eine Expression in Beziehung zu einem Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht."],"el":["Συνδέει μια έκφραση με μια χρονολογία ή ένα εύρος χρονολογιών που συνδέονται με την ηχογράφηση, κινηματογράφηση κ.λπ. του περιεχομένου μιας έκφρασης."],"en":["Relates an expression to a timespan that is associated with recording, filming, etc., the content of an expression."],"es":["Relaciona una expresión con un lapso de tiempo que está asociado con la grabación, filmación, etc., el contenido de una expresión."],"et":["Seostab väljenduse ajavahemikuga, mis on seotud väljenduse salvestamise, filmimise vms jäädvustamisega."],"fi":["Liittää ekspression ajanjaksoon, joka liittyy ekspression äänitykseen, filmaukseen tms."],"fr":["Met une expression en relation avec un laps de temps qui est associé à l’enregistrement, au tournage, etc., du contenu d’une expression."],"hu":["Hozzákapcsol egy kifejezési formát egy időtartamhoz, amely egy kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik."],"lv":["Sasaista izteiksmi ar laikposmu, kas saistīts ar izteiksmes ierakstīšanu, filmēšanu u.tml."],"nl":["Relateert een expressie aan een tijdspanne die is geassocieerd met het opnemen, filmen etc. van de content van een expressie."],"no":["Relaterer et uttrykk til et tidsrom som forbindes med opptak, filming etc. for et uttrykk."],"tr":["Bir anlatımı, içeriğinin kaydedilmesi, filme alınması vb. ile bağlantılı olan bir zaman aralığıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với ngày liên quan tới ghi, làm phim, v.v... của nội dung của biểu hiện."],"zh-Hans-CN":["将一种内容表达与和内容表达的内容的录制、摄制等有关的时间段关联起来。"]},"ToolkitLabel":{"ar":"تاريخ التقاط","ca":"data de captura","cs":"datum zaznamenání","da":"dato for indspilning","de":"Aufzeichnungsdatum","de":"Aufzeichnungsdatum","el":"χρονολογία της σύλληψης","en":"date of capture","es":"fecha de captura","et":"jäädvustamise daatum","fi":"tallennusajankohta","fr":"date de captation","hu":"felvétel időpontja:","lv":"tveršanas datējums","nl":"datum van vastleggen","no":"tidspunkt for opptak","sv":"inspelningstid","tr":"kayıt tarihi","vi":"ngày thu nạp","zh-Hans-CN":"摄录日期"},"ToolkitDefinition":{"ar":"فترة زمنية مرتبطة بتسجيل محتوى تعبيرة، أو تصويره، إلخ.","ca":"Interval de temps que s’associa amb l’enregistrament, la filmació, etc., del contingut d’una expressió.","cs":"Časové vymezení, které souvisí s nahráním, natočením (atd.) obsahu vyjádření.","da":"Tidsperiode knyttet til en indspilning, filmoptagelse, etc., af et indholdet af et udtryk.","de":"Ein Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.","de":"Ein Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.","el":"Μια χρονολογία ή ένα εύρος χρονολογιών που συνδέονται με την ηχογράφηση, κινηματογράφηση κ.λπ. του περιεχομένου μιας έκφρασης.","en":"A timespan that is associated with recording, filming, etc., the content of an expression.","es":"Un lapso de tiempo que está asociado con la grabación, filmación, etc., el contenido de una expresión.","et":"Ajavahemik, mis on seotud väljenduse salvestamise, filmimise vms jäädvustamisega.","fi":"Ajanjakso, joka liittyy ekspression äänitykseen, filmaukseen tms.","fr":"Laps de temps qui est associé à l’enregistrement, au tournage, etc., du contenu d’une expression.","hu":"Egy időtartam, amely egy kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik.","lv":"Laikposms, kas saistīts ar izteiksmes ierakstīšanu, filmēšanu u.tml.","nl":"Een tijdspanne die is geassocieerd met het opnemen, filmen etc. van de content van een expressie.","no":"Et tidsrom som forbindes med opptak, filming etc. for et uttrykk.","tr":"Bir anlatımın içeriğinin kaydedilmesi, çekilmesi vb. ile bağlantılı olan bir zaman aralığı.","vi":"Ngày liên quan tới ghi, quay phim, vv... của nội dung của một biểu hiện.","zh-Hans-CN":"和内容表达的内容的录制、摄制等有关的时间段"},"label":{"ar":"لها تاريخ التقاط","ca":"té com a data de captura","cs":"má datum zaznamenání","da":"har dato for indspilning","de":"hat Aufzeichnungsdatum","de":"hat Aufzeichnungsdatum","el":"έχει χρονολογία της σύλληψης","en":"has date of capture","es":"tiene fecha de captura","et":"jäädvustamise daatum","fi":"tallennusajankohta","fr":"a pour date de captation","hu":"felvétel időpontja a következő:","lv":"tveršanas datējums","nl":"heeft datum van vastleggen","no":"har tidspunkt for opptak","sv":"har inspelningstid","tr":"kayıt tarihi ile ilişkilidir","vi":"có ngày thu nạp","zh-Hans-CN":"有摄录日期"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/dateOfCapture.en","instructionNumber":"7.11.3","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20214", "lexicalAlias":"http://rdaregistry.info/Elements/e/dateOfExpression.en", "label":"has date of expression"},{"@id":"http://rdaregistry.info/Elements/e/P20217", "lexicalAlias":"http://rdaregistry.info/Elements/e/captureInformation.en", "label":"has capture information"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20004", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/dateOfCapture.en", "label":"has date of capture"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20004", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/dateOfCapture.en", "label":"has date of capture"}]},{"@id":"http://rdaregistry.info/Elements/e/P20288","definition":{"ca":["Relaciona una expressió amb un il·lustrador que contribueix a una expressió d’una obra proporcionant un contingut fotogràfic suplementari a una obra original."],"da":["Relaterer et udtryk til en illustrator, der har bidraget til et udtryk af et værk ved at tilvejebringe supplerende fotografisk indhold til et originalværk."],"de":["Setzt eine Expression mit einem Illustrator, der an einer Expression eines Werks mitwirkt, indem er einem Originalwerk zusätzliche fotografische Inhalte liefert, in Beziehung."],"el":["Συνδέει μια έκφραση με έναν εικονογράφο ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της παροχής συμπληρωματικού φωτογραφικού περιεχομένου σε ένα πρωτότυπο έργο."],"en":["Relates an expression to an illustrator who contributes to an expression by providing supplementary photographic content to an original work. (Deprecated)"],"fi":["Liittää ekspression kuvittajaan, joka osallistuu teoksen ekspression tekemiseen tarjoamalla täydentävää valokuvasisältöä alkuperäiseen teokseen."],"fr":["Met une expression en relation avec un illustrateur qui contribue à une expression d’une œuvre en fournissant du contenu photographique supplémentaire à une œuvre originale."],"hu":["Egy kifejezési formát hozzákapcsol egy illusztrátorhoz, aki egy mű kifejezési formájához hozzájárul azzal, hogy kiegészítő fényképészeti tartalmat ad hozzá egy eredeti műhöz."],"vi":["Liên kết một biểu hiện với người minh hoạ đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp nội dung ảnh phụ thêm vào tác phẩm nguồn."]},"ToolkitLabel":{"ca":"fotògraf (expressió)","da":"fotograf (udtryk)","de":"Fotograf (Expression)","el":"φωτογράφος (έκφραση)","en":"photographer of expression (Deprecated)","fi":"valokuvaaja (ekspressio)","fr":"photographe (expression)","hu":"fényképész (kifejezési forma)","no":"fotograf (uttrykk)","vi":"người chụp ảnh (biểu hiện)"},"ToolkitDefinition":{"ca":"Il·lustrador que contribueix a una expressió d’una obra proporcionant un contingut fotogràfic suplementari a una obra original.","da":"Illustrator, der har bidraget til et udtryk af et værk ved at tilvejebringe supplerende fotografisk indhold til et originalværk.","de":"Ein Illustrator, der an einer Expression eines Werks mitwirkt, indem er einem Originalwerk zusätzliche fotografische Inhalte liefert.","el":"Ένας εικονογράφος ο οποίος συνεισφέρει σε μια έκφραση ενός έργου μέσω της παροχής συμπληρωματικού φωτογραφικού περιεχομένου σε ένα πρωτότυπο έργο.","en":"An illustrator who contributes to an expression of a work by providing supplementary photographic content to an original work. (Deprecated)","fi":"Kuvittaja, joka osallistuu teoksen ekspression tekemiseen tarjoamalla täydentävää valokuvasisältöä alkuperäiseen teokseen.","fr":"Illustrateur qui contribue à une expression d’une œuvre en fournissant du contenu photographique supplémentaire à une œuvre originale.","hu":"Egy illusztrátor, aki egy mű kifejezési formájához hozzájárul azzal, hogy kiegészítő fényképészeti tartalmat szolgáltat egy eredeti műhöz.","no":"En illustratør som bidrar til et uttrykk av et verk ved å tilføre supplerende fotografisk innhold til originalverket.","vi":"Người minh hoạ đóng góp cho biểu hiện của tác phẩm bằng cách cung cấp nội dung ảnh phụ thêm vào tác phẩm nguồn."},"note":{"ca":["S’exclou la creació de contingut principalment artístic."],"da":["Skabelse af hovedsageligt kunstnerisk indhold er ikke omfattet."],"de":["Schöpfung, die in erster Linie aus dem künstlerischen Inhalt besteht, ist hiervon ausgenommen."],"el":["Δεν περιλαμβάνεται η δημιουργία περιεχομένου το οποίο είναι κατά κύριο λόγο καλλιτεχνικό."],"en":["Creation of content that is primarily artistic is excluded."],"fi":["Ei koske ensisijaisesti taiteellisen sisällön luomista."],"fr":["La création de contenu qui est principalement artistique est exclue."],"hu":["Olyan tartalom megalkotása, amely elsősorban művészi, nem tartozik bele."]},"label":{"ca":"té com a fotògraf (expressió)","da":"har fotograf (udtryk)","de":"hat Fotograf (Expression)","el":"έχει φωτογράφο (έκφραση)","en":"has photographer of expression (Deprecated)","fi":"valokuvaaja (ekspressio)","fr":"a pour photographe (expression)","hu":"van fényképésze (kifejezési forma)","vi":"có người chụp ảnh (biểu hiện)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/photographerOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"See Also":[{"@id":"http://rdaregistry.info/Elements/w/P10056", "lexicalAlias":"http://rdaregistry.info/Elements/w/photographerAgentOfWork.en", "label":"has photographer agent of work"}],"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20578", "lexicalAlias":"http://rdaregistry.info/Elements/e/contributorToAggregatedContent.en", "label":"has contributor to aggregated content (Deprecated)"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20288", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/photographerOfExpression.en", "label":"has photographer of expression (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20288", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/photographerOfExpression.en", "label":"has photographer of expression (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/e/P20158","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يقدم نصًا لفيلم سينمائي."],"ca":["Relaciona una expressió amb una expressió d’una obra que proporciona el text d’una pel·lícula cinematogràfica."],"cs":["Vztahuje vyjádření k vyjádření díla, které poskytuje text pro film."],"da":["Relaterer et udtryk til et udtryk af et værk, som angiver tekst til en spillefilm."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für einen Film liefert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für einen Film liefert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο παρέχει κείμενο για μια κινηματογραφική ταινία."],"en":["Relates an expression to an expression of a work that provides text for a motion picture."],"es":["Relaciona una expresión con una expresión de una obra que proporciona texto para una película."],"et":["Seostab väljenduse teose väljendusega, mis annab teksti filmile."],"fi":["Liittää ekspression teoksen ekspressioon, joka on elokuvan käsikirjoitus."],"fr":["Met une expression en relation avec une expression d’une œuvre qui fournit un texte pour un film."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely szöveget szolgáltat egy mozgóképhez."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas nodrošina tekstu kinofilmai."],"nl":["Relateert een expressie aan een expressie van een werk dat tekst levert voor een speelfilm."],"no":["Relaterer et uttrykk til et uttrykk av et verk som tilfører tekst til en spillefilm."],"tr":["Bir anlatımı, bir sinema filmi için metin sağlayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm cung cấp văn bản cho phim điện ảnh."],"zh-Hans-CN":["将一种内容表达与为一种电影提供文本的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة سيناريو فيلم سينمائي","ca":"expressió de guió de pel·lícula cinematogràfica","cs":"filmový scénář (vyjádření)","da":"filmmanuskriptudtryk","de":"Filmdrehbuch (Expression)","de":"Filmdrehbuch (Expression)","el":"σενάριο κινηματογραφικής ταινίας (έκφραση)","en":"motion picture screenplay expression","es":"expresión de guión cinematográfico","et":"filmistsenaarium (väljendus)","fi":"elokuvan käsikirjoitus (ekspressio)","fr":"scénario de film (expression)","hu":"mozgókép-forgatókönyv kifejezési formája:","lv":"izteiksme: kinoscenārijs","nl":"speelfilmscenario-expressie","no":"manus for spillefilm (uttrykk)","tr":"Sinema filmi senaryosunun anlatımı","vi":"kịch bản điện ảnh (biểu hiện)","zh-Hans-CN":"电影剧本内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يقدم نصًا لفيلم سينمائي.","ca":"Expressió d’una obra que proporciona el text d’una pel·lícula cinematogràfica.","cs":"Vyjádření díla, které poskytuje text pro film.","da":"Udtryk af et værk, som angiver tekst til en spillefilm.","de":"Eine Expression eines Werks, die Text für einen Film liefert.","de":"Eine Expression eines Werks, die Text für einen Film liefert.","el":"Μια έκφραση ενός έργου το οποίο παρέχει κείμενο για μια κινηματογραφική ταινία.","en":"An expression of a work that provides text for a motion picture.","es":"Una expresión de una obra que proporciona texto para una película.","et":"Teose väljendus, mis annab teksti filmile.","fi":"Teoksen ekspressio, joka on elokuvan käsikirjoitus.","fr":"Expression d’une œuvre qui fournit un texte pour un film.","hu":"Egy mű kifejezési formája, amely szöveget szolgáltat egy mozgóképhez.","lv":"Darba izteiksme, kas nodrošina tekstu kinofilmai.","nl":"Een expressie van een werk dat tekst levert voor een speelfilm.","no":"Et uttrykk av et verk som tilfører tekst til en spillefilm.","tr":"Bir sinema filmi için metin sağlayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm cung cấp văn bản cho phim điện ảnh.","zh-Hans-CN":"为一种电影提供文本的一种作品的一种内容表达"},"label":{"ar":"لها تعبيرة سيناريو فيلم سينمائي","ca":"té com a expressió de guió de pel·lícula cinematogràfica","cs":"má filmový scénář (vyjádření)","da":"har filmmanuskriptudtryk","de":"hat Filmdrehbuch (Expression)","de":"hat Filmdrehbuch (Expression)","el":"είναι σενάριο κινηματογραφικής ταινίας (έκφραση)","en":"has motion picture screenplay expression","es":"tiene expresión de guión cinematográfico","et":"filmistsenaarium (väljendus)","fi":"elokuvan käsikirjoitus (ekspressio)","fr":"a pour scénario de film (expression)","hu":"mozgókép-forgatókönyve a következő kifejezési forma:","lv":"izteiksme: kinoscenārijs","nl":"heeft speelfilmscenario-expressie","no":"har manus for spillefilm (uttrykk)","tr":"sinema filmi senaryosu anlatımı ile ilişkilidir","vi":"là kịch bản điện ảnh (biểu hiện)","zh-Hans-CN":"有电影剧本内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
