                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/expressionDescribedWithMetadataBy.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20269", "lexicalAlias":"http://rdaregistry.info/Elements/e/expressionDescribedBy.en", "label":"is expression described by"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20576", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/expressionDescribedWithMetadataBy.en", "label":"is expression described with metadata by"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20576", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/expressionDescribedWithMetadataBy.en", "label":"is expression described with metadata by"}]},{"@id":"http://rdaregistry.info/Elements/e/P20577","label":{"ca":"té obra de concordança","cs":"má konkordanci (dílo)","de":"hat Konkordanz (Werk)","en":"has concordance work","es":"tiene obra de concordancia","fi":"konkordanssihakemisto (teos)","fr":"a pour concordance (œuvre)","hu":"konkordanciaműve a következő:","nl":"heeft concordantiewerk","tr":"konkordans eser ile ilişkilidir","zh-Hans-CN":"有语词索引作品"},"definition":{"ca":["Relaciona una expressió amb una obra que és una guia sistemàtica de totes les paraules o d’una selecció de les paraules que apareixen en una expressió que realitza una obra textual."],"cs":["Vztahuje vyjádření k dílu, které je systematickým průvodcem všemi nebo vybranými slovy, která se objevují ve vyjádření, které realizuje textové dílo."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einem Index aller oder ausgewählter Wörter besteht, die in einer Realisierung eines textlichen Werks vorkommen."],"en":["Relates an expression to a work that is a systematic guide of all or selected words that occur in an expression that realizes a textual work."],"es":["Relaciona una expresión con una obra que es una guía sistemática de todas las palabras o palabras seleccionadas que ocurren en una expresión que realiza una obra textual."],"fi":["Liittää ekspression teokseen, joka on tekstiteoksen toteuttavassa ekspressiossa esiintyvien kaikkien tai valikoitujen sanojen systemaattinen opas."],"fr":["Met une expression en relation avec une œuvre qui consiste en un guide systématique d’une partie ou de la totalité des mots figurant dans une expression qui réalise une œuvre textuelle."],"hu":["Hozzákapcsol egy kifejezési formát egy műhöz, amely egy szöveges művet megvalósító kifejezési formában előfordulő összes szó vagy válogatott szavak szisztematikus útmutatója."],"nl":["Relateert een expressie aan een werk dat is een systematische gids van alle of geselecteerde woorden die voorkomen in een expressie die een tekstwerk realiseert."],"tr":["Bir anlatımı, metinsel bir eseri gerçekleştiren bir anlatımda geçen tüm veya seçilmiş kelimelerin sistematik bir rehberi olan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为实现一种文字作品的一种内容表达中出现的所有或所选词语的系统指引的一种作品关联起来。"]},"ToolkitLabel":{"ca":"obra de concordança","cs":"konkordance (dílo)","de":"Konkordanz (Werk)","en":"concordance work","es":"obra de concordancia","fi":"konkordanssihakemisto (teos)","fr":"concordance (œuvre)","hu":"konkordanciamű","nl":"concordantiewerk","tr":"uyum eseri","zh-Hans-CN":"语词索引作品"},"ToolkitDefinition":{"ca":"Obra que és una guia sistemàtica de totes les paraules o d’una selecció de les paraules que apareixen en una expressió que realitza una obra textual.","cs":"Dílo, které je systematickým průvodcem všemi nebo vybranými slovy, která se objevují ve vyjádření, které realizuje textové dílo.","de":"Ein Werk, das aus einem Index aller oder ausgewählter Wörter besteht, die in einer Realisierung eines textlichen Werks vorkommen.","en":"A work that is a systematic guide of all or selected words that occur in an expression that realizes a textual work.","es":"Una obra que es una guía sistemática de todas las palabras o palabras seleccionadas que ocurren en una expresión que realiza una obra textual.","fi":"Teos, joka on tekstiteoksen toteuttavassa ekspressiossa esiintyvien kaikkien tai valikoitujen sanojen systemaattinen opas.","fr":"Œuvre qui consiste en un guide systématique d’une partie ou de la totalité des mots figurant dans une expression qui réalise une œuvre textuelle.","hu":"Egy mű, amely egy szöveges művet megvalósító kifejezési formában előfordulő összes szó vagy válogatott szavak szisztematikus útmutatója.","nl":"Een werk dat is een systematische gids van alle of geselecteerde woorden die voorkomen in een expressie die een tekstwerk realiseert.","tr":"Metinsel bir eseri gerçekleştiren bir anlatımda geçen tüm veya seçilmiş kelimelerin sistematik bir rehberi olan eser.","zh-Hans-CN":"作为实现一种文字作品的一种内容表达中出现的所有或所选词语的系统指引的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
