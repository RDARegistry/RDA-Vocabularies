                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20524", "lexicalAlias":"http://rdaregistry.info/Elements/e/reviserFamily.en", "label":"has reviser family"},{"@id":"http://rdaregistry.info/Elements/e/P20418", "lexicalAlias":"http://rdaregistry.info/Elements/e/transcriberCollectiveAgent.en", "label":"has transcriber collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20536", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/transcriberFamily.en", "label":"has transcriber family"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20536", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/transcriberFamily.en", "label":"has transcriber family"}]},{"@id":"http://rdaregistry.info/Elements/e/P20359","label":{"ar":"لها شخص ناسخ","ca":"té com a persona transcriptora","cs":"má přepisovatele (osobu)","da":"har person, som er transskribent","de":"hat Transkribiererin/Transkribierer (Person)","de":"hat Transkribiererin/Transkribierer (Person)","en":"has transcriber person","es":"tiene persona transcriptora","et":"transkribeerija (isik)","fi":"transkriboija (henkilö)","fr":"a pour personne transcriptrice","hu":"átíró személye a következő:","lv":"transkribētājs (persona)","nl":"heeft transcribeerder-persoon","no":"har avskriver (person)","tr":"yazıya aktaran kişi ile ilişkilidir","zh-Hans-CN":"有转写者个人"},"definition":{"ar":["تربط بين تعبيرة وشخص يساهم في تعبيرة بكتابة محتوى لم تسبق كتابته أو تدوينه، أو بتغييره من نظام تدوين لآخر."],"ca":["Relaciona una expressió amb una persona que contribueix a una expressió escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre."],"cs":["Vztahuje vyjádření k osobě, která přispívá k vyjádření tím, že zapisuje nebo přepisuje nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný."],"da":["Relaterer et udtryk til en person, som bidrager til et udtryk ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet."],"de":["Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.,Setzt eine Expression in Beziehung zu einer Person, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt."],"en":["Relates an expression to a person who contributes to an expression by writing down or notating unwritten or unnotated content, or by changing it from one system of notation to another."],"es":["Relaciona una expresión con una persona que contribuye a una expresión escribiendo o anotando contenido no escrito o sin anotar, o cambiándolo de un sistema de notación a otro."],"et":["Seostab väljenduse isikuga, kes annab panuse väljendusse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise."],"fi":["Liittää ekspression henkilöön, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen."],"fr":["Met une expression en relation avec une personne qui contribue à une expression en écrivant ou en notant un contenu auparavant non écrit ou non noté, ou bien en le transposant d’un système de notation à un autre."],"hu":["Hozzákapcsol egy kifejezési formát egy személyhez, aki korábban le nem írt vagy le nem jegyzett tartalom leírásával vagy lejegyzésével, vagy egyik jelölési rendszerről a másikra történő átvitelével járul hozzá egy kifejezési formához."],"lv":["Sasaista izteiksmi ar personu, kura sniegusi ieguldījumu izteiksmē, pierakstot mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā."],"nl":["Relateert een expressie aan een persoon die bijdraagt aan een expressie door het opschrijven of noteren van ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteem naar een ander."],"no":["Relaterer et uttrykk til en person som bidrar til et uttrykk ved å forkorte originalverket, men la originalverkets særpreg og innhold forbli hovedsakelig uendret."],"tr":["Bir anlatımı, yazılı olmayan veya not edilmemiş içeriği yazarak veya not ederek veya bir not sisteminden diğerine değiştirerek anlatıma katkıda bulunan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与通过写下或记谱之前未写下或未记谱的内容或者将其从一种记谱体系改成另一种记谱体系而对一种内容表达有贡献的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص ناسخ","ca":"persona transcriptora","cs":"přepisovatel (osoba)","da":"person, som er transskribent","de":"Transkribiererin/Transkribierer (Person)","de":"Transkribiererin/Transkribierer (Person)","en":"transcriber person","es":"persona transcriptora","et":"transkribeerija (isik)","fi":"transkriboija (henkilö)","fr":"personne transcriptrice","hu":"átíró személy:","lv":"transkribētājs (persona)","nl":"transcribeerder-persoon","no":"avskriver (person)","tr":"yazıya aktaran kişi","zh-Hans-CN":"转写者个人"},"ToolkitDefinition":{"ar":"شخص يساهم في تعبيرة بكتابة محتوى لم تسبق كتابته أو تدوينه، أو بتغييره من نظام تدوين لآخر.","ca":"Persona que contribueix a una expressió escrivint o notant un contingut que no estava escrit o notat, o canviant-lo d’un sistema de notació a un altre.","cs":"Osoba, která přispívá k vyjádření tím, že zapisuje nebo přepisuje nezapsaný nebo nezaznamenaný obsah nebo ho mění z jednoho systému zápisu na jiný.","da":"Person, som bidrager til et udtryk ved at nedskrive eller notere uskrevet eller ikke-noteret indhold, eller ved at ændre det fra et notationssystem til et andet.","de":"Eine Person, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","de":"Eine Person, die zu einer Expression beiträgt, indem sie ungeschriebenen und nicht notierten Inhalt niederschreibt oder ihn von einem Notationssystem in ein anderes überträgt.","en":"A person who contributes to an expression by writing down or notating unwritten or unnotated content, or by changing it from one system of notation to another.","es":"Una persona que contribuye a una expresión escribiendo o anotando contenido no escrito o sin anotar, o cambiándolo de un sistema de notación a otro.","et":"Isik, kes annab panuse väljendusse, kirjutades üles või noodistades üleskirjutamata või noodistamata sisu või teisendades seda ühest märkimissüsteemist teise.","fi":"Henkilö, joka osallistuu ekspression tekemiseen kirjoittamalla muistiin tai nuotintamalla kirjoittamattoman tai nuotintamattoman sisällön tai muuttamalla sen merkintäjärjestelmästä toiseen.","fr":"Personne qui contribue à une expression en écrivant ou en notant un contenu auparavant non écrit ou non noté, ou bien en le transposant d’un système de notation à un autre.","hu":"Egy személy, aki korábban le nem írt vagy le nem jegyzett tartalom leírásával vagy lejegyzésével, vagy egyik jelölési rendszerről a másikra történő átvitelével járul hozzá egy kifejezési formához.","lv":"Persona, kura sniegusi ieguldījumu izteiksmē, pierakstot mutvārdu vai mūzikas saturu, vai pārrakstot to citādā pierakstā.","nl":"Een persoon die bijdraagt aan een expressie door het opschrijven of noteren van ongeschreven of niet-genoteerde content, of door het te wijzigen van een notatiesysteem naar een ander.","no":"En person som bidrar til et uttrykk ved å forkorte originalverket, men la originalverkets særpreg og innhold forbli hovedsakelig uendret.","tr":"Yazılmamış veya not edilmemiş içeriği yazarak veya not ederek veya 