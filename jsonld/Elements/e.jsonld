                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20192", "lexicalAlias":"http://rdaregistry.info/Elements/e/augmentationOfExpression.en", "label":"is augmentation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/appendixToExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20089", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/appendixToExpression.en", "label":"is appendix to expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20089", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/appendixToExpression.en", "label":"is appendix to expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20225","definition":{"ca":["Relaciona una expressió amb una presència o absència de so en una expressió."],"da":["Relaterer et udtryk til en tilstedeværelse eller fravær af lyd i et udtryk."],"de":["Setzt eine Expression in Beziehung zu einem Vorhandensein beziehungsweise nicht Vorhandensein von Ton in einer Expression."],"el":["Συνδέει μια έκφραση με μια παρουσία ή μια απουσία ήχου σε μια έκφραση."],"en":["Relates an expression to a presence or absence of sound in an expression. (Deprecated)"],"et":["Seostab väljenduse heli olemasolu või puudumisega väljenduses."],"fi":["Liittää ekspression äänen läsnäoloon tai puuttumiseen ekspressiossa."],"fr":["Met une expression en relation avec une présence ou une absence de son dans une expression."],"hu":["Egy kifejezési formát hozzákapcsol hang jelenlétéhez vagy távollétéhez egy kifejezési formában."],"nl":["Relateert een expressie aan een aanwezigheid of afwezigheid van geluid in een expressie."],"no":["Relaterer et uttrykk til en tilstedeværelse eller fravær av lyd i et uttrykk."],"vi":["Liên kết một biểu hiện với hiện diện hoặc không có âm thanh trong biểu hiện."]},"ToolkitLabel":{"ca":"contingut sonor","da":"lydindhold","de":"Toninhalt","el":"ηχητικό περιεχόμενο","en":"sound content (Deprecated)","es":"contenido sonoro","et":"helisisaldus","fi":"äänisisältö","fr":"contenu sonore","hu":"hangtartalom","nl":"geluidscontent","no":"lydinnhold","sv":"ljudinnehåll","vi":"nội dung âm thanh"},"ToolkitDefinition":{"ca":"Presència o absència de so en una expressió.","da":"Tilstedeværelse og fravær af lyd i et udtryk.","de":"Ein Vorhandensein beziehungsweise nicht Vorhandensein von Ton in einer Expression.","el":"Η παρουσία ή η απουσία ήχου σε μια έκφραση.","en":"A presence or absence of sound in an expression. (Deprecated)","es":"La presencia de sonido en un recurso, diferente al que consiste primariamente de sonido grabado.","et":"Heli olemasolu või puudumine väljenduses.","fi":"Äänen läsnäolo tai puuttuminen ekspressiossa.","fr":"Présence ou absence de son dans une expression.","hu":"Hang jelenléte vagy távolléte egy kifejezési formában.","nl":"Een aanwezigheid of afwezigheid van geluid in een expressie.","no":"En tilstedeværelse eller fravær av lyd i et uttrykk.","vi":"Hiện diện hoặc không có âm thanh trong biểu hiện."},"label":{"ca":"té com a contingut sonor","da":"har lydindhold","de":"hat Toninhalt","el":"έχει ηχητικό περιεχόμενο","en":"has sound content (Deprecated)","et":"helisisaldus","fi":"äänisisältö","fr":"a pour contenu sonore","hu":"hangtartalma","nl":"heeft geluidscontent","no":"har lydinnhold","sv":"har ljudinnehåll","vi":"có nội dung âm thanh"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"lexicalAlias":"http://rdaregistry.info/Elements/e/soundContent.en","status": {
