                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20202", "lexicalAlias":"http://rdaregistry.info/Elements/e/describedInExpression.en", "label":"is described in (expression) (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/evaluatedInExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20150","ToolkitDefinition":{"en":"An expression of a work that is examined or judged."},"ToolkitLabel":{"en":"evaluation of (expression)"},"definition":{"en":["Relates an expression to an expression of a work that is examined or judged. (Deprecated)"]},"label":{"en":"is evaluation of (expression) (Deprecated)"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20072", "lexicalAlias":"http://rdaregistry.info/Elements/e/descriptionOfExpression.en", "label":"is description of (expression) (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/evaluationOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"}},{"@id":"http://rdaregistry.info/Elements/e/P20270","definition":{"ar":["تربط بين تعبيرة وعمل يصف بنية تعبيرة لعمل آخر أو تكوينها."],"ca":["Relaciona una expressió amb una obra que descriu l’estructura i la composició d’una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k dílu, které popisuje strukturu a kompozici vyjádření jiného díla."],"da":["Relaterer et udtryk til et værk, som beskriver strukturen og sammensætning af et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einem Werk, das den Aufbau und die Zusammensetzung einer Expression eines anderen Werks beschreibt.,Setzt eine Expression in Beziehung zu einem Werk, das den Aufbau und die Zusammensetzung einer Expression eines anderen Werks beschreibt."],"el":["Συνδέει μια έκφραση με ένα έργο το οποίο εξετάζει μια έκφραση-πηγή για την ταύτιση των συστατικών του και τις σχέσεις τους."],"en":["Relates an expression to a work that describes the structure and composition of an expression of another work."],"es":["Relaciona una expresión con una obra que describe la estructura y composición de una expresión de otra obra."],"et":["Seostab väljenduse teosega, milles kirjeldatakse teise teose väljenduse struktuuri ja kompositsiooni."],"fi":["Liittää ekspression teokseen, joka kuvaa toisen teoksen ekspression rakennetta ja koostumusta."],"fr":["Met une expression en relation avec une œuvre qui décrit la structure et la composition d’une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy műhöz, amely egy másik mű kifejezési formáját vizsgálja, hogy leírhassa annak alkotóelemeit és azok viszonyait."],"lv":["Sasaista izteiksmi ar darbu, kurā aprakstīta cita darba izteiksmes struktūra."],"nl":["Relateert een expressie aan een werk dat de structuur en compositie van een expressie van een ander werk beschrijft."],"no":["Relaterer et uttrykk til et verk som beskriver strukturen og sammensetningen av et uttrykk av et annet verk."],"tr":["Bir anlatımı, başka bir eserin anlatımının yapısını ve bileşimini tanımlayan bir eserle ilişkilendirir."],"vi":["Liên kết một biểu hiện với chi tác phẩm kiểm tra biểu hiện nguồn để nhận dạng các bộ phận cấu thành và quan hệ giữa chúng."],"zh-Hans-CN":["将一种内容表达与描述另一种作品的一种内容表达的结构和创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة محللة في","ca":"expressió analitzada en","cs":"vyjádření analyzované v","da":"udtryk analyseret i","de":"Expression analysiert in","de":"Expression analysiert in","el":"αναλύεται στην (έκφραση)","en":"expression analysed in","es":"expresión analizada en","et":"väljenduse analüüs","fi":"ekspression analyysi","fr":"expression analysée dans","hu":"kifejezési forma elemezve a következőben:","lv":"izteiksmes analīze","nl":"expressie geanalyseerd in","no":"uttrykk analysert i","tr":"anlatım içinde analiz edilen","vi":"được phân tích trong (biểu hiện)","zh-Hans-CN":"被分析于……的内容表达"},"ToolkitDefinition":{"ar":"عمل يصف بنية تعبيرة لعمل آخر أو تكوينها.","ca":"Obra que descriu l’estructura i la composició d’una expressió d’una altra obra.","cs":"Dílo, které popisuje strukturu a kompozici vyjádření jiného díla.","da":"Værk, som beskriver strukturen og sammensætning af et udtryk af et andet værk.","de":"Ein Werk, das den Aufbau und die Zusammensetzung einer Expression eines anderen Werks beschreibt.","de":"Ein Werk, das den Aufbau und die Zusammensetzung einer Expression eines anderen Werks beschreibt.","el":"Ένα έργο το οποίο εξετάζει μια έκφραση-πηγή για την ταύτιση των συστατικών του και τις σχέσεις τους.","en":"A work that describes the structure and composition of an expression of another work.","es":"Una obra que describe la estructura y composición de una expresión de otra obra.","et":"Teos, milles kirjeldatakse teise teose väljenduse struktuuri ja kompositsiooni.","fi":"Teos, joka kuvaa toisen teoksen ekspression rakennetta ja koostumusta.","fr":"Œuvre qui décrit la structure et la composition d’une expression d’une autre œuvre.","hu":"Egy mű, amely egy másik mű kifejezési formáját vizsgálja, hogy leírhassa annak alkotóelemeit és azok viszonyait.","lv":"Darbs, kurā aprakstīta cita darba izteiksmes struktūra.","nl":"Een werk dat de structuur en compositie van een expressie van een ander werk beschrijft.","no":"Et verk som beskriver strukturen og sammensetningen av et uttrykk av et annet verk.","tr":"Başka bir eserin anlatımının yapı ve kompozisyonunu tanımlayan bir eser.","vi":"Tác phẩm kiểm tra biểu hiện nguồn để nhận dạng các bộ phận cấu thành và quan hệ giữa chúng.","zh-Hans-CN":"描述另一种作品的一种内容表达的结构和创作的一种作品"},"label":{"ar":"هي تعبيرة محللة في","ca":"és expressió analitzada en","cs":"je vyjádřením analyzovaným v","da":"er udtryk analyseret i","de":"ist Expression analysiert in","de":"ist Expression analysiert in","el":"αναλύεται στην (έκφραση)","en":"is expression analysed in","es":"se analiza la expresión en","et":"väljenduse analüüs","fi":"ekspression analyysi","fr":"est une expression analysée dans","hu":"kifejezési forma elemezve a következőben:","lv":"ir izteiksmes analīze","nl":"is expressie geanalyseerd in","no":"er uttrykk analysert i","tr":"analiz edilmiş anlatımdır","vi":"được phân tích trong (biểu hiện)","zh-Hans-CN":"是被分析于……的内容表达"},"altLabel":{"ar":["محللة في (تعبيرة)"],"ca":["analitzat en (expressió)"],"cs":["analyzováno v (vyjádření)"],"da":["analyseret i udtryk"],"de":["Analysiert in (Expression),Analysiert in (Expression)"],"en":["analysed in (expression)"],"es":["analizado en (expresión)"],"fi":["analysoitu teoksessa (ekspressio)"],"fr":["analysé dans (expression)"],"hu":["elemezve a következőben (kifejezési forma):"],"nl":["geanalyseerd in (expressie)"],"no":["analysert i (uttrykk)"],"tr":["analiz edilen (anlatım)"],"zh-Hans-CN":["被分析于（内容表达）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
