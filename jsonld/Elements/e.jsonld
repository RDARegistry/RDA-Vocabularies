                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/verseAdaptationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20124", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/verseAdaptationOfExpression.en", "label":"is verse adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20124", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/verseAdaptationOfExpression.en", "label":"is verse adaptation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20134","label":{"ar":"هي معالجة فيديو لتعبيرة","ca":"és adaptació en vídeo d’una expressió","cs":"je adaptací vyjádření pro video","da":"er bearbejdelse af udtryk til video","de":"ist Videobearbeitung von (Expression)","de":"ist Videobearbeitung von (Expression)","el":"είναι προσαρμογή για βίντεο της (έκφρασης)","en":"is video adaptation of expression","es":"es una adaptación en video de la expresión","et":"videoversioon väljendusest","fi":"videosovitus ekspressiosta","fr":"est une adaptation en vidéo d’une expression","hu":"videófeldolgozása a következő kifejezési forma alapján:","lv":"kā video adaptētā izteiksme","nl":"is videobewerking van expressie","no":"er bearbeidelse av uttrykk til video","tr":"anlatımın video uyarlamasıdır","vi":"là phỏng theo video của (biểu hiện)","zh-Hans-CN":"是内容表达的视频改编"},"definition":{"ar":["تربط تعبيرة بتعبيرة لعمل معالج كفيديو."],"ca":["Relaciona una expressió amb una expressió d’una obra que és adaptada per a vídeo."],"cs":["Vztahuje vyjádření k vyjádření díla, které je adaptováno pro video."],"da":["Relaterer et udtryk af et udtryk af et værk, som er bearbejdet til video."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Video bearbeitet ist.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die als Video bearbeitet ist."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί για βίντεο."],"en":["Relates an expression to an expression of a work that is adapted for video."],"es":["Relaciona una expresión con una expresión de una obra que está adaptada para vídeo."],"et":["Seostab väljenduse teose väljendusega, mis on adapteeritud videofilmina."],"fi":["Liittää ekspression teoksen ekspressioon, joka on sovitettu videoksi."],"fr":["Met une expression en relation avec une expression d’une œuvre qui est adaptée en vidéo."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amelyet videóként adaptáltak."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas ir adaptēta kā video."],"nl":["Relateert een expressie aan een expressie van een werk dat is bewerkt voor video."],"no":["Relaterer et uttrykk til et uttrykk av et verk som er bearbeidet til video."],"tr":["Bir anlatımı, video için uyarlanan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm được phỏng theo cho video."],"zh-Hans-CN":["将一种内容表达与被改编用于视频的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة فيديو لتعبيرة","ca":"adaptació en vídeo d’una expressió","cs":"adaptace vyjádření pro video","da":"bearbejdelse af udtryk til video","de":"Videobearbeitung von (Expression)","de":"Videobearbeitung von (Expression)","el":"προσαρμογή για βίντεο της (έκφρασης)","en":"video adaptation of expression","es":"adaptación en vídeo de la expresión.","et":"videoversioon väljendusest","fi":"videosovitus ekspressiosta","fr":"adaptation en vidéo d’une expression","hu":"videófeldolgozása a következő kifejezési forma alapján:","lv":"kā video adaptētā izteiksme","nl":"videobewerking van expressie","no":"bearbeidelse av uttrykk til video","tr":"anlatımın video uyarlaması","vi":"phỏng theo video của (biểu hiện)","zh-Hans-CN":"内容表达的视频改编"},"ToolkitDefinition":{"ar":"تعبيرة لعمل معالج لفيديو.","ca":"Expressió d’una obra que és adaptada per a vídeo.","cs":"Vyjádření díla, které je adaptováno pro video.","da":"Udtryk af et værk, som er bearbejdet til video.","de":"Eine Expression eines Werks, die als Video bearbeitet ist.","de":"Eine Expression eines Werks, die als Video bearbeitet ist.","el":"Μια έκφραση ενός έργου το οποίο έχει προσαρμοστεί για βίντεο.","en":"An expression of a work that is adapted for video.","es":"Una expresión de una obra que está adaptada para vídeo.","et":"Teose väljendus, mis on adapteeritud videofilmina.","fi":"Teoksen ekspressio, joka on sovitettu videoksi.","fr":"Expression d’une œuvre qui est adaptée en vidéo.","hu":"Egy mű kifejezési formája, amelyet videóként adaptáltak.","lv":"Darba izteiksme, kas ir adaptēta kā video.","nl":"Een expressie van een werk dat is bewerkt voor video.","no":"Et uttrykk av et verk som er bearbeidet til video.","tr":"Bir video için uyarlanmış bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm được phỏng theo cho video.","zh-Hans-CN":"被改编用于视频的一种作品的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20152", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptationOfExpression.en", "label":"is adaptation of expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/videoAdaptationOfExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20134", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/videoAdaptationOfExpression.en", "label":"is video adaptation of expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20134", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/videoAdaptationOfExpression.en", "label":"is video adaptation of expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20098","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يتكون من سيناريو لفيديو مبني على تعبيرة لعمل آخر."],"ca":["Relaciona una expressió amb una expressió d’una obra que consisteix en un guió d’un vídeo, basada en una expressió d’una altra obra."],"cs":["Vztahuje vyjádření k vyjádření díla, které sestává ze scénáře pro video, založenému na vyjádření jiného díla."],"da":["Relaterer et udtryk til et udtryk af et værk, som består af et manuskript til en video, baseret på et udtryk af et andet værk."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einem Drehbuch für ein Video besteht und auf einer Expression eines anderen Werks basiert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die aus einem Drehbuch für ein Video besteht und auf einer Expression eines anderen Werks basiert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου που συνίσταται από ένα σενάριο για ένα βίντεο βασισμένο σε ένα έργο-πηγή."],"en":["Relates an expression to an expression of a work that consists of a screenplay for a video, based on an expression of another work."],"es":["Relaciona una expresión con una expresión de una obra que consta de un guión para un vídeo, basado en una expresión de otra obra."],"et":["Seostab väljenduse teose väljendusega, mis on allikteosel põhinev stsenaarium video jaoks."],"fi":["Liittää ekspression teoksen ekspressioon, joka koostuu toisen teoksen ekspressioon perustuvasta videon käsikirjoituksesta."],"fr":["Met une expression en relation avec une expression d’une œuvre qui consiste en un scénario de vidéo, basée sur une expression d’une autre œuvre."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely egy másik mű kifejezési formáján alapuló videó forgatókönyvéből áll."],"lv":["Sasaista izteiksmi ar darba izteiksmi - videoscenārijs, veidots pēc pamatdarba."],"nl":["Relateert een expressie aan een expressie van een werk dat bestaat uit een scenario voor een video, gebaseerd op een expressie van een ander werk."],"no":["Relaterer et uttrykk til et uttrykk av et verk som består av et manuskript for en video, basert på et kildeverk."],"tr":["Bir anlatımı, başka bir eserin anlatımına dayanan bir video için senaryodan oluşan bir eserin anlatımıyla ilişkilendirir."],"vi":["Biểu hiện của tác phẩm có chứa kịch bản của video, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种内容表达与由基于另一种作品的一种内容表达的一种视频的剧本组成的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"معالجة كتعبيرة سيناريو فيديو","ca":"adaptat com a expressió de guió de vídeo","cs":"adaptováno jako scénář pro video (vyjádření)","da":"bearbejdet til videomanuskriptudtryk","de":"Bearbeitet als Videodrehbuch (Expression)","de":"Bearbeitet als Videodrehbuch (Expression)","el":"προσαρμοσμένη ως σενάριο για βίντεο (έκφραση)","en":"adapted as video screenplay expression","es":"adaptado como expresión de guión de vídeo","et":"adapteeritud videostsenaariumina (väljendus)","fi":"sovitettu videokäsikirjoitukseksi (ekspressio)","fr":"adapté en scénario de vidéo (expression)","hu":"videóforgatókönyv-feldolgozása kifejezési formaként:","lv":"adaptēts kā izteiksme: videoscenārijs","nl":"bewerkt als videoscenario-expressie","no":"bearbeidet som manus for video (uttrykk)","tr":"Video senaryosu anlatımı olarak uyarlanan","vi":"được phỏng theo như là kịch bản video (biểu hiện)","zh-Hans-CN":"被改编为视频剧本内容表达"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يتكون من سيناريو لفيديو مبني على تعبيرة لعمل آخر.","ca":"Expressió d’una obra que consisteix en un guió d’un vídeo, basada en una expressió d’una altra obra.","cs":"Vyjádření díla, které sestává ze scénáře pro video, založenému na vyjádření jiného díla.","da":"Udtryk af et værk, som består af et manuskript til en video, baseret på et udtryk af et andet værk.","de":"Eine Expression eines Werks, die aus einem Drehbuch für ein Video besteht und auf einer Expression eines anderen Werks basiert.","de":"Eine Expression eines Werks, die aus einem Drehbuch für ein Video besteht und auf einer Expression eines anderen Werks basiert.","el":"Μια έκφραση ενός έργου που συνίσταται από ένα σενάριο για ένα βίντεο βασισμένο σε ένα έργο-πηγή.","en":"An expression of a work that consists of a screenplay for a video, based on an expression of another work.","es":"Una expresión de una obra que consta de un guión para un vídeo, basado en una expresión de otra obra.","et":"Teose väljendus, mis on allikteosel põhinev stsenaarium video jaoks.","fi":"Teoksen ekspressio, joka koostuu toisen teoksen ekspressioon perustuvasta videon käsikirjoituksesta.","fr":"Expression d’une œuvre qui consiste en un scénario de vidéo, basée sur une expression d’une autre œuvre.","hu":"Egy mű kifejezési formája, amely egy másik mű kifejezési formáján alapuló videó forgatókönyvéből áll.","lv":"Darba izteiksme - videoscenārijs, veidots pēc pamatdarba.","nl":"Een expressie van een werk dat bestaat uit een scenario voor een video, gebaseerd op een expressie van een ander werk.","no":"Et uttrykk av et verk som består av et manuskript for en video, basert på et kildeverk.","tr":"Başka bir eserin anlatımına dayanan bir video için senaryodan oluşan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm có chứa kịch bản của video, dựa trên tác phẩm nguồn.","zh-Hans-CN":"由基于另一种作品的一种内容表达的一种视频的剧本组成的一种作品的一种内容表达"},"label":{"ar":"هي معالجة كتعبيرة سيناريو فيديو","ca":"és adaptat com a expressió de guió de vídeo","cs":"je adaptováno jako scénář pro video (vyjádření)","da":"er bearbejdet til videomanuskriptudtryk","de":"ist bearbeitet als Videodrehbuch (Expression)","de":"ist bearbeitet als Videodrehbuch (Expression)","el":"είναι προσαρμοσμένη ως σενάριο για βίντεο (έκφραση)","en":"is adapted as video screenplay expression","es":"está adaptado como expresión de guión de vídeo.","et":"adapteeritud videostsenaariumina (väljendus)","fi":"sovitettu videokäsikirjoitukseksi (ekspressio)","fr":"est adapté en scénario de vidéo (expression)","hu":"videóforgatókönyv-feldolgozása a következő kifejezési formaként:","lv":"ir adaptēts kā videoscenārijs (izteiksme)","nl":"is bewerkt als videoscenario-expressie","no":"er bearbeidet som manus for video (uttrykk)","tr":"video senaryosu anlatımı olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản video (biểu hiện)","zh-Hans-CN":"被改编为视频剧本内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20096", "lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsScreenplayExpression.en", "label":"is adapted as screenplay expression"}],"lexicalAlias":"http://rdaregistry.info/Elements/e/adaptedAsVideoScreenplayExpression.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/object/P20098", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/adaptedAsVideoScreenplayExpression.en", "label":"is adapted as video screenplay expression"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20098", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/adaptedAsVideoScreenplayExpression.en", "label":"is adapted as video screenplay expression"}]},{"@id":"http://rdaregistry.info/Elements/e/P20159","definition":{"ar":["تربط تعبيرة بتعبيرة لعمل يقدم نصًا لعمل موسيقي غير درامي، بخلاف الموسيقى الدينية."],"ca":["Relaciona una expressió amb una expressió d’una obra que proporciona el text d’una obra musical no teatral, diferent d’un oratori."],"cs":["Vztahuje vyjádření k vyjádření díla, které poskytuje text pro nedramatické hudební dílo jiné než oratorium."],"da":["Relaterer et udtryk til et udtryk af et værk, som angiver tekst til et ikke-dramatisk musikværk, bortset fra et oratorium."],"de":["Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für ein nicht dramatisches Musikwerk (kein Oratorium) liefert.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die Text für ein nicht dramatisches Musikwerk (kein Oratorium) liefert."],"el":["Συνδέει μια έκφραση με μια έκφραση ενός έργου το οποίο παρέχει κείμενο για ένα μη δραματικό μουσικό έργο, άλλο από ορατόριο."],"en":["Relates an expression to an expression of a work that provides text for a non-dramatic musical work, other than an oratorio."],"es":["Relaciona una expresión con una expresión de una obra que proporciona texto para una obra musical no dramática, distinta de un oratorio."],"et":["Seostab väljenduse teose väljendusega, mis annab teksti mittedramaatilisele muusikateosele (v.a oratoorium)."],"fi":["Liittää ekspression teoksen ekspressioon, joka on ei-näytelmällisen musiikkiteoksen (muun kuin oratorion) teksti."],"fr":["Met une expression en relation avec une expression d’une œuvre qui fournit un texte pour une œuvre musicale non dramatique, autre qu’un oratorio."],"hu":["Hozzákapcsol egy kifejezési formát egy mű kifejezési formájához, amely szöveggel lát el egy nem oratórium, nem-drámai zeneművet."],"lv":["Sasaista izteiksmi ar darba izteiksmi, kas nodrošina tekstu ne-dramatiskam muzikas darbam, kas nav oratorija."],"nl":["Relateert een expressie aan een expressie van een werk dat tekst levert voor een niet-dramatisch muziekwerk, anders dan een een oratorium."],"no":["Relaterer et uttrykk til et uttrykk av et verk som tilfører teksten til et ikke-dramatisk musikalsk verk, bortsett fra et oratorium."],"tr":["Bir anlatımı, oratoryo dışında dramatik olmayan bir müzik eseri için metin sağlayan bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết một biểu hiện với biểu hiện của tác phẩm cung cấp văn bản cho tác phẩm âm nhạc phi kịch, khác với oratorio."],"zh-Hans-CN":["将一种内容表达与为一种非戏剧音乐作品（清唱剧除外）提供文本的一种作品的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"إعداد موسيقي لتعبيرة","ca":"musicació d’una expressió","cs":"hudební zpracování vyjádření","da":"musiksætning af udtryk","de":"Vertonung von (Expression)","de":"Vertonung von (Expression)","el":"μελοποίηση της (έκφραση)","en":"musical setting of expression","es":"escenario musical de expresión","et":"viisistatud tekst (väljendus)","fi":"musiikkiteoksen teksti (ekspressio)","fr":"mise en musique d’une expression","hu":"zenei átirata a következő kifejezési formának:","lv":"izteiksme komponēta tekstam","nl":"muziek gezet op expressie","no":"musikksetting av uttrykk","tr":"müzikal ifadenin ortamı","vi":"phổ nhạc của (biểu hiện)","zh-Hans-CN":"内容表达的配乐"},"ToolkitDefinition":{"ar":"تعبيرة لعمل يقدم نصًا لعمل موسيقي غير درامي، بخلاف الموسيقى الدينية.","ca":"Expressió d’una obra que proporciona el text d’una obra musical no teatral, diferent d’un oratori.","cs":"Vyjádření díla, které poskytuje text pro nedramatické hudební dílo jiné než oratorium.","da":"Udtryk af et værk, som angiver tekst til et ikke-dramatisk musikværk, bortset fra et oratorium.","de":"Eine Expression eines Werks, die Text für ein nicht dramatisches Musikwerk (kein Oratorium) liefert.","de":"Eine Expression eines Werks, die Text für ein nicht dramatisches Musikwerk (kein Oratorium) liefert.","el":"Μια έκφραση ενός έργου το οποίο παρέχει κείμενο για ένα μη δραματικό μουσικό έργο, άλλο από ορατόριο.","en":"An expression of a work that provides text for a non-dramatic musical work, other than an oratorio.","es":"Una expresión de una obra que proporciona texto para una obra musical no dramática, distinta de un oratorio.","et":"Teose väljendus, mis annab teksti mittedramaatilisele muusikateosele (v.a oratoorium).","fi":"Teoksen ekspressio, joka on ei-näytelmällisen musiikkiteoksen (muun kuin oratorion) teksti.","fr":"Expression d’une œuvre qui fournit un texte pour une œuvre musicale non dramatique, autre qu’un oratorio.","hu":"Egy mű kifejezési formája, amely szöveggel lát el egy nem oratórium, nem-drámai zeneművet.","lv":"Darba izteiksme, kas nodrošina tekstu ne-dramatiskam muzikas darbam, kas nav oratorija.","nl":"Een expressie van een werk dat tekst levert voor een niet-dramatisch muziekwerk, anders dan een een oratorium.","no":"Et uttrykk av et verk som tilfører teksten til et ikke-dramatisk musikalsk verk, bortsett fra et oratorium.","tr":"Oratoryo dışında, dramatik olmayan bir müzik eseri için metin sağlayan bir eserin anlatımı.","vi":"Biểu hiện của tác phẩm cung cấp văn bản cho tác phẩm âm nhạc phi kịch, khác vớioratorio.","zh-Hans-CN":"为一种非戏剧音乐作品（清唱剧除外）提供文本的一种作品的一种内容表达"},"label":{"ar":"هي إعداد موسيقي لتعبيرة","ca":"és musicació d’una expressió","cs":"je hudebním zpracováním vyjádření","da":"er musiksætning af udtryk","de":"ist Vertonung von (Expression)","de":"ist Vertonung von (Expression)","el":"είναι μελοποίηση της (έκφραση)","en":"is musical setting of expression","es":"es escenario musical de expresión","et":"viisistatud tekst (väljendus)","fi":"musiikkiteoksen teksti (ekspressio)","fr":"est une mise en musique d’une expression","hu":"zenei átirata a következő kifejezési formának:","lv":"ir izteiksme komponēta tekstam","nl":"is muziek gezet op expressie","no":"er musikksetting av uttrykk","tr":"anlatımın müzikal düzenlemesidir","vi":"là phổ nhạc của (biểu hiện)","zh-Hans-CN":"是内容表达的配乐"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
