                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10006", "lexicalAlias":"http://rdaregistry.info/Elements/c/Expression.en", "label":"expression"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/e/P20407", "lexicalAlias":"http://rdaregistry.info/Elements/e/audioEngineerCollectiveAgent.en", "label":"has audio engineer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/P20050", "lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerAgent.en", "label":"has recording engineer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/e/P20504", "lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerCorporateBody.en", "label":"has recording engineer corporate body"},{"@id":"http://rdaregistry.info/Elements/e/P20563", "lexicalAlias":"http://rdaregistry.info/Elements/e/recordingEngineerFamily.en", "label":"has recording engineer family"},{"@id":"http://rdaregistry.info/Elements/e/object/P20445", "lexicalAlias":"http://rdaregistry.info/Elements/e/object/recordingEngineerCollectiveAgent.en", "label":"has recording engineer collective agent"},{"@id":"http://rdaregistry.info/Elements/e/datatype/P20445", "lexicalAlias":"http://rdaregistry.info/Elements/e/datatype/recordingEngineerCollectiveAgent.en", "label":"has recording engineer collective agent"}]},{"@id":"http://rdaregistry.info/Elements/e/P20504","label":{"ar":"لها هيئة مهندسة تسجيل","ca":"té com a entitat corporativa enginyera de so","cs":"má technika záznamu (korporaci)","da":"har korporation, som er indspilningstekniker","de":"hat Aufnahmetechnikerin/Aufnahmetechniker (Körperschaft)","de":"hat Aufnahmetechnikerin/Aufnahmetechniker (Körperschaft)","en":"has recording engineer corporate body","es":"tiene organismo corporativo ingeniero de grabación","et":"salvestusinsener (asutus)","fi":"äänittäjä (yhteisö)","fr":"a pour collectivité preneuse de son","hu":"hangrögzítő testülete a következő:","lv":"ierakstu inženieris (institūcija)","nl":"heeft opnametechnicus-corporatie","no":"har innspillingstekniker (korporasjon)","tr":"kayıt mühendisi tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有录制工程师团体"},"definition":{"ar":["تربط بين تعبيرة وهيئة تكون مهندس صوت يساهم في محتوى صوتي لتعبيرة بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل."],"ca":["Relaciona una expressió amb una entitat corporativa que és un enginyer d’àudio que contribueix al contingut àudio d’una expressió amb la supervisió dels aspectes tècnics d’una sessió d’enregistrament."],"cs":["Vztahuje vyjádření ke korporaci, která je zvukovým technikem, který přispívá ke zvukovému obsahu vyjádření tím, že dohlíží na technické aspekty nahrávání."],"da":["Relaterer et udtryk til en korporation, som er lydtekniker, som bidrager til lydindholdet af et udtryk ved at føre tilsyn med de tekniske aspekter af en lyd- eller videooptagelse."],"de":["Setzt eine Expression in Beziehung zu einer Tontechnikerin/einem Tontechniker (Körperschaft), die/der zum Audio-Inhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht.,Setzt eine Expression in Beziehung zu einer Tontechnikerin/einem Tontechniker (Körperschaft), die/der zum Audio-Inhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht."],"en":["Relates an expression to a corporate body who is an audio engineer who contributes to the audio content of an expression by supervising the technical aspects of a recording session."],"es":["Relaciona una expresión con un organismo corporativo que es un ingeniero de audio que contribuye al contenido de audio de una expresión al supervisar los aspectos técnicos del contenido de audio de una sesión de grabación."],"et":["Seostab väljenduse asutusega, kes heliinsenerina annab panuse väljenduse helisisusse, juhendades salvestamise tehnilisi aspekte."],"fi":["Liittää ekspression yhteisöön, joka on ääniteknikko, joka osallistuu ekspression äänisisällön tekemiseen valvomalla äänityksen teknistä toteutusta."],"fr":["Met une expression en relation avec une collectivité ingénieure du son qui contribue au contenu audio d’une expression en supervisant les aspects techniques d’une séance d’enregistrement."],"hu":["Hozzákapcsol egy kifejezési formát egy hangmester testülethez, amely egy felvétel technikai vonatkozásainak felügyeletével hozzájárul egy kifejezési forma audio-tartalmához."],"lv":["Sasaista izteiksmi ar institūciju, kas ir audio inženieris, kas sniedz ieguldījumu izteiksmes audio saturā, uzraugot tehniskos parametrus ieraksta laikā."],"nl":["Relateert een expressie aan een corporatie die een geluidstechnicus is die bijdraagt aan de geluidscontent van een expressie door het toezicht houden op de technische aspecten van een opnamesessie."],"no":["Relaterer et uttrykk til en korporasjon som er en lydtekniker som bidrar til lydinnholdet i et uttrykk ved å styre de tekniske aspektene ved en innspilling."],"tr":["Bir anlatımı, bir kayıt oturumunun teknik yönlerini denetleyerek anlatımın ses içeriğine katkıda bulunan bir ses mühendisi olan tüzel kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种内容表达与作为一个音频工程师通过监督一个录制过程中的技术方面而对一种内容表达的音频内容有贡献的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مهندسة تسجيل","ca":"entitat corporativa enginyera de so","cs":"technik záznamu (korporace)","da":"korporation, som er indspilningstekniker","de":"Aufnahmetechnikerin/Aufnahmetechniker (Körperschaft)","de":"Aufnahmetechnikerin/Aufnahmetechniker (Körperschaft)","en":"recording engineer corporate body","es":"organismo corporativo ingeniero de grabación","et":"salvestusinsener (asutus)","fi":"äänittäjä (yhteisö)","fr":"collectivité preneuse de son","hu":"hangrögzítő testület:","lv":"ierakstu inženieris (institūcija)","nl":"opnametechnicus-corporatie","no":"innspillingstekniker (korporasjon)","tr":"Kayıt mühendisi tüzel kişisi","zh-Hans-CN":"录制工程师团体"},"ToolkitDefinition":{"ar":"هيئة تكون مهندس صوت يساهم في محتوى صوتي لتعبيرة بالإشراف على الجوانب الفنية لمحتوى صوتي لجلسة تسجيل.","ca":"Entitat corporativa que és un enginyer d’àudio que contribueix al contingut àudio d’una expressió amb la supervisió dels aspectes tècnics d’una sessió d’enregistrament.","cs":"Korporace, která je zvukovým technikem, který přispívá ke zvukovému obsahu vyjádření tím, že dohlíží na technické aspekty nahrávání.","da":"Korporation, som er lydtekniker, som bidrager til lydindholdet af et udtryk ved at føre tilsyn med de tekniske aspekter af en lyd- eller videooptagelse.","de":"Eine Tontechnikerin/Ein Tontechniker (Körperschaft), die/der zum Audio-Inhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht.","de":"Eine Tontechnikerin/Ein Tontechniker (Körperschaft), die/der zum Audio-Inhalt einer Expression beiträgt, indem sie/er die technischen Aspekte einer Aufnahme überwacht.","en":"A corporate body who is an audio engineer who contributes to the audio content of an expression by supervising the technical aspects of a recording session.","es":"Un organismo corporativo que es un ingeniero de audio que contribuye a una expresión al contenido de audio de una expresión al supervisar los aspectos técnicos del contenido de audio de una sesión de grabación.","et":"Asutus, kes heliinsenerina annab panuse väljenduse helisisusse, juhendades salvestamise tehnilisi aspekte.","fi":"Yhteisö, joka on ääniteknikko, joka osallistuu ekspression äänisisällön tekemiseen valvomalla äänityksen teknistä toteutusta.","fr":"Collectivité ingénieure du son qui contribue au contenu audio d’une expression en supervisant les aspects techniques d’une séance d’enregistrement.","hu":"Egy hangmester testület, amely egy felvétel technikai vonatkozásainak felügyeletével hozzájárul egy kifejezési forma audio-tartalmához.","lv":"Institūcija - audio inženieris, kurš sniedz ieguldījumu izteiksmes audio saturā, uzraugot tehniskos parametrus ieraksta laikā.","nl":"Een corporatie die een geluidstechnicus is die bijdraagt aan de geluidscontent van een expressie door het toezicht houden op de technische aspecten van een opnamesessie.","no":"En korporasjon som er en lydtekniker som bidrar til lydinnholdet i et uttrykk ved å styre de tekniske aspektene ved en innspilling.","tr":"Bir kayıt oturumunun teknik yönlerini denetleyerek bir anlatının, ifadenin ses içeriğine katkıda bulunan bir ses mühendisi olan tüzel kişi.","zh-Hans-CN":"作为一个音频工程师通过监督一个录制过程中的技术方面而对一种内容表达的音频内容有贡献的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/e/", "label":"Expression properties"},"status": {
