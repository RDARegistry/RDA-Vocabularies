                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en", "label":"is succeeded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/absorbedInPartByWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10146", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/absorbedInPartByWork.en", "label":"is absorbed in part by work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10146", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/absorbedInPartByWork.en", "label":"is absorbed in part by work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10186","label":{"ar":"هو إعادة صياغة لعمل","ca":"és paràfrasi d’una obra","cs":"je parafrází díla","da":"er parafrase over værk","de":"ist Paraphrase von (Werk)","de":"ist Paraphrase von (Werk)","el":"είναι παράφραση του (έργο)","en":"is paraphrase of work","es":"es una paráfrasis de la obra","et":"parafraseeritud teos","fi":"parafraasi teoksesta","fr":"est une paraphrase d’une œuvre","hu":"parafrázisa a következő műnek:","it":"è parafrasi di opera","lv":"ir parafrāze darbam","nl":"is parafrase van werk","no":"er omskriving av verk","tr":"eserin yeniden yorumlanmasıdır","vi":"là diễn giải của (tác phẩm)","zh-Hans-CN":"是作品的演绎"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لإعادة صياغة محتوى عمل آخر في شكل مختلف."],"ca":["Relaciona una obra amb una obra usada com a base d’un replantejament del contingut d’una altra obra en una forma diferent."],"cs":["Vztahuje dílo k dílu, použitému jako základ pro přetvoření obsahu jiného díla v odlišné formě."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for en gentagelse af indholdet af et oprindeligt værk i en anden form."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine Neuformulierung des Inhalts eines anderen Werks in einer anderen Form verwendet wird.,Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine Neuformulierung des Inhalts eines anderen Werks in einer anderen Form verwendet wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια παράφραση, δηλαδή μια επαναδιατύπωση του περιεχομένου ενός έργου-πηγής σε μια διαφορετική μορφή."],"en":["Relates a work to a work used as a basis for a restating of the content of another work in a different form."],"es":["Relaciona una obra con una obra utilizada como base para reformular el contenido de otra obra de forma diferente."],"et":["Seostab teose teosega, mis on aluseks allikteose sisu väljendamisele teises vormis."],"fi":["Liittää teoksen teokseen, jota on käytetty toisen teoksen sisällön eri muodossa tapahtuvan toisintamisen perustana."],"fr":["Met une œuvre en relation avec une œuvre qui sert de base à une reprise du contenu d’une autre œuvre sous une formulation différente."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet alapként használnak egy parafrázishoz, azaz egy másik mű tartalmának újrafogalmazásához eltérő formában."],"it":["Correla un’opera a un’opera utilizzata come base per una riesposizione del contenuto di un’opera di partenza in una forma differente."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu parafrāzei, t.i., pamatdarba satura izteiktšanai citā veidā."],"nl":["Relateert een werk aan een werk gebruikt als een basis voor een herformulering van de content van een ander werk in een andere vorm."],"no":["Relaterer et verk til et verk som brukes som utgangspunkt for en gjentakelse av et kildeverks innhold i en annen form."],"tr":["Bir eseri, başka bir eserin içeriğinin farklı bir biçimde yeniden ifade edilmesi için temel olarak kullanılan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho diễn giải, nghĩa là, trình bày lại nội dung của tác phẩm nguồn dưới hình thái khác."],"zh-Hans-CN":["将一种作品与被用来作为以不同形式重述另一种作品之内容的基础的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إعادة صياغة لعمل","ca":"paràfrasi d’una obra","cs":"parafráze díla","da":"parafrase over værk","de":"Paraphrase von (Werk)","de":"Paraphrase von (Werk)","el":"παράφραση του (έργο)","en":"paraphrase of work","es":"paráfrasis de la obra","et":"parafraseeritud teos","fi":"parafraasi teoksesta","fr":"paraphrase d’une œuvre","hu":"parafrazeált mű","it":"parafrasi di opera","lv":"parafrāze darbam","nl":"parafrase van werk","no":"omskriving av verk","tr":"Eserin yorumlanması","vi":"diễn giải của (tác phẩm)","zh-Hans-CN":"作品的演绎"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لإعادة صياغة محتوى عمل آخر في شكل مختلف.","ca":"Obra usada com a base d’un replantejament del contingut d’una altra obra en una forma diferent.","cs":"Dílo, použité jako základ pro přetvoření obsahu jiného díla v odlišné formě.","da":"Værk, som anvendes som grundlag for en gentagelse af indholdet af et oprindeligt værk i en anden form.","de":"Ein Werk, das als Grundlage für eine Neuformulierung des Inhalts eines anderen Werks in einer anderen Form verwendet wird.","de":"Ein Werk, das als Grundlage für eine Neuformulierung des Inhalts eines anderen Werks in einer anderen Form verwendet wird.","el":"Ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια παράφραση, δηλαδή μια επαναδιατύπωση του περιεχομένου ενός έργου-πηγής σε μια διαφορετική μορφή.","en":"A work used as a basis for a restating of the content of another work in a different form.","es":"Una obra utilizada como base para reformular el contenido de otra obra de forma diferente.","et":"Teos, mis on aluseks allikteose sisu väljendamisele teises vormis.","fi":"Teos, jota on käytetty toisen teoksen sisällön eri muodossa tapahtuvan toisintamisen perustana.","fr":"Œuvre qui sert de base à une reprise du contenu d’une autre œuvre sous une formulation différente.","hu":"Egy mű, amelyet alapként használnak egy parafrázishoz, azaz egy másik mű tartalmának újrafogalmazásához eltérő formában.","it":"Opera utilizzata come base per una riesposizione del contenuto di un’opera di partenza in una forma differente.","lv":"Darbs, kas izmantots par pamatu parafrāzei, t.i., pamatdarba satura izteiktšanai citā veidā.","nl":"Een werk gebruikt als een basis voor een herformulering van de content van een ander werk in een andere vorm.","no":"Et verk som brukes som utgangspunkt for en gjentakelse av et kildeverks innhold i en annen form.","tr":"Başka bir çalışmanın içeriğinin farklı bir biçimde yeniden ifade edilmesi için temel olarak kullanılan bir çalışma.","vi":"Tác phẩm được sử dụng như là cơ sở cho diễn giải, nghĩa là, trình bày lại nội dung của tác phẩm nguồn dưới hình thái khác.","zh-Hans-CN":"被用来作为以不同形式重述另一种作品之内容的基础的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10341", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyleOf.en", "label":"is transformation by style of"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/paraphraseOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10186", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/paraphraseOfWork.en", "label":"is paraphrase of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10186", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/paraphraseOfWork.en", "label":"is paraphrase of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10002","label":{"ar":"له معرف لعمل","ca":"té com a identificador d’obra","cs":"má identifikátor díla","da":"har identifikator for værk","de":"hat Identifikator für ein Werk","de":"hat Identifikator für ein Werk","el":"έχει αναγνωριστικό για το έργο","en":"has identifier for work","es":"tiene identificador para obra","et":"teose identifikaator","fi":"teoksen tunniste","fr":"a pour identifiant d’œuvre","hu":"műazonosítója a következő:","it":"ha come identificatore per opera","lv":"darba identifikators","nl":"heeft identificatie voor werk","no":"har identifikator for verk","tr":"eserin tanımlayıcısı ile ilişkilidir","vi":"có chỉ số nhận dạng của tác phẩm","zh-Hans-CN":"有作品的标识符"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن اسم تعريفي لعمل يتكون من رمز، أو رقم، أو سلسلة تمثيلات أخرى، مستقلة عادة عن اللغة الطبيعية والتسميات المتعارف عليها اجتماعيا، ومستخدمة لتعريف عمل."],"ca":["Relaciona una obra amb un nomen que és una apel·lació d’obra que consisteix en un codi, un número o qualsevol altra cadena, normalment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una obra."],"cs":["Vztahuje dílo k nomen, které je pojmenováním díla, skládajícím se z kódu, čísla nebo jiného řetězce, obvykle nezávislého na přirozeném jazyce a společenských konvencích pojmenování, používaným k identifikaci díla."],"da":["Relaterer et værk til en benævnelse på værk, som består af en kode, nummer eller anden streng, sædvanligvis upåvirket af normalsprog og sociale navngivningskonventioner, brugt til at identificere et værk."],"de":["Setzt ein Werk in Beziehung zu einer Bezeichnung für ein Werk, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung eines Werks verwendet wird.,Setzt ein Werk in Beziehung zu einer Bezeichnung für ein Werk, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung eines Werks verwendet wird."],"el":["Συνδέει ένα έργο με έναν αλφαριθμητικό χαρακτήρα μοναδικά συνδεδεμένο με ένα έργο ή με ένα υποκατάστατο όπως μια καθιερωμένη εγγραφή για ένα έργο."],"en":["Relates a work to a nomen that is an appellation of work that consists of a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a work."],"es":["Relaciona una obra con un nomen que es un apelativo de obra que consiste en un código, número u otra secuencia, usualmente independiente del lenguaje natural y las convenciones sociales de nomenclatura, utilizado para identificar una obra."],"et":["Seostab teose teose nimetusega, mis koosneb teost identifitseerivast koodist, numbrist või muust loomulikust keelest ja üldtuntud nimetamistavadest sõltumatust stringist."],"fi":["Liittää teoksen nomeniin, joka on teoksen nimitys, joka koostuu koodista, luvusta tai muusta tavallisesti luonnollisesta kielestä ja yleisistä nimeämiskäytännöistä riippumattomasta merkkijonosta, jota käytetään teoksen identifiointiin."],"fr":["Met une œuvre en relation avec un nomen qui est une appellation d’œuvre consistant en un code, un nombre ou une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une œuvre."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy időtartam megnevezéséhez, amely kódból, számból vagy egyéb karakterláncból áll, általában a természetes nyelvtől és társadalmi elnevezési konvencióktól független, egy mű azonosítására használják."],"it":["Correla un’opera a una denominazione di un'opera che consiste di un codice, numero o altra stringa di caratteri, di solito indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, utilizzate per assegnare i nomi, utilizzato per identificare un'opera."],"lv":["Sasaista darbu ar nomenu, kas ir darba apzīmējums, kas sastāv no koda, skaitļa vai citas virknes, kas parasti ir neatkarīgs no dabiskas valodas vai sabiedrībā pieņemtām nosaukšanas tradīcijām, ko izmanto, lai identificētu darbu."],"nl":["Relateert een werk aan een nomen dat is een benaming van werk die bestaat uit een code, nummer of andere string, meestal onafhankelijk van natuurlijke taal en gewoonlijke naamgevingsconventies, gebruikt om een werk te identificeren."],"no":["Relaterer et verk til en betegnelse for verk som består av en kode, et nummer eller en annen streng, vanligvis uavhengig av et naturlig språk og sosiale navnekonvensjoner, brukt for å identifisere et verk."],"tr":["Bir eseri, bir eseri tanımlamak için kullanılan, genellikle doğal dil ve sosyal adlandırma kurallarından bağımsız olarak bir kod, sayı veya başka bir dizeden oluşan bir eser unvan olanı bir isimle ilişkilendirir."],"vi":["Liên kết tác phẩm với chuỗi ký tự duy nhất liên quan tới tác phẩm hoặc với vật thay thế như là biểu ghi chuẩn của tác phẩm."],"zh-Hans-CN":["将一种作品与作为一个由代码、数字、或其他串构成的称谓、通常独立于自然语言和社会命名惯例、用以标识一种作品的作品称谓的命名关联起来。"]},"ToolkitLabel":{"ar":"معرف لعمل","ca":"identificador d’obra","cs":"identifikátor díla","da":"identifikator for værk","de":"Identifikator für ein Werk","de":"Identifikator für ein Werk","el":"αναγνωριστικό για το έργο","en":"identifier for work","es":"identificador para obra","et":"teose identifikaator","fi":"teoksen tunniste","fr":"identifiant d’œuvre","hu":"műazonosító:","it":"identificatore per opera","lv":"darba identifikators","nl":"identificatie voor werk","no":"identifikator for verk","tr":"eserin tanımlayıcısı ile ilişkilidir","vi":"chỉ số nhận dạng của tác phẩm","zh-Hans-CN":"作品的标识符"},"ToolkitDefinition":{"ar":"تسمية عبارة عن اسم تعريفي لعمل يتكون من رمز، أو رقم، أو سلسلة تمثيلات أخرى، مستقلة عادة عن اللغة الطبيعية والتسميات المتعارف عليها اجتماعيا، ومستخدمة لتعريف عمل.","ca":"Nomen que és una apel·lació d’obra que consisteix en un codi, un número o qualsevol altra cadena, normalment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una obra.","cs":"Nomen, které je pojmenováním díla, skládajícím se z kódu, čísla nebo jiného řetězce, obvykle nezávislého na přirozeném jazyce a společenských konvencích pojmenování, používaným k identifikaci díla.","da":"Benævnelse på værk, som består af en kode, nummer eller anden streng, sædvanligvis upåvirket af normalsprog og sociale navngivningskonventioner, brugt til at identificere et værk.","de":"Eine Bezeichnung für ein Werk, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung eines Werks verwendet wird.","de":"Eine Bezeichnung für ein Werk, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung eines Werks verwendet wird.","el":"Ένας αλφαριθμητικός χαρακτήρας μοναδικά συνδεδεμένος με ένα έργο ή με ένα υποκατάστατο, όπως μια καθιερωμένη εγγραφή για ένα έργο.","en":"A nomen that is an appellation of work that consists of a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a work.","es":"Un nomen que es un apelativo de obra que consiste en un código, número u otra secuencia, usualmente independiente del lenguaje natural y las convenciones sociales de nomenclatura, utilizado para identificar una obra.","et":"Teose nimetus, mis koosneb teost identifitseerivast koodist, numbrist või muust loomulikust keelest ja üldtuntud nimetamistavadest sõltumatust stringist.","fi":"Nomen, joka on teoksen nimitys, joka koostuu koodista, luvusta tai muusta tavallisesti luonnollisesta kielestä ja yleisistä nimeämiskäytännöistä riippumattomasta merkkijonosta, jota käytetään teoksen identifiointiin.","fr":"Nomen qui est une appellation d’œuvre consistant en un code, un nombre ou une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une œuvre.","hu":"Egy nomen, amely egy mű megnevezése, amely kódból, számból vagy egyéb karakterláncból áll, általában a természetes nyelvtől és társadalmi elnevezési konvencióktól független, egy mű azonosítására használják.","it":"Denominazione di un’opera che consiste di un codice, numero o altra stringa di caratteri, di solito indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, utilizzate per assegnare i nomi, utilizzato per identificarla.","lv":"Darba apzīmējums, kas sastāv no koda, skaitļa vai citas virknes, kas parasti ir neatkarīgs no dabiskas valodas vai sabiedrībā pieņemtām nosaukšanas tradīcijām, ko izmanto, lai identificētu darbu.","nl":"Een nomen dat is een benaming van werk die bestaat uit een code, nummer of andere string, meestal onafhankelijk van natuurlijke taal en gewoonlijke naamgevingsconventies, gebruikt om een werk te identificeren.","no":"En betegnelse for verk som består av en kode, et nummer eller en annen streng, vanligvis uavhengig av et naturlig språk og sosiale navnekonvensjoner, brukt for å identifisere et verk.","tr":"Bir eseri tanımlamak için kullanılan, genellikle doğal dilden ve sosyal adlandırma kurallarından bağımsız, bir kod, sayı veya başka bir dizeden oluşan bir eser unvanı olan bir isim.","vi":"Chuỗi ký tự duy nhất liên quan tới tác phẩm hoặc với vật thay thế như là biểu ghi chuẩn của tác phẩm.","zh-Hans-CN":"作为一个由代码、数字、或其他串构成的称谓、通常独立于自然语言和社会命名惯例、用以标识一种作品的作品称谓的命名"},"note":{"ca":["L’identificador serveix per diferenciar una obra d’altres obres."],"da":["Identifikatoren tjener til at skelne et værk fra andre værker."],"de":["Der Identifikator dient dazu, dieses Werk von anderen Werken zu unterscheiden."],"el":["Το αναγνωριστικό εξυπηρετεί τον σκοπό της διαφοροποίησης ενός έργου από άλλα έργα."],"fr":["L’identifiant sert à différencier une œuvre d’autres œuvres."],"vi":["Chỉ số nhận dạng dùng để phân biệt một tác phẩm với các tác phẩm khác."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/identifierForWork.en","instructionNumber":"6.8","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10329", "lexicalAlias":"http://rdaregistry.info/Elements/w/appellationOfWork.en", "label":"has appellation of work"},{"@id":"http://rdaregistry.info/Elements/x/P00018", "lexicalAlias":"http://rdaregistry.info/Elements/x/identifierForRDAEntity.en", "label":"has identifier for RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10400", "lexicalAlias":"http://rdaregistry.info/Elements/w/identifierForWorkGroup.en", "label":"has identifier for work group"},{"@id":"http://rdaregistry.info/Elements/w/P10366", "lexicalAlias":"http://rdaregistry.info/Elements/w/issn.en", "label":"has ISSN"},{"@id":"http://rdaregistry.info/Elements/w/P10079", "lexicalAlias":"http://rdaregistry.info/Elements/w/numericDesignationOfMusicalWork.en", "label":"has numeric designation of musical work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10002", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/identifierForWork.en", "label":"has identifier for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10002", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/identifierForWork.en", "label":"has identifier for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10115","label":{"ar":"هو عمل منتقد في","ca":"és obra criticada per","cs":"je dílem kritizovaným v","da":"er værk kritiseret i","de":"ist Kritik eines Werks in","de":"ist Kritik eines Werks in","el":"κρίνεται στο (έργο)","en":"is work critiqued by","es":"es obra criticada por","et":"teose arvustus","fi":"teoksen kritiikki","fr":"est une œuvre critiquée par","hu":"mű bírálva a következő által:","it":"è opera sottop