                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10263", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectCorporateBody.en", "label":"has subject corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10339", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfCollectiveAgent.en", "label":"is description of collective agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10612", "lexicalAlias":"http://rdaregistry.info/Elements/w/metadataDescriptionOfCorporateBody.en", "label":"is metadata description of corporate body"},{"@id":"http://rdaregistry.info/Elements/w/object/P10326", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/descriptionOfCorporateBody.en", "label":"is description of corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10326", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/descriptionOfCorporateBody.en", "label":"is description of corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10085","label":{"ar":"هو معالج كعمل برنامج تليفزيوني","ca":"és adaptat com a obra de programa de televisió","cs":"je adaptováno jako televizní program (dílo)","da":"er bearbejdet til tv-programværk","de":"ist bearbeitet als Fernsehsendung (Werk)","de":"ist bearbeitet als Fernsehsendung (Werk)","el":"είναι προσαρμοσμένο ως τηλεοπτικό πρόγραμμα (έργο)","en":"is adapted as television program work","es":"es adaptada como obra de programa de televisión","et":"adapteeritud telesaatena (teos)","fi":"televisiosovitus (teos)","fr":"est adapté en émission de télévision (œuvre)","hu":"tévéműsormű-feldolgozása a következő:","it":"è adattata come opera in fo