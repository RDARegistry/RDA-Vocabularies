                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10483", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorCollectiveAgent.en", "label":"has author collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10255", "lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurAgent.en", "label":"has rapporteur agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10526", "lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurCorporateBody.en", "label":"has rapporteur corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10573", "lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurFamily.en", "label":"has rapporteur family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10479", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/rapporteurCollectiveAgent.en", "label":"has rapporteur collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10479", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/rapporteurCollectiveAgent.en", "label":"has rapporteur collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10526","label":{"ar":"له هيئة مقررة","ca":"té com a entitat corporativa relatora","cs":"má reportéra (korporaci)","da":"har korporation, som er rapportør","de":"hat Berichterstatterin/Berichterstatter (Körperschaft)","de":"hat Berichterstatterin/Berichterstatter (Körperschaft)","en":"has rapporteur corporate body","es":"tiene cuerpo corporativo relator","et":"aruande koostaja (asutus)","fi":"kokousten raportoija (yhteisö)","fr":"a pour collectivité rapporteuse","hu":"raportőr testülete a következő:","it":"ha come relatore ente","lv":"ziņotājs (institūcija)","nl":"heeft rapporteur-corporatie","no":"har rapportør (korporasjon)","tr":"raportör tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有会务报告人团体"},"definition":{"ar":["يربط بين عمل وهيئة تكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها."],"ca":["Relaciona una obra amb una entitat corporativa que és un autor que és nomenat per una organització per redactar les actes de les seves reunions."],"cs":["Vztahuje dílo ke korporaci, která je autorem, pověřeným organizací, aby podával zprávy o průběhu jejích jednání."],"da":["Relaterer et værk til en korporation, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten."],"en":["Relates a work to a corporate body who is an author who is appointed by an organization to report on the proceedings of its meetings."],"es":["Relaciona una obra con un cuerpo corporativo que es un autor que es designado por una organización para informar sobre los procedimientos de sus reuniones."],"et":["Seostab teose asutusega, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama."],"fi":["Liittää teoksen yhteisöön, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä."],"fr":["Met une œuvre en relation avec une collectivité autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions."],"hu":["Hozzákapcsol egy művet egy szerző testülethez, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról."],"it":["Correla un'opera a un ente autore incaricato da un'organizzazione di compilare rapporti sugli atti dei suoi incontri."],"lv":["Sasaista darbu ar institūciju - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem."],"nl":["Relateert een werk aan een corporatie die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten."],"no":["Relaterer et verk til en korporasjon som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter."],"tr":["Bir eseri, bir kuruluş tarafından toplantılarının işleyişi hakkında rapor vermek üzere atanan bir yazar olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个著者并被一个组织指定为报告会议记录的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مقررة","ca":"entitat corporativa relatora","cs":"reportér (korporace)","da":"korporation, som er rapportør","de":"Berichterstatterin/Berichterstatter (Körperschaft)","de":"Berichterstatterin/Berichterstatter (Körperschaft)","en":"rapporteur corporate body","es":"cuerpo corporativo relator","et":"aruande koostaja (asutus)","fi":"kokousten raportoija (yhteisö)","fr":"collectivité rapporteuse","hu":"raportőr testület:","it":"relatore ente","lv":"ziņotājs (institūcija)","nl":"rapporteur-corporatie","no":"rapportør (korporasjon)","tr":"raportör tüzel kişilik","zh-Hans-CN":"会务报告人团体"},"ToolkitDefinition":{"ar":"هيئة تكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.","ca":"Entitat corporativa que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.","cs":"Korporace, která je autorem, pověřeným organizací, aby podával zprávy o průběhu jejích jednání.","da":"Korporation, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.","de":"Eine Verfasserin/Ein Verfasser (Körperschaft), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.","de":"Eine Verfasserin/Ein Verfasser (Körperschaft), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.","en":"A corporate body who is an author who is appointed by an organization to report on the proceedings of its meetings.","es":"Un cuerpo corporativo que es un autor que es designado por una organización para informar sobre los procedimientos de sus reuniones.","et":"Asutus, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.","fi":"Yhteisö, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.","fr":"Collectivité autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions.","hu":"Egy szerző testület, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról.","it":"Ente autore incaricato da un'organizzazione di compilare rapporti sugli atti dei suoi incontri.","lv":"Institūcija - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.","nl":"Een corporatie die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.","no":"En korporasjon som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.","tr":"Bir kuruluş tarafından toplantılarının tutanakları hakkında rapor vermek üzere atanan yazar olan bir tüzel kişi.","zh-Hans-CN":"作为一个著者并被一个组织指定为报告会议记录的一个团体"},"note":{"ar":["تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات."],"ca":["S’exclou la responsabilitat que es limita a prendre notes."],"cs":["Odpovědnost omezená na pořizování zápisu je vyloučena."],"da":["Omfatter ikke ansvar begrænset til at tage referat."],"de":["Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.,Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt."],"en":["Responsibility limited to taking minutes is excluded."],"es":["Se excluye la responsabilidad limitada a levantar minutas."],"et":["Ei hõlma vastutust, mis o