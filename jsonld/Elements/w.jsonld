                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10291", "lexicalAlias":"http://rdaregistry.info/Elements/w/inspirationFor.en", "label":"is inspiration for"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/issue.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10410", "lexicalAlias":"http://rdaregistry.info/Elements/w/specialIssue.en", "label":"has special issue"},{"@id":"http://rdaregistry.info/Elements/w/object/P10141", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/issue.en", "label":"has issue"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10141", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/issue.en", "label":"has issue"}]},{"@id":"http://rdaregistry.info/Elements/w/P10102","label":{"ar":"هو إصدارة لـ","ca":"és número de","cs":"je číslem (čeho)","da":"er udgivelse af","de":"ist Ausgabe von","de":"ist Ausgabe von","el":"είναι στη σειρά","en":"is issue of","es":"es ejemplar de","et":"number seerias","fi":"numero teoksessa","fr":"est une livraison de","hu":"száma a következőnek:","it":"è fascicolo di","lv":"ir laidiens","nl":"is aflevering van","no":"er hefte i","tr":"sayısıdır","vi":"trong tùng thư","zh-Hans-CN":"是……的期"},"definition":{"ar":["يربط عمل بعمل تجميعي متتالٍ يلهِم السياسة التحريرية، والمجال، والأسلوب لعمل ثابت."],"ca":["Relaciona una obra amb una obra que és una obra agregadora successiva que inspira la política editorial, l’abast i l’estil d’una obra estàtica."],"cs":["Vztahuje dílo k dílu, které je postupně vydávaným agregačním dílem, inspirujícím celkovou redakční politiku, zaměření a styl statického díla."],"da":["Relaterer et værk til et værk, som er et fortløbende aggregerende værk, som inspirerer den redaktionelle retningslinje, rækkevid