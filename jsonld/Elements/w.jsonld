                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerCollectiveAgentOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10057", "lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerAgentOfWork.en", "label":"has interviewer agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10540", "lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerCorporateBodyOfWork.en", "label":"has interviewer corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10587", "lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerFamilyOfWork.en", "label":"has interviewer family of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10493", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/interviewerCollectiveAgentOfWork.en", "label":"has interviewer collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10493", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/interviewerCollectiveAgentOfWork.en", "label":"has interviewer collective agent of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10540","label":{"ar":"له هيئة محاورة لعمل","ca":"té com a entitat corporativa entrevistadora d’una obra","cs":"má tazatele díla (korporaci)","da":"har korporation, som er interviewer for værk","de":"hat Interviewerin/Interviewer eines Werks (Körperschaft)","de":"hat Interviewerin/Interviewer eines Werks (Körperschaft)","en":"has interviewer corporate body of work","es":"tiene cuerpo corporativo entrevistador de obra","et":"teose intervjueerija (asutus)","fi":"teoksen haastattelija (yhteisö)","fr":"a pour collectivité intervieweuse d’une œuvre","hu":"mű interjúkészítő testülete a következő:","it":"ha come intervistatore ente di opera","lv":"darbā intervējis (institūcija)","nl":"heeft interviewer-corporatie van werk","no":"har intervjuer (korporasjon)","tr":"eserin görüşmeci tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有作品的采访者团体"},"definition":{"ar":["يربط بين عمل وهيئة مسئولة عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو منظم استطلاعات الرأي، أو أي نوع آخر من الهيئات التي تجمع المعلومات."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus d’entitat corporativa que recull informació."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za vytvoření díla tím, že působí jako tazatel, zpravodaj, korporace provádějící průzkum veřejného mínění nebo jiná korporace, která shromažďuje informace."],"da":["Relaterer et værk til en korporation, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for korporation, som indsamler information."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Körperschaft Informationen zusammenträgt.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Körperschaft Informationen zusammenträgt."],"en":["Relates a work to a corporate body who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of corporate body who gathers information."],"es":["Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra actuando como entrevistador, reportero, encuestador o algún otro tipo de entidad corporativa que recopila información."],"et":["Seostab teose asutusega, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva asutusena."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre collectivité recueillant de l’information."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő testületként cselekszik."],"it":["Correla un'opera a un ente responsabile della creazione di un'opera che agisce come intervistatore, reporter, sondaggista o altro genere di ente che raccoglie informazioni."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon."],"tr":["Bir eseri, bir görüşmeci, muhabir, anketör veya bilgi toplayan başka bir türde tüzel kişi olarak hareket ederek bir eser oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集团体而对一种作品的创作负责的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة محاورة لعمل","ca":"entitat corporativa entrevistadora d’una obra","cs":"tazatel díla (korporace)","da":"korporation, som er interviewer for værk","de":"Interviewerin/Interviewer eines Werks (Körperschaft)","de":"Interviewerin/Interviewer eines Werks (Körperschaft)","en":"interviewer corporate body of work","es":"cuerpo corporativo entrevistador de obra","et":"teose intervjueerija (asutus)","fi":"teoksen haastattelija (yhteisö)","fr":"collectivité intervieweuse d’une œuvre","hu":"mű interjúkészítő testülete:","it":"intervistatore ente di opera","lv":"darbā intervējis (institūcija)","nl":"interviewer-corporatie van werk","no":"intervjuer (korporasjon)","tr":"eserin görüşmeci tüzel kişisi ile ilişkilidir","zh-Hans-CN":"作品的采访者团体"},"ToolkitDefinition":{"ar":"هيئة مسئولة عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو منظم استطلاعات الرأي، أو أي نوع آخر من الهيئات التي تجمع المعلومات.","ca":"Entitat corporativa que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus d’entitat corporativa que recull informació.","cs":"která je odpovědná za vytvoření díla tím, že působí jako tazatel, zpravodaj, korporace provádějící průzkum veřejného mínění nebo jiná korporace, která shromažďuje informace.","da":"Korporation, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for korporation, som indsamler information.","de":"Eine Körperschaft, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Körperschaft Informationen zusammenträgt.","de":"Eine Körperschaft, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Körperschaft Informationen zusammenträgt.","en":"A corporate body who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of corporate body who gathers information.","es":"Un cuerpo corporativo que es responsable de crear una obra actuando como entrevistador, reportero, encuestador o algún otro tipo de entidad corporativa que recopila información.","et":"Asutus, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva asutusena.","fi":"Yhteisö, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.","fr":"Collectivité qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre collectivité recueillant de l’information.","hu":"Egy testület, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő testületként cselekszik.","it":"Ente responsabile della creazione di un'opera che agisce come intervistatore, reporter, sondaggista o altro genere di ente che raccoglie informazioni.","lv":"Institūcija, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.","nl":"Een corporatie die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.","no":"En korporasjon som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.","tr":"Bir görüşmeci, muhabir, anketör veya bilgi toplayan başka tür bir tüzel kişi olarak hareket ederek bir çalışma oluşturmaktan sorumlu bir tüzel kişi.","zh-Hans-CN":"通过担当采访者、记者、民意调查员或其他类型信息搜集团体而对一种作品的创作负责的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
