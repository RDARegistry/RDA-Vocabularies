                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/cartographerPersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10052", "lexicalAlias":"http://rdaregistry.info/Elements/w/cartographerAgentOfWork.en", "label":"has cartographer agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10435", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/cartographerPersonOfWork.en", "label":"has cartographer person of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10435", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/cartographerPersonOfWork.en", "label":"has cartographer person of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10305","label":{"ar":"له وكيل مدير طاقم تمثيل","ca":"té com a agent director de càsting","cs":"má castingového režiséra (agenta)","da":"har agent, som er caster","de":"hat Casting Director (Akteur)","de":"hat Casting Director (Akteur)","el":"έχει υπεύθυνο διανομής ρόλων","en":"has casting director agent","es":"tiene agente director de casting","et":"casting'u juht (tegija)","fi":"roolittaja (toimija)","fr":"a pour agent directeur de casting","hu":"szereposztó rendező ágense a következő:","it":"ha come direttore del casting agente","lv":"aktieru atlases režisors (aģents)","nl":"heeft castingdirector-actor","no":"har casting director (agent)","tr":"kast yönetmeni temsilcisi ile ilişkilidir","vi":"có giám đốc phân vai","zh-Hans-CN":"有角色导演行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن معظم جوانب تخصيص الأدوار والواجبات للمؤدين."],"ca":["Relaciona una obra amb un agent que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za většinu aspektů přidělování rolí a úkolů účinkujícím."],"da":["Relaterer et værk til en agent, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τις περισσότερες πτυχές της κατανομής ρόλων και αρμοδιοτήτων στους εκτελεστές."],"en":["Relates a work to an agent who is responsible for most aspects of assigning parts and duties to performers."],"es":["Relaciona una obra con un agente que es responsable de la mayoría de los aspectos de la asignación de partes y deberes a los intérpretes."],"et":["Seostab teose tegijaga, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel."],"fi":["Liittää teoksen toimijaan, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért."],"it":["Correla un’opera a un agente responsabile per la maggior parte degli aspetti della assegnazione di parti e compiti agli interpreti."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par lomu sadali un pienākumu piešķiršanu izpildītājiem."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders."],"no":["Relaterer et verk til en agent som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere."],"tr":["Bir eseri, sanatçılara rol ve görev verilmesinin tüm yönlerinden sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm về phần lớn khía cạnh được gán cho phần hoặc nhiệm vụ của những người biểu diễn."],"zh-Hans-CN":["将一种作品与负责给演员分配角色和任务的大多数工作的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مدير طاقم تمثيل","ca":"agent director de càsting","cs":"castingový režisér (agent)","da":"agent, som er caster","de":"Casting Director (Akteur)","de":"Casting Director (Akteur)","el":"υπεύθυνος διανομής ρόλων","en":"casting director agent","es":"agente director de casting","et":"casting'u juht (tegija)","fi":"roolittaja (toimija)","fr":"agent directeur de casting","hu":"szereposztó rendező ágens:","it":"direttore del casting agente","lv":"aktieru atlases režisors (aģents)","nl":"castingdirector-actor","no":"casting director (agent)","tr":"kast yönetmeni temsilcisi","vi":"giám đốc phân vai","zh-Hans-CN":"角色导演行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن معظم جوانب تحديد الأدوار والواجبات للمؤدين.","ca":"Agent que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets.","cs":"Agent, který je odpovědný za většinu aspektů přidělování rolí a úkolů účinkujícím.","da":"Agent, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere.","de":"Ein Akteur, der für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.","de":"Ein Akteur, der für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τις περισσότερες πτυχές της κατανομής ρόλων και αρμοδιοτήτων στους εκτελεστές.","en":"An agent who is responsible for most aspects of assigning parts and duties to performers.","es":"Un agente que es responsable de la mayoría de los aspectos de la asignación de partes y deberes a los intérpretes.","et":"Tegija, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel.","fi":"Toimija, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.","fr":"Agent qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.","hu":"Egy ágens, amely felelős a szereposztás és feladatok előadókra osztásának legtöbb vonatkozásáért.","it":"Agente responsabile per la maggior parte degli aspetti della assegnazione di parti e compiti agli interpreti.","lv":"Aģents, kas ir atbildīgs par lomu sadali un pienākumu piešķiršanu izpildītājiem.","nl":"Een actor die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.","no":"En agent som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere.","tr":"Sanatçılara rol ve görev atamanın çoğu yönünden sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm về phần lớn khía cạnh được gán cho phần hoặc nhiệm vụ của những người biểu diễn.","zh-Hans-CN":"负责给演员分配角色和任务的大多数工作的一个行为者"},"altLabel":{"ar":["مدير طاقم تمثيل"],"ca":["director de càsting"],"da":["casting director"],"de":["Casting Director,Casting Director"],"en":["casting director"],"es":["director de casting"],"et":["casting'u juht"],"fi":["roolittaja"],"fr":["directeur de casting"],"hu":["szereposztó rendező:"],"it":["direttore del casting"],"no":["casting director"],"tr":["kast yönetmeni"],"zh-Hans-CN":["角色导演"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
