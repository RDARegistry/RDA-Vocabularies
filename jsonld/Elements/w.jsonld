                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en", "label":"is succeeded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/absorbedByWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10145", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/absorbedByWork.en", "label":"is absorbed by work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10145", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/absorbedByWork.en", "label":"is absorbed by work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10156","label":{"ar":"هو مسبوق بعمل","ca":"és precedit d’una obra","cs":"je předcházeno dílem","da":"er forudgået af","de":"ist vorangegangen ist (Werk)","de":"ist vorangegangen ist (Werk)","el":"προηγείται από (έργο)","en":"is preceded by work","es":"es precedida por obra","et":"eelnev teos","fi":"edeltävä teos","fr":"est précédé d’une œuvre","hu":"megelőzi a következő mű:","it":"è preceduta da opera","lv":"darba agrāki notikumi","nl":"is voorafgegaan door werk","no":"etterfølger verk","tr":"eseri takip eder","vi":"được đi trước bởi (tác phẩm)","zh-Hans-CN":"被作品作为先前"},"definition":{"ar":["يربط عمل بعمل تكون تغطيته الزمنية قبل التغطية الخاصة بعمل آخر."],"ca":["Relaciona una obra amb una obra la cobertura cronològica de la qual és anterior a la d’una altra obra."],"cs":["Vztahuje dílo k dílu, jehož chronologické pokrytí předchází chronologickému pokrytí jiného díla."],"da":["Relaterer et værk til et værk, der går forud for det efterfølgende værk, fx på et tidligere tidspunkt eller før noget i en fortælling."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen zeitliches Geschehen vor dem eines anderen Werks liegt.,Setzt ein Werk in Beziehung zu einem Werk, dessen zeitliches Geschehen vor dem eines anderen Werks liegt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο προηγείται, δηλαδή είναι προγενέστερο χρονικά ή αφηγηματικά κ.λπ. ενός έργου που ακολουθεί."],"en":["Relates a work to a work whose chronological coverage is before that of another work."],"es":["Relaciona una obra con una obra cuya cobertura cronológica es anterior a la de otra obra."],"et":["Seostab teose teosega, mille kronoloogiline ulatus on varasem kui teisel teosel."],"fi":["Liittää teoksen teokseen, jonka kronologinen kattavuus on varhaisempi kuin toisella teoksella."],"fr":["Met une œuvre en relation avec une œuvre dont la couverture chronologique est antérieure à celle d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely kronológiai narratívában megelőz egy rákövetkező művet."],"it":["Correla un’opera a un’opera la cui copertura cronologica è precedente a quella di un’altra opera."],"lv":["Sasaista darbu ar darbu, kas ievada tālāk sekojošo darbu, piemēram, ir agrāks laika ziņā vai notikumu ziņā."],"nl":["Relateert een werk aan een werk waarvan het chronologisch bereik is voor dat van een ander werk."],"no":["Relaterer et verk til et verk som kommer før, enten i tid eller i historien, et påfølgende verk."],"tr":["Bir eseri, kronolojik kapsamı başka bir eserden önce olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đi trước, nghĩa là, là trước đây theo thời gian hoặc trước theo câu chuyện kể, v.v..., tác phẩm tiếp theo."],"zh-Hans-CN":["将一种作品与其时间覆盖面在另一种作品之前的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مسبوق بعمل","ca":"precedit d’una obra","cs":"předcházeno dílem","da":"forudgået af (værk)","de":"Vorangegangen ist (Werk)","de":"Vorangegangen ist (Werk)","el":"προηγείται από (έργο)","en":"preceded by work","es":"precedida por obra","et":"eelnev teos","fi":"edeltävä teos","fr":"précédé d’une œuvre","hu":"előzménymű:","it":"preceduta da opera","lv":"darbs: agrāki notikumi","nl":"voorafgegaan door werk","no":"etterfølger verk","tr":"Eserden önceki","vi":"được đi trước bởi (tác phẩm)","zh-Hans-CN":"被作品作为先前"},"ToolkitDefinition":{"ar":"عمل تكون تغطيته الزمنية قبل التغطية الخاصة بعمل آخر.","ca":"Obra la cobertura cronològica de la qual és anterior a la d’una altra obra.","cs":"Dílo, jehož chronologické pokrytí předchází chronologickému pokrytí jiného díla.","da":"Værk, der går forud for det efterfølgende værk, fx på et tidligere tidspunkt eller før noget i en fortælling.","de":"Ein Werk, dessen zeitliches Geschehen vor dem eines anderen Werks liegt.","de":"Ein Werk, dessen zeitliches Geschehen vor dem eines anderen Werks liegt.","el":"Ένα έργο το οποίο προηγείται, δηλαδή είναι προγενέστερο χρονικά ή αφηγηματικά κ.λπ. ενός έργου που ακολουθεί.","en":"A work whose chronological coverage is before that of another work.","es":"Una obra cuya cobertura cronológica es anterior a la de otra obra.","et":"Teos, mille kronoloogiline ulatus on varasem kui teisel teosel.","fi":"Teos, jonka kronologinen kattavuus on varhaisempi kuin toisella teoksella.","fr":"Œuvre dont la couverture chronologique est antérieure à celle d’une autre œuvre.","hu":"Egy mű, amely kronológiai narratívában megelőz egy rákövetkező művet.","it":"Opera la cui copertura cronologica è precedente a quella di un’altra opera.","lv":"Darbs, kas ievada tālāk sekojošo darbu, piemēram, ir agrāks laika ziņā vai notikumu ziņā.","nl":"Een werk waarvan het chronologisch bereik is voor dat van een ander werk.","no":"Et verk som kommer før, enten i tid eller i historien, et påfølgende verk.","tr":"Kronolojik kapsamı başka bir eserin kronololik kapsamından önce olan eser.","vi":"Tác phẩm đi trước, nghĩa là, là trước đây theo thời gian hoặc trước theo câu chuyện kể, v.v..., tác phẩm tiếp theo.","zh-Hans-CN":"其时间覆盖面在另一种作品之前的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
