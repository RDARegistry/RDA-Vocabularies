                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10058", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistAgent.en", "label":"has artist agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10475", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistCollectiveAgent.en", "label":"has book artist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10428", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistPerson.en", "label":"has book artist person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10254", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/bookArtistAgent.en", "label":"has book artist agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10254", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/bookArtistAgent.en", "label":"has book artist agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10475","label":{"ar":"له وكيل جماعي فنان كتب","ca":"té com a agent col·lectiu artista de llibre d’art","cs":"má knižního výtvarníka (kolektivního agenta)","da":"har kollektiv agent, som er bogkunstner","de":"hat Buchkünstlerin/Buchkünstler (Gemeinschaftlicher Akteur)","de":"hat Buchkünstlerin/Buchkünstler (Gemeinschaftlicher Akteur)","en":"has book artist collective agent","es":"tiene agente colectivo artista del libro","et":"raamatukunstnik (kollektiiv)","fi":"kirjataiteilija (yhteistoimija)","fr":"a pour agent collectif artiste du livre","hu":"könyvművész kollektív ágense a következő:","it":"ha come book artist agente collettivo","lv":"grāmatu mākslinieks (grupa)","nl":"heeft boekkunstenaar-collectieve actor","no":"har bokkunstner (kollektiv agent)","tr":"kitap sanatçısı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有图书美术家集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي يكون فنانا مسئولاً عن استغلال شكل الكتاب أو تغيير هيكله المادي."],"ca":["Relaciona una obra amb un agent col·lectiu que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je umělcem, který je odpovědný za zpracování podoby knihy nebo změnu její fyzické struktury."],"da":["Relaterer et værk til en kollektiv agent, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physische Struktur verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physische Struktur verantwortlich ist."],"en":["Relates a work to a collective agent who is an artist who is responsible for exploiting the book form or altering its physical structure."],"es":["Relaciona una obra con un agente colectivo que es un artista que se encarga de explotar la forma del libro o alterar su estructura física."],"et":["Seostab teose kollektiiviga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest."],"fi":["Liittää teoksen yhteistoimijaan, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta."],"fr":["Met une œuvre en relation avec un agent collectif artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique."],"hu":["Hozzákapcsol egy művet egy művész kollektív ágenshez, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért."],"it":["Correla un'opera all'agente collettivo artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica."],"lv":["Sasaista darbu ar grupu, kas atbild par grāmatas kā mākslas darba radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru."],"nl":["Relateert een werk aan een collectieve actor die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur."],"no":["Relaterer et verk til en kollektiv agent som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur."],"tr":["Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu bir sanatçı olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فنان كتب","ca":"agent col·lectiu artista de llibre d’art","cs":"knižní výtvarník (kolektivní agent)","da":"kollektiv agent, som er bogkunstner","de":"Buchkünstlerin/Buchkünstler (Gemeinschaftlicher Akteur)","de":"Buchkünstlerin/Buchkünstler (Gemeinschaftlicher Akteur)","en":"book artist collective agent","es":"agente colectivo artista del libro","et":"raamatukunstnik (kollektiiv)","fi":"kirjataiteilija (yhteistoimija)","fr":"agent collectif artiste du livre","hu":"könyvművész kollektív ágens:","it":"book artist agente collettivo","lv":"grāmatu mākslinieks (grupa)","nl":"boekkunstenaar-collectieve actor","no":"bokkunstner (kollektiv agent)","tr":"kitap sanatçısı kolektif temsilcisi","zh-Hans-CN":"图书美术家集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون فنانا مسئولاً عن استغلال شكل الكتاب أو تغيير هيكله المادي.","ca":"Agent col·lectiu que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.","cs":"Kolektivní agent, který je odpovědný za zpracování podoby knihy nebo změnu její fyzické struktury.","da":"Kollektiv agent, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.","de":"Eine Künstlerin/Ein Künstler (Gemeinschaftlicher Akteur), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physische Struktur verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Gemeinschaftlicher Akteur), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physische Struktur verantwortlich ist.","en":"A collective agent who is an artist who is responsible for exploiting the book form or altering its physical structure.","es":"Un agente colectivo que es un artista que se encarga de explotar la forma del libro o alterar su estructura física.","et":"Kollektiiv, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.","fi":"Yhteistoimija, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.","fr":"Agent collectif artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.","hu":"Egy művész kollektív ágens, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.","it":"Agente collettivo artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica.","lv":"Grupa, kas atbild par grāmatas kā mākslas darba radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.","nl":"Een collectieve actor die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.","no":"En kollektiv agent som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.","tr":"Kitap formunu kullanmak veya fiziksel yapısını değiştirmekten sorumlu olan bir sanatçı olarak bir kolektif temsilci.","zh-Hans-CN":"作为一个艺术家负责开发图书外形或改变其物理结构的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
