                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/compilerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10055", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerAgent.en", "label":"has compiler agent"},{"@id":"http://rdaregistry.info/Elements/w/P10448", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorPerson.en", "label":"has aggregator person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10638", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectionRegistrarPerson.en", "label":"has collection registrar person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10444", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/compilerPerson.en", "label":"has compiler person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10444", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/compilerPerson.en", "label":"has compiler person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10053","label":{"ar":"له وكيل ملحن لعمل","ca":"té com a agent compositor d’una obra","cs":"má skladatele díla (agenta)","da":"har agent, som er komponist af værk","de":"hat Komponistin/Komponisten eines Werks (Akteur)","de":"hat Komponistin/Komponisten eines Werks (Akteur)","el":"έχει συνθέτη","en":"has composer agent of work","es":"tiene agente compositor de obra","et":"teose helilooja (tegija)","fi":"teoksen säveltäjä (toimija)","fr":"a pour agent compositeur d’une œuvre","hu":"mű zeneszerző ágense a következő:","it":"ha come compositore agente di opera","lv":"darba komponists (aģents)","nl":"heeft componist-actor van werk","no":"har komponist for verk (agent)","tr":"eserin besteci temsilcisi ile ilişkilidir","vi":"có người soạn","zh-Hans-CN":"有作品的作曲者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسؤول عن إنشاء عمل موسيقي."],"ca":["Relaciona una obra amb un agent que és responsable de la creació d’una obra musical."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za vytvoření hudebního díla."],"da":["Relaterer et værk til en agent, som er ansvarlig for at skabe et musikværk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Musikwerks verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός μουσικού έργου."],"en":["Relates a work to an agent who is responsible for creating a musical work."],"es":["Relaciona una obra con un agente que es responsable de crear una obra musical."],"et":["Seostab teose tegijaga, kes vastutab muusikateose loomise eest."],"fi":["Liittää teoksen toimijaan, joka on vastuussa musiikkiteoksen luomisesta."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy zenemű megalkotásáért."],"it":["Correla un'opera a un agente responsabile della creazione di un'opera musicale."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par mūzikas darba radīšanu."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een muziekwerk."],"no":["Relaterer et verk til en agent som er ansvarlig for å skape et musikalsk verk."],"tr":["Bir eseri, müzik eseri oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm âm nhạc."],"zh-Hans-CN":["将一种作品与负责创作一种音乐作品的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل ملحن عمل","ca":"agent compositor d’una obra","cs":"skladatel díla (agent)","da":"agent, som er komponist af værk","de":"Komponistin/Komponist eines Werks (Akteur)","de":"Komponistin/Komponist eines Werks (Akteur)","el":"συνθέτης","en":"composer agent of work","es":"agente compositor de obra","et":"teose helilooja (tegija)","fi":"teoksen säveltäjä (toimija)","fr":"agent compositeur d’une œuvre","hu":"mű zeneszerző ágense:","it":"compositore agente di opera","lv":"darba komponists (aģents)","nl":"componist-actor van werk","no":"komponist for verk (agent)","tr":"eserin besteci temsilcisi","vi":"người soạn","zh-Hans-CN":"作品的作曲者行为者"},"ToolkitDefinition":{"ar":"وكيل مسؤول عن إنشاء عمل موسيقي.","ca":"Agent que és responsable de la creació d’una obra musical.","cs":"Agent, který je odpovědný za vytvoření hudebního díla.","da":"Agent, som er ansvarlig for at skabe et musikværk.","de":"Ein Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.","de":"Ein Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τη δημιουργία ενός μουσικού έργου.","en":"An agent who is responsible for creating a musical work.","es":"Un agente que es responsable de crear una obra musical.","et":"Tegija, kes vastutab muusikateose loomise eest.","fi":"Toimija, joka on vastuussa musiikkiteoksen luomisesta.","fr":"Agent qui est responsable de la création d’une œuvre musicale.","hu":"Egy ágens, amely felelős egy mű létrehozásáért.","it":"Agente responsabile della creazione di un'opera musicale.","lv":"Aģents, kas ir atbildīgs par mūzikas darba radīšanu.","nl":"Een actor die verantwoordelijk is voor het creëren van een muziekwerk.","no":"En agent som er ansvarlig for å skape et musikalsk verk.","tr":"Bir müzik eserinin oluşturulmasından sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm tạo lập tác phẩm âm nhạc.","zh-Hans-CN":"负责创作一种音乐作品的一个行为者"},"note":{"ar":["يتم تضمين تكييف عمل موسيقي آخر لتشكيل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل يعتمد على موسيقى ملحن آخر."],"ca":["Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor."],"cs":["Zahrnuje adaptaci jiného hudebního díla za účelem vytvoření odlišné alterace, parafrázování díla nebo vytvoření díla v obecném stylu jiného skladatele, nebo vytvoření díla založeného na hudbě jiného skladatele."],"da":["Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet."],"de":["Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.,Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren."],"el":["Περιλαμβάνεται η προσαρμογή ενός άλλου μουσικού έργου για να αποτελέσει μια διακριτή μεταβολή, η παράφραση ενός έργου ή η δημιουργία ενός έργου στο γενικό ύφος ενός άλλου συνθέτη ή η δημιουργία ενός έργου που βασίζεται στη μουσική ενός άλλου συνθέτη."],"en":["Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included."],"es":["La adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra al estilo general de otro compositor, o crear una obra que está basada en la música de otro compositor, se incluye."],"et":["Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist."],"fi":["Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen."],"fr":["Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus."],"hu":["Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul."],"it":["E’ incluso l’adattamento di un’altra opera musicale per costituire una variazione distinta, tramite la parafrasi o la creazione di un’opera nello stile tipico di un altro compositore o tramite la creazione di un’opera basata sulla musica di un altro compositore"],"lv":["Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku."],"nl":["Bewerking van een ander muziekwerk om een onderscheidende wijziging te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen."],"no":["Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert."],"tr":["Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir."],"vi":["Phỏng theo tác phẩm âm nhạc khác thành hình thái sửa đổi riêng, diễn giải tác phẩm hoặc tạo lập tác phẩm với phong cách chung của người soạn khác, hoặc tạo lập tác phẩm dựa trên âm nhạc của người soạn khác, được bao gồm."],"zh-Hans-CN":["包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。"]},"altLabel":{"ar":["ملحن"],"ca":["compositor"],"cs":["skladatel"],"da":["komponist af værk"],"de":["Komponist,Komponist"],"en":["composer"],"es":["compositor"],"et":["teose helilooja"],"fi":["teoksen säveltäjä"],"fr":["compositeur"],"hu":["zeneszerző:"],"it":["compositore di opera"],"nl":["componist"],"no":["komponist for verk"],"tr":["besteci"],"zh-Hans-CN":["作曲者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/composerAgentOfWork.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10489", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerCollectiveAgentOfWork.en", "label":"has composer collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10442", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerPersonOfWork.en", "label":"has composer person of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10053", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/composerAgentOfWork.en", "label":"has composer agent of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10053", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/composerAgentOfWork.en", "label":"has composer agent of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10489","label":{"ar":"له وكيل جماعي ملحن لعمل","ca":"té com a agent col·lectiu compositor d’una obra","cs":"má skladatele (kolektivního agenta)","da":"har kollektiv agent, som er komponist af værk","de":"hat Komponistin/Komponisten eines Werks (Gemeinschaftlicher Akteur)","de":"hat Komponistin/Komponisten eines Werks (Gemeinschaftlicher Akteur)","en":"has composer collective agent of work","es":"tiene agente colectivo compositor de obra","et":"teose helilooja (kollektiiv)","fi":"teoksen säveltäjä (yhteistoimija)","fr":"a pour agent collectif compositeur d’une œuvre","hu":"mű zeneszerző kollektív ágense a következő:","it":"ha come compositore agente collettivo di opera","lv":"darba komponists (grupa)","nl":"heeft componist-collectieve actor werk","no":"har komponist for verk (kollektiv agent)","tr":"eserin besteci kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有作品的作曲者集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل موسيقي."],"ca":["Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra musical."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je odpovědný za vytvoření hudebního díla."],"da":["Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et musikværk."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Musikwerks verantwortlich ist."],"en":["Relates a work to a collective agent who is responsible for creating a musical work."],"es":["Relaciona una obra con un agente colectivo que se encarga de crear una obra musical."],"et":["Seostab teose kollektiiviga, kes vastutab muusikateose loomise eest."],"fi":["Liittää teoksen yhteistoimijaan, joka on vastuussa musiikkiteoksen luomisesta."],"fr":["Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy zenemű létrehozásáért."],"it":["Correla un'opera all'agente collettivo responsabile della creazione di un'opera musicale."],"lv":["Sasaista darbu ar grupu, kas ir atbildīga par mūzikas darba radīšanu."],"nl":["Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een muziekwerk."],"no":["Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et musikalsk verk."],"tr":["Bir eseri, bir müzik eseri oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创作一种音乐作品的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي ملحن لعمل","ca":"agent col·lectiu compositor d’una obra","cs":"skladatel (kolektivní agent)","da":"kollektiv agent, som er komponist af værk","de":"Komponistin/Komponist eines Werks (Gemeinschaftlicher Akteur)","de":"Komponistin/Komponist eines Werks (Gemeinschaftlicher Akteur)","en":"composer collective agent of work","es":"agente colectivo compositor de obra","et":"teose helilooja (kollektiiv)","fi":"teoksen säveltäjä (yhteistoimija)","fr":"agent collectif compositeur d’une œuvre","hu":"mű zeneszerző kollektív ágense:","it":"compositore agente collettivo di opera","lv":"darba komponists (grupa)","nl":"componist-collectieve actor werk","no":"komponist for verk (kollektiv agent)","tr":"eserin besteci kolektif temsilcisi","zh-Hans-CN":"作品的作曲者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن إنشاء عمل موسيقي.","ca":"Agent col·lectiu que és responsable de la creació d’una obra musical.","cs":"Kolektivní agent, který je odpovědný za vytvoření hudebního díla.","da":"Kollektiv agent, som er ansvarlig for at skabe et musikværk.","de":"Ein gemeinschaftlicher Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.","de":"Ein gemeinschaftlicher Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.","en":"A collective agent who is responsible for creating a musical work.","es":"Un agente colectivo que se encarga de crear una obra musical.","et":"Kollektiiv, kes vastutab muusikateose loomise eest.","fi":"Yhteistoimija, joka on vastuussa musiikkiteoksen luomisesta.","fr":"Agent collectif qui est responsable de la création d’une œuvre musicale.","hu":"Egy kollektív ágens, amely felelős egy zenemű létrehozásáért.","it":"Agente collettivo responsabile della creazione di un'opera musicale.","lv":"Grupa, kas ir atbildīga par mūzikas darba radīšanu.","nl":"Een collectieve actor die verantwoordelijk is voor het creëren van een muziekwerk.","no":"En kollektiv agent som er ansvarlig for å skape et musikalsk verk.","tr":"Bir müzik eseri oluşturmakla sorumlu olan bir kolektif temsilci","zh-Hans-CN":"负责创作一种音乐作品的一个集体行为者"},"note":{"ar":["يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر."],"ca":["Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor."],"cs":["Zahrnuje adaptaci jiného hudebního díla za účelem vytvoření zřetelné alterace, parafrázování díla nebo vytvoření díla v obecném stylu jiného skladatele, nebo vytvoření díla založeného na hudbě jiného skladatele."],"da":["Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet."],"de":["Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.,Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren."],"en":["Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included."],"es":["Se incluye la adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra en el estilo general de otro compositor, o crear una obra que se base en la música de otro compositor."],"et":["Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist."],"fi":["Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen."],"fr":["Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus."],"hu":["Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul."],"it":["E' compreso l'adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un'opera o la creazione di un'opera nello stile tipico di un altro compositore, o tramite la creazione di un'opera basata sulla musica di un altro compositore."],"lv":["Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku."],"nl":["Bewerking van een ander muziekwerk om een onderscheidende wijziging te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen."],"no":["Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert."],"tr":["Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir."],"zh-Hans-CN":["包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创作一种新的作品、或者基于另一个作曲者的音乐创作一种新的作品。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/composerCollectiveAgentOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10053", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerAgentOfWork.en", "label":"has composer agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10536", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerCorporateBodyOfWork.en", "label":"has composer corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10583", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerFamilyOfWork.en", "label":"has composer family of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10489", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/composerCollectiveAgentOfWork.en", "label":"has composer collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10489", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/composerCollectiveAgentOfWork.en", "label":"has composer collective agent of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10536","label":{"ar":"له هيئة ملحنة عمل","ca":"té com a entitat corporativa compositora d’una obra","cs":"má skladatele díla (korporaci)","da":"har korporation, som er komponist af værk","de":"hat Komponistin/Komponisten eines Werks (Körperschaft)","de":"hat Komponistin/Komponisten eines Werks (Körperschaft)","en":"has composer corporate body of work","es":"tiene cuerpo corporativo compositor de obra","et":"teose helilooja (asutus)","fi":"teoksen säveltäjä (yhteisö)","fr":"a pour collectivité compositrice d’une œuvre","hu":"mű zeneszerző testülete a következő:","it":"ha come compositore di opera  ente","lv":"darba komponists (institūcija)","nl":"heeft componist-corporatie werk","no":"har komponist for verk (korporasjon)","tr":"eserin besteci tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有作品的作曲者团体"},"definition":{"ar":["يربط بين عمل وهيئة مسئولة عن إنشاء عمل موسيقي."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra musical."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za vytvoření hudebního díla."],"da":["Relaterer et værk til en korporation, som er ansvarlig for at skabe et musikværk."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Musikwerks verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Musikwerks verantwortlich ist."],"en":["Relates a work to a corporate body who is responsible for creating a musical work."],"es":["Relaciona una obra con un cuerpo corporativo que se encarga de crear una obra musical."],"et":["Seostab teose asutusega, kes vastutab muusikateose loomise eest."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa musiikkiteoksen luomisesta."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy zenemű létrehozásáért."],"it":["Correla un'opera a un ente responsabile della creazione di un'opera musicale."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par mūzikas darba radīšanu."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een muziekwerk."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for å skape et musikalsk verk."],"tr":["Bir eseri, bir müzik eseri yaratmaktan sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创建一种音乐作品的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة ملحنة عمل","ca":"entitat corporativa compositora d’una obra","cs":"skladatel díla (korporace)","da":"korporation, som er komponist af værk","de":"Komponistin/Komponist eines Werks (Körperschaft)","de":"Komponistin/Komponist eines Werks (Körperschaft)","en":"composer corporate body of work","es":"cuerpo corporativo compositor de obra","et":"teose helilooja (asutus)","fi":"teoksen säveltäjä (yhteisö)","fr":"collectivité compositrice d’une œuvre","hu":"mű zeneszerző testülete:","it":"compositore ente di opera","lv":"darba komponists (institūcija)","nl":"componist-corporatie werk","no":"komponist for verk (korporasjon)","tr":"eserin besteci tüzel kişisi","zh-Hans-CN":"作品的作曲者团体"},"ToolkitDefinition":{"ar":"هيئة مسئولة عن إنشاء عمل موسيقي.","ca":"Entitat corporativa que és responsable de la creació d’una obra musical.","cs":"Korporace, která je odpovědná za vytvoření hudebního díla.","da":"Korporation, som er ansvarlig for at skabe et musikværk.","de":"Eine Körperschaft, die für die Schaffung eines Musikwerks verantwortlich ist.","de":"Eine Körperschaft, die für die Schaffung eines Musikwerks verantwortlich ist.","en":"A corporate body who is responsible for creating a musical work.","es":"Un cuerpo corporativo que se encarga de crear una obra musical.","et":"Asutus, kes vastutab muusikateose loomise eest.","fi":"Yhteisö, joka on vastuussa musiikkiteoksen luomisesta.","fr":"Collectivité qui est responsable de la création d’une œuvre musicale.","hu":"Egy testület, amely felelős egy zenemű létrehozásáért.","it":"Ente responsabile della creazione di un'opera musicale.","lv":"Institūcija, kas ir atbildīga par mūzikas darba radīšanu.","nl":"Een corporatie die verantwoordelijk is voor het creëren van een muziekwerk.","no":"En korporasjon som er ansvarlig for å skape et musikalsk verk.","tr":"Bir müzik eseri yaratmaktan sorumlu bir tüzel kişi.","zh-Hans-CN":"负责创建一种音乐作品的一个团体"},"note":{"ar":["يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر."],"ca":["Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor."],"cs":["Zahrnuje adaptaci jiného hudebního díla za účelem vytvoření zřetelné alterace, parafrázování díla nebo vytvoření díla v obecném stylu jiného skladatele, nebo vytvoření díla založeného na hudbě jiného skladatele."],"da":["Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet."],"de":["Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.,Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren."],"en":["Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included."],"es":["Se incluye la adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra en el estilo general de otro compositor, o crear una obra que se base en la música de otro compositor."],"et":["Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist."],"fi":["Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen."],"fr":["Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus."],"hu":["Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul."],"it":["E' compreso l'adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un'opera o la creazione di un'opera nello stile tipico di un altro compositore, o tramite la creazione di un'opera basata sulla musica di un altro compositore."],"lv":["Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku."],"nl":["Bewerking van een ander muziekwerk om een onderscheidende wijziging te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen."],"no":["Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert."],"tr":["Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir."],"zh-Hans-CN":["包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创作一种新的作品、或者基于另一个作曲者的音乐创作一种新的作品。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/composerCorporateBodyOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10489", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerCollectiveAgentOfWork.en", "label":"has composer collective agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10536", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/composerCorporateBodyOfWork.en", "label":"has composer corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10536", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/composerCorporateBodyOfWork.en", "label":"has composer corporate body of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10583","label":{"ar":"له عائلة ملحنة لعمل","ca":"té com a família compositora d’una obra","cs":"má skladatele díla (rodinu)","da":"har familie, som er komponist af værk","de":"hat Komponistin/Komponisten eines Werks (Familie)","de":"hat Komponistin/Komponisten eines Werks (Familie)","en":"has composer family of work","es":"tiene familia compositora de obra","et":"teose helilooja (perekond)","fi":"teoksen säveltäjä (suku)","fr":"a pour famille compositrice d’une œuvre","hu":"mű zeneszerző családja a következő:","it":"ha come compositore famiglia di opera","lv":"darba komponists (dzimta/ģimene)","nl":"heeft componist-familie werk","no":"har komponist (familie)","tr":"eserin besteci ailesi ile ilişkilidir","zh-Hans-CN":"有作品的作曲者家族"},"definition":{"ar":["يربط بين عمل وعائلة مسئولة عن إنشاء عمل موسيقي."],"ca":["Relaciona una obra amb una família que és responsable de la creació d’una obra musical."],"cs":["Vztahuje dílo k rodině, která je odpovědná za vytvoření hudebního díla."],"da":["Relaterer et værk til en familie, som er ansvarlig for at skabe et musikværk."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Musikwerks verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Musikwerks verantwortlich ist."],"en":["Relates a work to a family who is responsible for creating a musical work."],"es":["Relaciona una obra con una familia que es responsable de crear una obra musical."],"et":["Seostab teose perekonnaga, kes vastutab muusikateose loomise eest."],"fi":["Liittää teoksen sukuun, joka on vastuussa musiikkiteoksen luomisesta."],"fr":["Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy családhoz, amely felelős egy zenemű létrehozásáért."],"it":["Correla un'opera alla famiglia responsabile della creazione di un'opera musicale."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par mūzikas darba radīšanu."],"nl":["Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een muziekwerk."],"no":["Relaterer et verk til en familie som er ansvarlig for å skape et musikalsk verk."],"tr":["Bir eseri, bir müzik çalışması oluşturmaktan sorumlu aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创作一种音乐作品的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة ملحنة لعمل","ca":"família compositora d’una obra","cs":"skladatel díla (rodina)","da":"familie, som er komponist af værk","de":"Komponistin/Komponist eines Werks (Familie)","de":"Komponistin/Komponist eines Werks (Familie)","en":"composer family of work","es":"familia compositora de obra","et":"teose helilooja (perekond)","fi":"teoksen säveltäjä (suku)","fr":"famille compositrice d’une œuvre","hu":"mű zeneszerző családja:","it":"compositore famiglia di opera","lv":"darba komponists (dzimta/ģimene)","nl":"componist-familie werk","no":"komponist (familie)","tr":"eserin besteci ailesi","zh-Hans-CN":"作品的作曲者家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن إنشاء عمل موسيقي.","ca":"Família que és responsable de la creació d’una obra musical.","cs":"Rodina, která je odpovědná za vytvoření hudebního díla.","da":"Familie, som er ansvarlig for at skabe et musikværk.","de":"Eine Familie, die für die Schaffung eines Musikwerks verantwortlich ist.","de":"Eine Familie, die für die Schaffung eines Musikwerks verantwortlich ist.","en":"A family who is responsible for creating a musical work.","es":"Una familia que es responsable de crear una obra musical.","et":"Perekond, kes vastutab muusikateose loomise eest.","fi":"Suku, joka on vastuussa musiikkiteoksen luomisesta.","fr":"Famille qui est responsable de la création d’une œuvre musicale.","hu":"Egy család, amely felelős egy zenemű létrehozásáért.","it":"Famiglia responsabile della creazione di un'opera musicale.","lv":"Dzimta/ģimene, kas ir atbildīga par mūzikas darba radīšanu.","nl":"Een familie die verantwoordelijk is voor het creëren van een muziekwerk.","no":"En familie som er ansvarlig for å skape et musikalsk verk.","tr":"Bir müzik eseri oluşturmaktan sorumlu bir aile.","zh-Hans-CN":"负责创作一种音乐作品的一个家族"},"note":{"ar":["يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر."],"ca":["Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor."],"cs":["Zahrnuje adaptaci jiného hudebního díla za účelem vytvoření odlišné alterace, parafrázování díla nebo vytvoření díla v obecném stylu jiného skladatele, nebo vytvoření díla založeného na hudbě jiného skladatele."],"da":["Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet."],"de":["Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.,Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren."],"en":["Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included."],"es":["La adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra al estilo general de otro compositor, o crear una obra que está basada en la música de otro compositor, se incluye."],"et":["Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist."],"fi":["Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen."],"fr":["Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus."],"hu":["Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul."],"it":["E' compreso l'adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un'opera o la creazione di un'opera nello stile tipico di un altro compositore, o tramite la creazione di un'opera basata sulla musica di un altro compositore."],"lv":["Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku."],"nl":["Bewerking van een ander muziekwerk om een onderscheidende wijziging te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen."],"no":["Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert."],"tr":["Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir."],"zh-Hans-CN":["包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创作一种新的作品、或者基于另一个作曲者的音乐创作一种新的作品。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/composerFamilyOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10578", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorFamilyOfWork.en", "label":"has creator family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10489", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerCollectiveAgentOfWork.en", "label":"has composer collective agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10583", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/composerFamilyOfWork.en", "label":"has composer family of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10583", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/composerFamilyOfWork.en", "label":"has composer family of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10442","label":{"ar":"له شخص ملحن لعمل","ca":"té com a persona compositora d’una obra","cs":"má skladatele díla (osobu)","da":"har person, som er komponist af værk","de":"hat Komponistin/Komponisten eines Werks (Person)","de":"hat Komponistin/Komponisten eines Werks (Person)","en":"has composer person of work","es":"tiene persona compositora de obra","et":"teose helilooja (isik)","fi":"teoksen säveltäjä (henkilö)","fr":"a pour personne compositrice d’une œuvre","hu":"mű zeneszerző személye a következő:","it":"ha come compositore persona di opera","lv":"darba komponists (persona)","nl":"heeft componist-persoon werk","no":"har komponist for verk (person)","tr":"eserin bestecisi ile ilişkilidir","zh-Hans-CN":"有作品的作曲者个人"},"definition":{"ar":["يربط بين عمل وشخص مسئول عن إنشاء عمل موسيقي."],"ca":["Relaciona una obra amb una persona que és responsable de la creació d’una obra musical."],"cs":["Vztahuje dílo k osobě, která je odpovědná za vytvoření hudebního díla."],"da":["Relaterer et værk til en person, som er ansvarlig for at skabe et musikværk."],"de":["Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Musikwerks verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Musikwerks verantwortlich ist."],"en":["Relates a work to a person who is responsible for creating a musical work."],"es":["Relaciona una obra con una persona que se encarga de crear una obra musical."],"et":["Seostab teose isikuga, kes vastutab muusikateose loomise eest."],"fi":["Liittää teoksen henkilöön, joka on vastuussa musiikkiteoksen luomisesta."],"fr":["Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy személyhez, aki felelős egy zenemű létrehozásáért."],"it":["Correla un'opera alla persona responsabile della creazione di un'opera musicale."],"lv":["Sasaista darbu ar personu, kura ir atbildīga par mūzikas darba radīšanu."],"nl":["Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een muziekwerk."],"no":["Relaterer et verk til en person som er ansvarlig for å skape et musikalsk verk."],"tr":["Bir eseri, bir müzik eseri oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创作一种音乐作品的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص ملحن لعمل","ca":"persona compositora d’una obra","cs":"skladatel díla (osoba)","da":"person, som er komponist af værk","de":"Komponistin/Komponist eines Werks (Person)","de":"Komponistin/Komponist eines Werks (Person)","en":"composer person of work","es":"persona compositora de obra","et":"teose helilooja (isik)","fi":"teoksen säveltäjä (henkilö)","fr":"personne compositrice d’une œuvre","hu":"mű zeneszerző személye:","it":"compositore persona di opera","lv":"darba komponists (persona)","nl":"componist-persoon werk","no":"komponist for verk (person)","tr":"eserin bestecisi","zh-Hans-CN":"作品的作曲者个人"},"ToolkitDefinition":{"ar":"شخص يكون مسئولاً عن إنشاء عمل موسيقي.","ca":"Persona que és responsable de la creació d’una obra musical.","cs":"Osoba, osobě, která je odpovědná za vytvoření hudebního díla.","da":"Person, som er ansvarlig for at skabe et musikværk.","de":"Eine Person, die für die Schaffung eines Musikwerks verantwortlich ist.","de":"Eine Person, die für die Schaffung eines Musikwerks verantwortlich ist.","en":"A person who is responsible for creating a musical work.","es":"Una persona que se encarga de crear una obra musical.","et":"Isik, kes vastutab muusikateose loomise eest.","fi":"Henkilö, joka on vastuussa musiikkiteoksen luomisesta.","fr":"Personne qui est responsable de la création d’une œuvre musicale.","hu":"Egy személy, aki felelős egy zenemű létrehozásáért.","it":"Persona responsabile della creazione di un'opera musicale.","lv":"Persona, kura ir atbildīga par mūzikas darba radīšanu.","nl":"Een persoon die verantwoordelijk is voor het creëren van een muziekwerk.","no":"En person som er ansvarlig for å skape et musikalsk verk.","tr":"Bir müzik eseri yaratmaktan sorumlu olan kişi.","zh-Hans-CN":"负责创作一种音乐作品的一个个人"},"note":{"ar":["يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر."],"ca":["Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor."],"cs":["Zahrnuje adaptaci jiného hudebního díla za účelem vytvoření odlišné alterace, parafrázování díla nebo vytvoření díla v obecném stylu jiného skladatele, nebo vytvoření díla založeného na hudbě jiného skladatele."],"da":["Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet."],"de":["Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.,Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren."],"en":["Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included."],"es":["Se incluye la adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra en el estilo general de otro compositor, o crear una obra que se base en la música de otro compositor."],"et":["Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist."],"fi":["Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen."],"fr":["Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus."],"hu":["Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul."],"it":["E' compreso l'adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un'opera o la creazione di un'opera nello stile tipico di un altro compositore, o la creazione di un'opera basata sulla musica di un altro compositore."],"lv":["Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku."],"nl":["Bewerking van een ander muziekwerk om een onderscheidende wijziging te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen."],"no":["Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert."],"tr":["Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir."],"zh-Hans-CN":["包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/composerPersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10053", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerAgentOfWork.en", "label":"has composer agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10442", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/composerPersonOfWork.en", "label":"has composer person of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10442", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/composerPersonOfWork.en", "label":"has composer person of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10071","label":{"ar":"له وكيل استشاري","ca":"té com a agent consultor","cs":"má konzultanta (agenta)","da":"har agent, som er rådgiver","de":"hat Beraterin/Berater (Akteur)","de":"hat Beraterin/Berater (Akteur)","el":"έχει σύμβουλο","en":"has consultant agent","es":"tiene agente consultor","et":"konsultant (tegija)","fi":"asiantuntija (toimija)","fr":"a pour agent consultant","hu":"tanácsadó ágense a következő:","it":"ha come consulente agente","lv":"konsultants (aģents)","nl":"heeft consultant-actor","no":"har konsulent (agent)","tr":"danışman temsilci ile ilişkilidir","vi":"có người tư vấn","zh-Hans-CN":"有顾问行为者"},"definition":{"ar":["يربط بين عمل ووكيل يقدم خدمات استشارية، وغالبا ما يقدم مقترحات، لوكيل ذي صلة يقدَّم على أنه منشئ لعمل."],"ca":["Relaciona una obra amb un agent que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra."],"cs":["Vztahuje dílo k agentovi, který poskytuje konzultační služby a často dává doporučení spřízněnému agentovi, který je prezentován jako tvůrce díla."],"da":["Relaterer et værk til en agent, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.,Setzt ein Werk in Beziehung zu einem Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht."],"el":["Συνδέει ένα έργο με έναν φορέα που παρέχει υπηρεσίες συμβουλευτικής και συχνά κάνει συστάσεις σε κάποιον άλλον φορέα, ο οποίος αναπαρίσταται ως ο δημιουργός ενός έργου."],"en":["Relates a work to an agent who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work."],"es":["Relaciona una obra con un agente que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra."],"et":["Seostab teose tegijaga, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina."],"fi":["Liittää teoksen toimijaan, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä."],"fr":["Met une œuvre en relation avec un agent qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek."],"it":["Correla un'opera a un agente che fornisce servizi di consulenza, e spesso formula raccomandazioni a un agente correlato presentato come il creatore di un'opera."],"lv":["Sasaista darbu ar aģentu, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs."],"nl":["Relateert een werk aan een actor die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk."],"no":["Relaterer et verk til en agent som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk."],"tr":["Bir eseri, eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmeti veren ve genellikle tavsiyelerde bulunan bir temsilciyle ilişkilendirilir."],"vi":["Liên kết tác phẩm với tác nhân cung cấp dịch vụ tư vấn, và thường đưa ra khuyến nghị, cho tác nhân khác người được nêu như là người sáng tạo của tác phẩm."],"zh-Hans-CN":["将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل استشاري","ca":"agent consultor","cs":"konzultant (agent)","da":"agent, som er rådgiver","de":"Beraterin/Berater (Akteur)","de":"Beraterin/Berater (Akteur)","el":"σύμβουλος","en":"consultant agent","es":"agente consultor","et":"konsultant (tegija)","fi":"asiantuntija (toimija)","fr":"agent consultant","hu":"tanácsadó ágens:","it":"consulente agente","lv":"konsultants (aģents)","nl":"consultant-actor","no":"konsulent (agent)","tr":"danışman temsilcisi","vi":"người tư vấn","zh-Hans-CN":"顾问行为者"},"ToolkitDefinition":{"ar":"وكيل يقدم خدمات استشارية، وغالبًا ما يقدم مقترحات، لوكيل ذي صلة يقدَّم على أنه منشئ لعمل.","ca":"Agent que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.","cs":"Agent,který poskytuje konzultační služby a často dává doporučení spřízněnému agentovi, který je prezentován jako tvůrce díla.","da":"Agent, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.","de":"Ein Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.","de":"Ein Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.","el":"Ένας φορέας που παρέχει υπηρεσίες συμβουλευτικής και συχνά κάνει συστάσεις σε κάποιον άλλον φορέα, ο οποίος αναπαρίσταται ως ο δημιουργός ενός έργου.","en":"An agent who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.","es":"Un agente que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra.","et":"Tegija, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.","fi":"Toimija, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.","fr":"Agent qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.","hu":"Egy ágens, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.","it":"Agente che fornisce servizi di consulenza, e spesso formula raccomandazioni a un agente correlato che viene presentato come il creatore di un'opera.","lv":"Aģents, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.","nl":"Een actor die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.","no":"Det å skape et nytt verk ved å omskrive eller bearbeide verk av en annen opphaver er inkludert hvis dette i vesentlig grad har endret originalverkets særpreg og innhold, eller hvis mediet for uttrykket er endret.","tr":"Eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmeti veren ve genellikle tavsiyelerde bulunan bir temsilci.","vi":"Tác nhân cung cấp dịch vụ tư vấn, và thường đưa ra khuyến nghị, cho tác nhân khác người được nêu như là người sáng tạo của tác phẩm.","zh-Hans-CN":"向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个行为者"},"altLabel":{"ar":["استشاري"],"ca":["consultor"],"cs":["konzultant"],"da":["rådgiver"],"de":["Berater,Berater"],"en":["consultant"],"es":["consultor"],"et":["konsultant"],"fi":["asiantuntija"],"fr":["consultant"],"hu":["tanácsadó:"],"it":["consulente"],"nl":["consultant"],"no":["konsulent"],"tr":["danışman"],"zh-Hans-CN":["顾问"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/consultantAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10505", "lexicalAlias":"http://rdaregistry.info/Elements/w/consultantCollectiveAgent.en", "label":"has consultant collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10458", "lexicalAlias":"http://rdaregistry.info/Elements/w/consultantPerson.en", "label":"has consultant person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10071", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/consultantAgent.en", "label":"has consultant agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10071", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/consultantAgent.en", "label":"has consultant agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10505","label":{"ar":"له وكيل جماعي استشاري","ca":"té com a agent col·lectiu consultor","cs":"má konzultanta (kolektivního agenta)","da":"har kollektiv agent, som er rådgiver","de":"hat Beraterin/Berater (Gemeinschaftlicher Akteur)","de":"hat Beraterin/Berater (Gemeinschaftlicher Akteur)","en":"has consultant collective agent","es":"tiene agente colectivo consultor","et":"konsultant (kollektiiv)","fi":"asiantuntija (yhteistoimija)","fr":"a pour agent collectif consultant","hu":"tanácsadó kollektív ágense a következő:","it":"ha come consulente agente collettivo","lv":"konsultants (grupa)","nl":"heeft consultant-collectieve actor","no":"har konsulent (kollektiv agent)","tr":"danışman kolektif temsilci ile ilişkilidir","zh-Hans-CN":"有顾问集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي يقدم خدمات استشارية، وغالبًا ما يقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل."],"ca":["Relaciona una obra amb un agent col·lectiu que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který poskytuje konzultační služby a často dává doporučení spřízněnému agentovi, který je prezentován jako tvůrce díla."],"da":["Relaterer et værk til en kollektiv agent, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlicher Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.,Setzt ein Werk in Beziehung zu einem gemeinschaftlicher Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht."],"en":["Relates a work to a collective agent who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work."],"es":["Relaciona una obra con un agente colectivo que brinda servicios de consulta, y a menudo hace recomendaciones, para un agente relacionado que está representado como creador de una obra."],"et":["Seostab teose kollektiiviga, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina."],"fi":["Liittää teoksen yhteistoimijaan, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä."],"fr":["Met une œuvre en relation avec un agent collectif qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek."],"it":["Correla un'opera a un agente collettivo che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come  creatore di un'opera."],"lv":["Sasaista darbu ar grupu, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs."],"nl":["Relateert een werk aan een collectieve actor die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk."],"no":["Relaterer et verk til en kollektiv agent som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk."],"tr":["Bir eseri, bir eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmetleri sağlayan ve genellikle tavsiyelerde bulunan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي استشاري","ca":"agent col·lectiu consultor","cs":"konzultant","da":"kollektiv agent, som er rådgiver","de":"Beraterin/Berater (Gemeinschaftlicher Akteur)","de":"Beraterin/Berater (Gemeinschaftlicher Akteur)","en":"consultant collective agent","es":"agente colectivo consultor","et":"konsultant (kollektiiv)","fi":"asiantuntija (yhteistoimija)","fr":"agent collectif consultant","hu":"tanácsadó kollektív ágens:","it":"consulente agente collettivo","lv":"konsultants (grupa)","nl":"consultant-collectieve actor","no":"konsulent (kollektiv agent)","tr":"danışman kolektif temsilcisi","zh-Hans-CN":"顾问集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يقدم خدمات استشارية، وغالبًا ما يقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل.","ca":"Agent col·lectiu que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.","cs":"Kolektivní agent, který poskytuje konzultační služby a často dává doporučení spřízněnému agentovi, který je prezentován jako tvůrce díla.","da":"Kollektiv agent, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.","de":"Ein gemeinschaftlicher Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.","de":"Ein gemeinschaftlicher Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.","en":"A collective agent who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.","es":"Un agente colectivo que brinda servicios de consulta, y a menudo hace recomendaciones, para un agente relacionado que está representado como creador de una obra.","et":"Kollektiiv, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.","fi":"Yhteistoimija, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.","fr":"Agent collectif qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.","hu":"Egy kollektív ágens, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.","it":"Agente collettivo che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come creatore di un'opera.","lv":"Grupa, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.","nl":"Een collectieve actor die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.","no":"En kollektiv agen