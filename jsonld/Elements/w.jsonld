                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10196", "lexicalAlias":"http://rdaregistry.info/Elements/w/imitationOfWork.en", "label":"is imitation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/parodyOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10197", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/parodyOfWork.en", "label":"is parody of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10197", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/parodyOfWork.en", "label":"is parody of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10131","label":{"ar":"هو معالجة إذاعية لعمل","ca":"és adaptació radiofònica d’una obra","cs":"je rozhlasovou adaptací díla","da":"er bearbejdelse af værk til radio","de":"ist Hörfunkbearbeitung von (Werk)","de":"ist Hörfunkbearbeitung von (Werk)","el":"είναι ραδιοφωνική προσαρμογή του (έργο)","en":"is radio adaptation of work","es":"es adaptación de radio de obra","et":"raadioversioon teosest","fi":"radiosovitus teoksesta","fr":"est une adaptation pour la radio d’une œuvre","hu":"rádiós adaptációja a következő műnek:","it":"è adattamento radiofonico di opera","lv":"kā radio raidījums adaptētais darbs","nl":"is radiobewerking van werk","no":"er bearbeidelse av verk for radio","tr":"eserin radyo uyarlamasıdır","vi":"là phỏng theo truyền thanh của (tác phẩm)","zh-Hans-CN":"是作品的广播改编"},"definition":{"ar":["يربط عمل بعمل تمت معالجته كبرنامج إذاعي."],"ca":["Relaciona una obra amb una obra que s’adapta com un programa radiofònic."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako rozhlasový program."],"da":["Relaterer et værk til et værk, som er bearbejdet til et radioprogram."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Hörfunksendung bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als Hörfunksendung bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως ραδιοφωνικό πρόγραμμα."],"en":["Relates a work to a work that is adapted as a radio program."],"es":["Relaciona una obra con una obra que es adaptada como un programa de radio."],"et":["Seostab teose teosega, mis on adapteeritud raadiosaatena."],"fi":["Liittää teoksen teokseen, joka on sovitettu radio-ohjelmaksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée en émission de radio."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet rádióműsorként adaptáltak."],"it":["Correla un’opera a un’opera adattata come programma radiofonico."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā radio raidījums."],"nl":["Relateert een werk aan een werk dat is bewerkt als een radioprogramma."],"no":["Relaterer et verk til et verk som er bearbeidet til et radioprogram."],"tr":["Bir eseri, radyo programı olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là chương trình truyền thanh."],"zh-Hans-CN":["将一种作品与被改编为广播节目的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالجة إذاعية لعمل","ca":"adaptació radiofònica d’una obra","cs":"rozhlasová adaptace díla","da":"bearbejdelse af værk til radio","de":"Hörfunkbearbeitung von (Werk)","de":"Hörfunkbearbeitung von (Werk)","el":"ραδιοφωνική προσαρμογή του (έργο)","en":"radio adaptation of work","es":"adaptación de radio de obra","et":"raadioversioon teosest","fi":"radiosovitus teoksesta","fr":"adaptation pour la radio d’une œuvre","hu":"rádióműsorként átdolgozott mű:","it":"adattamento radiofonico di opera","lv":"kā radio raidījums adaptētais darbs","nl":"radiobewerking van werk","no":"bearbeidelse av verk for radio","tr":"eserin radyo uyarlaması","vi":"phỏng theo truyền thanh của (tác phẩm)","zh-Hans-CN":"作品的广播改编"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كبرنامج إذاعي.","ca":"Obra que s’adapta com un programa radiofònic.","cs":"Dílo, které je adaptováno jako rozhlasový program.","da":"Værk, som er bearbejdet til et radioprogram.","de":"Ein Werk, das als Hörfunksendung bearbeitet ist.","de":"Ein Werk, das als Hörfunksendung bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως ραδιοφωνικό πρόγραμμα.","en":"A work that is adapted as a radio program.","es":"Una obra que es adaptada como un programa de radio.","et":"Teos, mis on adapteeritud raadiosaatena.","fi":"Teos, joka on sovitettu radio-ohjelmaksi.","fr":"Œuvre qui est adaptée en émission de radio.","hu":"Egy mű, amelyet rádióműsorként átdolgoztak.","it":"Opera adattata come programma radiofonico.","lv":"Darbs, kas ir adaptēts kā radio raidījums.","nl":"Een werk dat is bewerkt als een radioprogramma.","no":"Et verk som er bearbeidet til et radioprogram.","tr":"Bir radyo programı olarak uyarlanan bir çalışma.","vi":"Tác phẩm đã được phỏng theo như là chương trình truyền thanh.","zh-Hans-CN":"被改编为广播节目的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
