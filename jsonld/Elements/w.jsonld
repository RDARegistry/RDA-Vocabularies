                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10577", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorFamily.en", "label":"has author family"},{"@id":"http://rdaregistry.info/Elements/w/P10479", "lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurCollectiveAgent.en", "label":"has rapporteur collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10573", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/rapporteurFamily.en", "label":"has rapporteur family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10573", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/rapporteurFamily.en", "label":"has rapporteur family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10432","label":{"ar":"له شخص مقرر","ca":"té com a persona relatora","cs":"má reportéra (osobu)","da":"har person, som er rapportør","de":"hat Berichterstatterin/Berichterstatter (Person)","de":"hat Berichterstatterin/Berichterstatter (Person)","en":"has rapporteur person","es":"tiene persona relatora","et":"aruande koostaja (isik)","fi":"kokousten raportoija (henkilö)","fr":"a pour personne rapporteuse","hu":"raportőr személye a következő:","it":"ha come relatore persona","lv":"ziņotājs (persona)","nl":"heeft rapporteur-persoon","no":"har rapportør (person)","tr":"raportör kişisi ile ilişkilidir","zh-Hans-CN":"有会务报告人个人"},"definition":{"ar":["يربط بين عمل وشخص يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها."],"ca":["Relaciona una obra amb una persona que és un autor que és nomenat per una organització per redactar les actes de les seves reunions."],"cs":["Vztahuje dílo k osobě, která je autorem, pověřeným organizací, aby podával zprávy o průběhu jejích jednání."],"da":["Relaterer et værk til en person, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten."],"en":["Relates a work to a person who is an author who is appointed by an organization to report on the proceedings of its meetings."],"es":["Relaciona una obra con una persona que es un autor que es designado por una organización para informar sobre las actas de sus reuniones."],"et":["Seostab teose isikuga, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama."],"fi":["Liittää teoksen henkilöön, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä."],"fr":["Met une œuvre en relation avec une personne autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions."],"hu":["Hozzákapcsol egy művet egy szerző személyhez, akit egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról."],"it":["Correla un'opera alla persona autore incaricata da un'organizzazione di compilare rapporti sugli atti dei suoi incontri."],"lv":["Sasaista darbu ar personu - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem."],"nl":["Relateert een werk aan een persoon die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten."],"no":["Relaterer et verk til en person som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter."],"tr":["Bir eseri, bir kuruluş tarafından toplantılarının işleyişi hakkında rapor vermek üzere atanan yazar olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个著者并被一个组织指定为报告会议记录的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مقرر","ca":"persona relatora","cs":"reportér (osoba)","da":"person, som er rapportør","de":"Berichterstatterin/Berichterstatter (Person)","de":"Berichterstatterin/Berichterstatter (Person)","en":"rapporteur person","es":"persona relatora","et":"aruande koostaja (isik)","fi":"kokousten raportoija (henkilö)","fr":"personne rapporteuse","hu":"raportőr személy:","it":"relatore persona","lv":"ziņotājs (persona)","nl":"rapporteur-persoon","no":"rapportør (person)","tr":"raportör kişi","zh-Hans-CN":"会务报告人个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.","ca":"Persona que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.","cs":"Osoba, která je autorem, pověřeným organizací, aby podával zprávy o průběhu jejích jednání.","da":"Person, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.","de":"Eine Verfasserin/Ein Verfasser (Person), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.","de":"Eine Verfasserin/Ein Verfasser (Person), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.","en":"A person who is an author who is appointed by an organization to report on the proceedings of its meetings.","es":"Una persona que es un autor que es designado por una organización para informar sobre las actas de sus reuniones.","et":"Isik, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.","fi":"Henkilö, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.","fr":"Personne autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions.","hu":"Egy szerző személy, akit egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról.","it":"Persona autore incaricata da un'organizzazione di compilare rapporti sugli atti dei suoi incontri.","lv":"Persona - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.","nl":"Een persoon die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.","no":"En person som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.","tr":"Bir kuruluş tarafından toplantılarının tutanakları hakkında rapor vermek üzere atanan yazar olan kişi.","zh-Hans-CN":"作为一个著者并被一个组织指定为报告会议记录的一个个人"},"note":{"ar":["تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات."],"ca":["S’exclou la responsabilitat que es limita a prendre notes."],"cs":["Odpovědnost omezená na pořizování zápisu je vyloučena."],"da":["Omfatter ikke ansvar begrænset til at tage referat."],"de":["Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.,Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt."],"en":["Responsibility limited to taking minutes is excluded."],"es":["Se excluye la responsabilidad limitada a levantar actas."],"et":["Ei hõlma vastutust, mis on piiratud ainult protokollimisega."],"fi":["Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta."],"fr":["Une responsabilité limitée à rédiger un procès-verbal est exclue."],"hu":["Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség."],"it":["E' esclusa la responsabilità limitata alla redazione dei verbali."],"lv":["Neietver atbildību protokolēt."],"nl":["Verantwoordelijkheid beperkt tot het notuleren is uitgesloten."],"no":["Ansvar som er begrenset til å ta møtereferater, er ikke inkludert."],"tr":["Tutanak tutmakla sınırlı sorumluluk hariçtir."],"zh-Hans-CN":["不包括仅限于写会议记录的责任。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10436", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorPerson.en", "label":"has author person"},{"@id":"http://rdaregistry.info/Elements/w/P10255", "lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurAgent.en", "label":"has rapporteur agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10432", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/rapporteurPerson.en", "label":"has rapporteur person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10432", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/rapporteurPerson.en", "label":"has rapporteur person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10404","label":{"ar":"له مصدر تسجيل","ca":"té com a font d’enregistrament","cs":"má pramen popisu","da":"har registreringskilde","de":"hat Aufnahmequelle","de":"hat Aufnahmequelle","en":"has recording source","es":"tiene fuente de grabación","et":"andmeallikas","fi":"merkintälähde","fr":"a pour source d’enregistrement","hu":"rögzítési forrása a következő:","it":"ha come fonte di registrazione","lv":"metadatu ieraksta avots","nl":"heeft bron van overname","no":"har registreringskilde","tr":"kayıt kaynağı ile ilişkilidir","zh-Hans-CN":"有记录信息源"},"definition":{"ar":["يربط بين عمل ومصدر معلومات لعمل ميتاداتا يعد وصفًا غير محدد يُنسخ من تجسيدة يتم وصفها."],"ca":["Relaciona una obra amb una font d’informació d’una obra de metadades que és una descripció no estructurada transcrita d’una manifestació que es descriu."],"cs":["Vztahuje dílo k pramenu informací pro metadatové dílo, které je nestrukturovaným popisem přepsaným z popisovaného provedení."],"da":["Relaterer et værk til en informationskilde for et metadataværk, som er en ustruktureret beskrivelse, gengivet fra en manifestation, der bliver beskrevet."],"de":["Setzt ein Werk in Beziehung zu einer Informationsquelle für ein Metadatenwerk, bei der es sich um eine unstrukturierte Beschreibung handelt, die aus einer beschriebenen Manifestation transkribiert ist.,Setzt ein Werk in Beziehung zu einer Informationsquelle für ein Metadatenwerk, bei der es sich um eine unstrukturierte Beschreibung handelt, die aus einer beschriebenen Manifestation transkribiert ist."],"en":["Relates a work to a source of information for a metadata work that is an unstructured description transcribed from a manifestation that is being described."],"es":["Relaciona una obra con una fuente de información para una obra de metadatos que es una descripción no estructurada transcrita de una manifestación que se está describiendo."],"et":["Seostab teose metaandmeteose jaoks kasutatud andmeallikaga, mida näitab kirjeldatavast kehastusest transkribeeritud struktureerimata kirjeldus."],"fi":["Liittää teoksen metatietoteoksen tiedonlähteeseen, joka on rakenteistamaton kuvailu jäljennettynä manifestaatiosta, joka on kuvailtavana."],"fr":["Met une œuvre en relation avec une source d’information pour une œuvre de métadonnées qui consiste en une description non structurée transcrite d’une manifestation décrite."],"hu":["Hozzákapcsol egy művet egy metaadatmű adatforrásához, amely egy megjelenési forma leírásából átírt, struktúrálatlan leírás."],"it":["Correla un'opera a una fonte d'informazione per un'opera di metadati che è una descrizione non strutturata trascritta dalla manifestazione che si sta descrivendo."],"lv":["Sasaista darbu ar metadatu darba informācijas avotu, kas ir no apskatāmās manifestācijas iegūts nestrukturēts apraksts."],"nl":["Relateert een werk aan een bron van informatie voor een metadatawerk dat een ongestructureerde beschrijving is, overgenomen uit een manifestatie die beschreven wordt."],"n