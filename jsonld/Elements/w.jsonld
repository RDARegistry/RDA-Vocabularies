                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10192", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentationOfWork.en", "label":"is augmentation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/illustrationsForWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10152", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/illustrationsForWork.en", "label":"is illustrations for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10152", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/illustrationsForWork.en", "label":"is illustrations for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10194","label":{"ar":"هو تكشيف لعمل","ca":"és indexació per a una obra","da":"er indeksering af værk","de":"ist Indexierung für (Werk)","el":"είναι ευρετηρίαση για (έργο)","en":"is indexing for work (Deprecated)","et":"indekseerimine teosele","fi":"indeksointi teoksesta","fr":"est une indexation pour une œuvre","hu":"indexe a következő műnek:","it":"è indicizzazione per opera","lv":"ir indeksētais darbs","nl":"is indexering voor werk","no":"er indeksering for verk","vi":"là định chỉ mục của (tác phẩm)"},"definition":{"ar":["يربط عمل بعمل تم تكشيف محتوياته بواسطة عمل ذي صلة"],"ca":["Relaciona una obra amb una obra els continguts de la qual han estat indexats per una obra relacionada."],"da":["Relaterer et værk til et værk, hvis indhold er blevet indekseret af et relateret værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalte durch ein in Beziehung stehendes Werk indexiert wurden."],"el":["Συνδέει ένα έργο με ένα έργο του οποίου τα περιεχόμενα έχουν ευρετηριαστεί από μια υπηρεσία επιτομής και ευρετηρίασης."],"en":["Relates a work to a work whose contents have been indexed by a related work. (Deprecated)"],"et":["Seostab teose teosega, mille sisu on indekseeritud seotud teoses."],"fi":["Liittää teoksen teokseen, jonka sisällön siihen liittyvä teos on indeksoinut."],"fr":["Met une œuvre en relation avec une œuvre dont le contenu a été indexé par une œuvre en relation."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek tartalmait egy kapcsolódó mű indexeli."],"it":["Correla un’opera a un’opera i cui contenuti sono stati indicizzati da un’opera correlata."],"lv":["Sasaista darbu ar darbu, kura saturs indeksēts ar saistīto darbu."],"nl":["Relateert een werk aan een werk waarvan de content geïndexeerd is door een gerelateerd werk."],"no":["Relaterer et verk til et verk hvis innhold er indeksert i et relatert verk."],"vi":["Liên kết tác phẩm với tác phẩm mà nội dung của nó được định chỉ mục bởi dịch vụ tóm tắt và định chỉ mục."]},"ToolkitLabel":{"ar":"تكشيف لعمل","ca":"indexació per a una obra","da":"indeksering af værk","de":"Indexierung für (Werk)","el":"ευρετηρίαση για (έργο)","en":"indexing for work (Deprecated)","es":"indización de (obra)","et":"indekseerimine teosele","fi":"indeksointi teoksesta","fr":"indexation pour une œuvre","hu":"indexelt mű","it":"indicizzazione per opera","lv":"indeksētais darbs","nl":"indexering voor werk","no":"indeksering for verk","vi":"định chỉ mục của (tác phẩm)"},"ToolkitDefinition":{"ar":"عمل تم تكشيف محتوياته بواسطة عمل ذي صلة","ca":"Obra els continguts de la qual han estat indexats per una obra relacionada.","da":"Værk, hvis indhold er blevet indekseret af et relateret værk.","de":"Ein Werk, dessen Inhalte durch ein in Beziehung stehendes Werk indexiert wurden.","el":"Ένα έργο του οποίου τα περιεχόμενα έχουν ευρετηριαστεί από μια υπηρεσία επιτομής και ευρετηρίασης.","en":"A work whose contents have been indexed by a related work. (Deprecated)","es":"Una obra cuyo contenido ha sido indizado por un servicio de indización y resumenes.","et":"Teos, mille sisu on indekseeritud seotud teoses.","fi":"Teos, jonka sisällön siihen liittyvä teos on indeksoinut.","fr":"Œuvre dont le contenu a été indexé par une œuvre en relation.","hu":"Egy mű, amelynek tartalmait egy kapcsolódó mű indexeli.","it":"Opera i cui contenuti sono stati indicizzati da un’opera correlata.","lv":"Darbs, kura saturs indeksēts ar saistīto darbu.","nl":"Een werk waarvan de content geïndexeerd is door een gerelateerd werk.","no":"Et verk hvis innhold er indeksert i et relatert verk.","vi":"Tác phẩm mà nội dung của nó được định chỉ mục bởi dịch vụ tóm tắt và định chỉ mục."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10190", "lexicalAlias":"http://rdaregistry.info/Elements/w/sourceWork.en", "label":"has source work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/indexingForWork.en","instructionNumber":"24.5","status": {
