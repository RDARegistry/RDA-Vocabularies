                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/appellantCorporateBody.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10009", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/appellantCorporateBody.en", "label":"has appellant corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10009", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/appellantCorporateBody.en", "label":"has appellant corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10043","label":{"ar":"له شخص مدعي","ca":"té com a persona demandant","cs":"má žalobce (osobu)","da":"har person, som er sagsøger","de":"hat Zivilklägerin/Zivilkläger (Person)","de":"hat Zivilklägerin/Zivilkläger (Person)","el":"έχει ενάγον φυσικό πρόσωπο","en":"has plaintiff person","es":"tiene persona demandante","et":"hageja (isik)","fi":"henkilökantaja","fr":"a pour personne demanderesse","hu":"felperese a következő:","it":"ha come querelante persona","lv":"prasītājs (persona)","nl":"heeft aanklager-persoon","no":"har saksøker (person)","tr":"davacı kişisi ile ilişkilidir","vi":"có cá nhân nguyên đơn","zh-Hans-CN":"有原告个人"},"definition":{"ar":["يربط بين عمل وشخص يرفع دعوى ضمن دعوى مدنية."],"ca":["Relaciona una obra amb una persona que interposa una demanda civil."],"cs":["Vztahuje dílo k osobě, která podává žalobu v civilním řízení."],"da":["Relaterer et værk til en person, som anlægger en sag i en civilproces."],"de":["Setzt ein Werk in Beziehung zu einer Person, die eine Klage in ein Zivilverfahren einbringt.,Setzt ein Werk in Beziehung zu einer Person, die eine Klage in ein Zivilverfahren einbringt."],"el":["Συνδέει ένα έργο με ένα φυσικό πρόσωπο, το οποίο ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας."],"en":["Relates a work to a person who brings a suit in a civil proceeding."],"es":["Relaciona una obra con una persona que entabla una demanda en un proceso civil."],"et":["Seostab teose isikuga, kes esitab tsiviilkohtumenetluses hagi."],"fi":["Liittää teoksen henkilöön, joka nostaa kanteen siviilioikeudenkäyntiin."],"fr":["Met une œuvre en relation avec une personne qui intente une poursuite civile."],"hu":["Hozzákapcsol egy művet egy személyhez, aki polgárjogi eljárás keretében pert indít."],"it":["Correla un’opera a una persona che intenta un’azione legale nell’ambito di un procedimento civile."],"lv":["Sasaista darbu ar personu, kura ceļ prasību civiltiesā."],"nl":["Relateert een werk aan een persoon die een proces aanspant in een civielrechtelijke procedure."],"no":["Relaterer et verk til en person som er saksøker i en sivilrettslig sak."],"tr":["Bir eseri, hukuk davasına taşıyan kişi ile ilişkilendirir."],"vi":["Liên kết tác phẩm với cá nhân đưa ra đơn kiện trong vụ kiện dân sự."],"zh-Hans-CN":["将一种作品与在民事诉讼中起诉的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مدعي","ca":"persona demandant","cs":"žalobce (osoba)","da":"person, som er sagsøger","de":"Zivilklägerin/Zivilkläger (Person)","de":"Zivilklägerin/Zivilkläger (Person)","el":"ενάγον φυσικό πρόσωπο","en":"plaintiff person","es":"persona demandante","et":"hageja (isik)","fi":"henkilökantaja","fr":"personne demanderesse","hu":"felperes:","it":"querelante persona","lv":"prasītājs (persona)","nl":"aanklager-persoon","no":"saksøker (person)","tr":"davacı kişi","vi":"cá nhân nguyên đơn","zh-Hans-CN":"原告个人"},"ToolkitDefinition":{"ar":"شخص يرفع دعوى ضمن دعوى مدنية.","ca":"Persona que interposa una demanda civil.","cs":"Osoba, která podává žalobu v civilním řízení.","da":"Person, som anlægger en sag i en civilproces.","de":"Eine Person, die eine Klage in ein Zivilverfahren einbringt.","de":"Eine Person, die eine Klage in ein Zivilverfahren einbringt.","el":"Ένα φυσικό πρόσωπο, το οποίο ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας.","en":"A person who brings a suit in a civil proceeding.","es":"Una persona que entabla una demanda en un proceso civil.","et":"Isik, kes esitab tsiviilkohtumenetluses hagi.","fi":"Henkilö, joka nostaa kanteen siviilioikeudenkäyntiin.","fr":"Personne qui intente une poursuite civile.","hu":"Egy személy, aki polgárjogi eljárás keretében pert indít.","it":"Persona che intenta un’azione legale nell’ambito di un procedimento civile.","lv":"Persona, kura ceļ prasību civiltiesā.","nl":"Een persoon die een proces aanspant in een civielrechtelijke procedure.","no":"En person som er saksøker i en sivilrettslig sak.","tr":"Davayı sivil mahkemeye taşıyan kişi.","vi":"Cá nhân đưa ra đơn kiện trong vụ kiện dân sự.","zh-Hans-CN":"在民事诉讼中起诉的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
