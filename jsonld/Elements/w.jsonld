                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsOratorioWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10289", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsOratorioWork.en", "label":"is adapted as oratorio work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10289", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsOratorioWork.en", "label":"is adapted as oratorio work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10297","label":{"ar":"له وكيل منظم","ca":"té com a agent organitzador","cs":"má organizátora (agenta)","da":"har agent, som er arrangør","de":"hat Veranstalterin/Veranstalter (Akteur)","de":"hat Veranstalterin/Veranstalter (Akteur)","el":"έχει οργανωτή","en":"has organizer agent","es":"tiene agente organizador","et":"korraldaja (tegija)","fi":"järjestäjä (toimija)","fr":"a pour agent organisateur","hu":"szervező ágense a következő:","it":"ha come organizzatore agente","lv":"organizētājs (aģents)","nl":"heeft organisator-actor","no":"har arrangør (agent)","tr":"organizatör temsilcisi ile ilişkilidir","vi":"có nhà tổ chức","zh-Hans-CN":"有组织者行为者"},"definition":{"ar":["يربط بين عمل ووكيل ينظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل."],"ca":["Relaciona una obra amb un agent que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra."],"cs":["Vztahuje dílo k agentovi, který pořádá konferenci, výstavu nebo jinou akci, která dává vzniknout dílu."],"da":["Relaterer et værk til en agent, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.,Setzt ein Werk in Beziehung zu einem Akteur, der eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert, aus der/dem ein Werk hervorgeht."],"el":["Συνδέει ένα έργο με έναν φορέα, ο οποίος οργανώνει μια έκθεση, ένα συμβάν, συνέδριο κ.λπ., εκ των οποίων προέκυψε η ανάγκη για ένα έργο."],"en":["Relates a work to an agent who organizes a conference, exhibition, or other event that gives rise to a work."],"es":["Relaciona una obra con un agente que organiza una conferencia, exposición u otro evento que dé origen a una obra."],"et":["Seostab teose tegijaga, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse."],"fi":["Liittää teoksen toimijaan, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle."],"fr":["Met une œuvre en relation avec un agent qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely egy mű létrejöttét eredményező konferenciát, kiállítást vagy egyéb eseményt szervez."],"it":["Correla un’opera a un agente che organizza una conferenza, una mostra o un altro evento che dà origine a un’opera."],"lv":["Sasaista darbu ar aģentu, kas organizējis konferenci, izstādi vai citu pasākumu."],"nl":["Relateert een werk aan een actor die organiseert een conferentie, tentoonstelling of andere gebeurtenis die aanleiding geeft tot een werk."],"no":["Relaterer et verk til en agent som organiserer en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk."],"tr":["Bir eseri, bir eseri ortaya çıkaran bir konferans, sergi veya başka bir etkinlik düzenleyen bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân tổ chức triển lãm, sự kiện, hội nghị, khoá học, chương trình, v.v... bắt nguồn cho tác phẩm."],"zh-Hans-CN":["将一种作品与组织产生一种作品的会议、展览或其他事件的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل منظم","ca":"agent organitzador","cs":"organizátor (agent)","da":"agent, som er arrangør","de":"Veranstalterin/Veranstalter (Akteur)","de":"Veranstalterin/Veranstalter (Akteur)","el":"οργανωτής","en":"organizer agent","es":"agente organizador","et":"korraldaja (tegija)","fi":"järjestäjä (toimija)","fr":"agent organisateur","hu":"szervező ágens:","it":"organizzatore agente","lv":"organizētājs (aģents)","nl":"organisator-actor","no":"arrangør (agent)","tr":"organizatör temsilci","vi":"nhà tổ chức","zh-Hans-CN":"组织者行为者"},"ToolkitDefinition":{"ar":"وكيل ينظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل.","ca":"Agent que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.","cs":"Agent, který pořádá konferenci, výstavu nebo jinou akci, která dává vzniknout dílu.","da":"Agent, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk.","de":"Ein Akteur, der eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.","de":"Ein Akteur, der eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert, aus der/dem ein Werk hervorgeht.","el":"Ένας φορέας, ο οποίος οργανώνει μια έκθεση, ένα συμβάν, συνέδριο κ.λπ., εκ των οποίων προέκυψε η ανάγκη για ένα έργο.","en":"An agent who organizes a conference, exhibition, or other event that gives rise to a work.","es":"Un agente que organiza una conferencia, exposición u otro evento que dé origen a una obra.","et":"Tegija, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse.","fi":"Toimija, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle.","fr":"Agent qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.","hu":