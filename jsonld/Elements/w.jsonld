                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/noteOnWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/x/P00015", "lexicalAlias":"http://rdaregistry.info/Elements/x/noteOnRDAEntity.en", "label":"has note on RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10402", "lexicalAlias":"http://rdaregistry.info/Elements/w/noteOnMetadataWork.en", "label":"has note on metadata work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10330", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/noteOnWork.en", "label":"has note on work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10234","label":{"ar":"هو معالجة أوبرالية لعمل","ca":"és adaptació operística d’una obra","cs":"je operní adaptací díla","da":"er bearbejdelse af værk til opera","de":"ist Opernbearbeitung von (Werk)","de":"ist Opernbearbeitung von (Werk)","el":"είναι προσαρμογή όπερας του (έργο)","en":"is opera adaptation of work","es":"es una adaptación operística de la obra","et":"ooperiversioon teosest","fi":"oopperasovitus teoksesta","fr":"est une adaptation à l’opéra d’une œuvre","hu":"operaadaptációja a következő műnek:","it":"è adattamento come opera musicale di opera","lv":"kā opera adaptētais darbs","nl":"is operabewerking van werk","no":"er bearbeidelse av verk til opera","tr":"eserin opera uyarlamasıdır","vi":"là phỏng theo opera của (tác phẩm)","zh-Hans-CN":"是作品的歌剧改编"},"definition":{"ar":["يربط عمل بعمل معالج كأوبرا."],"ca":["Relaciona una obra amb una obra que s’adapta com una òpera."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako opera."],"da":["Relaterer et værk til et værk, som er bearbejdet til en opera."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Oper bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als Oper bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως όπερα."],"en":["Relates a work to a work that is adapted as an opera."],"es":["Relaciona una obra con una obra que está adaptada como ópera."],"et":["Seostab teose teosega, mis on adapteeritud ooperina."],"fi":["Liittää teoksen teokseen, joka on sovitettu oopperaksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée à l’opéra."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet operaként adaptáltak."],"it":["Correla un’opera ca on un’opera adattata come un’opera musicale."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā opera."],"nl":["Relateert een werk aan een werk dat is bewerkt als opera."],"no":["Relaterer et verk til et verk som er bearbeidet til en opera."],"tr":["Bir eseri, opera eserine uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là opera."],"zh-Hans-CN":["将一种作品与被改编为歌剧的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالجة أوبرالية لعمل","ca":"adaptació operística d’una obra","cs":"operní adaptace díla","da":"bearbejdelse af værk til opera","de":"Opernbearbeitung von (Werk)","de":"Opernbearbeitung von (Werk)","el":"προσαρμογή όπερας του (έργο)","en":"opera adaptation of work","es":"adaptación operística de la obra","et":"ooperiversioon teosest","fi":"oopperasovitus teoksesta","fr":"adaptation à l’opéra d’une œuvre","hu":"operává átdolgozott mű","it":"adattamento come opera musicale di opera","lv":"kā opera adaptētais darbs","nl":"operabewerking van werk","no":"bearbeidelse av verk til opera","tr":"eserin operaya uyarlaması","vi":"phỏng theo opera của (tác phẩm)","zh-Hans-CN":"作品的歌剧改编"},"ToolkitDefinition":{"ar":"عمل معالج كأوبرا.","ca":"Obra que s’adapta com una òpera.","cs":"Dílo, které je adaptováno jako opera.","da":"Værk, som er bearbejdet til en opera.","de":"Ein Werk, das als Oper bearbeitet ist.","de":"Ein Werk, das als Oper bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως όπερα.","en":"A work that is adapted as opera.","es":"Una obra que está adaptada como ópera.","et":"Teos, mis on adapteeritud ooperina.","fi":"Teos, joka on sovitettu oopperaksi.","fr":"Œuvre qui est adaptée à l’opéra.","hu":"Egy mű, amelyet operaként adaptáltak.","it":"Opera adattata come un’opera musicale.","lv":"Darbs, kas ir adaptēts kā opera.","nl":"Een werk dat is bewerkt als opera.","no":"Et verk som er bearbeidet til en opera.","tr":"Bir opera olarak uyarlanan bir eser.","vi":"Tác phẩm đã được phỏng theo như là opera.","zh-Hans-CN":"被改编为歌剧的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
