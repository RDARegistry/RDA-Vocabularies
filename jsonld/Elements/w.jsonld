                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/dedicateePersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10312", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedPersonOfWork.en", "label":"has related person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10069", "lexicalAlias":"http://rdaregistry.info/Elements/w/dedicateeAgentOfWork.en", "label":"has dedicatee agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10412", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/dedicateePersonOfWork.en", "label":"has dedicatee person of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10412", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/dedicateePersonOfWork.en", "label":"has dedicatee person of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10048","label":{"ar":"له وكيل مُهدي","ca":"té com a agent dedicant","cs":"má dedikátora (agenta)","da":"har agent, som er dedikationsskriver","de":"hat Widmende/Widmenden (Akteur)","de":"hat Widmende/Widmenden (Akteur)","el":"έχει αφιερωτή","en":"has dedicator agent","es":"tiene agente dedicador","et":"pühendaja (tegija)","fi":"omistuksen tekijä (toimija)","fr":"a pour agent dédicateur d’une œuvre","hu":"dedikáló ágense a következő:","it":"ha come dedicante agente","lv":"veltītājs (aģents)","nl":"heeft opdrager-actor","no":"har agent som dediserer","tr":"ithaf eden temsilcisi ile ilişkilidir","vi":"có người đề tặng","zh-Hans-CN":"有题献者行为者"},"definition":{"ar":["يربط بين عمل ووكيل يخصص عملا تقديرا لإلهام وكيل مرتبط أو دعمه."],"ca":["Relaciona una obra amb un agent que assigna una obra com a reconeixement a la inspiració o el suport d’un agent relacionat."],"cs":["Vztahuje dílo k agentovi, který připisuje dílo souvisejícímu agentovi jako ocenění inspirace nebo podpory."],"da":["Relaterer et værk til en agent, som tilegner et værk til en relateret agent, som en anerkendelse af inspiration eller støtte."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet.,Setzt ein Werk in Beziehung zu einem Akteur, der ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet."],"el":["Συνδέει ένα έργο με έναν φορέα, από τον οποίο δημιουργείται η αφιέρωση."],"en":["Relates a work to an agent who assigns a work as an acknowledgement of the inspiration or support of a related agent."],"es":["Relaciona una obra con un agente que asigna una obra como un reconocimiento a la inspiración o apoyo de un agente relacionado."],"et":["Seostab teose tegijaga, kes pühendab teose tänuavaldusena innustust või toetust jaganud seotud tegijale."],"fi":["Liittää teoksen toimijaan, joka nimittää teoksen sitä innoittaineen tai tukeneen toimijan tunnustukseksi."],"fr":["Met une œuvre en relation avec un agent qui dédie une œuvre en reconnaissance de l’inspiration ou du soutien d’un agent en relation."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely köszönetképpen megjelöl egy művet egy kapcsolódó ágens inspirációjáért, támogatásáért cserébe."],"it":["Correla un’opera a un agente che dedica un’opera come riconoscimento dell’ispirazione o del sostegno a un agente correlato."],"lv":["Sasaista darbu ar aģentu, kas velta darbu pateicībā par saistītā aģenta iedvesmojumu vai atbalstu."],"nl":["Relateert een werk aan een actor die een werk toekent als erkenning van de inspiratie of hulp van een gerelateerde actor."],"no":["Relateter et verk til en agent som tilegner et verk som en bekreftelse på inspirasjon eller støtte fra en relatert agent."],"tr":["Bir eseri, ilgili temsilcinin ilhamı veya desteğinin bir karşılığı olarak tahsis eden bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân đề tặng tác phẩm."],"zh-Hans-CN":["将一种作品与指定一种作品作为一个相关行为者的启发或支持之感谢的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"له وكيل مُهدي","ca":"agent dedicant","cs":"dedikátor (agent)","da":"agent, som er dedikationsskriver","de":"Widmende/Widmender (Akteur)","de":"Widmende/Widmender (Akteur)","el":"αφιερωτής","en":"dedicator agent","es":"agente dedicador","et":"pühendaja (tegija)","fi":"omistuksen tekijä (toimija)","fr":"agent dédicateur d’une œuvre","hu":"dedikáló ágens:","it":"dedicante agente","lv":"veltītājs (aģents)","nl":"opdrager-actor","no":"agent som dediserer","tr":"adayan temsilci","vi":"người đề tặng","zh-Hans-CN":"题献者行为者"},"ToolkitDefinition":{"ar":"وكيل يخصص عملا تقديرا لإلهام وكيل مرتبط أو دعمه.","ca":"Agent que assigna una obra com a reconeixement a la inspiració o el suport d’un agent relacionat.","cs":"Agent, který připisuje dílo souvisejícímu agentovi jako ocenění inspirace nebo podpory.","da":"Agent, som tilegner et værk til en relateret agent, som en anerkendelse af inspiration eller støtte.","de":"Ein Akteur, der ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet.","de":"Ein Akteur, der ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet.","el":"Ένας φορέας από τον οποίο δημιουργείται μια αφιέρωση.","en":"An agent who assigns a work as an acknowledgement of the inspiration or support of a related agent.","es":"Un agente que asigna una obra como un reconocimiento a la inspiración o apoyo de un agente relacionado.","et":"Tegija, kes pühendab teose tänuavaldusena innustust või toetust jaganud seotud tegijale.","fi":"Toimija, joka nimittää teoksen sitä innoittaineen tai tukeneen toimijan tunnustukseksi.","fr":"Agent qui dédie une œuvre en reconnaissance de l’inspiration ou du soutien d’un agent en relation.","hu":"Egy ágens, amely köszönetképpen megjelöl egy művet egy kapcsolódó ágens által nyújtott inspirációért, támogatásért cserébe.