                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/artistCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10058", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistAgent.en", "label":"has artist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10545", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistCorporateBody.en", "label":"has artist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10592", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistFamily.en", "label":"has artist family"},{"@id":"http://rdaregistry.info/Elements/w/P10475", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistCollectiveAgent.en", "label":"has book artist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10473", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCollectiveAgent.en", "label":"has calligrapher collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10474", "lexicalAlias":"http://rdaregistry.info/Elements/w/sculptorCollectiveAgent.en", "label":"has sculptor collective agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10498", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/artistCollectiveAgent.en", "label":"has artist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10498", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/artistCollectiveAgent.en", "label":"has artist collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10545","label":{"ar":"له هيئة فنانة","ca":"té com a entitat corporativa artista","cs":"má výtvarníka (korporaci)","da":"har korporation, som er kunstner","de":"hat Künstlerin/Künstler (Körperschaft)","de":"hat Künstlerin/Künstler (Körperschaft)","en":"has artist corporate body","es":"tiene organismo corporativo artista","et":"kunstnik (asutus)","fi":"taiteilija (yhteisö)","fr":"a pour collectivité artiste","hu":"művész testülete a következő:","it":"ha come artista ente","lv":"mākslinieks (institūcija)","nl":"heeft kunstenaar-corporatie","no":"har kunstner (korporasjon)","tr":"sanatçı tüzel kişi ile ilişkilidir","zh-Hans-CN":"有美术家团体"},"definition":{"ar":["يربط بين عمل وهيئة تكون مسئولة عن إنشاء تصميم رسومي، ورسم، وتصوير زيتي أصلي، إلخ."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za vytvoření originálního grafického návrhu, kresby, malby atd."],"da":["Relaterer et værk til en korporation, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist."],"en":["Relates a work to a corporate body who is responsible for creating an original graphic design, drawing, painting, etc."],"es":["Relaciona una obra con un organismo corporativo que es responsable de concebir, y frecuentemente implementar, un diseño gráfico, dibujo, pintura, etc. original."],"et":["Seostab teose asutusega, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért."],"it":["Correla un'opera a un ente responsabile della creazione di un un progetto grafico, schizzo, dipinto originali, etc."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is het maken van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc."],"tr":["Bir eseri, orijinal bir grafik tasarımı, çizimi, resmi vb. oluşturmaktan sorumlu tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创作原创图形设计、绘图、绘画等的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة فنانة","ca":"entitat corporativa artista","cs":"výtvarník (korporace)","da":"korporation, som er kunstner","de":"Künstlerin/Künstler (Körperschaft)","de":"Künstlerin/Künstler (Körperschaft)","en":"artist corporate body","es":"organismo corporativo artista","et":"kunstnik (asutus)","fi":"taiteilija (yhteisö)","fr":"collectivité artiste","hu":"művész testület:","it":"artista ente","lv":"mākslinieks (institūcija)","nl":"kunstenaar-corporatie","no":"kunstner (korporasjon)","tr":"sanatçı tüzel kişisi","zh-Hans-CN":"美术家团体"},"ToolkitDefinition":{"ar":"هيئة تكون مسئولة عن إنشاء تصميم رسومي، ورسم، وتصوير زيتي أصلي، إلخ.","ca":"Entitat corporativa que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original.","cs":"Korporace, která je odpovědná za vytvoření originálního grafického návrhu, kresby, malby atd.","da":"Korporation, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc.","de":"Eine Körperschaft, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.","de":"Eine Körperschaft, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.","en":"A corporate body who is responsible for creating an original graphic design, drawing, painting, etc.","es":"Un organismo corporativo que es responsable de concebir, y frecuentemente implementar, un diseño gráfico, dibujo, pintura, etc. original.","et":"Asutus, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest.","fi":"Yhteisö, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.","fr":"Collectivité qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original.","hu":"Egy testület, amely felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért.","it":"Agente collettivo responsabile della creazione di un progetto grafico, schizzo, dipinto originali, etc.","lv":"Institūcija, kas ir atbildīga par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml.","nl":"Een corporatie die verantwoordelijk is het maken van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc.","no":"En korporasjon som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc.","tr":"Özgün bir grafik tasarım, çizim, boyama vb. oluşturmaktan sorumlu olan bir tüzel kişi.","zh-Hans-CN":"负责创作原创图形设计、绘图、绘画等的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
