                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10393", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorAgent.en", "label":"has aggregator agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10444", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerPerson.en", "label":"has compiler person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10448", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/aggregatorPerson.en", "label":"has aggregator person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10448", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/aggregatorPerson.en", "label":"has aggregator person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10286","label":{"ar":"له شخص مدعى عليه","ca":"té com a persona acusada","cs":"má žalovanou/obžalovanou osobu","da":"har sagsøgt person","de":"hat Angeklagte/Angeklagten/Beklagte/Beklagten (Person)","de":"hat Angeklagte/Angeklagten/Beklagte/Beklagten (Person)","el":"έχει εναγόμενο φυσικό πρόσωπο","en":"has defendant person","es":"tiene persona demandada","et":"kostja (isik)","fi":"henkilövastaaja","fr":"a pour personne défenderesse","hu":"alperes személye a következő:","it":"ha come imputato persona","lv":"atbildētājs (persona)","nl":"heeft verweerder-persoon","no":"har saksøkt person","tr":"davalı kişisi ile ilişkilidir","vi":"có cá nhân bị đơn","zh-Hans-CN":"有被告个人"},"definition":{"ar":["يربط بين عمل وشخص متهم في دعوى جنائية أو يحاكم في دعوى مدنية."],"ca":["Relaciona una obra amb una persona que és acusada en un procés penal o demandada en un procés civil."],"cs":["Vztahuje dílo k osobě, která je obviněna v trestním řízení nebo žalována v civilním řízení."],"da":["Relaterer et værk til en person, som er anklaget i en straffesag eller sagsøgt i en civilsag."],"de":["Setzt ein Werk in Beziehung zu einer Person, die in einem Strafverfahren angeklagt oder in einem Zivilverfahren verklagt ist.,Setzt ein Werk in Beziehung zu einer Person, die in einem Strafverfahren angeklagt oder in einem Zivilverfahren verklagt ist."],"el":["Συνδέει ένα έργο με ένα φυσικό πρόσωπο, το οποίο έχει κατηγορηθεί σε μία ποινική διαδικασία ή έχει ασκηθεί αγωγή εναντίον του στο πλαίσιο αστικής διαδικασίας."],"en":["Relates a work to a person who is accused in a criminal proceeding or sued in a civil proceeding."],"es":["Relaciona una obra con una persona que está imputada en un proceso penal o demandada en un proceso civil."],"et":["Seostab teose isikuga, kelle vastu on esitatud süüdistus kriminaalkohtumenetluses või hagi tsiviilkohtumenetluses."],"fi":["Liittää teoksen henkilöön, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne."],"fr":["Met une œuvre en relation avec une personne qui est accusée dans une poursuite criminelle ou contre laquelle une poursuite civile est intentée."],"hu":["Hozzákapcsol egy művet egy személyhez, akit büntetőjogi eljárásban vádolnak, vagy polgári jogi eljárásban perelnek."],"it":["Correla un’opera a una persona accusata in un procedimento penale o citata in un procedimento civile."],"lv":["Sasaista darbu ar personu, kura ir apzūdzēta kriminālprocesā vai iesūdzēta civilprocesā."],"nl":["Relateert een werk aan een persoon die beschuldigd wordt in een strafproces of gedaagd wordt in een civielrechtelijke procedure."],"no":["Relaterer et verk til en person som er tiltalt i en straffesak eller saksøkt i en sivilrettslig sak."],"tr":["Bir eseri, bir ceza davasında suçlanan veya bir hukuk davasında dava edilen kişiyle ilişkilendirir."],"vi":["Liên kết tác phẩm với cá nhân bị buộc tội trong vụ kiện hình sự hoặc bị kiện trong vụ kiện dân sự."],"zh-Hans-CN":["将一种作品与在刑事或民事诉讼中被控告的一个个人关联起来。"]},"ToolkitLabel":{"ar":"له شخص مدعى عليه","ca":"persona acusada","cs":"žalovaná/obžalovaná osoba","da":"sagsøgt person","de":"Angeklagte/Angeklagter/Beklagte/Beklagter (Person)","de":"Angeklagte/Angeklagter/Beklagte/Beklagter (Person)","el":"εναγόμενο φυσικό πρόσωπο","en":"defendant person","es":"persona demandada","et":"kostja (isik)","fi":"henkilövastaaja","fr":"personne défenderesse","hu":"alperes személy:","it":"imputato persona","lv":"atbildētājs (persona)","nl":"verweerder-persoon","no":"saksøkt person","tr":"sanık kişi","vi":"cá nhân bị đơn","zh-Hans-CN":"被告个人"},"ToolkitDefinition":{"ar":"شخص متهم في دعوى جنائية أو يحاكم في دعوى مدنية.","ca":"Persona que és acusada en un procés penal o demandada en un procés civil.","cs":"Osoba, která je obviněna v trestním řízení nebo žalována v civilním řízení.","da":"Person, som er anklaget i en straffesag eller sagsøgt i en civilsag.","de":"Eine Person, die in einem Strafverfahren angeklagt oder in einem Zivilverfahren verklagt ist.","de":"Eine Person, die in einem Strafverfahren angeklagt oder in einem Zivilverfahren verklagt ist.","el":"Ένα φυσικό πρόσωπο, το οποίο έχει κατηγορηθεί σε μία ποινική διαδικασία ή έχει ασκηθεί αγωγή εναντίον του στο πλαίσιο αστικής διαδικασίας.","en":"A person who is accused in a criminal proceeding or sued in a civil proceeding.","es":"Una persona que está imputada en un proceso penal o demandada en un proceso civil.","et":"Isik, kelle vastu on esitatud süüdistus kriminaalkohtumenetluses või hagi tsiviilkohtumenetluses.","fi":"Henkilö, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne.","fr":"Personne qui est accusée dans une poursuite criminelle ou contre laquelle une poursuite civile est intentée.","hu":"Egy személy, aki büntetőjogi eljárásban vádolnak, vagy polgári jogi eljárásban perelnek.","it":"Persona accusata in un procedimento penale o citata in un procedimento civile.","lv":"Persona, kura ir apzūdzēta kriminālprocesā vai iesūdzēta civilprocesā.","nl":"Een persoon die beschuldigd wordt in een strafproces of gedaagd wordt in een civielrechtelijke procedure.","no":"En person som er tiltalt i en straffesak eller saksøkt i en sivilrettslig sak.","tr":"Bir ceza davasında suçlanan veya bir hukuk davasında dava edilen kişi.","vi":"Cá nhân bị buộc tội trong vụ kiện hình sự hoặc bị kiện trong vụ kiện dân sự.","zh-Hans-CN":"在刑事或民事诉讼中被控告的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
