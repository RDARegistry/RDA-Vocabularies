                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/filmmakerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10063", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmmakerAgent.en", "label":"has filmmaker agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10450", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/filmmakerPerson.en", "label":"has filmmaker person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10450", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/filmmakerPerson.en", "label":"has filmmaker person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10073","label":{"ar":"وكيل منتج أفلام","ca":"té com a agent productor cinematogràfic","cs":"má filmového producenta (agenta)","da":"har agent, som er filmproducer","de":"hat Filmproduzentin/Filmproduzenten (Akteur)","de":"hat Filmproduzentin/Filmproduzenten (Akteur)","el":"έχει παραγωγό","en":"has film producer agent","es":"tiene agente productor fílmico","et":"filmiprodutsent (tegija)","fi":"elokuvatuottaja (toimija)","fr":"a pour agent producteur de cinéma","hu":"filmproducer ágense a következő:","it":"ha come produttore cinematografico agente","lv":"filmas producents (aģents)","nl":"heeft filmproducent-actor","no":"har filmprodusent (agent)","tr":"film yapımcısı kişisi ile ilişkilidir","vi":"có nhà sản xuất phim","zh-Hans-CN":"有电影制作者行为者"},"definition":{"ar":["يربط بين عمل ووكيل عبارة عن منتج مسئول عن معظم جوانب العمل في إنتاج فيلم."],"ca":["Relaciona una obra amb un agent que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula."],"cs":["Vztahuje dílo k agentovi, který je producentem, odpovědným za většinu obchodních aspektů výroby filmu."],"da":["Relaterer et værk til en agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film."],"de":["Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές μιας παραγωγής επί της οθόνης, ηχογράφησης, τηλεοπτικής, διαδικτυακής κ.λπ."],"en":["Relates a work to an agent who is a producer who is responsible for most of the business aspects of the production of a film."],"es":["Relaciona una obra con un agente que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de un film."],"et":["Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel."],"fi":["Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta."],"fr":["Met une œuvre en relation avec un agent producteur qui est responsable de la majeure partie des aspects commerciaux de la production d’un film."],"hu":["Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy filmprodukció üzleti vonatkozásainak a zöméért."],"it":["Correla un'opera all'agente produttore responsabile della maggior parte degli aspetti commerciali di un film."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par filmas uzņemšanas finansiālajiem aspektiem."],"nl":["Relateert een werk aan een actor die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film."],"no":["Relaterer et verk til en agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film."],"tr":["Bir eseri, bir filmin yapımının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với nhà sản xuất có trách nhiệm với phần lớn khía cạnh kinh doanh của phim."],"zh-Hans-CN":["将一种作品与作为制作者并负责电影制作的大部分商业运作的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل منتج أفلام","ca":"agent productor cinematogràfic","cs":"filmový producent (agent)","da":"agent, som er filmproducer","de":"Filmproduzentin/Filmproduzenten (Akteur)","de":"Filmproduzentin/Filmproduzenten (Akteur)","el":"παραγωγός","en":"film producer agent","es":"agente productor fílmico","et":"filmiprodutsent (tegija)","fi":"elokuvatuottaja (toimija)","fr":"agent producteur de cinéma","hu":"filmproducer ágens:","it":"produttore cinematografico agente","lv":"filmas producents (aģents)","nl":"filmproducent-actor","no":"filmprodusent (agent)","tr":"film yapımcısı temsilcisi","vi":"nhà sản xuất phim","zh-Hans-CN":"电影制作者行为者"},"ToolkitDefinition":{"ar":"وكيل عبارة عن منتج مسئول عن معظم جوانب العمل في إنتاج فيلم.","ca":"Agent que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula.","cs":"Agent, který je producentem, odpovědným za většinu obchodních aspektů výroby filmu.","da":"Agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film.","de":"Eine Produzentin/Ein Produzent (Akteur), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.","de":"Eine Produzentin/Ein Produzent (Akteur), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τις περισσότερες επιχειρηματικές πτυχές μιας ταινίας.","en":"An agent who is a producer who is responsible for most of the business aspects of the production of a film.","es":"Un agente que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de un film.","et":"Tegija, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel.","fi":"Toimija, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta.","fr":"Agent producteur qui est responsable de la majeure partie des aspects commerciaux de la production d’un film.","hu":"Egy producer ágens, aki felelős egy film üzleti vonatkozásainak a zöméért.","it":"Agente produttore responsabile della maggior parte degli aspetti commerciali di un film.","lv":"Aģents, kas ir atbildīgs par filmas uzņemšanas finansiālajiem aspektiem.","nl":"Een actor die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film.","no":"En agent som er en produsent men ansvar for de fleste forretningsmessige aspektene ved en film.","tr":"Bir filmin yapımının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan temsilci.","vi":"Nhà sản xuất có trách nhiệm với phần lớn khía cạnh kinh doanh của phim.","zh-Hans-CN":"作为制作者并负责电影制作的大部分商业运作的一个行为者"},"altLabel":{"ar":["منتج أفلام"],"ca":["productor cinematogràfic"],"cs":["filmový producent"],"da":["filmproducer"],"de":["Filmproduzent,Filmproduzent"],"en":["film producer"],"es":["productor fílmico"],"et":["filmiprodutsent"],"fi":["elokuvatuottaja"],"fr":["producteur de cinéma,agent producteur de film"],"hu":["filmproducer:"],"it":["produttore cinematografico"],"nl":["filmproducent"],"no":["filmprodusent"],"tr":["film yapımcısı"],"zh-Hans-CN":["电影制作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
