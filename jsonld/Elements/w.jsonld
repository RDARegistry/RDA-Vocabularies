                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/hierarchicFindingAidOf.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10624", "lexicalAlias":"http://rdaregistry.info/Elements/w/findingAidOf.en", "label":"is finding aid of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10626", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/hierarchicFindingAidOf.en", "label":"is hierarchic finding aid of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10626", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/hierarchicFindingAidOf.en", "label":"is hierarchic finding aid of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10627","label":{"ca":"és índex de","cs":"je indexem pro","de":"ist Indexierung für","en":"is index for","es":"es índice para","fi":"hakemisto manifestaatiolle","fr":"est un index de","hu":"mutatója a következőnek:","nl":"is index voor","tr":"dizinidir","zh-Hans-CN":"是……的索引"},"definition":{"ca":["Relaciona una obra amb una manifestació d’una obra textual que és la base d’una guia sistemàtica del contingut de la manifestació."],"cs":["Vztahuje dílo k provedení textového díla, které je základem pro systematického průvodce obsahem provedení."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das eine systematische, alphabetische Orientierungshilfe zum Inhalte eines anderen Werks bietet."],"en":["Relates a work to a manifestation of a textual work that is the basis of a systematic guide of the content of the manifestation."],"es":["Relaciona una obra con una manifestación de una obra textual que es la base de una guía sistemática del contenido de la manifestación."],"fi":["Liittää teoksen manifestaation sisällön systemaattisen oppaan perustana olevan tekstiteoksen manifestaatioon."],"fr":["Met une œuvre en relation avec une manifestation d’une œuvre textuelle qui constitue la base d’un guide systématique du contenu de la manifestation."],"hu":["Hozzákapcsol egy művet egy szöveges mű megjelenési formájához, amely alapul szolgál a megjelenési forma tartalmának szisztematikus útmutatójához."],"nl":["Relateert een werk aan een manifestatie van een tekstwerk dat de basis is van een systematische gids van de inhoud van de manifestatie."],"tr":["Bir eseri, gösterim içeriğinin sistematik bir rehberinin temeli olan metinsel bir eseri bir gösterim ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为其载体表现的内容的系统性指引的基础的一种文字作品的一种载体表现关联起来。"]},"ToolkitLabel":{"ca":"índex per","cs":"index pro","de":"ist Index zu","en":"index for","es":"índice para","fi":"hakemisto manifestaatiolle","fr":"index de","hu":"mutatója:","nl":"index voor","tr":"dizinidir","zh-Hans-CN":"……的索引"},"ToolkitDefinition":{"ca":"Manifestació d’una obra textual que és la base d’una guia sistemàtica del contingut de la manifestació.","cs":"Provedení textového díla, které je základem pro systematického průvodce obsahem provedení.","de":"Ein Werk, das eine systematische, alphabetische Orientierungshilfe zum Inhalte eines anderen Werks bietet.","en":"A manifestation of a textual work that is the basis of a systematic guide of the content of the manifestation.","es":"Una manifestación de una obra textual que es la base de una guía sistemática del contenido de la manifestación.","fi":"Manifestaation sisällön systemaattisen oppaan perustana olevan tekstiteoksen manifestaatio.","fr":"Manifestation d’une œuvre textuelle qui constitue la base d’un guide systématique du contenu de la manifestation.","hu":"Egy szöveges mű megjelenési formája, amely alapul szolgál a megjelenési forma tartalmának szisztematikus útmutatójához.","nl":"Een manifestatie van een tekstwerk dat de basis is van een systematische gids van de inhoud van de manifestatie.","tr":"Gösterim içeriğinin sistematik bir rehberin temeli olan metinsel bir çalışmanın gösterimi.","zh-Hans-CN":"作为其载体表现的内容的系统性指引的基础的一种文字作品的一种载体表现"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
