                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/aspectRatioOfRepresentativeExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/datatype/P10347", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/aspectRatioOfRepresentativeExpression.en", "label":"has aspect ratio of representative expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10304","label":{"ar":"له وكيل منتج صوت","ca":"té com a agent productor d’àudio","cs":"má producenta zvukového záznamu (agenta)","da":"har agent, som er lydproducer","de":"hat Produzentin/Produzenten einer Tonaufnahme (Akteur)","de":"hat Produzentin/Produzenten einer Tonaufnahme (Akteur)","el":"έχει παραγωγό ήχου","en":"has audio producer agent","es":"tiene agente productor de audio","et":"audioprodutsent (tegija)","fi":"äänituottaja (toimija)","fr":"a pour agent producteur audio","hu":"audioproducer ágense a következő:","it":"ha come produttore audio agente","lv":"skaņu ierakstu producents (aģents)","nl":"heeft geluidsproducent-actor","no":"har lydprodusent (agent)","tr":"ses yapımcısı temsilcisi ile ilişkilidir","vi":"có nhà sản xuất audio","zh-Hans-CN":"有音频制作者行为者"},"definition":{"ar":["يربط بين عمل ووكيل يكون منتجًا مسئولاً عن إدارة معظم جوانب العمل في تسجيل صوتي."],"ca":["Relaciona una obra amb un agent que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio."],"cs":["Vztahuje dílo k agentovi, který je producentem, odpovědným za řízení většiny obchodních aspektů zvukového záznamu."],"da":["Relaterer et værk til en agent, som er en producer, som er ansvarlig for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse."],"de":["Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές μιας ηχογράφησης."],"en":["Relates a work to an agent who is a producer who is responsible for managing most of the business aspects of an audio recording."],"es":["Relaciona una obra con un agente quien es un productor que es responsable de gestionar la mayoría de los aspectos comerciales de una grabación de audio."],"et":["Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel."],"fi":["Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta."],"fr":["Met une œuvre en relation avec un agent producteur qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio."],"hu":["Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy hangfelvétel üzleti vonatkozásainak a zöméért."],"it":["Correla un’opera all'agente produttore responsabile per la gestione della maggior parte degli aspetti commerciali di una registrazione audio."],"lv":["Sasaista darbu ar producentu aģentu, kas ir atbildīgs par skaņu ieraksta biznesa aspektiem."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname."],"no":["Relaterer et verk til en agent som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak."],"tr":["Bir eseri, bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với nhà sản xuất có trách nhiệm về phần lớn khía cạnh kinh doanh của bản ghi audio."],"zh-Hans-CN":["将一种作品与作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل منتج صوت","ca":"agent productor d’àudio","cs":"producent zvukového záznamu (agent)","da":"agent, som er lydproducer","de":"Produzentin/Produzent einer Tonaufnahme (Akteur)","de":"Produzentin/Produzent einer Tonaufnahme (Akteur)","el":"παραγωγός ήχου","en":"audio producer agent","es":"agente productor de audio","et":"audioprodutsent (tegija)","fi":"äänituottaja (toimija)","fr":"agent producteur audio","hu":"audioproducer ágens:","it":"produttore audio agente","lv":"skaņu ierakstu producents (aģents)","nl":"geluidsproducent-actor","no":"lydprodusent (agent)","tr":"ses yapımcısı temsilci","vi":"nhà sản xuất audio","zh-Hans-CN":"音频制作者行为者"},"ToolkitDefinition":{"ar":"وكيل يكون منتجًا مسئولاً عن إدارة معظم جوانب العمل في تسجيل صوتي.","ca":"Agent que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.","cs":"Agent, který je producentem, odpovědným za řízení většiny obchodních aspektů zvukového záznamu.","da":"Agent, som er en producer, som er ansvarlig for de fleste forretningsmæssige aspekter af en lydoptagelse.","de":"Eine Produzentin/Ein Produzent (Akteur), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.","de":"Eine Produzentin/Ein Produzent (Akteur), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.","el":"Ένας παραγωγός υπεύθυνος για τις περισσότερες επιχειρηματικές πτυχές μιας ηχογράφησης.","en":"An agent who is a producer who is responsible for managing most of the business aspects of an audio recording.","es":"Un agente quien es un productor que es responsable de gestionar la mayoría de los aspectos comerciales de una grabación de audio.","et":"Tegija, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel.","fi":"Toimija, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.","fr":"Agent producteur qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio.","hu":"Egy producer ágens, amely felelős egy hangfelvétel üzleti vonatkozásainak a zöméért.","it":"Agente produttore responsabile per la gestione della maggior parte degli aspetti commerciali di una registrazione audio.","lv":"Producents aģents, kas ir atbildīgs par skaņu ieraksta biznesa aspektiem.","nl":"Een actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.","no":"En agent som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak.","tr":"Bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu olan bir yapımcı olan temsilci.","vi":"Nhà sản xuất có trách nhiệm về phần lớn khía cạnh kinh doanh của bản ghi audio.","zh-Hans-CN":"作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个行为者"},"altLabel":{"ar":["منتج صوت"],"ca":["productor d’àudio"],"da":["lydproducer"],"de":["Produzent einer Tonaufnahme,Produzent einer Tonaufnahme"],"en":["audio producer"],"es":["productor de audio"],"et":["audioprodutsent"],"fi":["äänituottaja"],"fr":["producteur audio"],"hu":["audioproducer:"],"it":["produttore audio"],"no":["lydprodusent"],"tr":["ses yapımcısı"],"zh-Hans-CN":["音频制作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
