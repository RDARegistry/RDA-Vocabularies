                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/recordingSource.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10404", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/recordingSource.en", "label":"has recording source"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10404", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/recordingSource.en", "label":"has recording source"}]},{"@id":"http://rdaregistry.info/Elements/w/P10296","ToolkitLabel":{"ca":"relació d’obra referencial","da":"henvisende værkrelation med","de":"Referenzbeziehung auf Werkebene","el":"σχέσεις αναφοράς έργου με","es":"relación obra referencial","fi":"teoksen viittaussuhde","fr":"relation d’œuvre référentielle","no":"relasjonstypen henvisende verk","vi":"mối quan hệ tác phẩm tham chiếu với"},"ToolkitDefinition":{"ca":"Obra que referencia una altra obra.","da":"Værk der henviser til et andet værk.","de":"Ein Werk, das auf ein anderes Werk verweist.","el":"Ένα έργο που παραπέμπει σε ένα άλλο έργο.","es":"Una obra que hace referencia a la obra.","fi":"Teos, johon toinen teos viittaa.","fr":"Œuvre qui fait référence à une autre œuvre.","no":"Et verk som henviser til et annet verk.","vi":"Tác phẩm tham chiếu tác phẩm khác."},"label":{"ca":"té com a relació d’obra referencial","da":"har henvisende værkrelation med","de":"hat Referenzbeziehung auf Werkebene","el":"έχει σχέσεις αναφοράς έργου με","fi":"teoksen viittaussuhde","fr":"a pour relation d’œuvre référentielle","vi":"có mối quan hệ tác phẩm tham chiếu với"},"definition":{"ca":["Relaciona una obra amb una obra que referencia una altra obra."],"da":["Relaterer et værk til et værk der henviser til et andet værk."],"de":["Setzt ein Werk mit einem Werk, das auf ein anderes Werk verweist, in Beziehung."],"el":["Συνδέει ένα έργο με ένα έργο που παραπέμπει σε ένα άλλο έργο."],"fi":["Liittää teoksen teokseen, johon toinen teos viittaa."],"fr":["Met une œuvre en relation avec une œuvre qui fait référence à une autre œuvre."],"vi":["Liên kết tác phẩm với tác phẩm tham chiếu tác phẩm khác."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
