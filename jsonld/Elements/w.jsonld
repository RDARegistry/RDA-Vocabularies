                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsScreenplayWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10094", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsMotionPictureScreenplayWork.en", "label":"is adapted as motion picture screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/P10096", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsTelevisionScreenplayWork.en", "label":"is adapted as television screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/P10097", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsVideoScreenplayWork.en", "label":"is adapted as video screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10095", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsScreenplayWork.en", "label":"is adapted as screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10095", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsScreenplayWork.en", "label":"is adapted as screenplay work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10173","label":{"ar":"هو سيناريو عمل فيلم سينمائي","ca":"és obra de guió per a pel·lícula cinematogràfica","cs":"je scénářem pro film (dílo)","da":"er manuskript til filmværk","de":"ist Drehbuch für Film (Werk)","de":"ist Drehbuch für Film (Werk)","el":"είναι σενάριο για κινηματογραφική ταινία (έργο)","en":"is screenplay for motion picture work","es":"es un guión para una obra cinematográfica","et":"stsenaarium filmiteosele","fi":"käsikirjoitus elokuvaan (teos)","fr":"est un scénario pour un film (œuvre)","hu":"forgatókönyve a következő filmműnek:","it":"è sceneggiatura per opera cinematografica","lv":"ir kinoscenārijs darbam","nl":"is scenario voor speelfilmwerk","no":"er manus for spillefilm (verk)","tr":"sinema filmi eseri için senaryodur","vi":"là kịch bản cho điện ảnh (tác phẩm)","zh-Hans-CN":"是电影作品的剧本"},"definition":{"ar":["يربط عمل بعمل عبارة عن فيلم سينمائي يكمله عمل نصي."],"ca":["Relaciona una obra amb una obra que és una pel·lícula cinematogràfica que es complementa amb una obra textual."],"cs":["Vztahuje dílo k dílu, které je filmovým dílem, které je doplněno textovým dílem."],"da":["Relaterer et værk til et værk, som er en spillefilm, som er komplementeret af et tekstværk."],"de":["Setzt ein Werk in Beziehung zu einem Filmwerk, das durch ein textliches Werk vervollständigt wird.,Setzt ein Werk in Beziehung zu einem Filmwerk, das durch ein textliches Werk vervollständigt wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιεί το κείμενο ως σενάριο για μια κινηματογραφική ταινία."],"en":["Relates a work to a work that is a motion picture that is complemented by a textual work."],"es":["Relaciona una obra con una obra que es una película que se complementa con una obra textual."],"et":["Seostab teose filmiteosega, mis on täiendatud tekstteosega."],"fi":["Liittää teoksen teokseen, joka on elokuva, jota täydentää tekstiteos."],"fr":["Met une œuvre en relation avec une œuvre cinématographique qui est complétée par une œuvre textuelle."],"hu":["Hozzákapcsol egy művet egy mozgóképműhöz, amelyet egy szöveges mű egészít ki."],"it":["Correla un’opera a un’opera che è un film che è completata da un’opera testuale."],"lv":["Sasaista darbu ar darbu, kas ir kinofilma, kurā izmantots tekstuāls darbs kā scenārijs."],"nl":["Relateert een werk aan een werk dat een speelfilm is dat is gecomplementeerd door een tekstwerk."],"no":["Relaterer et verk til et verk som er en spillefilm som utfylles av et tekstlig verk."],"tr":["Bir eseri, metinsel bir eserle tamamlanan bir sinema filmi olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sử dụng văn bản như là kịch bản cho phim điện ảnh."],"zh-Hans-CN":["将一种作品与作为一种电影并被一种文字作品补充的一种作品关联起来。"]},"ToolkitLabel":{"ar":"سيناريو عمل فيلم سينمائي","ca":"obra de guió per a pel·lícula cinematogràfica","cs":"scénář pro film (dílo)","da":"manuskript til filmværk","de":"Drehbuch für Film (Werk)","de":"Drehbuch für Film (Werk)","el":"σενάριο για κινηματογραφική ταινία (έργο)","en":"screenplay for motion picture work","es":"guión para una obra cinematográfica","et":"stsenaarium filmiteosele","fi":"käsikirjoitus elokuvaan (teos)","fr":"scénario pour un film (œuvre)","hu":"filmmű-forgatókönyv:","it":"sceneggiatura per opera cinematografica","lv":"kinoscenārijs darbam","nl":"scenario voor speelfilmwerk","no":"manus for spillefilm (verk)","tr":"sinema filmi eseri için senaryo","vi":"kịch bản cho điện ảnh (tác phẩm)","zh-Hans-CN":"电影作品的剧本"},"ToolkitDefinition":{"ar":"عمل عبارة عن فيلم سينمائي يكمله عمل نصي.","ca":"Obra que és una pel·lícula cinematogràfica que es complementa amb una obra textual.","cs":"Dílo, které je filmovým dílem, které je doplněno textovým dílem.","da":"Værk, som er en spillefilm, som er komplementeret af et tekstværk.","de":"Ein Filmwerk, das durch ein textliches Werk vervollständigt wird.","de":"Ein Filmwerk, das durch ein textliches Werk vervollständigt wird.","el":"Ένα έργο το οποίο χρησιμοποιεί το κείμενο ως σενάριο για μια κινηματογραφική ταινία.","en":"A work that is a motion picture that is complemented by a textual work.","es":"Una obra que es una película que se complementa con una obra textual.","et":"Filmiteos, mis on täiendatud tekstteosega.","fi":"Teos, joka on elokuva, jota täydentää tekstiteos.","fr":"Œuvre cinématographique qui est complétée par une œuvre textuelle.","hu":"Egy mozgóképmű, amelyet egy szöveges mű egészít ki.","it":"Opera che è un film completata da un’opera testuale.","lv":"Darbs, kas ir kinofilma, kurā izmantots tekstuāls darbs kā scenārijs.","nl":"Een werk dat een speelfilm is dat is gecomplementeerd door een tekstwerk.","no":"Et verk som er en spillefilm som utfylles av et tekstlig verk.","tr":"Metinsel bir eserle tamamlanan bir sinema filmi olan eser.","vi":"Tác phẩm sử dụng văn bản như là kịch bản cho phim điện ảnh.","zh-Hans-CN":"作为一种电影并被一种文字作品补充的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10105", "lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayForWork.en", "label":"is screenplay for work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayForMotionPictureWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10173", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/screenplayForMotionPictureWork.en", "label":"is screenplay for motion picture work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10173", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/screenplayForMotionPictureWork.en", "label":"is screenplay for motion picture work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10159","label":{"ar":"له عمل سيناريو","ca":"té com a obra de guió","cs":"má scénář (dílo)","da":"har manuskriptværk","de":"hat Drehbuch (Werk)","de":"hat Drehbuch (Werk)","el":"είναι σενάριο (έργο)","en":"has screenplay work","es":"tiene obra de guion","et":"stsenaarium (teos)","fi":"käsikirjoitus (teos)","fr":"a pour scénario (œuvre)","hu":"forgatókönyv-műve a következő:","it":"ha come sceneggiatura opera","lv":"darbs: scenārijs","nl":"heeft scenariowerk","no":"har manus (verk)","tr":"senaryo eseri ile ilişkilidir","vi":"là kịch bản (tác phẩm)","zh-Hans-CN":"有影视剧剧本作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل نصي يكمل عملًا يستخدم سيناريو."],"ca":["Relaciona una obra amb una obra que és una obra textual que complementa una obra que usa un guió."],"cs":["Vztahuje dílo k dílu, které je textovým dílem, doplňujícím dílo, které využívá scénář."],"da":["Relaterer et værk til et værk, som er et tekstværk, som komplementerer et værk, som anvender et manuskript."],"de":["Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Werk ergänzt, welches ein Drehbuch verwendet.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Werk ergänzt, welches ein Drehbuch verwendet."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο παρέχει το κείμενο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο."],"en":["Relates a work to a work that is a textual work that complements a work that uses a screenplay."],"es":["Relaciona una obra con una obra que es una obra textual que complementa una obra que utiliza un guion."],"et":["Seostab teose tekstteosega, mis täiendab stsenaariumi põhjal valminud teost."],"fi":["Liittää teoksen teokseen, joka on tekstiteos, joka täydentää teosta, joka käyttää käsikirjoitusta."],"fr":["Met une œuvre en relation avec une œuvre textuelle qui complète une œuvre qui utilise un scénario."],"hu":["Hozzákapcsol egy művet egy szöveges műhöz, amely kiegészít egy forgatókönyvet használó művet."],"it":["Correla un’opera a un’opera testuale che completa un’opera che utilizza una sceneggiatura."],"lv":["Sasaista darbu ar darbu, kas ir realizēts kā teksts, kas papildina darbu, kas ir lieto scenāriju."],"nl":["Relateert een werk aan een werk dat een tekstwerk is dat een werk complementeert dat een scenario gebruikt."],"no":["Relaterer et verk til et verk som er et tekstlig verk som utfyller et verk som bruker et manus."],"tr":["Bir eseri, senaryo kullanan bir eseri tamamlayan metinsel bir eser olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm cung cấp văn bản cho phim điện ảnh, chương trình truyền hình hoặc video."],"zh-Hans-CN":["将一种作品与作为一种文字作品并补充使用一种影视剧剧本的一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل سيناريو","ca":"obra de guió","cs":"scénář (dílo)","da":"manuskriptværk","de":"Drehbuch (Werk)","de":"Drehbuch (Werk)","el":"σενάριο (έργο)","en":"screenplay work","es":"obra de guion","et":"stsenaarium (teos)","fi":"käsikirjoitus (teos)","fr":"scénario (œuvre)","hu":"forgatókönyvmű:","it":"sceneggiatura opera","lv":"darbs: scenārijs","nl":"scenariowerk","no":"manus (verk)","tr":"senaryo eseri","vi":"kịch bản (tác phẩm)","zh-Hans-CN":"影视剧剧本作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل نصي يكمل عملًا يستخدم سيناريو.","ca":"Obra que és una obra textual que complementa una obra que usa un guió.","cs":"Dílo, které je textovým dílem, doplňujícím dílo, které využívá scénář.","da":"Værk, som er et tekstværk, som komplementerer et værk, som anvender et manuskript.","de":"Ein textliches Werk, das ein Werk ergänzt, welches ein Drehbuch verwendet.","de":"Ein textliches Werk, das ein Werk ergänzt, welches ein Drehbuch verwendet.","el":"Ένα έργο το οποίο παρέχει το κείμενο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή βίντεο.","en":"A work that is a textual work that complements a work that uses a screenplay.","es":"Una obra que es una obra textual que complementa una obra que utiliza un guion.","et":"Tekstteos, mis täiendab stsenaariumi põhjal valminud teost.","fi":"Teos, joka on tekstiteos, joka täydentää teosta, joka käyttää käsikirjoitusta.","fr":"Œuvre textuelle qui complète une œuvre qui utilise un scénario.","hu":"Egy szövegse mű, amely kiegészít egy forgatókönyvet használó művet.","it":"Opera testuale che completa un’opera che utilizza una sceneggiatura.","lv":"Darbs, kas ir realizēts kā teksts, kas papildina darbu, kas ir lieto scenāriju.","nl":"Een werk dat een tekstwerk is dat een werk complementeert dat een scenario gebruikt.","no":"Et verk som er et tekstlig verk som utfyller et verk som bruker et manus.","tr":"Senaryo kullanan bir eseri tamamlayan metinsel bir eser olan bir çalışma.","vi":"Tác phẩm cung cấp văn bản cho phim điện ảnh, chương trình truyền hình hoặc video.","zh-Hans-CN":"作为一种文字作品并补充使用一种影视剧剧本的一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10371", "lexicalAlias":"http://rdaregistry.info/Elements/w/textWork.en", "label":"has text work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10160", "lexicalAlias":"http://rdaregistry.info/Elements/w/motionPictureScreenplayWork.en", "label":"has motion picture screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/P10163", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionScreenplayWork.en", "label":"has television screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/P10164", "lexicalAlias":"http://rdaregistry.info/Elements/w/videoScreenplayWork.en", "label":"has video screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10159", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/screenplayWork.en", "label":"has screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10159", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/screenplayWork.en", "label":"has screenplay work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10299","label":{"ar":"له وكيل مؤسس لعمل","ca":"té com a agent fundador d’una obra","cs":"má zakladatele díla (agenta)","da":"har agent, som er stifter af værk","de":"hat Begründerin/Begründer eines Werks (Akteur)","de":"hat Begründerin/Begründer eines Werks (Akteur)","el":"έχει θεμελιωτή του έργου","en":"has founder agent of work","es":"tiene agente fundador de obra","et":"teose asutaja (tegija)","fi":"teoksen perustaja (toimija)","fr":"a pour agent fondateur d’une œuvre","hu":"mű alapító ágense a következő:","it":"ha come fondatore agente di un'opera","lv":"darba dibinātājs (aģents)","nl":"heeft oprichter-actor van werk","no":"har grunnlegger av verk (agent)","tr":"eserin kurucu temsilcisi ile ilişkilidir","vi":"có người tạo lập tác phẩm","zh-Hans-CN":"有作品的创办者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن بدء عمل ممتد زمنيًا."],"ca":["Relaciona una obra amb un agent que és responsable d’iniciar una obra diacrònica."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za iniciování diachronního díla."],"da":["Relaterer et værk til en agent, som er ansvarlig for at igangsætte et diakronisk værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für das Begründen eines diachronen Werks verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für das Begründen eines diachronen Werks verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για την ίδρυση ενός περιοδικού, ενός ενσωματωμένου πόρου ή μιας πολυμερούς μονογραφίας."],"en":["Relates a work to an agent who is responsible for initiating a diachronic work."],"es":["Relaciona una obra con un agente que es responsable de iniciar una obra diacrónica."],"et":["Seostab teose tegijaga, kes vastutab diakroonilise teose ellukutsumise eest."],"fi":["Liittää teoksen toimijaan, joka on vastuussa diakronisen teoksen alullepanosta."],"fr":["Met une œuvre en relation avec un agent qui est responsable de lancer une œuvre diachronique."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy diakronikus mű indításáért."],"it":["Correla un'opera a un agente responsabile dell'avvio di un'opera diacronica."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het initiëren van een diachronisch werk."],"no":["Relaterer et verk til en agent som har ansvar for å etablere et diakronisk verk."],"tr":["Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập ấn phẩm nhiều kỳ, tài nguyên tích hợp, hoặc chuyên khảo nhiều phần."],"zh-Hans-CN":["将一种作品与负责发起一种历时作品的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مؤسس لعمل","ca":"agent fundador d’una obra","cs":"zakladatel díla (agent)","da":"agent, som er stifter af værk","de":"Begründerin/Begründer eines Werks (Akteur)","de":"Begründerin/Begründer eines Werks (Akteur)","el":"θεμελιωτής του έργου","en":"founder agent of work","es":"agente fundador de obra","et":"teose asutaja (tegija)","fi":"teoksen perustaja (toimija)","fr":"agent fondateur d’une œuvre","hu":"műalapító ágens:","it":"fondatore agente di opera","lv":"darba dibinātājs (aģents)","nl":"oprichter-actor van werk","no":"grunnlegger av verk (agent)","tr":"eserin kurucu temsilcisi","vi":"người tạo lập tác phẩm","zh-Hans-CN":"作品的创办者行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن بدء عمل ممتد زمنيًا.","ca":"Agent que és responsable d’iniciar una obra diacrònica.","cs":"Agent, který je odpovědný za iniciování diachronního díla.","da":"Agent, som er ansvarlig for at igangsætte et diakronisk værk.","de":"Ein Akteur, der für das Begründen eines diachronen Werks verantwortlich ist.","de":"Ein Akteur, der für das Begründen eines diachronen Werks verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για την ίδρυση ενός περιοδικού, ενός ενσωματωμένου πόρου ή μιας πολυμερούς μονογραφίας.","en":"An agent who is responsible for initiating a diachronic work.","es":"Un agente que es responsable de iniciar una obra diacrónica.","et":"Tegija, kes vastutab diakroonilise teose ellukutsumise eest.","fi":"Toimija, joka on vastuussa diakronisen teoksen alullepanosta.","fr":"Agent qui est responsable de lancer une œuvre diachronique.","hu":"Egy ágens, amely felelős egy diakronikus mű indításáért.","it":"Agente responsabile dell’avvio di un’opera diacronica.","lv":"Aģents, kas ir atbildīgs par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu.","nl":"Een actor die verantwoordelijk is voor het initiëren van een diachronisch werk.","no":"En agent som har ansvar for å etablere et diakronisk verk.","tr":"Bir artzamanlı işi başlatmaktan sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm tạo lập ấn phẩm nhiều kỳ, tài nguyên tích hợp, hoặc chuyên khảo nhiều phần.","zh-Hans-CN":"负责发起一种历时作品的一个行为者"},"altLabel":{"ar":["مؤسس لعمل"],"ca":["fundador d’una obra"],"da":["stifter af værk"],"de":["Begründer eines Werks,Begründer eines Werks"],"en":["founder of work"],"es":["fundador de obra"],"et":["teose asutaja"],"fi":["teoksen perustaja"],"fr":["fondateur d’œuvre"],"hu":["műalapító:"],"it":["fondatore di opera"],"no":["grunnlegger av verk"],"tr":["eserin kurucusu"],"zh-Hans-CN":["作品的创办者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
