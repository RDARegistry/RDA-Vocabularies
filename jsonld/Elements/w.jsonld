                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/photographerPersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10056", "lexicalAlias":"http://rdaregistry.info/Elements/w/photographerAgentOfWork.en", "label":"has photographer agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10445", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/photographerPersonOfWork.en", "label":"has photographer person of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10445", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/photographerPersonOfWork.en", "label":"has photographer person of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10354","label":{"ar":"له مكان التقاط لتعبيرة ممثِلة","ca":"té com a lloc de captura d’una expressió representativa","cs":"má místo zaznamenání reprezentativního vyjádření","da":"har optagelsessted for repræsentativt udtryk","de":"hat Aufzeichnungsort einer repräsentativen Expression","de":"hat Aufzeichnungsort einer repräsentativen Expression","en":"has place of capture of representative expression","es":"tiene lugar de captura de expresión representativa","et":"iseloomuliku väljenduse jäädvustamise koht","fi":"edustavan ekspression tallennuspaikka","fr":"a pour lieu de captation d’une expression représentative","hu":"reprezentatív kifejezési forma rögzítési helye a következő:","it":"ha come luogo di cattura dell'edizione rappresentativa","lv":"reprezentatīvās izteiksmes tveršanas vieta","nl":"heeft plaats van vastleggen van representatieve expressie","no":"har innspillingssted for representativt uttrykk","tr":"temsili anlatımın kayıt yeri ile ilişkilidir","zh-Hans-CN":"有代表性内容表达的摄录地点"},"definition":{"ar":["يربط بين عمل ومكان مرتبط بتسجيل محتوى تعبيرة ممثِلة، أو تصويره، إلخ."],"ca":["Relaciona una obra amb un lloc que s’associa amb l’enregistrament, la filmació, etc. del contingut d’una expressió representativa."],"cs":["Vztahuje dílo k místu, které souvisí se zaznamenáním, natočením (atd.) obsahu reprezentativního vyjádření."],"da":["Relaterer et værk til et sted, som er knyttet til optagelse, indspilning etc., af et repræsentativt udtryks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer repräsentativen Expression in Verbindung steht.,Setzt ein Werk in Beziehung zu einem Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer repräsentativen Expression in Verbindung steht."],"en":["Relates a work to a place that is associated with recording, filming, etc., the content of a representative expression."],"es":["Relaciona una obra con un lugar que se asocia a la grabación, filmación, etc., el contenido de una expresión representativa."],"et":["Seostab teose kohaga, mis on seotud iseloomuliku väljenduse sisu salvestamise, filmimise vms jäädvustamisega."],"fi":["Liittää teoksen paikkaan, joka liittyy edustavan ekspression sisällön äänitykseen, kuvaukseen tms."],"fr":["Met une œuvre en relation avec un lieu qui est associé à l’enregistrement, au tournage, etc. du contenu d’une expression représentative."],"hu":["Hozzákapcsol egy művet egy helyhez, amely egy reprezentatív kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik."],"it":["Correla un’opera a un luogo che è associato con la registrazione, ripresa, etc. del contenuto di una espressione rappresentativa."],"lv":["Sasaista darbu ar vietu, kas saistīta ar reprezentatīvas izteiksmes satura ierakstīšanu, filmēšanu u.tml."],"nl":["Relateert een werk aan een plaats die geassocieerd is met het opnemen, filmen etc. van de content van een representatieve expressie."],"no":["Relaterer et verk til et sted som forbindes med innspilling, opptak, etc. av innholdet i et representativt uttrykk."],"tr":["Bir eseri, temsili bir anlatımın içeriği olan kayıt, filme alma vb. ile bağlantılı olan bir yerle ilişkilendirir."],"zh-Hans-CN":["将一种作品与和一种代表性内容表达的内容的录制、摄制等有关的一个地点关联起来。"]},"ToolkitLabel":{"ar":"مكان التقاط لتعبيرة ممثِلة","ca":"lloc de captura d’una expressió representativa","cs":"místo zaznamenání reprezentativního vyjádření","da":"optagelsessted for repræsentativt udtryk","de":"Aufzeichnungsort einer repräsentativen Expression","de":"Aufzeichnungsort einer repräsentativen Expression","en":"place of capture of representative expression","es":"lugar de captura de expresión representativa","et":"iseloomuliku väljenduse jäädvustamise koht","fi":"edustavan ekspression tallennuspaikka","fr":"lieu de captation d’une expression représentative","hu":"reprezentatív kifejezési formához tartozó rögzítési hely:","it":"luogo di cattura dell'espessione rappresentativa","lv":"reprezentatīvās izteiksmes tveršanas vieta","nl":"plaats van vastleggen van representatieve expressie","no":"innspillingssted for representativt uttrykk","tr":"temsili anlatımın çekime alındığı yer","zh-Hans-CN":"代表性内容表达的摄录地点"},"ToolkitDefinition":{"ar":"مكان مرتبط بتسجيل محتوى تعبيرة ممثِلة، أو تصويره، إلخ.","ca":"Lloc que s’associa amb l’enregistrament, la filmació, etc. del contingut d’una expressió representativa.","cs":"Místo, které souvisí se zaznamenáním, natočením (atd.) obsahu reprezentativního vyjádření.","da":"Sted, som er knyttet til optagelse, indspilning etc., af et repræsentativt udtryks indhold.","de":"Ein Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer repräsentativen Expression in Verbindung steht.","de":"Ein Geografikum, das mit der Aufnahme, dem Filmen und so weiter des Inhalts einer repräsentativen Expression in Verbindung steht.","en":"A place that is associated with recording, filming, etc., the content of a representative expression.","es":"Un lugar que se asocia a la grabación, filmación, etc., el contenido de una expresión representativa.","et":"Koht, mis on seotud iseloomuliku väljenduse sisu salvestamise, filmimise vms jäädvustamisega.","fi":"Paikka, joka liittyy edustavan ekspression sisällön äänitykseen, kuvaukseen tms.","fr":"Lieu qui est associé à l’enregistrement, au tournage, etc. du contenu d’une expression représentative.","hu":"Egy hely, amely egy reprezentatív kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik.","it":"Luogo che è associato con la registrazione, ripresa, etc. del contenuto di una espressione rappresentativa.","lv":"Vieta, kas saistīta ar reprezentatīvas izteiksmes satura ierakstīšanu, filmēšanu u.tml.","nl":"Een plaats die geassocieerd is met het opnemen, filmen etc. van de content van een representatieve expressie.","no":"Et sted som forbindes med innspilling, opptak, etc. av innholdet i et representativt uttrykk.","tr":"Temsil edici bir anlatımın içeriğinin kaydedildiği, çekildiği vb. ile bağlantılı olan bir yer.","zh-Hans-CN":"和一种代表性内容表达的内容的录制、摄制等有关的一个地点"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/placeOfCaptureOfRepresentativeExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10316", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedPlaceOfWork.en", "label":"has related place of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10354", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/placeOfCaptureOfRepresentativeExpression.en", "label":"has place of capture of representative expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10354", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/placeOfCaptureOfRepresentativeExpression.en", "label":"has place of capture of representative expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10039","ToolkitLabel":{"ca":"demandant","da":"sagsøger","de":"Zivilkläger","el":"ενάγων","es":"demandante","fi":"kantaja","fr":"demandeur","no":"saksøker","vi":"nguyên đơn"},"ToolkitDefinition":{"ca":"Persona o entitat corporativa que interposa una demanda civil.","da":"Person eller korporation, der anlægger en civil sag.","de":"Eine Person oder eine Körperschaft, die eine Klage in ein Zivilverfahren einbringt.","el":"Ένα φυσικό πρόσωπο ή συλλογικό όργανο, που ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας.","es":"Una persona o entidad corporativa que presenta una demanda en un proceso civil.","fi":"Henkilö tai yhteisö, joka esittää kanteen siviiliprosessissa","fr":"Personne ou collectivité qui intente une poursuite civile.","no":"En person eller korporasjon som er saksøker i en sivilrettslig sak.","vi":"Cá nhân hoặc tập thể đưa ra đơn kiện trong vụ kiện dân sự."},"label":{"ca":"té com a demandant","da":"har sagsøger","de":"hat Zivilkläger","el":"έχει ενάγοντα","fi":"kantaja","fr":"a pour demandeur","vi":"có nguyên đơn"},"definition":{"ca":["Relaciona una obra amb una persona o entitat corporativa que interposa una demanda civil."],"da":["Relaterer et værk til en person eller korporation, der anlægger en civil sag."],"de":["Setzt ein Werk mit einer Person oder einer Körperschaft, die eine Klage in ein Zivilverfahren einbringt, in Beziehung."],"el":["Συνδέει ένα έργο με ένα φυσικό πρόσωπο ή συλλογικό όργανο, που ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας."],"fi":["Liittää teoksen henkilöön tai yhteisöön, joka esittää kanteen siviiliprosessissa"],"fr":["Met une œuvre en relation avec une personne ou une collectivité qui intente une poursuite civile."],"vi":["Liên kết tác phẩm với cá nhân hoặc tập thể đưa ra đơn kiện trong vụ kiện dân sự."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10047", "lexicalAlias":"http://rdaregistry.info/Elements/w/otherAgentWork.en", "label":"has other agent associated with work (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/plaintiff.en","instructionNumber":"18.5"},{"@id":"http://rdaregistry.info/Elements/w/P10112","label":{"ar":"له عمل إضافات","ca":"té com a obra d’addenda","cs":"má addenda (dílo)","da":"har tillægsværk","de":"hat Ergänzung (Werk)","de":"hat Ergänzung (Werk)","el":"είναι προσθήκες (έργο)","en":"has addenda work","es":"tiene obra de adenda","et":"lisa (teos)","fi":"lisäykset (teos)","fr":"a pour addenda (œuvre)","hu":"pótlás-műve a következő:","it":"ha come addenda opera","lv":"darbs: saturisks pielikums","nl":"heeft toevoegingen-werk","no":"har tilleggsverk","tr":"ek eser ile ilişkilidir","vi":"là phụ lục (tác phẩm)","zh-Hans-CN":"有补遗作品"},"definition":{"ar":["يربط عمل بعمل يتكون من محتوى موجز ويعَد ضروريًا لاستكمال عمل ذي صلة."],"ca":["Relaciona una obra amb una obra que consisteix en un contingut breu que és essencial per a la completesa d’una obra relacionada."],"cs":["Vztahuje dílo k dílu, které sestává ze stručného obsahu, který je nezbytný pro úplnost souvisejícího díla."],"da":["Relaterer et værk til et værk, som består af kortfattet indhold, som er væsentligt for fuldstændigheden af et relateret værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus kurzem Inhalt besteht, der für die Vollständigkeit eines in Beziehung stehenden Werks notwendig ist.,Setzt ein Werk in Beziehung zu einem Werk, das aus kurzem Inhalt besteht, der für die Vollständigkeit eines in Beziehung stehenden Werks notwendig ist."],"el":["Συνδέει ένα έργο με ένα έργο, το οποίο συνίσταται από ένα σύντομο περιεχόμενο που είναι ουσιώδες για την πληρότητα ενός άλλου έργου."],"en":["Relates a work to a work that consists of brief content that is essential for the completeness of a related work."],"es":["Relaciona una obra con una obra que consiste en contenido breve que es esencial para la completitud de una obra relacionada."],"et":["Seostab teose teosega, mille sisu on lühike, kuid hädavajalik seotud teose terviklikkuse seisukohast."],"fi":["Liittää teoksen teokseen, joka koostuu suppeasta sisällöstä, joka on olennainen siihen liittyvän teoksen kokonaisuudelle."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un bref contenu essentiel à la complétude d’une œuvre en relation."],"hu":["Hozzákapcsol egy művet egy rövid tartalomból álló műhöz, amely nélkülözhetetlen egy kapcsolódó mű teljességéhez."],"it":["Correla un’opera a un’opera che consiste di contenuto breve essenziale a completamento di un’opera correlata."],"lv":["Sasaista darbu ar darbu - īss saturs, kas ir būtisks saistītā darba pilnīgumam."],"nl":["Relateert een werk aan een werk dat bestaat uit korte content die essentieel is voor de compleetheid van een gerelateerd werk."],"no":["Relaterer et verk til et verk som består av kortfattet innhold som er avgjørende for at et annet verk skal være fullstendig."],"tr":["Bir eseri, ilgili eserin bütünlüğü için gerekli olan kısa içerikten oluşan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa nội dung ngắn gọn nhưng cần thiết đối với sự hàn chỉnh của tác phẩm khác."],"zh-Hans-CN":["将一种作品与由简要内容组成并对一种相关作品的完整性必不可少的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل إضافات","ca":"obra d’addenda","cs":"addenda (dílo)","da":"tillægsværk","de":"Ergänzung (Werk)","de":"Ergänzung (Werk)","el":"προσθήκες (έργο)","en":"addenda work","es":"obra de adenda","et":"lisa (teos)","fi":"lisäykset (teos)","fr":"addenda (œuvre)","hu":"pótlásmű:","it":"addenda opera","lv":"darbs: saturisks pielikums","nl":"toevoegingen-werk","no":"tilleggsverk","tr":"Ek çalışma","vi":"phụ lục (tác phẩm)","zh-Hans-CN":"补遗作品"},"ToolkitDefinition":{"ar":"عمل يتكون من محتوى موجز ويعَد ضروريًا لاستكمال عمل ذي صلة.","ca":"Obra que consisteix en un contingut breu que és essencial per a la completesa d’una obra relacionada.","cs":"Dílo, které sestává ze stručného obsahu, který je nezbytný pro úplnost souvisejícího díla.","da":"Værk, som består af kortfattet indhold, som er væsentligt for fuldstændigheden af et relateret værk.","de":"Ein Werk, das aus kurzem Inhalt besteht, der für die Vollständigkeit eines in Beziehung stehenden Werks notwendig ist.","de":"Ein Werk, das aus kurzem Inhalt besteht, der für die Vollständigkeit eines in Beziehung stehenden Werks notwendig ist.","el":"Ένα έργο, το οποίο συνίσταται από ένα σύντομο περιεχόμενο που είναι ουσιώδες για την πληρότητα ενός άλλου έργου.","en":"A work that consists of brief content that is essential for the completeness of a related work.","es":"Una obra que consiste en contenido breve que es esencial para la completitud de una obra relacionada.","et":"Teos, mille sisu on lühike, kuid hädavajalik seotud teose terviklikkuse seisukohast.","fi":"Teos, joka koostuu suppeasta sisällöstä, joka on olennainen siihen liittyvän teoksen kokonaisuudelle.","fr":"Œuvre qui consiste en un bref contenu essentiel à la complétude d’une œuvre en relation.","hu":"Egy rövid tartalomból álló mű, amely nélkülözhetetlen egy kapcsolódó mű teljességéhez.","it":"Opera che consiste di contenuto breve essenziale a completamento di un’opera correlata.","lv":"Darbs - īss saturs, kas ir būtisks saistītā darba pilnīgumam.","nl":"Een werk dat bestaat uit korte content die essentieel is voor de compleetheid van een gerelateerd werk.","no":"Et verk som består av kortfattet innhold som er avgjørende for at et annet verk skal være fullstendig.","tr":"İlgili bir eserin tamamlayıcılığı için gerekli olan kısa içerikten oluşan bir eser.","vi":"Tác phẩm có chứa nội dung ngắn gọn nhưng cần thiết đối với sự hàn chỉnh của tác phẩm khác.","zh-Hans-CN":"由简要内容组成并对一种相关作品的完整性必不可少的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en", "label":"is augmented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/addendaWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10112", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/addendaWork.en", "label":"has addenda work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10112", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/addendaWork.en", "label":"has addenda work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10122","label":{"ar":"له عمل بادئة","ca":"té com a obra de preqüela","cs":"má prequel (dílo)","da":"har værk, som er forløber","de":"hat Prequel (Werk)","de":"hat Prequel (Werk)","el":"είναι προοίμιο","en":"has prequel work","es":"tiene obra precuela","et":"järg teosele","fi":"esiosa (teos)","fr":"a pour antépisode (œuvre)","hu":"előzményműve a következő:","it":"ha come opera precedente","lv":"darbs: pirmsstāsts","nl":"heeft prequel-werk","no":"har forløper (verk)","tr":"önceki eser ile ilişkilidir","vi":"là tác phẩm mở rộng","zh-Hans-CN":"有前篇作品"},"definition":{"ar":["يربط عمل بعمل يمتد من خلاله سرد عمل آخر إلى الوراء عبر الزمن."],"ca":["Relaciona una obra amb una obra que amplia la narrativa d’una altra obra cap enrere en el temps."],"cs":["Vztahuje dílo k dílu, které rozšiřuje děj jiného díla zpětně v čase."],"da":["Relaterer et værk til et værk, som forlænger et andet værks fortælling tilbage i tid."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Erzählstrang eines anderen Werks zeitlich rückwärts erweitert.,Setzt ein Werk in Beziehung zu einem Werk, das den Erzählstrang eines anderen Werks zeitlich rückwärts erweitert."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο επεκτείνει την αφήγηση ενός προηγούμενου έργου προς τα πίσω στον χρόνο."],"en":["Relates a work to a work that extends the narrative of another work backwards in time."],"es":["Relaciona una obra con una obra que extiende la narrativa de otra obra hacia atrás en el tiempo."],"et":["Seostab teose teosega, mis laiendab teise teose sündmuste esitust ajas tagasi."],"fi":["Liittää teoksen teokseen, joka laajentaa toisen teoksen kerrontaa ajassa taaksepäin."],"fr":["Met une œuvre en relation avec une œuvre qui prolonge le récit d’une autre œuvre sur une période plus ancienne dans le temps."],"hu":["Hozzákapcsol egy művet egy műhöz, amely időben visszafelé terjeszti ki egy másik mű narratíváját."],"it":["Correla un’opera a un’opera che amplia la narrazione di un’altra opera tornando indietro nel tempo."],"lv":["Sasaista darbu ar darbu (prīkvels), kura sižets risinās pirms sākotnējā darba notikumu laika."],"nl":["Relateert een werk aan een werk dat de narratie van een ander werk uitbreidt, achterwaarts in de tijd."],"no":["Relaterer et verk til et verk som fortsetter historien fra et annet verk bakover i tid."],"tr":["Bir eseri, başka bir eseri anlatısını zamanda geriye doğru genişleten bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mở rộng câu chuyện kể của tác phẩm trước đây theo ngược thời gian."],"zh-Hans-CN":["将一种作品与把另一种作品的叙述在时间上往回延伸的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل بادئة","ca":"obra de preqüela","cs":"prequel (dílo)","da":"værk, som er forløber","de":"Prequel (Werk)","de":"Prequel (Werk)","el":"προοίμιο","en":"prequel work","es":"obra precuela","et":"järg teosele","fi":"esiosa (teos)","fr":"antépisode (œuvre)","hu":"előzménymű:","it":"opera precedente","lv":"darbs: pirmsstāsts","nl":"prequel-werk","no":"forløper (verk)","tr":"Bilgilendirici eser","vi":"tác phẩm mở rộng","zh-Hans-CN":"前篇作品"},"ToolkitDefinition":{"ar":"عمل يمتد من خلاله سرد عمل آخر إلى الوراء عبر الزمن.","ca":"Obra que amplia la narrativa d’una altra obra cap enrere en el temps.","cs":"Dílo, které rozšiřuje děj jiného díla zpětně v čase.","da":"Værk, som forlænger et andet værks fortælling tilbage i tid.","de":"Ein Werk, das den Erzählstrang eines anderen Werks zeitlich rückwärts erweitert.","de":"Ein Werk, das den Erzählstrang eines anderen Werks zeitlich rückwärts erweitert.","el":"Ένα έργο το οποίο επεκτείνει την αφήγηση ενός προηγούμενου έργου προς τα πίσω στον χρόνο.","en":"A work that extends the narrative of another work backwards in time.","es":"Una obra que extiende la narrativa de otra obra hacia atrás en el tiempo.","et":"Teos, mis laiendab teise teose sündmuste esitust ajas tagasi.","fi":"Teos, joka laajentaa toisen teoksen kerrontaa ajassa taaksepäin.","fr":"Œuvre qui prolonge le récit d’une autre œuvre sur une période plus ancienne dans le temps.","hu":"Egy mű, amely időben visszafelé terjeszti ki egy másik mű narratíváját.","it":"Opera che amplia la narrazione di un’altra opera tornando indietro nel tempo.","lv":"Darbs (prīkvels), kura sižets risinās pirms sākotnējā darba notikumu laika.","nl":"Een werk dat de narratie van een ander werk uitbreidt, achterwaarts in de tijd.","no":"Et verk som fortsetter historien fra et annet verk bakover i tid.","tr":"Başka bir eserin anlatısını zaman içinde geriye doğru uzatan bir eser.","vi":"Tác phẩm mở rộng câu chuyện kể của tác phẩm trước đây theo ngược thời gian.","zh-Hans-CN":"把另一种作品的叙述在时间上往回延伸的一种作品"},"altLabel":{"ar":["تتمة"],"ca":[","],"cs":["sequel k,prequel"],"da":["efterfølger til"],"de":["Sequel,Prequel"],"en":["sequel to,prequel"],"es":["secuela de,precuela"],"fi":[","],"fr":["suite de,antépisode"],"hu":["folytatása a következőnek:,előzmény:"],"it":["sequel di"],"nl":[","],"no":["etterfølger til"],"tr":["sonraki eseri,önceki eser"],"zh-Hans-CN":["……的续篇,前篇"],"zh-Hant-TW":[","]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/prequelWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10122", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/prequelWork.en", "label":"has prequel work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10122", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/prequelWork.en", "label":"has prequel work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10064","label":{"ar":"له وكيل منتج","ca":"té com a agent productor","cs":"má producenta (agenta)","da":"har agent, som er producer","de":"hat Produzentin/Produzenten (Akteur)","de":"hat Produzentin/Produzenten (Akteur)","el":"έχει παραγωγό","en":"has producer agent","es":"tiene agente productor","et":"produtsent (tegija)","fi":"tuottaja (toimija)","fr":"a pour agent producteur","hu":"producer ágense a következő:","it":"ha come produttore agente","lv":"producents (aģents)","nl":"heeft producent-actor","no":"har produsent (agent)","tr":"yapımcı temsilcisi ile ilişkilidir","vi":"có nhà sản xuất","zh-Hans-CN":"有制作者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن معظم جوانب العمل الخاصة بالإنتاج للسينما، وللتسجيل الصوتي، وللتلفزيون، وللبث عبر الإنترنت، إلخ."],"ca":["Relaciona una obra amb un agent que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, un programa de televisió, d’una emissió web, etc."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd."],"da":["Relaterer et værk til en agent, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές μιας παραγωγής επί της οθόνης, ηχογράφησης, τηλεοπτικής, διαδικτυακής εκπομπής κ.λπ."],"en":["Relates a work to an agent responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc."],"es":["Relaciona una obra con un agente que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, de grabación de audio, televisión, webcast, etc."],"et":["Seostab teose tegijaga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel."],"fi":["Liittää teoksen toimijaan, joka vastaa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés stb. legtöbb üzleti vonatkozásáért."],"it":["Correla un'opera a un agente responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc."],"no":["Relaterer et verk til en agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc."],"tr":["Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun ticari yönlerinin çoğundan sorumlu bir temsilci ile ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm về phần lớn khía cạnh kinh doanh của sản phẩm màn ảnh, ghi âm, truyền hình, web, v.v..."],"zh-Hans-CN":["将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个行为者关联起来。"]},"note":{"ar":["منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ."],"ca":["En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc."],"cs":["Producent je obvykle zodpovědný za získávání finančních prostředků, řízení produkce, najímání klíčových pracovníků, zajišťování distributorů atd."],"da":["Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc."],"de":["Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.,Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich."],"el":["Ένας παραγωγός είναι γενικά υπεύθυνος για τη συγκέντρωση πόρων/χρηματοδότησης, τη διεύθυνση της παραγωγής, την πρόσληψη του βασικού προσωπικού, την οργάνωση της διανομής κ.λπ."],"en":["A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc."],"es":["Un productor es generalmente responsable de recaudar fondos, gestionar la producción, contratar personal clave, llegar a acuerdos para distribuidores, etc."],"et":["Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest."],"fi":["Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne."],"fr":["Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc."],"hu":["Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb."],"it":["Un produttore è in genere responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc."],"lv":["Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml."],"nl":["Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc."],"no":["En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc."],"tr":["Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur."],"vi":["Nhà sản xuất có trách nhiệm tổng quát về nguồn tài chính, quản lý sản xuất, thuê mướn nhân sự chủ yếu, dắp xếp về nhà phân phppos, v.v..."],"zh-Hans-CN":["制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等"]},"ToolkitLabel":{"ar":"وكيل منتج","ca":"agent productor","cs":"producent (agent)","da":"agent, som er producer","de":"Produzentin/Produzent (Akteur)","de":"Produzentin/Produzent (Akteur)","el":"παραγωγός","en":"producer agent","es":"agente productor","et":"produtsent (tegija)","fi":"tuottaja (toimija)","fr":"agent producteur","hu":"producer ágens:","it":"produttore agente","lv":"producents (aģents)","nl":"producent-actor","no":"produsent (agent)","tr":"yapımcı temsilci","vi":"nhà sản xuất","zh-Hans-CN":"制作者行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.","ca":"Agent que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.","cs":"Agent, který je odpovědný za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd.","da":"Agent, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.","de":"Ein Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","de":"Ein Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τις περισσότερες επιχειρηματικές πτυχές μιας παραγωγής επί της οθόνης, ηχογράφησης, τηλεοπτικής, διαδικτυακής εκπομπής κ.λπ.","en":"An agent who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.","es":"Un agente que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, de grabación de audio, televisión, webcast, etc.","et":"Tegija, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.","fi":"Toimija, joka vastaa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.","fr":"Agent qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.","hu":"Egy ágens, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés stb. legtöbb üzleti vonatkozásáért.","it":"Agente responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.","lv":"Aģents, kas ir atbildīgs par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.","nl":"Een actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.","no":"En agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.","tr":"Ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun iş yönlerinin çoğundan sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm về phần lớn khía cạnh kinh doanh của sản phẩm màn ảnh, ghi âm, truyền hình, web, v.v...","zh-Hans-CN":"负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个行为者"},"altLabel":{"ar":["منتج"],"ca":["productor"],"cs":["producent"],"da":["producer"],"de":["Produzent,Produzent"],"en":["producer"],"es":["productor"],"et":["produtsent"],"fi":["tuottaja"],"fr":["producteur"],"hu":["producer:"],"it":["produttore"],"nl":["producent"],"no":["produsent"],"tr":["yapımcı"],"zh-Hans-CN":["制作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/producerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10304", "lexicalAlias":"http://rdaregistry.info/Elements/w/audioProducerAgent.en", "label":"has audio producer agent"},{"@id":"http://rdaregistry.info/Elements/w/P10073", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmProducerAgent.en", "label":"has film producer agent"},{"@id":"http://rdaregistry.info/Elements/w/P10501", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerCollectiveAgent.en", "label":"has producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10454", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerPerson.en", "label":"has producer person"},{"@id":"http://rdaregistry.info/Elements/w/P10074", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioProducerAgent.en", "label":"has radio producer agent"},{"@id":"http://rdaregistry.info/Elements/w/P10075", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProducerAgent.en", "label":"has television producer agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10064", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/producerAgent.en", "label":"has producer agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10064", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/producerAgent.en", "label":"has producer agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10501","label":{"ar":"له وكيل جماعي منتج","ca":"té com a agent col·lectiu productor","cs":"má producenta (kolektivního agenta)","da":"har kollektiv agent, som er producer","de":"hat Produzentin/Produzenten (Gemeinschaftlicher Akteur)","de":"hat Produzentin/Produzenten (Gemeinschaftlicher Akteur)","en":"has producer collective agent","es":"tiene agente colectivo productor","et":"produtsent (kollektiiv)","fi":"tuottaja (yhteistoimija)","fr":"a pour agent collectif producteur","hu":"producer kollektív ágense a következő:","it":"ha come produttore agente collettivo","lv":"producents (grupa)","nl":"heeft producent-collectieve actor","no":"har produsent (kollektiv agent)","tr":"yapımcı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有制作者集体行为者"},"definition":{"ar":["يربط العمل بوكيل جماعي مسئول عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ."],"ca":["Relaciona una obra amb un agent col·lectiu que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je odpovědný za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd."],"da":["Relaterer et værk til en kollektiv agent, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist."],"en":["Relates a work to a collective agent who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc."],"es":["Relaciona una obra con un agente colectivo que es responsable de la mayoría de los aspectos comerciales de una producción para pantalla, grabación de sonido, televisión, webcast, etc."],"et":["Seostab teose kollektiiviga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel."],"fi":["Liittää teoksen yhteistoimijaan, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä."],"fr":["Met une œuvre en relation avec un agent collectif qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért."],"it":["Correla un'opera all'agente collettivo responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc."],"lv":["Sasaista darbu ar grupu, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem."],"nl":["Relateert een werk aan een collectieve actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc."],"no":["Relaterer et verk til en kollektiv agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc."],"tr":["Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir yapımın ticari yönlerinin çoğundan sorumlu olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي منتج","ca":"agent col·lectiu productor","cs":"producent (kolektivní agent)","da":"kollektiv agent, som er producer","de":"Produzentin/Produzent (Gemeinschaftlicher Akteur)","de":"Produzentin/Produzent (Gemeinschaftlicher Akteur)","en":"producer collective agent","es":"agente colectivo productor","et":"produtsent (kollektiiv)","fi":"tuottaja (yhteistoimija)","fr":"agent collectif producteur","hu":"producer kollektív ágens:","it":"produttore agente collettivo","lv":"producents (grupa)","nl":"producent-collectieve actor","no":"produsent (kollektiv agent)","tr":"Yapımcı kolektif temsilci","zh-Hans-CN":"制作者行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.","ca":"Agent col·lectiu que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.","cs":"Kolektivní agent, který je odpovědný za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd.","da":"Kollektiv agent, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.","de":"Ein gemeinschaftlicher Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","de":"Ein gemeinschaftlicher Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","en":"A collective agent who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.","es":"Un agente colectivo que es responsable de la mayoría de los aspectos comerciales de una producción para pantalla, grabación de sonido, televisión, webcast, etc.","et":"Kollektiiv, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.","fi":"Yhteistoimija, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.","fr":"Agent collectif qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.","hu":"Egy kollektív ágens, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.","it":"Agente collettivo responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.","lv":"Grupa, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.","nl":"Een collectieve actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.","no":"En kollektiv agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.","tr":"Ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun ticari yönlerinin çoğundan sorumlu olan kolektif bir temsilci.","zh-Hans-CN":"负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个集体行为者"},"note":{"ar":["منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ."],"ca":["En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc."],"cs":["Producent je obvykle zodpovědný za získávání finančních prostředků, řízení produkce, najímání klíčových pracovníků, zajišťování distributorů atd."],"da":["Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc."],"de":["Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.,Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich."],"en":["A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc."],"es":["Un productor generalmente es responsable de recaudar fondos, gestionar la producción, contratar personal clave, gestionar los distribuidores, etc."],"et":["Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest."],"fi":["Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne."],"fr":["Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc."],"hu":["Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb."],"it":["Generalmente un produttore è responsabile per la raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc."],"lv":["Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml."],"nl":["Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc."],"no":["En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc."],"tr":["Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur."],"zh-Hans-CN":["制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/producerCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10064", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerAgent.en", "label":"has producer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10468", "lexicalAlias":"http://rdaregistry.info/Elements/w/audioProducerCollectiveAgent.en", "label":"has audio producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10469", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmProducerCollectiveAgent.en", "label":"has film producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10548", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerCorporateBody.en", "label":"has producer corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10595", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerFamily.en", "label":"has producer family"},{"@id":"http://rdaregistry.info/Elements/w/P10470", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioProducerCollectiveAgent.en", "label":"has radio producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10471", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProducerCollectiveAgent.en", "label":"has television producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10501", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/producerCollectiveAgent.en", "label":"has producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10501", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/producerCollectiveAgent.en", "label":"has producer collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10548","label":{"ar":"له هيئة منتجة","ca":"té com a entitat corporativa productora","cs":"má producenta (korporaci)","da":"har korporation, som er producer","de":"hat Produzentin/Produzenten (Körperschaft)","de":"hat Produzentin/Produzenten (Körperschaft)","en":"has producer corporate body","es":"tiene organismo corporativo productor","et":"produtsent (asutus)","fi":"tuottaja (yhteisö)","fr":"a pour collectivité productrice","hu":"producer testülete a következő:","it":"ha come produttore ente","lv":"producents (institūcija)","nl":"heeft producent-corporatie","no":"har produsent (korporasjon)","tr":"yapımcı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有制作者团体"},"definition":{"ar":["يربط بين عمل وهيئة مسئولة عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd."],"da":["Relaterer et værk til en korporation, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist."],"en":["Relates a work to a corporate body who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc."],"es":["Relaciona una obra con un organismo corporativo que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, de grabación de audio, televisión, webcast, etc."],"et":["Seostab teose asutusega, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért."],"it":["Correla un'opera a un ente responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc."],"tr":["Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir yapımın ticari yönlerinin çoğundan sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة منتجة","ca":"entitat corporativa productora","cs":"producent (korporace)","da":"korporation, som er producer","de":"Produzentin/Produzent (Körperschaft)","de":"Produzentin/Produzent (Körperschaft)","en":"producer corporate body","es":"organismo corporativo productor","et":"produtsent (asutus)","fi":"tuottaja (yhteisö)","fr":"collectivité productrice","hu":"producer testület:","it":"produttore ente","lv":"producents (institūcija)","nl":"producent-corporatie","no":"produsent (korporasjon)","tr":"Yapımcı tüzel kişi","zh-Hans-CN":"制作者团体"},"ToolkitDefinition":{"ar":"هيئة مسئولة عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.","ca":"Entitat corporativa que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.","cs":"Korporace, která je odpovědná za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd.","da":"Korporation, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.","de":"Eine Körperschaft, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","de":"Eine Körperschaft, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","en":"A corporate body who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.","es":"Un organismo corporativo que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, de grabación de audio, televisión, webcast, etc.","et":"Asutus, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.","fi":"Yhteisö, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.","fr":"Collectivité qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.","hu":"Egy testület, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.","it":"Ente responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.","lv":"Institūcija, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.","nl":"Een corporatie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.","no":"En korporasjon som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.","tr":"Ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun ticari yönlerinin çoğundan sorumlu olan bir tüzel kişi.","zh-Hans-CN":"负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个团体"},"note":{"ar":["منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ."],"ca":["En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc."],"cs":["Producent je obvykle zodpovědný za získávání finančních prostředků, řízení produkce, najímání klíčových pracovníků, zajišťování distributorů atd."],"da":["Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc."],"de":["Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.,Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich."],"en":["A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc."],"es":["Un productor es generalmente responsable de recaudar fondos, gestionar la producción, contratar personal clave, llegar a acuerdos para distribuidores, etc."],"et":["Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest."],"fi":["Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne."],"fr":["Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc."],"hu":["Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb."],"it":["Generalmente un produttore è responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc."],"lv":["Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml."],"nl":["Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc."],"no":["En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc."],"tr":["Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur."],"zh-Hans-CN":["制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/producerCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10501", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerCollectiveAgent.en", "label":"has producer collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10515", "lexicalAlias":"http://rdaregistry.info/Elements/w/audioProducerCorporateBody.en", "label":"has audio producer corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10516", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmProducerCorporateBody.en", "label":"has film producer corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10517", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioProducerCorporateBody.en", "label":"has radio producer corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10518", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProducerCorporateBody.en", "label":"has television producer corporate body"},{"@id":"http://rdaregistry.info/Elements/w/object/P10548", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/producerCorporateBody.en", "label":"has producer corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10548", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/producerCorporateBody.en", "label":"has producer corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10595","label":{"ar":"له عائلة منتجة","ca":"té com a família productora","cs":"má producenta (rodinu)","da":"har familie, som er producer","de":"hat Produzentin/Produzenten (Familie)","de":"hat Produzentin/Produzenten (Familie)","en":"has producer family","es":"tiene familia productora","et":"produtsent (perekond)","fi":"tuottaja (suku)","fr":"a pour famille productrice","hu":"producer családja a következő:","it":"ha come produttore famiglia","lv":"producents (dzimta/ģimene)","nl":"heeft producent-familie","no":"har produsent (familie)","tr":"yapımcı ailesi ile ilişkilidir","zh-Hans-CN":"有制作者家族"},"definition":{"ar":["يربط بين عمل وعائلة مسئولة عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ."],"ca":["Relaciona una obra amb una família que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc."],"cs":["Vztahuje dílo k rodině, která je odpovědná za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd."],"da":["Relaterer et værk til en familie, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Familie, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist."],"en":["Relates a work to a family who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc."],"es":["Relaciona una obra con una familia que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, grabación de audio, televisión, webcast, etc."],"et":["Seostab teose perekonnaga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel."],"fi":["Liittää teoksen sukuun, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä."],"fr":["Met une œuvre en relation avec une famille qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc."],"hu":["Hozzákapcsol egy művet egy családhoz, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért."],"it":["Correla un'opera alla famiglia responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem."],"nl":["Relateert een werk aan een familie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc."],"no":["Relaterer et verk til en familie som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc."],"tr":["Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir yapımın ticari yönlerinin çoğundan sorumlu olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة منتجة","ca":"família productora","cs":"producent (rodina)","da":"familie, som er producer","de":"Produzentin/Produzent (Familie)","de":"Produzentin/Produzent (Familie)","en":"producer family","es":"familia productora","et":"produtsent (perekond)","fi":"tuottaja (suku)","fr":"famille productrice","hu":"producer család:","it":"produttore famiglia","lv":"producents (dzimta/ģimene)","nl":"producent-familie","no":"produsent (familie)","tr":"yapımcı aile","zh-Hans-CN":"制作者家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.","ca":"Família que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.","cs":"Rodina, která je odpovědná za většinu obchodních aspektů produkce pro film, zvukový záznam, televizi, webcast atd.","da":"Familie, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.","de":"Eine Familie, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","de":"Eine Familie, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.","en":"A family who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.","es":"Una familia que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, grabación de audio, televisión, webcast, etc.","et":"Perekond, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.","fi":"Suku, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.","fr":"Famille qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.","hu":"Egy család, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.","it":"Famiglia responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.","lv":"Dzimta/ģimene, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.","nl":"Een familie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.","no":"En familie som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.","tr":"Ekran, ses kaydı, televizyon, internet yayını vb. için bir prodüksiyonun ticari yönlerinin çoğundan sorumlu olan bir aile.","zh-Hans-CN":"负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个家族"},"note":{"ar":["منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ."],"ca":["En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc."],"cs":["Producent je obvykle zodpovědný za získávání finančních prostředků, řízení produkce, najímání klíčových pracovníků, zajišťování distributorů atd."],"da":["Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc."],"de":["Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.,Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich."],"en":["A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc."],"es":["Un productor es generalmente responsable de recaudar fondos, gestionar la producción, contratar personal clave, llegar a acuerdos para distribuidores, etc."],"et":["Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest."],"fi":["Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne."],"fr":["Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc."],"hu":["Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb."],"it":["Generalmente un produttore è responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc."],"lv":["Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml."],"nl":["Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc."],"no":["En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc."],"tr":["Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur."],"zh-Hans-CN":["制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
