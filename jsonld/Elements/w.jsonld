                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/sequentialVersion.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10377", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByExtensionPlan.en", "label":"has transformation by extension plan"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10379", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sequentialVersion.en", "label":"has sequential version"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10379", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sequentialVersion.en", "label":"has sequential version"}]},{"@id":"http://rdaregistry.info/Elements/w/P10380","label":{"ar":"هو إصدارة متتالية","ca":"és versió seqüencial de","cs":"je sekvenční verzí (čeho)","da":"er efterfølgende version af","de":"ist fortlaufende Version von","de":"ist fortlaufende Version von","en":"is sequential version of","es":"es una versión secuencial de","et":"järjestikune versioon teosest","fi":"peräkkäisversio teoksesta","fr":"est une version séquentielle de","hu":"szekvenciális változata a következőnek:","it":"è versione sequenziale di","lv":"ir secīgā versija no","nl":"is sequentiële versie van","no":"er etterfølgende versjon av","tr":"sıralı sürümüdür","zh-Hans-CN":"是……的序列版本"},"definition":{"ar":["يربط عمل بعمل له خطة توسع يتم تغييرها من متتالٍ إلى متكامل لإنشاء عمل."],"ca":["Relaciona una obra amb una obra que té un pla d’extensió que es canvia de successiu a integrant per crear una obra."],"cs":["Vztahuje dílo k dílu, které má plán rozšíření, který je změněn z postupně vydávaného na integrační za účelem vytvoření díla."],"da":["Relaterer et værk til et værk, som har en udvidelsesplan, som, for at skabe et værk, ændres fra integrerende til fortløbende."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Erweiterungsplan von sukzessiv auf integrierend geändert wird, um ein Werk zu erstellen.,Setzt ein Werk in Beziehung zu einem Werk, dessen Erweiterungsplan von sukzessiv auf integrierend geändert wird, um ein Werk zu erstellen."],"en":["Relates a work to a work that has an extension plan that is changed from successive to integrating to create a work."],"es":["Relaciona una obra con una obra que tiene un plan de extensión que se cambia de sucesivo a integrador para crear una obra."],"et":["Seostab teose teosega, mille jätkamiskava on teose loomiseks muudetud järjestikusest täienevaks."],"fi":["Liittää teoksen teokseen, jolla on laajennussuunnitelma, jota on muutettu peräkkäisestä päivittyväksi teoksen luomiseksi."],"fr":["Met une œuvre en relation avec une œuvre dont le plan d’extension intégrateur est modifié en plan successif pour créer une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek a közlési terve folyamatosról integrálóvá változott egy mű létrejövetele érdekében."],"it":["Correla un'opera a un'opera che ha un piano di estensione cambiato da integrativo a consecutivo per creare un'opera."],"lv":["Sasaista darbu ar darbu, kam paplašināšanas plāns ticis mainīts no veselā uz secīgu, lai izveidotu darbu."],"nl":["Relateert een werk aan een werk dat een extensieplan heeft dat veranderd is van successief naar geïntegreerd om een werk te vormen."],"no":["Relaterer et verk til et verk som har en utvidelsesplan som er endret fra fortløpende til integrerende for å skape et verk."],"tr":["Bir eseri, bir eser oluşturmak için ardışıktan birleştirmeye değiştirilen bir genişletme planına sahip bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与有扩充计划并被改变为从相继性到集成性以创作一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة متتالية لـ","ca":"versió seqüencial de","cs":"sekvenční verze (čeho)","da":"efterfølgende version af","de":"Fortlaufende Version von","de":"Fortlaufende Version von","en":"sequential version of","es":"versión secuencial de","et":"järjestikune versioon teosest","fi":"peräkkäisversio teoksesta","fr":"version séquentielle de","hu":"szekvenciális változata:","it":"versione sequenziale di","lv":"secīgā versija no","nl":"sequentiële versie van","no":"etterfølgende versjon av","tr":"sıralı versiyon","zh-Hans-CN":"……的序列版本"},"ToolkitDefinition":{"ar":"عمل له خطة توسع يتم تغييرها من متتالٍ إلى متكامل لإنشاء عمل.","ca":"Obra que té un pla d’extensió que es canvia de successiu a integrant per crear una obra.","cs":"Dílo, které má plán rozšíření, který je změněn z postupně vydávaného na integrační za účelem vytvoření díla.","da":"Værk, som har en udvidelsesplan, som, for at skabe et værk, ændres fra integrerende til fortløbende.","de":"Ein Werk, dessen Erweiterungsplan von sukzessiv auf integrierend geändert wird, um ein Werk zu erstellen.","de":"Ein Werk, dessen Erweiterungsplan von sukzessiv auf integrierend geändert wird, um ein Werk zu erstellen.","en":"A work that has an extension plan that is changed from successive to integrating to create a work.","es":"Una obra que tiene un plan de extensión que se cambia de sucesivo a integrador para crear una obra.","et":"Teos, mille jätkamiskava on teose loomiseks muudetud järjestikusest täienevaks.","fi":"Teos, jolla on laajennussuunnitelma, jota on muutettu peräkkäisestä päivittyväksi teoksen luomiseksi.","fr":"Œuvre dont le plan d’extension intégrateur est modifié en plan successif pour créer une œuvre.","hu":"Egy mű, amelynek a közlési terve folyamatosról integrálóvá változott egy mű létrejövetele érdekében.","it":"Opera che ha un piano di estensione cambiato da integrativo a consecutivo per creare un'opera.","lv":"Darbs, kam paplašināšanas plāns ticis mainīts no veselā uz secīgu, lai izveidotu darbu.","nl":"Een werk dat een extensieplan heeft dat veranderd is van successief naar geïntegreerd om een werk te vormen.","no":"Et verk som har en utvidelsesplan som er endret fra fortløpende til integrerende for å skape et verk.","tr":"Bir eser oluşturmak için ardışıktan bütünleştiriciye değiştirilen bir uzatma planına sahip bir eser.","zh-Hans-CN":"有扩充计划并被改变为从相继性到集成性以创作一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/sequentialVersionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10378", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByExtensionPlanOf.en", "label":"is transformation by extension plan of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10380", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sequentialVersionOf.en", "label":"is sequential version of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10380", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sequentialVersionOf.en", "label":"is sequential version of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10231","note":{"ca":["Les obres seqüencials inclouen seqüeles, preqüeles, continuacions, obres que es reemplacen, etc."],"de":["Dazu gehören Sequels, Prequels, Fortsetzungen usw."],"el":["Τα διαδοχικά έργα περιλαμβάνουν συνέχειες, προοίμια, αντικατάσεις έργων κ.λπ."],"en":["Sequential works include sequels, prequels, continuations, superseding works, etc."],"fr":["Les œuvres séquentielles comprennent les suites, les antépisodes, les continuations, les œuvres qui en remplacent d’autres, etc."],"vi":["Tác phẩm tiếp theo bao gồm cả tác phẩm đoạn theo, mô tả trước, tiếp tục, thay thế, v.v..."]},"ToolkitLabel":{"ca":"relació d’obra seqüencial","da":"sekventiel værkrelation","de":"Nachfolge-Beziehung auf Werkebene","el":"ακολουθιακή σχέση έργου με","es":"relaciones de obra secuencial","fi":"teoksen jatkuvuussuhde","fr":"relation d’œuvre séquentielle","no":"relasjonstypen etterfølgende verk","vi":"mối quan hệ tác phẩm tiếp theoi"},"ToolkitDefinition":{"ca":"Obra que és precedida o seguida per una altra obra.","da":"Værk der er forudgået af eller efterfulgt af et værk.","de":"Ein Werk, dem ein anderes Werk voranging oder folgte.","el":"Ένα έργο το οποίο προηγείται ή έπεται ενός άλλου έργου.","es":"Una obra que es precedido por o sucedida por la obra.","fi":"Teos, jota edeltää tai seuraa toinen teos. Peräkkäisiä teoksia ovat jatko-osat, esiosat, seuraajat, edeltävät teokset tms","fr":"Œuvre qui est précédée ou suivie par une autre œuvre.","no":"Et verk som avløser eller avløses av et annet verk.","vi":"Tác phẩm được đi trước bởi hoặc tiếp theo bởi tác phẩm khác."},"label":{"ca":"té com a relació d’obra seqüencial","da":"har sekventiel værk-relation med","de":"hat Nachfolge-Beziehung auf Werkebene","el":"έχει ακολουθιακή σχέση έργου με","fi":"teoksen jatkuvuussuhde","fr":"a pour relation d’œuvre séquentielle","vi":"có mối quan hệ tác phẩm tiếp theo với"},"definition":{"ca":["Relaciona una obra amb una obra que és precedida o seguida per una altra obra."],"da":["Relaterer et værk til et værk der er forudgået af eller efterfulgt af et værk."],"de":["Setzt ein Werk mit einem Werk, dem ein anderes Werk voranging oder folgte, in Beziehung."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο προηγείται ή έπεται ενός άλλου έργου."],"fi":["Liittää teoksen teokseen, jota edeltää tai seuraa toinen teos."],"fr":["Met une œuvre en relation avec une œuvre qui est précédée ou suivie par une autre œuvre."],"vi":["Liên kết tác phẩm với tác phẩm được đi trước bởi hoặc tiếp theo bởi tác phẩm khác."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/sequentialWorkRelationship.en","instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10231", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sequentialWorkRelationship.en", "label":"has sequential work relationship with (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10231", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sequentialWorkRelationship.en", "label":"has sequential work relationship with (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10381","label":{"ar":"له إصدارة متسلسلة","ca":"té com a versió serialitzada","cs":"má serializovanou verzi","da":"har serialiseret version","de":"hat Fortsetzungs-Version","de":"hat Fortsetzungs-Version","en":"has serialized version","es":"tiene versión serializada","et":"sarjaversioon","fi":"sarjaversio","fr":"a pour version en série","hu":"sorozati változata a következő:","it":"ha come versione serializzata","lv":"sērijveida versija","nl":"heeft seriële versie","no":"har serialisert versjon","tr":"serileştirilmiş sürüm ile ilişkilidir","zh-Hans-CN":"有序列化的版本"},"definition":{"ar":["يربط عمل بعمل يتم إنشاؤه عن طريق تغيير خطة توسع لعمل من ثابت إلى متتالٍ."],"ca":["Relaciona una obra amb una obra que es crea canviant el pla d’extensió d’una obra d’estàtic a successiu."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou plánu rozšíření díla ze statického na postupně vydávané."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre udvidelsesplanen for et værk fra statisk til fortløbende."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Erweiterungsplans eines Werks von statisch auf sukzessiv erstellt wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Erweiterungsplans eines Werks von statisch auf sukzessiv erstellt wird."],"en":["Relates a work to a work that is created by changing the extension plan of a work from static to successive."],"es":["Relaciona una obra con una obra que se crea cambiando el plan de extensión de una obra de estático a sucesivo."],"et":["Seostab teose teosega, mis on loodud, muutes teose jätkamiskava staatilisest järjestikuseks."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen laajennussuunnitelmaa staattisesta peräkkäiseksi."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le plan d’extension statique d’une œuvre en plan successif."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű közlési tervének statikusról folyamatossá való változásával jött létre."],"it":["Correla un'opera a un'opera creata cambiando il piano di estensione da statico a consecutivo."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba paplašināšanas plānu no statiska uz secīgu."],"nl":["Relateert een werk aan een werk dat gevormd is door het extensieplan te veranderen van statisch naar successief."],"no":["Relaterer et verk til et verk som er skapt ved endring av utgivelsesplan for et verk fra statisk til fortløpende."],"tr":["Bir eseri, bir eserin genişletme planını durağandan ardışık hale değiştirilerek oluşturulan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过将一种作品的扩充计划从静态到相继性变化而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة متسلسلة","ca":"versió serialitzada","cs":"serializovaná verze","da":"serialiseret version","de":"Fortsetzungs-Version","de":"Fortsetzungs-Version","en":"serialized version","es":"versión serializada","et":"sarjaversioon","fi":"sarjaversio","fr":"version en série","hu":"sorozati változata:","it":"versione serializzata","lv":"sērijveida versija","nl":"seriële versie","no":"serialisert versjon","tr":"serileştirilmiş versiyon","zh-Hans-CN":"序列化的版本"},"ToolkitDefinition":{"ar":"عمل يتم إنشاؤه عن طريق تغيير خطة توسع لعمل من ثابت إلى متتالٍ.","ca":"Obra que es crea canviant el pla d’extensió d’una obra d’estàtic a successiu.","cs":"Dílo, které je vytvořeno změnou plánu rozšíření díla ze statického na postupně vydávané.","da":"Værk, som er skabt ved at ændre et udvidelsesplanen for et værk fra statisk til fortløbende.","de":"Ein Werk, das durch Änderung des Erweiterungsplans eines Werks von statisch auf sukzessiv erstellt wird.","de":"Ein Werk, das durch Änderung des Erweiterungsplans eines Werks von statisch auf sukzessiv erstellt wird.","en":"A work that is created by changing the extension plan of a work from static to successive.","es":"Una obra que se crea cambiando el plan de extensión de una obra de estático a sucesivo.","et":"Teos, mis on loodud, muutes teose jätkamiskava staatilisest järjestikuseks.","fi":"Teos, joka on luotu muuttamalla teoksen laajennussuunnitelmaa staattisesta peräkkäiseksi.","fr":"Œuvre qui est créée en modifiant le plan d’extension statique d’une œuvre en plan successif.","hu":"Egy mű, amely egy mű közlési tervének statikusról folyamatossá való változásával jött létre.","it":"Opera creata cambiando il piano di estensione da statico a consecutivo.","lv":"Darbs, kas radīts, mainot darba paplašināšanas plānu no statiska uz secīgu.","nl":"Een werk dat gevormd is door het extensieplan te veranderen van statisch naar successief.","no":"Et verk som er skapt ved endring av utgivelsesplan for et verk fra statisk til fortløpende.","tr":"Bir eserin genişletme planının sabitten ardışık plana değiştirilmesiyle oluşturulan bir eser.","zh-Hans-CN":"通过将一种作品的扩充计划从静态到相继性变化而被创作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/serializedVersion.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10377", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByExtensionPlan.en", "label":"has transformation by extension plan"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10381", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/serializedVersion.en", "label":"has serialized version"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10381", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/serializedVersion.en", "label":"has serialized version"}]},{"@id":"http://rdaregistry.info/Elements/w/P10391","label":{"ar":"هو إصدارة متسلسلة من","ca":"és versió serialitzada de","cs":"je serializovanou verzí (čeho)","da":"er serialiseret version af","de":"ist Fortsetzungs-Version von","de":"ist Fortsetzungs-Version von","en":"is serialized version of","es":"es la versión serializada de","et":"sarjaversioon teosest","fi":"sarjaversio teoksesta","fr":"est une version en série de","hu":"sorozati változata a következőnek:","it":"è versione serializzata di","lv":"ir sērijveida versija no","nl":"is seriële versie van","no":"er serialisert versjon av","tr":"serileştirilmiş sürümüdür","zh-Hans-CN":"是……的序列化的版本"},"definition":{"ar":["يربط عمل بعمل له خطة توسع تم تغييرها من متتالٍ إلى ثابت لإنشاء عمل."],"ca":["Relaciona una obra amb una obra que té un pla d’extensió que es canvia de successiu a estàtic per crear una obra."],"cs":["Vztahuje dílo k dílu, které má plán rozšíření, který je změněn z postupně vydávaného na statický za účelem vytvoření díla."],"da":["Relaterer et værk til et værk, som har en udvidelsesplan, som, for at skabe et værk, ændres fra fortløbende til statisk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Erweiterungsplan von sukzessiv auf statisch geändert wird, um ein Werk zu schaffen.,Setzt ein Werk in Beziehung zu einem Werk, dessen Erweiterungsplan von sukzessiv auf statisch geändert wird, um ein Werk zu schaffen."],"en":["Relates a work to a work that has an extension plan that is changed from successive to static to create a work."],"es":["Relaciona una obra con una obra que tiene un plan de extensión que se cambia de sucesivo a estático para crear una obra."],"et":["Seostab teose teosega, mille jätkamiskava on teose loomiseks muudetud järjestikusest staatiliseks."],"fi":["Liittää teoksen teokseen, jolla on laajennussuunnitelma, joka on muutettu peräkkäisestä staattiseksi teoksen luomiseksi."],"fr":["Met une œuvre en relation avec une œuvre dont le plan d’extension successif est modifié en plan statique pour créer une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek a közlési terve folyamatosról statikussá változott egy mű létrejövetele érdekében."],"it":["Correla un'opera a un'opera che ha un piano di estensione cambiato da consecutivo a statico per creare un'opera."],"lv":["Sasaista darbu ar darbu, kam paplašināšanas plāns ticis mainīts no statiska uz secīgu, lai izveidotu darbu."],"nl":["Relateert een werk aan een werk dat een extensieplan heeft dat veranderd is van successief naar statisch om een werk te vormen."],"no":["Relaterer et verk til et verk som har en utvidelelsesplan som er endret fra fortløpende til statisk for å skape et verk."],"tr":["Bir eseri, bir eser oluşturmak için ardışıktan durağana değiştirilen bir genişletme planına sahip bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与有扩充计划并被从相继性改变为静态以创作一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة متسلسلة من","ca":"versió serialitzada de","cs":"serializovaná verze (čeho)","da":"serialiseret version af","de":"Fortsetzungs-Version von","de":"Fortsetzungs-Version von","en":"serialized version of","es":"versión serializada de","et":"sarjaversioon teosest","fi":"sarjaversio teoksesta","fr":"version en série de","hu":"sorozati változata:","it":"versione serializzata di","lv":"sērijveida versija no","nl":"seriële versie van","no":"serialisert versjon av","tr":"serileştirilmiş versiyon","zh-Hans-CN":"……的序列化的版本"},"ToolkitDefinition":{"ar":"عمل له خطة توسع تم تغييرها من متتالٍ إلى ثابت لإنشاء عمل.","ca":"Obra que té un pla d’extensió que es canvia de successiu a estàtic per crear una obra.","cs":"Dílo, které má plán rozšíření, který je změněn z postupně vydávaného na statický za účelem vytvoření díla.","da":"Værk, som har en udvidelsesplan, som, for at skabe et værk, ændres fra fortløbende til statisk.","de":"Ein Werk, dessen Erweiterungsplan von sukzessiv auf statisch geändert wird, um ein Werk zu schaffen.","de":"Ein Werk, dessen Erweiterungsplan von sukzessiv auf statisch geändert wird, um ein Werk zu schaffen.","en":"A work that has an extension plan that is changed from successive to static to create a work.","es":"Una obra que tiene un plan de extensión que se cambia de sucesivo a estático para crear una obra.","et":"Teos, mille jätkamiskava on teose loomiseks muudetud järjestikusest staatiliseks.","fi":"Teos, jolla on laajennussuunnitelma, joka on muutettu peräkkäisestä staattiseksi teoksen luomiseksi.","fr":"Œuvre dont le plan d’extension successif est modifié en plan statique pour créer une œuvre.","hu":"Egy mű, amelynek a közlési terve folyamatosról statikussá változott egy mű létrejövetele érdekében.","it":"Opera che ha un piano di estensione cambiato da consecutivo a statico per creare un'opera.","lv":"Darbs, kam paplašināšanas plāns ticis mainīts no statiska uz secīgu, lai izveidotu darbu.","nl":"Een werk dat een extensieplan heeft dat veranderd is van successief naar statisch om een werk te vormen.","no":"Et verk som har en utvidelsesplan som er endret fra fortløpende til statisk for å skape et verk.","tr":"Bir eser oluşturmak için ardışıktan statik hale değiştirilen bir uzatma planına sahip bir eser.","zh-Hans-CN":"有扩充计划并被从相继性改变为静态以创作一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/serializedVersionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10378", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByExtensionPlanOf.en", "label":"is transformation by extension plan of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10391", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/serializedVersionOf.en", "label":"is serialized version of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10391", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/serializedVersionOf.en", "label":"is serialized version of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10334","label":{"ar":"له رقم مسلسل لعمل موسيقي","ca":"té com a número d’ordre d’una obra musical","cs":"má pořadové číslo hudebního díla","da":"har serienummer for musikværk","de":"hat laufende Nummer eines Musikwerks","de":"hat laufende Nummer eines Musikwerks","en":"has serial number of musical work","es":"tiene número de serie de obra musical","et":"muusikateose järjenumber","fi":"musiikkiteoksen järjestysnumero","fr":"a pour numéro d’ordre d’une œuvre musicale","hu":"zenemű sorozatszáma a következő:","it":"ha come numero seriale di opera musicale","lv":"mūzikas darba kārtas numurs","nl":"heeft serienummer van muziekwerk","no":"har serienummer for musikalsk verk","tr":"müzik eserinin seri numarası ile ilişkilidir","zh-Hans-CN":"有音乐作品的序列号"},"ToolkitLabel":{"ar":"رقم مسلسل لعمل موسيقي","ca":"número d’ordre d’una obra musical","cs":"pořadové číslo hudebního díla","da":"serienummer for musikværk","de":"Laufende Nummer eines Musikwerks","de":"Laufende Nummer eines Musikwerks","en":"serial number of musical work","es":"número de serie de obra musical","et":"muusikateose järjenumber","fi":"musiikkiteoksen järjestysnumero","fr":"numéro d’ordre d’une œuvre musicale","hu":"zenemű-sorozatszám:","it":"numero seriale di opera musicale","lv":"mūzikas darba kārtas numurs","nl":"serienummer van muziekwerk","no":"serienummer for musikalsk verk","tr":"müzik eserinin seri numarası","zh-Hans-CN":"音乐作品的序列号"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن تعيين رقمي لعمل موسيقي يخصصه ملحن أو مصدر مرجعي يشير إلى تسلسل الأعمال الموسيقية تحت نفس العنوان، أو تحت نفس العنوان ووسيلة الأداء."],"ca":["Relaciona una obra amb un nomen que és una designació numèrica d’una obra musical que és assignada per un compositor o una font de referència que indica una seqüència d’obres musicals que comparteixen el mateix títol o que comparteixen el mateix títol i el mateix repartiment d’execució representatiu."],"cs":["Vztahuje dílo k nomen, které je číselným označením hudebního díla přiřazeným skladatelem nebo referenčním zdrojem a které označuje pořadí hudebních děl, která sdílejí stejný název, nebo stejný název a současně stejné reprezentativní obsazení."],"da":["Relaterer et værk til en numerisk betegnelse for musikværk, angivet af en komponist eller en referencekilde, som angiver en sekvens af musikværk, som deler samme titel, eller som deler samme titel og samme repræsentative besætning."],"de":["Setzt ein Werk in Beziehung zu einer numerischen Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten vergeben oder aus einem Nachschlagewerk entnommen wird und auf eine Folge von Musikwerken hinweist, die den gleichen Titel oder den gleichen Titel und die gleiche repräsentative Besetzung haben.,Setzt ein Werk in Beziehung zu einer numerischen Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten vergeben oder aus einem Nachschlagewerk entnommen wird und auf eine Folge von Musikwerken hinweist, die den gleichen Titel oder den gleichen Titel und die gleiche repräsentative Besetzung haben."],"en":["Relates a work to a nomen that is a numeric designation of musical work that is assigned by a composer or a reference source that indicates a sequence of musical works that share the same title or that share the same title and the same representative medium of performance."],"es":["Relaciona una obra con un nomen que es una designación numérica de una obra musical asignada por un compositor o una fuente de referencia que indica una secuencia de obras musicales que comparten el mismo título o que comparten el mismo título y el mismo medio representativo de interpretación."],"et":["Seostab teose muusikateose numbrilise tähistusega, mille on andnud helilooja või mis on antud teatmeallikas. Järjenumber näitab selliste muusikateoste järjestust, mis kannavad ühesugust pealkirja või ühesugust pealkirja koos iseloomuliku esituskoosseisuga."],"fi":["Liittää teoksen nomeniin, joka on säveltäjän tai tietolähteen antama musiikkiteoksen numerointi, joka osoittaa sellaisten musiikkiteosten järjestyksen, jotka jakavat saman nimekkeen tai jotka jakavat saman nimekkeen ja saman edustavan esityskokoonpanon."],"fr":["Met une œuvre en relation avec un nomen qui est une désignation numérique d’une œuvre musicale attribuée par un compositeur ou une source de référence et indiquant une séquence d’œuvres musicales ayant le même titre ou ayant le même titre et la même distribution d’exécution représentative."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy zenemű számjelzéséhez, amelyet egy zeneszerző vagy hivatkozási forrás rendelt hozzá, amely az olyan zeneművek sorrendjét jelöli, amelyek azonos címűek, vagy azonos a címük és jellegzetes az előadásmédiumuk."],"it":["Correla un’opera a una designazione numerica di opera musicale assegnata dal compositore o da una fonte di reference che ordina una sequenza di opere musicali che condividono lo stesso titolo o lo stesso mezzo d’interpretazione caratteristico."],"lv":["Sasaista darbu ar nomenu, kas ir mūzikas darba numerācijas apzīmējums, ko piešķīris komponists vai uzziņu avots un kurš norāda uz vienāda nosaukuma vai vienāda nosaukuma un vienāda oriģinālā izpildījuma veida mūzikas darbu secību."],"nl":["Relateert een werk aan een nomen dat is een numerieke aanduiding van muziekwerk dat is toegekend door een componist of een naslagwerk dat een volgorde aangeeft van muziekwerken die dezelfde titel hebben of die dezelfde titel en representatieve uitvoeringsmedium delen."],"no":["Relaterer et verk til en numerisk betegnelse på musikalsk verk som er tildelt av en komponist eller en referansekilde som viser en sekvens av muskalske verk som har samme tittel eller som har samme tittel og den samme besetningen."],"tr":["Bir eseri, bir besteci veya aynı başlığı paylaşan veya aynı başlığı ve aynı temsili performans ortamını paylaşan bir dizi müzik eserini gösteren bir referans kaynağı tarafından atanan müzik eserinin sayısal belirteci olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种资源与作为由作曲者或参考信息源分配、表示有同样题名或者同样题名和同样表演表现媒介的音乐作品序列的音乐作品的数字标识的一个命名关联起来。"]},"ToolkitDefinition":{"ar":"سمية عبارة عن تعيين رقمي لعمل موسيقي يخصصه ملحن أو مصدر مرجعي يشير إلى تسلسل الأعمال الموسيقية تحت نفس العنوان، أو تحت نفس العنوان ووسيلة الأداء.","ca":"Nomen que és una designació numèrica d’una obra musical que és assignada per un compositor o una font de referència que indica una seqüència d’obres musicals que comparteixen el mateix títol o que comparteixen el mateix títol i el mateix repartiment d’execució representatiu.","cs":"Nomen, které je číselným označením hudebního díla přiřazeným skladatelem nebo referenčním zdrojem a které označuje pořadí hudebních děl, která sdílejí stejný název, nebo stejný název a současně stejné reprezentativní obsazení.","da":"Numerisk betegnelse for musikværk, angivet af en komponist eller en referencekilde, som angiver en sekvens af musikværk, som deler samme titel, eller som deler samme titel og samme repræsentative besætning.","de":"Eine numerischen Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten vergeben oder aus einem Nachschlagewerk entnommen wird und auf eine Folge von Musikwerken hinweist, die den gleichen Titel oder den gleichen Titel und die gleiche repräsentative Besetzung haben.","de":"Eine numerischen Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten vergeben oder aus einem Nachschlagewerk entnommen wird und auf eine Folge von Musikwerken hinweist, die den gleichen Titel oder den gleichen Titel und die gleiche repräsentative Besetzung haben.","en":"A nomen that is a numeric designation of musical work that is assigned by a composer or a reference source that indicates a sequence of musical works that share the same title or that share the same title and the same representative medium of performance.","es":"Un nomen que es una designación numérica de una obra musical asignada por un compositor o una fuente de referencia que indica una secuencia de obras musicales que comparten el mismo título o que comparten el mismo título y el mismo medio representativo de interpretación.","et":"Muusikateose numbriline tähistus, mille on andnud helilooja või mis on antud teatmeallikas. Järjenumber näitab selliste muusikateoste järjestust, mis kannavad ühesugust pealkirja või ühesugust pealkirja koos iseloomuliku esituskoosseisuga.","fi":"Nomen, joka on säveltäjän tai tietolähteen antama musiikkiteoksen numerointi, joka osoittaa sellaisten musiikkiteosten järjestyksen, jotka jakavat saman nimekkeen tai jotka jakavat saman nimekkeen ja saman edustavan esityskokoonpanon.","fr":"Nomen qui est une désignation numérique d’une œuvre musicale attribuée par un compositeur ou une source de référence et indiquant une séquence d’œuvres musicales ayant le même titre ou ayant le même titre et la même distribution d’exécution représentative.","hu":"Egy nomen, egy zenemű számjelzése, amelyet egy zeneszerző vagy hivatkozási forrás rendelt hozzá, amely az olyan zeneművek sorrendjét jelöli, amelyek azonos címűek, vagy azonos a címük és jellegzetes az előadásmédiumuk.","it":"Designazione numerica di opera musicale assegnata dal compositore o da una fonte di reference che ordina una sequenza di opere musicali che condividono lo stesso titolo o lo stesso mezzo d’interpretazione caratteristico.","lv":"Mūzikas darba numerācijas apzīmējums, ko piešķīris komponists vai uzziņu avots un kurš norāda uz vienāda nosaukuma vai vienāda nosaukuma un vienāda oriģinālā izpildījuma veida mūzikas darbu secību.","nl":"Een nomen dat is een numerieke aanduiding van muziekwerk dat is toegekend door een componist of een naslagwerk dat een volgorde aangeeft van muziekwerken die dezelfde titel hebben of die dezelfde titel en representatieve uitvoeringsmedium delen.","no":"En numerisk betegnelse på musikalsk verk som er tildelt av en komponist eller en referansekilde som viser en sekvens av muskalske verk som har samme tittel eller som har samme tittel og den samme besetningen.","tr":"Aynı başlığı paylaşan veya aynı başlığı ve aynı temsili icra ortamını paylaşan bir dizi müzik eserini gösteren, bir besteci veya bir referans kaynağı tarafından atanan müzik eserinin sayısal bir tanımı olan bir isim.","zh-Hans-CN":"作为由作曲者或参考信息源分配、表示有同样题名或者同样题名和同样表演表现媒介的音乐作品序列的音乐作品的数字标识的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/serialNumberOfMusicalWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10079", "lexicalAlias":"http://rdaregistry.info/Elements/w/numericDesignationOfMusicalWork.en", "label":"has numeric designation of musical work"}],"instructionNumber":"6.16.1.3.1","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10334", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/serialNumberOfMusicalWork.en", "label":"has serial number of musical work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10334", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/serialNumberOfMusicalWork.en", "label":"has serial number of musical work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10358","label":{"ar":"له محتوى صوت لتعبيرة ممثِلة","ca":"té com a contingut sonor d’una expressió representativa","cs":"má zvukový obsah reprezentativního vyjádření","da":"har lydindhold for repræsentativt udtryk","de":"hat Toninhalt einer repräsentativen Expression","de":"hat Toninhalt einer repräsentativen Expression","en":"has sound content of representative expression","es":"tiene contenido sonoro de expresión representativa","et":"iseloomuliku väljenduse helisisu","fi":"edustavan ekspression äänisisältö","fr":"a pour contenu sonore d’une expression représentative","hu":"reprezentatív kifejezési forma hangtartalma a következő:","it":"ha come contenuto sonoro di un'espressione rappresentativa","lv":"reprezentatīvās izteiksmes skaņas saturs","nl":"heeft geluidscontent van representatieve expressie","no":"har lydinnhold for et representativt uttrykk","tr":"temsili anlatımın ses içeriği ile ilişkilidir","zh-Hans-CN":"有代表性内容表达的声音内容"},"definition":{"ar":["يربط بين عمل ووجود صوت أو عدم وجوده في تعبيرة ممثِلة لعمل."],"ca":["Relaciona una obra amb la presència o absència de so en una expressió representativa d’una obra."],"cs":["Vztahuje dílo k přítomnosti nebo nepřítomnosti zvuku v reprezentativním vyjádření díla."],"da":["Relaterer et værk til en tilstedeværelse eller fravær af lyd i et værks repræsentative udtryk."],"de":["Setzt ein Werk in Beziehung zum Vorhandensein beziehungsweise Nichtvorhandensein von Ton in einer repräsentativen Expression eines Werks.,Setzt ein Werk in Beziehung zum Vorhandensein beziehungsweise Nichtvorhandensein von Ton in einer repräsentativen Expression eines Werks."],"en":["Relates a work to a presence or absence of sound in a representative expression of a work."],"es":["Relaciona una obra con la presencia o ausencia de sonido en una expresión representativa de una obra."],"et":["Seostab teose heli olemasolu või puudumisega teose iseloomulikus väljenduses."],"fi":["Liittää teoksen äänen läsnäoloon tai puuttumiseen teoksen edustavassa ekspressiossa."],"fr":["Met une œuvre en relation avec une présence ou une absence de son dans une expression représentative d’une œuvre."],"hu":["Egy művet hozzákapcsol hang jelenlétéhez vagy hiányához egy reprezentatív kifejezési formájában."],"it":["Correla un’opera a una presenza o assenza di suono in un’espressione rappresentativa di un’opera."],"lv":["Sasaista darbu ar skaņas esamību vai tās trūkumu darba reprezentatīvajā izteiksmē."],"nl":["Relateert een werk aan een aanwezigheid of afwezigheid van geluid in een representatieve expressie van een werk."],"no":["Relaterer et verk til en tilstedeværelse eller et fravær av lyd i et representativt uttrykk av et verk."],"tr":["Bir eseri, temsili bir anlatımın sesin varlığı veya yokluğu ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与一种作品的一种代表性内容表达中声音出现或不出现的指示关联起来。"]},"ToolkitLabel":{"ar":"محتوى صوت لتعبيرة ممثِلة","ca":"contingut sonor d’una expressió representativa","cs":"zvukový obsah reprezentativního vyjádření","da":"lydindhold for repræsentativt udtryk","de":"Toninhalt einer repräsentativen Expression","de":"Toninhalt einer repräsentativen Expression","en":"sound content of representative expression","es":"contenido sonoro de expresión representativa","et":"iseloomuliku väljenduse helisisu","fi":"edustavan ekspression äänisisältö","fr":"contenu sonore d’une expression représentative","hu":"reprezentatív kifejezési formához tartozó hangtartalom:","it":"contenuto sonoro di un'espressione rappresentativa","lv":"reprezentatīvās izteiksmes skaņas saturs","nl":"geluidscontent van representatieve expressie","no":"lydinnhold for et representativt uttrykk","tr":"temsili ifadenin ses içeriği","zh-Hans-CN":"代表性内容表达的声音内容"},"ToolkitDefinition":{"ar":"وجود صوت أو عدم وجوده في تعبيرة ممثِلة لعمل.","ca":"Presència o absència de so en una expressió representativa d’una obra.","cs":"Přítomnost nebo nepřítomnost zvuku v reprezentativním vyjádření díla.","da":"Tilstedeværelse eller fravær af lyd i et værks repræsentative udtryk.","de":"Ein Vorhandensein beziehungsweise Nichtvorhandensein von Ton in einer repräsentativen Expression eines Werks.","de":"Ein Vorhandensein beziehungsweise Nichtvorhandensein von Ton in einer repräsentativen Expression eines Werks.","en":"A presence or absence of sound in a representative expression of a work.","es":"La presencia o ausencia de sonido en una expresión representativa de una obra.","et":"Heli olemasolu või puudumine teose iseloomulikus väljenduses.","fi":"Äänen läsnäolo tai puuttuminen teoksen edustavassa ekspressiossa.","fr":"Présence ou absence de son dans une expression représentative d’une œuvre.","hu":"Hang jelenléte vagy hiánya egy mű egy reprezentatív kifejezési formájában.","it":"Presenza o assenza di suono in un’espressione rappresentativa di un’opera.","lv":"Skaņas esamība vai tās trūkums darba reprezentatīvajā izteiksmē.","nl":"Een aanwezigheid of afwezigheid van geluid in een representatieve expressie van een werk.","no":"En tilstedeværelse eller et fravær av lyd i et representativt uttrykk av et verk.","tr":"Bir eserin temsili anlatımında sesin varlığı veya yokluğu.","zh-Hans-CN":"一种作品的一种代表性内容表达中声音出现或不出现的指示"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/soundContentOfRepresentativeExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10358", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/soundContentOfRepresentativeExpression.en", "label":"has sound content of representative expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10358", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/soundContentOfRepresentativeExpression.en", "label":"has sound content of representative expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10376","label":{"ar":"هو أصوات لعمل","ca":"és sons per a una obra","cs":"je zvukem k dílu","da":"er lyde til værk","de":"ist Töne für (Werk)","de":"ist Töne für (Werk)","en":"is sounds for work","es":"son sonidos para la obra","et":"heli teosele","fi":"ääni teokseen","fr":"consiste en sons pour une œuvre","hu":"hangokban kifejezett kiegészítője a következő műnek:","it":"è suono per opera","lv":"ir skaņas darbam","nl":"is geluiden voor werk","no":"er lyd for verk","tr":"Eser için ses","zh-Hans-CN":"是作品的声音"},"ToolkitLabel":{"ar":"أصوات لعمل","ca":"sons per a una obra","cs":"zvuk k dílu","da":"lyde til værk","de":"Töne für (Werk)","de":"Töne für (Werk)","en":"sounds for work","es":"sonidos para la obra","et":"heli teosele","fi":"ääni teokseen","fr":"sons pour une œuvre","hu":"hangművel ellátott mű","it":"suono per opera","lv":"skaņas darbam","nl":"geluiden voor werk","no":"lyd for verk","tr":"eser için sesler","zh-Hans-CN":"作品的声音"},"definition":{"ar":["يربط عمل بعمل يكمله عمل يتم تحقيقه على أنه صوت."],"ca":["Relaciona una obra amb una obra que es complementa amb una obra que es realitza com a so."],"cs":["Vztahuje dílo k dílu, které je doplněno dílem, které je realizováno jako zvuk."],"da":["Relaterer et værk til et værk, som er komplementeret af et værk, som realiseres som lyd."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch ein Werk aus Tönen vervollständigt wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch ein Werk aus Tönen vervollständigt wird."],"en":["Relates a work to a work that is complemented by a work that is realized as sound."],"es":["Relaciona una obra con una obra que se complementa con una obra que se realiza como sonido."],"et":["Seostab teose teosega, mis on täiendatud helidena realiseeritud teosega."],"fi":["Liittää teoksen teokseen, jota täydentää teos, joka toteutuu äänenä."],"fr":["Met une œuvre en relation avec une œuvre qui est complétée par une œuvre réalisée sous forme de sons."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy hangként kifejezett mű egészít ki."],"it":["Correla un'opera a un'opera completata da un'opera realizzata come suono."],"lv":["Sasaista darbu ar darbu, kas ir papildināts ar darbu, kas realizēts kā skaņa."],"nl":["Relateert een werk aan een werk dat gecomplementeerd wordt door een werk dat gerealiseerd is als geluid."],"no":["Relaterer et verk til et verk som utfylles av et verk som realiseres som lyd."],"tr":["Bir eseri, ses olarak gerçekleştirilen bir eserle tamamlanan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与被一种作品补充并被实现为声音的一种作品关联起来。"]},"ToolkitDefinition":{"ar":"عمل يكمله عمل يتم تحقيقه على أنه صوت.","ca":"Obra que es complementa amb una obra que es realitza com a so.","cs":"Dílo, které je doplněno dílem, které je realizováno jako zvuk.","da":"Værk, som er komplementeret af et værk, som realiseres som lyd.","de":"Ein Werk, das durch ein Werk aus Tönen vervollständigt wird.","de":"Ein Werk, das durch ein Werk aus Tönen vervollständigt wird.","en":"A work that is complemented by a work that is realized as sound.","es":"Una obra que se complementa con una obra que se realiza como sonido.","et":"Teos, mis on täiendatud helidena realiseeritud