                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/musicForWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10106", "lexicalAlias":"http://rdaregistry.info/Elements/w/incidentalMusicForWork.en", "label":"is incidental music for work"},{"@id":"http://rdaregistry.info/Elements/w/P10245", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForMotionPictureWork.en", "label":"is music for motion picture work"},{"@id":"http://rdaregistry.info/Elements/w/P10244", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForRadioProgramWork.en", "label":"is music for radio program work"},{"@id":"http://rdaregistry.info/Elements/w/P10242", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForTelevisionProgramWork.en", "label":"is music for television program work"},{"@id":"http://rdaregistry.info/Elements/w/P10240", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForVideoWork.en", "label":"is music for video work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10238", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/musicForWork.en", "label":"is music for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10238", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/musicForWork.en", "label":"is music for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10093","label":{"ar":"له عمل إيضاحيات","ca":"té com a obra d’il·lustracions","cs":"má ilustrace (dílo)","da":"har illustrationsværk","de":"hat Illustrationen (Werk)","de":"hat Illustrationen (Werk)","el":"είναι εικονογραφήσεις (έργο)","en":"has illustrations work","es":"tiene obra de ilustraciones","et":"illustratsioonid teoses","fi":"kuvitus (teos)","fr":"a pour illustrations (œuvre)","hu":"illusztrációja a következő mű:","it":"ha come illustrazioni opera","lv":"darbs: ilustrācijas","nl":"heeft illustraties-werk","no":"har illustrasjoner (verk)","tr":"resimleme eseri ile ilişkilidir","vi":"là minh hoạ (tác phẩm)","zh-Hans-CN":"有插图作品"},"definition":{"ar":["يربط عمل بعمل يتكون من محتوى تصويري مصمم لشرح عمل مزيد أو تزيينه."],"ca":["Relaciona una obra amb una obra que consisteix en un contingut pictòric dissenyat per explicar o decorar una obra augmentada."],"cs":["Vztahuje dílo k dílu, které sestává z obrazového obsahu určeného k vysvětlení nebo vyzdobení rozšířeného díla."],"da":["Relaterer et værk til et værk, som består af billedindhold, som er skabt til at forklare eller udsmykke et beriget værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Bildinhalte ergänzt wird, die ein erweitertes Werk erklären oder ausschmücken sollen.,Setzt ein Werk in Beziehung zu einem Werk, das durch Bildinhalte ergänzt wird, die ein erweitertes Werk erklären oder ausschmücken sollen."],"el":["Συνδέει ένα έργο με ένα έργο που συνίσταται από εικονογραφημένο περιεχόμενο προορισμένο να εξηγήσει ή να διακοσμήσει μια επαυξημένη έκφραση."],"en":["Relates a work to a work that consists of pictorial content designed to explain or decorate an augmented work."],"es":["Relaciona una obra con una obra que consiste de contenido pictórico diseñado para explicar o decorar una obra aumentada."],"et":["Seostab teose teosega, mis sisaldab laiendatud teose selgitamiseks või kaunistamiseks mõeldud piltsisu."],"fi":["Liittää teoksen teokseen, joka koostuu laajennettavaa teosta selittävästä ja koristavasta kuvamateriaalista."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en contenu visuel destiné à expliquer ou à décorer une œuvre augmentée."],"hu":["Hozzákapcsol egy művel egy olyan képi tartalomból álló műhöz, amelyet egy bővített mű magyarázatára vagy díszítésére terveztek."],"it":["Correla un’opera a un’opera che consiste di contenuto pittorico ideato per esplicare o decorare un’opera ampliata."],"lv":["Sasaista darbu ar darbu - ilustrēts saturs, kas radīts, lai izskaidrotu vai izgreznotu papildināto darbu."],"nl":["Relateert een werk aan een werk dat bestaat uit picturale content ontworpen om een aanvullend werk te verklaren of versieren."],"no":["Relaterer et verk til et verk som består av bildeinnhold laget for å forklare eller dekorere et utvidet verk."],"tr":["Bir eseri, çoğaltılmış bir eseri açıklamak veya süslemek için tasarlanmış görsel içeriği içeren bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa nội dung tranh ảnh được thiết kế để giải thích hoặc trang trí cho tác phẩm được gia tăng."],"zh-Hans-CN":["将一种作品与由被设计用来解释或装饰一种被附增的作品的图画内容组成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل إيضاحيات","ca":"obra d’il·lustracions","cs":"ilustrace (dílo)","da":"illustrationsværk","de":"Illustrationen (Werk)","de":"Illustrationen (Werk)","el":"εικονογραφήσεις (έργο)","en":"illustrations work","es":"obra de ilustraciones","et":"illustratsioonid teoses","fi":"kuvitus (teos)","fr":"illustrations (œuvre)","hu":"illusztrációmű:","it":"illustrazioni opera","lv":"darbs: ilustrācijas","nl":"illustratiewerk","no":"illustrasjoner (verk)","tr":"resimleme eseri ile ilişkilidir","vi":"minh hoạ (tác phẩm)","zh-Hans-CN":"插图作品"},"ToolkitDefinition":{"ar":"عمل يتكون من محتوى تصويري مصمم لشرح عمل مزيد أو تزيينه.","ca":"Obra que consisteix en un contingut pictòric dissenyat per explicar o decorar una obra augmentada.","cs":"Dílo, které sestává z obrazového obsahu určeného k vysvětlení nebo vyzdobení rozšířeného díla.","da":"Værk, som består af billedindhold, som er skabt til at forklare eller udsmykke et beriget værk.","de":"Ein Werk, das durch Bildinhalte ergänzt wird, die ein erweitertes Werk erklären oder ausschmücken sollen.","de":"Ein Werk, das durch Bildinhalte ergänzt wird, die ein erweitertes Werk erklären oder ausschmücken sollen.","el":"Ένα έργο που συνίσταται από εικονογραφημένο περιεχόμενο προορισμένο να εξηγήσει ή να διακοσμήσει μια επαυξημένη έκφραση.","en":"A work that consists of pictorial content designed to explain or decorate an augmented work.","es":"Una obra que consiste de contenido pictórico diseñado para explicar o decorar una obra aumentada.","et":"Teos, mis sisaldab laiendatud teose selgitamiseks või kaunistamiseks mõeldud piltsisu.","fi":"Teos, joka koostuu laajennettavaa teosta selittävästä ja koristavasta kuvamateriaalista.","fr":"Œuvre qui consiste en contenu visuel destiné à expliquer ou à décorer une œuvre augmentée.","hu":"Egy olyan képi tartalomból álló mű, amelyet egy bővített mű magyarázatára vagy díszítésére terveztek.","it":"Opera che consiste di contenuto pittorico ideato per esplicare o decorare un’opera ampliata.","lv":"Darbs - ilustrēts saturs, kas radīts, lai izskaidrotu vai izgreznotu papildināto darbu.","nl":"Een werk dat bestaat uit picturale content ontworpen om een aanvullend werk te verklaren of versieren.","no":"Et verk som består av bildeinnhold laget for å forklare eller dekorere et utvidet verk.","tr":"Genişletilmiş bir eseri açıklamak veya süslemek için tasarlanmış görsel içerikten oluşan eser.","vi":"Tác phẩm có chứa nội dung tranh ảnh được thiết kế để giải thích hoặc trang trí cho tác phẩm được gia tăng.","zh-Hans-CN":"由被设计用来解释或装饰一种被附增的作品的图画内容组成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
