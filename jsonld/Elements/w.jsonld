                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/bindingOfItemOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10310", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedItemOfWork.en", "label":"has related item of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10364", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/bindingOfItemOf.en", "label":"is binding of item of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10364", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/bindingOfItemOf.en", "label":"is binding of item of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10363","label":{"ar":"هو تجليد لتجسيدة لـ","ca":"és enquadernació d’una manifestació de","cs":"je vazbou provedení (čeho)","da":"er indbinding af manifestation af","de":"ist Einband einer Manifestation von","de":"ist Einband einer Manifestation von","en":"is binding of manifestation of","es":"es vinculante de manifestación de","et":"köide kehastusele","fi":"manifestaation sidos manifestaatiosta","fr":"est une reliure d’une manifestation de","hu":"könyvkötött megjelenési formája a következőnek:","it":"è legatura della manifestazione di","lv":"ir iesējums manifestācijai","nl":"is bindwijze van manifestatie van","no":"er innbinding av manifestasjon for","tr":"gösteriminin ciltleyicisidir","zh-Hans-CN":"是……的载体表现的装订"},"definition":{"ar":["يربط بين عمل وتجسيدة تم تجليدها."],"ca":["Relaciona una obra amb una manifestació que és enquadernada."],"cs":["Vztahuje dílo k provedení, které je svázané."],"da":["Relaterer et værk til en manifestation, som er indbundet."],"de":["Setzt ein Werk in Beziehung zu einer gebundenen Manifestation.,Setzt ein Werk in Beziehung zu einer gebundenen Manifestation."],"en":["Relates a work to a manifestation that is bound."],"es":["Relaciona una obra con una manifestación que está vinculada."],"et":["Seostab teose köidetud kehastusega."],"fi":["Liittää teoksen manifestaatioon, joka on sidottu."],"fr":["Met une œuvre en relation avec une manifestation qui est reliée."],"hu":["Hozzákapcsol egy művet egy megjelenési formához, amely maga a kötés."],"it":["Correla un’opera a una manifestazione rilegata."],"lv":["Sasaista darbu ar manifestāciju, kas ir iesieta."],"nl":["Relateert een werk aan een manifestatie die gebonden is."],"no":["Relaterer et verk til en manifestasjon som er innbundet."],"tr":["Bir eseri, bağlı olduğu bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与一种被装订的载体表现关联起来。"]},"ToolkitLabel":{"ar":"تجليد لتجسيدة لـ","ca":"enquadernació d’una manifestació de","cs":"vazba provedení (čeho)","da":"indbinding af manifestation af","de":"Einband einer Manifestation von","de":"Einband einer Manifestation von","en":"binding of manifestation of","es":"vinculante de manifestación de","et":"köide kehastusele","fi":"manifestaation sidos manifestaatiosta","fr":"reliure d’une manifestation de","hu":"könyvkötött megjelenési forma","it":"legatura della manifestazione di","lv":"ir iesējums manifestācijai","nl":"binden van manifestatie van","no":"innbinding av manifestasjon for","tr":"gösterimin ciltlenmesi","zh-Hans-CN":"……的载体表现的装订"},"ToolkitDefinition":{"ar":"تجسيدة تم تجليدها.","ca":"Manifestació que és enquadernada.","cs":"Provedení, které je svázané.","da":"Manifestation, som er indbundet.","de":"Eine gebundene Manifestation.","de":"Eine gebundene Manifestation.","en":"A manifestation that is bound.","es":"Una manifestación que está vinculada.","et":"Köidetud kehastus.","fi":"Manifestaatio, joka on sidottu.","fr":"Manifestation qui est reliée.","hu":"Egy megjelenési forma, amely maga a kötés.","it":"Manifestazione rilegata.","lv":"Manifestācija, kas ir iesieta.","nl":"Een manifestatie die gebonden is.","no":"En manifestasjon som er innbundet.","tr":"Ciltli bir gösterim.","zh-Hans-CN":"一种被装订的载体表现"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
