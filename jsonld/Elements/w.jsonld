                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/variantAccessPointForWork.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10328", "lexicalAlias":"http://rdaregistry.info/Elements/w/accessPointForWork.en", "label":"has access point for work"},{"@id":"http://rdaregistry.info/Elements/x/P00022", "lexicalAlias":"http://rdaregistry.info/Elements/x/variantAccessPointForRDAEntity.en", "label":"has variant access point for RDA entity"}],"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10332", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/variantAccessPointForWork.en", "label":"has variant access point for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10332", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/variantAccessPointForWork.en", "label":"has variant access point for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10023","label":{"ar":"هو معالج شعريا كعمل","ca":"és adaptat en vers com a obra","cs":"je adaptováno ve verších jako dílo","da":"er bearbejdet i versform som værk","de":"ist bearbeitet als Gedicht (Werk)","de":"ist bearbeitet als Gedicht (Werk)","el":"είναι προσαρμοσμένο σε έμμετρο λόγο ως (έργο)","en":"is adapted in verse as work","es":"es adaptada en verso como obra","et":"adapteeritud värssteosena","fi":"runomukaelma (teos)","fr":"est adapté en vers comme une œuvre","hu":"versmű-átdolgozása a következő:","it":"è adattata in versi come opera","lv":"ir adaptēts kā darbs dzejā","nl":"is bewerkt in versvorm als werk","no":"er bearbeidet til verseform som verk","tr":"manzum eser olarak uyarlanmıştır","vi":"được phỏng theo ở thể thơ của (tác phẩm)","zh-Hans-CN":"被改编成韵文作为作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن تركيب أدبي في شكل شعر مقتبس من عمل آخر."],"ca":["Relaciona una obra amb obra que és una composició literària en vers adaptada d’una altra obra."],"cs":["Vztahuje dílo k dílu, které je literární kompozicí ve formě veršů, adaptovanou z jiného díla."],"da":["Relaterer et værk til en litterær komposition i versform, bearbejdet ud fra et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einer literarischen Dichtung in Versform (Werk), die auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einer literarischen Dichtung in Versform (Werk), die auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με μια λογοτεχνική σύνθεση σε έμμετρη μορφή προσαρμοσμένη από ένα έργο-πηγή."],"en":["Relates a work to a work that is a literary composition in verse form adapted from another work."],"es":["Relaciona una obra con una obra que es una composición literaria en forma de verso adaptada de otra obra."],"et":["Seostab teose värsivormis kirjandusliku kompositsiooniga, mis on adapteeritud allikteosest."],"fi":["Liittää teoksen teokseen, joka on toisesta teoksesta runomuotoon sovitettu teos."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en une composition littéraire en vers adaptée d’une œuvre source."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik műből átdolgozott verses formájú irodalmi alkotáshoz."],"it":["Correla un’opera a una composizione letteraria in versi adattata da un’opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir literārs darbs vārsmās veidots no pamatdarba."],"nl":["Relateert een werk aan een werk dat is een literaire compositie in versvorm bewerkt van een ander werk."],"no":["Relaterer et verk til en litterær komposisjon i verseform bearbeidet fra et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan nazım edebî bir eser olan eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm văn chương ở thể thơ phỏng theo tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与被改编自另一种作品的一种文学韵文写作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج شعريا كعمل","ca":"adaptat en vers com a obra","cs":"adaptováno ve verších jako dílo","da":"bearbejdet i versform som værk","de":"Bearbeitet als Gedicht (Werk)","de":"Bearbeitet als Gedicht (Werk)","el":"προσαρμοσμένο σε έμμετρο λόγο ως (έργο)","en":"adapted in verse as work","es":"adaptada en verso como obra","et":"adapteeritud värssteosena","fi":"runomukaelma (teos)","fr":"adapté en vers comme une œuvre","hu":"versmű-átdolgozás:","it":"adattata in versi come opera","lv":"adaptēts kā darbs dzejā","nl":"bewerkt in versvorm als werk","no":"bearbeidet til verseform som verk","tr":"Manzum eser olarak uyarlanan","vi":"được phỏng theo ở thể thơ của (tác phẩm)","zh-Hans-CN":"被改编成韵文作为作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن تركيب أدبي في شكل شعر مقتبس من عمل آخر.","ca":"Obra que és una composició literària en vers adaptada d’una altra obra.","cs":"Dílo, které je literární kompozicí ve formě veršů, adaptovanou z jiného díla.","da":"Litterær komposition i versform, bearbejdet ud fra et oprindeligt værk.","de":"Eine literarische Dichtung in Versform (Werk), die auf einem anderen Werk basiert.","de":"Eine literarische Dichtung in Versform (Werk), die auf einem anderen Werk basiert.","el":"Μια λογοτεχνική σύνθεση σε έμμετρη μορφή προσαρμοσμένη από ένα έργο-πηγή.","en":"A work that is a literary composition in verse form adapted from another work.","es":"Una obra que es una composición literaria en forma de verso adaptada de otra obra.","et":"Värsivormis kirjanduslik kompositsioon, mis on adapteeritud allikteosest.","fi":"Teos, joka on toisesta teoksesta runomuotoon sovitettu teos.","fr":"Œuvre qui consiste en une composition littéraire en vers adaptée d’une œuvre source.","hu":"Egy mű, amely egy másik műből átdolgozott verses formájú irodalmi alkotás.","it":"Composizione letteraria in versi adattata da un’opera di partenza.","lv":"Literārs darbs vārsmās veidots no pamatdarba.","nl":"Een werk dat is een literaire compositie in versvorm bewerkt van een ander werk.","no":"En litterær komposisjon i verseform bearbeidet fra et kildeverk.","tr":"Başka bir eserden uyarlanmış, nazım biçiminde yazılmış edebi bir eser.","vi":"Tác phẩm văn chương ở thể thơ phỏng theo tác phẩm nguồn.","zh-Hans-CN":"被改编自另一种作品的一种文学韵文写作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
