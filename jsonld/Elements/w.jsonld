                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/authorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10061", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorAgent.en", "label":"has author agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10431", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistPerson.en", "label":"has librettist person"},{"@id":"http://rdaregistry.info/Elements/w/P10430", "lexicalAlias":"http://rdaregistry.info/Elements/w/lyricistPerson.en", "label":"has lyricist person"},{"@id":"http://rdaregistry.info/Elements/w/P10432", "lexicalAlias":"http://rdaregistry.info/Elements/w/rapporteurPerson.en", "label":"has rapporteur person"},{"@id":"http://rdaregistry.info/Elements/w/P10429", "lexicalAlias":"http://rdaregistry.info/Elements/w/screenwriterPerson.en", "label":"has screenwriter person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10436", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/authorPerson.en", "label":"has author person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10436", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/authorPerson.en", "label":"has author person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10364","label":{"ar":"هو تجليد لمفردة لـ","ca":"és enquadernació d’un ítem de","cs":"je vazbou jednotky (čeho)","da":"er indbinding af eksemplar af","de":"ist Einband eines Exemplars von","de":"ist Einband eines Exemplars von","en":"is binding of item of","es":"es vinculante del item de","et":"köide eksemplarile","fi":"kappaleen sidos kappaleesta","f