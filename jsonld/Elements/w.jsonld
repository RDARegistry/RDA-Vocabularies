                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsMotionPictureWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10025", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsMotionPictureWork.en", "label":"is adapted as motion picture work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10025", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsMotionPictureWork.en", "label":"is adapted as motion picture work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10246","label":{"ar":"له عمل موسيقى لفيلم سينمائي","ca":"té com a obra de música de pel·lícula cinematogràfica","cs":"má hudbu (dílo) pro film","da":"har filmmusikværk","de":"ist Filmmusik (Werk)","de":"ist Filmmusik (Werk)","el":"είναι μουσική κινηματογράφου (έργο)","en":"has motion picture music work","es":"tiene obras de música cinematográfica","et":"filmimuusika (teos)","fi":"elokuvamusiikki (teos)","fr":"a pour musique de film (œuvre)","hu":"mozgókép zenéje a következő:","it":"ha come musica per film opera","lv":"darbs: kinomūzika","nl":"heeft speelfilmmuziek-werk","no":"har filmmusikk (verk)","tr":"sinema filmi müziği eseri ile ilişkilidir","vi":"là âm nhạc điện ảnh (tác phẩm)","zh-Hans-CN":"有电影音乐作品"},"definition":{"ar":["يربط عمل بعمل موسيقي يكمل عملًا عبارة عن فيلم سينمائي."],"ca":["Relaciona una obra amb una obra que és una obra musical que complementa una obra que és una pel·lícula cinematogràfica."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, doplňujícím dílo, které je filmem."],"da":["Relaterer et værk til et musikværk, som komplementerer et værk, som er en spillefilm."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, das ein Filmwerk ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Filmwerk ergänzt."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο το οποίο χρησιμοποιείται σε μια κινηματογραφική ταινία."],"en":["Relates a work to A work that is a musical work that complements a work that is a motion picture."],"es":["Relaciona una obra con una obra que es una obra musical que complementa una obra que es una película."],"et":["Seostab teose muusikateosega, mis täiendab filmiteost."],"fi":["Liittää teoksen musiikkiteokseen, joka täydentää teosta, joka on elokuva."],"fr":["Met une œuvre en relation avec une œuvre musicale qui complète une œuvre cinématographique."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amely kiegészít egy mozgóképművet."],"it":["Correla un’opera a un’opera musicale che completa un’opera che è un film."],"lv":["Sasaista darbu ar mūzikas darbu, kas papildina darbu, kas ir kinofilma."],"nl":["Relateert een werk aan een muziekwerk dat een werk complementeert dat een speelfilm is."],"no":["Relaterer et verk til et musikalsk verk som utfyller en spillefilm."],"tr":["Bir eseri, sinema filmi olan bir eseri tamamlayan bir müzik eseri olan eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sử dụng tác phẩm âm nhạc trong phim điện ảnh."],"zh-Hans-CN":["将一种作品与作为一种音乐作品并补充作为一种电影的一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل موسيقى لفيلم سينمائي","ca":"obra de música de pel·lícula cinematogràfica","cs":"hudba (dílo) pro film","da":"filmmusikværk","de":"Filmmusik (Werk)","de":"Filmmusik (Werk)","el":"μουσική κινηματογράφου (έργο)","en":"motion picture music work","es":"obras de música cinematográfica","et":"filmimuusika (teos)","fi":"elokuvamusiikki (teos)","fr":"musique de film (œuvre)","hu":"filmzenemű","it":"musica per film opera","lv":"darbs: kinomūzika","nl":"speelfilm-muziekwerk","no":"filmmusikk (verk)","tr":"sinema filmi müziği çalışması","vi":"âm nhạc điện ảnh (tác phẩm)","zh-Hans-CN":"电影音乐作品"},"ToolkitDefinition":{"ar":"عمل موسيقي يكمل عملًا عبارة عن فيلم سينمائي.","ca":"Obra que és una obra musical que complementa una obra que és una pel·lícula cinematogràfica.","cs":"Dílo, které je hudebním dílem, doplňujícím dílo, které je filmem.","da":"Musikværk, som komplementerer et værk, som er en spillefilm.","de":"Ein Musikwerk, das ein Filmwerk ergänzt.","de":"Ein textliches Werk, das ein Filmwerk ergänzt.","el":"Ένα μουσικό έργο το οποίο χρησιμοποιείται σε μια κινηματογραφική ταινία.","en":"A work that is a musical work that complements a work that is a motion picture.","es":"Una obra que es una obra musical que complementa una obra que es una película.","et":"Muusikateos, mis täiendab filmiteost.","fi":"Musiikkiteos, joka täydentää teosta, joka on elokuva.","fr":"Œuvre musicale qui complète une œuvre cinématographique.","hu":"Egy mű, amely egy zenemű, amely kiegészít egy mozgóképművet.","it":"Opera musicale che completa un’opera che è un film.","lv":"Mūzikas darbs, kas papildina darbu, kas ir kinofilma.","nl":"Een muziekwerk dat een werk complementeert dat een speelfilm is.","no":"Et musikalsk verk som utfyller en spillefilm.","tr":"Bir sinema filmini tamamlayan bir müzik eseri olan bir eser","vi":"Tác phẩm sử dụng tác phẩm âm nhạc trong phim điện ảnh.","zh-Hans-CN":"作为一种音乐作品并补充作为一种电影的一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en", "label":"has music work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/motionPictureMusicWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10246", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/motionPictureMusicWork.en", "label":"has motion picture music work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10246", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/motionPictureMusicWork.en", "label":"has motion picture music work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10142","label":{"ar":"هو تكييف لعمل","ca":"és adaptació d’una obra","cs":"je adaptací díla","da":"er bearbejdelse af værk","de":"ist Bearbeitung von (Werk)","de":"ist Bearbeitung von (Werk)","el":"είναι προσαρμογή του (έργο)","en":"is adaptation of work","es":"es adaptación de obra","et":"adapteeritud teosest","fi":"mukaelma teoksesta","fr":"est une adaptation d’une œuvre","hu":"adaptációja a következő műnek:","it":"è adattamento di opera","lv":"ir adaptētais darbs","nl":"is bewerking van werk","no":"er bearbeidelse av verk","tr":"eserinin uyarlamasıdır","vi":"là phỏng theo của (tác phẩm)","zh-Hans-CN":"是作品的改编"},"definition":{"ar":["يربط عمل بعمل معدَّل لغرض، أو استخدام، أو وسيلة أخرى غير ما كان معنيًّا في الأصل."],"ca":["Relaciona una obra amb una obra que es modifica per a un objectiu, un ús o un suport diferent d’aquell per al qual es va concebre originalment."],"cs":["Vztahuje dílo k dílu, které je modifikováno pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno."],"da":["Relaterer et værk til et værk, som er tilpasset til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür es ursprünglich konzipiert wurde, bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür es ursprünglich konzipiert wurde, bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει τροποποιηθεί για έναν σκοπό, μια χρήση ή ένα μέσο άλλο από εκείνο για το οποίο αρχικά προοριζόταν."],"en":["Relates a work to a work that is modified for a purpose, use, or medium other than that for which it was originally intended."],"es":["Relaciona una obra con una obra que es modificada para un propósito, uso o medio diferente a aquel para el cual estaba originalmente destinada."],"et":["Seostab teose teosega, mida on muudetud algupärasest erineva otstarbe, kasutusviisi või meediumi jaoks."],"fi":["Liittää teoksen teokseen, jota on muokattu jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten."],"fr":["Met une œuvre en relation avec une œuvre qui est modifiée pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet olyan célra, használatra vagy médiumra módosítottak, amely eltér az eredetileg tervezettől."],"it":["Correla un’opera a un’opera che è modificata per uno scopo, utilizzo o mezzo diversi da quelli per cui era stata pensata in origine."],"lv":["Sasaista darbu ar darbu, kas ir mainīts citam nolūkam, lietojumam vai medijam."],"nl":["Relateert een werk aan een werk dat aangepast is voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was."],"no":["Relaterer et verk til et verk som er bearbeidet til et annet formål, bruksområde eller medium enn det opprinnelig var ment for."],"tr":["Bir eseri, orijinal olarak tasarlandığının dışında bir amaç, kullanım veya ortam için değiştirilmiş bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được sửa đổi cho mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc."],"zh-Hans-CN":["将一种作品与以不同于起初意图的目的、使用或媒介被修改的一种作品关联起来。"]},"note":{"ar":["ينطبق هذا العنصر على التغييرات في الشكل أو في الأعمال المعاد كتابتها بالكامل بنفس الشكل."],"ca":["Aquest element s’aplica a canvis en la forma o a obres que han estat reescrites completament en la mateixa forma."],"cs":["Tento prvek se vztahuje na změny formy nebo na díla kompletně přepsaná ve stejné formě."],"da":["Dette element gælder for ændringer i form eller for værker, som er omskrevet fuldstændigt i samme form."],"de":["Dies Element bezieht sich auf Änderungen der Form oder auf Werke, die in derselben Form vollständig neu geschrieben sind.,Dies Element bezieht sich auf Änderungen der Form oder auf Werke, die in derselben Form vollständig neu geschrieben sind."],"el":["Αυτή η σχέση βρίσκει εφαρμογή στις αλλαγές στη μορφή ή στα έργα που έχουν ξαναγραφτεί ολοκληρωτικά στην ίδια μορφή."],"en":["This element applies to changes in form or to works completely rewritten in the same form."],"es":["Este elemento aplica a cambios en la forma o a obras completamente reescritas en la misma forma."],"et":["Elementi rakendatakse muutuste puhul vormis või teoste puhul, mis on täielikult ümber kirjutatud samas vormis."],"fi":["Tämä elementti soveltuu muutoksiin muodossa tai samassa muodossa kokonaan uudelleenmuokattuihin teoksiin."],"fr":["Cette relation s’applique aux changements dans la forme ou aux œuvres complètement réécrites dans la même forme."],"hu":["Ez az elem érvényes a formai változásokra, vagy az ugyanabban a formában teljesen újraírt művekre."],"it":["Questo elemento si applica ai cambiamenti di forma o a opere completamente riscritte nella stessa forma ."],"lv":["Elements attiecas uz izmaiņām darba formā un darbiem, kas pilnīgi pārrakstīti tajā pašā formā."],"nl":["Dit element is over het algemeen van toepassing op veranderingen in vorm of op werken die compleet herschreven zijn in dezelfde vorm."],"no":["Dette elementet gjelder endringer i form eller eller i verk som er totalt omskrevet i samme form."],"tr":["Bu öğe, biçim değişiklikleri veya aynı biçimde tamamen yeniden yazılan eserler için geçerlidir."],"vi":["Nối quan hệ này áp dụng đối với thay đổi về hình thái hoặc đối cới tác phẩm được viết lại toàn bộ dưới cùng hình thái."],"zh-Hans-CN":["该元素适用于形式的改变或者以同样形式完全被改写的作品。"]},"ToolkitLabel":{"ar":"تكييف لعمل","ca":"adaptació d’una obra","cs":"adaptace díla","da":"bearbejdelse af værk","de":"Bearbeitung von (Werk)","de":"Bearbeitung von (Werk)","el":"προσαρμογή του (έργο)","en":"adaptation of work","es":"adaptación de obra","et":"adapteeritud teosest","fi":"mukaelma teoksesta","fr":"adaptation d’une œuvre","hu":"mű adaptációja:","it":"adattamento di opera","lv":"adaptētais darbs","nl":"bewerking van werk","no":"bearbeidelse av verk","tr":"Eserin uyarlaması","vi":"phỏng theo của (tác phẩm)","zh-Hans-CN":"作品的改编"},"ToolkitDefinition":{"ar":"عمل معدَّل لغرض، أو استخدام، أو وسيلة أخرى غير ما كان معنيًّا في الأصل.","ca":"Obra que es modifica per a un objectiu, un ús o un suport diferent d’aquell per al qual es va concebre originalment.","cs":"Dílo, které je modifikováno pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno.","da":"Værk, som er tilpasset til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til.","de":"Ein Werk, das für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür es ursprünglich konzipiert wurde, bearbeitet ist.","de":"Ein Werk, das für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium, als den/die/das, wofür es ursprünglich konzipiert wurde, bearbeitet ist.","el":"Ένα έργο το οποίο έχει τροποποιηθεί για έναν σκοπό, μια χρήση ή ένα μέσο άλλο από εκείνο για το οποίο αρχικά προοριζόταν.","en":"A work that is modified for a purpose, use, or medium other than that for which it was originally intended.","es":"Una obra que es modificada para un propósito, uso o medio diferente a aquel para el cual estaba originalmente destinada.","et":"Teos, mida on muudetud algupärasest erineva otstarbe, kasutusviisi või meediumi jaoks.","fi":"Teos, jota on muokattu jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten.","fr":"Œuvre qui est modifiée pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine.","hu":"Egy mű, amelyet olyan célra, használatra vagy médiumra módosítottak, amely eltér az eredetileg tervezettől","it":"Opera modificata per uno scopo, utilizzo o mezzo diversi da quelli per cui era stata pensata in origine.","lv":"Darbs, kas ir mainīts citam nolūkam, lietojumam vai medijam.","nl":"Een werk dat aangepast is voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was.","no":"Et verk som er bearbeidet til et annet formål, bruksområde eller medium enn det opprinnelig var ment for.","tr":"Başlangıçta tasarlandığı amaç, kullanım veya ortam dışında bir amaç, kullanım veya ortam için değiştirilmiş bir eser.","vi":"Tác phẩm đã được sửa đổi cho mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc.","zh-Hans-CN":"以不同于起初意图的目的、使用或媒介被修改的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
