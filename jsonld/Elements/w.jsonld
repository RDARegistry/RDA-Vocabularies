                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/relatedEntityOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/x/P00028", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedEntityOfRDAEntity.en", "label":"has related entity of RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10307", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedRDAEntityOfWork.en", "label":"has related RDA entity of work"},{"@id":"http://rdaregistry.info/Elements/w/P10256", "lexicalAlias":"http://rdaregistry.info/Elements/w/subject.en", "label":"has subject"},{"@id":"http://rdaregistry.info/Elements/w/object/P10405", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/relatedEntityOfWork.en", "label":"has related entity of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10405", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/relatedEntityOfWork.en", "label":"has related entity of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10307","label":{"ar":"له كيان \"وام\" مرتبط بعمل","ca":"té com a entitat RDA relacionada amb una obra","cs":"má s dílem související entitu RDA","da":"har RDA-entitet relateret til værk","de":"hat mit Werk in Beziehung stehende RDA-Entität","de":"hat mit Werk in Beziehung stehende RDA-Entität","el":"έχει σχετική οντότητα (έργο)","en":"has related RDA entity of work","es":"tiene entidad RDA relacionada de obra","et":"teosega seotud RDA olem","fi":"teokseen liittyvä RDA-entiteetti","fr":"a pour entité RDA en relation avec une œuvre","hu":"műhöz kapcsolódó RDA-entitás a következő:","it":"ha come entità RDA correlata a opera","lv":"ar darbu saistītā RDA entīte","nl":"heeft gerelateerde RDA-entiteit van werk","no":"har RDA-entitet relatert til verk","tr":"eserin ilgili RDA varlığı ile ilişkilidir","vi":"có thực thể có liên quan (tác phẩm)","zh-Hans-CN":"有作品的关联RDA实体"},"definition":{"ar":["يربط بين عمل وكيان \"وام\" مرتبط بعمل."],"ca":["Relaciona una obra amb una entitat RDA que s’associa amb una obra."],"cs":["Vztahuje dílo k entitě RDA, která souvisí s dílem."],"da":["Relaterer et værk til en RDA-entitet, som er knyttet til et værk."],"de":["Setzt ein Werk in Beziehung zu einer RDA-Entität, die mit einem Werk in Verbindung steht.,Setzt ein Werk in Beziehung zu einer RDA-Entität, die mit einem Werk in Verbindung steht."],"el":["Συνδέει ένα έργο με μια οντότητα που συνδέεται με ένα περιγραφόμενο έργο."],"en":["Relates a work to an RDA entity that is associated with a work."],"es":["Relaciona una obra con una entidad RDA que está asociada a una obra."],"et":["Seostab teose teosega seotud RDA olemiga."],"fi":["Liittää teoksen RDA-entiteettiin, joka liittyy teokseen."],"fr":["Met une œuvre en relation avec une entité RDA qui est associée à une œuvre."],"hu":["Hozzákapcsol egy noment egy műhöz kapcsolódó RDA-entitáshoz."],"it":["Correla un'opera a un'entità RDA che è associata a un'opera."],"lv":["Sasaista darbu ar RDA entīti, kas saistīta ar darbu."],"nl":["Relateert een werk aan een RDA-entiteit die is geassocieerd met een werk."],"no":["Relaterer et verk til en RDA-entitet som forbindes med et verk."],"tr":["Bir eseri, bir eserle bağlantılı olan bir RDA varlığıyla ilişkilendirir."],"vi":["Liên kết tác phẩm với thực thể liên quan tới tác phẩm đang được mô tả."],"zh-Hans-CN":["将一种作品与和一种作品有关的一个RDA实体关联起来。"]},"ToolkitDefinition":{"ar":"كيان \"وام\" المرتبط بعمل.","ca":"Entitat RDA que s’associa amb una obra.","cs":"Entita RDA, která souvisí s dílem.","da":"RDA-entitet, som er knyttet til et værk.","de":"Eine RDA-Entität, die mit einem Werk in Verbindung steht.","de":"Eine RDA-Entität, die mit einem Werk in Verbindung steht.","en":"An RDA entity that is associated with a work.","es":"Una entidad RDA que está asociada a una obra.","et":"Teosega seotud RDA olem.","fi":"RDA-entiteetti, joka liittyy teokseen.","fr":"Entité RDA qui est associée à une œuvre.","hu":"Egy műhöz kapcsolódó RDA-entitás.","it":"Entità RDA che è associata a un'opera.","lv":"RDA entīte, kas saistīta ar darbu.","nl":"Een RDA-entiteit die is geassocieerd met een werk.","no":"En RDA-entitet som forbindes med et verk.","tr":"Bir eserle bağlantılı olan bir RDA varlığı.","vi":"Thực thể liên quan tới tác phẩm đang được mô tả.","zh-Hans-CN":"和一种作品有关的一个RDA实体"},"ToolkitLabel":{"ar":"كيان \"وام\" مرتبط بعمل","ca":"entitat RDA relacionada amb una obra","cs":"s dílem související entita RDA","da":"RDA-entitet relateret til værk","de":"mit Werk in Beziehung stehende RDA-Entität","de":"mit Werk in Beziehung stehende RDA-Entität","en":"related RDA entity of work","es":"entidad RDA relacionada de obra","et":"teosega seotud RDA olem","fi":"teokseen liittyvä RDA-entiteetti","fr":"entité RDA en relation avec une œuvre","hu":"műhöz kapcsolódó RDA-entitás:","it":"entità RDA correlata a opera","lv":"ar darbu saistītā RDA entīte","nl":"gerelateerde RDA-entiteit van werk","no":"RDA-entitet relatert til verk","tr":"Eserin RDA varlığıyla ilişkisi","zh-Hans-CN":"作品的关联RDA实体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10405", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedEntityOfWork.en", "label":"has related entity of work"},{"@id":"http://rdaregistry.info/Elements/x/P00001", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedRDAEntityOfRDAEntity.en", "label":"has related RDA entity of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/relatedRDAEntityOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10311", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedAgentOfWork.en", "label":"has related agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10316", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedPlaceOfWork.en", "label":"has related place of work"},{"@id":"http://rdaregistry.info/Elements/w/P10317", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedTimespanOfWork.en", "label":"has related timespan of work"},{"@id":"http://rdaregistry.info/Elements/w/P10308", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedExpressionOfWork.en", "label":"has related expression of work"},{"@id":"http://rdaregistry.info/Elements/w/P10309", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedManifestationOfWork.en", "label":"has related manifestation of work"},{"@id":"http://rdaregistry.info/Elements/w/P10318", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedNomenOfWork.en", "label":"has related nomen of work"},{"@id":"http://rdaregistry.info/Elements/w/P10310", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedItemOfWork.en", "label":"has related item of work"},{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"},{"@id":"http://rdaregistry.info/Elements/w/P10324", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectRDAEntity.en", "label":"has subject RDA entity"},{"@id":"http://rdaregistry.info/Elements/w/object/P10307", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/relatedRDAEntityOfWork.en", "label":"has related RDA entity of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10307", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/relatedRDAEntityOfWork.en", "label":"has related RDA entity of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10306","label":{"ar":"له وكيل فنان مزج موسيقي","ca":"té com a agent artista de remescla","cs":"má remixéra (agenta)","da":"har agent, som er remixer","de":"hat Remix Artist (Akteur)","de":"hat Remix Artist (Akteur)","el":"έχει καλλιτέχνη remix","en":"has remix artist agent","es":"tiene agente artista de remix","et":"remiksija (tegija)","fi":"uudelleenmiksaaja (toimija)","fr":"a pour agent remixeur","hu":"remixművész ágense a következő:","it":"ha come artista di remix agente","lv":"remiksētājs (aģents)","nl":"heeft remixartiest-actor","no":"har remikser (agent)","tr":"remix sanatçısı temsilcisi ile ilişkilidir","vi":"có nghệ sỹ hoà âm","zh-Hans-CN":"有合成艺术家行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن إنشاء عمل صوتي عن طريق معالجة الأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها."],"ca":["Relaciona una obra amb un agent que és responsable de la creació d’una obra àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků."],"da":["Relaterer et værk til en agent, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für das Schaffen eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.,Setzt ein Werk in Beziehung zu einem Akteur, der für das Schaffen eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός ακουστικού έργου μέσω του χειρισμού, της επανασύνθεσης, της μίξης και της αναπαραγωγής προηγούμενα ηχογραφημένων ήχων."],"en":["Relates a work to an agent who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona una obra con un agente que es responsable de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados."],"et":["Seostab teose tegijaga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid."],"fi":["Liittää teoksen toimijaan, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával."],"it":["Correla un’opera a un agente responsabile di un’opera audio mediante la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer et verk til en agent som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir eseri, önceden kaydedilmiş sesleri değiştirerek, birleştirip karıştırarak ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm sáng tạo tác phẩm audio bằng cách thực hiện, kết hợp, hoà âm, và sản xuất lại âm thanh được ghi trước đây."],"zh-Hans-CN":["将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个行为者关联起来。"]},"note":{"ar":["تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"el":["Δεν περιλαμβάνονται οι διαδικασίες μίξης, οι οποίες δεν μεταβάλλουν ουσιαστικά τη φύση και το περιεχόμενου του πρωτότυπου έργου και η μίξη ηχογραφημένων κομματιών [με τέτοιον τρόπο], ώστε [αυτά] να εμφανίζονται ως ένα ενιαίο κομμάτι."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido del trabajo original, y la mezcla de pistas grabadas para que aparezcan como una pista continua."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Correla un’opera a un agente responsabile di un’opera audio mediante la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"vi":["Hoạt động tái hào âm không làm thay đổi cơ bản bản chất và nội dung và nội dung của tác phẩm nguyên gốc và hoà trộn các rãnh ghi với nhau để thành rãnh liên tục không được bao gồm."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"ToolkitLabel":{"ar":"وكيل فنان مزج موسيقي","ca":"agent artista de remescla","cs":"remixér (agent)","da":"agent, som er remixer","de":"Remix Artist (Akteur)","de":"Remix Artist (Akteur)","el":"καλλιτέχνης remix","en":"remix artist agent","es":"agente artista de remix","et":"remiksija (tegija)","fi":"uudelleenmiksaaja (toimija)","fr":"agent remixeur","hu":"remixművész ágens:","it":"artista di remix agente","lv":"remiksētājs (aģents)","nl":"remixartiest-actor","no":"remikser (agent)","tr":"remiks sanatçısı temsilci","vi":"nghệ sỹ hoà âm","zh-Hans-CN":"合成艺术家行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن إنشاء عمل صوتي عن طريق معالجة الأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.","ca":"Agent que és responsable de la creació d’una obra àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Agent, který je odpovědný za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků.","da":"Agent, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein Akteur, der für das Schaffen eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","de":"Ein Akteur, der für das Schaffen eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","el":"Ένας φορέας υπεύθυνος για τη δημιουργία ενός ακουστικού έργου μέσω του χειρισμού, της επανασύνθεσης, της μίξης και της αναπαραγωγής προηγούμενα ηχογραφημένων ήχων.","en":"An agent who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Un agente que es responsable de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.","et":"Tegija, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.","fi":"Toimija, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Agent qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.","hu":"Egy ágens, amely felelős egy audiomű létrehozásáért korábban rögzített hangok megmunkálásával, újrakombinálásával és reprodukálásával.","it":"Agente responsabile per la creazione di un’opera audio mediante la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.","lv":"Aģents, kas ir atbildīgs par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.","nl":"Een actor die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"En agent som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri düzenleyerek, birleştirerek, karıştırarak ve yeniden üreterek bir ses eserinin oluşturulmasından sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm sáng tạo tác phẩm audio bằng cách thực hiện, kết hợp, hoà âm, và sản xuất lại âm thanh được ghi trước đây.","zh-Hans-CN":"通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个行为者"},"altLabel":{"ar":["فنان مزج موسيقي"],"ca":["artista de remescla"],"cs":["remixér"],"da":["remixer"],"de":["Remix Artist,Remix Artist"],"en":["remix artist"],"es":["artista de remix"],"et":["remiksija"],"fi":["uudelleenmiksaaja"],"fr":["remixeur"],"hu":["remixművész:"],"it":["artista di remix"],"no":["remikser"],"tr":["remiks sanatçısı"],"zh-Hans-CN":["合成艺术家"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"See Also":[{"@id":"http://rdaregistry.info/Elements/e/P20296", "lexicalAlias":"http://rdaregistry.info/Elements/e/djAgent.en", "label":"has DJ agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10496", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistCollectiveAgent.en", "label":"has remix artist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10449", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistPerson.en", "label":"has remix artist person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10306", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remixArtistAgent.en", "label":"has remix artist agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10306", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remixArtistAgent.en", "label":"has remix artist agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10496","label":{"ar":"له وكيل جماعي فنان مزج موسيقي","ca":"té com a agent col·lectiu artista de remescla","cs":"má remixéra (kolektivního agenta)","da":"har kollektiv agent, som er remixer","de":"hat Remix Artist (Gemeinschaftlicher Akteur)","de":"hat Remix Artist (Gemeinschaftlicher Akteur)","en":"has remix artist collective agent","es":"tiene agente colectivo artista de remix","et":"remiksija (kollektiiv)","fi":"uudelleenmiksaaja (yhteistoimija)","fr":"a pour agent collectif remixeur","hu":"remixművész kollektív ágense a következő:","it":"ha come artista di remix agente collettivo","lv":"remiksētājs (grupa)","nl":"heeft remixartiest-collectieve actor","no":"har remikser (kollektiv agent)","tr":"remix sanatçısı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有合成艺术家集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل صوتي من خلال المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها."],"ca":["Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je odpovědný za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků."],"da":["Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert."],"en":["Relates a work to a collective agent who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona una obra con un agente colectivo que se encarga de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados."],"et":["Seostab teose kollektiiviga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid."],"fi":["Liittää teoksen yhteistoimijaan, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával."],"it":["Correla un'opera all'agente collettivo responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza."],"lv":["Sasaista darbu ar grupu, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas."],"nl":["Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir eseri, önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses kaynağı oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي فنان مزج موسيقي","ca":"agent col·lectiu artista de remescla","cs":"remixér (kolektivní agent)","da":"kollektiv agent, som er remixer","de":"Remix Artist (Gemeinschaftlicher Akteur)","de":"Remix Artist (Gemeinschaftlicher Akteur)","en":"remix artist collective agent","es":"agente colectivo artista de remix","et":"remiksija (kollektiiv)","fi":"uudelleenmiksaaja (yhteistoimija)","fr":"agent collectif remixeur","hu":"remixművész kollektív ágens:","it":"artista di remix agente collettivo","lv":"remiksētājs (grupa)","nl":"remixartiest-collectieve actor","no":"remikser (kollektiv agent)","tr":"remiks sanatçısı kolektif temsilci","zh-Hans-CN":"合成艺术家集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن إنشاء عمل صوتي من خلال المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.","ca":"Agent col·lectiu que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Kolektivní agent, který je odpovědný za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků.","da":"Kollektiv agent, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Ein gemeinschaftlicher Akteur, der für die Schaffung eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","de":"Ein gemeinschaftlicher Akteur, der für die Schaffung eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","en":"A collective agent who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Un agente colectivo que se encarga de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.","et":"Kollektiiv, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.","fi":"Yhteistoimija, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Agent collectif qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.","hu":"Egy kollektív ágens, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.","it":"Agente collettivo responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.","lv":"Grupa, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.","nl":"Een collectieve actor die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"En kollektiv agent som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri manipüle ederek, birleştirerek, karıştırarak ve yeniden üreterek bir ses çalışması oluşturmaktan sorumlu kolektif temsilci","zh-Hans-CN":"通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个集体行为者"},"note":{"ar":["تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido de la obra original, y la mezcla de pistas grabadas para que aparezcan como una pista continua."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell'opera originale, nonché il missaggio di brani registrati che appaiono come un unico brano."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10306", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistAgent.en", "label":"has remix artist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10543", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistCorporateBody.en", "label":"has remix artist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10590", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistFamily.en", "label":"has remix artist family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10496", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remixArtistCollectiveAgent.en", "label":"has remix artist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10496", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remixArtistCollectiveAgent.en", "label":"has remix artist collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10543","label":{"ar":"له هيئة فنانة مزج موسيقي","ca":"té com a entitat corporativa artista de remescla","cs":"má remixéra (korporaci)","da":"har korporation, som er remixer","de":"hat Remix Artist (Körperschaft)","de":"hat Remix Artist (Körperschaft)","en":"has remix artist corporate body","es":"tiene cuerpo corporativo artista de remix","et":"remiksija (asutus)","fi":"uudelleenmiksaaja (yhteisö)","fr":"a pour collectivité remixeuse","hu":"remixművész testülete a következő:","it":"ha come artista di remix ente","lv":"remiksētājs (institūcija)","nl":"heeft remixartiest-corporatie","no":"har remikser (korporasjon)","tr":"remix sanatçısı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有合成艺术家团体"},"definition":{"ar":["يربط بين عمل وهيئة مشتركة مسئولة عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků."],"da":["Relaterer et værk til en korporation, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert."],"en":["Relates a work to a corporate body who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados."],"et":["Seostab teose asutusega, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával."],"it":["Correla un'opera a un ente responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir eseri, önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة فنانة مزج موسيقي","ca":"entitat corporativa artista de remescla","cs":"remixér (korporace)","da":"korporation, som er remixer","de":"Remix Artist (Körperschaft)","de":"Remix Artist (Körperschaft)","en":"remix artist corporate body","es":"cuerpo corporativo artista de remix","et":"remiksija (asutus)","fi":"uudelleenmiksaaja (yhteisö)","fr":"collectivité remixeuse","hu":"remixművész testület:","it":"artista di remix ente","lv":"remiksētājs (institūcija)","nl":"remixartiest-corporatie","no":"remikser (korporasjon)","tr":"remiks sanatçısı tüzel kişi","zh-Hans-CN":"合成艺术家团体"},"ToolkitDefinition":{"ar":"هيئة مسئولة عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.","ca":"Entitat corporativa que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Korporace, která je odpovědná za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků.","da":"Korporation, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Eine Körperschaft, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","de":"Eine Körperschaft, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","en":"A corporate body who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Un cuerpo corporativo que es responsable de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.","et":"Asutus, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.","fi":"Yhteisö, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Collectivité qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.","hu":"Egy testület, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.","it":"Ente responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.","lv":"Institūcija, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.","nl":"Een corporatie die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"En korporasjon som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri manipüle ederek, yeniden birleştirerek, miksleyerek ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu bir tüzel kişi.","zh-Hans-CN":"通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个团体"},"note":{"ar":["تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido de la obra original, y la mezcla de pistas grabadas para que aparezcan como una pista continua."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell'opera originale, nonché il missaggio di brani registrati che appaiono come un unico brano."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10496", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistCollectiveAgent.en", "label":"has remix artist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10543", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remixArtistCorporateBody.en", "label":"has remix artist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10543", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remixArtistCorporateBody.en", "label":"has remix artist corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10590","label":{"ar":"له عائلة فنانة مزج موسيقي","ca":"té com a família artista de remescla","cs":"má remixéra (rodinu)","da":"har familie, som er remixer","de":"hat Remix Artist (Familie)","de":"hat Remix Artist (Familie)","en":"has remix artist family","es":"tiene familia artista de remix","et":"remiksija (perekond)","fi":"uudelleenmiksaaja (suku)","fr":"a pour famille remixeuse","hu":"remixművész családja a következő:","it":"ha come artista di remix famiglia","lv":"remiksētājs (dzimta/ģimene)","nl":"heeft remixartiest-familie","no":"har remikser (familie)","tr":"remix sanatçısı ailesi ile ilişkilidir","zh-Hans-CN":"有合成艺术家家族"},"definition":{"ar":["يربط بين عمل وعائلة مسئولة عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها."],"ca":["Relaciona una obra amb una família que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje dílo k rodině, která je odpovědná za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků"],"da":["Relaterer et værk til en familie, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.,Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert."],"en":["Relates a work to a family who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona una obra con una familia que es responsable de crear una obra de audio al manipular, recombinar, mezclar y reproducir sonidos previamente grabados."],"et":["Seostab teose perekonnaga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid."],"fi":["Liittää teoksen sukuun, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés."],"hu":["Hozzákapcsol egy művet egy családhoz, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával."],"it":["Correla un'opera alla famiglia responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas."],"nl":["Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer et verk til en famile som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir eseri, önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة فنانة مزج موسيقي","ca":"família artista de remescla","cs":"remixér (rodina)","da":"familie, som er remixer","de":"Remix Artist (Familie)","de":"Remix Artist (Familie)","en":"remix artist family","es":"familia artista de remix","et":"remiksija (perekond)","fi":"uudelleenmiksaaja (suku)","fr":"famille remixeuse","hu":"remixművész család:","it":"artista di remix famiglia","lv":"remiksētājs (dzimta/ģimene)","nl":"remixartiest-familie","no":"remikser (familie)","tr":"remiks sanatçısı aile","zh-Hans-CN":"合成艺术家家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.","ca":"Família que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Rodina, která je odpovědná za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků","da":"Familie, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Eine Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","de":"Eine Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","en":"A family who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una familia que es responsable de crear una obra de audio al manipular, recombinar, mezclar y reproducir sonidos previamente grabados.","et":"Perekond, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.","fi":"Suku, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Famille qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.","hu":"Egy család, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.","it":"Famiglia responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.","lv":"Dzimta/ģimene, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.","nl":"Een familie die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"En famile som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri manipüle ederek, yeniden birleştirerek, düzenleyerek ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu bir aile.","zh-Hans-CN":"通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个家族"},"note":{"ar":["تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Actividades de remix que no cambian sustancialmente la naturaleza y contenido de la obra original, y mezclar juntas pistas grabadas para que parezcan una pista continua, se excluyen."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell'opera originale, nonché il missaggio di brani registrati che appaiano come un unico brano."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10578", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorFamilyOfWork.en", "label":"has creator family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10496", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistCollectiveAgent.en", "label":"has remix artist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10590", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remixArtistFamily.en", "label":"has remix artist family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10590", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remixArtistFamily.en", "label":"has remix artist family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10449","label":{"ar":"له شخص فنان مزج موسيقي","ca":"té com a persona artista de remescla","cs":"má remixéra (osobu)","da":"har person, som er remixer","de":"hat Remix Artist (Person)","de":"hat Remix Artist (Person)","en":"has remix artist person","es":"tiene persona artista de remezcla","et":"remiksija (isik)","fi":"uudelleenmiksaaja (henkilö)","fr":"a pour personne remixeuse","hu":"remixművész személye a következő:","it":"ha come artista di remix persona","lv":"remiksētājs (persona)","nl":"heeft remixartiest-persoon","no":"har remikser (person)","tr":"remix sanatçısı kişisi ile ilişkilidir","zh-Hans-CN":"有合成艺术家个人"},"definition":{"ar":["يربط بين عمل وشخص مسئول عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها."],"ca":["Relaciona una obra amb una persona que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament."],"cs":["Vztahuje dílo k osobě, která je odpovědná za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků."],"da":["Relaterer et værk til en person, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde."],"de":["Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.,Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert."],"en":["Relates a work to a person who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds."],"es":["Relaciona una obra con una persona que se encarga de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados."],"et":["Seostab teose isikuga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid."],"fi":["Liittää teoksen henkilöön, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä."],"fr":["Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés."],"hu":["Hozzákapcsol egy művet egy személyhez, aki felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával."],"it":["Correla un'opera alla persona responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza."],"lv":["Sasaista darbu ar personu, kura ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas."],"nl":["Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden."],"no":["Relaterer et verk til en person som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere."],"tr":["Bir eseri önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri yaratmaktan sorumlu olan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص فنان مزج موسيقي","ca":"persona artista de remescla","cs":"remixér (osoba)","da":"person, som er remixer","de":"Remix Artist (Person)","de":"Remix Artist (Person)","en":"remix artist person","es":"persona artista de remezcla","et":"remiksija (isik)","fi":"uudelleenmiksaaja (henkilö)","fr":"personne remixeuse","hu":"remixművész személy:","it":"artista di remix persona","lv":"remiksētājs (persona)","nl":"remixartiest-persoon","no":"remikser (person)","tr":"remiks sanatçısı kişi","zh-Hans-CN":"合成艺术家个人"},"ToolkitDefinition":{"ar":"شخص مسئول عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.","ca":"Persona que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.","cs":"Osoba, která je odpovědná za vytvoření zvukového díla pomocí manipulace, rekombinace, mixáže a reprodukce dříve nahraných zvuků.","da":"Person, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.","de":"Eine Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","de":"Eine Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.","en":"A person who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.","es":"Una persona que se encarga de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.","et":"Isik, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.","fi":"Henkilö, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.","fr":"Personne qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.","hu":"Egy személy, aki felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.","it":"Persona responsabile della creazione di un'opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.","lv":"Persona, kura ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.","nl":"Een persoon die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.","no":"En person som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.","tr":"Önceden kaydedilmiş sesleri manipüle ederek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri yaratmaktan sorumlu olan kişi.","zh-Hans-CN":"通过操纵、重新组合、混合和复制事先录制的声音而负责创作一种音频作品的一个个人"},"note":{"ar":["تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر."],"ca":["S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua."],"cs":["Remixování, které podstatně nemění povahu a obsah původního díla, a mixování nahraných stop dohromady tak, aby vypadaly jako jedna souvislá stopa, jsou vyloučeny."],"da":["Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet."],"de":["Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.,Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis."],"en":["Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded."],"es":["Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido del trabajo original, y la mezcla de pistas grabadas para que aparezcan como una pista continua."],"et":["Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks."],"fi":["Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi."],"fr":["Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue."],"hu":["Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése."],"it":["Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell'opera originale, nonché il missaggio di brani registrati che appaiono come un unico brano."],"lv":["Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā."],"nl":["Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten."],"no":["Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert."],"tr":["Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir."],"zh-Hans-CN":["不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10306", "lexicalAlias":"http://rdaregistry.info/Elements/w/remixArtistAgent.en", "label":"has remix artist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10449", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remixArtistPerson.en", "label":"has remix artist person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10449", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remixArtistPerson.en", "label":"has remix artist person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10346","label":{"ar":"له تعبيرة ممثِلة","ca":"té com a expressió representativa","cs":"má reprezentativní vyjádření","da":"har repræsentativt udtryk","de":"hat repräsentative Expression","de":"hat repräsentative Expression","en":"has representative expression","es":"tiene expresión representativa","et":"iseloomulik väljendus","fi":"edustava ekspressio","fr":"a pour expression représentative","hu":"reprezentatív kifejezési formája a következő:","it":"ha come espressione rappresentativa","lv":"reprezentatīvā izteiksme","nl":"heeft representatieve expressie","no":"har representativt uttrykk","tr":"temsili anlatım ile ilişkilidir","zh-Hans-CN":"有代表性内容表达"},"definition":{"ar":["يربط بين عمل وتعبيرة تُعد مصدرًا أساسيًا للبيانات لتحديد عمل."],"ca":["Relaciona una obra amb una expressió que es considera una font canònica de dades per identificar una obra."],"cs":["Vztahuje dílo k vyjádření, které je považováno za reprezentativní zdroj údajů pro identifikaci díla."],"da":["Relaterer et værk til et udtryk, som er en anerkendt datakilde for identificering af et værk."],"de":["Setzt ein Werk in Beziehung zu einer Expression, die als anerkannte Datenquelle zur Identifizierung eines Werks gilt.,Setzt ein Werk in Beziehung zu einer Expression, die als anerkannte Datenquelle zur Identifizierung eines Werks gilt."],"en":["Relates a work to an expression that is considered a canonical source of data for identifying a work."],"es":["Relaciona una obra con una expresión que se considera una fuente canónica de datos para identificar una obra."],"et":["Seostab teose väljendusega, mida peetakse teose identifitseerimisel kanooniliseks andmeallikaks."],"fi":["Liittää teoksen ekspressioon, jota pidetään kanonisena tietolähteenä teoksen identifioinnissa."],"fr":["Met une œuvre en relation avec une expression qui est considérée comme une source canonique de données pour l’identification d’une œuvre."],"hu":["Egy művet hozzákapcsol egy kifejezési formához, amely kanonizált adatforrásnak tekinthető egy mű azonosításához."],"it":["Correla un’opera a un’espressione che è considerata la fonte convenzionale dei dati per identificare un’opera."],"lv":["Sasaista darbu ar izteiksmi, ko uzskata par kanonisku datu avotu darba identificēšanai."],"nl":["Relateert een werk aan een expressie die beschouwd wordt als canonieke bron van data voor het identificeren van een werk."],"no":["Relaterer et verk til et uttrykk som er en anerkjent datakilde for identifisering av et verk."],"tr":["Bir eseri, bir eseri tanımlamak için doğrulanmış bir veri kaynağı olarak kabul edilen bir anlatımla ilişkilendirir."],"zh-Hans-CN":["将一种作品与被认为是标识一种作品的数据之典范信息源的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة ممثِلة","ca":"expressió representativa","cs":"reprezentativní vyjádření","da":"repræsentativt udtryk","de":"Repräsentative Expression","de":"Repräsentative Expression","en":"representative expression","es":"expresión representativa","et":"iseloomulik väljendus","fi":"edustava ekspressio","fr":"expression représentative","hu":"reprezentatív kifejezési forma:","it":"espressione rappresentativa","lv":"reprezentatīvā izteiksme","nl":"representatieve expressie","no":"representativt uttrykk","tr":"temsili anlatım","zh-Hans-CN":"代表性内容表达"},"ToolkitDefinition":{"ar":"تعبيرة تُعد مصدرًا أساسيًا للبيانات لتحديد عمل.","ca":"Expressió que es considera una font canònica de dades per identificar una obra.","cs":"Vyjádření, které je považováno za reprezentativní zdroj údajů pro identifikaci díla.","da":"Udtryk, som er en anerkendt datakilde for identificering af et værk.","de":"Eine Expression, die als anerkannte Datenquelle zur Identifizierung eines Werks gilt.","de":"Eine Expression, die als anerkannte Datenquelle zur Identifizierung eines Werks gilt.","en":"An expression that is considered a canonical source of data for identifying a work.","es":"Una expresión que se considera una fuente canónica de datos para identificar una obra.","et":"Väljendus, mida peetakse teose identifitseerimisel kanooniliseks andmeallikaks.","fi":"Ekspressio, jota pidetään kanonisena tietolähteenä teoksen identifioinnissa.","fr":"Expression qui est considérée comme une source canonique de données pour l’identification d’une œuvre.","hu":"Egy kifejezési forma, amely kanonizált adatforrásnak tekinthető egy mű azonosításához.","it":"Espressione che è considerata la fonte dei dati convenzionale per identificare un’opera.","lv":"Izteiksme, ko uzskata par kanonisku datu avotu darba identificēšanai.","nl":"Een expressie die beschouwd wordt als canonieke bron van data voor het identificeren van een werk.","no":"Et uttrykk som er en anerkjent datakilde for identifisering av et verk.","tr":"Bir eseri tanımlamak için kanonik bir veri kaynağı olarak kabul edilen bir anlatım.","zh-Hans-CN":"被认为是标识一种作品的数据之典范信息源的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/representativeExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10078", "lexicalAlias":"http://rdaregistry.info/Elements/w/expressionOfWork.en", "label":"has expression of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10346", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/representativeExpression.en", "label":"has representative expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10346", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/representativeExpression.en", "label":"has representative expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10293","label":{"ar":"له وكيل باحث","ca":"té com a agent investigador","cs":"má výzkumníka (agenta)","da":"har agent, som er researcher","de":"hat Forscherin/Forscher (Akteur)","de":"hat Forscherin/Forscher (Akteur)","el":"έχει ερευνητή","en":"has researcher agent","es":"tiene agente investigador","et":"uurija (tegija)","fi":"tutkija (toimija)","fr":"a pour agent recherchiste","hu":"kutató ágense a következő:","it":"ha come ricercatore agente","lv":"pētnieks (aģents)","nl":"heeft onderzoeker-actor","no":"har forsker (agent)","tr":"araştırmacı temsilcisi ile ilişkilidir","vi":"có nhà nghiên cứu","zh-Hans-CN":"有研究者行为者"},"definition":{"ar":["يربط بين عمل ووكيل يقوم بإجراء بحث لدعم إنشاء عمل."],"ca":["Relaciona una obra amb un agent que fa recerca per donar suport a la creació d’una obra."],"cs":["Vztahuje dílo k agentovi, který provádí výzkum na podporu vytvoření díla."],"da":["Relaterer et værk til en agent, som udfører research til at understøtte skabelsen af et værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der Forschung betreibt, um das Schaffen eines Werks zu unterstützen.,Setzt ein Werk in Beziehung zu einem Akteur, der Forschung betreibt, um das Schaffen eines Werks zu unterstützen."],"el":["Συνδέει ένα έργο με έναν φορέα, ο οποίος διεξάγει έρευνα υποστηρικτικά της δημιουργίας ενός έργου."],"en":["Relates a work to an agent who does research in support of the creation of a work."],"es":["Relaciona una obra con un agente que realiza investigaciones en apoyo a la creación de una obra."],"et":["Seostab teose tegijaga, kes teeb teose loomise heaks uurimistööd."],"fi":["Liittää teoksen toimijaan, joka tukee teoksen syntymistä tutkimuksellaan."],"fr":["Met une œuvre en relation avec un agent qui effectue des recherches pour aider à la création d’une œuvre."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely kutatást végez egy mű megalkotásának támogatására."],"it":["Correla un’opera a un agente che fa ricerche a supporto della creazione di un’opera."],"lv":["Sasaista darbu ar aģentu, kas veicis pētniecību darba radīšanai."],"nl":["Relateert een werk aan een actor die onderzoek doet ter ondersteuning van de creatie van een werk."],"no":["Relaterer et verk til en agent som forsker som støtte til å skape et verk."],"tr":["Bir eseri, eserin oluşturulmasını desteklemek için araştırma yapan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân tiến hành nghiên cứu để hỗ trợ sáng tạo tác phẩm."],"zh-Hans-CN":["将一种作品与从事研究以支持一种作品的创作的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل باحث","ca":"agent investigador","cs":"výzkumník (agent)","da":"agent, som er researcher","de":"Forscherin/Forscher (Akteur)","de":"Forscherin/Forscher (Akteur)","el":"ερευνητής","en":"researcher agent","es":"agente investigador","et":"uurija (tegija)","fi":"tutkija (toimija)","fr":"agent recherchiste","hu":"kutató ágens:","it":"ricercatore agente","lv":"pētnieks (aģents)","nl":"onderzoeker-actor","no":"forsker (agent)","tr":"araştırmacı temsilci","vi":"nhà nghiên cứu","zh-Hans-CN":"研究者行为者"},"ToolkitDefinition":{"ar":"وكيل يقوم بإجراء ب