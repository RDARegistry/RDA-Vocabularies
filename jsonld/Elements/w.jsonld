                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10194", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/indexingForWork.en", "label":"is indexing for work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10194", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/indexingForWork.en", "label":"is indexing for work (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10198","label":{"ar":"له عمل مرتبط بعمل","ca":"té com a obra relacionada amb una obra","cs":"má dílo vztahující se k dílu","da":"har værk relateret til værk","de":"hat mit Werk in Beziehung stehendes Werk","de":"hat mit Werk in Beziehung stehendes Werk","el":"έχει σχετικό έργο (έργο)","en":"has related work of work","es":"tiene obra relacionada de obra","et":"teosega seotud teos","fi":"teokseen liittyvä teos","fr":"a pour œuvre en relation avec une œuvre","hu":"mű kapcsolódó műve a következő:","it":"ha come opera correlata di opera","lv":"ar darbu saistītais darbs","nl":"heeft gerelateerd werk van werk","no":"har relatert verk av verk","tr":"eserin ilgili eseri ile ilişkilidir","vi":"có tác phẩm có liên quan (tác phẩm)","zh-Hans-CN":"有作品的关联作品"},"definition":{"ar":["يربط عمل بعمل مرتبط بعمل."],"ca":["Relaciona una obra amb una obra que s’associa amb una obra."],"cs":["Vztahuje dílo k dílu, které souvisí s dílem."],"da":["Relaterer et værk til et værk, som er knyttet til et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das mit einem Werk in Verbindung steht.,Setzt ein Werk in Beziehung zu einem Werk, das mit einem Werk in Verbindung steht."],"el":["Συνδέει ένα έργο με ένα έργο που συνδέεται με ένα περιγραφόμενο έργο."],"en":["Relates a work to a work that is associated with a work."],"es":["Relaciona una obra con una obra que está asociada a una obra."],"et":["Seostab teose teosega seotud teosega."],"fi":["Liittää teoksen teokseen, joka liittyy teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui est associée à une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy műhöz társítanak."],"it":["Correla un’opera a un’opera che è associata a un’opera."],"lv":["Sasaista darbu ar darbu, kas saistīts ar darbu."],"nl":["Relateert een werk aan een werk dat is geassocieerd met een werk."],"no":["Relaterer et verk til et verk som forbindes med et verk."],"tr":["Bir eseri, bir eserle bağlantılı olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm liên quan tới tác phẩm đang được mô tả."],"zh-Hans-CN":["将一种作品与和一种作品有关的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل مرتبط بعمل","ca":"obra relacionada amb una obra","cs":"dílo vztahující se k dílu","da":"værk relateret til værk","de":"mit Werk in Beziehung stehendes Werk","de":"mit Werk in Beziehung stehendes Werk","en":"related work of work","es":"obra relacionada de obra","et":"teosega seotud teos","fi":"teokseen liittyvä teos","fr":"œuvre en relation avec une œuvre","hu":"műhöz kapcsolódó mű","it":"opera correlata di opera","lv":"ar darbu saistītais darbs","nl":"gerelateerd werk van werk","no":"relatert verk av verk","tr":"Eserle ilişkili eser","vi":"tác phẩm có liên quan (tác phẩm)","zh-Hans-CN":"作品的关联作品"},"ToolkitDefinition":{"ar":"عمل مرتبط بعمل.","ca":"Obra que s’associa amb una obra.","cs":"Dílo, které souvisí s dílem.","da":"Værk, som er knyttet til et værk.","de":"Ein Werk, das mit einem Werk in Verbindung steht.","de":"Ein Werk, das mit einem Werk in Verbindung steht.","en":"A work that is associated with a work.","es":"Una obra que está asociada a una obra.","et":"Teosega seotud teos.","fi":"Teos, joka liittyy teokseen.","fr":"Œuvre qui est associée à une œuvre.","hu":"Egy mű, amelyet egy műhöz társítanak.","it":"Opera che è associata a un’opera.","lv":"Darbs, kas saistīts ar darbu.","nl":"Een werk dat is geassocieerd met een werk.","no":"Et verk som forbindes med et verk.","tr":"Bir eserle bağlantılı olan bir eser.","vi":"Tác phẩm liê