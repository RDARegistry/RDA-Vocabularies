                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10262", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectFamily.en", "label":"has subject family"},{"@id":"http://rdaregistry.info/Elements/w/P10339", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfCollectiveAgent.en", "label":"is description of collective agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10613", "lexicalAlias":"http://rdaregistry.info/Elements/w/metadataDescriptionOfFamily.en", "label":"is metadata description of family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10327", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/descriptionOfFamily.en", "label":"is description of family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10327", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/descriptionOfFamily.en", "label":"is description of family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10350","label":{"ar":"له تاريخ التقاط لتعبيرة ممثِلة","ca":"té com a data de captura d’una expressió representativa","cs":"má datum zaznamenání reprezentativního vyjádření","da":"har dato for indspilning af repræsentativt udtryk","de":"hat Aufzeichnungsdatum einer repräsentativen Expression","de":"hat Aufzeichnungsdatum einer repräsentativen Expression","en":"has date of capture of representative expression","es":"tiene fecha de captura de expresión representativa","et":"iseloomuliku väljenduse jäädvustamise daatum","fi":"edustavan ekspression tallennusajankohta","fr":"a pour date de captation d’une expression représentative","hu":"reprezentatív kifejezési forma rögzítési dátuma a következő:","it":"ha come data di cattura di espressione rappresentativa","lv":"reprezentatīvās izteiksmes tveršanas datējums","nl":"heeft datum van vastleggen van representatieve expressie","no":"har tidspunkt for opptak for representativt uttrykk","tr":"temsili anlatım kayıt tarihi ile ilişkilidir","zh-Hans-CN":"有代表性内容表达的摄录日期"},"definition":{"ar":["يربط بين عمل وفترة زمنية مرتبطة بتسجيل محتوى تعبيرة ممثِلة، أو تصويره، إلخ."],"ca":["Relaciona una obra amb un interval de temps que s’associa amb l’enregistrament, la filmació, etc. del contingut d’una expressió representativa."],"cs":["Vztahuje dílo k časovému vymezení, které je spojeno s zaznamenáním, natočením (atd.) obsahu reprezentativního vyjádření."],"da":["Relaterer et værk til en tidsperiode, som er knyttet til indspilning, filmoptagelse, etc., af et repræsentativt udtryks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.,Setzt ein Werk in Beziehung zu einem Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht."],"en":["Relates a work to a timespan that is associated with recording, filming, etc., the content of a representative expression."],"es":["Relaciona una obra con un lapso de tiempo que se asocia a la grabación, filmación, etc., el contenido de una expresión representativa."],"et":["Seostab teose ajavahemikuga, mis on seotud iseloomuliku väljenduse sisu salvestamise, filmimise vms jäädvustamisega."],"fi":["Liittää teoksen ajanjaksoon, joka liittyy edustavan ekspression sisällön äänitykseen, filmaukseen tms."],"fr":["Met une œuvre en relation avec un laps de temps qui est associé à l’enregistrement, au tournage, etc. du contenu d’une expression représentative."],"hu":["Hozzákapcsol egy művet egy időtartamhoz, amely egy reprezentatív kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik."],"it":["Correla un’opera a un intervallo di date associate alla registrazione, ripresa, etc. del contenuto di un’espressione rappresentativa."],"lv":["Sasaista darbu ar laikposmu, kas saistīts ar reprezentatīvās izteiksmes satura ierakstīšanu, filmēšanu u.tml."],"nl":["Relateert een werk aan een tijdspanne die geassocieerd is met het opnemen, filmen etc. van de content van een representatieve expressie."],"no":["Relaterer et verk til et tidsrom som forbindes med innspilling, opptak, etc. av innholdet i et representativt uttrykk."],"tr":["Bir eseri, temsili bir anlatımın içeriği olan kayıt, filme alma vb. ile bağlantılı olan bir zaman aralığıyla ilişkilendirir."],"zh-Hans-CN":["将一种作品与和一种代表性内容表达的内容的录制、摄制等有关的一个时间段关联起来。"]},"ToolkitLabel":{"ar":"تاريخ التقاط لتعبيرة ممثِلة","ca":"data de captura d’una expressió representativa","cs":"datum zaznamenání reprezentativního vyjádření","da":"dato for indspilning af repræsentativt udtryk","de":"Aufzeichnungsdatum einer repräsentativen Expression","de":"Aufzeichnungsdatum einer repräsentativen Expression","en":"date of capture of representative expression","es":"fecha de captura de expresión representativa","et":"iseloomuliku väljenduse jäädvustamise daatum","fi":"edustavan ekspression tallennusajankohta","fr":"date de captation d’une expression représentative","hu":"reprezentatív kifejezési formához tartozó rögzítési dátum:","it":"data di cattura di espressione rappresentativa","lv":"reprezentatīvās izteiksmes tveršanas datējums","nl":"datum van vastleggen van representatieve expressie","no":"tidspunkt for opptak for representativt uttrykk","tr":"temsili anlatımın kaydedilme tarihi","zh-Hans-CN":"代表性内容表达的摄录日期"},"ToolkitDefinition":{"ar":"فترة زمنية مرتبطة بتسجيل محتوى تعبيرة ممثِلة، أو تصويره، إلخ.","ca":"Interval de temps que s’associa amb l’enregistrament, la filmació, etc. del contingut d’una expressió representativa.","cs":"Časové vymezení, které je spojeno s zaznamenáním, natočením (atd.) obsahu reprezentativního vyjádření.","da":"Tidsperiode, som er knyttet til indspilning, filmoptagel