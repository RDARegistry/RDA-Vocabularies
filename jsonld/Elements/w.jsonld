                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/artistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10058", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistAgent.en", "label":"has artist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10428", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistPerson.en", "label":"has book artist person"},{"@id":"http://rdaregistry.info/Elements/w/P10426", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherPerson.en", "label":"has calligrapher person"},{"@id":"http://rdaregistry.info/Elements/w/P10427", "lexicalAlias":"http://rdaregistry.info/Elements/w/sculptorPerson.en", "label":"has sculptor person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10451", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/artistPerson.en", "label":"has artist person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10451", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/artistPerson.en", "label":"has artist person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10347","label":{"ar":"له نسبة باعية لتعبيرة ممثِلة","ca":"té com a relació d’aspecte d’una expressió representativa","cs":"má poměr stran reprezentativního vyjádření","da":"har dimensionsforhold for repræsentativt udtryk","de":"hat Bildformat einer repräsentativen Expression","de":"hat Bildformat einer repräsentativen Expression","en":"has aspect ratio of representative expression","es":"tiene relación de aspecto de expresión representativa","et":"iseloomuliku väljenduse kuvasuhe","fi":"edustavan ekspression kuvasuhde","fr":"a pour format d’image d’une expression représentative","hu":"reprezentatív kifejezési forma képmérataránya a következő:","it":"ha come rapporto d'aspetto di espressione rappresentativa","lv":"reprezentatīvās izteiksmes attēla proporcija","nl":"heeft aspectratio van representatieve expressie","no":"har bildesideforhold for representativt uttrykk","tr":"temsili anlatımın en boy oranı ile ilişkilidir","zh-Hans-CN":"有代表性内容表达的宽高比"},"definition":{"ar":["يربط بين عمل والنسبة العددية لعرض تعبيرة ممثِلة لعمل صورة متحركة إلى ارتفاعها."],"ca":["Relaciona una obra amb una relació numèrica entre l’amplada i l’altura d’una expressió representativa d’una obra d’imatge en moviment."],"cs":["Vztahuje dílo k číselnému poměru šířky a výšky reprezentativního vyjádření pohyblivého obrazu (díla)."],"da":["Relaterer et værk til et numerisk forhold mellem bredden og højden af et repræsentativt udtryk af et levende billedeværk."],"de":["Setzt ein Werk in Beziehung zu einem Zahlenverhältnis von Breite zu Höhe einer repräsentativen Expression eines Bewegtbildwerks.,Setzt ein Werk in Beziehung zu einem Zahlenverhältnis von Breite zu Höhe einer repräsentativen Expression eines Bewegtbildwerks."],"en":["Relates a work to a numerical ratio of the width to the height of a representative expression of a moving image work."],"es":["Relaciona una obra con una relación numérica entre el ancho y el alto de una expresión representativa de una obra de imagen en movimiento."],"et":["Seostab teose liikuvast pildist koosneva teose iseloomuliku väljenduse laiuse ja kõrguse arvulise suhtega."],"fi":["Liittää teoksen liikkuvan kuvan teoksen edustavan ekspression leveyden ja korkeuden väliseen numeeriseen suhteeseen."],"fr":["Met une œuvre en relation avec un rapport numérique entre la largeur et la hauteur d’une expression représentative d’une œuvre d’images animées."],"hu":["Hozzákapcsol egy művet egy arányszámhoz, amely egy mozgóképmű reprezentatív kifejezési formájának szélességét viszonyítja annak magasságához."],"it":["Correla un’opera a un rapporto tra l’ampiezza e l’altezza di una espressione rappresentativa di un’opera immagine in movimento."],"lv":["Sasaista darbu ar kustīgā attēla reprezentatīvās izteiksmes platuma un augstuma skaitlisko attiecību."],"nl":["Relateert een werk aan een numerieke verhouding van de breedte tot de hoogte van een representatieve expressie van een speelfilmwerk."],"no":["Relaterer et verk til et tallmessig forhold mellom bredden og høyden til et representativt uttrykk av et verk bestående av levende bilder."],"tr":["Bir eseri, hareketli bir görüntü eserinin temsili bir anlatımının genişliğinin yüksekliğine sayısal oranıyla ilişkilendirir."],"zh-Hans-CN":["将一种作品与一种动态图像作品的一种代表性内容表达的宽度和高度的数字比关联起来。"]},"ToolkitLabel":{"ar":"نسبة باعية لتعبيرة ممثِلة","ca":"relació d’aspecte d’una expressió representativa","cs":"poměr stran reprezentativního vyjádření","da":"dimensionsforhold for repræsentativt udtryk","de":"Bildformat einer repräsentativen Expression","de":"Bildformat einer repräsentativen Expression","en":"aspect ratio of representative expression","es":"relación de aspecto de expresión representativa","et":"iseloomuliku väljenduse kuvasuhe","fi":"edustavan ekspression kuvasuhde","fr":"format d’image d’une expression représentative","hu":"reprezentatív kifejezési formához tartozó képméretarány:","it":"rapporto d'aspetto dell'espressione rappresentativa","lv":"reprezentatīvās izteiksmes attēla proporcija","nl":"aspectratio van representatieve expressie","no":"bildesideforhold for representativt uttrykk","tr":"temsili anlatımın görüntü oranı","zh-Hans-CN":"代表性内容表达的宽高比"},"ToolkitDefinition":{"ar":"النسبة العددية لعرض تعبيرة ممثِلة لعمل صورة متحركة إلى ارتفاعها.","ca":"Relació numèrica entre l’amplada i l’altura d’una expressió representativa d’una obra d’imatge en moviment.","cs":"Číselný poměr šířky a výšky reprezentativního vyjádření pohyblivého obrazu (díla).","da":"Numerisk forhold mellem bredden og højden af et repræsentativt udtryk af et levende billedeværk.","de":"Ein Zahlenverhältnis von Breite zu Höhe einer repräsentativen Expression eines Bewegtbildwerks.","de":"Ein Zahlenverhältnis von Breite zu Höhe einer repräsentativen Expression eines Bewegtbildwerks.","en":"A numerical ratio of the width to the height of a representative expression of a moving image work.","es":"Una relación numérica entre el ancho y el alto de una expresión representativa de una obra de imagen en movimiento.","et":"Liikuvast pildist koosneva teose iseloomuliku väljenduse laiuse ja kõrguse arvuline suhe.","fi":"Liikkuvan kuvan teoksen edustavan ekspression leveyden ja korkeuden välinen numeerinen suhde.","fr":"Rapport numérique entre la largeur et la hauteur d’une expression représentative d’une œuvre d’images animées.","hu":"Egy arányszám, amely egy mozgóképmű reprezentatív kifejezési formájának szélességét viszonyítja annak magasságához.","it":"Rapporto tra l’ampiezza e l’altezza di una espressione rappresentativa di un’opera immagine in movimento.","lv":"Kustīgā attēla reprezentatīvās izteiksmes platuma un augstuma skaitliskā attiecība","nl":"Een numerieke verhouding van de breedte tot de hoogte van een representatieve expressie van een speelfilmwerk.","no":"Et tallmessig forhold mellom bredden og høyden til et representativt uttrykk av et verk bestående av levende bilder.","tr":"Hareketli bir görüntü eserinin temsili bir anlatımının genişliğinin yüksekliğine sayısal oranı.","zh-Hans-CN":"一种动态图像作品的一种代表性内容表达的宽度和高度的数字比"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
