                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10201", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/findingAidForWork.en", "label":"is finding aid for work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10201", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/findingAidForWork.en", "label":"is finding aid for work (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10367","label":{"ar":"له عنوان مفتاحي","ca":"té com a títol clau","cs":"má klíčový název","da":"har nøgletitel","de":"hat Key Title","de":"hat Key Title","en":"has key title","es":"tiene título clave","et":"võtmepealkiri","fi":"avainnimeke","fr":"a pour titre-clé","hu":"kulcscíme a következő:","it":"ha come titolo chiave","lv":"atslēgnosaukums","nl":"heeft key title","no":"har nøkkeltittel","tr":"ana başlık ile ilişkilidir","zh-Hans-CN":"有识别题名"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن عنوان عمل خصصته وكالة تسجيل ردمد."],"ca":["Relaciona una obra amb un nomen que és un títol d’obra que és assignat per una agència de registre de l’ISSN."],"cs":["Vztahuje dílo k nomen, které je názvem díla, přiřazeným registrační agenturou ISSN."],"da":["Relaterer et værk til en titel på værk, som er tildelt af et ISSN-kontor."],"de":["Setzt ein Werk in Beziehung zu einem Titel eines Werks, der durch eine ISSN-Registrierungsstelle zugewiesen wird.,Setzt ein Werk in Beziehung zu einem Titel eines Werks, der durch eine ISSN-Registrierungsstelle zugewiesen wird."],"en":["Relates a work to a nomen that is a title of work that is assigned by an ISSN registration agency."],"es":["Relaciona una obra con un nomen que es un título de obra que es asignado por una agencia de registro de ISSN."],"et":["Seostab teose teose pealkirjaga, mille on määranud ISSN registreerimise agentuur."],"fi":["Liittää teoksen nomeniin, joka on teoksen nimeke, jonka on antanut ISSN-rekisteröintitoimisto."],"fr":["Met une œuvre en relation avec un nomen qui est un titre d’œuvre attribué par une agence d’enregistrement de l’ISSN."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy olyan műcímhez, amelyet egy ISSN regisztrációs ügynökség jegyez."],"it":["Correla un’opera a un titolo dell'opera che è assegnato da un’agenzia di registrazione ISSN."],"lv":["Sasaista darbu ar nomenu, kas ir unikāls nosaukums, ko resursam piešķīrusi starptautiskā ISSN aģentūra."],"nl":["Relateert een werk aan een nomen dat is een titel van een werk dat toegekend is door een ISSN-registratiebureau."],"no":["Relaterer et verk til en tittel for verk som er tildelt av et ISSN-kontor."],"tr":["Bir eseri, bir ISSN kayıt kuruluşu tarafından atanan bir eser başlığı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为被国际标准连续出版物号一个注册机构分配之作品的一个题名的一个命名关联起来。"]},"ToolkitLabel":{"ar":"عنوان مفتاحي","ca":"títol clau","cs":"klíčový název","da":"nøgletitel","de":"Key Title","de":"Key Title","en":"key title","es":"título clave","et":"võtmepealkiri","fi":"avainnimeke","fr":"titre-clé","hu":"kulcscíme:","it":"titolo chiave","lv":"atslēgnosaukums","nl":"key title","no":"nøkkeltittel","tr":"anahtar başlık","zh-Hans-CN":"识别题名"},"ToolkitDefinition":{"ar":"تسمية عبارة عن عنوان عمل خصصته وكالة تسجيل ردمد.","ca":"Relaciona una obra amb un nomen que és un títol d’obra que és assignat per una agència de registre de l’ISSN.","cs":"Nomen, které je názvem díla, přiřazeným registrační agenturou ISSN.","da":"Titel på værk, som er tildelt af et ISSN-kontor.","de":"Ein Titel eines Werks, der durch eine ISSN-Registrierungsstelle zugewiesen wird.","de":"Ein Titel eines Werks, der durch eine ISSN-Registrierungsstelle zugewiesen wird.","en":"A nomen that is a title of work that is assigned by an ISSN registration agency.","es":"Un nomen que es un título de obra que es asignado por una agencia de registro de ISSN.","et":"Teose pealkiri, mille on määranud ISSN registreerimise agentuur.","fi":"Nomen, joka on teoksen nimeke, jonka on antanut ISSN-rekisteröintitoimisto.","fr":"Nomen qui est un titre d’œuvre attribué par une agence d’enregistrement de l’ISSN.","hu":"Egy nomen, egy olyan műcím, amelyet egy ISSN regisztrációs ügynökség jegyez.","it":"Titolo dell'opera che è assegnato da un’agenzia di registrazione ISSN.","lv":"Unikāls nosaukums, ko resursam piešķīrusi starptautiskā ISSN aģentūra.","nl":"Een nomen dat is een titel van een werk dat toegekend is door een ISSN-registratiebureau.","no":"En tittel for verk som er tildelt av et ISSN-kontor.","tr":"Bir ISSN kayıt ajansı tarafından atanan bir eser başlığı olan bir isim.","zh-Hans-CN":"作为被国际标准连续出版物号一个注册机构分配之作品的一个题名的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
