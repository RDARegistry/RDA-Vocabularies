/verseAdaptationOfWork.en", "label":"is verse adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/P10138", "lexicalAlias":"http://rdaregistry.info/Elements/w/videoAdaptationOfWork.en", "label":"is video adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/P10250", "lexicalAlias":"http://rdaregistry.info/Elements/w/videoGameAdaptationOfWork.en", "label":"is video game adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/P10133", "lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayBasedOnWork.en", "label":"is screenplay based on work"},{"@id":"http://rdaregistry.info/Elements/w/P10189", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettoBasedOnWork.en", "label":"is libretto based on work"},{"@id":"http://rdaregistry.info/Elements/w/P10137", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioScriptBasedOnWork.en", "label":"is radio script based on work"},{"@id":"http://rdaregistry.info/Elements/w/P10233", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicalTheatreAdaptationOfWork.en", "label":"is musical theatre adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/P10234", "lexicalAlias":"http://rdaregistry.info/Elements/w/operaAdaptationOfWork.en", "label":"is opera adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptationOfWork.en", "label":"is adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptationOfWork.en", "label":"is adaptation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10108","label":{"ar":"هو مزيد بعمل","ca":"és augmentat per una obra","cs":"je rozšířeno o dílo","da":"er beriget med værk","de":"ist erweitert durch (Werk)","de":"ist erweitert durch (Werk)","el":"είναι επαυξημένο από (έργο)","en":"is augmented by work","es":"es aumentado por obra","et":"laiendatud teosega","fi":"laajennettu teoksella","fr":"est augmenté par une œuvre","hu":"bővíti a következő mű:","it":"è ampliata da opera","lv":"darba papildinājums","nl":"is aangevuld door werk","no":"er utvidet av verk","tr":"eser ile arttırılmıştır","vi":"được gia tăng bởi (tác phẩm)","zh-Hans-CN":"被作品附增"},"definition":{"ar":["يربط عمل بعمل يضيف إلى محتوى عمل سائد."],"ca":["Relaciona una obra amb una obra que afegeix el contingut d’una obra predominant."],"cs":["Vztahuje dílo k dílu, které přispívá k obsahu hlavního díla."],"da":["Relaterer et værk til et værk, som føjer noget til et fremtrædende værks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Inhalt eines Hauptwerks ergänzt.,Setzt ein Werk in Beziehung zu einem Werk, das den Inhalt eines Hauptwerks ergänzt."],"el":["Συνδέει ένα έργο με ένα έργο, το οποίο αυξάνει το περιεχόμενο του κύριου έργου."],"en":["Relates a work to a work that adds to the content of a predominant work."],"es":["Relaciona una obra con una obra que añade al contenido de una obra predominante."],"et":["Seostab teose teosega, mis lisab midagi dominantse teose sisule."],"fi":["Liittää teoksen teokseen, joka täydentää pääteoksen sisältöä."],"fr":["Met une œuvre en relation avec une œuvre qui ajoute au contenu d’une œuvre prédominante."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy domináns mű tartalmát gyarapítja."],"it":["Correla un’opera a un’opera che aumenta il contenuto di un’opera predominante."],"lv":["Sasaista darbu ar darbu, kas pievienots pamatdarba saturam."],"nl":["Relateert een werk aan een werk dat toevoegt aan de content van een hoofdwerk."],"no":["Relaterer et verk til et verk som utvider innholdet av et mer fremtredende verk."],"tr":["Bir eseri, baskın bir eserin içeriğine katkıda bulunan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm têm vào nội dung của tác phẩm nổi trội."],"zh-Hans-CN":["将一种作品与增加到一种主要作品之内容中去的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مزيد بعمل","ca":"augmentat per una obra","cs":"rozšířeno o dílo","da":"beriget med værk","de":"Erweitert durch (Werk)","de":"Erweitert durch (Werk)","el":"επαυξημένο από (έργο)","en":"augmented by work","es":"aumentado por obra","et":"laiendatud teosega","fi":"laajennettu teoksella","fr":"augmenté par une œuvre","hu":"bővítő mű:","it":"ampliata da opera","lv":"darbs: papildinājums","nl":"aangevuld door werk","no":"utvidet av verk","tr":"eser ile artırılmış","vi":"được gia tăng bởi (tác phẩm)","zh-Hans-CN":"被作品附增"},"ToolkitDefinition":{"ar":"عمل يضيف إلى محتوى عمل سائد.","ca":"Obra que afegeix el contingut d’una obra predominant.","cs":"Dílo, které přispívá k obsahu hlavního díla.","da":"Værk, som føjer noget til et fremtrædende værks indhold.","de":"Ein Werk, das den Inhalt eines Hauptwerks ergänzt.","de":"Ein Werk, das den Inhalt eines Hauptwerks ergänzt.","el":"Ένα έργο το οποίο αυξάνει το περιεχόμενο του κύριου έργου.","en":"A work that adds to the content of a predominant work.","es":"Una obra que añade al contenido de una obra predominante.","et":"Teos, mis lisab midagi dominantse teose sisule.","fi":"Teos, joka täydentää pääteoksen sisältöä.","fr":"Œuvre qui ajoute au contenu d’une œuvre prédominante.","hu":"Egy mű, amely egy domináns mű tartalmát gyarapítja.","it":"Opera che amplia il contenuto di un’opera predominante.","lv":"Darbs, kas pievienots pamatdarba saturam.","nl":"Een werk dat toevoegt aan de content van een hoofdwerk.","no":"Et verk som utvider innholdet av et mer fremtredende verk.","tr":"Öncelikli bir eserin içeriğine katkıda bulunan eser.","vi":"Tác phẩm têm vào nội dung của tác phẩm nổi trội.","zh-Hans-CN":"增加到一种主要作品之内容中去的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10123", "lexicalAlias":"http://rdaregistry.info/Elements/w/appendixWork.en", "label":"has appendix work"},{"@id":"http://rdaregistry.info/Elements/w/P10158", "lexicalAlias":"http://rdaregistry.info/Elements/w/indexWork.en", "label":"has index work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10026", "lexicalAlias":"http://rdaregistry.info/Elements/w/cadenzaWork.en", "label":"has cadenza work"},{"@id":"http://rdaregistry.info/Elements/w/P10110", "lexicalAlias":"http://rdaregistry.info/Elements/w/catalogueWork.en", "label":"has catalogue work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10157", "lexicalAlias":"http://rdaregistry.info/Elements/w/findingAidWork.en", "label":"has finding aid work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10111", "lexicalAlias":"http://rdaregistry.info/Elements/w/concordanceWork.en", "label":"has concordance work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10092", "lexicalAlias":"http://rdaregistry.info/Elements/w/errataWork.en", "label":"has errata work"},{"@id":"http://rdaregistry.info/Elements/w/P10093", "lexicalAlias":"http://rdaregistry.info/Elements/w/illustrationsWork.en", "label":"has illustrations work"},{"@id":"http://rdaregistry.info/Elements/w/P10112", "lexicalAlias":"http://rdaregistry.info/Elements/w/addendaWork.en", "label":"has addenda work"},{"@id":"http://rdaregistry.info/Elements/w/P10172", "lexicalAlias":"http://rdaregistry.info/Elements/w/supplementWork.en", "label":"has supplement work"},{"@id":"http://rdaregistry.info/Elements/w/P10124", "lexicalAlias":"http://rdaregistry.info/Elements/w/guideWork.en", "label":"has guide work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/augmentedByWork.en", "label":"is augmented by work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/augmentedByWork.en", "label":"is augmented by work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10170","label":{"ar":"هو متبوع بعمل","ca":"és seguit d’una obra","cs":"je následováno dílem","da":"er efterfulgt af (værk)","de":"ist gefolgt von (Werk)","de":"ist gefolgt von (Werk)","el":"ακολουθείται από (έργο)","en":"is succeeded by work","es":"es sucedida por obra","et":"järgnev teos","fi":"myöhempi teos","fr":"est suivi d’une œuvre","hu":"folytatja a következő mű:","it":"è seguita da opera","lv":"darba vēlāki notikumi","nl":"is gevolgd door werk","no":"er avløst av verk","tr":"eser tarafından yerine getirilmiştir","vi":"được kế tiếp bởi (tác phẩm)","zh-Hans-CN":"被作品后继"},"definition":{"ar":["يربط عمل بعمل تكون تغطيته الزمنية بعد التغطية الخاصة بعمل آخر."],"ca":["Relaciona una obra amb una obra la cobertura cronològica de la qual és posterior a aquella d’una altra obra."],"cs":["Vztahuje dílo k dílu, jehož chronologické pokrytí následuje po chronologickém pokrytí jiného díla."],"da":["Relaterer et værk til et værk, der følger efter det forudgående værk, dvs. på et senere tidspunkt eller efter noget i en fortælling."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen zeitliches Geschehen nach dem eines anderen Werks liegt.,Setzt ein Werk in Beziehung zu einem Werk, dessen zeitliches Geschehen nach dem eines anderen Werks liegt."],"el":["Συνδέει ένα έργο με ένα έργο που έπεται, ακολουθεί δηλαδή χρονικά σε μια αφήγηση κ.λπ. ένα προηγούμενο έργο."],"en":["Relates a work to a work whose chronological coverage is after that of another work."],"es":["Relaciona una obra con una obra cuya cobertura cronológica es posterior a la de otra obra."],"et":["Seostab teose teosega, mille kronoloogiline ulatus on hilisem kui teisel teosel."],"fi":["Liittää teoksen teokseen, jolla on toista teosta myöhäisempi ajallinen kattavuus."],"fr":["Met une œuvre en relation avec une œuvre dont la couverture chronologique est postérieure à celle d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely kronológiai narratívában követ egy másik művet, azaz időben későbbi vagy azutáni."],"it":["Correla un’opera a un’opera la cui copertura cronologica è successiva a quella di un’altra opera."],"lv":["Sasaista darbu ar darbu, kas turpina (piemēram, ir vēlāks laika vai notikumu ziņā) par iepriekšējo darbu."],"nl":["Relateert een werk aan een werk waarvan het chronologisch bereik is na dat van een ander werk."],"no":["Relaterer et verk til et verk som følger kronologisk etter et annet verk."],"tr":["Bir eseri, kronolojik kapsamı başka bir eserden sonra olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm tiếp theo, nghĩa là, sau này theo thời gian hoặc sau theo câu chuyện kể, v.v... tác phẩm đi trước."],"zh-Hans-CN":["将一种作品与其时间覆盖面在另一种作品之后的一种作品关联起来。"]},"ToolkitLabel":{"ar":"متبوع بعمل","ca":"seguit d’una obra","cs":"následováno dílem","da":"efterfulgt af (værk)","de":"Gefolgt von (Werk)","de":"Gefolgt von (Werk)","el":"ακολουθείται από (έργο)","en":"succeeded by work","es":"sucedida por obra","et":"järgnev teos","fi":"myöhempi teos","fr":"suivi d’une œuvre","hu":"folytató mű:","it":"seguita da opera","lv":"darbs: vēlāki notikumi","nl":"gevolgd door werk","no":"avløst av verk","tr":"eser ile başarılı","vi":"được kế tiếp bởi (tác phẩm)","zh-Hans-CN":"被作品后继"},"ToolkitDefinition":{"ar":"عمل تكون تغطيته الزمنية بعد التغطية الخاصة بعمل آخر.","ca":"Obra la cobertura cronològica de la qual és posterior a aquella d’una altra obra.","cs":"Dílo, jehož chronologické pokrytí následuje po chronologickém pokrytí jiného díla.","da":"Værk, der følger efter det forudgående værk, dvs. på et senere tidspunkt eller efter noget i en fortælling.","de":"Ein Werk, dessen zeitliches Geschehen nach dem eines anderen Werks liegt.","de":"Ein Werk, dessen zeitliches Geschehen nach dem eines anderen Werks liegt.","el":"Ένα έργο που έπεται, ακολουθεί δηλαδή χρονικά σε μια αφήγηση κ.λπ. ένα προηγούμενο έργο.","en":"A work whose chronological coverage is after that of another work.","es":"Una obra cuya cobertura cronológica es posterior a la de otra obra.","et":"Teos, mille kronoloogiline ulatus on hilisem kui teisel teosel.","fi":"Teos, jolla on toista teosta myöhäisempi ajallinen kattavuus.","fr":"Œuvre dont la couverture chronologique est postérieure à celle d’une autre œuvre.","hu":"Egy mű, amely kronológiai narratívában követ egy másik művet, azaz időben későbbi vagy azutáni.","it":"Opera la cui copertura cronologica è successiva a quella di un’altra opera.","lv":"Darbs, kas turpina (piemēram, ir vēlāks laika vai notikumu ziņā) par iepriekšējo darbu.","nl":"Een werk waarvan het chronologisch bereik is na dat van een ander werk.","no":"Et verk som følger kronologisk etter et annet verk.","tr":"Kronolojik kapsamı başka bir eserin kronololik kapsamından sonra olan eser.","vi":"Tác phẩm tiếp theo, nghĩa là, sau này theo thời gian hoặc sau theo câu chuyện kể, v.v... Tác phẩm đi trước.","zh-Hans-CN":"其时间覆盖面在另一种作品之后的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
