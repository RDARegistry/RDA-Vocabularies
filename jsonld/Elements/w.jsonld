                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/organizerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10297", "lexicalAlias":"http://rdaregistry.info/Elements/w/organizerAgent.en", "label":"has organizer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10457", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/organizerPerson.en", "label":"has organizer person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10457", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/organizerPerson.en", "label":"has organizer person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10212","label":{"ar":"هو مدمج لتشكيل عمل","ca":"és fusionat per formar una obra","cs":"je sloučeno pro vznik díla","da":"er sammenlagt til værk","de":"ist vereinigt, um ... zu bilden (Werk)","de":"ist vereinigt, um ... zu bilden (Werk)","el":"είναι συγχωνευμένο για να σχηματίσει (έργο)","en":"is merged to form work","es":"se fusiona para formar una obra","et":"ühendatud teoseks","fi":"yhdistynyt teokseksi","fr":"est fusionné pour former une œuvre","hu":"beleolvadt a következő műbe:","it":"è fusa per formare opera","lv":"ir sapludināts darbā","nl":"is samengevoegd om werk te vormen","no":"er slått sammen til verk","tr":"eser olarak birleştirilmiştir","vi":"được hợp lại để tạo thành (tác phẩm)","zh-Hans-CN":"被合并而形成作品"},"definition":{"ar":["يربط عمل بعمل مكون من تجميع لعملين أو أكثر معًا."],"ca":["Relaciona una obra amb una obra que està formada per la reunió de dues o més obres."],"cs":["Vztahuje dílo k dílu, které vzniklo spojením dvou nebo více děl."],"da":["Relaterer et værk til et værk, som er dannet ved at lægge to eller flere værker sammen."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch das Zusammenführen von zwei oder mehreren Werken gebildet wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch das Zusammenführen von zwei oder mehreren Werken gebildet wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο σχηματίζεται από τη συνένωση δύο ή περισσότερων έργων."],"en":["Relates a work to a work that is formed from the coming together of two or more works."],"es":["Relaciona una obra con una obra que se forma a partir de la unión de dos o más obras."],"et":["Seostab teose teosega, mis on moodustatud kahe või enama teose kokkupaneku teel."],"fi":["Liittää teoksen teokseen, joka on muodostunut kahden tai useamman teoksen yhdistymisestä."],"fr":["Met une œuvre en relation avec une œuvre qui est formée par la combinaison de deux ou plusieurs œuvres."],"hu":["Hozzákapcsol egy művet egy műhöz, amely két vagy több mű egyesüléséből jött létre."],"it":["Correla un’opera a un’opera formata dalla fusione di due o più opere."],"lv":["Sasaista darbu ar darbu, kas izveidots no diviem vai vairākiem darbiem."],"nl":["Relateert een werk aan een werk dat is gevormd door het samenkomen van twee of meer werken."],"no":["Relaterer et verk til et verk skapt ved å kombinere to eller flere verk."],"tr":["Bir eseri, iki veya daha fazla eserin bir araya gelmesiyle oluşan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được hình thành từ ghép lại hai hoặc nhiều hơn tác phẩm."],"zh-Hans-CN":["将一种作品与两种或多种作品一起形成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مدمج لتشكيل عمل","ca":"fusionat per formar una obra","cs":"sloučením vzniklo dílo","da":"sammenlagt til værk","de":"Vereinigt, um ... zu bilden (Werk)","de":"Vereinigt, um ... zu bilden (Werk)","el":"συγχωνευμένο για να σχηματίσει (έργο)","en":"merged to form work","es":"fusionado para formar una obra","et":"ühendatud teoseks","fi":"yhdistynyt teokseksi","fr":"fusionné pour former une œuvre","hu":"összeolvasztott mű","it":"fusa per formare opera","lv":"sapludināts darbā","nl":"gefuseerd om werk te vormen","no":"slått sammen til verk","tr":"Birden fazla çalışmanın birleştirilmesi","vi":"được hợp lại để tạo thành (tác phẩm)","zh-Hans-CN":"被合并而形成作品"},"ToolkitDefinition":{"ar":"عمل مكون من تجميع لعملين أو أكثر معًا.","ca":"Obra que està formada per la reunió de dues o més obres.","cs":"Dílo, které vzniklo spojením dvou nebo více děl.","da":"Værk, som er dannet ved at lægge to eller flere værker sammen.","de":"Ein Werk, das durch das Zusammenführen von zwei oder mehreren Werken gebildet wird.","de":"Ein Werk, das durch das Zusammenführen von zwei oder mehreren Werken gebildet wird.","el":"Ένα έργο το οποίο σχηματίζεται από τη συνένωση δύο ή περισσότερων έργων.","en":"A work that is formed from the coming together of two or more works.","es":"Una obra que se forma a partir de la unión de dos o más obras.","et":"Teos, mis on moodustatud kahe või enama teose kokkupaneku teel.","fi":"Teos, joka on muodostunut kahden tai useamman teoksen yhdistymisestä.","fr":"Œuvre qui est formée par la combinaison de deux ou plusieurs œuvres.","hu":"Egy mű, amely két vagy több mű egyesüléséből jött létre.","it":"Opera formata dalla fusione di due o più opere.","lv":"Darbs, kas izveidots no diviem vai vairākiem darbiem.","nl":"Een werk dat is gevormd door het samenkomen van twee of meer werken.","no":"Et verk skapt ved å kombinere to eller flere verk.","tr":"İki veya daha fazla çalışmanın bir araya gelmesiyle oluşan bir çalışma.","vi":"Tác phẩm được hình thành từ ghép lại hai hoặc nhiều hơn tác phẩm.","zh-Hans-CN":"两种或多种作品一起形成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
