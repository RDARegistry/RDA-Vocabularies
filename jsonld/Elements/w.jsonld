                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en", "label":"has music work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/radioProgramMusicWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10243", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/radioProgramMusicWork.en", "label":"has radio program music work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10243", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/radioProgramMusicWork.en", "label":"has radio program music work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10074","label":{"ar":"له وكيل منتج إذاعي","ca":"té com a agent productor radiofònic","cs":"má rozhlasového producenta (agenta)","da":"har agent, som er radioproducer","de":"hat Hörfunkproduzentin/Hörfunkproduzenten (Akteur)","de":"hat Hörfunkproduzentin/Hörfunkproduzenten (Akteur)","el":"έχει ραδιοφωνικό παραγωγό","en":"has radio producer agent","es":"tiene agente productor de radio","et":"raadioprodutsent (tegija)","fi":"radiotuottaja (toimija)","fr":"a pour agent producteur de radio","hu":"rádiós producer ágense a következő:","it":"ha come produttore radiofonico agente","lv":"radio raidījuma producents (aģents)","nl":"heeft radioproducent-actor","no":"har radioprodusent (agent)","tr":"radyo yapımcısı temsilcisi ile ilişkilidir","vi":"có nhà sản xuất truyền thanh","zh-Hans-CN":"有广播制作者行为者"},"definition":{"ar":["يربط بين عمل ووكيل عبارة عن منتج مسئول عن معظم جوانب العمل في برنامج إذاعي."],"ca":["Relaciona una obra amb un agent que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic."],"cs":["Vztahuje dílo k agentovi, který je producentem, odpovědným za většinu obchodních aspektů rozhlasového programu."],"da":["Relaterer et værk til en agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram."],"de":["Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές ενός ραδιοφωνικού προγράμματος."],"en":["Relates a work to an agent who is a producer who is responsible for most of the business aspects of a radio program."],"es":["Relaciona una obra con un agente que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de un programa de radio."],"et":["Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide eest raadiosaate tootmisel."],"fi":["Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta."],"fr":["Met une œuvre en relation avec un agent producteur qui est responsable de la majeure partie des aspects commerciaux d’une émission de radio."],"hu":["Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy rádióműsor üzleti vonatkozásainak a zöméért."],"it":["Correla un'opera all'agente produttore responsabile della maggior parte degli aspetti commerciali di un programma radiofonico."],"lv":["Sasaista darbu ar aģentu - producents, kurš ir atbildīgs par radio raidījuma darbības/biznesa aspektiem."],"nl":["Relateert een werk aan een actor die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een radioprogramma."],"no":["Relaterer et verk til en agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et radioprogram."],"tr":["Bir eseri, bir radyo programının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với nhà sản xuất có trách nhiệm về phần lớn khía cạnh kinh doanh của chương trình thanh"],"zh-Hans-CN":["将一种作品与作为制作者并负责广播节目的大部分商业运作的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل منتح إذاعي","ca":"agent productor radiofònic","cs":"rozhlasový producent (agent)","da":"agent, som er radioproducer","de":"Hörfunkproduzentin/Hörfunkproduzent (Akteur)","de":"Hörfunkproduzentin/Hörfunkproduzent (Akteur)","el":"ραδιοφωνικός παραγωγός","en":"radio producer agent","es":"agente productor de radio","et":"raadioprodutsent (tegija)","fi":"radiotuottaja (toimija)","fr":"agent producteur de radio","hu":"rádióproducer ágens:","it":"produttore radiofonico agente","lv":"radio raidījuma producents (aģents)","nl":"radioproducent-actor","no":"radioprodusent (agent)","tr":"radyo yapımcısı temsilci","vi":"nhà sản xuất truyền thanh","zh-Hans-CN":"广播制作者行为者"},"ToolkitDefinition":{"ar":"وكيل عبارة عن منتج مسئول عن معظم جوانب العمل في برنامج إذاعي.","ca":"Agent que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic.","cs":"Agent, který je producentem, odpovědným za většinu obchodních aspektů rozhlasového programu.","da":"Agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram.","de":"Eine Produzentin/Ein Produzent (Akteur), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.","de":"Eine Produzentin/Ein Produzent (Akteur), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.","el":"Ένας παραγωγός υπεύθυνος για τις περισσότερες επιχειρηματικές πτυχές ενός ραδιοφωνικού προγράμματος.","en":"An agent who is a producer who is responsible for most of the business aspects of a radio program.","es":"Un agente que es un productor que es res