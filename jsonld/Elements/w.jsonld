                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10287", "lexicalAlias":"http://rdaregistry.info/Elements/w/commissioningAgent.en", "label":"has commissioning agent"},{"@id":"http://rdaregistry.info/Elements/w/P10312", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedPersonOfWork.en", "label":"has related person of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/commissioningPerson.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10439", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/commissioningPerson.en", "label":"has commissioning person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10439", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/commissioningPerson.en", "label":"has commissioning person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10055","label":{"ar":"له وكيل مجمع","ca":"té com a agent compilador","cs":"má sestavovatele (agenta)","da":"har agent, som er kompilator","de":"hat Zusammenstellende/Zusammenstellenden (Akteur)","de":"hat Zusammenstellende/Zusammenstellenden (Akteur)","el":"έχει συμπιλητή","en":"has compiler agent","es":"tiene agente compilador","et":"koostaja (tegija)","fi":"kokoaja (toimija)","fr":"a pour agent compilateur","hu":"összeállító ágense a következő:","it":"ha come compilatore agente","lv":"sastādītājs (aģents)","nl":"heeft samensteller-actor","no":"har utarbeider (agent)","tr":"derleyen temsilci ile ilişkilidir","vi":"có người biên soạn","zh-Hans-CN":"有编纂者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ."],"ca":["Relaciona una obra amb un agent que és responsable de la creació d’un conjunt de descripció de metadades."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za vytvoření sady popisných metadat."],"da":["Relaterer et værk til en agent, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines textlichen Werks verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός νέου έργου, όπως μιας βιβλιογραφίας ή ενός οδηγού μέσω της επιλογής, της οργάνωσης, της συλλογής και της επιμέλειας δεδομένων, πληροφοριών κ.λπ."],"en":["Relates a work to an agent who is responsible for creating a metadata description set."],"es":["Relaciona una obra con un agente que es responsable de crear un conjunto de descripción de metadatos."],"et":["Seostab teose tegijaga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms."],"fi":["Liittää teoksen toimijaan, joka on vastuussa metatietokokonaisuuden luomisesta."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la création d’un ensemble de métadonnées descriptives."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy metaadatleírás-halmaz elkészítéséért."],"it":["Correla un'opera a un agente responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite la la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset."],"no":["Relaterer et verk til en agent som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc."],"tr":["Bir eseri, üstveri seti oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm mới như là thư mục hoặc danh bạ bằng cách lựa chọn, sắp xếp, tập hợp, và biên tập dữ liệu, thông tin, v.v..."],"zh-Hans-CN":["将一种作品与负责创建一个元数据描述集的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جامع","ca":"agent compilador","cs":"sestavovatel (agent)","da":"agent, som er kompilator","de":"Zusammenstellende/Zusammenstellender (Akteur)","de":"Zusammenstellende/Zusammenstellender (Akteur)","el":"συμπιλητής","en":"compiler agent","es":"agente compilador","et":"koostaja (tegija)","fi":"kokoaja (toimija)","fr":"agent compilateur","hu":"összeállító ágens:","it":"compilatore agente","lv":"sastādītājs (aģents)","nl":"samensteller-actor","no":"utarbeider (agent)","tr":"derleyici temsilci","vi":"người biên soạn","zh-Hans-CN":"编纂者行为者"},"ToolkitDefinition":{"ar":"وكيل مسؤول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.","ca":"Un agent que és responsable de la creació d’un conjunt de descripció de metadades.","cs":"Agent, který je odpovědný za vytvoření sady popisných metadat.","da":"Agent, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.","de":"Ein Akteur, der durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.","de":"Ein Akteur, der für die Schaffung eines Werks verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τη δημιουργία ενός νέου έργου, όπως μιας βιβλιογραφίας ή ενός οδηγού μέσω της επιλογής, της οργάνωσης, της συλλογής και της επιμέλειας δεδομένων, πληροφοριών κ.λπ.","en":"An agent who is responsible for creating a metadata description set.","es":"Un agente que es responsable de crear un conjunto de descripción de metadatos.","et":"Tegija, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.","fi":"Toimija, joka on vastuussa metatietokokonaisuuden luomisesta.","fr":"Agent qui est responsable de la création d’un ensemble de métadonnées descriptives.","hu":"Egy ágens, amely felelős egy metaadatleírás-halmaz elkészítéséért.","it":"Agente responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.","lv":"Aģents, kas ir atbildīgs par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.","nl":"Een actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.","no":"En agent som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.","tr":"Bir üst veri tanımlama seti oluşturulmasından sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm tạo lập tác phẩm mới như là thư mục hoặc danh bạ bằng cách lựa chọn, sắp xếp, tập hợp, và biên tập dữ liệu, thông tin, v.v...","zh-Hans-CN":"负责创建一个元数据描述集的一个行为者"},"note":{"ar":["تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن الأعمال أو أجزاء من الأعمال وتجميعها."],"ca":["Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític."],"cs":["Sada popisných metadat zahrnuje bibliografii děl, vyjádření nebo manifestací, adresář agentů a míst a analytickou vyhledávací pomůcku."],"da":["Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet."],"de":["Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.,Ein Metadaten-Beschreibungssatz umfasst eine Bibliografie von Werken, Expressionen oder Manifestationen, ein Verzeichnis von Akteuren und Geografika sowie analytische Findmittel."],"el":["Δεν περιλαμβάνεται η αναθεώρηση ή η αποσαφήνιση του περιεχομένου ή η επιλογή και η συγκέντρωση έργων ή μερών ενός έργου από έναν ή περισσότερους δημιουργούς."],"en":["A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid."],"es":["Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares y una ayuda analítica para hallazgos."],"et":["Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist."],"fi":["Metatietokonaisuuteen kuuluvat teosten, ekspressioiden tai manifestaatioiden bibliografia, toimija- ja paikkahakemisto sekä analyyttinen luettelo."],"fr":["Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique."],"hu":["A metaadatleírási halmaz tartalmazza a művek, kifejezési formák vagy megjelenési formák bibliográfiáját, az ágensek és helyek nyilvántartását, valamint az analitikus keresési segédletet."],"it":["Sono esclusi la revisione o il chiarimento del contenuto di una espressione dell’opera e la selezione e la raccolta di espressioni di opere o di parti di opere"],"lv":["Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu."],"nl":["Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel."],"no":["Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert."],"tr":["Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir."],"vi":["Sửa lại hoặc làm rõ nội dung, hoặc lưa chọn và kết hợp lại các tác phẩm hoặc phần của tác phẩm, bởi một hoặc nhiều hơn người sáng tạo, được bao gồm"],"zh-Hans-CN":["元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。"]},"altLabel":{"ar":["جامع"],"ca":["compilador"],"cs":["sestavovatel"],"da":["kompilator"],"de":["Zusammenstellender,Zusammenstellender"],"en":["compiler"],"es":["compilador"],"et":["koostaja"],"fi":["kokoaja"],"fr":["compilateur"],"hu":["összeállító:"],"it":["compilatore"],"nl":["samensteller"],"no":["utarbeider"],"tr":["derleyici"],"zh-Hans-CN":["编纂者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/compilerAgent.en","See Also":[{"@id":"http://rdaregistry.info/Elements/e/P20048", "lexicalAlias":"http://rdaregistry.info/Elements/e/editor.en", "label":"has editor (Deprecated)"}],"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10393", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorAgent.en", "label":"has aggregator agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10491", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerCollectiveAgent.en", "label":"has compiler collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10444", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerPerson.en", "label":"has compiler person"},{"@id":"http://rdaregistry.info/Elements/w/P10634", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectionRegistrarAgent.en", "label":"has collection registrar agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10055", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/compilerAgent.en", "label":"has compiler agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10055", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/compilerAgent.en", "label":"has compiler agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10491","label":{"ar":"له وكيل جماعي جامع","ca":"té com a agent col·lectiu compilador","cs":"má sestavovatele (kolektivního agenta)","da":"har kollektiv agent, som er kompilator","de":"hat Zusammenstellende/Zusammenstellenden (Gemeinschaftlicher Akteur)","de":"hat Zusammenstellende/Zusammenstellenden (Gemeinschaftlicher Akteur)","en":"has compiler collective agent","es":"tiene agente colectivo compilador","et":"koostaja (kollektiiv)","fi":"kokoaja (yhteistoimija)","fr":"a pour agent collectif compilateur","hu":"összeállító kollektív ágense a következő:","it":"ha come compilatore agente collettivo","lv":"sastādītājs (grupa)","nl":"heeft samensteller-collectieve actor","no":"har utarbeider (kollektiv agent)","tr":"derleyen kolektif temsilci ile ilişkilidir","zh-Hans-CN":"有编纂者集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ."],"ca":["Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un conjunt de descripció de metadades."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je odpovědný za vytvoření sady popisu metadat."],"da":["Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines textlichen Werks verantwortlich ist."],"en":["Relates a work to a collective agent who is responsible for creating a metadata description set."],"es":["Relaciona una obra con un agente colectivo que es responsable de crear un conjunto de descripción de metadatos."],"et":["Seostab teose kollektiiviga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms."],"fi":["Liittää teoksen yhteistoimijaan, joka on vastuussa metatietokonaisuuden luomisesta."],"fr":["Met une œuvre en relation avec un agent collectif qui est responsable de la création d’un ensemble de métadonnées descriptives."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy metaadatleírás-halmaz elkészítéséért."],"it":["Correla un'opera a un agente collettivo responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite la la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc."],"lv":["Sasaista darbu ar grupu, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml."],"nl":["Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset."],"no":["Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc."],"tr":["Bir eseri, bir metadata setini oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创建一个元数据描述集的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي جامع","ca":"agent col·lectiu compilador","cs":"sestavovatel (kolektivní agent)","da":"kollektiv agent, som er kompilator","de":"Zusammenstellende/Zusammenstellender (Gemeinschaftlicher Akteur)","de":"Zusammenstellende/Zusammenstellender (Gemeinschaftlicher Akteur)","en":"compiler collective agent","es":"agente colectivo compilador","et":"koostaja (kollektiiv)","fi":"kokoaja (yhteistoimija)","fr":"agent collectif compilateur","hu":"összeállító kollektív ágens:","it":"compilatore agente collettivo","lv":"sastādītājs (grupa)","nl":"samensteller-collectieve actor","no":"utarbeider (kollektiv agent)","tr":"derleyici kolektif temsilci","zh-Hans-CN":"编纂者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.","ca":"Agent col·lectiu que és responsable de la creació d’un conjunt de descripció de metadades.","cs":"Kolektivní agent, který je odpovědný za vytvoření sady popisu metadat.","da":"Kollektiv agent, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.","de":"Ein gemeinschaftlicher Akteur, der durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.","de":"Ein gemeinschaftlicher Akteur, der für die Schaffung eines Werks verantwortlich ist.","en":"A collective agent who is responsible for creating a metadata description set.","es":"Un agente colectivo que es responsable de crear un conjunto de descripción de metadatos.","et":"Kollektiiv, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.","fi":"Yhteistoimija, joka on vastuussa metatietosanaston luomisesta.","fr":"Agent collectif qui est responsable de la création d’un ensemble de métadonnées descriptives.","hu":"Egy kollektív ágens, felelős egy metaadatleírás-halmaz elkészítéséért.","it":"Agente collettivo responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.","lv":"Grupa, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.","nl":"Een collectieve actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.","no":"En kollektiv agent som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.","tr":"Metadata tanımlama seti oluşturma sorumluluğuna sahip kolektif temsilci","zh-Hans-CN":"负责创建一个元数据描述集的一个集体行为者"},"note":{"ar":["تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن الأعمال أو أجزاء من الأعمال وتجميعها."],"ca":["Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític."],"cs":["Sada popisů metadat zahrnuje bibliografii děl, vyjádření nebo manifestací, adresář činitelů a míst a analytickou vyhledávací pomůcku."],"da":["Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet."],"de":["Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.,Ein Metadaten-Beschreibungssatz umfasst eine Bibliografie von Werken, Expressionen oder Manifestationen, ein Verzeichnis von Akteuren und Geografika sowie analytische Findmittel."],"en":["A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid."],"es":["Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares, y una ayuda analítica para la búsqueda."],"et":["Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist."],"fi":["Metatietokonaisuuteen kuuluvat teosten, ekspressioiden tai manifestaatioiden bibliografia, toimija- ja paikkahakemisto sekä analyyttinen luettelo."],"fr":["Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique."],"hu":["A metaadatleírási halmaz tartalmazza a művek, kifejezési formák vagy megjelenési formák bibliográfiáját, az ágensek és helyek nyilvántartását, valamint az analitikus keresési segédletet."],"it":["Sono esclusi la revisione o il chiarimento del contenuto di un'espressione di un'opera, e la selezione e raccolta di espressioni di opere o parti di opere."],"lv":["Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu."],"nl":["Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel."],"no":["Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert."],"tr":["Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir."],"zh-Hans-CN":["元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/compilerCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10055", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerAgent.en", "label":"has compiler agent"},{"@id":"http://rdaregistry.info/Elements/w/P10495", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorCollectiveAgent.en", "label":"has aggregator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10538", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerCorporateBody.en", "label":"has compiler corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10585", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerFamily.en", "label":"has compiler family"},{"@id":"http://rdaregistry.info/Elements/w/P10635", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectionRegistrarCollectiveAgent.en", "label":"has collection registrar collective agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10491", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/compilerCollectiveAgent.en", "label":"has compiler collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10491", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/compilerCollectiveAgent.en", "label":"has compiler collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10538","label":{"ar":"له هيئة جامعة","ca":"té com a entitat corporativa compiladora","cs":"má sestavovatele (korporaci)","da":"har korporation, som er kompilator","de":"hat Zusammenstellende/Zusammenstellenden (Körperschaft)","de":"hat Zusammenstellende/Zusammenstellenden (Körperschaft)","en":"has compiler corporate body","es":"tiene cuerpo corporativo compilador","et":"koostaja (asutus)","fi":"kokoaja (yhteisö)","fr":"a pour collectivité compilatrice","hu":"összeállító testülete a következő:","it":"ha come compilatore ente","lv":"sastādītājs (institūcija)","nl":"heeft samensteller-corporatie","no":"har utarbeider (korporasjon)","tr":"derleyici tüzel kişi ile ilişkilidir","zh-Hans-CN":"有编纂者团体"},"definition":{"ar":["يربط بين عمل وهيئة تكون مسئولة عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un conjunt de descripció de metadades."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za vytvoření sady popisu metadat."],"da":["Relaterer et værk til en korporation, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines textlichen Werks verantwortlich ist."],"en":["Relates a work to a corporate body who is responsible for creating a metadata description set."],"es":["Relaciona una obra con un cuerpo corporativo que es responsable de crear un conjunto de descripción de metadatos."],"et":["Seostab teose asutusega, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa metatietokokonaisuuden luomisesta."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la création d’un ensemble de métadonnées descriptives."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy metaadatleírás-halmaz elkészítéséért."],"it":["Correla un'opera a un ente responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc."],"tr":["Bir eseri, üstveri seti oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创建一个元数据描述集的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة جامعة","ca":"entitat corporativa compiladora","cs":"sestavovatel (korporace)","da":"korporation, som er kompilator","de":"Zusammenstellende/Zusammenstellender (Körperschaft)","de":"Zusammenstellende/Zusammenstellender (Körperschaft)","en":"compiler corporate body","es":"cuerpo corporativo compilador","et":"koostaja (asutus)","fi":"kokoaja (yhteisö)","fr":"collectivité compilatrice","hu":"összeállító testület:","it":"compilatore ente","lv":"sastādītājs (institūcija)","nl":"samensteller-corporatie","no":"utarbeider (korporasjon)","tr":"derleyici tüzel kişi","zh-Hans-CN":"编纂者团体"},"ToolkitDefinition":{"ar":"هيئة تكون مسئولة عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.","ca":"Entitat corporativa que és responsable de la creació d’un conjunt de descripció de metadades.","cs":"Korporace, která je odpovědná za vytvoření sady popisu metadat.","da":"Korporation, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.","de":"Eine Körperschaft, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.","de":"Eine Körperschaft, die für die Schaffung eines Werks verantwortlich ist.","en":"A corporate body who is responsible for creating a metadata description set.","es":"Un cuerpo corporativo que es responsable de crear un conjunto de descripción de metadatos.","et":"Asutus, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.","fi":"Yhteisö, joka on vastuussa metatietokokonaisuuden luomisesta.","fr":"Collectivité qui est responsable de la création d’un ensemble de métadonnées descriptives.","hu":"Egy testület, amely felelős egy metaadatleírás-halmaz elkészítéséért.","it":"Ente responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.","lv":"Institūcija, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.","nl":"Een corporatie die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.","no":"En korporasjon som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.","tr":"Bir meta veri açıklama seti oluşturmaktan sorumlu olan bir tüzel kişi.","zh-Hans-CN":"负责创建一个元数据描述集的一个团体"},"note":{"ar":["تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن أعمال أو أجزاء من أعمال وتجميعها."],"ca":["Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític."],"cs":["Sada popisných metadat zahrnuje bibliografii děl, vyjádření nebo manifestací, adresář činitelů a míst a analytickou vyhledávací pomůcku."],"da":["Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet."],"de":["Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.,Ein Metadaten-Beschreibungssatz umfasst eine Bibliografie von Werken, Expressionen oder Manifestationen, ein Verzeichnis von Akteuren und Geografika sowie analytische Findmittel."],"en":["A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid."],"es":["Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares, y una ayuda analítica para la búsqueda."],"et":["Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist."],"fi":["Metatietokonaisuuteen kuuluvat teosten, ekspressioiden tai manifestaatioiden bibliografia, toimija- ja paikkahakemisto sekä analyyttinen luettelo."],"fr":["Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique."],"hu":["A metaadatleírási halmaz tartalmazza a művek, kifejezési formák vagy megjelenési formák bibliográfiáját, az ágensek és helyek nyilvántartását, valamint az analitikus keresési segédletet."],"it":["Sono esclusi la revisione o il chiarimento del contenuto di un'espressione di un'opera, e la selezione e raccolta di espressioni di opere o parti di opere."],"lv":["Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu."],"nl":["Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel."],"no":["Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert."],"tr":["Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir."],"zh-Hans-CN":["元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/compilerCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10491", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerCollectiveAgent.en", "label":"has compiler collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10542", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorCorporateBody.en", "label":"has aggregator corporate body"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10636", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectionRegistrarCorporateBody.en", "label":"has collection registrar corporate body"},{"@id":"http://rdaregistry.info/Elements/w/object/P10538", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/compilerCorporateBody.en", "label":"has compiler corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10538", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/compilerCorporateBody.en", "label":"has compiler corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10585","label":{"ar":"له عائلة جامعة","ca":"té com a família compiladora","cs":"má sestavovatele (rodinu)","da":"har familie, som er kompilator","de":"hat Zusammenstellende/Zusammenstellenden (Familie)","de":"hat Zusammenstellende/Zusammenstellenden (Familie)","en":"has compiler family","es":"tiene familia compiladora","et":"koostaja (perekond)","fi":"kokoaja (suku)","fr":"a pour famille compilatrice","hu":"összeállító családja a következő:","it":"ha come compilatore famiglia","lv":"sastādītājs (dzimta/ģimene)","nl":"heeft samensteller-familie","no":"har utarbeider (familie)","tr":"derleyen aile ile ilişkilidir","zh-Hans-CN":"有编纂者家族"},"definition":{"ar":["يربط بين عمل وعائلة مسئولة عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ."],"ca":["Relaciona una obra amb una família que és responsable de la creació d’un conjunt de descripció de metadades."],"cs":["Vztahuje dílo k rodině, která je odpovědná za vytvoření sady popisu metadat."],"da":["Relaterer et værk til en familie, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines textlichen Werks verantwortlich ist."],"en":["Relates a work to a family who is responsible for creating a metadata description set."],"es":["Relaciona una obra con una familia que es responsable de crear un conjunto de descripción de metadatos."],"et":["Seostab teose perekonnaga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms."],"fi":["Liittää teoksen sukuun, joka on vastuussa metatietokokonaisuuden luomisesta."],"fr":["Met une œuvre en relation avec une famille qui est responsable de la création d’un ensemble de métadonnées descriptives."],"hu":["Hozzákapcsol egy művet egy családhoz, amely felelős egy metaadatleírás-halmaz elkészítéséért."],"it":["Correla un'opera alla famiglia responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml."],"nl":["Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset."],"no":["Relaterer et verk til en familie som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc."],"tr":["Bir eseri, bir üstveri seti oluşturmaktan sorumlu olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创建一个元数据描述集的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة جامعة","ca":"família compiladora","cs":"sestavovatel (rodina)","da":"familie, som er kompilator","de":"Zusammenstellende/Zusammenstellender (Familie)","de":"Zusammenstellende/Zusammenstellender (Familie)","en":"compiler family","es":"familia compiladora","et":"koostaja (perekond)","fi":"kokoaja (suku)","fr":"famille compilatrice","hu":"összeállító család:","it":"compilatore famiglia","lv":"sastādītājs (dzimta/ģimene)","nl":"samensteller-familie","no":"utarbeider (familie)","tr":"derleyici aile","zh-Hans-CN":"编纂者家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.","ca":"Família que és responsable de la creació d’un conjunt de descripció de metadades.","cs":"Rodina, která je odpovědná za vytvoření sady popisu metadat.","da":"Familie, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.","de":"Eine Familie, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.","de":"Eine Familie, die für die Schaffung eines Werks verantwortlich ist.","en":"A family who is responsible for creating a metadata description set.","es":"Una familia que es responsable de crear un conjunto de descripción de metadatos.","et":"Perekond, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.","fi":"Suku, joka on vastuussa metatietokokonaisuuden luomisesta.","fr":"Famille qui est responsable de la création d’un ensemble de métadonnées descriptives.","hu":"Egy család, amely felelős egy metaadatleírás-halmaz elkészítéséért.","it":"Famiglia responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.","lv":"Dzimta/ģimene, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.","nl":"Een familie die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.","no":"En familie som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.","tr":"Bir üstveri açıklama seti oluşturmaktan sorumlu bir aile.","zh-Hans-CN":"负责创建一个元数据描述集的一个家族"},"note":{"ar":["تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن أعمال أو أجزاء من أعمال وتجميعها."],"ca":["Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític."],"cs":["Sada popisných metadat zahrnuje bibliografii děl, vyjádření nebo manifestací, adresář činitelů a míst a analytickou vyhledávací pomůcku."],"da":["Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet."],"de":["Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.,Ein Metadaten-Beschreibungssatz umfasst eine Bibliografie von Werken, Expressionen oder Manifestationen, ein Verzeichnis von Akteuren und Geografika sowie analytische Findmittel."],"en":["A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid."],"es":["Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares y una ayuda analítica para hallazgos."],"et":["Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist."],"fi":["Metatietokonaisuuteen kuuluvat teosten, ekspressioiden tai manifestaatioiden bibliografia, toimija- ja paikkahakemisto sekä analyyttinen luettelo."],"fr":["Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique."],"hu":["A metaadatleírási halmaz tartalmazza a művek, kifejezési formák vagy megjelenési formák bibliográfiáját, az ágensek és helyek nyilvántartását, valamint az analitikus keresési segédletet."],"it":["Sono esclusi la revisione o il chiarimento del contenuto di un'espressione di un'opera, e la selezione e raccolta di espressioni di opere o parti di opere."],"lv":["Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu."],"nl":["Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel."],"no":["Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert."],"tr":["Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir."],"zh-Hans-CN":["元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/compilerFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10491", "lexicalAlias":"http://rdaregistry.info/Elements/w/compilerCollectiveAgent.en", "label":"has compiler collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10589", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorFamily.en", "label":"has aggregator family"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10637", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectionRegistrarFamily.en", "label":"has collection registrar family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10585", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/compilerFamily.en", "label":"has compiler family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10585", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/compilerFamily.en", "label":"has compiler family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10444","label":{"ar":"له شخص جامع","ca":"té com a persona compiladora","cs":"má sestavovatele (osobu)","da":"har person, som er kompilator","de":"hat Zusammenstellende/Zusammenstellenden (Person)","de":"hat Zusammenstellende/Zusammenstellenden (Person)","en":"has compiler person","es":"tiene persona compiladora","et":"koostaja (isik)","fi":"kokoaja (henkilö)","fr":"a pour personne compilatrice","hu":"összeállító személye a következő:","it":"ha come compilatore persona","lv":"sastādītājs (persona)","nl":"heeft samensteller-persoon","no":"har utarbeider (person)","tr":"derleyen kişi ile ilişkilidir","zh-Hans-CN":"有编纂者个人"},"definition":{"ar":["يربط بين عمل وشخص مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ."],"ca":["Relaciona una obra amb una persona que és responsable de la creació d’un conjunt de descripció de metadades."],"cs":["Vztahuje dílo k osobě, která je odpovědná za vytvoření sady popisu metadat."],"da":["Relaterer et værk til en person, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc."],"de":["Setzt ein Werk in Beziehung zu einer Person, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines textlichen Werks verantwortlich ist."],"en":["Relates a work to a person who is responsible for creating a metadata description set."],"es":["Relaciona una obra con una persona que es responsable de crear un conjunto de descripción de metadatos."],"et":["Seostab teose isikuga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms."],"fi":["Liittää teoksen henkilöön, joka on vastuussa metatietokonaisuuden luomisesta."],"fr":["Met une œuvre en relation avec une personne qui est responsable de la création d’un ensemble de métadonnées descriptives."],"hu":["Hozzákapcsol egy művet egy személyhez, aki felelős egy metaadatleírás-halmaz elkészítéséért."],"it":["Correla un'opera alla persona responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite selezione, organizzazione, aggregazione e cura di dati, informazioni, etc."],"lv":["Sasaista darbu ar personu, kura ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml."],"nl":["Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset."],"no":["Relaterer et verk til en person som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc."],"tr":["Bir eseri, üstveri seti oluşturmaktan sorumlu bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责创建一个元数据描述集的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص جامع","ca":"persona compiladora","cs":"sestavovatel (osoba)","da":"person, som er kompilator","de":"Zusammenstellende/Zusammenstellender (Person)","de":"Zusammenstellende/Zusammenstellender (Person)","en":"compiler person","es":"persona compiladora","et":"koostaja (isik)","fi":"kokoaja (henkilö)","fr":"personne compilatrice","hu":"összeállító személy:","it":"compilatore persona","lv":"sastādītājs (persona)","nl":"samensteller-persoon","no":"utarbeider (person)","tr":"derleyici","zh-Hans-CN":"编纂者个人"},"ToolkitDefinition":{"ar":"شخص يكون مسئولاً عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.","ca":"Persona que és responsable de la creació d’un conjunt de descripció de metadades.","cs":"Osoba, která je odpovědná za vytvoření sady popisu metadat.","da":"Person, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.","de":"Eine Person, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.","de":"Eine Person, die für die Schaffung eines Werks verantwortlich ist.","en":"A person who is responsible for creating a metadata description set.","es":"Una persona que es responsable de crear un conjunto de descripción de metadatos.","et":"Isik, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.","fi":"Henkilö, joka on vastuussa metatietokokonaisuuden luomisesta.","fr":"Personne qui est responsable de la création d’un ensemble de métadonnées descriptives.","hu":"Egy személy, aki felelős egy metaadatleírás-halmaz elkészítéséért.","it":"Persona responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.","lv":"Persona, kura ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.","nl":"Een persoon die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.","no":"En person som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.","tr":"Bir üstveri seti oluşturmaktan sorumlu olan kişi.","zh-Hans-CN":"负责创建一个元数据描述集的一个个人"},"note":{"ar":["تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن الأعمال أو أجزاء من الأعمال وتجميعها."],"ca":["Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític."],"cs":["Sada popisných metadat zahrnuje bibliografii děl, vyjádření nebo provedení, adresář činitelů a míst a analytickou vyhledávací pomůcku."],"da":["Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet."],"de":["Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.,Ein Metadaten-Beschreibungssatz umfasst eine Bibliografie von Werken, Expressionen oder Manifestationen, ein Verzeichnis von Akteuren und Geografika sowie analytische Findmittel."],"en":["A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid."],"es":["Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares, y una ayuda analítica para la búsqueda."],"et":["Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist."],"fi":["Metatietokonaisuuteen kuuluvat teosten, ekspressioiden tai manifestaatioiden bibliografia, toimija- ja paikkahakemisto sekä analyyttinen luettelo."],"fr":["Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique."],"hu":["A metaadatleírási halmaz tartalmazza a művek, kifejezési formák vagy megjelenési formák bibliográfiáját, az ágensek és helyek nyilvántartását, valamint az analitikus keresési segédletet."],"it":["Sono esclusi la revisione o il chiarimento del contenuto di un'espressione di un'opera, e la selezione e raccolta di espressioni di opere o parti di opere."],"lv":["Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu."],"nl":["Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel."],"no":["Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert."],"tr":["Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir."],"zh-Hans-CN":["元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
