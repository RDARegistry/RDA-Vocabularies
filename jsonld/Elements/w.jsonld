                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10371", "lexicalAlias":"http://rdaregistry.info/Elements/w/textWork.en", "label":"has text work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/radioScriptWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10162", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/radioScriptWork.en", "label":"has radio script work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10162", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/radioScriptWork.en", "label":"has radio script work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10255","label":{"ar":"له وكيل مقرر","ca":"té com a agent relator","cs":"má reportéra (agenta)","da":"har agent, som er rapportør","de":"hat Berichterstatterin/Berichterstatter (Akteur)","de":"hat Berichterstatterin/Berichterstatter (Akteur)","el":"έχει εισηγητή","en":"has rapporteur agent","es":"tiene agente relator","et":"aruande koostaja (tegija)","fi":"kokousten raportoija (toimija)","fr":"a pour agent rapporteur","hu":"raportőr ágense a következő:","it":"ha come relatore agente","lv":"ziņotājs (aģents)","nl":"heeft rapporteur-actor","no":"har rapportør (agent)","tr":"raportör temsilcisi ile ilişkilidir","vi":"có người chuẩn bị báo cáo","zh-Hans-CN":"有会务报告人行为者"},"definition":{"ar":["يربط بين عمل ووكيل يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها."],"ca":["Relaciona una obra amb un agent que és un autor que és nomenat per una organització per redactar les actes de les seves reunions."],"cs":["Vztahuje dílo k agentovi, který je autorem, pověřeným organizací, aby podával zprávy o průběhu jejích jednání."],"da":["Relaterer et værk til en agent, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten."],"el":["Συνδέει ένα έργο με έναν συγγραφέα, στον οποίο έχει ανατεθεί από έναν οργανισμό να αναφέρει σχετικά με τα πρακτικά των συναντήσεων του."],"en":["Relates a work to an agent who is an author who is appointed by an organization to report on the proceedings of its meetings."],"es":["Relaciona una obra con un agente que es un autor que es designado por una organización para informar sobre el desarrollo de sus reuniones."],"et":["Seostab teose tegijaga, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama."],"fi":["Liittää teoksen toimijaan, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä."],"fr":["Met une œuvre en relation avec un agent auteur qui est nommé par une organisation pour rédiger les comptes rendus de ses réunions."],"hu":["Hozzákapcsol egy forrást egy szerző ágenshez, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést üléseinek a jegyzőkönyveiről."],"it":["Correla un’opera a un agente che è un autore incaricato da un’organizzazione di compilare rapporti sugli atti dei suoi incontri."],"lv":["Sasaista darbu ar aģentu - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem."],"nl":["Relateert een werk aan een actor die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten."],"no":["Relaterer et verk til en agent som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter."],"tr":["Bir eseri, bir kuruluş tarafından toplantılarının işleyişleri hakkında rapor vermek üzere atanan bir yazar olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác giả được chỉ định bởi tổ chức để báo cáo về kỷ yếu của cuộc họp."],"zh-Hans-CN":["将一种作品与作为一个著者并被一个组织指定为报告会议记录的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مقرر","ca":"agent relator","cs":"reportér (agent)","da":"agent, som er rapportør","de":"Berichterstatterin/Berichterstatter (Akteur)","de":"Berichterstatterin/Berichterstatter (Akteur)","el":"εισηγητής","en":"rapporteur agent","es":"agente relator","et":"aruande koostaja (tegija)","fi":"kokousten raportoija (toimija)","fr":"agent rapporteur","hu":"raportőr ágens:","it":"relatore agente","lv":"ziņotājs (aģents)","nl":"rapporteur-actor","no":"rapportør (agent)","tr":"raportör temsilci","vi":"người chuẩn bị báo cáo","zh-Hans-CN":"会务报告人行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.","ca":"Agent que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.","cs":"agentovi, který je autorem, pověřeným organizací, aby podával zprávy o průběhu jejích jednání.","da":"Agent, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.","de":"Eine Verfasserin/Ein Verfasser (Akteur), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.","de":"Eine Verfasserin/Ein Verfasser (Akteur), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.","el":"Ένας συγγραφέας, στον οποίο έχει ανατεθεί από έναν οργανισμό να αναφέρει σχετικά με τα πρακτικά των συναντήσεών του.","en":"An agent who is an author who is appointed by an organization to report on the proceedings of its meetings.","es":"Un agente que es un autor que es designado por una organización para informar sobre el desarrollo de sus reuniones.","et":"Tegija, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.","fi":"Toimija, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.","fr":"Agent auteur qui est nommé par une organisation pour rédiger les comptes rendus de ses réunions.","hu":"Egy szerző ágens, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést üléseinek a jegyzőkönyveiről.","it":"Autore incaricato da un’organizzazione di compilare rapporti sugli atti dei suoi incontri.","lv":"Aģents - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.","nl":"Een actor die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.","no":"En agent som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.","tr":"Bir kuruluş tarafından toplantılarının tutanakları hakkında rapor vermek üzere atanan bir yazar olan temsilci.","vi":"Tác giả được chỉ định bởi tổ chức để báo cáo về kỷ yếu của cuộc họp.","zh-Hans-CN":"作为一个著者并被一个组织指定为报告会议记录的一个行为者"},"note":{"ar":["تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات."],"ca":["S’exclou la responsabilitat que es limita a prendre notes."],"cs":["Odpovědnost omezená na pořizování zápisu je vyloučena."],"da":["Omfatter ikke ansvar begrænset til at tage referat."],"de":["Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.,Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt."],"el":["Δεν περιλαμβάνεται η υπευθυνότητα που περιορίζεται στην τήρηση πρακτικών."],"en":["Responsibility limited to taking minutes is excluded."],"es":["Se excluye la responsabilidad limitada a levantar actas."],"et":["Ei hõlma vastutust, mis on piiratud ainult protokollimisega."],"fi":["Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta."],"fr":["Une responsabilité limitée à rédiger un procès-verbal est exclue."],"hu":["Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség."],"it":["E' esclusa la responsabilità limitata alla stesura delle minute"],"lv":["Neietver atbildību protokolēt."],"nl":["Verantwoordelijkheid beperkt tot het notuleren is uitgesloten."],"no":["Ansvar som er begrenset til å ta møtereferater, er ikke inkludert."],"tr":["Tutanak tutmakla sınırlı sorumluluk hariçtir."],"vi":["Trách nhiệm giới hạn vào ghi biển bản không được bao gồm"],"zh-Hans-CN":["不包括仅限于写会议记录的责任。"]},"altLabel":{"ar":["مقرر"],"ca":["relator"],"cs":["reportér"],"da":["rapportør"],"de":["Berichterstatter,Berichtserstatter"],"en":["rapporteur"],"es":["relator"],"et":["aruande koostaja"],"fi":["kokousten raportoija"],"fr":["rapporteur"],"hu":["raportőr:"],"it":["relatore"],"no":["rapportør"],"tr":["raportör"],"zh-Hans-CN":["会务报告人"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
