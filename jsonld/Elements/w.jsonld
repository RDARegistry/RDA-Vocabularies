                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/critiqueOfRDAEntity.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10361", "lexicalAlias":"http://rdaregistry.info/Elements/w/evaluationOfRDAEntity.en", "label":"is evaluation of RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10359", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/critiqueOfRDAEntity.en", "label":"is critique of RDA entity"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10359", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/critiqueOfRDAEntity.en", "label":"is critique of RDA entity"}]},{"@id":"http://rdaregistry.info/Elements/w/P10327","label":{"ar":"هو وصف لعائلة","ca":"és descripció d’una família","cs":"je popisem rodiny","da":"er beskrivelse af familie","de":"ist Beschreibung von (Familie)","de":"ist Beschreibung von (Familie)","el":"είναι περιγραφή της (οικογένεια)","en":"is description of family","es":"es descripción de familia","et":"kirjeldatud perekond","fi":"kuvaus suvusta","fr":"est une description d’une famille","hu":"leírása a következő családnak:","it":"è descrizione di famiglia","lv":"ir apraksts dzimtai/ģimenei","nl":"is beschrijving van familie","no":"er beskrivelse av familie","tr":"ailenin tanımıdır","vi":"là mô tả của (gia đình)","zh-Hans-CN":"是家族的描述"},"definition":{"ar":["يربط بين عمل وعائلة موصوفة في عمل."],"ca":["Relaciona una obra amb una família que és descrita per una obra."],"cs":["Vztahuje dílo k rodině, která je popisována v díle."],"da":["Relaterer et værk til en familie, som er beskrevet af et værk."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die von einem Werk beschrieben wird.,Setzt ein Werk in Beziehung zu einer Familie, die von einem Werk beschrieben wird."],"el":["Συνδέει ένα έργο με μια οικογένεια που περιγράφεται από ένα περιγραφικό έργο."],"en":["Relates a work to a family who is described by a work."],"es":["Relaciona una obra con una familia que es descrita por una obra."],"et":["Seostab teose perekonnaga, keda teoses on kirjeldatud."],"fi":["Liittää teoksen sukuun, jota teos kuvaa."],"fr":["Met une œuvre en relation avec une famille qui est décrite par une œuvre."],"hu":["Hozzákapcsol egy művet egy családhoz, amelyet egy mű leír."],"it":["Correla un'opera a una famiglia che è descritta da un'opera."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas aprakstīta darbā."],"nl":["Relateert een werk aan een familie die beschreven wordt door een werk."],"no":["Relaterer et verk til en familie som beskrives av et verk."],"tr":["Bir eseri, eser tarafından tanımlanan bir aileyle ilişkilendirir."],"vi":["Liên kết tác phẩm với gia đình mà tác phẩm nói về."],"zh-Hans-CN":["将一种作品与被一种作品描述的一个家族关联起来。"]},"ToolkitLabel":{"ar":"وصف لعائلة","ca":"descripció d’una família","cs":"popis rodiny","da":"beskrivelse af familie","de":"Beschreibung von (Familie)","de":"Beschreibung von (Familie)","el":"περιγραφή της (οικογένεια)","en":"description of family","es":"descripción de familia","et":"kirjeldatud perekond","fi":"kuvaus suvusta","fr":"description d’une famille","hu":"leírt család:","it":"descrizione di famiglia","lv":"apraksts dzimtai/ģimenei","nl":"beschrijving van familie","no":"beskrivelse av familie","tr":"ailenin tanımı","vi":"mô tả của (gia đình)","zh-Hans-CN":"家族的描述"},"ToolkitDefinition":{"ar":"عائلة موصوفة في عمل.","ca":"Família que és descrita per una obra.","cs":"Rodina, která je popisována v díle.","da":"Familie, som er beskrevet af et værk.","de":"Eine Familie, die von einem Werk beschrieben wird.","de":"Eine Familie, die von einem Werk beschrieben wird.","el":"Μια οικογένεια που περιγράφεται από ένα περιγραφικό έργο.","en":"A family who is described by a work.","es":"Una familia que es descrita por una obra.","et":"Perekond, keda teoses on kirjeldatud.","fi":"Suku, jota teos kuvaa.","fr":"Famille qui est décrite par une œuvre.","hu":"Egy család, amelyet egy mű leír.","it":"Famiglia che è descritta da un'opera.","lv":"Dzimta/ģimene, kas aprakstīta darbā.","nl":"Een familie die beschreven wordt door een werk.","no":"En familie som beskrives av et verk.","tr":"Bir çalışma tarafından tanımlanan aile.","vi":"Gia đình mà tác phẩm nói về.","zh-Hans-CN":"被一种作品描述的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
