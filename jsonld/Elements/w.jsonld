                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/commentaryOnManifestation.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10271", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfManifestation.en", "label":"is description of manifestation"}],"instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10276", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/commentaryOnManifestation.en", "label":"is commentary on manifestation"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10276", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/commentaryOnManifestation.en", "label":"is commentary on manifestation"}]},{"@id":"http://rdaregistry.info/Elements/w/P10270","label":{"ar":"هو تعليق على مفردة","ca":"és comentari sobre un ítem","cs":"je komentářem k jednotce","da":"er kommentar til eksemplar","de":"ist Kommentar zu (Exemplar)","de":"ist Kommentar zu (Exemplar)","el":"είναι σχόλια στο (αντίτυπο)","en":"is commentary on item","es":"es un comentario sobre el item","et":"kommenteeritud eksemplar","fi":"kommentaari kappaleesta","fr":"est un commentaire sur un item","hu":"kommentárja a következő példánynak:","it":"è commento su item","lv":"ir komentārs vienībai","nl":"is commentaar op item","no":"er kommentar til eksemplar","tr":"kopya hakkında yorumdur","vi":"là bình luận về (bản)","zh-Hans-CN":"是关于单件的评注"},"definition":{"ar":["يربط بين عمل ومفردة تستخدم كأساس لمجموعة ملاحظات شارحة أو نقدية."],"ca":["Relaciona una obra amb un ítem usat com a base d’un conjunt de notes explicatives o crítiques."],"cs":["Vztahuje dílo k jednotce, použité jako základ pro soubor vysvětlujících nebo kritických poznámek."],"da":["Relaterer et værk til et eksemplar, som anvendes som grundlag for et sæt af forklarende eller kritiske kommentarer."],"de":["Setzt ein Werk in Beziehung zu einem Exemplar, das als Grundlage für eine Reihe von erläuternden oder kritischen Anmerkungen verwendet wird.,Setzt ein Werk in Beziehung zu einem Exemplar, das als Grundlage für eine Reihe von erläuternden oder kritischen Anmerkungen verwendet wird."],"el":["Συνδέει ένα έργο με ένα αντίτυπο που χρησιμοποιείται ως η βάση για ένα σύνολο από επεξηγηματικές ή κριτικές σημειώσεις."],"en":["Relates a work to an item used as a basis for a set of explanatory or critical notes."],"es":["Relaciona una obra con un item utilizado como base para un conjunto de notas explicativas o críticas."],"et":["Seostab teose eksemplariga, mis on aluseks selgitavate või kriitiliste märkuste kogumile."],"fi":["Liittää teoksen selittävien tai kriittisten huomautusten joukon perustana käytettyyn kappaleeseen."],"fr":["Met une œuvre en relation avec un item qui sert de base à un ensemble de notes explicatives ou critiques."],"hu":["Hozzákapcsol egy művet egy példányhoz, amelyet magyarázó vagy kritikai jegyzetek halmazának alapjaként használnak."],"it":["Correla un’opera a un item utilizzato come base per un insieme di note esplicative o critiche."],"lv":["Sasaista darbu ar vienību, kas izmantota par pamatu virknei paskaidrojošu vai kritisku piezīmju."],"nl":["Relateert een werk aan een item gebruikt als een basis voor een verzameling van verklarende of kritische noten."],"no":["Relaterer et verk til et eksemplar brukt som utgangspunkt for et sett med forklarende eller kritiske noter."],"tr":["Bir eseri, bir dizi açıklayıcı veya eleştirel notlar seti için temel olarak kullanılan bir kopyayla ilişkilendirir."],"vi":["Liên kết tác phẩm với bản được dùng như là cơ sở cho chuỗi các ghi chú giải thích hoặc phê bình."],"zh-Hans-CN":["将一种作品与被用作一个解释性或评论性附注之集合的基础的一个单件关联起来。"]},"ToolkitLabel":{"ar":"تعليق على مفردة","ca":"comentari sobre un ítem","cs":"komentář k jednotce","da":"kommentar til eksemplar","de":"Kommentar zu (Exemplar)","de":"Kommentar zu (Exemplar)","el":"σχόλια στο (αντίτυπο)","en":"commentary on item","es":"comentario sobre el item","et":"kommenteeritud eksemplar","fi":"kommentaari kappaleesta","fr":"commentaire sur un item","hu":"kommentált példány","it":"commentario su item","lv":"komentārs vienībai","nl":"commentaar op item","no":"kommentar til eksemplar","tr":"kopyaya ilişkin yorum","vi":"bình luận về (bản)","zh-Hans-CN":"关于单件的评注"},"ToolkitDefinition":{"ar":"مفردة تستخدم كأساس لمجموعة ملاحظات شارحة أو نقدية.","ca":"Ítem usat com a base d’un conjunt de notes explicatives o crítiques.","cs":"Jednotka, použitá jako základ pro soubor vysvětlujících nebo kritických poznámek.","da":"Eksemplar, som anvendes som grundlag for et sæt af forklarende eller kritiske kommentarer.","de":"Ein Exemplar, das als Grundlage für eine Reihe von erläuternden oder kritischen Anmerkungen verwendet wird.","de":"Ein Exemplar, das als Grundlage für eine Reihe von erläuternden oder kritischen Anmerkungen verwendet wird.","el":"Ένα αντίτυπο που χρησιμοποιείται ως η βάση για ένα σύνολο από επεξηγηματικές ή κριτικές σημειώσεις.","en":"An item used as a basis for a set of explanatory or critical notes.","es":"Un item utilizado como base para un conjunto de notas explicativas o críticas.","et":"Eksemplar, mis on aluseks selgitavate või kriitiliste märkuste kogumile.","fi":"Selittävien tai kriittisten huomautusten joukon perustana käytetty kappale.","fr":"Item qui sert de base à un ensemble de notes explicatives ou critiques.","hu":"Egy példány, amelyet magyarázó vagy kritikai jegyzetek halmazának alapjaként használnak.","it":"Item utilizzato come base per un insieme di note esplicative o critiche.","lv":"Vienība, kas izmantota par pamatu virknei paskaidrojošu vai kritisku piezīmju.","nl":"Een item gebruikt als een basis voor een verzameling van verklarende of kritische noten.","no":"Et eksemplar brukt som utgangspunkt for et sett med forklarende eller kritiske noter.","tr":"Bir dizi açıklayıcı veya eleştirel bilgiye temel olarak kullanılan bir kopya.","vi":"Bản được dùng như là cơ sở cho chuỗi các ghi chú giải thích hoặc phê bình.","zh-Hans-CN":"被用作一个解释性或评论性附注之集合的基础的一个单件"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/commentaryOnItem.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10265", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfItem.en", "label":"is description of item"}],"instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10270", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/commentaryOnItem.en", "label":"is commentary on item"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10270", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/commentaryOnItem.en", "label":"is commentary on item"}]},{"@id":"http://rdaregistry.info/Elements/w/P10111","label":{"ar":"له عمل كشاف نصوص","ca":"té com a obra de concordança","da":"har konkordansværk","de":"hat Konkordanz (Werk)","el":"είναι συμφραστικός πίνακας λέξεων (έργο)","en":"has concordance work (Deprecated)","et":"konkordants (teos)","fi":"konkordanssihakemisto (teos)","fr":"a pour concordance (œuvre)","hu":"konkordanciája a következő mű:","it":"ha come concordanza opera","lv":"darbs: konkordance","nl":"heeft concordantiewerk","no":"har konkordans (verk)","vi":"là sách dẫn (tác phẩm)"},"definition":{"ar":["يربط عمل بعمل يتكون من كشاف لكل الكلمات أو كالكلمات المختارة المتحققة في عمل نصي."],"ca":["Relaciona una obra amb una obra que consisteix en un índex de totes les paraules o de les seleccionades que apareixen en una realització d’una obra textual."],"da":["Relaterer et værk til et værk, som består af et indeks over alle ordene i et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einem Index aller oder ausgewählter Wörter besteht, die in einer Realisierung eines textlichen Werks vorkommen."],"el":["Συνδέει ένα έργο με ένα έργο, το οποίο συνίσταται από ένα ευρετήριο όλων των λέξεων σε ένα κύριο έργο."],"en":["Relates a work to a work that consists of an index of all or selected words that occur in a realization of a textual work. (Deprecated)"],"et":["Seostab teose teosega, mis sisaldab teose kõigi sõnade registri."],"fi":["Liittää teoksen teokseen, joka koostuu kaikkien tai valikoitujen tekstiteoksen toteutuksessa esiintyvien sanojen hakemistosta."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un index de la totalité ou d’une partie des mots qui apparaissent dans une réalisation d’une œuvre textuelle."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy szöveges mű összes szavának vagy válogatott szavak mutatójából áll."],"it":["Correla un’opera a un’opera che consiste di un indice di tutte le parole di un’opera."],"lv":["Sasaista darbu ar darbu - alfabētisks vārdu/izteicienu saraksts."],"nl":["Realiseert een werk aan een werk dat bestaat uit een index van alle of geselecteerde woorden die voorkomen in een realisatie van een tekstwerk."],"no":["Relaterer et verk til et verk som består av et register over alle ordene i et verk."],"vi":["Liên kết tác phẩm với tác phẩm có chứa chỉ mục của tất cả các từ của tác phẩm nổi trội."]},"ToolkitLabel":{"ar":"عمل كشاف نصوص","ca":"obra de concordança","da":"konkordansværk","de":"Konkordanz (Werk)","el":"συμφραστικός πίνακας λέξεων (έργο)","en":"concordance work (Deprecated)","es":"concordancia (obra)","et":"konkordants (teos)","fi":"konkordanssihakemisto (teos)","fr":"concordance (œuvre)","hu":"konkordanciamű","it":"concordanza opera","lv":"darbs: konkordance","nl":"concordantiewerk","no":"konkordans (verk)","vi":"sách dẫn (tác phẩm)"},"ToolkitDefinition":{"ar":"عمل يتكون من كشاف لكل الكلمات أو الكلمات المختارة المتحققة في عمل نصي.","ca":"Obra que consisteix en un índex de totes les paraules o de les seleccionades que apareixen en una realització d’una obra textual.","da":"Værk, som består af et indeks over alle ordene i et værk.","de":"Ein Werk, das aus einem Index aller oder ausgewählter Wörter besteht, die in einer Realisierung eines textlichen Werks vorkommen.","el":"Ένα έργο το οποίο συνίσταται από ένα ευρετήριο όλων των λέξεων σε ένα κύριο έργο.","en":"A work that consists of an index of all or selected words that occur in a realization of a textual work. (Deprecated)","es":"Una obra que consiste en un indice de todas las palabras en la obra principal.","et":"Teos, mis sisaldab teose kõigi sõnade registri.","fi":"Teos, joka koostuu kaikkien tai valikoitujen tekstiteoksen toteutuksessa esiintyvien sanojen hakemistosta.","fr":"Œuvre qui consiste en un index de la totalité ou d’une partie des mots qui apparaissent dans une réalisation d’une œuvre textuelle.","hu":"Egy mű, amely egy szöveges mű összes szavának vagy válogatott szavak mutatójából áll.","it":"Opera che consiste di un indice di tutte le parole di un’opera.","lv":"Darbs - alfabētisks vārdu/izteicienu saraksts.","nl":"Een werk dat bestaat uit een index van alle of geselecteerde woorden die voorkomen in een realisatie van een tekstwerk.","no":"Et verk som består av et register over alle ordene i et verk.","vi":"Tác phẩm có chứa chỉ mục của tất cả các từ của tác phẩm nổi trội."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en", "label":"is augmented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/concordanceWork.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10111", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/concordanceWork.en", "label":"has concordance work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10111", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/concordanceWork.en", "label":"has concordance work (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10083","label":{"ar":"له خطوط إحداثيات مزدوجة","ca":"té com a cadenes de parells de coordenades","cs":"má soustavy dvojic souřadnic","da":"har strenge med koordinatpar","de":"hat Reihen von Koordinatenpaaren","de":"hat Reihen von Koordinatenpaaren","el":"έχει αλφαριθμητικά των ζευγών συντεταγμένων","en":"has strings of coordinate pairs","es":"tiene secuencias de pares de coordenadas","et":"koordinaatide paaride rida","fi":"koordinaattiparit","fr":"a pour chaînes de paires de coordonnées","hu":"koordinátapár-láncai a következők:","it":"ha come stringhe di coppie di coordinate","lv":"koordinātu pāru virknes","nl":"heeft tekenreeksen van coördinatenparen","no":"har strenger med koordinatpar","tr":"koordinat çifti dizgesi ile ilişkilidir","vi":"có chuỗi các cặp toạ độ","zh-Hans-CN":"有坐标对串"},"definition":{"ar":["يربط بين عمل ومكان عبارة عن نطاق تغطية محتوى خرائطي لعمل محدد من خلال مضلع باستخدام إحداثيات لكل قمة مضلع."],"ca":["Relaciona una obra amb un lloc que és l’àrea de cobertura d’una obra cartogràfica que s’identifica per un polígon mitjançant les coordenades de cada vèrtex."],"cs":["Vztahuje dílo k místu, které je oblastí pokrytí kartografického díla a je definováno polygonem, u něhož jsou známé souřadnice všech vrcholů."],"da":["Relaterer et værk til et system til identificering af det præcise areal, som dækkes af et værks kartografiske indhold, ved anvendelse af koordinater for hvert af en polygons toppunkter."],"de":["Setzt ein Werk in Beziehung zu einem Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und durch ein Vieleck mit Koordinaten für jeden Eckpunkt identifiziert wird.,Setzt ein Werk in Beziehung zu einem Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und durch ein Vieleck mit Koordinaten für jeden Eckpunkt identifiziert wird."],"el":["Συνδέει ένα έργο με ένα σύστημα για την ταύτιση της ακριβούς περιοχής που καλύπτεται από το χαρτογραφικό περιεχόμενο ενός έργου που χρησιμοποιεί συντεταγμένες για κάθε κορυφή ενός πολύγωνου."],"en":["Relates a work to a place that is the area of coverage of a cartographic work that is identified by a polygon using coordinates for each vertex."],"es":["Relaciona una obra con un lugar que el área de cobertura de una obra cartográfica que es identificada por un polígono utilizando coordinadas para cada vértice."],"et":["Seostab teose süsteemiga, mille abil tuvastatakse teose kartograafilises sisus hõlmatud täpne ala, kasutades hulknurga iga tipu koordinaate."],"fi":["Liittää teoksen paikkaan, joka on kartografisen teoksen kattama alue, joka on identifioitu jokaisen kärjen koordinaatteja käyttävällä monikulmiolla."],"fr":["Met une œuvre en relation avec un lieu qui constitue la zone de couverture d’une œuvre cartographique identifiée par un polygone à l’aide des coordonnées de chaque sommet."],"hu":["Hozzákapcsol egy művet egy helyhez, egy kartográfiai mű által lefedett területhez, amely meghatározásához az a poligon csúcsainak koordinátáit használja."],"it":["Correla un’opera a un sistema per identificare l’area precisa coperta dal contenuto cartografico di un’opera che utilizza coordinate per ciascun vertice di un poligono."],"lv":["Sasaista darbu ar vietu, kas ir teritorija sistēmas precīzai teritorijas noteikšanai, izmantojot koordinātas katrai daudzstūra virsotnei."],"nl":["Relateert een werk aan een systeem voor het identificeren van een exact gebied bestreken door de cartografische content van een werk waarbij coördinaten gebruikt worden voor elk hoekpunt van een veelhoek."],"no":["Relaterer et verk til et system for å identifisere det eksakte området som dekkes av det kartografiske innholdet til et verk, ved hjelp av koordinater for hvert hjørne av et polygon."],"tr":["Bir eseri, her bir köşe için koordinatlar kullanılarak bir çokgenle tanımlanan bir kartografik eserin kapsama alanı olan bir yerle ilişkilendirir."],"vi":["Liên kết tác phẩm với hệ thống để nhận dạng khu vực chính xác được bao quát bằng nội dung bản đồ của tác phẩm sử dụng các toạ độ cho mỗi đỉnh của đa giác."],"zh-Hans-CN":["将一种作品与作为使用一个多边形每个角的坐标标识一种地图作品所覆盖范围的一个地点关联起来。"]},"ToolkitLabel":{"ar":"خطوط إحداثيات مزدوجة","ca":"cadenes de parells de coordenades","cs":"soustavy dvojic souřadnic","da":"strenge med koordinatpar","de":"Reihen von Koordinatenpaaren","de":"Reihen von Koordinatenpaaren","el":"αλφαριθμητικά των ζευγών συντεταγμένων","en":"strings of coordinate pairs","es":"secuencias de pares de coordenadas","et":"koordinaatide paaride rida","fi":"koordinaattiparit","fr":"chaînes de paires de coordonnées","hu":"koordinátapár-láncai:","it":"stringhe di coppie di coordinate","lv":"koordinātu pāru virknes","nl":"tekenreeksen van coördinatenparen","no":"strenger med koordinatpar","tr":"koordinat çiftleri dizgesi","vi":"chuỗi các cặp toạ độ","zh-Hans-CN":"坐标对串"},"ToolkitDefinition":{"ar":"مكان عبارة عن نطاق تغطية محتوى خرائطي لعمل محدد من خلال مضلع باستخدام إحداثيات لكل قمة مضلع.","ca":"Lloc que és l’àrea de cobertura d’una obra cartogràfica que s’identifica per un polígon mitjançant les coordenades de cada vèrtex.","cs":"Místo, které je oblastí pokrytí kartografického díla a je definováno polygonem, u něhož jsou známé souřadnice všech vrcholů.","da":"System til identificering af det præcise areal, som dækkes af et værks kartografiske indhold, ved anvendelse af koordinater for hvert af en polygons toppunkter.","de":"Ein Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und durch ein Vieleck mit Koordinaten für jeden Eckpunkt identifiziert wird.","de":"Ein Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und durch ein Vieleck mit Koordinaten für jeden Eckpunkt identifiziert wird.","el":"Ένα σύστημα για την ταύτιση της ακριβούς περιοχής που καλύπτεται από το χαρτογραφικό περιεχόμενο ενός έργου που χρησιμοποιεί συντεταγμένες για κάθε κορυφή ενός πολύγωνου.","en":"A place that is the area of coverage of a cartographic work that is identified by a polygon using coordinates for each vertex.","es":"Un lugar que el área de cobertura de una obra cartográfica que es identificada por un polígono utilizando coordinadas para cada vértice.","et":"Süsteem, mille abil tuvastatakse teose kartograafilises sisus hõlmatud täpne ala, kasutades hulknurga iga tipu koordinaate.","fi":"Paikka, joka on kartografisen teoksen kattama alue, joka on identifioitu jokaisen kärjen koordinaatteja käyttävällä monikulmiolla.","fr":"Lieu qui constitue la zone de couverture d’une œuvre cartographique identifiée par un polygone à l’aide des coordonnées de chaque sommet.","hu":"Egy hely, egy kartográfiai mű által lefedett terület, amely meghatározásához az a poligon csúcsainak koordinátáit használja.","it":"Sistema per identificare l’area precisa coperta dal contenuto cartografico di un’opera che utilizza coordinate per ciascun vertice di un poligono.","lv":"Sistēma precīzas teritorijas noteikšanai, izmantojot koordinātas katrai daudzstūra virsotnei.","nl":"Een systeem voor het identificeren van een exact gebied bestreken door de cartografische content van een werk waarbij coördinaten gebruikt worden voor elk hoekpunt van een veelhoek.","no":"Et system for å identifisere det eksakte området som dekkes av det kartografiske innholdet til et verk, ved hjelp av koordinater for hvert hjørne av et polygon.","tr":"Her bir köşe için koordinatlar kullanılarak bir çokgenle tanımlanan bir kartografik çalışmanın kapsama alanı olan bir yer.","vi":"Hệ thống để nhận dạng khu vực chính xác được bao quát bằng nội dung bản đồ của tác phẩm sử dụng các toạ độ cho mỗi đỉnh của đa giác.","zh-Hans-CN":"作为使用一个多边形每个角的坐标标识一种地图作品所覆盖范围的一个地点"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10024", "lexicalAlias":"http://rdaregistry.info/Elements/w/coordinatesOfCartographicContent.en", "label":"has coordinates of cartographic content"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/stringsOfCoordinatePairs.en","instructionNumber":"7.4.3","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10083", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/stringsOfCoordinatePairs.en", "label":"has strings of coordinate pairs"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10083", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/stringsOfCoordinatePairs.en", "label":"has strings of coordinate pairs"}]},{"@id":"http://rdaregistry.info/Elements/w/P10091","label":{"ar":"هو معالج كعمل راقص","ca":"és adaptat com a obra de coreografia","cs":"je adaptováno jako choreografické dílo","da":"er bearbejdet til koreografiværk","de":"ist bearbeitet als Choreografie (Werk)","de":"ist bearbeitet als Choreografie (Werk)","el":"είναι προσαρμοσμένο ως χορογραφία (έργο)","en":"is adapted as choreography work","es":"es adaptada como obra coreográfica","et":"adapteeritud koreograafilise teosena","fi":"sovitettu koreografiaksi (teos)","fr":"est adapté en chorégraphie (œuvre)","hu":"koreográfiamű-átdolgozása a következő:","it":"è adattata come opera in forma di coreografia","lv":"ir adaptēts kā horeogrāfija (darbs)","nl":"is bewerkt als choreografisch werk","no":"er bearbeidet som koreografisk verk","tr":"koreografi eseri olarak uyarlanmıştır","vi":"được phỏng theo như là dàn dựng (tác phẩm)","zh-Hans-CN":"被改编为编舞作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل راقص مبني على عمل آخر."],"ca":["Relaciona una obra amb una obra que és una obra coreogràfica basada en una altra obra."],"cs":["Vztahuje dílo k dílu, které je choreografickým dílem, založeným na jiném díle."],"da":["Relaterer et værk til et koreografisk værk, baseret på et relateret værk."],"de":["Setzt ein Werk in Beziehung zu einem choreografischen Werk, das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem choreografischen Werk, das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα έργο που συνίσταται από κίνηση βασισμένη σε ένα έργο-πηγή."],"en":["Relates a work to a work that is a choreographic work based on another work."],"es":["Relaciona una obra con una obra que es una obra coreográfica que está basada en otra obra."],"et":["Seostab teose koreograafilise teosega, mis põhineb seotud teosel."],"fi":["Liittää teoksen teokseen, joka on toiseen teokseen perustuva koreografinen teos."],"fr":["Met une œuvre en relation avec une œuvre chorégraphique qui est basée sur une autre œuvre."],"hu":["Egy művet hozzákapcsol egy forrásművön alapuló műhöz, amely mozgásból áll."],"it":["Correla un’opera a un’opera coreografica basata su un’opera correlata."],"lv":["Sasaista darbu ar darbu, kas ir darba pārstrādājums horeogrāfijā."],"nl":["Relateert een werk aan een werk dat is een choreografisch werk gebaseerd op een ander werk."],"no":["Relaterer et verk til et koreografisk verk basert på et relatert verk."],"tr":["Bir eseri, başka bir eserden uyarlanmış koreografi bir eseri olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa động thái dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为基于另一种作品的一种编舞作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل راقص","ca":"adaptat com a obra de coreografia","cs":"adaptováno jako choreografické dílo","da":"bearbejdet til koreografiværk","de":"Bearbeitet als Choreografie (Werk)","de":"Bearbeitet als Choreografie (Werk)","el":"προσαρμοσμένο ως χορογραφία (έργο)","en":"adapted as choreography work","es":"adaptada como obra coreográfica","et":"adapteeritud koreograafilise teosena","fi":"sovitettu koreografiaksi (teos)","fr":"adapté en chorégraphie (œuvre)","hu":"koreográfiamű-átdolgozás:","it":"adattata come opera in forma di coreografia","lv":"adaptēts kā darbs: horeogrāfija","nl":"bewerkt als choreografisch werk","no":"bearbeidet som koreografisk verk","tr":"Koreografi çalışması olarak uyarlanan","vi":"được phỏng theo như là dàn dựng (tác phẩm)","zh-Hans-CN":"被改编为编舞作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل راقص مبني على عمل آخر.","ca":"Obra que és una obra coreogràfica basada en una altra obra.","cs":"Dílo, které je choreografickým dílem, založeným na jiném díle.","da":"Koreografisk værk, baseret på et relateret værk.","de":"Ein choreografischen Werk, das auf einem anderen Werk basiert.","de":"Ein choreografischen Werk, das auf einem anderen Werk basiert.","el":"Ένα έργο που συνίσταται από κίνηση βασισμένη σε ένα έργο-πηγή.","en":"A work that is a choreographic work based on another work.","es":"Una obra que es una obra coreográfica que está basada en otra obra.","et":"Koreograafiline teos, mis põhineb seotud teosel.","fi":"Teos, joka on toiseen teokseen perustuva koreografinen teos.","fr":"Œuvre chorégraphique qui est basée sur une autre œuvre.","hu":"Egy mozgásból álló mű, amely egy forrásművön alapul.","it":"Opera coreografica basata su un’opera correlata.","lv":"Darba pārstrādājums horeogrāfijā.","nl":"Een werk dat is een choreografisch werk gebaseerd op een ander werk.","no":"Et koreografisk verk basert på et relatert verk.","tr":"Başka bir eserden uyarlanmış koreografik çalışma olan bir eser.","vi":"Tác phẩm có chứa động thái dựa trên tác phẩm nguồn.","zh-Hans-CN":"作为基于另一种作品的一种编舞作品的一种作品"},"altLabel":{"de":["Bearbeitet als Choreographie (Werk)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
