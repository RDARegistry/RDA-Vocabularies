ird.,Setzt ein Werk in Beziehung zu einem Akteur, der durch ein Werk geehrt wird."],"el":["Συνδέει ένα έργο με έναν φορέα, τιμώμενο από ένα έργο."],"en":["Relates a work to an agent who is honoured by a work."],"es":["Relaciona una obra con un agente que es homenajeado por una obra."],"et":["Seostab teose tegijaga, keda teosega austatakse."],"fi":["Liittää teoksen toimijaan, jonka kunniaksi teos on tehty."],"fr":["Met une œuvre en relation avec un agent qui est honoré par une œuvre."],"hu":["Hozzákapcsol egy művet egy ágenshez, amelyet egy mű méltat."],"it":["Correla un’opera a un agente che è onorato da un'opera."],"lv":["Sasaista darbu ar aģentu, kas godināts ar darbu."],"nl":["Relateert een werk aan een actor die geëerd wordt door een werk."],"no":["Relaterer et verk til en agent som blir beæret av et verk."],"tr":["Bir eseri, eser tarafından onurlandırılan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân được tác phẩm kính trọng."],"zh-Hans-CN":["将一种作品与被一种作品纪念的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مكرم بعمل","ca":"agent homenatjat d’una obra","cs":"poctěný agent (dílem)","da":"agent, som beæres af værk","de":"Gefeierte/Gefeierter eines Werks (Akteur)","de":"Gefeierte/Gefeierter eines Werks (Akteur)","el":"τιμώμενο πρόσωπο","en":"honouree agent of work","es":"agente homenajeado de obra","et":"teose austusavalduse saaja (tegija)","fi":"teoksella kunnioitettu toimija","fr":"agent honoré d’une œuvre","hu":"mű méltatott ágense:","it":"onorato agente di opera","lv":"ar darbu godinātais aģents","nl":"geëerde actor van werk","no":"beæret agent av verk","tr":"eserin onurlandırılan temsilcisi ile ilişkilidir","vi":"người được kính trọng","zh-Hans-CN":"作品的被纪念者行为者"},"ToolkitDefinition":{"ar":"وكيل مكرم بعمل.","ca":"Agent que és homenatjat per una obra.","cs":"Agent, který je poctěn v díle.","da":"Agent, som hædres af et værk.","de":"Ein Akteur, der durch ein Werk geehrt wird.","de":"Ein Akteur, der durch ein Werk geehrt wird.","el":"Ένας φορέας τιμώμενος από ένα έργο.","en":"An agent who is honoured by a work.","es":"Un agente que es homenajeado por una obra.","et":"Tegija, keda teosega austatakse.","fi":"Toimija, jonka kunniaksi teos on tehty.","fr":"Agent qui est honoré par une œuvre.","hu":"Egy ágens, amelyet egy mű méltat.","it":"Agente che è onorato da un'opera.","lv":"Aģents, kas godināts ar darbu.","nl":"Een actor die geëerd wordt door een werk.","no":"En agent som blir beæret av et verk.","tr":"Bir çalışmayla onurlandırılan bir temsilci.","vi":"Tác nhân được tác phẩm kính trọng.","zh-Hans-CN":"被一种作品纪念的一个行为者"},"altLabel":{"ar":["مكرَّم"],"ca":[","],"cs":[","],"da":["agent, som er hædersperson i værk"],"de":["Gefeierte/Gefeierter eines Werks (Gemeinschaftlicher Akteur),Gefeierter"],"en":["honoree agent of work,honouree"],"es":["agente homenajeado de obra,homenajeado"],"et":["teose austusavalduse saaja"],"fi":[","],"fr":["agent honoré"],"hu":[","],"it":["onorato di opera"],"nl":["geëerde actor van werk,geëerde"],"no":["agent beæret av et verk,beæret av verk"],"tr":["eserin onurlandırılan temsilcisi,onursal"],"zh-Hans-CN":["作品的被纪念者行为者,被纪念者"],"zh-Hant-TW":[","]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
