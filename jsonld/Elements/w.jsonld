                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10238", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForWork.en", "label":"is music for work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/musicForMotionPictureWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10245", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/musicForMotionPictureWork.en", "label":"is music for motion picture work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10245", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/musicForMotionPictureWork.en", "label":"is music for motion picture work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10237","label":{"ar":"له عمل موسيقي","ca":"té com a obra de música","cs":"má hudbu (dílo)","da":"har musikværk","de":"hat Musik (Werk)","de":"hat Musik (Werk)","el":"είναι μουσική (έργο)","en":"has music work","es":"tiene obra musical","et":"muusika (teos)","fi":"musiikki (teos)","fr":"a pour musique (œuvre)","hu":"zenéje a következő mű:","it":"ha come opera in forma di musica","lv":"darbs: mūzika","nl":"heeft muziekwerk","no":"har musikk (verk)","tr":"müzik eseri ile ilişkilidir","vi":"là âm nhạc (tác phẩm)","zh-Hans-CN":"有音乐作品"},"definition":{"ar":["يربط عمل بعمل موسيقي يكمل عملا."],"ca":["Relaciona una obra amb una obra que és una obra musical que complementa una obra."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, doplňujícím dílo."],"da":["Relaterer et værk til et musikværk, som komplementerer et værk."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, das ein Werk ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Musikwerk ergänzt."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο που χρησιμοποιείται σε μια κινηματογραφική ταινία, ένα θεατρικό έργο, ένα τηλεοπτικό πρόγραμμα κ.λπ."],"en":["Relates a work to a work that is a musical work that complements a work."],"es":["Relaciona una obra con una obra que es una obra musical que complementa una obra."],"et":["Seostab teose teost täiendava muusikateosega."],"fi":["Liittää teoksen musiikkiteokseen, joka täydentää teosta."],"fr":["Met une œuvre en relation avec une œuvre musicale qui complète une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amely kiegészít egy művet."],"it":["Correla un’opera a un’opera musicale che completa un’opera."],"lv":["Sasaista darbu ar mūzikas darbu, kas papildina citu darbu."],"nl":["Relateert een werk aan een muziekwerk dat een werk complementeert."],"no":["Relaterer et verk til et musikalsk verk som utfyller et verk."],"tr":["Bir eseri, bir eseri tamamlayan bir müzik eseri olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc được sử dụng trong phim điện ảnh, kịch, chương trình truyền hình, v.v..."],"zh-Hans-CN":["将一种作品与作为一种音乐作品并补充一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل موسيقي","ca":"obra de música","cs":"hudba (dílo)","da":"musikværk","de":"Musik (Werk)","de":"Musik (Werk)","el":"μουσική (έργο)","en":"music work","es":"obra musical","et":"muusika (teos)","fi":"musiikki (teos)","fr":"musique (œuvre)","hu":"zenemű","it":"opera in forma di musica","lv":"darbs: mūzika","nl":"muziekwerk","no":"musikk (verk)","tr":"müzik eseri","vi":"âm nhạc (tác phẩm)","zh-Hans-CN":"音乐作品"},"ToolkitDefinition":{"ar":"عمل موسيقي يكمل عملا.","ca":"Obra que és una obra musical que complementa una obra.","cs":"Dílo, které je hudebním dílem, doplňujícím dílo.","da":"Musikværk, som komplementerer et andet værk.","de":"Ein Musikwerk, das ein Werk ergänzt.","de":"Ein textliches Werk, das ein Musikwerk ergänzt.","el":"Ένα μουσικό έργο που χρησιμοποιείται σε μια κινηματογραφική ταινία, ένα θεατρικό έργο, ένα τηλεοπτικό πρόγραμμα κ.λπ.","en":"A work that is a musical work that complements a work.","es":"Una obra que es una obra musical que complementa una obra.","et":"Teost täiendav muusikateos.","fi":"Musiikkiteos, joka täydentää teosta.","fr":"Œuvre musicale qui complète une œuvre.","hu":"Egy mű, amely egy zenemű, amely kiegészít egy művet.","it":"Opera musicale che completa un’opera.","lv":"Mūzikas darbs, kas papildina citu darbu.","nl":"Een muziekwerk dat een werk complementeert.","no":"Et musikalsk verk som utfyller et verk.","tr":"Bir eseri tamamlayan bir müzik eseri olan bir eser.","vi":"Tác phẩm âm nhạc được sử dụng trong phim điện ảnh, kịch, chương trình truyền hình, v.v...","zh-Hans-CN":"作为一种音乐作品并补充一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10246", "lexicalAlias":"http://rdaregistry.info/Elements/w/motionPictureMusicWork.en", "label":"has motion picture music work"},{"@id":"http://rdaregistry.info/Elements/w/P10031", "lexicalAlias":"http://rdaregistry.info/Elements/w/incidentalMusicWork.en", "label":"has incidental music work"},{"@id":"http://rdaregistry.info/Elements/w/P10243", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioProgramMusicWork.en", "label":"has radio program music work"},{"@id":"http://rdaregistry.info/Elements/w/P10241", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProgramMusicWork.en", "label":"has television program music work"},{"@id":"http://rdaregistry.info/Elements/w/P10239", "lexicalAlias":"http://rdaregistry.info/Elements/w/videoMusicWork.en", "label":"has video music work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/musicWork.en", "label":"has music work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/musicWork.en", "label":"has music work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10079","label":{"ar":"له تعيين رقمي لعمل موسيقي","ca":"té com a designació numèrica d’una obra musical","cs":"má číselné označení hudebního díla","da":"har numerisk betegnelse for et musikværk","de":"ist numerische Bezeichnung eines Musikwerks","de":"ist numerische Bezeichnung eines Musikwerks","el":"έχει αριθμητικό προσδιορισμό του μουσικού έργου","en":"has numeric designation of musical work","es":"tiene designación numérica de obra musical","et":"muusikateose numbriline tähistus","fi":"musiikkiteoksen numerointi","fr":"a pour désignation numérique d’une œuvre musicale","hu":"zenemű számjelzése a következő:","it":"ha come designazione numerica di opera musicale","lv":"mūzikas darba numerācija","nl":"heeft numerieke aanduiding van muziekwerk","no":"har numerisk betegnelse for musikalsk verk","tr":"müzik eserinin sayısal tanımlayıcısı ile ilişkilidir","vi":"có định danh số của tác phẩm âm nhạc","zh-Hans-CN":"有音乐作品的数字标识"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن رقم تسلسلي، أو رقم قطعة موسيقية، أو رقم كشاف موضوعي مخصص لعمل موسيقي لملحن، أو ناشر، أو عالم موسيقى."],"ca":["Relaciona una obra amb un nomen que és un número d’ordre, número d’opus o número d’índex temàtic assignat a una obra musical per un compositor, un editor o un musicòleg."],"cs":["Vztahuje dílo k nomen, které je pořadovým číslem, opusovým číslem nebo číslem tematického katalogu, přiřazeným hudebnímu dílu skladatelem, vydavatelem nebo muzikologem."],"da":["Relaterer et værk til et serienummer, opusnummer eller værkfortegnelsesnummer tildelt et musikværk af en komponist, udgiver eller musikforsker."],"de":["Setzt ein Werk in Beziehung zu einer laufenden Nummer, einer Opus-Nummer oder einer Werkverzeichnisnummer, die einem Musikwerk durch eine Komponistin/einen Komponisten, einen Verlag oder eine Musikwissenschaftlerin/einen Musikwissenschaftler zugewiesen wird.,Setzt ein Werk in Beziehung zu einer laufenden Nummer, einer Opus-Nummer oder einer Werkverzeichnisnummer, die einem Musikwerk durch eine Komponistin/einen Komponisten, einen Verlag oder eine Musikwissenschaftlerin/einen Musikwissenschaftler zugewiesen wird."],"el":["Συνδέει ένα έργο με έναν σειριακό αριθμό, αριθμό έργου ή αριθμό θεματικού ευρετηρίου που ανατίθεται σε ένα μουσικό έργο από έναν συνθέτη, εκδότη ή μουσικολόγο."],"en":["Relates a work to a nomen that is a serial number, opus number, or thematic index number assigned to a musical work by a composer, publisher, or musicologist."],"es":["Relaciona una obra con un nomen que es un número de serie, número de opus o número de índice temático asignado a una obra musical por un compositor, editorial o musicólogo."],"et":["Seostab teose järjenumbri, oopuse numbri või temaatilise kataloogi numbriga, mille on muusikateosele määranud helilooja, kirjastaja või muusikateadlane."],"fi":["Liittää teoksen nomeniin, joka on järjestysnumero, opusnumero tai temaattisen teosluettelon numero, jonka säveltäjä, kustantaja tai musiikintutkija on antanut musiikkiteokselle."],"fr":["Met une œuvre en relation avec un nomen qui est un numéro d’ordre, un numéro d’opus ou un numéro de catalogue thématique attribué à une œuvre musicale par un compositeur, un éditeur ou un musicologue."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy sorozati számhoz, opusszámhoz vagy tematikus indexszámhoz, amelyet egy zeneszerző, egy kiadó vagy egy zenetudós rendel hozzá egy zeneműhöz."],"it":["Correla un’opera a un numero sequenziale, numero di opera o numero di catalogo tematico assegnato a un'opera musicale da un compositore, un editore o un musicologo."],"lv":["Sasaista darbu ar nomenu, kas ir mūzikas darba kārtas numurs, opusa numurs vai tematiskā rādītāja numurs, kuru piešķīris komponists, izdevējs vai muzikologs."],"nl":["Relateert een werk aan een nomen dat is een serienummer, opusnummer of thematische indexnummer toegekend aan een muziekwerk door een componist, uitgever of musicoloog."],"no":["Relaterer et verk til et serienummer, opusnummer eller nummer for tematisk verkfortegnelse som en komponist, utgiver eller musikkviter har gitt et musikalsk verk."],"tr":["Bir eseri, bir besteci, yayıncı veya müzikolog tarafından bir müzik kaynağına atanan seri numarası, beste numarası veya tematik dizin numarası olan bir isimle ilişkilendirir."],"vi":["Liên kết tác phẩm với chỉ số tùng thư, chỉ số tác phẩm nghệ thuật, hoặc chỉ mục đề tài được người soạn, nhà xuất bản, hoặc nhà âm nhạc học gán cho tác phẩm âm nhạc ,"],"zh-Hans-CN":["将一种作品与作为作曲者、出版者或者音乐学家给一种音乐作品分配的序列号、作品号或主题索引号的一个命名关联起来。"]},"ToolkitLabel":{"ar":"تعيين رقمي لعمل موسيقي","ca":"designació numèrica d’una obra musical","cs":"číselné označení hudebního díla","da":"numerisk betegnelse for et musikværk","de":"Numerische Bezeichnung eines Musikwerks","de":"Numerische Bezeichnung eines Musikwerks","el":"αριθμητικός προσδιορισμός του μουσικού έργου","en":"numeric designation of musical work","es":"designación numérica de obra musical","et":"muusikateose numbriline tähistus","fi":"musiikkiteoksen numerointi","fr":"désignation numérique d’une œuvre musicale","hu":"zeneműhöz tartozó számjelzés:","it":"designazione numerica di opera musicale","lv":"mūzikas darba numerācija","nl":"numerieke aanduiding van muziekwerk","no":"numerisk betegnelse for musikalsk verk","tr":"müzik eserinin sayısal tanımlaması","vi":"định danh số của tác phẩm âm nhạc","zh-Hans-CN":"音乐作品的数字标识"},"ToolkitDefinition":{"ar":"تسمية عبارة عن رقم تسلسلي، أو رقم قطعة موسيقية، أو رقم كشاف موضوعي مخصص لعمل موسيقي لملحن، أو ناشر، أو عالم موسيقى.","ca":"Nomen que és un número d’ordre, número d’opus o número d’índex temàtic assignat a una obra musical per un compositor, un editor o un musicòleg.","cs":"Nomen, které je pořadovým číslem, opusovým číslem nebo číslem tematického katalogu, přiřazeným hudebnímu dílu skladatelem, vydavatelem nebo muzikologem.","da":"Serienummer, opusnummer eller værkfortegnelsesnummer tildelt et musikværk af en komponist, udgiver eller musikforsker.","de":"Eine laufende Nummer, eine Opus-Nummer oder eine Werkverzeichnisnummer, die einem Musikwerk durch eine Komponistin/einen Komponisten, einen Verlag oder eine Musikwissenschaftlerin/einen Musikwissenschaftler zugewiesen wird.","de":"Eine laufende Nummer, eine Opus-Nummer oder eine Werkverzeichnisnummer, die einem Musikwerk durch eine Komponistin/einen Komponisten, einen Verlag oder eine Musikwissenschaftlerin/einen Musikwissenschaftler zugewiesen wird.","el":"Ένας σειριακός αριθμός, αριθμός έργου ή αριθμός θεματικού ευρετηρίου που ανατίθεται σε ένα μουσικό έργο από έναν συνθέτη, εκδότη ή μουσικολόγο.","en":"A nomen that is a serial number, opus number, or thematic index number assigned to a musical work by a composer, publisher, or musicologist.","es":"Un nomen que es un número de serie, número de opus o número de índice temático asignado a una obra musical por un compositor, editorial o musicólogo.","et":"Järjenumber, oopuse number või temaatilise kataloogi number, mille on muusikateosele määranud helilooja, kirjastaja või muusikateadlane.","fi":"Nomen, joka on järjestysnumero, opusnumero tai temaattisen teosluettelon numero, jonka säveltäjä, kustantaja tai musiikintutkija on antanut musiikkiteokselle.","fr":"Nomen qui est un numéro d’ordre, un numéro d’opus ou un numéro de catalogue thématique attribué à une œuvre musicale par un compositeur, un éditeur ou un musicologue.","hu":"Egy nomen, egy sorozati szám, opusszám vagy tematikus indexszám, amelyet egy zeneszerző, egy kiadó vagy egy zenetudós rendel hozzá egy zeneműhöz.","it":"Numero sequenziale, numero di opera o numero di catalogo tematico assegnato a un'opera musicale da un compositore, un editore o un musicologo.","lv":"Mūzikas darba kārtas numurs, opusa numurs vai tematiskā rādītāja numurs, kuru piešķīris komponists, izdevējs vai muzikologs.","nl":"Een nomen dat is een serienummer, opusnummer of thematische indexnummer toegekend aan een muziekwerk door een componist, uitgever of musicoloog.","no":"Et serienummer, opusnummer eller nummer for tematisk verkfortegnelse som en komponist, utgiver eller musikkviter har gitt et musikalsk verk.","tr":"Bir besteci, yayıncı veya müzikolog tarafından bir müzik eserine atanan seri numarası, opus numarası veya tematik dizin numarası olan bir isim.","vi":"Chỉ số tùng thư, chỉ số tác phẩm nghệ thuật, hoặc chỉ mục đề tài được người soạn, nhà xuất bản, hoặc nhà âm nhạc học gán cho tác phẩm âm nhạc ,","zh-Hans-CN":"作为作曲者、出版者或者音乐学家给一种音乐作品分配的序列号、作品号或主题索引号的一个命名"},"note":{"ar":["يتضمن التعيين تعليقًا (مثل رقم، أو مرجع سابق، أو BWV) وقد يتضمن تواريخ أو فترات زمنية أخرى، وتمثيلات هجائية-رقمية أو تمثيلات أخرى."],"ca":["Una designació inclou una llegenda (per exemple, núm., op., BWV) i pot incloure dates o altres intervals de temps i caràcters alfanumèrics o altres caràcters."],"cs":["Označení zahrnuje popisek (např. č., op., BWV) a může obsahovat data nebo jiné časové vymezení a alfanumerické nebo jiné znaky."],"da":["Betegnelse omfatter en indledning (fx no., op., BWV) og den kan omfatte datoer eller andre tidsperioder, alfanumerisk tegnsæt eller andre skrifttegn."],"de":["Darunter fallen einleitende Begriffe (zum Beispiel Nr., op., BWV) sowie gegebenenfalls Datumsangaben oder andere Zeiträume und alphanumerische oder andere Zeichen.,Darunter fallen einleitende Begriffe (zum Beispiel Nr., op., BWV) sowie gegebenenfalls Datumsangaben oder andere Zeiträume und alphanumerische oder andere Zeichen."],"el":["Ένας αριθμητικός προσδιορισμός ενός μουσικού έργου περιλαμβάνει μια επικεφαλίδα όπως π.χ., no., op., BWV και μπορεί να περιλαμβάνει ένα αριθμητικό, ένα γράμμα, μια λέξη, οποιονδήποτε άλλο χαρακτήρα ή τον συνδυασμό τους."],"en":["A designation includes a caption (e.g., no., op., BWV) and may include dates or other timespans, and alphanumeric or other characters."],"es":["Una designación incluye un título (por ejemplo, núm., op., BWV) y puede incluir fechas u otros espacios de tiempo y caracteres numéricos u otros."],"et":["Tähistus sisaldab vastavat täheühendit (nt nr, op., BWV) ja võib sisaldada daatumeid või muid ajavahemikke ning tähtnumbrilisi või muid märke"],"fi":["Numerointi sisältää otsikon (esim. nro, op., BWV) ja voi sisältää ajankohtia tai muita ajanjaksoja sekä aakkosnumeerisia tai muita merkkejä."],"fr":["Une désignation comprend un libellé (par exemple, no, op., BWV) et peut inclure des dates ou d’autres laps de temps ainsi que des caractères alphanumériques ou autres."],"hu":["Egy zenemű számjelzése magában foglalja az olyan feliratozást, mint például a pl., a no. az op., a BWV, és magába foglalhat egy számot, betűt, szót, bármely más karaktert, vagy ezek kombinációját."],"lv":["Numerācija ietver apzīmējumus, piemēram, Nr., op., BWV, tajā var būt iekļauts datējums vai cits laikposma apzīmējums, kā arī cipari, burti vai citas rakstzīmes."],"nl":["Een aanduiding omvat een opschrift (bijv. nr., op. BWV) en kan data of andere tijdspannes omvatten, en alfanumerieke of andere tekens."],"no":["En betegnelse inkluderer en tekst (f.eks. no., op., BWV) og kan inneholde datoer eller andre tidsspenn og alfanumeriske eller andre tegn."],"tr":["Bir tanımlama bir başlık içerir (örneğin, no., op., BWV) ve tarihleri veya diğer zaman aralıklarını ve alfanümerik veya diğer karakterleri içerebilir."],"vi":["Định danh số của tác phẩm âm nhạc bao gồm cả đầu đề như là e.g., no., op., BWV, và có thể bao gồm chữ số, chữ cái, hoặc ký tự bất kỳ khác, hoặc tổ hợp của chúng."],"zh-Hans-CN":["标识包括一段说明文字（例如no.、op.、BWV）并可以包括日期或其他时间段、以及字母数字或其他字符。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
