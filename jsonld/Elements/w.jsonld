                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10312", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedPersonOfWork.en", "label":"has related person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10407", "lexicalAlias":"http://rdaregistry.info/Elements/w/academicSupervisor.en", "label":"has academic supervisor"},{"@id":"http://rdaregistry.info/Elements/w/P10448", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorPerson.en", "label":"has aggregator person"},{"@id":"http://rdaregistry.info/Elements/w/P10286", "lexicalAlias":"http://rdaregistry.info/Elements/w/defendantPerson.en", "label":"has defendant person"},{"@id":"http://rdaregistry.info/Elements/w/P10035", "lexicalAlias":"http://rdaregistry.info/Elements/w/appelleePerson.en", "label":"has appellee person"},{"@id":"http://rdaregistry.info/Elements/w/P10438", "lexicalAlias":"http://rdaregistry.info/Elements/w/architectPerson.en", "label":"has architect person"},{"@id":"http://rdaregistry.info/Elements/w/P10451", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistPerson.en", "label":"has artist person"},{"@id":"http://rdaregistry.info/Elements/w/P10436", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorPerson.en", "label":"has author person"},{"@id":"http://rdaregistry.info/Elements/w/P10044", "lexicalAlias":"http://rdaregistry.info/Elements/w/judge.en", "label":"has judge"},{"@id":"http://rdaregistry.info/Elements/w/P10435", "lexicalAlias":"http://rdaregistry.info/Elements/w/cartographerPersonOfWork.en", "label":"has cartographer person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10453", "lexicalAlias":"http://rdaregistry.info/Elements/w/castingDirectorPerson.en", "label":"has casting director person"},{"@id":"http://rdaregistry.info/Elements/w/P10434", "lexicalAlias":"http://rdaregistry.info/Elements/w/choreographerPerson.en", "label":"has choreographer person"},{"@id":"http://rdaregistry.info/Elements/w/P10442", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerPersonOfWork.en", "label":"has composer person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10458", "lexicalAlias":"http://rdaregistry.info/Elements/w/consultantPerson.en", "label":"has consultant person"},{"@id":"http://rdaregistry.info/Elements/w/P10414", "lexicalAlias":"http://rdaregistry.info/Elements/w/dedicatorPerson.en", "label":"has dedicator person"},{"@id":"http://rdaregistry.info/Elements/w/P10441", "lexicalAlias":"http://rdaregistry.info/Elements/w/designerPerson.en", "label":"has designer person"},{"@id":"http://rdaregistry.info/Elements/w/P10284", "lexicalAlias":"http://rdaregistry.info/Elements/w/degreeCommitteeMember.en", "label":"has degree committee member"},{"@id":"http://rdaregistry.info/Elements/w/P10455", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorPerson.en", "label":"has director person"},{"@id":"http://rdaregistry.info/Elements/w/P10415", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorPersonOfPhotography.en", "label":"has director person of photography"},{"@id":"http://rdaregistry.info/Elements/w/P10417", "lexicalAlias":"http://rdaregistry.info/Elements/w/editorialDirectorPerson.en", "label":"has editorial director person"},{"@id":"http://rdaregistry.info/Elements/w/P10045", "lexicalAlias":"http://rdaregistry.info/Elements/w/praeses.en", "label":"has praeses"},{"@id":"http://rdaregistry.info/Elements/w/P10042", "lexicalAlias":"http://rdaregistry.info/Elements/w/appellantPerson.en", "label":"has appellant person"},