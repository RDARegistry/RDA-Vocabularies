                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/sponsoringPersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10067", "lexicalAlias":"http://rdaregistry.info/Elements/w/sponsoringAgentOfWork.en", "label":"has sponsoring agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10312", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedPersonOfWork.en", "label":"has related person of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10607", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sponsoringPersonOfWork.en", "label":"has sponsoring person of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10607", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sponsoringPersonOfWork.en", "label":"has sponsoring person of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10382","label":{"ar":"له إصدارة ثابتة","ca":"té com a versió estàtica","cs":"má statickou verzi","da":"har statisk version","de":"hat statische Version","de":"hat statische Version","en":"has static version","es":"tiene versión estática","et":"staatiline versioon","fi":"staattinen versio","fr":"a pour version statique","hu":"statikus változata a következő:","it":"ha come versione statica","lv":"statiska versija","nl":"heeft statische versie","no":"har statisk versjon","tr":"durağan sürüm ile ilişkilidir","zh-Hans-CN":"有静态版本"},"definition":{"ar":["يربط عمل بعمل يتم إنشاؤه عن طريق تغيير خطة توسع لعمل من متكامل إلى ثابت."],"ca":["Relaciona una obra amb una obra que es crea canviant el pla d’extensió d’una obra d’integrant a estàtic."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou plánu rozšíření díla z integračního na statické."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre udvidelsesplanen for et værk fra integrerende til statisk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Erweiterungsplans eines Werks von integrierend auf statisch erstellt wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Erweiterungsplans eines Werks von integrierend auf statisch erstellt wird."],"en":["Relates a work to a work that is created by changing the extension plan of a work from integrating to static."],"es":["Relaciona una obra con una obra que se crea cambiando el plan de extensión de una obra de integradora a estática."],"et":["Seostab teose teosega, mis on loodud, muutes teose jätkamiskava järjestikusest staatiliseks."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen laajennussuunnitelmaa päivittyvästä staattiseksi."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le plan d’extension intégrateur d’une œuvre en plan statique."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű közlési tervének integrálóról statikussá való változásával jött létre."],"it":["Correla un'opera a un'opera creata cambiando il piano di estensione di un'opera da integrativo a statico."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba paplašināšanas plānu no integrētā uz statisku."],"nl":["Relateert een werk aan een werk dat gevormd is door het veranderen van een extensieplan van geïntegreerd naar statisch."],"no":["Relaterer et verk til et verk som er skapt ved endring av utvidelsesplan for et verk fra integrerende til statisk."],"tr":["Bir eseri, bir eserin genişletme planı birleştiriciden durağan hale değiştirilerek oluşturulan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过将一种作品的扩充计划从集成性到静态变化而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة ثابتة","ca":"versió estàtica","cs":"statická verze","da":"statisk version","de":"Statische Version","de":"Statische Version","en":"static version","es":"versión estática","et":"staatiline versioon","fi":"staattinen versio","fr":"version statique","hu":"statikus változata:","it":"versione statica","lv":"statiska versija","nl":"statische versie","no":"statisk versjon","tr":"durağan sürüm","zh-Hans-CN":"静态版本"},"ToolkitDefinition":{"ar":"عمل يتم إنشاؤه عن طريق تغيير خطة توسع لعمل من متكامل إلى ثابت.","ca":"Obra que es crea canviant el pla d’extensió d’una obra d’integrant a estàtic.","cs":"Dílo, které je vytvořeno změnou plánu rozšíření díla z integračního na statické.","da":"Værk, som er skabt ved at ændre udvidelsesplanen for et værk fra integrerende til statisk.","de":"Ein Werk, das durch Änderung des Erweiterungsplans eines Werks von integrierend auf statisch erstellt wird.","de":"Ein Werk, das durch Änderung des Erweiterungsplans eines Werks von integrierend auf statisch erstellt wird.","en":"A work that is created by changing the extension plan of a work from integrating to static.","es":"Una obra que se crea cambiando el plan de extensión de una obra de integradora a estática.","et":"Teos, mis on loodud, muutes teose jätkamiskava järjestikusest staatiliseks.","fi":"Teos, joka on luotu muuttamalla teoksen laajennussuunnitelmaa päivittyvästä staattiseksi.","fr":"Œuvre qui est créée en modifiant le plan d’extension intégrateur d’une œuvre en plan statique.","hu":"Egy mű, amely egy mű közlési tervének integrálóról folyamatossá való változásával jött létre.","it":"Opera creata cambiando il piano di estensione di un'opera da integrativo a statico.","lv":"Darbs, kas radīts, mainot darba paplašināšanas plānu no integrētā uz statisku.","nl":"Een werk dat gevormd is door het veranderen van een extensieplan van geïntegreerd naar statisch.","no":"Et verk som er skapt ved endring av utvidelsesplan for et verk fra integrerende til statisk.","tr":"Bir eserin genişletme planının bütünleştiriciden durağana değiştirilmesiyle oluşturulan eser.","zh-Hans-CN":"通过将一种作品的扩充计划从集成性到静态变化而被创作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
