                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/transformationOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10384", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudienceOf.en", "label":"is transformation by audience of"},{"@id":"http://rdaregistry.info/Elements/w/P10343", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByGenreOf.en", "label":"is transformation by genre of"},{"@id":"http://rdaregistry.info/Elements/w/P10345", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByPolicyOf.en", "label":"is transformation by policy of"},{"@id":"http://rdaregistry.info/Elements/w/P10341", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyleOf.en", "label":"is transformation by style of"},{"@id":"http://rdaregistry.info/Elements/w/object/P10337", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/transformationOf.en", "label":"is transformation of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10337", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/transformationOf.en", "label":"is transformation of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10077","label":{"ar":"له درجة أكاديمية","ca":"té com a títol acadèmic","cs":"má akademický titul","da":"har akademisk grad","de":"hat akademischen Grad","de":"hat akademischen Grad","el":"έχει ανώτερου εκπαιδευτικού επιπέδου πτυχίο","en":"has academic degree","es":"tiene grado académico","et":"akadeemiline kraad","fi":"akateeminen oppiarvo","fr":"a pour grade universitaire","hu":"tudományos fokozata a következő:","it":"ha come titolo accademico","lv":"akadēmiskais grāds","nl":"heeft academische graad","no":"har akademisk grad","sv":"har akademisk grad","tr":"akademik derece ile ilişkilidir","vi":"có văn bằng học thuật","zh-Hans-CN":"有学位"},"definition":{"ar":["يربط بين عمل ورتبة تمنح كضمان للكفاءة الأكاديمية."],"ca":["Relaciona una obra amb un grau concedit com a garantia d’un nivell acadèmic."],"cs":["Vztahuje dílo k titulu udělenému jako záruka akademické způsobilosti."],"da":["Relaterer et værk til en rang, som tildeles som garanti for akademisk færdighed."],"de":["Setzt ein Werk in Beziehung zu einem Rang, der als Bestätigung für wissenschaftliche Leistungen verliehen wird.,Setzt ein Werk in Beziehung zu einem Rang, der als Bestätigung für wissenschaftliche Leistungen verliehen wird."],"el":["Συνδέει ένα έργο με μια ιεραρχία που υποδηλώνεται ως η εγγύηση της ακαδημαϊκής αριστείας."],"en":["Relates a work to a rank conferred as a guarantee of academic proficiency."],"es":["Relaciona una obra con un rango conferido como una garantía de suficiencia académica."],"et":["Seostab teose auastmega, mis on antud akadeemilise pädevuse kinnituseks."],"fi":["Liittää teoksen akateemisten opintojen perusteella myönnettyyn oppiarvoon."],"fr":["Met une œuvre en relation avec un rang conféré comme garantie de compétence universitaire."],"hu":["Hozzákapcsol egy művet egy ranghoz, amelyet tudományos jártasság garanciájaként adományoznak."],"it":["Correla un'opera a un grado conferito a garanzia di competenza accademica."],"lv":["Sasaista darbu ar akadēmiskas izglītības ieguves apliecinājumu."],"nl":["Relateert een werk aan een rang verleend als een garantie van academische vakkundigheid."],"no":["Relaterer et verk til en grad tildelt som en garanti for akademisk kompetanse."],"tr":["Bir eseri, akademik yeterliliğin kanıtı olarak verilen bir dereceyle ilişkilendirir."],"vi":["Liên kết tác phẩm với thứ bậc được trao như là chứng nhận về tinh thông học thuật."],"zh-Hans-CN":["将一种作品与作为学术能力担保的一种等级关联起来。"]},"ToolkitLabel":{"ar":"درجة أكاديمية","ca":"títol acadèmic","cs":"akademický titul","da":"akademisk grad","de":"Akademischer Grad","de":"Akademischer Grad","el":"ανώτερο εκπαιδευτικού επιπέδου πτυχίο","en":"academic degree","es":"grado académico","et":"akadeemiline kraad","fi":"akateeminen oppiarvo","fr":"grade universitaire","hu":"tudományos fokozata:","it":"titolo accademico","lv":"akadēmiskais grāds","nl":"academische graad","no":"akademisk grad","sv":"akademisk grad","tr":"akademik derece","vi":"văn bằng học thuật","zh-Hans-CN":"学位"},"ToolkitDefinition":{"ar":"رتبة تمنح كضمان للكفاءة الأكاديمية.","ca":"Grau concedit com a garantia d’un nivell acadèmic.","cs":"Titul udělený jako záruka akademické způsobilosti.","da":"Rang, som tildeles som garanti for akademisk færdighed.","de":"Ein Rang, der als Bestätigung für wissenschaftliche Leistungen verliehen wird.","de":"Ein Rang, der als Bestätigung für wissenschaftliche Leistungen verliehen wird.","el":"Μια ιεραρχία που υποδηλώνεται ως η εγγύηση της ακαδημαϊκής αριστείας.","en":"A rank conferred as a guarantee of academic proficiency.","es":"Un rango conferido como una garantía de suficiencia académica.","et":"Auaste, mis on antud akadeemilise pädevuse kinnituseks.","fi":"Akateemisten opintojen perusteella myönnetty oppiarvo.","fr":"Rang conféré comme garantie de compétence universitaire.","hu":"Egy rang, amelyet tudományos jártasság garanciájaként adományoznak.","it":"Grado conferito a garanzia di competenza accademica.","lv":"Akadēmiskas izglītības ieguves apliecinājums.","nl":"Een rang verleend als een garantie van academische vakkundigheid.","no":"En grad tildelt som en garanti for akademisk kompetanse.","tr":"Akademik yeterliliğin göstergesi olarak verilen bir derece.","vi":"Thứ bậc được trao như là chứng nhận về tinh thông học thuật.","zh-Hans-CN":"作为学术能力担保的一种等级"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/academicDegree.en","instructionNumber":"7.9.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10077", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/academicDegree.en", "label":"has academic degree (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10077", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/academicDegree.en", "label":"has academic degree"}]},{"@id":"http://rdaregistry.info/Elements/w/P10124","label":{"ar":"له عمل دليل إرشادي","ca":"té com a obra de guia","cs":"má metodického průvodce","da":"har vejledningsværk","de":"hat Orientierungshilfe (Werk)","de":"hat Orientierungshilfe (Werk)","el":"είναι οδηγός (έργο)","en":"has guide work","es":"tiene obra guía","et":"käsiraamat (teos)","fi":"opas (teos)","fr":"a pour guide (œuvre)","hu":"kalauzműve a következő:","it":"ha come guida opera","lv":"palīglīdzeklis: darbs","nl":"heeft gidswerk","no":"har studieveiledning (verk)","tr":"rehber eser ile ilişkilidir","vi":"là chỉ dẫn (tác phẩm)","zh-Hans-CN":"有指南作品"},"definition":{"ar":["يربط عمل بعمل يرشد المستخدم إلى كيفية استخدام العمل السائد، باستخدام الملاحظات، ووسائل التعلم والدراسة، والتمارين، والمسائل، والأسئلة والأجوبة، ومواد المعلم أو الطلاب، إلخ."],"ca":["Relaciona una obra amb una obra que guia un usuari en l’ús d’una obra predominant, usant notes, ajudes a l’aprenentatge i l’estudi, exercicis, problemes, preguntes i respostes, materials per al professor o l’estudiant, etc."],"cs":["Vztahuje dílo k dílu, které uživatele provází používáním hlavního díla s využitím poznámek, učebních a studijních pomůcek, cvičení, problémů, otázek a odpovědí, materiály pro instruktory nebo studenty, atd."],"da":["Relater et værk til et værk, som hjælper en bruger med at anvende et fremtrædende værk vha. noter, lære- og studiehjælpemidler, øvelser, problemstillinger, spørgsmål og svar, lærer- og elevmaterialer etc."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das Benutzende durch die Verwendung von Anmerkungen, Lern- und Studienhilfen, Übungen, Problemstellungen, Fragen und Antwort oder anderen Lehr- oder Schülermaterialien durch die Nutzung eines Hauptwerks führt.,Setzt ein Werk in Beziehung zu einem Werk, das Benutzende durch die Verwendung von Anmerkungen, Lern- und Studienhilfen, Übungen, Problemstellungen, Fragen und Antwort oder anderen Lehr- oder Schültermaterialien durch die Nutzung eines Hauptwerks führt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο καθοδηγεί τον χρήστη μέσω της χρήσης ενός κύριου έργου, με τη χρήση σημειώσεων, βοηθημάτων μάθησης και μελέτης, ασκήσεων, προβλημάτων, ερωταποκρίσεων, υλικού για τον εκπαιδευτή ή τον μαθητή κ.λπ."],"en":["Relates a work to a work that guides a user through the use of a predominant work, using notes, learning and study aids, exercises, problems, questions and answers, instructor or student materials, etc."],"es":["Relaciona una obra con una obra que guía a un usuario a través del uso de una obra predominante, utilizando notas, ayudas para aprendizaje y estudio, ejercicios, problemas, preguntas y respuestas, materiales para instructores y estudiantes, etc."],"et":["Seostab teose teosega, milles juhendatakse kasutama dominantset teost märkuste, õpijuhiste, harjutuste, ülesannete, küsimuste ja vastuste, õpetaja või õpilase materjalide jms abil."],"fi":["Liittää teoksen teokseen, joka opastaa käyttäjää vallitsevan teoksen käytössä huomautusten, harjoitusten, kysymysten ja vastausten, harjoitus- tai oppimateriaalin tms. avulla."],"fr":["Met une œuvre en relation avec une œuvre qui guide un utilisateur à travers une œuvre prédominante au moyen de notes, d’outils pédagogiques, d’exercices, de problèmes, de questions et réponses, de matériel didactique, etc."],"hu":["Hozzákapcsol egy művet egy műhöz, amely a használót végigvezeti egy domináns mű használatán jegyzetek, tanulási és tanulmányi segédletek, gyakorlatok, problémák, kérdések és válaszok, oktatói vagy diákanyagok stb. felhasználásával."],"it":["Correla un’opera a un’opera che guida l’utente all’utilizzo dell’opera principale mediante l’utilizzo di note, sussidi per l’apprendimento e lo studio, esercizi, problemi, domande e risposte, materiali per l’insegnante o per gli studenti, etc."],"lv":["Sasaista darbu ar darbu – palīglīdzeklis pamatdarba lietošanai."],"nl":["Relateert een werk aan een werk dat een gebruiker geleidt door het gebruik van een hoofdwerk, met behulp van noten, leer- en studiehulpmiddelen, oefeningen, vraagstukken, vragen en antwoorden, instructie- of studentenmateriaal etc."],"no":["Relaterer et verk til et verk som veileder en bruker gjennom bruken av et mer fremtredende verk ved hjelp av noter, pedagogiske hjelpemidler, øvelser, oppgaver, spørsmål og svar, lære- eller studiemateriell, etc."],"tr":["Bir eseri, notlar, öğrenme ve çalışma araçları, alıştırmalar, problemler, sorular ve cevaplar, eğitmen veya öğrenci materyalleri vb. kullanarak bir kullanıcıya baskın bir eserin kullanımı boyunca rehberlik eden bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm chỉ dẫn người dùng qua sử dụng tác phẩm nổi trội, sử dụng ghi chú, trợ giúp học tập và nghiên cứu, bài tập, vấn đề, câu hỏi và trả lời, tài liệu giảng viên hoặc sinh viên, v.v..."],"zh-Hans-CN":["将一种作品与用注释、学习和研究工具、练习、提问、问题与答案、教师或学生参考资料等对使用者使用主要作品提供指导的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل دليل إرشادي","ca":"obra de guia","cs":"metodický průvodce","da":"vejledningsværk","de":"Orientierungshilfe (Werk)","de":"Orientierungshilfe (Werk)","el":"οδηγός (έργο)","en":"guide work","es":"obra guía","et":"käsiraamat (teos)","fi":"opas (teos)","fr":"guide (œuvre)","hu":"kalauzmű:","it":"guida opera","lv":"palīglīdzeklis: darbs","nl":"gidswerk","no":"studieveiledning (verk)","tr":"çalışma rehberi","vi":"chỉ dẫn (tác phẩm)","zh-Hans-CN":"指南作品"},"ToolkitDefinition":{"ar":"عمل يرشد المستخدم إلى كيفية استخدام العمل السائد، باستخدام الملاحظات، ووسائل التعلم والدراسة، والتمارين، والمسائل، والأسئلة والأجوبة، ومواد المعلم أو الطلاب، إلخ.","ca":"Obra que guia un usuari en l’ús d’una obra predominant, usant notes, ajudes a l’aprenentatge i l’estudi, exercicis, problemes, preguntes i respostes, materials per al professor o l’estudiant, etc.","cs":"Dílo, které uživatele provází používáním hlavního díla s využitím poznámek, učebních a studijních pomůcek, cvičení, problémů, otázek a odpovědí, materiály pro instruktory nebo studenty, atd.","da":"Værk, som hjælper en bruger med at anvende et fremtrædende værk vha. noter, lære- og studiehjælpemidler, øvelser, problemstillinger, spørgsmål og svar, lærer- og elevmaterialer etc.","de":"Ein Werk, das Benutzende durch die Verwendung von Anmerkungen, Lern- und Studienhilfen, Übungen, Problemstellungen, Fragen und Antwort oder anderen Lehr- oder Schülermaterialien durch die Nutzung eines Hauptwerks führt.","de":"Ein Werk, das Benutzende durch die Verwendung von Anmerkungen, Lern- und Studienhilfen, Übungen, Problemstellungen, Fragen und Antwort oder anderen Lehr- oder Schültermaterialien durch die Nutzung eines Hauptwerks führt.","el":"Ένα έργο το οποίο καθοδηγεί τον χρήστη μέσω της χρήσης ενός κύριου έργου με τη χρήση σημειώσεων, βοηθημάτων μάθησης και μελέτης, ασκήσεων, προβλημάτων, ερωταποκρίσεων, υλικού για τον εκπαιδευτή ή τον μαθητή κ.λπ.","en":"A work that guides a user through the use of a predominant work, using notes, learning and study aids, exercises, problems, questions and answers, instructor or student materials, etc.","es":"Una obra que guía a un usuario a través del uso de una obra predominante, utilizando notas, ayudas para aprendizaje y estudio, ejercicios, problemas, preguntas y respuestas, materiales para instructores y estudiantes, etc.","et":"Teos, milles juhendatakse kasutama dominantset teost märkuste, õpijuhiste, harjutuste, ülesannete, küsimuste ja vastuste, õpetaja või õpilase materjalide jms abil.","fi":"Teos, joka opastaa käyttäjää vallitsevan teoksen käytössä huomautusten, harjoitusten, kysymysten ja vastausten, harjoitus- tai oppimateriaalin tms. avulla.","fr":"Œuvre qui guide un utilisateur à travers une œuvre prédominante au moyen de notes, d’outils pédagogiques, d’exercices, de problèmes, de questions et réponses, de matériel didactique, etc.","hu":"Egy mű, amely a használót végigvezeti egy domináns mű használatán jegyzetek, tanulási és tanulmányi segédletek, gyakorlatok, problémák, kérdések és válaszok, oktatói vagy diákanyagok stb. felhasználásával.","it":"Opera che guida l’utente all’utilizzo dell’opera principale mediante l’utilizzo di note, sussidi per l’apprendimento e lo studio, esercizi, problemi, domande e risposte, materiali per l’insegnante o per gli studenti, etc","lv":"Darbs – palīglīdzeklis pamatdarba lietošanai.","nl":"Een werk dat een gebruiker geleidt door het gebruik van een hoofdwerk, met behulp van noten, leer- en studiehulpmiddelen, oefeningen, vraagstukken, vragen en antwoorden, instructie- of studentenmateriaal etc.","no":"Et verk som veileder en bruker gjennom bruken av et mer fremtredende verk ved hjelp av noter, pedagogiske hjelpemidler, øvelser, oppgaver, spørsmål og svar, lære- eller studiemateriell, etc.","tr":"Bir ana eserin kullanımını kullanıcıya rehberlik eden bir eser; notlar, öğrenme ve çalışma yardımları, alıştırmalar, problemler, sorular ve cevaplar, öğretmen veya öğrenci materyalleri gibi öğeler kullanır.","vi":"Tác phẩm chỉ dẫn người dùng qua sử dụng tác phẩm nổi trội, sử dụng ghi chú, trợ giúp học tập và nghiên cứu, bài tập, vấn đề, câu hỏi và trả lời, tài liệu giảng viên hoặc sinh viên, v.v...","zh-Hans-CN":"用注释、学习和研究工具、练习、提问、问题与答案、教师或学生参考资料等对使用者使用主要作品提供指导的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en", "label":"is augmented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/guideWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10124", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/guideWork.en", "label":"has guide work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10124", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/guideWork.en", "label":"has guide work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10001","label":{"ar":"له مبحوث/ مستجيب","ca":"té com a respondens","cs":"má předkladatele nebo oponenta","da":"har respondent","de":"hat Respondentin/Respondent","de":"hat Respondentin/Respondent","el":"έχει συμμετέχοντα","en":"has respondent","es":"tiene sustentante","et":"respondens","fi":"respondentti","fr":"a pour répondant","hu":"válaszadója a következő:","it":"ha come candidato","lv":"akadēmiskā disputa respondents","nl":"heeft respondent","no":"har respondent","tr":"tez yazarı ile ilişkilidir","vi":"có thí sinh","zh-Hans-CN":"有答辩人"},"definition":{"ar":["يربط بين عمل وشخص مرشح للحصول على درجة علمية يدافع عن أطروحة مقدمة من رؤساء جلسة علمية في مناظرة أكاديمية أو يعارضها."],"ca":["Relaciona una obra amb una persona que és un candidat a un grau que defensa o s’oposa a una tesi proposada pel praeses en una disputa acadèmica."],"cs":["Vztahuje dílo k osobě, která je kandidátem na titul a v akademické disputaci obhajuje diplomovou práci nebo je oponentem diplomové práce, kterou poskytl předsedající disputace."],"da":["Relaterer et værk til en person, som er kandidat til en akademisk grad, som forsvarer eller opponerer mod en tese, som er fremsat af præses i et akademisk afhandlingsforsvar."],"de":["Setzt ein Werk in Beziehung zu einer Kandidatin/einem Kandidaten (Person) für einen akademischen Grad, die/der eine These, die vom Praeses in einer akademischen Disputation aufgestellt wird, verteidigt oder ablehnt.,Setzt ein Werk in Beziehung zu einer Kandidatin/einem Kandidaten (Person) für einen akademischen Grad, die/der eine These, die vom Praeses in einer akademischen Disputation aufgestellt wird, verteidigt oder ablehnt."],"el":["Συνδέει ένα έργο με έναν υποψήφιο διδάκτορα για ένα πτυχίο που επιχειρηματολογεί υπέρ ή κατά μιας θέσης που παρέχεται από τον επόπτη σε μια διατριβή."],"en":["Relates a work to a person who is a candidate for a degree who defends or opposes a thesis provided by the praeses in an academic disputation."],"es":["Relaciona una obra con una persona que es candidata a un grado que defiende u opone una tesis provista por el presidente en un examen profesional académico."],"et":["Seostab teose kraadi taotleva isikuga, kes akadeemilises väitluses kaitseb või oponeerib praeses'e esitletud teese."],"fi":["Liittää teoksen henkilöön, joka on oppiarvoa tavoitteleva kandidaatti, joka akateemisessa väitöstilaisuudessa puolustaa tai opponoi preeseksen esittelemää väitöskirjaa."],"fr":["Met une œuvre en relation avec une personne candidate à un grade universitaire qui défend ou réfute une thèse proposée par le praeses lors d’une disputation académique."],"hu":["Hozzákapcsol egy művet egy személyhez, aki az elnök által előterjesztett értekezést megvédi vagy opponálja egy tudományos vitában."],"it":["Correla un'opera a una persona candidata al conseguimento di un titolo accademico, che difende o si oppone a una tesi proposta dal relatore nell'ambito di una disputa accademica."],"lv":["Sasaista darbu ar personu, kura ir kandidāts grāda iegūšanai, kurš aizstāv vai oponē akadēmiskā disputa vadītāja piedāvātajām tēzēm."],"nl":["Relateert een werk aan een persoon die een kandidaat is voor een graad die een stelling verstrekt door de preses in een academische disputatie weerlegt of verdedigt."],"no":["Relaterer et verk til en person som er en kandidat for en grad, som forsvarer eller bestrider en avhandling levert av preses i en akademisk disputas."],"tr":["Bir eseri, danışmanlar tarafından ortaya konan akademik bir tartışmada bir tezi savunan veya karşı çıkan bir mezun adayı olan kişiyle ilişkilendirir."],"vi":["Liên kết tác phẩm với ứng viên của học vị, người bảo vệ hoặc dự thi một luận văn do hội đồng tổ chức trong cuộc tranh luận học thuật"],"zh-Hans-CN":["将一种作品与作为学位候选人对在学位答辩中评审人提供的一个论题提出支持或反对的一个个人关联起来。"]},"ToolkitLabel":{"ar":"مستجيب","ca":"respondens","cs":"předkladatel nebo oponent","da":"respondent","de":"Respondentin/Respondent","de":"Respondentin/Respondent","el":"συμμετέχων","en":"respondent","es":"sustentante","et":"respondens","fi":"respondentti","fr":"répondant","hu":"válaszadó:","it":"candidato","lv":"akadēmiskā disputa respondents","nl":"respondent","no":"respondent","tr":"tez savunan kişi","vi":"thí sinh","zh-Hans-CN":"答辩人"},"ToolkitDefinition":{"ar":"شخص مرشح للحصول على درجة علمية يدافع عن أطروحة مقدمة من رؤساء جلسة علمية في مناظرة أكاديمية أو يعارضها.","ca":"Persona que és un candidat a un grau que defensa o s’oposa a una tesi proposada pel praeses en una disputa acadèmica.","cs":"Osoba, která je kandidátem na titul a v akademické disputaci obhajuje diplomovou práci nebo je oponentem diplomové práce, kterou poskytl předsedající disputace.","da":"Person, som er kandidat til en akademisk grad, som forsvarer eller opponerer mod en tese, som er fremsat af præses i et akademisk afhandlingsforsvar.","de":"Eine Kandidatin/Ein Kandidat für einen akademischen Grad, die/der eine These, die vom Praeses in einer akademischen Disputation aufgestellt wird, verteidigt oder ablehnt.","de":"Eine Kandidatin/Ein Kandidat für einen akademischen Grad, die/der eine These, die vom Praeses in einer akademischen Disputation aufgestellt wird, verteidigt oder ablehnt.","el":"Ένας υποψήφιος διδάκτορας για ένα πτυχίο που επιχειρηματολογεί υπέρ ή κατά μιας θέσης που παρέχεται από τον επόπτη σε μια διατριβή.","en":"A person who is a candidate for a degree who defends or opposes a thesis provided by the praeses in an academic disputation.","es":"Una persona que es candidata a un grado que defiende u opone una tesis provista por el presidente en un examen profesional académico.","et":"Kraadi taotlev isik, kes akadeemilises väitluses kaitseb või oponeerib praeses'e esitletud teese.","fi":"Henkilö, joka on oppiarvoa tavoiteleva kandidaatti, joka akateemisessa väitöstilaisuudessa puolustaa tai opponoi preeseksen esittelemää väitöskirjaa.","fr":"Personne candidate à un grade universitaire qui défend ou réfute une thèse proposée par le praeses lors d’une disputation académique.","hu":"Egy személy, aki az elnök által előterjesztett értekezést megvédi vagy opponálja egy tudományos vitában.","it":"Persona candidata al conseguimento di un titolo accademico, che difende o si oppone a una tesi proposta dal relatore nell'ambito di una disputa accademica.","lv":"Kandidāts grāda iegūšanai, kurš aizstāv vai oponē akadēmiskā disputa vadītāja piedāvātajām tēzēm.","nl":"Een persoon die een kandidaat is voor een graad die een stelling verstrekt door de preses in een academische disputatie weerlegt of verdedigt.","no":"En person som er en kandidat for en grad, som forsvarer eller bestrider en avhandling levert av preses i en akademisk disputas.","tr":"Akademik bir tartışmada danışmanlar tarafından ortaya konan bir tezi savunan veya karşı çıkan bir derece adayı olan kişi.","vi":"Ứng viên của học vị, người bảo vệ hoặc dự thi một luận văn do hội đồng tổ chức trong cuộc tranh luận học thuật","zh-Hans-CN":"作为学位候选人对在学位答辩中评审人提供的一个论题提出支持或反对的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/respondent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10001", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/respondent.en", "label":"has respondent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10001", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/respondent.en", "label":"has respondent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10332","label":{"ar":"له نقطة وصول متغيرة لعمل","ca":"té com a variant de punt d’accés d’obra","cs":"má variantní selekční údaj pro dílo","da":"har variant af søgeindgang for værk","de":"hat zusätzlichen Sucheinstieg für ein Werk","de":"hat zusätzlichen Sucheinstieg für ein Werk","en":"has variant access point for work","es":"tiene un punto de acceso variante para la obra","et":"teose otsielemendi variant","fi":"teoksen varianttihakutieto","fr":"a pour variante de point d’accès d’une œuvre","hu":"mű hozzáférésipont-változata a következő:","it":"ha come punto d'accesso variante per opera","lv":"darba papildforma","nl":"heeft variant ingang voor werk","no":"har alternativ søkeinngang for verk","tr":"eser için alternatif erişim noktası ile ilişkilidir","zh-Hans-CN":"有作品的变异检索点"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن نقطة وصول لعمل لم يتم اختيارها بتفضيل استخدامها في خطة ترميز مفردات معينة."],"ca":["Relaciona una obra amb un nomen que és un punt d’accés d’obra que no se selecciona com a preferent en un esquema de codificació de vocabulari específic."],"cs":["Vztahuje dílo k nomen, které je selekčním údajem díla a které nebylo zvoleno jako preferované v určitém řízeném slovníku."],"da":["Relaterer et værk til en søgeindgang for værk, som ikke er valgt som præference i et specifikt vokabularkodningsskema."],"de":["Setzt ein Werk in Beziehung zu einem Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme nicht als Vorzugsform bestimmt wird.,Setzt ein Werk in Beziehung zu einem Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme nicht als Vorzugsform bestimmt wird."],"en":["Relates a work to a nomen that is an access point of work that is not selected for preference in a specific vocabulary encoding scheme."],"es":["Relaciona una obra con un nomen que es un punto de acceso a la obra que no está seleccionado de preferencia en un esquema de codificación de vocabulario específico."],"et":["Seostab teose teose otsielemendiga, mis ei ole valitud eelistatuks vastavas leksikaalses märkimissüsteemis."],"fi":["Liittää teoksen nomeniin, joka on teoksen hakutieto, jota ei ole valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä."],"fr":["Met une œuvre en relation avec un nomen qui est un point d’accès d’une œuvre ne faisant pas l’objet d’un choix privilégié dans un schéma d’encodage de vocabulaire spécifique."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy olyan hozzáférési ponthoz mű számára, amelyet egy adott szótárkódolási sémában nem részesítenek előnyben."],"it":["Correla un’opera a un punto d’accesso per l’opera che non è selezionato come preferito in uno specifico schema di codifica di vocabolario."],"lv":["Sasaista darbu ar nomenu, kas ir piekļuves punkts darbam, kas nav izvēlēts kā prioritārs noteiktai kontrolētas vārdnīcas shēmai."],"nl":["Relateert een werk aan een nomen dat is een ingang voor werk die niet bij voorkeur geselecteerd is in een specifiek vocabulair coderingssysteem."],"no":["Relaterer et verk til en søkeinngang for verk som ikke er valgt som preferanse i et bestemt kodeskjema for vokabular."],"tr":["Bir eseri, belirli bir kelime kodlama şemasında tercih için seçilmemiş bir eser erişim noktası olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一种作品的检索点、并没有在一个特定的词表编码体系中被优先选用的一个命名关联起来。"]},"ToolkitLabel":{"ar":"نقطة وصول متغيرة لعمل","ca":"variant de punt d’accés d’obra","cs":"variantní selekční údaj pro dílo","da":"variant af søgeindgang for værk","de":"Zusätzlicher Sucheinstieg für ein Werk","de":"Zusätzlicher Sucheinstieg für ein Werk","en":"variant access point for work","es":"punto de acceso variante para la obra","et":"teose otsielemendi variant","fi":"teoksen varianttihakutieto","fr":"variante de point d’accès d’une œuvre","hu":"mű hozzáférésipont-változata:","it":"punto d'accesso variante per opera","lv":"darba papildforma","nl":"variant ingang voor werk","no":"alternativ søkeinngang for verk","tr":"eser için alternatif erişim noktası","zh-Hans-CN":"作品的变异检索点"},"ToolkitDefinition":{"ar":"تسمية عبارة عن نقطة وصول لعمل لم يتم اختيارها بتفضيل استخدامها في خطة ترميز مفردات معينة.","ca":"Nomen que és un punt d’accés d’obra que no se selecciona com a preferent en un esquema de codificació de vocabulari específic.","cs":"Nomen, které je selekčním údajem díla a které nebylo zvoleno jako preferované v určitém řízeném slovníku.","da":"Søgeindgang for værk, som ikke er valgt som præference i et specifikt vokabularkodningsskema.","de":"Ein Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme nicht als Vorzugsform bestimmt wird.","de":"Ein Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme nicht als Vorzugsform bestimmt wird.","en":"A nomen that is an access point of work that is not selected for preference in a specific vocabulary encoding scheme.","es":"Un nomen que es un punto de acceso a la obra que no está seleccionado de preferencia en un esquema de codificación de vocabulario específico.","et":"Teose otsielement, mis ei ole valitud eelistatuks vastavas leksikaalses märkimissüsteemis.","fi":"Nomen, joka on teoksen hakutieto, jota ei ole valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä.","fr":"Nomen qui est un point d’accès d’une œuvre ne faisant pas l’objet d’un choix privilégié dans un schéma d’encodage de vocabulaire spécifique.","hu":"Egy nomen, egy olyan hozzáférési pont mű számára, amelyet egy adott szótárkódolási sémában nem részesítenek előnyben.","it":"Punto d’accesso per l’opera che non è selezionato come preferito in uno specifico schema di codifica di vocabolario.","lv":"Piekļuves punkts darbam, kas nav izvēlēts kā prioritārs noteiktai kontrolētas vārdnīcas shēmai.","nl":"Een nomen dat is een ingang voor werk die niet bij voorkeur geselecteerd is in een specifiek vocabulair coderingssysteem.","no":"En søkeinngang for verk som ikke er valgt som preferanse i et bestemt kodeskjema for vokabular.","tr":"Belirli bir kelime kodlama şemasında tercih için seçilmemiş bir eserin erişim noktası olan isim.","zh-Hans-CN":"作为一种作品的检索点、并没有在一个特定的词表编码体系中被优先选用的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
