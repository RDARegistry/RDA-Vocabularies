                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/keyTitle.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10088", "lexicalAlias":"http://rdaregistry.info/Elements/w/titleOfWork.en", "label":"has title of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10367", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/keyTitle.en", "label":"has key title"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10367", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/keyTitle.en", "label":"has key title"}]},{"@id":"http://rdaregistry.info/Elements/w/P10281","label":{"ar":"هو نقد لتعبيرة","ca":"és crítica d’una expressió","cs":"je kritikou vyjádření","da":"er kritik af udtryk","de":"ist Kritik von (Expression)","de":"ist Kritik von (Expression)","el":"είναι κρίση της (έκφραση)","en":"is critique of expression","es":"es crítica de la expresión","et":"arvustatud väljendus","fi":"kritiikki ekspressiosta","fr":"est une critique d’une expression","hu":"bírálata a következő kifejezési formának:","it":"è critica di espressione","lv":"ir kritika izteiksmei","nl":"is kritiek van expressie","no":"er kritikk av uttrykk","tr":"anlatımın eleştirisidir","vi":"là phê bình của (biểu hiện)","zh-Hans-CN":"是内容表达的批评"},"definition":{"ar":["يربط بين عمل وتعبيرة تستخدم كأساس لتقييم نقدي."],"ca":["Relaciona una obra amb una expressió que és avaluada críticament per una obra."],"cs":["Vztahuje dílo k vyjádření, které je kriticky hodnoceno v díle."],"da":["Relaterer et værk til et udtryk, som anvendes som grundlag for en kritisk evaluering."],"de":["Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine kritische Untersuchung verwendet wird.,Setzt eine Expression in Beziehung zu einem Werk, bei dem es sich um eine kritische Untersuchung einer Expression handelt."],"el":["Συνδέει ένα έργο με μια έκφραση που χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση."],"en":["Relates a work to an expression that is critically evaluated by a work."],"es":["Relaciona una obra con una expresión que es evaluada críticamente por una obra."],"et":["Seostab teose väljendusega, mis on aluseks kriitilisele hinnangule."],"fi":["Liittää teoksen ekspressioon, johon kriittinen arviointi perustuu."],"fr":["Met une œuvre en relation avec une expression qui fait l’objet d’une évaluation critique par une œuvre."],"hu":["Hozzákapcsol egy művet egy kifejezési formához, amelyet egy mű által kritikailag kiértékelnek.."],"it":["Correla un'opera a un'espressione usata come base per una valutazione critica."],"lv":["Sasaista darbu ar izteiksmi, kas izmantota par pamatu kritikai."],"nl":["Relateert een werk aan een expressie die kritisch geëvalueerd wordt door een werk."],"no":["Relaterer et verk til et uttrykk brukt som utgangspunkt for en kritisk evaluering."],"tr":["Bir eseri, bir eser tarafından eleştirel olarak değerlendirilen bir anlatımla ilişkilendirir."],"vi":["Liên kết tác phẩm với biểu thị được dùng như là cơ sở cho đánh giá phê bình."],"zh-Hans-CN":["将一种作品与被一种作品批评性评价的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"نقد لتعبيرة","ca":"crítica d’una expressió","cs":"kritika vyjádření","da":"kritik af udtryk","de":"Kritik von (Expression)","de":"Kritik von (Expression)","el":"κρίση της (έκφραση)","en":"critique of expression","es":"crítica de la expresión","et":"arvustatud väljendus","fi":"kritiikki ekspressiosta","fr":"critique d’une expression","hu":"bírált kifejezési forma","it":"critica di espressione","lv":"kritika izteiksmei","nl":"kritiek van expressie","no":"kritikk av uttrykk","tr":"anlatımın eleştirisi","vi":"phê bình của (biểu hiện)","zh-Hans-CN":"内容表达的批评"},"ToolkitDefinition":{"ar":"تعبيرة تستخدم كأساس لتقييم نقدي.","ca":"Expressió que és avaluada críticament per una obra.","cs":"Vyjádření, které je kriticky hodnoceno v díle.","da":"Udtryk, som anvendes som grundlag for en kritisk evaluering.","de":"Eine Expression, die als Grundlage für eine kritische Untersuchung verwendet wird.","de":"Eine Expression, die von einem Werk beschrieben wird.","el":"Μια έκφραση που χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση.","en":"An expression that is critically evaluated by a work.","es":"Una expresión que es evaluada críticamente por una obra.","et":"Väljendus, mis on aluseks kriitilisele hinnangule.","fi":"Ekspressio, johon kriittinen arviointi perustuu.","fr":"Expression qui fait l’objet d’une évaluation critique par une œuvre.","hu":"Egy kifejezési forma, amelyet egy mű által kritikailag kiértékelnek..","it":"Espressione usata come base per una valutazione critica.","lv":"Izteiksme, kas izmantota par pamatu kritikai.","nl":"Een expressie die kritisch geëvalueerd wordt door een werk.","no":"Et uttrykk brukt som utgangspunkt for en kritisk evaluering.","tr":"Bir eser tarafından eleştirel olarak değerlendirilen bir anlatım.","vi":"Biểu thị được dùng như là cơ sở cho đánh giá phê bình.","zh-Hans-CN":"被一种作品批评性评价的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
