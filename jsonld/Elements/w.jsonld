                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10344", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByPolicy.en", "label":"has transformation by policy"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10195", "lexicalAlias":"http://rdaregistry.info/Elements/w/prequelTo.en", "label":"is prequel to (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10191", "lexicalAlias":"http://rdaregistry.info/Elements/w/continuedByWork.en", "label":"is continued by work"},{"@id":"http://rdaregistry.info/Elements/w/P10145", "lexicalAlias":"http://rdaregistry.info/Elements/w/absorbedByWork.en", "label":"is absorbed by work"},{"@id":"http://rdaregistry.info/Elements/w/P10146", "lexicalAlias":"http://rdaregistry.info/Elements/w/absorbedInPartByWork.en", "label":"is absorbed in part by work"},{"@id":"http://rdaregistry.info/Elements/w/P10022", "lexicalAlias":"http://rdaregistry.info/Elements/w/replacedByWork.en", "label":"is replaced by work"},{"@id":"http://rdaregistry.info/Elements/w/P10211", "lexicalAlias":"http://rdaregistry.info/Elements/w/splitIntoWork.en", "label":"is split into work"},{"@id":"http://rdaregistry.info/Elements/w/P10021", "lexicalAlias":"http://rdaregistry.info/Elements/w/replacedInPartByWork.en", "label":"is replaced in part by work"},{"@id":"http://rdaregistry.info/Elements/w/P10212", "lexicalAlias":"http://rdaregistry.info/Elements/w/mergedToFormWork.en", "label":"is merged to form work"},{"@id":"http://rdaregistry.info/Elements/w/P10104", "lexicalAlias":"http://rdaregistry.info/Elements/w/separatedIntoWork.en", "label":"is separated into work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/succeededByWork.en", "label":"is succeeded by work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/succeededByWork.en", "label":"is succeeded by work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10191","label":{"ar":"هو مستمر عن طريق عمل","ca":"és continuat per una obra","cs":"navazuje dílo","da":"er fortsat af værk","de":"ist fortgesetzt durch (Werk)","de":"ist fortgesetzt durch (Werk)","el":"συνεχίζεται από (έργο)","en":"is continued by work","es":"es continuado por la obra","et":"jätkub teosena","fi":"seuraaja (teos)","fr":"est continué par une œuvre","hu":"folytatja a következő mű:","it":"è continuata da opera","lv":"ir turpinājumdarbs","nl":"is voortgezet door werk","no":"er fortsatt i verk","tr":"eser ile devam ettirilmiştir","vi":"được tiếp tục bằng (tác phẩm)","zh-Hans-CN":"被作品继承"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل ممتد زمنيًا ومستمر في محتوى عمل آخر ممتد زمنيًا ومكتمل."],"ca":["Relaciona una obra amb una obra que és una obra diacrònica que continua el contingut d’una altra obra diacrònica completa."],"cs":["Vztahuje dílo k dílu, které je diachronním dílem, které je pokračováním obsahu jiného diachronního díla, které bylo ukončeno."],"da":["Relaterer et værk til et værk, som er et diakronisk værk, som fortsætter indholdet af et andet diakronisk værk, som er fuldstændigt."],"de":["Setzt ein Werk in Beziehung zu einem diachronen Werk, das den Inhalt eines anderen abgeschlossenen diachronen Werks fortführt.,Setzt ein Werk in Beziehung zu einem diachronen Werk, das den Inhalt eines anderen abgeschlossenen diachronen Werks fortführt."],"el":["Συνδέει ένα έργο με ένα έργο του οποίου το περιεχόμενο συνεχίζει ένα προηγούμενο έργο."],"en":["Relates a work to a work that is a diachronic work that continues the content of another diachronic work that is completed."],"es":["Relaciona una obra con una obra que es una obra diacrónica que continúa el contenido de otra obra diacrónica que está completa."],"et":["Seostab teose diakroonilise teosega, mis jätkab teise, lõpetatud diakroonilise teose sisu."],"fi":["Liittää teoksen teokseen, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen sisältöä."],"fr":["Met une œuvre en relation avec une œuvre diachronique qui continue le contenu d’une autre œuvre diachronique qui est terminée."],"hu":["Hozzákapcsol egy művet egy diakronikus műhöz, amely egy másik, befejezett diakronikus mű tartalmát folytatja."],"it":["Correla un’opera a un’opera diacronica che continua il contenuto di un’altra opera diacronica completa."],"lv":["Sasaista darbu ar darbu, kas ir diahronisks darbs, kas turpina cita pabeigta diahroniska darba saturu."],"nl":["Relateert een werk aan een werk dat een diachronisch werk is dat de content voortzet van een ander diachronisch werk dat is afgesloten."],"no":["Relaterer et verk til et verk som er et diakronisk verk som fortsetter innholdet av et annet diakronisk verk som er komplett."],"tr":["Bir eseri, tamamlanmış başka bir artzamanlı eserin içeriğini devam ettiren artzamanlı bir eser olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mà nội dung của nó tiếp tục tác phẩm trước đây."],"zh-Hans-CN":["将一种作品与作为一种历时作品并继承另一种已经完成了的历时作品的内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مستمر عن طريق عمل","ca":"continuat per una obra","cs":"navazuje dílo","da":"fortsat af værk","de":"Fortgesetzt durch (Werk)","de":"Fortgesetzt durch (Werk)","el":"συνεχίζεται από (έργο)","en":"continued by work","es":"continuado por la obra","et":"jätkub teosena","fi":"seuraaja (teos)","fr":"continué par une œuvre","hu":"folytató mű","it":"continuata da opera","lv":"turpinājumdarbs","nl":"voortgezet door werk","no":"fortsettes i verk","tr":"eser ile devam edilir","vi":"được tiếp tục bằng (tác phẩm)","zh-Hans-CN":"被作品继承"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل ممتد زمنيًا ومستمر في محتوى عمل آخر ممتد زمنيًا ومكتمل.","ca":"Obra que és una obra diacrònica que continua el contingut d’una altra obra diacrònica completa.","cs":"Dílo, které je diachronním dílem, které je pokračováním obsahu jiného diachronního díla, které bylo ukončeno.","da":"Værk, som er et diakronisk værk, som fortsætter indholdet af et andet diakronisk værk, som er fuldstændigt.","de":"Ein diachrones Werk, das den Inhalt eines anderen abgeschlossenen diachronen Werks fortführt.","de":"Ein diachrones Werk, das den Inhalt eines anderen abgeschlossenen diachronen Werks fortführt.","el":"Ένα έργο του οποίου το περιεχόμενο συνεχίζει ένα προηγούμενο έργο.","en":"A work that is a diachronic work that continues the content of another diachronic work that is completed.","es":"Una obra que es una obra diacrónica que continúa el contenido de otra obra diacrónica que está completa.","et":"Diakrooniline teos, mis jätkab teise, lõpetatud diakroonilise teose sisu.","fi":"Teos, joka on diakroninen teos, joka jatkaa toisen, valmiin diakronisen teoksen sisältöä.","fr":"Œuvre diachronique qui continue le contenu d’une autre œuvre diachronique qui est terminée.","hu":"Egy mű, amely egy másik, befejezett diakronikus mű tartalmát folytatja.","it":"Opera diacronica che continua il contenuto di un’altra opera diacronica completa.","lv":"Darbs, kas ir diahronisks darbs, kas turpina cita pabeigta diahroniska darba saturu.","nl":"Een werk dat een diachronisch werk is dat de content voortzet van een ander diachronisch werk dat is afgesloten.","no":"Et verk som er et diakronisk verk som fortsetter innholdet av et annet diakronisk verk som er komplett.","tr":"Tamamlanmış başka bir artzamanlı eserin içeriğini devam ettiren artzamanlı eser olan bir eser.","vi":"Tác phẩm mà nội dung của nó tiếp tục tác phẩm trước đây.","zh-Hans-CN":"作为一种历时作品并继承另一种已经完成了的历时作品的内容的一种作品"},"note":{"ar":["هذا العنصر ينطبق عامة على عمل متتالٍ."],"ca":["En general, aquest element s’aplica a una obra successiva."],"cs":["Tento prvek se obecně vztahuje na postupně vydávané dílo."],"da":["Dette element gælder generelt for et fortløbende værk."],"de":["Im Allgemeinen trifft dieses Element auf ein sukzessives Werk zu.,Im Allgemeinen trifft dieses Element auf ein sukzessives Werk zu."],"el":["Αυτή η σχέση βρίσκει γενική εφαρμογή στα περιοδικά."],"en":["This element applies in general to a successive work."],"es":["Este elemento se aplica en general a una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvään teokseen."],"fr":["Cet élément s’applique généralement à une œuvre successive."],"hu":["Ez az elem általában a folyamatos művekre vonatkozik."],"it":["Generalmente questo elemento si applica a un'opera successiva."],"lv":["Šis elements parasti attiecas uz secīgā darba izteiksmi."],"nl":["Dit element is over het algemeen van toepassing op een successief werk."],"no":["Dette elementet gjelder som oftest for et påfølgende verk."],"tr":["Bu öğe, genel olarak ardşık bir eser için geçerlidir."],"vi":["Mối quan hệ này áp dụng tổng quát cho ấn phẩm nhiều kỳ."],"zh-Hans-CN":["该元素一般适用于一种相继作品。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en", "label":"is succeeded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/continuedByWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10191", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/continuedByWork.en", "label":"is continued by work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10191", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/continuedByWork.en", "label":"is continued by work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10103","label":{"ar":"هو متمم بعمل","ca":"és complementat per una obra","cs":"je doplněno dílem","da":"er komplementeret af værk","de":"ist vervollständigt durch (Werk)","de":"ist vervollständigt durch (Werk)","el":"είναι συμπληρωμένο από (έργο)","en":"is complemented by work","es":"es complementada por obra","et":"täiendatud teosega","fi":"täydentävä teos","fr":"est complété par une œuvre","hu":"kiegészíti a következő mű:","it":"è completata a opera","lv":"ir kopā ar darbu","nl":"is gecomplementeerd door werk","no":"er utfylt av verk","tr":"eser ile tamamlanmıştır","vi":"được bổ sung bởi (tác phẩm)","zh-Hans-CN":"被一种作品补充"},"definition":{"ar":["يربط عمل بعمل مقترن بعمل ذي صلة دون اعتبار أحدهما كعمل سائد."],"ca":["Relaciona una obra amb una obra que està aparellada amb una obra relacionada sense que cap es consideri predominant."],"cs":["Vztahuje dílo k dílu, které je spojeno s hlavním dílem, aniž by některé z děl bylo považováno za hlavní."],"da":["Relaterer et værk til et værk, som er parret med et relateret værk, uden at ét af værkerne betragtes som det fremtrædende."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das mit einem in Beziehung stehenden Werk zusammengebracht wird, ohne dass eines der beiden als Hauptwerk angesehen wird.,Setzt ein Werk in Beziehung zu einem Werk, das mit einem in Beziehung stehenden Werk zusammengebracht wird, ohne dass eines der beiden als Hauptwerk angesehen wird."],"el":["Συνδέει ένα έργο με ένα έργο, συνταιριασμένο με ένα άλλο έργο, χωρίς κάποιο από τα δύο έργα να θεωρείται ότι δεσπόζει."],"en":["Relates a work to a work that is paired with a related work without either work being considered to be predominant."],"es":["Relaciona una obra con una obra que es emparejada con una obra relacionada sin que alguna de las obras sea considerada predominante."],"et":["Seostab teose teosega, mis on paaristatud seotud teosega, ilma et kumbagi teost peetaks dominantseks."],"fi":["Liittää teoksen teokseen, joka on yhdistetty siihen liittyvään teokseen ilman, että kumpaakaan teosta pidetään ensisijaisena."],"fr":["Met une œuvre en relation avec une œuvre qui est jumelée à une œuvre en relation sans qu’aucune des deux œuvres ne soit considérée comme prédominante."],"hu":["Hozzákapcsol egy művet egy kapcsolódó művel párosított műhöz, anélkül, hogy bármelyiket dominánsnak kellene tekinteni."],"it":["Correla un’opera a un’opera presentata insieme a un’opera correlata senza che nessuna delle due venga presentata come principale."],"lv":["Sasaista darbu ar darbu saistīts ar citu darbu, kur neviens no darbiem nav uzskatāms par dominējošu."],"nl":["Relateert een werk aan een werk dat een paar vormt met een gerelateerd werk zonder dat één van de werken als voornaamste gezien wordt."],"no":["Relaterer et verk til et verk som er kombinert med annet verk uten at ett av verkene dominerer."],"tr":["Bir eseri, her iki çalışma da baskın olarak kabul edilmeksizin ilgili bir eserle eşleştirilen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm cặp đôi với tác phẩm khác mà không có tác phẩm nào được xem là nổi trội."],"zh-Hans-CN":["将一种作品与和一种相关作品配对而两者都不被认为占主导地位的一种作品关联起来。"]},"ToolkitLabel":{"ar":"متمم بعمل","ca":"complementat per una obra","cs":"doplněno dílem","da":"komplementeret af værk","de":"Vervollständigt durch (Werk)","de":"Vervollständigt durch (Werk)","el":"συμπληρωμένο από (έργο)","en":"complemented by work","es":"complementada por obra","et":"täiendatud teosega","fi":"täydentävä teos","fr":"complété par une œuvre","hu":"kiegészítésmű:","it":"completata a opera","lv":"kopā ar darbu","nl":"gecomplementeerd door werk","no":"utfylt av verk","tr":"eserle tamamlanır","vi":"được bổ sung bởi (tác phẩm)","zh-Hans-CN":"被一种作品补充"},"ToolkitDefinition":{"ar":"عمل مقترن بعمل ذي صلة دون اعتبار أحدهما كعمل سائد.","ca":"Obra que està aparellada amb una obra relacionada sense que cap es consideri predominant.","cs":"Dílo, které je spojeno s hlavním dílem, aniž by některé z děl bylo považováno za hlavní.","da":"Værk, som er parret med et relateret værk, uden at ét af værkerne betragtes som det fremtrædende.","de":"Ein Werk, das mit einem in Beziehung stehenden Werk zusammengebracht wird, ohne dass eines der beiden als Hauptwerk angesehen wird.","de":"Ein Werk, das mit einem in Beziehung stehenden Werk zusammengebracht wird, ohne dass eines der beiden als Hauptwerk angesehen wird.","el":"Ένα έργο, συνταιριασμένο με ένα άλλο έργο, χωρίς κάποιο από τα δύο έργα να θεωρείται ότι δεσπόζει.","en":"A work that is paired with a related work without either work being considered to be predominant.","es":"Una obra que es emparejada con una obra relacionada sin que alguna de las obras sea considerada predominante.","et":"Teos, mis on paaristatud seotud teosega, ilma et kumbagi teost peetaks dominantseks.","fi":"Teos, joka on yhdistetty siihen liittyvään teokseen ilman, että kumpaakaan teosta pidetään ensisijaisena.","fr":"Œuvre qui est jumelée à une œuvre en relation sans qu’aucune des deux œuvres ne soit considérée comme prédominante.","hu":"Egy kapcsolódó művel anélkül párosított mű, hogy bármelyiket dominánsnak kellene tekinteni.","it":"Opera presentata insieme a un’opera correlata senza che nessuna delle due venga presentata come principale.","lv":"Darbs saistīts ar citu darbu, kur neviens no darbiem nav uzskatāms par dominējošu.","nl":"Een werk dat een paar vormt met een gerelateerd werk zonder dat één van de werken als voornaamste gezien wordt.","no":"Et verk som er kombinert med annet verk uten at ett av verkene dominerer.","tr":"Herhangi bir eserin baskın olduğu düşünülmeden, ilişkili bir eserle eşleştirilen bir eser.","vi":"Tác phẩm cặp đôi với tác phẩm khác mà không có tác phẩm nào được xem là nổi trội.","zh-Hans-CN":"和一种相关作品配对而两者都不被认为占主导地位的一种作品"},"note":{"da":[""]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10247", "lexicalAlias":"http://rdaregistry.info/Elements/w/choreographyWork.en", "label":"has choreography work"},{"@id":"http://rdaregistry.info/Elements/w/P10248", "lexicalAlias":"http://rdaregistry.info/Elements/w/choreographyForWork.en", "label":"is choreography for work"},{"@id":"http://rdaregistry.info/Elements/w/P10238", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForWork.en", "label":"is music for work"},{"@id":"http://rdaregistry.info/Elements/w/P10376", "lexicalAlias":"http://rdaregistry.info/Elements/w/soundsForWork.en", "label":"is sounds for work"},{"@id":"http://rdaregistry.info/Elements/w/P10374", "lexicalAlias":"http://rdaregistry.info/Elements/w/soundsWork.en", "label":"has sounds work"},{"@id":"http://rdaregistry.info/Elements/w/P10375", "lexicalAlias":"http://rdaregistry.info/Elements/w/spokenWordForWork.en", "label":"is spoken word for work"},{"@id":"http://rdaregistry.info/Elements/w/P10373", "lexicalAlias":"http://rdaregistry.info/Elements/w/spokenWordWork.en", "label":"has spoken word work"},{"@id":"http://rdaregistry.info/Elements/w/P10372", "lexicalAlias":"http://rdaregistry.info/Elements/w/textForWork.en", "label":"is text for work"},{"@id":"http://rdaregistry.info/Elements/w/P10371", "lexicalAlias":"http://rdaregistry.info/Elements/w/textWork.en", "label":"has text work"},{"@id":"http://rdaregistry.info/Elements/w/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en", "label":"has music work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/complementedByWork.en", "label":"is complemented by work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/complementedByWork.en", "label":"is complemented by work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10145","label":{"ar":"هو مستوعَب عن طريق عمل","ca":"és absorbit per una obra","cs":"je absorbováno dílem","da":"er indlemmet af værk","de":"ist aufgegangen in (Werk)","de":"ist aufgegangen in (Werk)","el":"απορροφήθηκε από (έργο)","en":"is absorbed by work","es":"es absorbido por obra","et":"sulandunud teosega","fi":"sulautunut teokseen","fr":"est absorbé par une œuvre","hu":"beolvasztja a következő mű:","it":"è assorbita da opera","lv":"ir iekļaujošais darbs","nl":"is opgenomen door werk","no":"er innlemmet i verk","tr":"eser tarafından kapsanmıştır","vi":"được hấp thụ bởi (tác phẩm)","zh-Hans-CN":"被作品吸收"},"definition":{"ar":["يربط عمل بعمل يشتمل محتواه على محتوى عمل آخر."],"ca":["Relaciona una obra amb una obra el contingut de la qual incorpora el contingut d’una altra obra."],"cs":["Vztahuje dílo k dílu, jehož obsah zahrnuje obsah jiného díla."],"da":["Relaterer et værk til et værk, hvis indhold inkorporerer et andet værks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalt den Inhalt eines anderen Werks umfasst.,Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalt den Inhalt eines anderen Werks umfasst."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο ενσωματώνει ένα άλλο έργο."],"en":["Relates a work to a work whose content incorporates the content of another work."],"es":["Relaciona una obra con una obra cuyo contenido incorpora el contenido de otra obra."],"et":["Seostab teose teosega, mille sisu haarab endasse teise teose sisu."],"fi":["Liittää teoksen teokseen, jonka sisältöön toisen teoksen sisältö on yhdistynyt."],"fr":["Met une œuvre en relation avec une œuvre dont le contenu intègre celui d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek tartalma egy másik mű tartalmát magába olvasztja."],"it":["Correla un'opera a un'opera il cui contenuto incorpora il contenuto di un’altra opera."],"lv":["Sasaista darbu ar darbu, kas iekļauj cita darba saturu."],"nl":["Relateert een werk aan een werk waarvan de content, de content van een ander werk opneemt."],"no":["Relaterer et verk til et verk hvis innhold er innlemmet i et annet verk."],"tr":["Bir eseri, içeriği başka bir eserin içeriğini içeren bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sáp nhập tác phẩm khác."],"zh-Hans-CN":["将一种作品与其内容纳入另一种作品之内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"احتوي بعمل","ca":"absorbit per una obra","cs":"absorbováno dílem","da":"indlemmet af værk","de":"Aufgegangen in (Werk)","de":"Aufgegangen in (Werk)","el":"απορροφήθηκε από (έργο)","en":"absorbed by work","es":"absorbido por obra","et":"sulandunud teosega","fi":"sulautunut teokseen","fr":"absorbé par une œuvre","hu":"beolvasztó mű:","it":"assorbita da opera","lv":"iekļaujošais darbs","nl":"opgenomen door werk","no":"innlemmet i verk","tr":"eser tarafından kapsanan","vi":"được hấp thụ bởi (tác phẩm)","zh-Hans-CN":"被作品吸收"},"ToolkitDefinition":{"ar":"عمل يشتمل محتواه على محتوى عمل آخر.","ca":"Obra el contingut de la qual incorpora el contingut d’una altra obra.","cs":"Dílo, jehož obsah zahrnuje obsah jiného díla.","da":"Værk, hvis indhold inkorporerer et andet værks indhold.","de":"Ein Werk, dessen Inhalt den Inhalt eines anderen Werks umfasst.","de":"Ein Werk, dessen Inhalt den Inhalt eines anderen Werks umfasst.","el":"Ένα έργο το οποίο ενσωματώνει ένα άλλο έργο.","en":"A work whose content incorporates the content of another work.","es":"Una obra cuyo contenido incorpora el contenido de otra obra.","et":"Teos, mille sisu haarab endasse teise teose sisu.","fi":"Teos, jonka sisältöön toisen teoksen sisältö on yhdistynyt.","fr":"Œuvre dont le contenu intègre celui d’une autre œuvre.","hu":"Egy mű, amelynek egy másik mű tartalmát magába olvasztja.","it":"Opera il cui contenuto incorpora il contenuto di un’altra opera.","lv":"Darbs, kas iekļauj cita darba saturu.","nl":"Een werk waarvan de content, de content van een ander werk opneemt.","no":"Et verk hvis innhold er innlemmet i et annet verk.","tr":"İçeriği başka bir eserin içeriğini içeren bir çalışma.","vi":"Tác phẩm sáp nhập tác phẩm khác.","zh-Hans-CN":"其内容纳入另一种作品之内容的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
