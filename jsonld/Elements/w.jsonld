                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsNovelWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10034", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsNovelWork.en", "label":"is adapted as novel work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10034", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsNovelWork.en", "label":"is adapted as novel work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10386","label":{"ar":"له إصدارة إقليمية","ca":"té com a versió regional","cs":"má regionální verzi","da":"har regional version","de":"hat Regionalversion","de":"hat Regionalversion","en":"has regional version","es":"tiene versión regional","et":"regionaalversioon","fi":"alueversio","fr":"a pour version régionale","hu":"regionális változata a következő:","it":"ha come versione regionale","lv":"reģionālā versija","nl":"heeft regionale versie","no":"har regional versjon","tr":"bölgesel sürüm ile ilişkilidir","zh-Hans-CN":"有地区版本"},"definition":{"ar":["يربط عمل بعمل تم إنشاؤه عن طريق تغيير الجمهور الإقليمي لعمل."],"ca":["Relaciona una obra amb una obra que es crea canviant els destinataris regionals d’una obra."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou regionálního publika díla."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre et værks regionale målgruppe."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung der regionalen Zielgruppe eines Werks geschaffen wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung der regionalen Zielgruppe eines Werks geschaffen wird."],"en":["Relates a work to a work that is created by changing the regional audience of a work."],"es":["Relaciona una obra con una obra que se crea cambiando la audiencia regional de una obra."],"et":["Seostab teose teosega, mis on loodud, muutes teose regionaalset sihtrühma."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen alueyleisöä."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le public régional d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű regionális közönségének megváltozása következtében jött létre."],"it":["Correla un'opera a un'opera creata modificando la regione dei destinatari di un'opera."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba reģionālo auditoriju."],"nl":["Relateert een werk aan een werk dat is gecreëerd door het wijzigen van de regionale doelgroep van een werk."],"no":["Relaterer et verk til et verk som er skapt ved endring av den regionale målgruppen for et verk."],"tr":["Bir eseri, bir eserin bölgesel kitlesi değiştirilerek oluşturulan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过改变一种作品的地区受众而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة إقليمية","ca":"versió regional","cs":"regionální verze","da":"regional version","de":"Regionalversion","de":"Regionalversion","en":"regional version","es":"versión regional","et":"regionaalversioon","fi":"alueversio","fr":"version régionale","hu":"regionális változata:","it":"versione regionale","lv":"reģionālā versija","nl":"regionale versie","no":"regional versjon","tr":"bölgesel sürüm","zh-Hans-CN":"地区版本"},"ToolkitDefinition":{"ar":"عمل يتم إنشاؤه عن طريق تغيير الجمهور الإقليمي لعمل.","ca":"Obra que es crea canviant els destinataris regionals d’una obra.","cs":"Dílo, které je vytvořeno změnou regionálního publika díla.","da":"Værk, som er skabt ved at ændre et værks regionale målgruppe.","de":"Ein Werk, das durch Änderung der regionalen Zielgruppe eines Werks erstellt wird.","de":"Ein Werk, das durch Änderung der regionalen Zielgruppe eines Werks erstellt wird.","en":"A work that is created by changing the regional audience of a work.","es":"Una obra que se crea cambiando la audiencia regional de una obra.","et":"Teos, mis on loodud, muutes teose regionaalset sihtrühma.","fi":"Teos, joka on luotu muuttamalla teoksen alueyleisöä.","fr":"Œuvre qui est créée en modifiant le public régional d’une œuvre.","hu":"Egy mű, amely egy mű regionális közönségének megváltozása következtében jött létre.","it":"Opera creata cambiando la regione dei destinatari di un'opera.","lv":"Darbs, kas radīts, mainot darba reģionālo auditoriju.","nl":"Een werk dat is gecreëerd door het wijzigen van de regionale doelgroep van een werk.","no":"Et verk som er skapt ved endring av den regionale målgruppen for et verk.","tr":"Bir eserin bölgesel izleyici kitlesinin değiştirilmesiyle oluşturulan bir eser.","zh-Hans-CN":"通过改变一种作品的地区受众而被创作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
