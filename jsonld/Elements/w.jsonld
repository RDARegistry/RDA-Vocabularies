                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10156", "lexicalAlias":"http://rdaregistry.info/Elements/w/precededByWork.en", "label":"is preceded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/separatedFromWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10169", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/separatedFromWork.en", "label":"is separated from work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10169", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/separatedFromWork.en", "label":"is separated from work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10210","label":{"ar":"له تاريخ لعمل","ca":"té com a història d’una obra","cs":"má historii díla","da":"har værkhistorie","de":"hat Geschichte eines Werks","de":"hat Geschichte eines Werks","el":"έχει ιστορία του έργου","en":"has history of work","es":"tiene historial de obra","et":"teose ajalugu","fi":"teoksen historia","fr":"a pour historique d’une œuvre","hu":"mű története a következő:","it":"ha come storia di opera","lv":"darba vēsture","nl":"heeft geschiedenis van werk","no":"verkets historie","sv":"har verkets historia","tr":"eserin geçmişi ile ilişkilidir","vi":"có lịch sử của tác phẩm","zh-Hans-CN":"有作品的历史"},"definition":{"ar":["يربط بين عمل وملخص المعلومات حول تاريخ عمل."],"ca":["Relaciona una obra amb un resum de la informació sobre la història d’una obra."],"cs":["Vztahuje dílo k souhrnu informací o historii díla."],"da":["Relaterer et værk til en opsummering af oplysninger om et værks historie."],"de":["Setzt ein Werk in Beziehung zu Informationen über die Geschichte eines Werks.,Setzt ein Werk in Beziehung zu Informationen über die Geschichte eines Werks."],"el":["Συνδέει ένα έργο με μια περίληψη των πληροφοριών που αναφέρονται στην ιστορία ενός έργου."],"en":["Relates a work to a summary of information about the history of a work."],"es":["Relaciona una obra con un resumen de información sobre la historia de una obra."],"et":["Seostab teose kokkuvõtliku infoga teose ajaloo kohta."],"fi":["Liittää teoksen yhteenvetoon teoksen historiaan liittyvistä tiedoista."],"fr":["Met une œuvre en relation avec un résumé de l’information sur l’histoire d’une œuvre."],"hu":["Hozzákapcsol egy művet egy mű történetéről szóló információk összefoglalásához."],"it":["Correla un'opera a informazioni sintetiche sulla storia di un'opera."],"lv":["Sasaista darbu ar informāciju par darba vēsturi."],"nl":["Relateert een werk aan een samenvatting van informatie betreffende de geschiedenis van een werk."],"no":["Relaterer et verk til et sammendrag av informasjon om et verks historie."],"tr":["Bir eseri, bir eserin tarihi hakkındaki bilgilerin bir özetiyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tóm lược thông tin về lịch sử của tác phẩm."],"zh-Hans-CN":["将一种作品与关于一种作品历史的信息提要关联起来。"]},"ToolkitLabel":{"ar":"تاريخ لعمل","ca":"història d’una obra","cs":"historie díla","da":"værkhistorie","de":"Geschichte eines Werks","de":"Geschichte eines Werks","el":"ιστορία του έργου","en":"history of work","es":"historial de obra","et":"teose ajalugu","fi":"teoksen historia","fr":"historique d’une œuvre","hu":"műtörténet","it":"storia di opera","lv":"darba vēsture","nl":"geschiedenis van werk","no":"verkets historie","sv":"verkets historia","tr":"çalışmanın tarihçesi","vi":"lịch sử của tác phẩm","zh-Hans-CN":"作品的历史"},"ToolkitDefinition":{"ar":"ملخص المعلومات حول تاريخ لعمل.","ca":"Resum de la informació sobre la història d’una obra.","cs":"Souhrn informací o historii díla.","da":"Opsummering af oplysninger om et værks historie.","de":"Informationen über die Geschichte eines Werks.","de":"Informationen über die Geschichte eines Werks.","el":"Μια περίληψη των πληροφοριών που αναφέρονται στην ιστορία ενός έργου.","en":"A summary of information about the history of a work.","es":"Un resumen de información sobre la historia de una obra.","et":"Kokkuvõtlik info teose ajaloo kohta.","fi":"Yhteenveto teoksen historiaan liittyvistä tiedoista.","fr":"Résumé d’informations sur l’histoire d’une œuvre.","hu":"Egy mű történetéről szóló információk összefoglalása.","it":"Informazioni sintetiche sulla storia di un'opera.","lv":"Informācija par darba vēsturi.","nl":"Een samenvatting van informatie betreffende de geschiedenis van een werk.","no":"Et sammendrag av informasjon om et verks historie.","tr":"Bir eserin tarihi hakkındaki bilgilerin özeti.","vi":"Tóm lược thông tin về lịch sử của tác phẩm.","zh-Hans-CN":"关于一种作品历史的信息提要"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/historyOfWork.en","instructionNumber":"6.7","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/datatype/P10210", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/historyOfWork.en", "label":"has history of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10185","label":{"ar":"هو إعادة إنتاج لعمل","ca":"és nova versió d’una obra","cs":"je remakem díla","da":"er genindspilning af værk","de":"ist Remake von (Werk)","de":"ist Remake von (Werk)","el":"είναι ανακατασκευή του (έργο)","en":"is remake of work","es":"es una nueva versión de la obra","et":"uusproduktsioon teosest","fi":"uusintaproduktio teoksesta","fr":"est une nouvelle version d’une œuvre","hu":"újraalkotása a következő műnek","it":"è rifacimento di opera","lv":"ir jauna versija darbam","nl":"is remake van werk","no":"er nyinnspilling av verk","tr":"eserin yeniden yapımıdır","vi":"là làm lại của (tác phẩm)","zh-Hans-CN":"是作品的重新制作"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لفيلم سينمائي جديد، أو برنامج إذاعي، أو برنامج تليفزيوني، أو فيديو."],"ca":["Relaciona una obra amb una obra usada com a base d’una nova pel·lícula cinematogràfica, un nou programa radiofònic, un nou programa de televisió o un nou vídeo."],"cs":["Vztahuje dílo k dílu, použitému jako základ pro nový film, rozhlasový program, televizní program nebo video."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for en ny spillefilm, radioprogram, tv-program eller video."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für einen neuen Film, eine neue Hörfunksendung, eine neue Fernsehsendung oder ein neues Video verwendet wird.,Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für einen neuen Film, eine neue Hörfunksendung, eine neue Fernsehsendung oder ein neues Video verwendet wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια νέα κινηματογραφική ταινία, ένα ραδιοφωνικό πρόγραμμα, ένα τηλεοπτικό πρόγραμμα ή βίντεο."],"en":["Relates a work to a work used as a basis for a new motion picture, radio program, television program, or video."],"es":["Relaciona una obra con una obra utilizada como base para una nueva película, programa de radio, programa de televisión o vídeo."],"et":["Seostab teose teosega, mis on aluseks uuele filmile, raadiosaatele, telesaatele või videofilmile."],"fi":["Liittää teoksen uuden elokuvan, televisio-ohjelman, radio-ohjelman tai videon perustana käytettyyn teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui sert de base à un nouveau film, une nouvelle émission de radio, une nouvelle émission de télévision ou une nouvelle vidéo."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet alapként használnak egy új mozgóképhez, rádióműsorhoz, televízióműsorhoz vagy videóhoz."],"it":["Correla un’opera a un’opera utilizzata come base per un nuovo film, programma radiofonico o video."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu jaunai kinofilmai, radio, televīzijas raidījumam vai video (rīmeikam)."],"nl":["Relateert een werk aan een werk gebruikt als een basis voor een nieuwe speelfilm, radioprogramma, televisieprogramma of video."],"no":["Relaterer et verk til et verk brukt som utgangspunkt for en ny spillefilm, et nytt radioprogram, et nytt fjernsynsprogram eller en ny video"],"tr":["Bir eseri, yeni bir sinema filmi, radyo programı, televizyon programı veya video için temel olarak kullanılan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho phim điện ảnh, chương trình truyền thanh, chương trình truyền hình, hoặc video mới."],"zh-Hans-CN":["将一种作品与被用作一种新的电影、广播节目、电视节目或视频的基础的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إعادة إنتاج لعمل","ca":"nova versió d’una obra","cs":"remake díla","da":"genindspilning af værk","de":"Remake von (Werk)","de":"Remake von (Werk)","el":"ανακατασκευή του (έργο)","en":"remake of work","es":"nueva versión de la obra","et":"uusproduktsioon teosest","fi":"uusintaproduktio teoksesta","fr":"nouvelle version d’une œuvre","hu":"mű újraalkotása:","it":"rifacimento di opera","lv":"jauna versija darbam","nl":"remake van werk","no":"nyinnspilling av verk","tr":"eserin yeniden yapımı","vi":"làm lại của (tác phẩm)","zh-Hans-CN":"作品的重新制作"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لفيلم سينمائي جديد، أو برنامج إذاعي، أو برنامج تليفزيوني، أو فيديو.","ca":"Obra usada com a base d’una nova pel·lícula cinematogràfica, un nou programa radiofònic, un nou programa de televisió o un nou vídeo.","cs":"Dílo, použité jako základ pro nový film, rozhlasový program, televizní program nebo video.","da":"Værk, som anvendes som grundlag for en ny spillefilm, radioprogram, tv-program eller video.","de":"Ein Werk, das als Grundlage für einen neuen Film, eine neue Hörfunksendung, eine neue Fernsehsendung oder ein neues Video verwendet wird.","de":"Ein Werk, das als Grundlage für einen neuen Film, eine neue Hörfunksendung, eine neue Fernsehsendung oder ein neues Video verwendet wird.","el":"Ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια νέα κινηματογραφική ταινία, ένα ραδιοφωνικό πρόγραμμα, ένα τηλεοπτικό πρόγραμμα ή βίντεο.","en":"A work used as a basis for a new motion picture, radio program, television program, or video.","es":"Una obra utilizada como base para una nueva película, programa de radio, programa de televisión o vídeo.","et":"Teos, mis on aluseks uuele filmile, raadiosaatele, telesaatele või videofilmile.","fi":"Uuden elokuvan, televisio-ohjelman, radio-ohjelman tai videon perustana käytetty teos.","fr":"Œuvre qui sert de base à un nouveau film, une nouvelle émission de radio, une nouvelle émission de télévision ou une nouvelle vidéo.","hu":"Egy mű, amelyet alapként használnak egy új mozgóképhez, rádióműsorhoz, televízióműsorhoz vagy videóhoz.","it":"Opera utilizzata come base per un nuovo film, programma radiofonico o video.","lv":"Darbs, kas izmantots par pamatu jaunai kinofilmai, radio, televīzijas raidījumam vai video (rīmeikam).","nl":"Een werk gebruikt als een basis voor een nieuwe speelfilm, radioprogramma, televisieprogramma of video.","no":"Et verk brukt som utgangspunkt for en ny spillefilm, et nytt radioprogram, et nytt fjernsynsprogram eller en ny video","tr":"Yeni bir sinema filmi, radyo programı, televizyon programı veya video için temel olarak kullanılan bir çalışma.","vi":"Tác phẩm được sử dụng như là cơ sở cho phim điện ảnh, chương trình truyền thanh, chương trình truyền hình, hoặc video mới.","zh-Hans-CN":"被用作一种新的电影、广播节目、电视节目或视频的基础的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10341", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyleOf.en", "label":"is transformation by style of"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/remakeOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10185", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remakeOfWork.en", "label":"is remake of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10185", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remakeOfWork.en", "label":"is remake of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10196","label":{"ar":"هو محاكاة لعمل","ca":"és imitació d’una obra","cs":"je imitací díla","da":"er efterligning af værk","de":"ist Imitation von (Werk)","de":"ist Imitation von (Werk)","el":"είναι αντίγραφο του (έργο)","en":"is imitation of work","es":"es imitación de obra","et":"jäljendatud teos","fi":"jäljitelmä teoksesta","fr":"est une imitation d’une œuvre","hu":"utánzása a következő műnek:","it":"è imitazione di opera","lv":"ir imitācija darbam","nl":"is imitatie van werk","no":"er imitasjon av verk","tr":"eserin taklididir","vi":"là mô phỏng của (tác phẩm)","zh-Hans-CN":"是作品的模仿"},"definition":{"ar":["يربط عمل بعمل يُنسخ أسلوبه أو محتواه في عمل مشتق."],"ca":["Relaciona una obra amb una obra l’estil o el contingut de la qual es copia en una obra derivada."],"cs":["Vztahuje dílo k dílu, jehož styl nebo obsah je kopírován v odvozeném díle."],"da":["Relaterer et værk til et værk, hvis stil eller indhold er kopieret i et afledt værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Stil oder Inhalt in einem abgeleiteten Werk kopiert wird.,Setzt ein Werk in Beziehung zu einem Werk, dessen Stil oder Inhalt in einem abgeleiteten Werk kopiert wird."],"el":["Συνδέει ένα έργο με ένα έργο του οποίου το ύφος ή το περιεχόμενο αντιγράφεται σε ένα παράγωγο έργο."],"en":["Relates a work to a work whose style or content is copied in a derivative work."],"es":["Relaciona una obra con una obra cuyo estilo o contenido se copia en una obra derivada."],"et":["Seostab teose teosega, mille stiili või sisu on jäljendatud tuletatud teoses."],"fi":["Liittää teoksen teokseen, jonka tyyliä tai sisältöä johdannaisteos jäljittelee."],"fr":["Met une œuvre en relation avec une œuvre dont le style ou le contenu est copié dans une œuvre dérivée."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek stílusát vagy tartalmát egy származékos műben másolják."],"it":["Correla un’opera a un’opera il cui stile o contenuto è copiato in un’opera derivata."],"lv":["Sasaista darbu ar darbu, kura stils vai saturs atdarināts atvasinātā darbā."],"nl":["Relateert een werk aan een werk waarvan stijl of content is gekopieerd in een afgeleid werk."],"no":["Relaterer et verk til et verk hvis stil eller innhold kopieres i et avledet verk."],"tr":["Bir eseri, biçimi veya içeriği türev bir esere kopyalanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mà phong cách và nội dung được sao lại trong tác phẩm dẫn xuất."],"zh-Hans-CN":["将一种作品与其风格和内容被复制于一种衍生作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"محاكاة لعمل","ca":"imitació d’una obra","cs":"imitace díla","da":"efterligning af værk","de":"Imitation von (Werk)","de":"Imitation von (Werk)","el":"αντίγραφο του (έργο)","en":"imitation of work","es":"imitación de obra","et":"jäljendatud teos","fi":"jäljitelmä teoksesta","fr":"imitation d’une œuvre","hu":"utánzott mű","it":"imitazione di opera","lv":"imitācija darbam","nl":"imitatie van werk","no":"imitasjon av verk","tr":"eserin taklididir","vi":"mô phỏng của (tác phẩm)","zh-Hans-CN":"作品的模仿"},"ToolkitDefinition":{"ar":"عمل يُنسخ أسلوبه أو محتواه في عمل مشتق.","ca":"Obra l’estil o el contingut de la qual es copia en una obra derivada.","cs":"Dílo, jehož styl nebo obsah je kopírován v odvozeném díle.","da":"Værk, hvis stil eller indhold er kopieret i et afledt værk.","de":"Ein Werk, dessen Stil oder Inhalt in einem abgeleiteten Werk kopiert wird.","de":"Ein Werk, dessen Stil oder Inhalt in einem abgeleiteten Werk kopiert wird.","el":"Ένα έργο του οποίου το ύφος ή το περιεχόμενο αντιγράφεται σε ένα παράγωγο έργο.","en":"A work whose style or content is copied in a derivative work.","es":"Una obra cuyo estilo o contenido se copia en una obra derivada.","et":"Teos, mille stiili või sisu on jäljendatud tuletatud teoses.","fi":"Teos, jonka tyyliä tai sisältöä johdannaisteos jäljittelee.","fr":"Œuvre dont le style ou le contenu est copié dans une œuvre dérivée.","hu":"Egy mű, amelynek stílusát vagy tartalmát egy származékos műben másolják.","it":"Opera il cui stile o contenuto è copiato in un’opera derivata.","lv":"Darbs, kura stils vai saturs atdarināts atvasinātā darbā.","nl":"Een werk waarvan stijl of content is gekopieerd in een afgeleid werk.","no":"Et verk hvis stil eller innhold kopieres i et avledet verk.","tr":"Biçimi veya içeriği türetilen bir çalışmada kopyalanmış bir çalışma.","vi":"Tác phẩm mà phong cách và nội dung được sao lại trong tác phẩm dẫn xuất.","zh-Hans-CN":"其风格和内容被复制于一种衍生作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10341", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyleOf.en", "label":"is transformation by style of"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/imitationOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10197", "lexicalAlias":"http://rdaregistry.info/Elements/w/parodyOfWork.en", "label":"is parody of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10196", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/imitationOfWork.en", "label":"is imitation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10196", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/imitationOfWork.en", "label":"is imitation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10128","label":{"ar":"هو اقتباس شعري لعمل","ca":"és adaptació en vers d’una obra","cs":"je veršovanou adaptací díla","da":"er bearbejdelse af værk til vers","de":"ist Gedichtbearbeitung von (Werk)","de":"ist Gedichtbearbeitung von (Werk)","el":"είναι προσαρμογή έμμετρου λόγου του (έργο)","en":"is verse adaptation of work","es":"es adaptación en verso de obra","et":"värsskohandus teosest","fi":"runomukaelma teoksesta","fr":"est une adaptation en vers d’une œuvre","hu":"verses adaptációja a következő műnek:","it":"è adattamento in versi di opera","lv":"kā dzeja adaptētais darbs","nl":"is bewerking in versvorm van werk","no":"er bearbeidelse av verk til verseform","tr":"eserin nazım uyarlamasıdır","vi":"là phỏng theo thể thơ của (tác phẩm)","zh-Hans-CN":"是作品的韵文改编"},"definition":{"ar":["يربط عمل بعمل تمت معالجته كتكوين أدبي في شكل شعر."],"ca":["Relaciona una obra amb una obra que s’adapta com una composició literària en vers."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako literární kompozice ve formě veršů."],"da":["Relaterer et værk til et værk, som er bearbejdet til en litterær komposition i versform."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als literarische Dichtung in Versform bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als literarische Dichtung in Versform bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως μια λογοτεχνική σύνθεση σε έμμετρη μορφή."],"en":["Relates a work to a work that is adapted as a literary composition in verse form."],"es":["Relaciona una obra con una obra que es adaptada como una composición en forma de verso."],"et":["Seostab teose teosega, mis on adapteeritud värsivormis kirjandusliku kompositsioonina."],"fi":["Liittää teoksen teokseen, joka on sovitettu runomuotoiseksi kirjalliseksi tuotokseksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée sous forme de composition littéraire en vers."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet verses formájú irodalmi alkotásként adaptáltak."],"it":["Correla un’opera a un’opera adattata come componimento letterario in versi."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā literārs darbs dzejas formā."],"nl":["Relateert een werk aan een werk dat is bewerkt als een literaire compositie in versvorm."],"no":["Relaterer et verk til et verk som er bearbeidet til en litterær komposisjon i verseform."],"tr":["Bir eseri, nazım biçiminde edebi bir eser olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là sáng tác văn chương ở thể thơ."],"zh-Hans-CN":["将一种作品与被改编为韵文形式文学写作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"اقتباس شعري لعمل","ca":"adaptació en vers d’una obra","cs":"veršovaná adaptace díla","da":"bearbejdelse af værk til vers","de":"Gedichtbearbeitung von (Werk)","de":"Gedichtbearbeitung von (Werk)","el":"προσαρμογή έμμετρου λόγου του (έργο)","en":"verse adaptation of work","es":"adaptación en verso de obra","et":"värsskohandus teosest","fi":"runomukaelma teoksesta","fr":"adaptation en vers d’une œuvre","hu":"versként átdolgozott mű:","it":"adattamento in versi di opera","lv":"kā dzeja adaptētais darbs","nl":"bewerking in versvorm van werk","no":"bearbeidelse av verk til verseform","tr":"eserin manzum uyarlaması","vi":"phỏng theo thể thơ của (tác phẩm)","zh-Hans-CN":"作品的韵文改编"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كتكوين أدبي في شكل شعر.","ca":"Obra que s’adapta com una composició literària en vers.","cs":"Dílo, které je adaptováno jako literární kompozice ve formě veršů.","da":"Værk, som er bearbejdet til en litterær komposition i versform.","de":"Ein Werk, das als literarische Dichtung in Versform bearbeitet ist.","de":"Ein Werk, das als literarische Dichtung in Versform bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως μια λογοτεχνική σύνθεση σε έμμετρη μορφή.","en":"A work that is adapted as a literary composition in verse form.","es":"Una obra que es adaptada como una composición en forma de verso.","et":"Teos, mis on adapteeritud värsivormis kirjandusliku kompositsioonina.","fi":"Teos, joka on sovitettu runomuotoiseksi kirjalliseksi tuotokseksi.","fr":"Œuvre qui est adaptée sous forme de composition littéraire en vers.","hu":"Egy mű, amelyet verses formájú irodalmi alkotásként adaptáltak.","it":"Opera adattata come componimento letterario in versi.","lv":"Darbs, kas ir adaptēts kā literārs darbs dzejas formā.","nl":"Een werk dat is bewerkt als een literaire compositie in versvorm.","no":"Et verk som er bearbeidet til en litterær komposisjon i verseform.","tr":"Nazım biçiminde edebi bir eser olarak uyarlanan bir eser.","vi":"Tác phẩm đã được phỏng theo như là sáng tác văn chương ở thể thơ.","zh-Hans-CN":"被改编为韵文形式文学写作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
