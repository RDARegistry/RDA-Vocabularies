                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsRadioProgramWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10076", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsRadioProgramWork.en", "label":"is adapted as radio program work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10076", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsRadioProgramWork.en", "label":"is adapted as radio program work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10243","label":{"ar":"له عمل موسيقي لبرنامج إذاعي","ca":"té com a obra de música de programa radiofònic","cs":"má hudbu (dílo) pro rozhlasový program","da":"har radioprogrammusikværk","de":"hat Hörfunksendungsmusik (Werk)","de":"hat Hörfunksendungsmusik (Werk)","el":"είναι μουσική ραδιοφωνικού προγράμματος (έργο)","en":"has radio program music work","es":"tiene obra musical en programas de radio","et":"raadiosaate muusika (teos)","fi":"radio-ohjelman musiikki (teos)","fr":"a pour musique d’émission de radio (œuvre)","hu":"rádióműsorzene-műve a következő:","it":"ha come musica per programma radiofonico opera","lv":"darbs: radio raidījuma mūzika","nl":"heeft radioprogrammamuziek-werk","no":"har radiomusikk (verk)","tr":"radyo programı müziği eseri ile ilişkilidir","vi":"là âm nhạc chương trình truyền thanh (tác phẩm)","zh-Hans-CN":"有广播节目音乐作品"},"definition":{"ar":["يربط عمل بعمل موسيقي يكمل عملًا عبارة عن برنامج إذاعي."],"ca":["Relaciona una obra amb una obra que és una obra musical que complementa una obra que és un programa radiofònic."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, doplňujícím dílo, které je rozhlasovým programem."],"da":["Relaterer et værk til et musikværk, som komplementerer et værk, som er et radioprogram."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, das eine Hörfunksendung (Werk) ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das eine Hörfunksendung (Werk) ergänzt."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο το οποίο χρησιμοποιείται σε ένα ραδιοφωνικό πρόγραμμα."],"en":["Relates a work to a work that is a musical work that complements a work that is a radio program."],"es":["Relaciona una obra con una obra que es una obra musical que complementa una obra que es un programa de radio."],"et":["Seostab teose muusikateosega, mis täiendab raadiosaatena esinevat teost."],"fi":["Liittää teoksen musiikkiteokseen, joka täydentää teosta, joka on radio-ohjelma."],"fr":["Met une œuvre en relation avec une œuvre musicale qui complète une œuvre consistant en une émission de radio."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amely kiegészít egy rádióműsor-művet."],"it":["Correla un’opera a un’opera musicale che completa un’opera che è un programma radiofonico."],"lv":["Sasaista darbu ar mūzikas darbu, kas papildina darbu, kas ir radio raidījums."],"nl":["Relateert een werk aan een muziekwerk dat een werk complementeert dat een radioprogramma is."],"no":["Relaterer et verk til et musikalsk verk som utfyller et radioprogram."],"tr":["Bir eseri, radyo programı olan bir eseri tamamlayan bir müzik eseri olan eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc được sử dụng trong chương trình truyền thanh."],"zh-Hans-CN":["将一种作品与作为一种音乐作品并补充作为一种广播节目的一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل موسيقى لبرنامج إذاعي","ca":"obra de música de programa radiofònic","cs":"hudba (dílo) pro rozhlasový program","da":"radioprogrammusikværk","de":"Hörfunksendungsmusik (Werk)","de":"Hörfunksendungsmusik (Werk)","el":"μουσική ραδιοφωνικού προγράμματος (έργο)","en":"radio program music work","es":"obra musical en programas de radio","et":"raadiosaate muusika (teos)","fi":"radio-ohjelman musiikki (teos)","fr":"musique d’émission de radio (œuvre)","hu":"rádióműsor-zenemű","it":"musica per programma radiofonico opera","lv":"darbs: radio raidījuma mūzika","nl":"radioprogrammamuziek-werk","no":"radiomusikk (verk)","tr":"radyo programı müziği","vi":"âm nhạc chương trình truyền thanh (tác phẩm)","zh-Hans-CN":"广播节目音乐作品"},"ToolkitDefinition":{"ar":"عمل موسيقي يكمل عملًا عبارة عن برنامج إذاعي.","ca":"Obra que és una obra musical que complementa una obra que és un programa radiofònic.","cs":"Dílo, které je hudebním dílem, doplňujícím dílo, které je rozhlasovým programem.","da":"Musikværk, som komplementerer et værk, som er et radioprogram.","de":"Ein Musikwerk, das eine Hörfunksendung (Werk) ergänzt.","de":"Ein textliches Werk, das eine Hörfunksendung (Werk) ergänzt.","el":"Ένα μουσικό έργο το οποίο χρησιμοποιείται σε ένα ραδιοφωνικό πρόγραμμα.","en":"A work that is a musical work that complements a work that is a radio program.","es":"Una obra que es una obra musical que complementa una obra que es un programa de radio.","et":"Muusikateos, mis täiendab raadiosaatena esinevat teost.","fi":"Musiikkiteos, joka täydentää teosta, joka on radio-ohjelma.","fr":"Œuvre musicale qui complète une œuvre consistant en une émission de radio.","hu":"Egy mű, amely egy zenemű, amely kiegészít egy rádióműsor-művet.","it":"Opera musicale che completa un’opera che è un programma radiofonico.","lv":"Muzikas darbs, kas papildina darbu, kas ir radio raidījums.","nl":"Een muziekwerk dat een werk complementeert dat een radioprogramma is.","no":"Et musikalsk verk som utfyller et radioprogram.","tr":"Bir radyo programını tamamlayan bir müzik eseri olan bir eser.","vi":"Tác phẩm âm nhạc được sử dụng trong chương trình truyền thanh.","zh-Hans-CN":"作为一种音乐作品并补充作为一种广播节目的一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "