                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/founderAgentOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10499", "lexicalAlias":"http://rdaregistry.info/Elements/w/founderCollectiveAgentOfWork.en", "label":"has founder collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10452", "lexicalAlias":"http://rdaregistry.info/Elements/w/founderPersonOfWork.en", "label":"has founder person of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10299", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/founderAgentOfWork.en", "label":"has founder agent of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10299", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/founderAgentOfWork.en", "label":"has founder agent of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10499","label":{"ar":"له وكيل جماعي مؤسس لعمل","ca":"té com a agent col·lectiu fundador d’una obra","cs":"má zakladatele díla (kolektivního agenta)","da":"har kollektiv agent, som er stifter af værk","de":"hat Begründerin/Begründer eines Werks (Gemeinschaftlicher Akteur)","de":"hat Begründerin/Begründer eines Werks (Gemeinschaftlicher Akteur)","en":"has founder collective agent of work","es":"tiene agente colectivo fundador de obra","et":"teose asutaja (kollektiiv)","fi":"teoksen perustaja (yhteistoimija)","fr":"a pour agent collectif fondateur d’une œuvre","hu":"mű alapító kollektív ágense a következő:","it":"ha come fondatore agente collettivo di opera","lv":"darba dibinātājs (grupa)","nl":"heeft oprichter-collectieve actor van werk","no":"har grunnlegger av verk (kollektiv agent)","tr":"eserin kurucu kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有作品的创办者集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي مسئول عن بدء عمل ممتد زمنيًا."],"ca":["Relaciona una obra amb un agent col·lectiu que és responsable d’iniciar una obra diacrònica."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je odpovědný za iniciování diachronního díla."],"da":["Relaterer et værk til en kollektiv agent, som er ansvarlig for at igangsætte et diakronisk værk."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für das Begründen eines diachronen Werks verantwortlich ist.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für das Begründen eines diachronen Werks verantwortlich ist."],"en":["Relates a work to a collective agent who is responsible for initiating a diachronic work."],"es":["Relaciona una obra con un agente colectivo que se encarga de iniciar una obra diacrónica."],"et":["Seostab teose kollektiiviga, kes vastutab diakroonilise teose ellukutsumise eest."],"fi":["Liittää teoksen yhteistoimijaan, joka on vastuussa diakronisen teoksen alullepanosta."],"fr":["Met une œuvre en relation avec un agent collectif qui est responsable de lancer une œuvre diachronique."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy diakronikus mű indításáért."],"it":["Correla un'opera all'agente collettivo responsabile dell'avvio di un'opera diacronica."],"lv":["Sasaista darbu ar grupu, kas ir atbildīga par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu."],"nl":["Relateert een werk aan een collectieve actor die verantwoordelijk is voor het initiëren van een diachronisch werk."],"no":["Relaterer et verk til en kollektiv agent som har ansvar for å etablere et diakronisk verk."],"tr":["Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-