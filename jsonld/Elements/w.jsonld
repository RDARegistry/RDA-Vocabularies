                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en", "label":"is succeeded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/mergedToFormWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10212", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/mergedToFormWork.en", "label":"is merged to form work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10212", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/mergedToFormWork.en", "label":"is merged to form work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10019","label":{"ar":"هو جزء من عمل","ca":"és part d’una obra","cs":"je částí díla","da":"er del af værk","de":"ist Teil von (Werk)","de":"ist Teil von (Werk)","el":"περιέχεται σε (έργο)","en":"is part of work","es":"es parte de obra","et":"osa teosest","fi":"osa teosta","fr":"est une partie d’œuvre de","hu":"része a következő műnek:","it":"è parte di opera","lv":"ir daļa darbā","nl":"is deel van werk","no":"er del av verk","tr":"eserin bir bileşenidir","vi":"được chứa trong (tác phẩm)","zh-Hans-CN":"是作品的部分"},"definition":{"ar":["يربط عمل بعمل يحتوي على عمل آخر كمكون منفصل."],"ca":["Relaciona una obra amb una obra que té una altra obra com a component discret."],"cs":["Vztahuje dílo k dílu, které obsahuje jiné dílo jako samostatnou část."],"da":["Relaterer et værk til et værk, som har et andet værk som en separat komponent."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk als einzelnen Bestandteil enthält.,Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk als einzelnen Bestandteil enthält."],"el":["Συνδέει ένα έργο με ένα μεγαλύτερο έργο για το οποίο το έργο συνιστά ένα διακριτό συστατικό."],"en":["Relates a work to a work that has another work as a discrete component."],"es":["Relaciona una obra con una obra que tiene otra obra como un componente discreto."],"et":["Seostab teose teosega, millesse kuulub iseseisva koostisosana teine teos."],"fi":["Liittää teoksen teokseen, jolla on toinen teos itsenäisenä osana."],"fr":["Met une œuvre en relation avec une œuvre qui a pour composante distincte une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely elkülöníthető alkotóelemként rendelkezik egy másik művel."],"it":["Correla un’opera a un’opera che ha un’altra opera come componente distinta."],"lv":["Sasaista darbu ar darbu, kam ir cits darbs kā atsevišķa sastāvdaļa."],"nl":["Relateert een werk aan een werk dat een ander werk als afzonderlijk onderdeel heeft."],"no":["Relaterer et verk til et verk som inneholder et annet verk som en avgrenset del."],"tr":["Bir eseri, ayrık bir bileşen olarak farklı bir esere sahip bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm lớn hơn mà tác phẩm là bộ phận cấu thành tách biệt."],"zh-Hans-CN":["将一种作品与有另一种作品作为独立组成部分的一种作品关联起来。"]},"ToolkitLabel":{"ar":"جزء من عمل","ca":"part d’una obra","cs":"část díla","da":"del af værk","de":"Teil von (Werk)","de":"Teil von (Werk)","el":"περιέχεται σε (έργο)","en":"part of work","es":"parte de obra","et":"osa teosest","fi":"osa teosta","fr":"partie d’œuvre de","hu":"befoglaló mű:","it":"parte di opera","lv":"daļa darbā","nl":"deel van werk","no":"del av verk","tr":"Eserin bölümü","vi":"được chứa trong (tác phẩm)","zh-Hans-CN":"作品的部分"},"ToolkitDefinition":{"ar":"عمل له عمل آخر كمكون منفصل.","ca":"Obra que té una altra obra com a component discret.","cs":"Dílo, které obsahuje jiné dílo jako samostatnou část.","da":"Værk, som har et andet værk som en separat komponent.","de":"Ein Werk, das ein anderes Werk als einzelnen Bestandteil enthält.","de":"Ein Werk, das ein anderes Werk als einzelnen Bestandteil enthält.","el":"Ένα μεγαλύτερο έργο στο οποίο ένα έργο συνιστά ένα διακριτό συστατικό.","en":"A work that has another work as a discrete component.","es":"Una obra que tiene otra obra como un componente discreto.","et":"Teos, millesse kuulub iseseisva koostisosana teine teos.","fi":"Teos, jolla on toinen teos itsenäisenä osana.","fr":"Œuvre qui a pour composante distincte une autre œuvre.","hu":"Egy mű, amely elkülöníthető alkotóelemként rendelkezik egy másik művel.","it":"Opera con un’opera che ha un’altra opera come componente distinta.","lv":"Darbs, kam ir cits darbs kā atsevišķa sastāvdaļa.","nl":"Een werk dat een ander werk als afzonderlijk onderdeel heeft.","no":"Et verk som inneholder et annet verk som en avgrenset del.","tr":"Ayrı bir bileşen olarak farklı bir esere sahip eser.","vi":"Tác phẩm lớn hơn mà tác phẩm là bộ phận cấu thành tách biệt.","zh-Hans-CN":"有另一种作品作为独立组成部分的一种作品"},"altLabel":{"ar":["متضمن في (عمل)"],"ca":["contingut en (obra)"],"cs":["zahrnuto v (díle)"],"da":["indholdt i værk"],"de":["Enthalten in (Werk),Enthalten in (Werk)"],"en":["contained in (work)"],"es":["contenida en (obra)"],"et":["sisaldub teoses"],"fi":["sisältyy teokseen"],"fr":["contenu dans (œuvre)"],"hu":["tartalmazza a következő (mű):"],"it":["contenuta in opera"],"tr":["içinde bulunan (eser)"],"zh-Hans-CN":["被包含于（作品）"]},"note":{"ar":["يعد العمل الجزئي ضروريًا للعمل بأكمله."],"ca":["Una obra de part es considera essencial per a l’obra completa."],"cs":["Část díla je považována za nezbytnou pro celé dílo."],"da":["Del af et værk er anset for at være vigtigt for hele værket."],"de":["Ein Teilwerk wird als wesentlich für das Gesamtwerk angesehen.,Ein Teilwerk wird als wesentlich für das Gesamtwerk angesehen."],"en":["A part work is considered to be essential to the whole work."],"es":["Una parte de obra se considera esencial para la obra completa."],"et":["Teose osa peetakse kogu teose suhtes oluliseks."],"fi":["Teoksen osaa pidetään olennaisena koko teokselle."],"fr":["Une partie d’œuvre est considérée comme essentielle à l’œuvre entière."],"hu":["A részmű alapvető fontosságú az egész mű szempontjából."],"it":["Un'opera parte è considerata essenziale per l'intera opera"],"lv":["Darbs: daļa, kuru uzskata par būtisku visam darbam."],"nl":["Een deelwerk wordt beschouwd als essentieel voor het hele werk."],"no":["Et delverk er ansett å være viktig for hele verket."],"tr":["Bir parça eserin, eserin bütünü için gerekli olduğu kabul edilir."],"zh-Hans-CN":["一种部分作品被认为对于完整作品至关重要。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
