                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/sculptorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10592", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistFamily.en", "label":"has artist family"},{"@id":"http://rdaregistry.info/Elements/w/P10474", "lexicalAlias":"http://rdaregistry.info/Elements/w/sculptorCollectiveAgent.en", "label":"has sculptor collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10568", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sculptorFamily.en", "label":"has sculptor family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10568", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sculptorFamily.en", "label":"has sculptor family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10427","label":{"ar":"له شخص نحات","ca":"té com a persona escultora","cs":"má sochaře (osobu)","da":"har person, som er skulptør","de":"hat Bildhauerin/Bildhauer (Person)","de":"hat Bildhauerin/Bildhauer (Person)","en":"has sculptor person","es":"tiene persona escultor","et":"skulptor (isik)","fi":"kuvanveistäjä (henkilö)","fr":"a pour personne sculptrice","hu":"szobrász személye a következő:","it":"ha come scultore persona","lv":"tēlnieks (persona)","nl":"heeft beeldhouwer-persoon","no":"har skulptør (person)","tr":"heykeltıraş kişisi ile ilişkilidir","zh-Hans-CN":"有雕塑家个人"},"definition":{"ar":["يربط بين عمل وشخص يكون فنانا مسئولاً عن إنشاء عمل ثلاثي الأبعاد عن طريق النمذجة، أو النحت، أو تقنية مشابهة."],"ca":["Relaciona una obra amb una persona que és un artista que és responsable de la creació d’una obra tridimensional a partir del modelatge, la talla o una tècnica similar."],"cs":["Vztahuje dílo k osobě, která je umělcem odpovědným za vytvoření trojrozměrného díla modelováním, vyřezáváním nebo podobnou technikou."],"da":["Relaterer et værk til en person, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist."],"en":["Relates a work to a person who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique."],"es":["Relaciona una obra con una persona que es un artista que se encarga de crear una obra tridimensional mediante modelado, tallado o una técnica similar."],"et":["Seostab teose isikuga, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik."],"fi":["Liittää teoksen henkilöön, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla."],"fr":["Met une œuvre en relation avec une personne artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire."],"hu":["Hozzákapcsol egy művet egy művész személyhez, aki felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával."],"it":["Correla un'opera alla persona artista responsabile della creazione di un'opera tridimensionale tramite modellatura, intaglio o tecnica simile."],"lv":["Sasaista darbu ar personu - mākslinieks, kurš ir atbildīgs par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku."],"nl":["Relateert een werk aan een persoon die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek."],"no":["Relaterer et verk til en person som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker."],"tr":["Bir eseri, modelleme, oyma veya benzeri bir teknikle üç boyutlu bir eser oluşturmaktan sorumlu sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个艺术家并通过模型、雕刻或类似技术负责创作一种三维作品的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص نحات","ca":"persona escultora","cs":"sochař (osoba)","da":"person, som er skulptør","de":"Bildhauerin/Bildhauer (Person)","de":"Bildhauerin/Bildhauer (Person)","en":"sculptor person","es":"persona escultor","et":"skulptor (isik)","fi":"kuvanveistäjä (henkilö)","fr":"personne sculptrice","hu":"szobrász személy:","it":"scultore persona","lv":"tēlnieks (persona)","nl":"beeldhouwer-persoon","no":"skulptør (person)","tr":"heykeltıraş kişi","zh-Hans-CN":"雕塑家个人"},"ToolkitDefinition":{"ar":"شخص يكون فنانا مسئولاً عن إنشاء عمل ثلاثي الأبعاد عن طريق النمذجة، أو النحت، أو تقنية مشابهة.","ca":"Persona que és un artista que és responsable de la creació d’una obra tridimensional a partir del modelatge, la talla o una tècnica similar.","cs":"Osoba, která je umělcem odpovědným za vytvoření trojrozměrného díla modelováním, vyřezáváním nebo podobnou technikou.","da":"Person, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik.","de":"Eine Künstlerin/Ein Künstler (Person), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Person), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.","en":"A person who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique.","es":"Una persona que es un artista que se encarga de crear una obra tridimensional mediante modelado, tallado o una técnica similar.","et":"Isik, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik.","fi":"Henkilö, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.","fr":"Personne artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire.","hu":"Egy művész személy, aki felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával.","it":"Persona artista responsabile della creazione di un'opera tridimensionale tramite modellatura, intaglio o tecnica simile.","lv":"Persona - mākslinieks, kurš ir atbildīgs par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku.","nl":"Een persoon die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek.","no":"En person som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker.","tr":"Modelleme, oyma veya benzeri bir teknikle üç boyutlu bir eser meydana getirmekle sorumlu bir sanatçı olan kişi.","zh-Hans-CN":"作为一个艺术家并通过模型、雕刻或类似技术负责创作一种三维作品的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/sculptorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10451", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistPerson.en", "label":"has artist person"},{"@id":"http://rdaregistry.info/Elements/w/P10202", "lexicalAlias":"http://rdaregistry.info/Elements/w/sculptorAgent.en", "label":"has sculptor agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10427", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sculptorPerson.en", "label":"has sculptor person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10427", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sculptorPerson.en", "label":"has sculptor person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10104","label":{"ar":"هو منفصل إلى عمل","ca":"és separat en una obra","cs":"oddělilo se dílo","da":"er delvis fortsat i (værk)","de":"ist teilweise fortgesetzt von (Werk)","de":"ist teilweise fortgesetzt von (Werk)","el":"συνεχίζεται μερικώς από (έργο)","en":"is separated into work","es":"es separada en obra","et":"eraldunud teos","fi":"eronnut teokseksi","fr":"est continué en partie par une œuvre","hu":"kivált a következő műbe:","it":"è distinta in opera","lv":"ir atdalītais darbs","nl":"is afgesplitst in werk","no":"fortsettes delvis i verk","tr":"eserin bölümlerine ayrılmıştır","vi":"được tiếp tục một phần bởi (tác phẩm)","zh-Hans-CN":"被分离出而成的作品"},"definition":{"ar":["يربط عمل بعمل ممتد زمنيًا يُكْمل المحتوى الجزئي لعمل آخر ممتد زمنيًا ومستمر."],"ca":["Relaciona una obra amb una obra que és una obra diacrònica que continua el contingut parcial d’una altra obra diacrònica que és contínua."],"cs":["Vztahuje dílo k dílu, které je diachronním dílem, které je pokračováním částečného obsahu jiného diachronního díla, které pokračuje."],"da":["Relaterer et værk til et værk, hvoraf en del af indholdet er udskilt fra et tidligere værk, så et nyt værk er dannet."],"de":["Setzt ein Werk in Beziehung zu einem diachronen Werk, das teilweise den Inhalt eines anderen fortlaufenden diachronen Werks fortführt.,Setzt ein Werk in Beziehung zu einem diachronen Werk, das teilweise den Inhalt eines anderen fortlaufenden diachronen Werks fortführt."],"el":["Συνδέει ένα έργο με ένα έργο, μέρος του περιεχομένου του οποίου διαχωρίστηκε από ένα προηγούμενο έργο για να σχηματίσει ένα νέο έργο."],"en":["Relates a work to a work that is a diachronic work that continues the partial content of another diachronic work that is continuing."],"es":["Relaciona una obra con una obra que es una obra diacrónica que continua el contenido parcial de otra obra diacrónica que continua."],"et":["Seostab teose diakroonilise teosega, mis jätkab osaliselt teise, jätkuva diakroonilise teose sisu."],"fi":["Liittää teoksen teokseen, joka on diakroninen teos, joka jatkaa toisen diakronisen jatkuvan teoksen sisältöä osittain."],"fr":["Met une œuvre en relation avec une œuvre diachronique qui continue le contenu partiel d’une autre œuvre diachronique qui se poursuit."],"hu":["Hozzákapcsol egy művet egy diakronikus műhöz, amely egy másik folytatódó diakronikus mű részleges tartalmát folytatja."],"it":["Correla un’opera a un’opera che è un’opera diacronica che continua in parte il contenuto di un’altra opera diacronica che continua."],"lv":["Sasaista darbu ar darbu, kas ir diahronisks darbs, kas daļēji turpina cita diahroniska darba saturu, kas turpinās."],"nl":["Relateert een werk aan een werk dat een diachronisch werk is dat de gedeeltelijke content voortzet van een ander diachronisch werk dat voortgezet wordt."],"no":["Relaterer et verk til et verk som er et diakronisk verk som er en delvis fortsettelse av innholdet av et annet løpende diakronisk verk."],"tr":["Bir eseri, devam etmekte olan başka bir artzamanlı eserin kısmi içeriğini devam ettiren artzamanlı bir eser olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mà phần của nội dung của nó được phân tách từ tác phẩm trước đây để tạo thành tác phẩm mới."],"zh-Hans-CN":["将一种作品与作为一种历时作品、继承另一种继续出版的历时作品的部分内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"منفصل إلى عمل","ca":"separat en una obra","cs":"oddělilo se dílo","da":"delvis fortsat i (værk)","de":"Teilweise fortgesetzt von (Werk)","de":"Teilweise fortgesetzt von (Werk)","el":"συνεχίζεται μερικώς από (έργο)","en":"separated into work","es":"separada en obra","et":"eraldunud teos","fi":"eronnut teokseksi","fr":"continué en partie par une œuvre","hu":"részben kivált mű:","it":"distinta in opera","lv":"atdalītais darbs","nl":"afgesplitst in werk","no":"fortsettes delvis i verk","tr":"esere ayrılmış","vi":"được tiếp tục một phần bởi (tác phẩm)","zh-Hans-CN":"被分离出而成的作品"},"ToolkitDefinition":{"ar":"عمل ممتد زمنيًا يُكْمل المحتوى الجزئي لعمل آخر ممتد زمنيًا ومستمر.","ca":"Obra que és una obra diacrònica que continua el contingut parcial d’una altra obra diacrònica que és contínua.","cs":"Dílo, které je diachronním dílem, které je pokračováním částečného obsahu jiného diachronního díla, které pokračuje.","da":"Værk, hvoraf en del af indholdet er udskilt fra et tidligere værk, så et nyt værk er dannet.","de":"Ein diachrones Werk, das teilweise den Inhalt eines anderen fortlaufenden diachronen Werks fortführt.","de":"Ein diachrones Werk, das teilweise den Inhalt eines anderen fortlaufenden diachronen Werks fortführt.","el":"Ένα έργο, μέρος του περιεχομένου του οποίου διαχωρίστηκε από ένα προηγούμενο έργο για να σχηματίσει ένα νέο έργο.","en":"A work that is a diachronic work that continues the partial content of another diachronic work that is continuing.","es":"Una obra que es una obra diacrónica que continua el contenido parcial de otra obra diacrónica que continua.","et":"Diakrooniline teos, mis jätkab osaliselt teise, jätkuva diakroonilise teose sisu.","fi":"Teos, joka on diakroninen teos, joka jatkaa toisen diakronisen jatkuvan teoksen sisältöä osittain.","fr":"Œuvre diachronique qui continue le contenu partiel d’une autre œuvre diachronique qui se poursuit.","hu":"Egy diakronikus mű, amely egy másik folytatódó diakronikus mű részleges tartalmát folytatja.","it":"Opera che è un’opera diacronica che continua in parte il contenuto di un’altra opera diacronica che continua.","lv":"Darbs, kas ir diahronisks darbs, kas daļēji turpina cita diahroniska darba saturu, kas turpinās.","nl":"Een werk dat een diachronisch werk is dat de gedeeltelijke content voortzet van een ander diachronisch werk dat voortgezet wordt.","no":"Et verk som er et diakronisk verk som er en delvis fortsettelse av innholdet av et annet løpende diakronisk verk.","tr":"Devam etmekte olan başka bir artzamanlı eserin kısmi içeriğini devam ettiren artzamanlı eser olan bir eser.","vi":"Tác phẩm mà phần của nội dung của nó được phân tách từ tác phẩm trước đây để tạo thành tác phẩm mới.","zh-Hans-CN":"作为一种历时作品、继承另一种继续出版的历时作品的部分内容的一种作品"},"note":{"ar":["ينطبق هذا العنصر بشكل عام على عمل متتالٍ."],"ca":["En general, aquest element s’aplica a una obra successiva."],"cs":["Tento prvek se obecně vztahuje na postupně vydávané dílo."],"da":["Anvend generelt for periodika."],"de":["Im Allgemeinen trifft dieses Element auf ein sukzessives Werk zu.,Im Allgemeinen trifft dieses Element auf ein sukzessives Werk zu."],"el":["Αυτή η σχέση βρίσκει γενική εφαρμογή στα περιοδικά."],"en":["This element applies in general to a successive work."],"es":["Este elemento aplica en general a una obra sucesiva."],"et":["Elementi rakendatakse peamiselt järgteose puhul."],"fi":["Tämä elementti soveltuu yleensä peräkkäisesti ilmestyvään teokseen."],"fr":["Cet élément s’applique généralement à une œuvre successive."],"hu":["Ez az elem általában a folyamatos művekre vonatkozik."],"it":["Generalmente questo elemento si applica a un'opera successiva"],"lv":["Šis elements vispārīgi attiecas uz secīgu darbu."],"nl":["Dit element is over het algemeen van toepassing op een successief werk."],"no":["Dette elementet gjelder som oftest for et påfølgende verk."],"tr":["Bu öğe, genel olarak ardşık bir eser için geçerlidir."],"vi":["Mối quan hệ này áp dụng tổng quát cho ấn phẩm nhiều kỳ."],"zh-Hans-CN":["该元素一般适用于一种相继作品。"]},"altLabel":{"ar":["مستمر في جزء من (عمل)"],"ca":["continuat en part per (obra)"],"cs":["navazuje částečně dílo"],"de":["Teilweise aufgegangen in (Werk),Teilweise aufgegangen in (Werk)"],"en":["continued in part by (work)"],"es":["continuada en parte por (obra)"],"fi":["jatkuu osittain teoksessa"],"fr":["continué en partie par (œuvre)"],"hu":["részekben folytatódik a következőben (mű):"],"it":["continuata in parte da opera"],"no":["fortsettes delvis i verk"],"tr":["(eserin) bir kısmı ile devam edilir"],"zh-Hans-CN":["部分被继承（作品）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en", "label":"is succeeded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/separatedIntoWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10104", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/separatedIntoWork.en", "label":"is separated into work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10104", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/separatedIntoWork.en", "label":"is separated into work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10020","label":{"ar":"له عمل تتمة","ca":"té com a obra de seqüela","cs":"má sequel (dílo)","da":"har værk, som er efterfølger","de":"hat Sequel (Werk)","de":"hat Sequel (Werk)","el":"είναι συνέχεια","en":"has sequel work","es":"tiene obra secuela","et":"järg (teos)","fi":"jatko-osa (teos)","fr":"a pour suite (œuvre)","hu":"folytatása a következő:","it":"ha come opera successiva","lv":"darbs: pēcstāsts","nl":"heeft sequel-werk","no":"har etterfølger (verk)","tr":"sonraki eser ile ilişkilidir","vi":"là tiếp theo","zh-Hans-CN":"有续篇作品"},"definition":{"ar":["يربط عمل بعمل يمتد من خلاله سرد عمل آخر للأمام عبر الزمن."],"ca":["Relaciona una obra amb una obra que allarga el contingut narratiu d’una altra obra cap endavant en el temps."],"cs":["Vztahuje dílo k dílu, které rozšiřuje děj jiného díla kupředu v čase."],"da":["Relaterer et værk til et værk, som forlænger et andet værks fortælling i tid."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Erzählstrang eines anderen Werks zeitlich vorwärts erweitert.,Setzt ein Werk in Beziehung zu einem Werk, das den Erzählstrang eines anderen Werks zeitlich vorwärts erweitert."],"el":["Συνδέει ένα έργο με ένα μεταγενέστερο έργο που συνεχίζει την αφήγηση ενός προηγούμενου έργου."],"en":["Relates a work to a work that extends the narrative of another work forwards in time."],"es":["Relaciona una obra con una obra que extiende la narrativa de otra obra hacia adelante en el tiempo."],"et":["Seostab teose teosega, mis laiendab teise teose sündmuste esitust ajas edasi."],"fi":["Liittää teoksen teokseen, joka laajentaa toisen teoksen kerrontaa ajassa eteenpäin."],"fr":["Met une œuvre en relation avec une œuvre qui prolonge le récit d’une autre œuvre sur une période plus récente dans le temps."],"hu":["Hozzákapcsol egy művet egy műhoz, amely kiterjeszti egy másik mű narratíváját időben előre."],"it":["Correla un’opera a un’opera la cui narrazione è proseguita da un'altra opera consecutiva."],"lv":["Sasaista darbu ar darbu (sīkvels), kura sižets risinās pēc sākotnējā darba notikumu laika."],"nl":["Relateert een werk aan een werk dat de narratie van een ander werk uitbreidt, voorwaarts in de tijd."],"no":["Relaterer et verk til et verk hvor hendelsesforløpet fra et annet verk fortsetter i tid."],"tr":["Bir eseri, başka bir eserin anlatısını zamanda ileriye götüren bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sau này tiếp tục chuyện kể của tác phẩm trước đây."],"zh-Hans-CN":["将一种作品与把另一种作品的叙述在时间上往前延伸的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل تتمة","ca":"obra de seqüela","cs":"sequel (dílo)","da":"værk, som er efterfølger","de":"Sequel (Werk)","de":"Sequel (Werk)","el":"είναι συνέχεια","en":"sequel work","es":"obra secuela","et":"järg (teos)","fi":"jatko-osa (teos)","fr":"suite (œuvre)","hu":"folytatásmű:","it":"opera successiva","lv":"darbs: pēcstāsts","nl":"sequel-werk","no":"etterfølger (verk)","tr":"devam eseri","vi":"tiếp theo","zh-Hans-CN":"续篇作品"},"ToolkitDefinition":{"ar":"عمل يمتد من خلاله سرد عمل آخر للأمام عبر الزمن.","ca":"Obra que allarga el contingut narratiu d’una altra obra cap endavant en el temps.","cs":"Dílo, které rozšiřuje děj jiného díla kupředu v čase.","da":"Værk, som forlænger et andet værks fortælling i tid.","de":"Ein Werk, das den Erzählstrang eines anderen Werks zeitlich vorwärts erweitert.","de":"Ein Werk, das den Erzählstrang eines anderen Werks zeitlich vorwärts erweitert.","el":"Ένα μεταγενέστερο έργο που συνεχίζει την αφήγηση ενός προηγούμενου έργου.","en":"A work that extends the narrative of another work forwards in time.","es":"Una obra con una obra que extiende la narrativa de otra obra hacia adelante en el tiempo.","et":"Teos, mis laiendab teise teose sündmuste esitust ajas edasi.","fi":"Teos, joka laajentaa toisen teoksen kerrontaa ajassa eteenpäin.","fr":"Œuvre qui prolonge le récit d’une autre œuvre sur une période plus récente dans le temps.","hu":"Egy mű, amely kiterjeszti egy másik mű narratíváját időben előre.","it":"Opera la cui narrazione è proseguita da un'altra opera consecutiva.","lv":"Darbs (sīkvels), kura sižets risinās pēc sākotnējā darba notikumu laika.","nl":"Een werk dat de narratie van een ander werk uitbreidt, voorwaarts in de tijd.","no":"Et verk hvor hendelsesforløpet fra et annet verk fortsetter i tid.","tr":"Başka bir eserin anlatısını zaman içerisinde ileriye doğru uzatan bir eser.","vi":"Tác phẩm sau này tiếp tục chuyện kể của tác phẩm trước đây.","zh-Hans-CN":"把另一种作品的叙述在时间上往前延伸的一种作品"},"altLabel":{"ar":["بادئة"],"ca":[","],"cs":["sequel,prequel k"],"da":["forløber til"],"de":["Sequel,Prequel"],"en":["sequel,prequel to"],"es":["secuela,precuela de"],"fi":[","],"fr":["suite,antépisode de"],"hu":[","],"it":["prequel di"],"nl":[","],"no":["forløper til"],"tr":["sonraki eser,önceki eseri"],"zh-Hans-CN":["续篇,……的前篇"],"zh-Hant-TW":[","]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/sequelWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10020", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sequelWork.en", "label":"has sequel work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10020", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sequelWork.en", "label":"has sequel work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10379","label":{"ar":"له إصدارة متتالية","ca":"té com a versió seqüencial","cs":"má sekvenční verzi","da":"har efterfølgende version","de":"hat fortlaufende Version","de":"hat fortlaufende Version","en":"has sequential version","es":"tiene versión secuencial","et":"järjestikune versioon","fi":"peräkkäisversio","fr":"a pour version séquentielle","hu":"szekvenciális változata a következő:","it":"ha come versione sequenziale","lv":"secīgā versija","nl":"heeft sequentiële versie","no":"har etterfølgende versjon","tr":"sonraki sürüm ile ilişkilidir","zh-Hans-CN":"有序列版本"},"definition":{"ar":["يربط عمل بعمل يتم إنشاؤه عن طريق تغيير خطة توسع لعمل من متكامل إلى متتالٍ."],"ca":["Relaciona una obra amb una obra que es crea canviant el pla d’extensió d’una obra d’integrant a successiu."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou plánu rozšíření díla z integračního na postupně vydávané."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre udvidelsesplanen for et værk fra integrerende til fortløbende."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Erweiterungsplans eines Werks von integrierend auf sukzessiv erstellt wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Erweiterungsplans eines Werks von integrierend auf sukzessiv erstellt wird."],"en":["Relates a work to a work that is created by changing the extension plan of a work from integrating to successive."],"es":["Relaciona una obra con una obra que se crea cambiando el plan de extensión de una obra de integradora a sucesiva."],"et":["Seostab teose teosega, mis on loodud, muutes teose jätkamiskava täienevast järjestikuseks."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen laajennussuunnitelmaa päivittyvästä peräkkäiseksi."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le plan d’extension intégrateur d’une œuvre en plan successif."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű közlési tervének integrálóról folyamatossá való változásával jött létre."],"it":["Correla un'opera a un'opera creata cambiando il piano di estensione di un'opera da integrativo a consecutivo."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba paplašināšanas plānu no veselā uz secīgo."],"nl":["Relateert een werk aan een werk dat gevormd is door het extensieplan te veranderen van geïntegreerd naar successief."],"no":["Relaterer et verk til et verk som er skapt ved endring av utvidelsesplanen for et verk fra integrerende til fortløpende."],"tr":["Bir eseri, bir eserin genişletme planını birleştiriciden ardışık hale değiştirilerek oluşturulan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过将一种作品的扩充计划从集成性改变为相继性而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة متتالية","ca":"versió seqüencial","cs":"sekvenční verze","da":"efterfølgende version","de":"Fortlaufende Version","de":"Fortlaufende Version","en":"sequential version","es":"versión secuencial","et":"järjestikune versioon","fi":"peräkkäisversio","fr":"version séquentielle","hu":"szekvenciális változata:","it":"versione sequenziale","lv":"secīgā versija","nl":