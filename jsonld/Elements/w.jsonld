                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en", "label":"has music work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProgramMusicWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10241", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/televisionProgramMusicWork.en", "label":"has television program music work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10241", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/televisionProgramMusicWork.en", "label":"has television program music work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10096","label":{"ar":"هو معالج كعمل سيناريو تليفزيون","ca":"és adaptat com a obra de guió de televisió","cs":"je adaptováno jako televizní scénář (dílo)","da":"er bearbejdet til tv-manuskriptværk","de":"ist bearbeitet als Fernsehdrehbuch (Werk)","de":"ist bearbeitet als Fernsehdrehbuch (Werk)","el":"είναι προσαρμοσμένο ως τηλεοπτικό σενάριο (έργο)","en":"is adapted as television screenplay work","es":"es adaptada como obra de guion de televisión","et":"adapteeritud telestsenaariumina (teos)","fi":"sovitettu televisiokäsikirjoitukseksi (teos)","fr":"est adapté en scénario de télévision (œuvre)","hu":"tévésforgatókönyvmű-feldolgozása a következő:","it":"è adattata come opera in forma di sceneggiatura televisiva","lv":"ir adaptēts kā televīzijas raidījuma scenārijs (darbs)","nl":"is bewerkt als televiescenariowerk","no":"er bearbeidet som manus for fjernsyn (verk)","tr":"televizyon senaryosu eseri olarak uyarlanmıştır","vi":"được phỏng theo như là tác phẩm kịch bản truyền hình","zh-Hans-CN":"被改编为电视节目剧本作品"},"definition":{"ar":["يربط عمل بعمل يتكون من سيناريو فيلم سينمائي لبرنامج تليفزيوني، مبني على عمل آخر."],"ca":["Relaciona una obra amb una obra que consisteix en un guió d’un programa de televisió basat en una altra obra."],"cs":["Vztahuje dílo k dílu, které sestává ze scénáře k televiznímu programu, založeného na jiném díle."],"da":["Relaterer et værk til et værk, som består af et manuskript til et tv-program, baseret på et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einem Drehbuch für eine Fernsehsendung besteht, das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Werk, das aus einem Drehbuch für eine Fernsehsendung besteht, das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα έργο που συνίσταται από ένα σενάριο για ένα τηλεοπτικό πρόγραμμα βασισμένο σε ένα έργο-πηγή."],"en":["Relates a work to a work that consists of a screenplay for a television program, based on another work."],"es":["Relaciona una obra con una obra que consiste en un guion para un programa de televisión basado en otra obra."],"et":["Seostab teose teosega, mis on allikteosel põhinev stsenaarium telesaate jaoks."],"fi":["Liittää teoksen teokseen, joka koostuu toiseen teokseen perustuvasta televisio-ohjelman käsikirjoituksesta."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un scénario d’émission de télévision basé sur une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik művön alapuló televízióműsor forgatókönyvéből áll."],"it":["Correla un’opera a un’opera che consiste di una sceneggiatura per un programma televisivo, basata su un’opera di partenza."],"lv":["Sasaista darbu ar darbu - televīzijas raidījuma scenārijs veidots pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat bestaat uit een scenario voor een televisieprogramma, gebaseerd op een ander werk."],"no":["Relaterer et verk til et verk som består av et manuskript for et fjernsynsprogram, basert på et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan bir televizyon programı senaryosundan oluşan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa kịch bản của chương trình truyền hình, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与由基于另一种作品的一种电视节目的剧本组成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل سيناريو تليفزيون","ca":"adaptat com a obra de guió de televisió","cs":"adaptováno jako televizní scénář (dílo)","da":"bearbejdet til tv-manuskriptværk","de":"Bearbeitet als Fernsehdrehbuch (Werk)","de":"Bearbeitet als Fernsehdrehbuch (Werk)","el":"προσαρμοσμένο ως τηλεοπτικό σενάριο (έργο)","en":"adapted as television screenplay work","es":"adaptada como obra de guion de televisión","et":"adapteeritud telestsenaariumina (teos)","fi":"sovitettu televisiokäsikirjoitukseksi (teos)","fr":"adapté en scénario de télévision (œuvre)","hu":"tévésforgatókönyv-feldolgozása a következő:","it":"adattata come opera in forma di sceneggiatura televisiva","lv":"adaptēts kā darbs: televīzijas raidījuma scenārijs","nl":"bewerkt als televiescenariowerk","no":"bearbeidet som manus for fjernsyn (verk)","tr":"Televizyon senaryosu çalışması olarak uyarlanan","vi":"được phỏng theo như là kịch bản truyền hình (tác phẩm)","zh-Hans-CN":"被改编为电视节目剧本作品"},"ToolkitDefinition":{"ar":"عمل يتكون من سيناريو فيلم سينمائي لبرنامج تليفزيوني، مبني على عمل آخر.","ca":"Obra que consisteix en un guió d’un programa de televisió basat en una altra obra.","cs":"Dílo, které sestává ze scénáře k televiznímu programu, založeného na jiném díle.","da":"Værk, som består af et manuskript til et tv-program, baseret på et oprindeligt værk.","de":"Ein Werk, das aus einem Drehbuch für eine Fernsehsendung besteht, das auf einem anderen Werk basiert.","de":"Ein Werk, das aus einem Drehbuch für eine Fernsehsendung besteht, das auf einem anderen Werk basiert.","el":"Ένα έργο που συνίσταται από ένα σενάριο για ένα τηλεοπτικό πρόγραμμα βασισμένο σε ένα έργο-πηγή.","en":"A work that consists of a screenplay for a television program, based on another work.","es":"Una obra que consiste en un guion para un programa de televisión basado en otra obra.","et":"Teos, mis on allikteosel põhinev stsenaarium telesaate jaoks.","fi":"Teos, joka koostuu toiseen teokseen perustuvasta televisio-ohjelman käsikirjoituksesta.","fr":"Œuvre qui consiste en un scénario d’émission de télévision basé sur une autre œuvre.","hu":"Egy mű, amely egy másik művön alapuló televízióműsor forgatókönyvéből áll.","it":"Opera che consiste di una sceneggiatura per un programma televisivo, basata su un’opera di partenza.","lv":"Darbs - televīzijas raidījuma scenārijs veidots pēc pamatdarba.","nl":"Een werk dat bestaat uit een scenario voor een televisieprogramma, gebaseerd op een ander werk.","no":"Et verk som består av et manuskript for et fjernsynsprogram, basert på et kildeverk.","tr":"Başka bir esere dayalı olarak bir televizyon programı için yazılmış bir senaryodan oluşan eser.","vi":"Tác phẩm có chứa kịch bản của chương trình truyền hình, dựa trên tác phẩm nguồn.","zh-Hans-CN":"由基于另一种作品的一种电视节目的剧本组成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
