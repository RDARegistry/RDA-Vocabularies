":["note du catalogueur,explication d’une relation"],"hu":[","],"it":["nota del catalogatore"],"nl":[","],"tr":["katologcu notu,ilişkinin açıklaması"],"zh-Hans-CN":["编目员的附注,关系的解释"],"zh-Hant-TW":[","]},"ToolkitLabel":{"ar":"تبصرة عن عمل ميتاداتا","ca":"nota sobre una obra de metadades","cs":"poznámka o metadatech (dílo)","da":"note om metadataværk","de":"Anmerkung zum Metadatenwerk","de":"Anmerkung zum Metadatenwerk","en":"note on metadata work","es":"nota sobre obra de metadatos","et":"märkus metaandmeteose kohta","fi":"huomautus metatietoteoksesta","fr":"note sur une œuvre de métadonnées","hu":"megjegyzés a metaadatműről","it":"nota su opera di metadati","lv":"piezīme par metadatiem","nl":"noot bij metadatawerk","no":"note om metadataverk","tr":"Üstveri çalışması hakkında not","zh-Hans-CN":"关于元数据作品的附注"},"ToolkitDefinition":{"ar":"وصف عام غير محدد لخاصية أو أكثر من خصائص عمل الميتاداتا.","ca":"Descripció no estructurada àmplia d’un o més atributs d’una obra de metadades.","cs":"Obecný nestrukturovaný popis jednoho nebo více atributů metadatového díla.","da":"Bred, ustruktureret beskrivelse af en eller flere af et metadataværks attributter.","de":"Eine umfassende, unstrukturierte Beschreibung eines Merkmals oder mehrerer Merkmale eines Metadatenwerks.","de":"Eine umfassende, unstrukturierte Beschreibung eines Merkmals oder mehrerer Merkmale eines Metadatenwerks.","en":"A broad unstructured description of one or more attributes of a metadata work.","es":"Una descripción amplia y no estructurada de uno o más atributos de una obra de metadatos.","et":"Üldine struktureerimata kirjeldus, mis iseloomustab üht või mitut metaandmeteose omadust.","fi":"Laaja rakenteistamaton kuvailu yhdestä tai useammasta metatietoteoksen attribuutista.","fr":"Description non structurée générale d’un ou plusieurs attributs d’une œuvre de métadonnées.","hu":"Egy metaadatmű egy vagy több ismérvének átfogó, strukturálatlan leírása.","it":"Descrizione non strutturata estesa di uno o più attributi