                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/dedicatorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10578", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorFamilyOfWork.en", "label":"has creator family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10461", "lexicalAlias":"http://rdaregistry.info/Elements/w/dedicatorCollectiveAgent.en", "label":"has dedicator collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10555", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/dedicatorFamily.en", "label":"has dedicator family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10555", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/dedicatorFamily.en", "label":"has dedicator family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10414","label":{"ar":"له شخص مُهدي","ca":"té com a persona dedicant","cs":"má dedikátora (osobu)","da":"har person, som er dedikationsskriver","de":"hat Widmende/Widmenden (Person)","de":"hat Widmende/Widmenden (Person)","en":"has dedicator person","es":"tiene dedicatoria de persona","et":"pühendaja (isik)","fi":"omistuksen tekijä (henkilö)","fr":"a pour personne dédicatrice d’une œuvre","hu":"dedikáló személye a következő:","it":"ha come dedicante persona","lv":"veltītājs (persona)","nl":"heeft opdrager-persoon","no":"har dediserende person","tr":"ithaf eden kişisi ile ilişkilidir","zh-Hans-CN":"有题献者个人"},"definition":{"ar":["يربط بين عمل وشخص يعين عملًا كإقرار بإلهام وكيل ذي صلة أو دعمه."],"ca":["Relaciona una obra amb una persona que assigna una obra com a reconeixement per la inspiració o el suport d’un agent relacionat."],"cs":["Vztahuje dílo k osobě, která připisuje dílo souvisejícímu agentovi jako ocenění inspirace nebo podpory."],"da":["Relaterer et værk til en person, som tilegner et værk til en relateret agent, som en anerkendelse af inspiration eller støtte."],"de":["Setzt ein Werk in Beziehung zu einer Person, die ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet.,Setzt ein Werk in Beziehung zu einer Person, die ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet."],"en":["Relates a work to a person who assigns a work as an acknowledgement of the inspiration or support of a related agent."],"es":["Relaciona una obra con una persona que le asigna una obra como reconocimiento a la inspiración o apoyo de un agente relacionado."],"et":["Seostab teose isikuga, kes pühendab teose tänuavaldusena innustust või toetust jaganud seotud tegijale."],"fi":["Liittää teoksen henkilöön, joka nimittää teoksen tunnustukseksi siihen liittyvän toimijan innoituksesta tai tuesta."],"fr":["Met une œuvre en relation avec une personne qui dédie une œuvre en reconnaissance de l’inspiration ou du soutien d’un agent en relation."],"hu":["Hozzákapcsol egy művet egy személyhez, aki köszönetképpen megjelöl egy művet egy kapcsolódó ágens inspirációjáért, támogatásáért cserébe."],"it":["Correla un'opera a una persona che dedica un'opera come riconoscimento dell'ispirazione o del sostegno di un agente correlato."],"lv":["Sasaista darbu ar personu, kura velta darbu pateicībā par saistītā aģenta iedvesmojumu vai atbalstu."],"nl":["Relateert een werk aan een persoon die een werk toekent als erkenning van de inspiratie of hulp van een gerelateerde actor."],"no":["Relaterer et verk til en person som tildeler et verk som anerkjennelse for inspirasjon eller støtte fra en relatert agent."],"tr":["Bir eseri, ilgili bir temsilcinin ilhamı veya desteğinin bir teşekkürü olarak bir eseri atfeden kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与指定一种作品作为一个相关行为者的启发或支持之感谢的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مُهدي","ca":"persona dedicant","cs":"dedikátor (osoba)","da":"person, som er dedikationsskriver","de":"Widmende/Widmender (Person)","de":"Widmende/Widmender (Person)","en":"dedicator person","es":"dedicatoria de persona","et":"pühendaja (isik)","fi":"omistuksen tekijä (henkilö)","fr":"personne dédicatrice d’une œuvre","hu":"dedikáló személy:","it":"dedicante persona","lv":"veltītājs (persona)","nl":"opdrager-persoon","no":"dediserende person","tr":"adayan kişi","zh-Hans-CN":"题献者个人"},"ToolkitDefinition":{"ar":"شخص يعين عملًا كإقرار بإلهام وكيل ذي صلة أو دعمه.","ca":"Persona que assigna una obra com a reconeixement per la inspiració o el suport d’un agent relacionat.","cs":"Osoba, která připisuje dílo souvisejícímu agentovi jako ocenění inspirace nebo podpory.","da":"Person, som tilegner et værk til en relateret agent, som en anerkendelse af inspiration eller støtte.","de":"Eine Person, die ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet.","de":"Eine Person, die ein Werk als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur widmet.","en":"A person who assigns a work as an acknowledgement of the inspiration or support of a related agent.","es":"Una persona que le asigna una obra como reconocimiento a la inspiración o apoyo de un agente relacionado.","et":"Isik, kes pühendab teose tänuavaldusena innustust või toetust jaganud seotud tegijale.","fi":"Henkilö, joka nimittää teoksen tunnustukseksi siihen liittyvän toimijan innoituksesta tai tuesta.","fr":"Personne qui dédie une œuvre en reconnaissance de l’inspiration ou du soutien d’un agent en relation.","hu":"Egy személy, aki köszönetképpen megjelöl egy művet egy kapcsolódó ágens inspirációjáért, támogatásáért cserébe.","it":"Persona che dedica un'opera come riconoscimento dell'ispirazione o del sostegno di un agente correlato.","lv":"Persona, kura velta darbu pateicībā par saistītā aģenta iedvesmojumu vai atbalstu.","nl":"Een persoon die een werk toekent als erkenning van de inspiratie of hulp van een gerelateerde actor.","no":"En person som tildeler et verk som anerkjennelse for inspirasjon eller støtte fra en relatert agent.","tr":"İlgili bir temsilcinin fikir ya da desteğinin teşekkürü olarak bir eseri atfeden kişi.","zh-Hans-CN":"指定一种作品作为一个相关行为者的启发或支持之感谢的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/dedicatorPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10048", "lexicalAlias":"http://rdaregistry.info/Elements/w/dedicatorAgent.en", "label":"has dedicator agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10414", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/dedicatorPerson.en", "label":"has dedicator person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10414", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/dedicatorPerson.en", "label":"has dedicator person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10040","ToolkitLabel":{"ca":"acusat","da":"sagsøgte","de":"Angeklagter/Beklagter","el":"εναγόμενος","es":"acusado","fi":"vastaaja","fr":"défendeur","no":"saksøkte","vi":"bị đơn"},"ToolkitDefinition":{"ca":"Persona o entitat corporativa que és acusada en un procés penal o demandada en un procés civil.","da":"Person eller korporation, der er anklaget i en straffesag eller sagsøgt i en civil sag.","de":"Eine Person oder eine Körperschaft, die in einem Strafverfahren angeklagt oder in einem Zivilprozess verklagt ist.","el":"Ένα φυσικό πρόσωπο ή συλλογικό όργανο, το οποίο έχει κατηγορηθεί σε μία ποινική διαδικασία ή έχει ασκηθεί αγωγή εναντίον του στο πλαίσιο αστικής διαδικασίας.","es":"Una persona o entidad corporativa que es acusada en un proceso penal o demandada en un proceso civil.","fi":"Henkilö tai yhteisö, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne siviiliprosessissa","fr":"Personne ou collectivité qui est accusée dans une poursuite criminelle ou contre laquelle une poursuite civile est intentée.","no":"En person eller korporasjon som er tiltalt i en straffesak eller saksøkt i en sivilrettslig sak.","vi":"Cá nhân hoặc tập thể bị buộc tội trong vụ kiện hình sự hoặc bị kiện trong vụ kiện dân sự."},"label":{"ca":"té com a acusat","da":"har sagsøgte","de":"hat Angeklagten/Beklagten","el":"έχει εναγόμενο","fi":"vastaaja","fr":"a pour défendeur","vi":"có bị đơn"},"definition":{"ca":["Relaciona una obra amb una persona o entitat corporativa que és acusada en un procés penal o demandada en un procés civil."],"da":["Relaterer et værk til en person eller korporation, der er anklaget i en straffesag eller sagsøgt i en civil sag."],"de":["Setzt ein Werk mit einer Person oder einer Körperschaft, die in einem Strafverfahren angeklagt oder in einem Zivilprozess verklagt ist, in Beziehung."],"el":["Συνδέει ένα έργο με ένα φυσικό πρόσωπο ή συλλογικό όργανο, το οποίο έχει κατηγορηθεί σε μία ποινική διαδικασία ή έχει ασκηθεί αγωγή εναντίον του στο πλαίσιο αστικής διαδικασίας."],"fi":["Liittää teoksen henkilöön tai yhteisöön, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne siviiliprosessissa"],"fr":["Met une œuvre en relation avec une personne ou une collectivité qui est accusée dans une poursuite criminelle ou contre laquelle une poursuite civile est intentée."],"vi":["Liên kết tác phẩm với cá nhân hoặc tập thể bị buộc tội trong vụ kiện hình sự hoặc bị kiện trong vụ kiện dân sự."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10047", "lexicalAlias":"http://rdaregistry.info/Elements/w/otherAgentWork.en", "label":"has other agent associated with work (Deprecated)"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/defendant.en","instructionNumber":"18.5"},{"@id":"http://rdaregistry.info/Elements/w/P10229","note":{"ca":["Les obres derivades inclouen sumaris, resums, compendis, adaptacions, dramatitzacions, novel·litzacions, guions, traduccions lliures, paràfrasis, imitacions, paròdies, etc."],"da":["Afledte værker inkluderer resumeer, abstracts, sammenfatninger, bearbejdelser, dramatiseringer, omskrivninger til roman, manuskripter, frie oversættelser, parafraser, imitationer, parodier etc."],"de":["Zu abgeleiteten Werken gehören Zusammenfassungen, Abstracts, Digests, Bearbeitungen, Bühnenbearbeitungen, Romanbearbeitungen, freie Übersetzungen, Paraphrasen, Imitationen, Parodien usw."],"el":["Τα παράγωγα έργα περιλαμβάνουν περιλήψεις, επιτομές, προσαρμογές, δραματοποιήσεις, μυθιστοριογραφήσεις, σενάρια, ελεύθερες μεταφράσεις, παραφράσεις, μιμήσεις, παρωδίες κ.λπ."],"en":["Derivative works include summaries, abstracts, digests, adaptations, dramatizations, novelizations, screenplays, free translations, paraphrases, imitations, parodies, etc."],"fr":["Les œuvres dérivées comprennent les résumés, y compris les résumés analytiques, les condensés, les adaptations, les novélisations, les scénarios, les traductions libres, les paraphrases, les imitations, les parodies, etc."],"vi":["Tác phẩm dẫn xuất bao gồm cả tóm lược, tóm tắt, vựng tập, phỏng theo, kịch hoá, tiểu thuyết hoá, kịch bản, bản dịch tự do, diễn giải, mô phỏng, nhại, v.v..."]},"ToolkitLabel":{"ca":"relació d’obra derivada","da":"afledt værkrelation","de":"Abgeleitete Beziehung auf Werkebene","el":"παράγωγη σχέση έργου με","es":"relaciones de obra derivada","fi":"teoksen johdannaissuhde","fr":"relation d’œuvre dérivée","no":"relasjonstypen avledet verk","vi":"mối quan hệ tác phẩm dẫn xuấti"},"ToolkitDefinition":{"ca":"Obra que es basa o deriva d’una altra obra.","da":"Værk, der er baseret på eller er en afledning af et værk.","de":"Ein Werk, das auf einer Ableitung eines anderen Werks basiert oder eine Ableitung eines anderen Werks ist.","el":"Ένα έργο το οποίο βασίζεται σε ή είναι παράγωγο ενός άλλου έργου.","es":"Una obra que se basa en, o es un derivado de la obra.","fi":"Teos, joka perustuu toiseen teokseen tai on johdettu toisesta teoksesta. Johdettuja teoksia ovat yhteenvedot, abtraktit, mukautetut lyhennelmät, mukaelmat, dramatisoinnit, romaanimukaelmat, käsikirjoitukset, vapaamuotoiset käännökset, parafraasit, jäljitelmat, parodiat tms.","fr":"Œuvre qui est basée sur une autre œuvre ou en constitue un dérivé.","no":"Et verk som er basert på eller avledet fra et annet verk.","vi":"Tác phẩm dựa trên hoặc là dẫn xuất của tác phẩm khác."},"label":{"ca":"té com a relació d’obra derivada","da":"har afledt værkrelation med","de":"hat abgeleitete Beziehung auf Werkebene","el":"έχει παράγωγη σχέση έργου με","fi":"teoksen johdannaissuhde","fr":"a pour relation d’œuvre dérivée","vi":"có mối quan hệ tác phẩm dẫn xuất với"},"definition":{"ca":["Relaciona una obra amb una obra que es basa o deriva d’una altra obra."],"da":["Relaterer et værk til et værk, der er baseret på eller er en afledning af et værk."],"de":["Setzt ein Werk mit einem Werk, das auf einer Ableitung eines anderen Werks basiert oder eine Ableitung eines anderen Werks ist, in Beziehung."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο βασίζεται σε ή είναι παράγωγο ενός άλλου έργου."],"fi":["Liittää teoksen teokseen, joka perustuu toiseen teokseen tai on johdettu toisesta teoksesta."],"fr":["Met une œuvre en relation avec une œuvre qui est basée sur une autre œuvre ou en constitue un dérivé."],"vi":["Liên kết tác phẩm với tác phẩm dựa trên hoặc là dẫn xuất của tác phẩm khác."]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
