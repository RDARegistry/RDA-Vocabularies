                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/grantingInstitutionOrFaculty.en","instructionNumber":"7.9.3","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10311", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedAgentOfWork.en", "label":"has related agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10208", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/grantingInstitutionOrFaculty.en", "label":"has granting institution or faculty (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10208", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/grantingInstitutionOrFaculty.en", "label":"has granting institution or faculty (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10393","label":{"ar":"له وكيل مجمع","ca":"té com a agent agregador","cs":"má agregátora (agenta)","da":"har agent, som er samler","de":"hat Aggregatorin/Aggregator (Akteur)","de":"hat Aggregatorin/Aggregator (Akteur)","en":"has aggregator agent","es":"tiene agente agregador","et":"liitja (tegija)","fi":"aggregaattori (toimija)","fr":"a pour agent agrégateur","hu":"aggregátor ágense a következő:","it":"ha come aggregatore agente","lv":"apkopotājs (aģents)","nl":"heeft aggregator-actor","no":"har aggregator (agent)","tr":"toplayıcı temsilci ile ilişkilidir","zh-Hans-CN":"有合集编者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن إنشاء عمل مجمع عن طريق اختيار تعبيرات أعمال أخرى وترتيبها."],"ca":["Relaciona una obra amb un agent que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za vytvoření agregačního díla výběrem a uspořádáním vyjádření jiných děl."],"da":["Relaterer et værk til en agent, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für die Erstellung eines aggregierenden Werks verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.,Setzt ein Werk in Beziehung zu einem Akteur, der für die Erstellung eines aggregierenden Werks verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt."],"en":["Relates a work to an agent who is responsible for creating an aggregating work by selecting and arranging expressions of other works."],"es":["Relaciona una obra con un agente quees responsable de crear una obra agregada seleccionando y ordenando expresiones de otras obras."],"et":["Seostab teose tegijaga, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused."],"fi":["Liittää teoksen toimijaan, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén."],"it":["Correla un'opera all'agente responsabile della creazione di un'opera aggregata attraverso la selezione e l'organizzazione di espressioni di altre opere."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par darba-apkopojumu radīšanu, atlasot un sakārtojot citu darbu izteiksmes."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken."],"no":["Relaterer et verk til en agent som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk."],"tr":["Bir eseri, diğer eserlerin anlatımlarını seçerek ve düzenleyerek toplu bir eser yapmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责把其他作品的内容表达选择和整理后创作一种合集性作品的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مجمع","ca":"agent agregador","cs":"agregátor (agent)","da":"agent, som er samler","de":"Aggregatorin/Aggregator (Akteur)","de":"Aggregatorin/Aggregator (Akteur)","en":"aggregator agent","es":"agente agregador","et":"liitja (tegija)","fi":"aggregaattori (toimija)","fr":"agent agrégateur","hu":"aggregátor ágens:","it":"aggregatore agente","lv":"apkopotājs (aģents)","nl":"aggregator-actor","no":"aggregator (agent)","tr":"Toplayıcı temsilci","zh-Hans-CN":"合集编者行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن إنشاء عمل مجمع عن طريق اختيار تعبيرات أعمال أخرى وترتيبها.","ca":"Agent que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres.","cs":"Agent, který je odpovědný za vytvoření agregačního díla výběrem a uspořádáním vyjádření jiných děl.","da":"Agent, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk.","de":"Ein Akteur, der für die Erstellung eines aggregierenden Werks verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","de":"Ein Akteur, der für die Erstellung eines aggregierenden Werks verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.","en":"An agent who is responsible for creating an aggregating work by selecting and arranging expressions of other works.","es":"Un agente quees responsable de crear una obra agregada seleccionando y ordenando expresiones de otras obras.","et":"Tegija, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused.","fi":"Toimija, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.","fr":"Agent qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres.","hu":"Egy ágens, amely felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén.","it":"Agente responsabile per la creazione di un'opera aggregata attraverso la selezione e l'organizzazione di espressioni di altre opere.","lv":"Aģents, kas ir atbildīgs par darba-apkopojumu radīšanu, atlasot un sakārtojot citu darbu izteiksmes","nl":"Een actor die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken.","no":"En agent som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk.","tr":"Diğer eserlerin ifadelerini seçerek ve düzenleyerek toplu çalışma oluşturmaktan sorumlu olan bir temsilci.","zh-Hans-CN":"负责把其他作品的内容表达选择和整理后创作一种合集性作品的一个行为者"},"altLabel":{"ar":["مجمع"],"ca":["agregador"],"cs":["agregátor"],"da":["aggregator"],"de":["Aggregate"],"en":["aggregator"],"es":["agregador"],"et":["liitja"],"fi":["aggregaattori"],"fr":["agrégateur"],"hu":["aggregátor:"],"no":["aggregator"],"tr":["Toplayıcı"],"zh-Hans-CN":["合集编者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
