ra.","lv":"Temats, par ko ir darbs.","nl":"Een onderwerp waar een werk over gaat.","no":"Et emne som verket handler om.","tr":"Bir eserin konusu.","vi":"Thuật ngữ, cụm từ, chỉ số phân loại, v.v..., chỉ ra tác phẩm nói về cái gì.","zh-Hans-CN":"一种作品所关于的一个论题"},"altLabel":{"ar":["علاقة موضوع"],"ca":["relació de matèria"],"cs":["vztah k předmětu"],"de":["Themenbeziehung,Themenbeziehung"],"en":["subject relationship"],"es":["relación de tema"],"fi":["aihesuhde"],"fr":["relation de sujet"],"hu":["tárgyi típusú kapcsolat"],"tr":["konu alınan ilişki"],"zh-Hans-CN":["主题关系"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
