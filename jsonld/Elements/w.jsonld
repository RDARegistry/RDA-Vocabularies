ische beschouwing.","no":"Et eksemplar brukt som utgangspunkt for en kritisk evaluering.","vi":"Bản được dùng như là cơ sở cho đánh giá phê bình."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"lexicalAlias":"http://rdaregistry.info/Elements/w/critiqueOfItem.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10265", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfItem.en", "label":"is description of item"}],"instructionNumber":"23.5","status": {
