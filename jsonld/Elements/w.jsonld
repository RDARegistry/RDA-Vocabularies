                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/regionalVersionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10384", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudienceOf.en", "label":"is transformation by audience of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10389", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/regionalVersionOf.en", "label":"is regional version of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10389", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/regionalVersionOf.en", "label":"is regional version of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10405","label":{"ar":"له كيان مرتبط بعمل","ca":"té com a entitat relacionada amb una obra","cs":"má entitu související s dílem","da":"har entitet relateret til værk","de":"hat mit Werk in Beziehung stehende Entität","de":"hat mit Werk in Beziehung stehende Entität","en":"has related entity of work","es":"tiene entidad de obra relacionada","et":"teosega seotud olem","fi":"teokseen liittyvä entiteetti","fr":"a pour entité en relation avec une œuvre","hu":"mű kapcsolódó entitása a következő:","it":"ha come entità correlata di opera","lv":"ar darbu saistītā entīte","nl":"heeft gerelateerde entiteit van werk","no":"har relatert entitet for verk","tr":"eserin ilgili varlığı ile ilişkilidir","zh-Hans-CN":"有作品的关联实体"},"definition":{"ar":["يربط بين عمل وكيان مرتبط بعمل."],"ca":["Relaciona una obra amb una entitat que s’associa amb una obra."],"cs":["Vztahuje dílo k entitě, která souvisí s dílem."],"da":["Relaterer et værk til en entitet, som er knyttet til et værk."],"de":["Setzt ein Werk in Beziehung zu einer Entität, die mit einem Werk in Verbindung steht.,Setzt ein Werk in Beziehung zu einer Entität, die mit einem Werk in Verbindung steht."],"en":["Relates a work to an entity that is associated with a work."],"es":["Relaciona una obra con una entidad que está asociada a una obra."],"et":["Seostab teose teosega seotud olemiga."],"fi":["Liittää teoksen entiteettiin, joka liittyy teokseen."],"fr":["Met une œuvre en relation avec une entité qui est associée à une œuvre."],"hu":["Hozzákapcsol egy művet egy entitáshoz, amelyet egy műhöz társítanak."],"it":["Correla un'opera a un'entità associata a un'opera."],"lv":["Sasaista darbu ar entīti, kas saistīta ar darbu."],"nl":["Relateert een werk aan een entitieit die is geassocieerd met een werk."],"no":["Relaterer et verk til en entitet som forbindes med et verk."],"tr":["Bir eseri, bir eserle bağlantılı olan bir varlıkla ilişkilendirir."],"zh-Hans-CN":["将一种作品与和一种作品有关的一个实体关联起来。"]},"ToolkitLabel":{"ar":"كيان مرتبط بعمل","ca":"entitat relacionada amb una obra","cs":"entita související s dílem","da":"entitet relateret til værk","de":"mit Werk in Beziehung stehende Entität","de":"mit Werk in Beziehung stehende Entität","en":"related entity of work","es":"entidad de obra relacionada","et":"teosega seotud olem","fi":"teokseen liittyvä entiteetti","fr":"entité en relation avec une œuvre","hu":"mű kapcsolódó entitása:","it":"entità correlata di opera","lv":"ar darbu saistītā entīte","nl":"gerelateerde entiteit van werk","no":"relatert entitet for verk","tr":"Eserin ilşkili olduğu varlık","zh-Hans-CN":"作品的关联实体"},"ToolkitDefinition":{"ar":"كيان مرتبط بعمل.","ca":"Entitat que s’associa amb una obra.","cs":"Entita, která souvisí s dílem.","da":"Entitet, som er knyttet til et værk.","de":"Eine Entität, die mit einem Werk in Verbindung steht.","de":"Eine Entität, die mit einem Werk in Verbindung steht.","en":"An entity that is associated with a work.","es":"Una entidad que está asociada a una obra.","et":"Teosega seotud olem.","fi":"Entiteetti, joka liittyy teokseen.","fr":"Entité qui est associée à une œuvre.","hu":"