                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10064", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerAgent.en", "label":"has producer agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProducerAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10471", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProducerCollectiveAgent.en", "label":"has television producer collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10424", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionProducerPerson.en", "label":"has television producer person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10075", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/televisionProducerAgent.en", "label":"has television producer agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10075", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/televisionProducerAgent.en", "label":"has television producer agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10471","label":{"ar":"له وكيل جماعي منتج تليفزيوني","ca":"té com a agent col·lectiu productor de televisió","cs":"má televizního producenta (kolektivního agenta)","da":"har kollektiv agent, som er tv-producer","de":"hat Fernsehproduzentin/Fernsehproduzenten (Gemeinschaftlicher Akteur)","de":"hat Fernsehproduzentin/Fernsehproduzenten (Gemeinschaftlicher Akteur)","en":"has television producer collective agent","es":"tiene agente colectivo productor de televisión","et":"teleprodutsent (kollektiiv)","fi":"televisiotuottaja (yhteistoimija)","fr":"a pour agent collectif producteur de télévision","hu":"televízióproducer kollektív ágense a következő:","it":"ha come produttore televisivo agent