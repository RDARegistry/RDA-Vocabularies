                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedInVerseAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10023", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedInVerseAsWork.en", "label":"is adapted in verse as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10023", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedInVerseAsWork.en", "label":"is adapted in verse as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10097","label":{"ar":"هو معالج كعمل سيناريو فيديو","ca":"és adaptat com a obra de guió de vídeo","cs":"je adaptováno jako scénář pro video (dílo)","da":"er bearbejdet til videomanuskriptværk","de":"ist bearbeitet als Videodrehbuch (Werk)","de":"ist bearbeitet als Videodrehbuch (Werk)","el":"είναι προσαρμοσμένο ως σενάριο για βίντεο (έργο)","en":"is adapted as video screenplay work","es":"es adaptada como obra de guion de video","et":"adapteeritud videostsenaariumina (teos)","fi":"sovitettu videokäsikirjoitukseksi (teos)","fr":"est adapté en scénario de vidéo (œuvre)","hu":"videóforgatókönyv-feldolgozása a következő:","it":"è adattata come opera in forma di sceneggiatura per video","lv":"ir adaptēts kā videoscenārijs (darbs)","nl":"is bewerkt als videoscenariowerk","no":"er bearbeidet som manus for video (verk)","tr":"video senaryosu eseri olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản video (tác phẩm)","zh-Hans-CN":"被改编为视频剧本作品"},"definition":{"ar":["يربط عمل بعمل يتكون من سيناريو فيلم سينمائي لفيديو، مبني على عمل آخر."],"ca":["Relaciona una obra amb una obra que consisteix en un guió d’un vídeo basat en una altra obra."],"cs":["Vztahuje dílo k dílu, které sestává ze scénáře k videu, založeného na jiném díle."],"da":["Relaterer et værk til et værk, som består af et manuskript til en video, baseret på et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einem Drehbuch für ein Video besteht, das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Werk, das aus einem Drehbuch für ein Video besteht, das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα έργο που συνίσταται από ένα σενάριο για ένα βίντεο βασισμένο σε ένα έργο-πηγή."],"en":["Relates a work to a work that consists of a screenplay for a video, based on another work."],"es":["Relaciona una obra con una obra que consiste en un guion para un video basado en otra obra."],"et":["Seostab teose teosega, mis on allikteosel põhinev stsenaarium video jaoks."],"fi":["Liittää teoksen teokseen, joka koostuu toiseen teokseen perustuvasta videokäsikirjoituksesta."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un scénario de vidéo basé sur une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik művön alapuló videó forgatókönyvéből áll."],"it":["Correla un’opera a un’opera che consiste di una sceneggiatura per un video, basata su un’opera di partenza."],"lv":["Sasaista darbu ar darbu - videoscenārijs, veidots pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat bestaat uit een scenario voor een video, gebaseerd op een ander werk."],"no":["Relaterer et verk til et verk som består av et manuskript for en video, basert på et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan bir video senaryosundan oluşan eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa kịch bản của video, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与由基于另一种作品的一种视频的剧本组成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل سيناريو فيديو","ca":"adaptat com a obra de guió de vídeo","cs":"adaptováno jako scénář pro video (dílo)","da":"bearbejdet til videomanuskriptværk","de":"Bearbeitet als Videodrehbuch (Werk)","de":"Bearbeitet als Videodrehbuch (Werk)","el":"προσαρμοσμένο ως σενάριο για βίντεο (έργο)","en":"adapted as video screenplay work","es":"adaptada como obra de guion de video","et":"adapteeritud videostsenaariumina (teos)","fi":"sovitettu videokäsikirjoitukseksi (teos)","fr":"adapté en scénario de vidéo (œuvre)","hu":"videóforgatókönyv-feldolgozása a következő:","it":"adattata come opera in forma di sceneggiatura per video","lv":"adaptēts kā darbs: videoscenārijs","nl":"bewerkt als videoscenariowerk","no":"bearbeidet som manus for video (verk)","tr":"Video senaryosu çalışması olarak uyarlanan","vi":"được phỏng theo như là tác phẩm kịch bản video","zh-Hans-CN":"被改编为视频剧本作品"},"ToolkitDefinition":{"ar":"عمل يتكون من سيناريو فيلم سينمائي لفيديو، مبني على عمل آخر.","ca":"Obra que consisteix en un guió d’un vídeo basat en una altra obra.","cs":"Dílo, které sestává ze scénáře k videu, založeného na jiném díle.","da":"Værk, som består af et manuskript til en video, baseret på et oprindeligt værk.","de":"Ein Werk, das aus einem Drehbuch für ein Video besteht, das auf einem anderen Werk basiert.","de":"Ein Werk, das aus einem Drehbuch für ein Video besteht, das auf einem anderen Werk basiert.","el":"Ένα έργο που συνίσταται από ένα σενάριο για ένα βίντεο βασισμένο σε ένα έργο-πηγή.","en":"A work that consists of a screenplay for a video, based on another work.","es":"Una obra que consiste en un guion para un video basado en otra obra.","et":"Teos, mis on allikteosel põhinev stsenaarium video jaoks.","fi":"Teos, joka koostuu toiseen teokseen perustuvasta videokäsikirjoituksesta.","fr":"Œuvre qui consiste en un scénario de vidéo basé sur une autre œuvre.","hu":"Egy mű, amely egy másik művön alapuló videó forgatókönyvéből áll.","it":"Opera che consiste di una sceneggiatura per un video, basata su un’opera di partenza.","lv":"Darbs - videoscenārijs, veidots pēc pamatdarba.","nl":"Een werk dat bestaat uit een scenario voor een video, gebaseerd op een ander werk.","no":"Et verk som består av et manuskript for en video, basert på et kildeverk.","tr":"Başka bir esere dayalı olarak bir video için yazılmış bir senaryodan oluşan eser.","vi":"Tác phẩm có chứa kịch bản của video, dựa trên tác phẩm nguồn.","zh-Hans-CN":"由基于另一种作品的一种视频的剧本组成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
