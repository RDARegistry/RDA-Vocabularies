                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/consultantCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10071", "lexicalAlias":"http://rdaregistry.info/Elements/w/consultantAgent.en", "label":"has consultant agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10552", "lexicalAlias":"http://rdaregistry.info/Elements/w/consultantCorporateBody.en", "label":"has consultant corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10599", "lexicalAlias":"http://rdaregistry.info/Elements/w/consultantFamily.en", "label":"has consultant family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10505", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/consultantCollectiveAgent.en", "label":"has consultant collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10505", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/consultantCollectiveAgent.en", "label":"has consultant collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10552","label":{"ar":"له هيئة استشارية","ca":"té com a entitat corporativa consultora","cs":"má konzultanta (korporaci)","da":"har korporation, som er rådgiver","de":"hat Beraterin/Berater (Körperschaft)","de":"hat Beraterin/Berater (Körperschaft)","en":"has consultant corporate body","es":"tiene organismo corporativo consultor","et":"konsultant (asutus)","fi":"asiantuntija (yhteisö)","fr":"a pour collectivité consultante","hu":"tanácsadó testülete a következő:","it":"ha come consulente ente","lv":"konsultants (institūcija)","nl":"heeft consultant-corporatie","no":"har konsulent (korporasjon)","tr":"danışman tüzel kişi ile ilişkilidir","zh-Hans-CN":"有顾问团体"},"definition":{"ar":["يربط بين عمل وهيئة تقدم خدمات استشارية، وغالبًا ما تقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل."],"ca":["Relaciona una obra amb una entitat corporativa que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra."],"cs":["Vztahuje dílo ke korporaci, která poskytuje konzultační služby a často dává doporučení spřízněnému agentovi, který je prezentován jako tvůrce díla."],"da":["Relaterer et værk til en korporation, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistige Schöpferin/geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.,Setzt ein Werk in Beziehung zu einer Körperschaft, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistige Schöpferin/geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht."],"en":["Relates a work to a corporate body who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work."],"es":["Relaciona una obra con un organismo corporativo que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra."],"et":["Seostab teose asutusega, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina."],"fi":["Liittää teoksen yhteisöön, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä."],"fr":["Met une œuvre en relation avec une collectivité qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre."],"hu":["Hozzákapcsol egy művet egy testülethez, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek."],"it":["Correla un'opera a un ente che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come creatore di un'opera."],"lv":["Sasaista darbu ar institūciju, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs."],"nl":["Relateert een werk aan een corporatie die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk."],"no":["Relaterer et verk til en korporasjon som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk."],"tr":["Bir eseri, bir eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmetleri sağlayan ve genellikle tavsiyelerde bulunan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة استشارية","ca":"entitat corporativa consultora","cs":"konzultant (korporace)","da":"korporation, som er rådgiver","de":"Beraterin/Berater (Körperschaft)","de":"Beraterin/Berater (Körperschaft)","en":"consultant corporate body","es":"organismo corporativo consultor","et":"konsultant (asutus)","fi":"asiantuntija (yhteisö)","fr":"collectivité consultante","hu":"tanácsadó testület:","it":"consulente ente","lv":"konsultants (institūcija)","nl":"consultant-corporatie","no":"konsulent (korporasjon)","tr":"danışman tüzel kişisi","zh-Hans-CN":"顾问团体"},"ToolkitDefinition":{"ar":"هيئة تقدم خدمات استشارية، وغالبًا ما تقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل.","ca":"Entitat corporativa que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.","cs":"Korporace, která poskytuje konzultační služby a často dává doporučení spřízněnému agentovi, který je prezentován jako tvůrce díla.","da":"Korporation, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.","de":"Eine Körperschaft, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistige Schöpferin/geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.","de":"Eine Körperschaft, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistige Schöpferin/geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.","en":"A corporate body who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.","es":"Un organismo corporativo que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra.","et":"Asutus, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.","fi":"Yhteisö, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.","fr":"Collectivité qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.","hu":"Egy testület, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.","it":"Ente che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come creatore di un'opera.","lv":"Institūcija, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.","nl":"Een corporatie die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.","no":"En korporasjon som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk.","tr":"Bir tüzel kişi, bir eserin yaratıcısı olarak temsil edilen ilgili bir temsilciye danışmanlık hizmeti sunar ve sıkça önerilerde bulunur.","zh-Hans-CN":"向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
