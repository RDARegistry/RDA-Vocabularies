                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10159", "lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayWork.en", "label":"has screenplay work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/videoScreenplayWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10164", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/videoScreenplayWork.en", "label":"has video screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10164", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/videoScreenplayWork.en", "label":"has video screenplay work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10239","label":{"ar":"له عمل موسيقي لفيديو","ca":"té com a obra de música de vídeo","cs":"má hudbu (dílo) pro video","da":"har videomusikværk","de":"hat Videomusik (Werk)","de":"hat Videomusik (Werk)","el":"είναι βίντεο μουσική (έργο)","en":"has video music work","es":"tiene obra de video musical","et":"videofilmi muusika (teos)","fi":"videon musiikki (teos)","fr":"a pour musique de vidéo (œuvre)","hu":"videozene-műve a következő:","it":"ha come musica da video opera","lv":"darbs: videomūzika","nl":"heeft videomuziek-werk","no":"har videomusikk (verk)","tr":"video müziği eseri ile ilişkilidir","vi":"là âm nhạc video (tác phẩm)","zh-Hans-CN":"有视频音乐作品"},"definition":{"ar":["يربط عمل بعمل موسيقي يكمل عملًا عبارة عن فيديو."],"ca":["Relaciona una obra amb una obra que és una obra musical que complementa una obra que és un vídeo."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, doplňujícím dílo, které je videem."],"da":["Relaterer et værk til et musikværk, som komplementerer et værk, som er en video."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, das ein Video ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Videowerk ergänzt."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο το οποίο χρησιμοποιείται σε ένα βίντεο."],"en":["Relates a work to a work that is a musical work that complements a work that is a video."],"es":["Relaciona una obra con una obra que es una obra musical que complementa una obra que es un video."],"et":["Seostab teose muusikateosega, mis täiendab videofilmina esinevat teost."],"fi":["Liittää teoksen musiikkiteokseen, joka täydentää teosta, joka on video."],"fr":["Met une œuvre en relation avec une œuvre musicale qui complète une œuvre consistant en une vidéo."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amely kiegészít egy videóművet."],"it":["Correla un’opera a un’opera musicale che completa un’opera che è un video."],"lv":["Sasaista darbu ar mūzikas darbu, kas papildina darbu, kas ir video."],"nl":["Relateert een werk aan een muziekwerk dat een werk complementeert dat een video is."],"no":["Relaterer et verk til et musikalsk verk som utfyller en video."],"tr":["Bir eseri, video olan bir eser, tamamlayan müzik eseri olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc được sử dụng trong video."],"zh-Hans-CN":["将一种作品与作为一种音乐作品并补充作为一种视频的一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل موسيقى لفيديو","ca":"obra de música de vídeo","cs":"hudba (dílo) pro video","da":"videomusikværk","de":"Videomusik (Werk)","de":"Videomusik (Werk)","el":"βίντεο μουσική (έργο)","en":"video music work","es":"obra de video musical","et":"videofilmi muusika (teos)","fi":"videon musiikki (teos)","fr":"musique de vidéo (œuvre)","hu":"videózenemű","it":"musica da video opera","lv":"darbs: videomūzika","nl":"videomuziek-werk","no":"videomusikk (verk)","tr":"video müziği eseri","vi":"âm nhạc video (tác phẩm)","zh-Hans-CN":"视频音乐作品"},"ToolkitDefinition":{"ar":"عمل موسيقي يكمل عملًا عبارة عن فيديو.","ca":"Obra que és una obra musical que complementa una obra que és un vídeo.","cs":"Dílo, které je hudebním dílem, doplňujícím dílo, které je videem.","da":"Musikværk, som komplementerer et værk, som er en video.","de":"Ein Musikwerk, das ein Video ergänzt.","de":"Ein Musikwerk, das ein Video ergänzt.","el":"Ένα μουσικό έργο το οποίο χρησιμοποιείται σε ένα βίντεο.","en":"A work that is a musical work that complements a work that is a video.","es":"Una obra que es una obra musical que complementa una obra que es un video.","et":"Muusikateos, mis täiendab videofilmina esinevat teost.","fi":"Musiikkiteos, joka täydentää teosta, joka on video.","fr":"Œuvre musicale qui complète une œuvre consistant en une vidéo.","hu":"Egy mű, amely egy zenemű, amely kiegészít egy videóművet.","it":"Opera musicale che completa un’opera che è un video.","lv":"Mūzikas darbs, kas papildina darbu, kas ir video.","nl":"Een muziekwerk dat een werk complementeert dat een video is.","no":"Et musikalsk verk som utfyller en video.","tr":"Bir videoyu tamamlayan bir müzik eseri olan bir eser.","vi":"Tác phẩm âm nhạc được sử dụng trong video.","zh-Hans-CN":"作为一种音乐作品并补充作为一种视频的一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en", "label":"has music work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/videoMusicWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10239", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/videoMusicWork.en", "label":"has video music work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10239", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/videoMusicWork.en", "label":"has video music work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10121","label":{"ar":"هو عمل محلَّل في","ca":"és obra analitzada en","cs":"je dílem analyzovaným v","da":"er værk analyseret i","de":"ist Werk analysiert in","de":"ist Werk analysiert in","el":"αναλύεται στο (έργο)","en":"is work analysed in","es":"es obra analizada en","et":"teose analüüs","fi":"teoksen analyysi","fr":"est une œuvre analysée dans","hu":"mű elemezve a következőben:","it":"è opera analizzata in","lv":"ir darba analīze","nl":"is werk geanalyseerd in","no":"er verk analysert i","tr":"Eserin incelenmesidir","vi":"được phân tích trong (tác phẩm)","zh-Hans-CN":"是被分析于……的作品"},"definition":{"ar":["يربط عمل بعمل يصف بنية عمل آخر وتكوينه."],"ca":["Relaciona una obra amb una obra que descriu l’estructura i la composició d’una altra obra."],"cs":["Vztahuje dílo k dílu, které popisuje strukturu a kompozici jiného díla."],"da":["Relaterer et værk til et værk, som beskriver strukturen og sammensætning af et andet værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Aufbau und die Zusammensetzung eines anderen Werks beschreibt.,Setzt ein Werk in Beziehung zu einem Werk, das den Aufbau und die Zusammensetzung eines anderen Werks beschreibt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο εξετάζει ένα έργο-πηγή για την ταύτιση των συστατικών του και τις σχέσεις τους."],"en":["Relates a work to a work that describes the structure and composition of another work."],"es":["Relaciona una obra con una obra que describe la estructura y composición de otra obra."],"et":["Seostab teose teosega, milles kirjeldatakse teise teose struktuuri ja kompositsiooni."],"fi":["Liittää teoksen teokseen, joka kuvaa toisen teoksen rakennetta ja koostumusta."],"fr":["Met une œuvre en relation avec une œuvre qui décrit la structure et la composition d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy másik mű vizsgál, hogy leírhassa annak alkotóelemeit és azok viszonyait."],"it":["Correla un’opera a un’opera che descrive struttura e composizione di un’altra opera."],"lv":["Sasaista darbu ar darbu, kas analizē pamatdarba sastāvdaļas un to attiecības."],"nl":["Relateert een werk aan een werk dat de structuur en compositie beschrijft van een ander werk."],"no":["Relaterer et verk til et verk som beskriver strukturen og oppbyggingen av et annet verk."],"tr":["Bir eseri, başka bir eserin yapısını ve içeriğini tanımlayan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm kiểm tra tác phẩm nguồn để nhận dạng các bộ phận cấu thành và quan hệ của chúng."],"zh-Hans-CN":["将一种作品与描述另一种作品的结构和创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل محلَّل في","ca":"obra analitzada en","cs":"dílo analyzované v","da":"værk analyseret i","de":"Werk analysiert in","de":"Werk analysiert in","el":"αναλύεται στο (έργο)","en":"work analysed in","es":"obra analizada en","et":"teose analüüs","fi":"teoksen analyysi","fr":"œuvre analysée dans","hu":"mű elemezve a következőben:","it":"opera analizzata in","lv":"darba analīze","nl":"werk geanalyseerd in","no":"verk analysert i","tr":"eser içinde analiz edilen","vi":"được phân tích trong (tác phẩm)","zh-Hans-CN":"被分析于……的作品"},"ToolkitDefinition":{"ar":"عمل يصف بنية عمل آخر وتكوينه.","ca":"Obra que descriu l’estructura i la composició d’una altra obra.","cs":"Dílo, které popisuje strukturu a kompozici jiného díla.","da":"Værk, som beskriver strukturen og sammensætning af et andet værk.","de":"Ein Werk, das den Aufbau und die Zusammensetzung eines anderen Werks beschreibt.","de":"Ein Werk, das den Aufbau und die Zusammensetzung eines anderen Werks beschreibt.","el":"Ένα έργο το οποίο εξετάζει ένα έργο-πηγή για την ταύτιση των συστατικών του και τις σχέσεις τους.","en":"A work that describes the structure and composition of another work.","es":"Una obra que describe la estructura y composición de otra obra.","et":"Teos, milles kirjeldatakse teise teose struktuuri ja kompositsiooni.","fi":"Teos, joka kuvaa toisen teoksen rakennetta ja koostumusta.","fr":"Œuvre qui décrit la structure et la composition d’une autre œuvre.","hu":"Egy mű, amelyet egy másik mű vizsgál, hogy leírhassa annak alkotóelemeit és azok viszonyait.","it":"Opera che descrive struttura e composizione di un’altra opera.","lv":"Darbs, kas analizē pamatdarba sastāvdaļas un to attiecības.","nl":"Een werk dat de structuur en compositie beschrijft van een ander werk.","no":"Et verk som beskriver strukturen og oppbyggingen av et annet verk.","tr":"Başka bir eserin yapı ve kompozisyonunu tanımlayan bir eser.","vi":"Tác phẩm kiểm tra tác phẩm nguồn để nhận dạng các bộ phận cấu thành và quan hệ của chúng.","zh-Hans-CN":"描述另一种作品的结构和创作的一种作品"},"altLabel":{"ar":["محلَّل في (عمل)"],"ca":["analitzat en (obra)"],"cs":["analyzováno v (díle)"],"da":["analyseret i værk"],"de":["Analysiert in (Werk),Analysiert in (Werk)"],"en":["analysed in (work)"],"es":["analizado en (obra)"],"fi":["analysoitu teoksessa"],"fr":["analysé dans (œuvre)"],"hu":["elemezve a következőben (mű):"],"it":["analizzata in (opera)"],"nl":["geanalyseerd in (werk)"],"no":["analysert i (verk)"],"tr":["analiz edilen (eser)"],"zh-Hans-CN":["被分析于（作品）"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
