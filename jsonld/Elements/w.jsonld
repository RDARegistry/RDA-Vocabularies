                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10170", "lexicalAlias":"http://rdaregistry.info/Elements/w/succeededByWork.en", "label":"is succeeded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/prequelTo.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10195", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/prequelTo.en", "label":"is prequel to (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10195", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/prequelTo.en", "label":"is prequel to (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10361","label":{"ar":"هو تقييم لكيان \"وام\"","ca":"és avaluació d’una entitat RDA","cs":"je hodnocením entity RDA","da":"er evaluering af RDA-entitet","de":"ist Evaluierung von (RDA-Entität)","de":"ist Evaluierung von (RDA-Entität)","en":"is evaluation of RDA entity","es":"es la evaluación de la entidad RDA","et":"hinnang RDA olemile","fi":"arviointi RDA-entiteetistä","fr":"est une évaluation d’une entité RDA","hu":"értékelése a következő RDA-entitásnak:","it":"è valutazione di entità RDA","lv":"ir novērtējums RDA entītei","nl":"is beschouwing van RDA-entiteit","no":"er evaluering av RDA-entitet","tr":"RDA varlığının değerlendirmesidir","zh-Hans-CN":"是RDA实体的评价"},"definition":{"ar":["يربط بين عمل وكيان \"وام\" الذي يتم فحصه أو الحكم عليه."],"ca":["Relaciona una obra amb una entitat RDA que és examinada o jutjada per una obra."],"cs":["Vztahuje dílo k entitě RDA, která je zkoumána nebo hodnocena v díle."],"da":["Relaterer et værk til en RDA-entitet, som er undersøgt eller bedømt."],"de":["Setzt ein Werk in Beziehung zu einer RDA-Entität, die untersucht oder beurteilt wird.,Setzt ein Werk in Beziehung zu einer RDA-Entität, die untersucht oder beurteilt wird."],"en":["Relates a work to an RDA entity that is examined or judged by a work."],"es":["Relaciona una obra con una entidad RDA que es examinada o juzgada por una obra."],"et":["Seostab teose RDA olemiga, mida on kontrollitud või hinnatud."],"fi":["Liittää teoksen RDA-entiteettiin, jota on tutkittu tai arvioitu."],"fr":["Met une œuvre en relation avec une entité RDA qui est examinée ou jugée par une œuvre."],"hu":["Hozzákapcsol egy művet egy RDA-entitáshoz, amelyet egy mű által elemeznek és megítélnek."],"it":["Correla un’opera a un’entità RDA che è esaminata o valutata."],"lv":["Sasaista darbu ar RDA entīti, kas tiek pārbaudīta vai vērtēta."],"nl":["Relateert een werk aan een RDA-entiteit die onderzocht of beoordeeld wordt door een werk."],"no":["Relaterer et verk til en RDA-entitet som er utforsket eller vurdert."],"tr":["Bir eseri, bir eser tarafından incelenen veya yargılanan bir RDA varlığıyla ilişkilendirir."],"zh-Hans-CN":["将一种作品与被一种作品检查或评判的一种RDA实体关联起来。"]},"ToolkitLabel":{"ar":"تقييم لكيان \"وام\"","ca":"avaluació d’una entitat RDA","cs":"hodnocení entity RDA","da":"evaluering af RDA-entitet","de":"Evaluierung von (RDA-Entität)","de":"Evaluierung von (RDA-Entität)","en":"evaluation of RDA entity","es":"evaluación de la entidad RDA","et":"hinnang RDA olemile","fi":"arviointi RDA-entiteetistä","fr":"évaluation d’une entité RDA","hu":"értékelt RDA-entitás","it":"valutazione di entità RDA","lv":"novērtējums RDA entītei","nl":"beschouwing van RDA-entiteit","no":"evaluering av RDA-entitet","tr":"RDA varlığının değerlendirilmesi","zh-Hans-CN":"RDA实体的评价"},"ToolkitDefinition":{"ar":"كيان \"وام\" الذي يتم فحصه أو الحكم عليه.","ca":"Entitat RDA que és examinada o jutjada per una obra.","cs":"Entita RDA, která je zkoumána nebo hodnocena v díle.","da":"RDA-entitet, som er undersøgt eller bedømt.","de":"Eine RDA-Entität, die untersucht oder beurteilt wird.","de":"Eine RDA-Entität, die untersucht oder beurteilt wird.","en":"An RDA entity that is examined or judged by a work.","es":"Una entidad RDA que es examinada o juzgada por una obra.","et":"RDA olem, mida on kontrollitud või hinnatud.","fi":"RDA-entiteetti, jota on tutkittu tai arvioitu.","fr":"Entité RDA qui est examinée ou jugée par une œuvre.","hu":"Egy RDA-entitás, amelyet egy mű által elemeznek és megítélnek.","it":"Entità RDA che è esaminata o valutata.","lv":"RDA entīte, kas tiek pārbaudīta vai vērtēta.","nl":"Een RDA-entiteit die onderzocht of beoordeeld wordt.","no":"En RDA-entitet som er utforsket eller vurdert.","tr":"Bir eser tarafından incelenen veya değerlendirilen bir RDA varlığı.","zh-Hans-CN":"被一种作品检查或评判的一种RDA实体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
