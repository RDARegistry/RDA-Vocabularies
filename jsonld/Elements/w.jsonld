                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/librettistCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10483", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorCollectiveAgent.en", "label":"has author collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10205", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistAgent.en", "label":"has librettist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10525", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistCorporateBody.en", "label":"has librettist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10572", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistFamily.en", "label":"has librettist family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10478", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettistCollectiveAgent.en", "label":"has librettist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10478", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettistCollectiveAgent.en", "label":"has librettist collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10525","label":{"ar":"له هيئة مؤلفة أوبرالية","ca":"té com a entitat corporativa llibretista","cs":"má libretistu (korporaci)","da":"har korporation, som er librettist","de":"hat Librettistin/Librettisten (Körperschaft)","de":"hat Librettistin/Librettisten (Körperschaft)","en":"has librettist corporate body","es":"tiene cuerpo corporativo libretista","et":"libretist (asutus)","fi":"libretisti (yhteisö)","fr":"a pour collectivité librettiste","hu":"librettista testülete a következő:","it":"ha come librettista ente","lv":"libretists (institūcija)","nl":"heeft librettist-corporatie","no":"har librettist (korporasjon)","tr":"libretto yazarı tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有台本作者团体"},"definition":{"ar":["يربط بين عمل وهيئة مؤلفة لكلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية."],"ca":["Relaciona una obra amb una entitat corporativa que és un autor de les paraules d’un musical o una obra coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori."],"cs":["Vztahuje dílo ke korporaci, která je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium."],"da":["Relaterer et værk til en korporation, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium."],"en":["Relates a work to a corporate body who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con un cuerpo corporativo que es autor de las letras de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio."],"et":["Seostab teose asutusega, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor."],"fi":["Liittää teoksen yhteisöön, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec une collectivité autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művet egy szerző testülethez, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un'opera a un ente autore delle parole di un musical o opera coreografica, come un'opera, balletto, o altra opera per il teatro musicale, o per un oratorio."],"lv":["Sasaista darbu ar institūciju, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai."],"nl":["Relateert een werk aan een corporatie die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til en korporasjon som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzikal sahne için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مؤلفة أوبرالية","ca":"entitat corporativa llibretista","cs":"libretista (korporace)","da":"korporation, som er librettist","de":"Librettistin/Librettist (Körperschaft)","de":"Librettistin/Librettist (Körperschaft)","en":"librettist corporate body","es":"cuerpo corporativo libretista","et":"libretist (asutus)","fi":"libretisti (yhteisö)","fr":"collectivité librettiste","hu":"librettista testület:","it":"librettista ente","lv":"libretists (institūcija)","nl":"librettist-corporatie","no":"librettist (korporasjon)","tr":"Opera metni yazarı tüzel kişilik","zh-Hans-CN":"台本作者团体"},"ToolkitDefinition":{"ar":"هيئة تكون مؤلفة لكلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.","ca":"Entitat corporativa que és un autor de les paraules d’un musical o una obra coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.","cs":"Korporace, která je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium.","da":"Korporation, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Eine Verfasserin/Ein Verfasser (Körperschaft)des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","de":"Eine Verfasserin/Ein Verfasser (Körperschaft)des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","en":"A corporate body who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Un cuerpo corporativo que es autor de las letras de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.","et":"Asutus, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.","fi":"Yhteisö, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.","fr":"Collectivité autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy szerző testület, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Ente autore delle parole di un musical o opera coreografica, come un'opera, balletto, o altra opera per il teatro musicale, o per un oratorio.","lv":"Institūcija, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.","nl":"Een corporatie die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"En korporasjon som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.","tr":"Opera, bale veya müzik sahnesi için başka bir çalışma veya oratoryo gibi bir müzikal veya koreografik çalışmanın sözlerinin yazarı olan bir tüzel kişi.","zh-Hans-CN":"作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个团体"},"note":{"ar":["يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només les paraules de les cançons d’un musical."],"cs":["Autorství textů pouze písní z muzikálu je vyloučeno."],"da":["Forfatter til kun sangteksterne i en musical er ikke omfattet."],"de":["Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.,Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter."],"en":["Authoring of the words of only the songs from a musical is excluded."],"es":["Se excluye la autoría de la letra únicamente de las canciones de un musical."],"et":["Ei hõlma üksnes muusikali laulusõnade kirjutamist."],"fi":["Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu."],"hu":["Musicaldalok szövegírója nem tartozik ide."],"it":["E' escluso essere autore delle parole delle sole canzoni di un musical."],"lv":["Neietver atsevišķu dziesmu tekstus mūziklos."],"nl":["Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten."],"no":["Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中只是歌曲的词著者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
