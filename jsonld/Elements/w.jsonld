                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/staticVersionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10378", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByExtensionPlanOf.en", "label":"is transformation by extension plan of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10392", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/staticVersionOf.en", "label":"is static version of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10392", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/staticVersionOf.en", "label":"is static version of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10324","label":{"ar":"له كيان \"وام\" موضوع","ca":"té com a entitat RDA de matèria","cs":"má předmět (entitu RDA)","da":"har RDA-entitet, som er subjekt","de":"hat Thema (RDA-Entität)","de":"hat Thema (RDA-Entität)","el":"έχει θέμα (οντότητα)","en":"has subject RDA entity","es":"tiene tema de entidad RDA","et":"teema (RDA olem)","fi":"aiheena oleva RDA-entiteetti","fr":"a pour entité RDA sujet","hu":"tárgya a következő entitás:","it":"ha come soggetto entità RDA","lv":"temats (RDA entīte)","nl":"heeft RDA-entiteit als onderwerp","no":"har emne RDA-entitet","tr":"konu alınan RDA varlığı ile ilişkilidir","vi":"có chủ đề (thực thể)","zh-Hans-CN":"有主题RDA实体"},"definition":{"ar":["يربط بين عمل وكيان \"وام\" يدور حوله عمل."],"ca":["Relaciona una obra amb una entitat RDA sobre la qual tracta una obra."],"cs":["Vztahuje dílo k entitě RDA, o níž dílo pojednává."],"da":["Relaterer et værk til en RDA-entitet, som et værk handler om."],"de":["Setzt ein Werk in Beziehung zu einer RDA-Entität, von der ein Werk handelt.,Setzt ein Werk in Beziehung zu einer RDA-Entität, von der ein Werk handelt."],"el":["Συνδέει ένα έργο με μια οντότητα στην οποία αναφέρεται ένα έργο."],"en":["Relates a work to an RDA entity that a work is about."],"es":["Relaciona una obra con una entidad RDA de la que trata una obra."],"et":["Seostab teose RDA olemiga, mille kohta teos on."],"fi":["Liittää teoksen RDA-entiteettiin, jota teos koskee."],"fr":["Met une œuvre en relation avec un entité RDA dont traite une œuvre."],"hu":["Hozzákapcsol egy művet egy RDA-entitáshoz, amelyről egy mű szól."],"it":["Correla un'opera con un'entità RDA di cui l'opera tratta."],"lv":["Sasaista darbu ar RDA entīti, par kuru ir darbs."],"nl":["Relateert een werk aan een RDA-entiteit waar een werk over gaat."],"no":["Relaterer et verk til en RDA-entitet som et verk handler om."],"tr":["Bir eseri, o eserin konusu olan bir RDA varlığıyla ilişkilendirir."],"vi":["Liên kết tác phẩm với thực thể mà tác phẩm nói về."],"zh-Hans-CN":["将一种作品与一种作品所关于的一个RDA实体关联起来。"]},"ToolkitDefinition":{"ar":"كيان \"وام\" يدور حوله عمل.","ca":"Entitat RDA sobre la qual tracta una obra.","cs":"Entita RDA, o níž dílo pojednává.","da":"RDA-entitet, som et værk handler om.","de":"Eine RDA-Entität, von der ein Werk handelt.","de":"Eine RDA-Entität, von der ein Werk handelt.","en":"An RDA entity that a work is about.","es":"Una entidad RDA de la que trata una obra.","et":"RDA olem, mille kohta teos on.","fi":"RDA-entiteetti, jota teos koskee.","fr":"Entité RDA dont traite une œuvre.","hu":"Egy RDA-entitás, amelyről egy mű szól.","it":"Entità RDA di cui l'opera tratta.","lv":"RDA entīte, par kuru ir darbs.","nl":"Een RDA-entiteit waar een werk over gaat.","no":"En RDA-entitet som et verk handler om.","tr":"Bir eserin konusu olan RDA varlığı.","vi":"Thực thể mà tác phẩm nói về.","zh-Hans-CN":"一种作品所关于的一个RDA实体"},"ToolkitLabel":{"ar":"كيان \"وام\" موضوع","ca":"entitat RDA de matèria","cs":"předmět (entita RDA)","da":"RDA-entitet, som er subjekt","de":"Thema (RDA-Entität)","de":"Thema (RDA-Entität)","en":"subject RDA entity","es":"tema de entidad RDA","et":"teema (RDA olem)","fi":"aiheena oleva RDA-entiteetti","fr":"entité RDA sujet","hu":"tárgyalt entitás:","it":"soggetto entità RDA","lv":"temats (RDA entīte)","nl":"RDA-entiteit als onderwerp","no":"emne RDA-entitet","tr":"konu alınan RDA varlığı","zh-Hans-CN":"主题RDA实体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
