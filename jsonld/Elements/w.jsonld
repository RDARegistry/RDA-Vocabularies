                                                                                    "label": "Deprecated"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/referentialWorkRelationship.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10296", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/referentialWorkRelationship.en", "label":"has referential work relationship with (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10296", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/referentialWorkRelationship.en", "label":"has referential work relationship with (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10034","label":{"ar":"هو معالج كعمل روائي","ca":"és adaptat com a obra de novel·la","cs":"je adaptováno jako román (dílo)","da":"er bearbejdet til romanværk","de":"ist bearbeitet als Roman (Werk)","de":"ist bearbeitet als Roman (Werk)","el":"είναι προσαρμοσμένο ως μυθιστόρημα (έργο)","en":"is adapted as novel work","es":"es adaptado como obra de novela","et":"adapteeritud romaanina (teos)","fi":"romaanimukaelma (teos)","fr":"est adapté en roman (œuvre)","hu":"regényként való átdolgozása a következő mű:","it":"è adattata come opera in forma di romanzo","lv":"ir adaptēts kā romāns (darbs)","nl":"is bewerkt als romanwerk","no":"er bearbeidet som roman (verk)","tr":"roman eseri olarak uyarlanmıştır","vi":"được phỏng theo như là tác tiểu thuyết (tác phẩm)","zh-Hans-CN":"被改编为小说作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن رواية مقتبسة من عمل آخر."],"ca":["Relaciona una obra amb una obra que és una novel·la adaptada d’una altra obra."],"cs":["Vztahuje dílo k dílu, které je románem, adaptovaným z jiného díla."],"da":["Relaterer et værk til en roman, som er bearbejdet ud fra et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einem Roman (Werk), der auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Roman (Werk), der auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα μυθιστόρημα προσαρμοσμένο από ένα έργο-πηγή."],"en":["Relates a work to a work that is a novel adapted from another work."],"es":["Relaciona una obra con una obra que es una novela adaptada de otra obra."],"et":["Seostab teose allikteosest adapteeritud romaaniga."],"fi":["Liittää teoksen teokseen, joka on toisesta teoksesta sovitettu romaani."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un roman adapté d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy másik műhöz, egy regényhez, amelyet egy másik műből adaptáltak."],"it":["Correla un’opera a un romanzo adattato da un'opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir romāns adaptēts pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat is een roman bewerkt van een ander werk."],"no":["Relaterer et verk til en roman bearbeidet fra et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanmış bir roman olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tiểu thuyết được phỏng theo từ tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为改编自另一种作品的一种小说的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل روائي","ca":"adaptat com a obra de novel·la","cs":"adaptováno jako román (dílo)","da":"bearbejdet til romanværk","de":"Bearbeitet als Roman (Werk)","de":"Bearbeitet als Roman (Werk)","el":"προσαρμοσμένο ως μυθιστόρημα (έργο)","en":"adapted as novel work","es":"adaptado como obra de novela","et":"adapteeritud romaanina (teos)","fi":"romaanimukaelma (teos)","fr":"adapté en roman (œuvre)","hu":"regénymű-átdolgozás:","it":"adattata come in forma di romanzo","lv":"adaptēts kā darbs: romāns","nl":"bewerkt als romanwerk","no":"bearbeidet som roman (verk)","tr":"Roman eseri olarak uyarlanan","vi":"được phỏng theo như là tiểu thuyết (tác phẩm)","zh-Hans-CN":"被改编为小说作品"},"ToolkitDefinition":{"ar":"رواية مقتبسة من عمل آخر.","ca":"Obra que és una novel·la adaptada d’una altra obra.","cs":"Dílo, které je románem, adaptovaným z jiného díla.","da":"Roman, som er bearbejdet ud fra et oprindeligt værk.","de":"Ein Roman (Werk), der auf einem anderen Werk basiert.","de":"Ein Roman (Werk), der auf einem anderen Werk basiert.","el":"Ένα μυθιστόρημα προσαρμοσμένο από ένα έργο-πηγή.","en":"A work that is a novel adapted from another work.","es":"Una obra que es una novela adaptada de otra obra.","et":"Allikteosest adapteeritud romaan.","fi":"Teos, joka on toisesta teoksesta sovitettu romaani.","fr":"Œuvre qui consiste en un roman adapté d’une autre œuvre.","hu":"Egy mű, egy regény, amelyet egy másik műből adaptáltak.","it":"Romanzo adattato da un'opera di partenza.","lv":"Romāns adaptēts pēc pamatdarba.","nl":"Een werk dat is een roman bewerkt van een ander werk.","no":"En roman bearbeidet fra et kildeverk.","tr":"Başka bir eserden uyarlanmış bir roman olan bir eser.","vi":"Tiểu thuyết được phỏng theo từ tác phẩm nguồn.","zh-Hans-CN":"作为改编自另一种作品的一种小说的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
