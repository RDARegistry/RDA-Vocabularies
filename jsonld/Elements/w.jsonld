                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10156", "lexicalAlias":"http://rdaregistry.info/Elements/w/precededByWork.en", "label":"is preceded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/absorptionOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10224", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/absorptionOfWork.en", "label":"is absorption of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10224", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/absorptionOfWork.en", "label":"is absorption of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10182","label":{"ar":"هو نقد لعمل","ca":"és crítica d’una obra","cs":"je kritikou díla","da":"er kritik af værk","de":"ist Kritik von (Werk)","de":"ist Kritik von (Werk)","el":"είναι κριτική του (έργο)","en":"is critique of work","es":"es critica de la obra","et":"arvustatud teos","fi":"kritiikki teoksesta","fr":"est une critique d’une œuvre","hu":"bírálata a következő műnek:","it":"è critica di opera","lv":"ir kritika darbam","nl":"is kritiek van werk","no":"er kritikk av verk","tr":"eserin eleştirisidir","vi":"phê bình của (tác phẩm)","zh-Hans-CN":"是作品的批评"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لتقييم نقدي."],"ca":["Relaciona una obra amb una obra que és avaluada críticament per una obra."],"cs":["Vztahuje dílo k dílu, které je kriticky hodnoceno v díle."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for en kritisk evaluering."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine kritische Untersuchung verwendet wird.,Setzt ein Werk in Beziehung zu einem Werk, bei dem es sich um eine kritische Untersuchung eines Werks handelt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση."],"en":["Relates a work to a work that is critically evaluated by a work."],"es":["Relaciona una obra con una obra que es evaluada críticamente por una obra."],"et":["Seostab teose teosega, mis on aluseks kriitilisele hinnangule."],"fi":["Liittää teoksen teokseen, johon kriittinen arviointi perustuu."],"fr":["Met une œuvre en relation avec une œuvre qui fait l’objet d’une évaluation critique par une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy mű kritikailag kiértékel."],"it":["Correla un'opera a un'opera usata come base per una valutazione critica."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu kritikai."],"nl":["Relateert een werk aan een werk dat kritisch geëvalueerd wordt door een werk."],"no":["Relaterer et verk til et verk brukt som utgangspunkt for en kritisk evaluering."],"tr":["Bir eseri, bir çalışma tarafından eleştirel olarak değerlendirilen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho đánh giá phê bình."],"zh-Hans-CN":["将一种作品与被被一种作品批评性评价的一种作品关联起来。"]},"ToolkitLabel":{"ar":"نقد لعمل","ca":"crítica d’una obra","cs":"kritika díla","da":"kritik af værk","de":"Kritik von (Werk)","de":"Kritik von (Werk)","el":"κριτική του (έργο)","en":"critique of work","es":"critica de la obra","et":"arvustatud teos","fi":"kritiikki teoksesta","fr":"critique d’une œuvre","hu":"mű bírálata:","it":"critica di opera","lv":"kritika darbam","nl":"kritiek van werk","no":"kritikk av verk","tr":"eserin eleştirisi","vi":"phê bình của (tác phẩm)","zh-Hans-CN":"作品的批评"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لتقييم نقدي.","ca":"Obra que és avaluada críticament per una obra.","cs":"Dílo, které je kriticky hodnoceno v díle.","da":"Værk, som anvendes som grundlag for en kritisk evaluering.","de":"Ein Werk, das als Grundlage für eine kritische Untersuchung verwendet wird.","de":"Ein Werk, bei dem es sich um eine kritische Untersuchung eines Werks handelt.","el":"Ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση.","en":"A work that is critically evaluated by a work.","es":"Una obra que es evaluada críticamente por una obra.","et":"Teos, mis on aluseks kriitilisele hinnangule.","fi":"Teos, johon kriittinen arviointi perustuu.","fr":"Œuvre qui fait l’objet d’une évaluation critique par une œuvre.","hu":"Egy mű, amelyet egy mű kritikailag kiértékel.","it":"Opera usata come base per una valutazione critica.","lv":"Darbs, kas izmantots par pamatu kritikai.","nl":"Een werk dat kritisch geëvalueerd wordt door een werk.","no":"Et verk brukt som utgangspunkt for en kritisk evaluering.","tr":"Bir çalışma tarafından eleştirel olarak değerlendirilen bir çalışma.","vi":"Tác phẩm được sử dụng như là cơ sở cho đánh giá phê bình.","zh-Hans-CN":"被一种作品批评性评价的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
