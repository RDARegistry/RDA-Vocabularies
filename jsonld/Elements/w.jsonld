                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/filmProducerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10454", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerPerson.en", "label":"has producer person"},{"@id":"http://rdaregistry.info/Elements/w/P10073", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmProducerAgent.en", "label":"has film producer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10422", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/filmProducerPerson.en", "label":"has film producer person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10422", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/filmProducerPerson.en", "label":"has film producer person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10227","label":{"ca":"és seqüela de","da":"er efterfølger til","de":"ist Sequel zu","el":"είναι συνέχεια σε","en":"is sequel to (Deprecated)","fi":"jatko-osa teokselle","fr":"est une suite de","hu":"folytatás","vi":"là tác phẩm mở rộng của"},"definition":{"ca":["Relaciona una obra amb una obra el contingut narratiu de la qual és continuat per una obra posterior."],"da":["Relaterer et værk til et værk, hvis fortælling fortsættes af et senere værk."],"de":["Setzt ein Werk mit einem Werk, dessen Erzählung durch das spätere Werk fortgesetzt wird, in Beziehung."],"el":["Συνδέει ένα έργο με ένα έργο του οποίου η αφήγηση συνεχίζεται από ένα μεταγενέστερο έργο."],"en":["Relates a work to a work whose narrative is continued by a later work. (Deprecated)"],"fi":["Liittää teoksen teokseen, jonka sisältöä myöhemmin julkaistu teos juonellisesti jatkaa."],"fr":["Met une œuvre en relation avec une œuvre dont le récit est continué par une œuvre ultérieure."],"hu":["Egy művet hozzákapcsol egy műhöz, amelynek narratíváját egy későbbi mű folytatja."],"vi":["Liên kết tác phẩm với tác phẩm mà câu chuyện kể của nó được tiếp tục bởi nội dung của tác phẩm sau này."]},"ToolkitLabel":{"ca":"seqüela de","da":"efterfølger til","de":"Sequel zu","el":"συνέχεια σε","en":"sequel to (Deprecated)","es":"secuela de","fi":"jatko-osa teokselle","fr":"suite de","hu":"folytatása (mű)","no":"fortsettelse av","vi":"tác phẩm mở rộng của"},"ToolkitDefinition":{"ca":"Obra el contingut narratiu de la qual és continuat per una obra posterior.","da":"Værk, hvis fortælling fortsættes af et senere værk.","de":"Ein Werk, dessen Erzählung durch das spätere Werk fortgesetzt wird.","el":"Ένα έργο του οποίου η αφήγηση συνεχίζεται από ένα μεταγενέστερο έργο.","en":"A work whose narrative is continued by a later work. (Deprecated)","es":"La obra cuya narración se continúa en una obra posterior.","fi":"Teos, jonka sisältöä myöhemmin julkaistu teos juonellisesti jatkaa.","fr":"Œuvre dont le récit est continué par une œuvre ultérieure.","hu":"Egy mű, amelynek narratíváját egy későbbi mű folytatja.","no":"Et verk hvis historie fortsetter i et senere verk.","vi":"Tác phẩm mà câu chuyện kể của nó được tiếp tục bởi nội dung của tác phẩm sau này."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10156", "lexicalAlias":"http://rdaregistry.info/Elements/w/precededByWork.en", "label":"is preceded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/sequelTo.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10227", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/sequelTo.en", "label":"is sequel to (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10227", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/sequelTo.en", "label":"is sequel to (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10095","label":{"ar":"هو معالج كعمل سيناريو","ca":"és adaptat com a obra de guió","cs":"je adaptováno jako scénář (dílo)","da":"er bearbejdet til manuskriptværk","de":"ist bearbeitet als Drehbuch (Werk)","de":"ist bearbeitet als Drehbuch (Werk)","el":"είναι προσαρμοσμένο ως σενάριο (έργο)","en":"is adapted as screenplay work","es":"es adaptada como obra de guion","et":"adapteeritud stsenaariumina (teos)","fi":"sovitettu käsikirjoitukseksi (teos)","fr":"est adapté en scénario (œuvre)","hu":"forgatókönyvmű-feldolgozása a következő:","it":"è adattata come opera in forma di sceneggiatura","lv":"ir adaptēts kā scenārijs (darbs)","nl":"is bewerkt als scenariowerk","no":"er bearbeidet som manus for skuespill (verk)","tr":"senaryo eseri olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản (tác phẩm)","zh-Hans-CN":"被改编为影视剧本作品"},"definition":{"ar":["يربط عمل بعمل يتكون من سيناريو فيلم سينمائي، أو برنامج تليفزيوني، أو فيديو، مبني على عمل آخر."],"ca":["Relaciona una obra amb una obra que consisteix en un guió d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo basat en una altra obra."],"cs":["Vztahuje dílo k dílu, které sestává ze scénáře k filmu, televiznímu programu nebo videu, založeného na jiném díle."],"da":["Relaterer et værk til et værk, som består af et manuskript til en spillefilm, tv-program eller en video, baseret på et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht, das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Werk, das aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht, das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα έργο που που συνίσταται από ένα σενάριο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή ένα βίντεο βασισμένο σε ένα έργο-πηγή."],"en":["Relates a work to a work that consists of a screenplay for a motion picture, television program, or video, based on another work."],"es":["Relaciona una obra con una obra que consiste en un guion para una película, un programa de televisión o un video basado en otra obra."],"et":["Seostab teose teosega, mis on allikteosel põhinev stsenaarium filmi, telesaate või video jaoks."],"fi":["Liittää teoksen teokseen, joka koostuu toiseen teokseen perustuvasta elokuvan, televisio-ohjelman tai videon käsikirjoituksesta."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un scénario de film, d’émission de télévision ou de vidéo basé sur une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik művön alapuló mozgókép, televízióműsor vagy videó forgatókönyvéből áll."],"it":["Correla un’opera a un’opera che consiste di una sceneggiatura per un film, un programma televisivo o un video, basata su un’opera di partenza."],"lv":["Sasaista darbu ar darbu - kinofilmas, televīzijas uzveduma vai video scenārijs veidots pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat bestaat uit een scenario voor een speelfilm, televisieprogramma of video, gebaseerd op een ander werk."],"no":["Relaterer et verk til et verk som består av et manuskript for en spillefilm, et fjernsynsprogram eller en video, basert på et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan bir sinema filmi, televizyon programı veya video senaryosundan oluşan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa kịch bản của phim điện ảnh, chương trình truyền hình, hoặc video, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与由基于另一种作品的一种电影、电视节目或视频的剧本组成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل سيناريو","ca":"adaptat com a obra de guió","cs":"adaptováno jako scénář (dílo)","da":"bearbejdet til manuskriptværk","de":"Bearbeitet als Drehbuch (Werk)","de":"Bearbeitet als Drehbuch (Werk)","el":"προσαρμοσμένο ως σενάριο (έργο)","en":"adapted as screenplay work","es":"adaptada como obra de guion","et":"adapteeritud stsenaariumina (teos)","fi":"sovitettu käsikirjoitukseksi (teos)","fr":"adapté en scénario (œuvre)","hu":"forgatókönyvmű-átdolgozás:","it":"adattata come opera in forma di sceneggiatura","lv":"adaptēts kā darbs: scenārijs","nl":"bewerkt als scenariowerk","no":"bearbeidet som manus for skuespill (verk)","tr":"Senaryo çalışması olarak uyarlanan","vi":"được phỏng theo như là kịch bản (tác phẩm)","zh-Hans-CN":"被改编为影视剧本作品"},"ToolkitDefinition":{"ar":"عمل يتكون من سيناريو فيلم سينمائي، أو برنامج تليفزيوني، أو فيديو، مبني على عمل آخر.","ca":"Obra que consisteix en un guió d’una pel·lícula cinematogràfica, un programa de televisió o un vídeo basat en una altra obra.","cs":"Dílo, které sestává ze scénáře k filmu, televiznímu programu nebo videu, založeného na jiném díle.","da":"Værk, som består af et manuskript til en spillefilm, tv-program eller en video, baseret på et oprindeligt værk.","de":"Ein Werk, das aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht, das auf einem andern Werk basiert.","de":"Ein Werk, das aus einem Drehbuch für einen Film, eine Fernsehsendung oder ein Video besteht, das auf einem andern Werk basiert.","el":"Ένα έργο που που συνίσταται από ένα σενάριο για μια κινηματογραφική ταινία, ένα τηλεοπτικό πρόγραμμα ή ένα βίντεο βασισμένο σε ένα έργο-πηγή.","en":"A work that consists of a screenplay for a motion picture, television program, or video, based on another work.","es":"Una obra que consiste en un guion para una película, un programa de televisión o un video basado en otra obra.","et":"Teos, mis on allikteosel põhinev stsenaarium filmi, telesaate või video jaoks.","fi":"Teos, joka koostuu toiseen teokseen perustuvasta elokuvan, televisio-ohjelman tai videon käsikirjoituksesta.","fr":"Œuvre qui consiste en un scénario de film, d’émission de télévision ou de vidéo basé sur une autre œuvre.","hu":"Egy mű, amely egy másik művön alapuló mozgókép, televízióműsor vagy videó forgatókönyvéből áll.","it":"Opera che consiste di una sceneggiatura per un film, un programma televisivo o un video, basata su un’opera di partenza.","lv":"Darbs - kinofilmas, televīzijas uzveduma vai video scenārijs veidots pēc pamatdarba.","nl":"Een werk dat bestaat uit een scenario voor een speelfilm, televisieprogramma of video, gebaseerd op een ander werk.","no":"Et verk som består av et manuskript for en spillefilm, et fjernsynsprogram eller en video, basert på et kildeverk.","tr":"Başka bir esere dayalı olarak bir sinema filmi, televizyon programı veya video senaryosundan oluşan eser.","vi":"Tác phẩm có chứa kịch bản của phim điện ảnh, chương trình truyền hình, hoặc video, dựa trên tác phẩm nguồn.","zh-Hans-CN":"由基于另一种作品的一种电影、电视节目或视频的剧本组成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
