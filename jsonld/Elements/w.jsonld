                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/programmerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10050", "lexicalAlias":"http://rdaregistry.info/Elements/w/programmerAgent.en", "label":"has programmer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10440", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/programmerPerson.en", "label":"has programmer person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10440", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/programmerPerson.en", "label":"has programmer person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10355","label":{"ar":"له إسقاط لمحتوى خرائطي لتعبيرة ممثِلة","ca":"té com a projecció de contingut cartogràfic d’una expressió representativa","cs":"má projekci kartografického obsahu reprezentativního vyjádření","da":"har projicering af kartografisk indhold af repræsentativt udtryk","de":"hat Projektion von kartografischem Inhalt einer repräsentativen Expression","de":"hat Projektion von kartografischem Inhalt einer repräsentativen Expression","en":"has projection of cartographic content of representative expression","es":"tiene proyección de contenido cartográfico de expresión representativa","et":"iseloomuliku väljenduse kartograafilise sisu projektsioon","fi":"edustavan ekspression kartografisen sisällön projektio","fr":"a pour projection d’un contenu cartographique d’une expression représentative","hu":"reprezentatív kifejezési forma vetített kartográfiai tartalma a következő:","it":"ha come proiezione di contenuto cartografico dell'espressione rappresentativa","lv":"reprezentatīvās izteiksmes projekcija (kartogrāfijā)","nl":"heeft projectie van cartografische content van representatieve expressie","no":"har kartprojeksjon for representativt uttrykk","tr":"temsili anlatımın kartografik içeriğinin projeksiyonu ile ilişkilidir","zh-Hans-CN":"有代表性内容表达的地图内容的投影"},"definition":{"ar":["يربط بين عمل وطريقة أو نظام مستخدم لتمثيل سطح الأرض أو الكرة السماوية على مسطح في تعبيرة ممثِلة لعمل."],"ca":["Relaciona una obra amb un mètode o sistema usat per representar la superfície de la terra o d’una esfera celeste sobre un pla en una expressió representativa d’una obra."],"cs":["Vztahuje dílo k metodě nebo systému, použitým pro reprezentaci zemského povrchu nebo nebeské sféry do roviny v reprezentativním vyjádření díla."],"da":["Relaterer et værk til en metode eller system, som anvendes til at repræsentere jordens overflade eller overfladen på et himmellegeme på et kort i et værks repræsentative udtryk."],"de":["Setzt eine Expression in Beziehung zu einer Methode oder ein System, die/das angewendet wird, um in einer repräsentativen Expression eines Werks die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.,Setzt eine Expression in Beziehung zu einer Methode oder ein System, die/das angewendet wird, um in einer repräsentativen Expression eines Werks die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren."],"en":["Relates a work to a method or system used to represent the surface of the earth or of a celestial sphere on a plane in a representative expression of a work."],"es":["Relaciona una obra con un método o sistema utilizado para representar la superficie de la tierra o de una esfera celeste sobre un plano en una expresión representativa de una obra."],"et":["Seostab teose meetodi või süsteemiga, mida teose iseloomulikus väljenduses on kasutatud Maa pinna või taevasfääri tasapinnaliseks kujutamiseks."],"fi":["Liittää teoksen menetelmään tai järjestelmään, jota käytetään esittämään maapallon tai taivaanpallon pintaa kaksiulotteisesti teoksen edustavassa ekspressiossa."],"fr":["Met une œuvre en relation avec une méthode ou un système utilisé pour représenter la surface de la Terre ou d’une sphère céleste sur un plan dans une expression représentative d’une œuvre."],"hu":["Hozzákapcsol egy művet egy olyan módszerhez vagy rendszerhez, amelyet egy mű kifejezési formájában a Föld vagy egy égitest felszínének síkbeli ábrázolására használnak."],"it":["Correla un’opera a un metodo o sistema utilizzato per rappresentare la superficie della Terra o di una sfera celeste su un piano in un’espressione rappresentativa di un’opera."],"lv":["Sasaista darbu ar metodi vai sistēmu, ko izmanto zemes vai debess sfēras virsmas attēlošanai plaknē, reprezentatīvā darba izteiksmē."],"nl":["Relateert een werk aan een methode of systeem gebruikt om het oppervlak van de aarde of een hemelbol voor te stellen op een vlak in een representatieve expressie van een werk."],"no":["Relaterer et verk til en metode eller et system som brukes for å gjengi overflaten til jorden eller et annet kuleformet himmellegeme på en flat overflate i et representativt uttrykk av et verk."],"tr":["Bir eseri, bir eserin temsili ifadesinde, yeryüzünün veya bir göksel kürenin yüzeyini bir düzlem üzerinde temsil etmek için kullanılan bir yöntem veya sistemle ilişkilendirir."],"zh-Hans-CN":["将一种作品与用于在一种作品的一种代表性内容表达中一个平面上表示地球或天球表面的方法或系统关联起来。"]},"ToolkitLabel":{"ar":"إسقاط محتوى خرائطي لتعبيرة ممثِلة","ca":"projecció de contingut cartogràfic d’una expressió representativa","cs":"projekce kartografického obsahu reprezentativního vyjádření","da":"projicering af kartografisk indhold af repræsentativt udtryk","de":"Projektion von kartografischem Inhalt einer repräsentativen Expression","de":"Projektion von kartografischem Inhalt einer repräsentativen Expression","en":"projection of cartographic content of representative expression","es":"proyección de contenido cartográfico de expresión representativa","et":"iseloomuliku väljenduse kartograafilise sisu projektsioon","fi":"edustavan ekspression kartografisen sisällön projektio","fr":"projection d’un contenu cartographique d’une expression représentative","hu":"reprezentatív kifejezési formához tartozó vetített kartografikus tartalom:","it":"proiezione di contenuto cartografico dell'espressione rappresentativa","lv":"reprezentatīvās izteiksmes projekcija (kartogrāfijā)","nl":"projectie van cartografische content van representatieve expressie","no":"kartprojeksjon for representativt uttrykk","tr":"temsili anlatımın kartografik içeriğinin projeksiyonu","zh-Hans-CN":"代表性内容表达的地图内容的投影"},"ToolkitDefinition":{"ar":"طريقة أو نظام مستخدم لتمثيل سطح الأرض أو الكرة السماوية على مسطح في تعبيرة ممثِلة لعمل.","ca":"Mètode o sistema usat per representar la superfície de la terra o d’una esfera celeste sobre un pla en una expressió representativa d’una obra.","cs":"Metoda nebo systém, použité pro reprezentaci zemského povrchu nebo nebeské sféry do roviny v reprezentativním vyjádření díla.","da":"Metode eller system, som anvendes til at repræsentere jordens overflade eller overfladen på et himmellegeme på et kort i et værks repræsentative udtryk.","de":"Eine Methode oder ein System, die/das angewendet wird, um in einer repräsentativen Expression eines Werks die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.","de":"Eine Methode oder ein System, die/das angewendet wird, um in einer repräsentativen Expression eines Werks die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.","en":"A method or system used to represent the surface of the earth or of a celestial sphere on a plane in a representative expression of a work.","es":"Un método o sistema utilizado para representar la superficie de la tierra o de una esfera celeste sobre un plano en una expresión representativa de una obra.","et":"Meetod või süsteem, mida teose iseloomulikus väljenduses on kasutatud Maa pinna või taevasfääri tasapinnaliseks kujutamiseks.","fi":"Menetelmä tai järjestelmä, jota käytetään esittämään maapallon tai taivaanpallon pintaa kaksiulotteisesti teoksen edustavassa ekspressiossa.","fr":"Méthode ou système utilisé pour représenter la surface de la Terre ou d’une sphère céleste sur un plan dans une expression représentative d’une œuvre.","hu":"Egy olyan módszer vagy rendszer, amelyet egy mű kifejezési formájában a Föld vagy egy égitest felszínének síkbeli ábrázolására használnak.","it":"Metodo o sistema utilizzato per rappresentare la superficie della Terra o di una sfera celeste su un piano in un’espressione rappresentativa di un’opera.","lv":"Metode vai sistēma, ko izmanto zemes vai debess sfēras virsmas attēlošanai plaknē, reprezentatīvā darba izteiksmē.","nl":"Een methode of systeem gebruikt om het oppervlak van de aarde of een hemelbol voor te stellen op een vlak in een representatieve expressie van een werk.","no":"En metode eller et system som brukes for å gjengi overflaten til jorden eller et annet kuleformet himmellegeme på en flat overflate i et representativt uttrykk av et verk.","tr":"Bir eserin temsili anlatımında yeryüzünün veya göksel bir kürenin yüzeyini bir düzlem üzerinde temsil etmek için kullanılan bir yöntem veya sistem.","zh-Hans-CN":"用于在一种作品的一种代表性内容表达中一个平面上表示地球或天球表面的方法或系统"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/projectionOfCartographicContentOfRepresentativeExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10355", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/projectionOfCartographicContentOfRepresentativeExpression.en", "label":"has projection of cartographic content of representative expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10355", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/projectionOfCartographicContentOfRepresentativeExpression.en", "label":"has projection of cartographic content of representative expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10408","label":{"ar":"له مشرف مشروعات","ca":"té com a supervisor de projecte","cs":"má supervizora projektu","da":"har vejleder","de":"hat Projektbetreuerin/Projektbetreuer","de":"hat Projektbetreuerin/Projektbetreuer","en":"has project supervisor","es":"tiene supervisor de proyecto","et":"projekti juhendaja","fi":"projektin ohjaaja","fr":"a pour superviseur de projet","hu":"projekt témavezetője a következő:","it":"ha come supervisore di progetto","lv":"studiju darba vadītājs","nl":"heeft projectbegeleider","no":"har prosjektveileder","tr":"proje danışmanı ile ilişkilidir","zh-Hans-CN":"有项目主管"},"definition":{"ar":["يربط بين عمل وشخص يكون مشرفا أكاديميا مسئولاً عن تقديم المشورة أو الإشراف على مشروع يقوم به طالب وينتج عنه عمل."],"ca":["Relaciona una obra amb una persona que és un supervisor acadèmic que és responsable d’assessorar o supervisar un projecte emprès per un estudiant que dona com a resultat una obra."],"cs":["Vztahuje dílo k osobě, která je školitelem, odpovědným za poradenství nebo dohled nad projektem, který provádí student a jehož výsledkem je dílo"],"da":["Relaterer et værk til en akademisk vejleder, som er ansvarlig for vejledning og tilsynsføring af et projekt, som udføres af en studerende, og som resulterer i et værk."],"de":["Setzt ein Werk in Beziehung zu einer akademischen Betreuerin/einem akademischen Betreuer (Person), die/der ein Projekt einer Studentin/eines Studenten beaufsichtigt oder betreut, das zu einem Werk führt.,Setzt ein Werk in Beziehung zu einer akademischen Betreuerin/einem akademischen Betreuer (Person), die/der ein Projekt einer Studentin/eines Studenten beaufsichtigt oder betreut, das zu einem Werk führt."],"en":["Relates a work to a person who is an academic supervisor who is responsible for advising or supervising a project undertaken by a student that results in a work."],"es":["Relaciona una obra con una persona que es un supervisor académico que es responsable de asesorar o supervisar un proyecto realizado por un estudiante que da como resultado una obra."],"et":["Seostab teose akadeemilise juhendajaga, kes vastutab (üli)õpilase täidetava ja teoses väljenduva projekti nõustamise või ülevaatamise eest."],"fi":["Liittää teoksen henkilöön, joka on akateeminen ohjaaja, joka on vastuussa opiskelijan suorittaman, teokseen johtavan projektin neuvonnasta tai ohjaamisesta."],"fr":["Met une œuvre en relation avec une personne qui est un superviseur académique responsable de guider ou de superviser un projet entrepris par un étudiant et entraînant la création d’une œuvre."],"hu":["Hozzákapcsol egy művet egy tudományos témavezető személyhez, aki egy olyan hallgató által vállalt projekt tanácsadója és témavezetője, amely egy művet eredményez."],"it":["Correla un'opera al supervisore accademico responsabile della consulenza o supervisione su un progetto intrapreso da uno studente che produce un'opera."],"lv":["Sasaista darbu ar personu, kura ir akadēmiskais vadītājs, kurš atbildīgs par studenta darba konsultēšanu vai uzraudzīšanu."],"nl":["Relateert een werk aan een persoon die is een academische begeleider die verantwoordelijk is voor advisering of begeleiding van een project door een student dat resulteert in een werk."],"no":["Relaterer et verk til en akademisk veileder som er ansvarlig for å veilede eller føre tilsyn med et prosjekt utført av en student og som resulterer i et verk."],"tr":["Bir eseri, bir öğrenci tarafından üstlenilen ve bir eser olarak sonuçlanan bir projeye danışmanlık yapmaktan veya denetlemekten sorumlu olan bir akademik danışman olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责为导致一种作品的学生所做的项目作指导和监督的作为学术主管的一个个人关联起来。"]},"ToolkitLabel":{"ar":"مشرف مشروعات","ca":"supervisor de projecte","cs":"supervizor projektu","da":"vejleder","de":"Projektbetreuerin/Projektbetreuer","de":"Projektbetreuerin/Projektbetreuer","en":"project supervisor","es":"supervisor de proyecto","et":"projekti juhendaja","fi":"projektin ohjaaja","fr":"superviseur de projet","hu":"projekt-témavezető:","it":"supervisore di progetto","lv":"studiju darba vadītājs","nl":"projectbegeleider","no":"prosjektveileder","tr":"Proje yöneticisi","zh-Hans-CN":"项目主管"},"ToolkitDefinition":{"ar":"شخص يكون مشرفا أكاديميا مسئولاً عن تقديم المشورة أو الإشراف على مشروع يقوم به طالب وينتج عنه عمل.","ca":"Persona que és un supervisor acadèmic que és responsable d’assessorar o supervisar un projecte emprès per un estudiant que dona com a resultat una obra.","cs":"Osoba, která je školitelem, odpovědným za poradenství nebo dohled nad projektem, který provádí student a jehož výsledkem je dílo","da":"Akademisk vejleder, som er ansvarlig for vejledning og tilsynsføring af et projekt, som udføres af en studerende, og som resulterer i et værk.","de":"Eine akademische Betreuerin/Ein akademischer Betreuer (Person), die/der ein Projekt einer Studentin/eines Studenten beaufsichtigt oder betreut, das zu einem Werk führt.","de":"Eine akademische Betreuerin/Ein akademischer Betreuer (Person), die/der ein Projekt einer Studentin/eines Studenten beaufsichtigt oder betreut, das zu einem Werk führt.","en":"A person who is an academic supervisor who is responsible for advising or supervising a project undertaken by a student that results in a work.","es":"Una persona que es un supervisor académico que es responsable de asesorar o supervisar un proyecto realizado por un estudiante que da como resultado una obra.","et":"Akadeemiline juhendaja, kes vastutab (üli)õpilase täidetava ja teoses väljenduva projekti nõustamise või ülevaatamise eest.","fi":"Henkilö, joka on akateeminen ohjaaja, joka on vastuussa opiskelijan suorittaman, teokseen johtavan projektin neuvonnasta tai ohjaamisesta.","fr":"Personne qui est un superviseur académique responsable de guider ou de superviser un projet entrepris par un étudiant et entraînant la création d’une œuvre.","hu":"Egy tudományos témavezető személy, aki egy olyan hallgató által vállalt projekt tanácsadója és témavezetője, amely egy művet eredményez.","it":"Supervisore accademico responsabile della consulenza o supervisione su un progetto intrapreso da uno studente, che produce un'opera.","lv":"Akadēmiskais vadītājs, kurš atbildīgs par studenta darba konsultēšanu vai uzraudzīšanu.","nl":"Een persoon die is een academische begeleider die verantwoordelijk is voor advisering of begeleiding van een project door een student dat resulteert in een werk.","no":"En akademisk veileder som er ansvarlig for å veilede eller føre tilsyn med et prosjekt utført av en student og som resulterer i et verk.","tr":"Bir öğrenci tarafından üstlenilen ve bir çalışma ile sonuçlanan bir projeye danışmanlık yapmaktan veya denetlemekten sorumlu olan akademik danışman olan kişi.","zh-Hans-CN":"负责为导致一种作品的学生所做的项目作指导和监督的作为学术主管的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/projectSupervisor.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10407", "lexicalAlias":"http://rdaregistry.info/Elements/w/academicSupervisor.en", "label":"has academic supervisor"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10408", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/projectSupervisor.en", "label":"has project supervisor"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10408", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/projectSupervisor.en", "label":"has project supervisor"}]},{"@id":"http://rdaregistry.info/Elements/w/P10014","label":{"ar":"له وكيل مخرج إذاعي","ca":"té com a agent realitzador radiofònic","cs":"má rozhlasového režiséra (agenta)","da":"har agent, som er radioregissør","de":"hat Hörfunkregisseurin/Hörfunkregisseur (Akteur)","de":"hat Hörfunkregisseurin/Hörfunkregisseur (Akteur)","el":"έχει διευθυντή ραδιοφωνικού προγράμματος","en":"has radio director agent","es":"tiene agente director de radio","et":"raadiorežissöör (tegija)","fi":"radio-ohjaaja (toimija)","fr":"a pour agent réalisateur de radio","hu":"rádiós rendező ágense a következő:","it":"ha come regista radiofonico agente","lv":"radio raidījuma direktors (aģents)","nl":"heeft radioregisseur-actor","no":"har radioregissør (agent)","tr":"radyo yönetmeni temsilcisi ile ilişkilidir","vi":"có đạo diễn truyền thanh","zh-Hans-CN":"有广播导演行为者"},"definition":{"ar":["يربط بين عمل ووكيل يكون مخرجا مسئولاً عن الإدارة العامة والإشراف على برنامج إذاعي."],"ca":["Relaciona una obra amb un agent que és un realitzador que és responsable de la gestió general i la supervisió d’un programa radiofònic."],"cs":["Vztahuje dílo k agentovi, který je režisérem odpovědným za celkové řízení a dohled nad rozhlasovým programem."],"da":["Relaterer et værk til en agent, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram."],"de":["Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer Radiosendung verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer Radiosendung verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν διευθυντή υπεύθυνο για τη γενική διεύθυνση και εποπτεία ενός ραδιοφωνικού προγράμματος."],"en":["Relates a work to an agent who is a director who is responsible for the general management and supervision of a radio program."],"es":["Relaciona una obra con un agente que es un director quien es responsable de la gestión y supervisión general de un programa de radio."],"et":["Seostab teose tegijaga, kes on raadiosaate üldise juhtimise ja juhendamise eest vastutav režissöör."],"fi":["Liittää teoksen toimijaan, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta."],"fr":["Met une œuvre en relation avec un agent réalisateur qui est responsable de la gestion et de la supervision générales d’une émission de radio."],"hu":["Hozzákapcsol egy művet egy rendező ágenshez, amely felelős egy rádióműsor általános menedzseléséért és felügyeletéért."],"it":["Correla un’opera all'agente regista responsabile dell'organizzazione e della supervisione generali di un programma radiofonico."],"lv":["Sasaista darbu ar aģentu - direktors, kurš atbildīgs par radio raidījuma vispārēju vadību un uzraudzību."],"nl":["Relateert een werk aan een actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een radioprogramma."],"no":["Relaterer et verk til en agent som er regissør med ansvar for generell ledelse av et radioprogram."],"tr":["Bir eseri, radyo programına ait bir performansın genel yönetiminden ve denetiminden sorumlu bir yönetmen olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với đạo diễn có trách nhiệm về quản lý và giám sát chung của chương trình truyền thanh."],"zh-Hans-CN":["将一种作品与作为一个导演并负责广播节目的总体管理和监督的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مخرج إذاعي","ca":"agent realitzador radiofònic","cs":"rozhlasový režisér (agent)","da":"agent, som er radioregissør","de":"Hörfunkregisseurin/Hörfunkregisseur (Akteur)","de":"Hörfunkregisseurin/Hörfunkregisseur (Akteur)","el":"διευθυντής ραδιοφωνικού προγράμματος","en":"radio director agent","es":"agente director de radio","et":"raadiorežissöör (tegija)","fi":"radio-ohjaaja (toimija)","fr":"agent réalisateur de radio","hu":"rádiós rendező ágens:","it":"regista radiofonico agente","lv":"radio raidījuma direktors (aģents)","nl":"radioregisseur-actor","no":"radioregissør (agent)","tr":"radyo yönetmeni temsilci","vi":"đạo diễn truyền thanh","zh-Hans-CN":"广播导演行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مخرجا مسئولاً عن الإدارة العامة والإشراف على برنامج إذاعي.","ca":"Agent que és un realitzador que és responsable de la gestió general i la supervisió d’un programa radiofònic.","cs":"Agent, který je režisérem odpovědným za celkové řízení a dohled nad rozhlasovým programem.","da":"Agent, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram.","de":"Eine Regisseurin/ein Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer Radiosendung verantwortlich ist.","de":"Eine Regisseurin/ein Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer Radiosendung verantwortlich ist.","el":"Ένας διευθυντής υπεύθυνος για τη γενική διεύθυνση και εποπτεία ενός ραδιοφωνικού προγράμματος.","en":"An agent who is a director who is responsible for the general management and supervision of a radio program.","es":"Un agente que es un director quien es responsable de la gestión y supervisión general de