                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/bindingOfManifestationOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10309", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedManifestationOfWork.en", "label":"has related manifestation of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10363", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/bindingOfManifestationOf.en", "label":"is binding of manifestation of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10363", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/bindingOfManifestationOf.en", "label":"is binding of manifestation of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10044","label":{"ar":"له قاضي","ca":"té com a jutge","cs":"má soudce","da":"har dommer","de":"hat Richterin/Richter","de":"hat Richterin/Richter","el":"έχει κριτή","en":"has judge","es":"tiene juez","et":"kohtunik","fi":"tuomari","fr":"a pour juge","hu":"bírója a következő:","it":"ha come giudice","lv":"tiesnesis","nl":"heeft rechter","no":"har dommer","tr":"hâkim ile ilişkilidir","vi":"có quan toà","zh-Hans-CN":"有法官"},"definition":{"ar":["يربط بين عمل وشخص ينظر في المسائل القانونية ويفصل فيها في محكمة."],"ca":["Relaciona una obra amb una persona que escolta i decideix en les causes jurídiques en un tribunal."],"cs":["Vztahuje dílo k osobě, která u soudu projednává a rozhoduje o právních záležitostech."],"da":["Relaterer et værk til en person, som hører og afgører juridiske anliggender i retten."],"de":["Setzt ein Werk in Beziehung zu einer Person, die bei Gericht juristische Angelegenheiten anhört und darüber entscheidet.,Setzt ein Werk in Beziehung zu einer Person, die bei Gericht juristische Angelegenheiten anhört und darüber entscheidet."],"el":["Συνδέει ένα έργο με ένα φυσικό πρόσωπο, το οποίο ακούει και αποφασίζει αναφορικά με ζητήματα νομικής φύσης στο δικαστήριο."],"en":["Relates a work to a person who hears and decides on legal matters in court."],"es":["Relaciona una obra con una persona que escucha y decide sobre asuntos legales en un tribunal."],"et":["Seostab teose isikuga, kes kohtus kuulab ära ja otsustab õigusasju."],"fi":["Liittää teoksen henkilöön, joka kuulee ja päättää oikeusasioista tuomioistuimessa."],"fr":["Met une œuvre en relation avec une personne qui entend des causes juridiques et rend jugement dans un tribunal."],"hu":["Hozzákapcsol egy művet egy személyhez, aki jogi ügyekben tárgyalást vezet és ítélkezik a bíróságon."],"it":["Correla un’opera a una persona che ascolta e decide su questioni giuridiche nell'ambito di un tribunale."],"lv":["Sasaista darbu ar personu, kura tiesā izskata/uzklausa un lemj juridiskus jautājumus."],"nl":["Relateert een werk aan een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die hoort en oordeelt over juridische zaken in rechtszitting.Een persoon die 