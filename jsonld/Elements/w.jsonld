                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10341", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyleOf.en", "label":"is transformation by style of"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/freeTranslationOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10143", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/freeTranslationOfWork.en", "label":"is free translation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10143", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/freeTranslationOfWork.en", "label":"is free translation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10178","label":{"ar":"هو مراجعة لعمل","ca":"és revisió d’una obra","cs":"je recenzí díla","da":"er anmeldelse af værk","de":"ist Rezension von (Werk)","de":"ist Rezension von (Werk)","el":"είναι κριτική του (έργο)","en":"is review of work","es":"es revisión de la obra","et":"ülevaade teosest","fi":"arvostelu teoksesta","fr":"est une recension d’une œuvre","hu":"szemlézi a következő művet:","it":"è recensione di opera","lv":"ir recenzija darbam","nl":"is recensie van werk","no":"er anmeldelse av verk","tr":"eserin incelemesidir","vi":"là tổng thuật của (tác phẩm)","zh-Hans-CN":"是作品的评论"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لتقييم موجز."],"ca":["Relaciona una obra amb una obra que és avaluada breument per una obra."],"cs":["Vztahuje dílo k dílu, které je stručně hodnoceno v díle."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for en kortfattet evaluering."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine kurze Untersuchung verwendet wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch ein erweiterndes Werk aktualisiert oder in anderer Weise vervollständigt wird."],"el":["Συνδέει ένα έργο με ένα έργο που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση."],"en":["Relates a work to a work that is briefly evaluated by a work."],"es":["Relaciona una obra con una obra que es brevemente evaluada por una obra."],"et":["Seostab teose teosega, mis on lühihinnangu aluseks."],"fi":["Liittää teoksen lyhyen arvioinnin perustana käytettyyn teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui est brièvement évaluée par une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy rövid mű által kiértékeltek."],"it":["Correla un'opera a un'opera usata come base per una breve valutazione."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu īsam novērtējumam."],"nl":["Relateert een werk aan een werk dat kort geëvalueerd wordt door een werk."],"no":["Relaterer et verk til et verk brukt som utgangspunkt for en kortfattet evaluering."],"tr":["Bir eseri, bir eser tarafından kısaca değerlendirilen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho đánh giá ngắn gọn."],"zh-Hans-CN":["将一种作品与被一种作品简要评价的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مراجعة لعمل","ca":"revisió d’una obra","cs":"recenze díla","da":"anmeldelse af værk","de":"Rezension von (Werk)","de":"Rezension von (Werk)","el":"κριτική του (έργο)","en":"review of work","es":"revisión de la obra","et":"ülevaade teosest","fi":"arvostelu teoksesta","fr":"recension d’une œuvre","hu":"szemlézett mű:","it":"recensione di opera","lv":"recenzija darbam","nl":"recensie van werk","no":"anmeldelse av verk","tr":"eserin incelemesi","vi":"tổng thuật của (tác phẩm)","zh-Hans-CN":"作品的评论"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لتقييم موجز.","ca":"Obra que és avaluada breument per una obra.","cs":"Dílo, které je stručně hodnoceno v díle.","da":"Værk, som anvendes som grundlag for en kortfattet evaluering.","de":"Ein Werk, das als Grundlage für eine kurze Untersuchung verwendet wird.","de":"Ein Werk, das durch eine Manifestation verkörpert ist.","el":"Ένα έργο που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση.","en":"A work that is briefly evaluated by a work.","es":"Una obra que es brevemente evaluada por una obra.","et":"Teos, mis on lühihinnangu aluseks.","fi":"Teoksen lyhyen arvioinnin perustana käytetty teos.","fr":"Œuvre qui est brièvement évaluée par une œuvre.","hu":"Egy mű, amelyet egy rövid mű által kiértékeltek.","it":"Opera usata come base per una breve valutazione.","lv":"Darbs, kas izmantots par pamatu īsam novērtējumam.","nl":"Een werk dat kort geëvalueerd wordt door een werk.","no":"Et verk brukt som utgangspunkt for en kortfattet evaluering.","tr":"Bir çalışma tarafından kısaca değerlendirilen çalışma.","vi":"Tác phẩm được sử dụng như là cơ sở cho đánh giá ngắn gọn.","zh-Hans-CN":"被一种作品简要评价的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
