                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsTelevisionProgramWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10085", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsTelevisionProgramWork.en", "label":"is adapted as television program work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10085", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsTelevisionProgramWork.en", "label":"is adapted as television program work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10241","label":{"ar":"له عمل موسيقي لبرنامج تليفزيوني","ca":"té com a obra de música de programa de televisió","cs":"má hudbu (dílo) pro televizní program","da":"har tv-programmusikværk","de":"hat Fernsehsendungsmusik (Werk)","de":"hat Fernsehsendungsmusik (Werk)","el":"είναι μουσική τηλεοπτικού προγράμματος (έργο)","en":"has television program music work","es":"tiene obra musical en programas de televisión","et":"telesaate muusika (teos)","fi":"televisio-ohjelman musiikki (teos)","fr":"a pour musique d’émission de télévision (œuvre)","hu":"televízióműsorzene-műve a következő:","it":"ha come musica per programma televisivo opera","lv":"darbs: televīzijas raidījuma mūzika","nl":"heeft televisieprogrammamuziek-werk","no":"har fjernsynsmusikk (verk)","tr":"televizyon programı müziği eseri ile ilişkilidir","vi":"là âm nhạc chương trình truyền hình (tác phẩm)","zh-Hans-CN":"有电视节目音乐作品"},"definition":{"ar":["يربط عمل بعمل موسيقي يكمل عملاً عبارة عن برنامج تليفزيوني."],"ca":["Relaciona una obra amb una obra que és una obra musical que complementa una obra que és un programa de televisió."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, doplňujícím dílo, které je televizním programem."],"da":["Relaterer et værk til et musikværk, som komplementerer et værk, som er et tv-program."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, das eine Fernsehsendung ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das eine Fernsehsendung (Werk) ergänzt."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο το οποίο χρησιμοποιείται σε ένα τηλεοπτικό πρόγραμμα."],"en":["Relates a work to a work that is a musical work that complements a work that is a television program."],"es":["Relaciona una obra con una obra que es una obra musical que complementa una obra que es un programa de televisión."],"et":["Seostab teose muusikateosega, mis täiendab telesaatena esinevat teost."],"fi":["Liittää teoksen musiikkiteokseen, joka täydentää teosta, joka on televisio-ohjelma."],"fr":["Met une œuvre en relation avec une œuvre musicale qui complète une œuvre consistant en une émission de télévision."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amely kiegészít egy televízióműsor-művet."],"it":["Correla un’opera a un’opera musicale che completa un’opera che è un programma televisivo."],"lv":["Sasaista darbu ar mūzikas darbu, kas papildina darbu, kas ir televīzijas raidījums."],"nl":["Relateert een werk aan een muziekwerk dat een werk complementeert dat een televisieprogramma is."],"no":["Relaterer et verk til et musikalsk verk som utfyller et fjernsynsprogram."],"tr":["Bir eseri, televizyon programı olan bir eseri tamamlayan müzik eseri olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc được sử dụng trong chương trình truyền hình."],"zh-Hans-CN":["将一种作品与作为一种音乐作品并补充作为一种电视节目的一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل موسيقي لبرنامج تليفزيوني","ca":"obra de música de programa de televisió","cs":"hudba (dílo) pro televizní program","da":"tv-programmusikvæ