                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayBasedOnWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10134", "lexicalAlias":"http://rdaregistry.info/Elements/w/motionPictureScreenplayBasedOnWork.en", "label":"is motion picture screenplay based on work"},{"@id":"http://rdaregistry.info/Elements/w/P10135", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionScreenplayBasedOnWork.en", "label":"is television screenplay based on work"},{"@id":"http://rdaregistry.info/Elements/w/P10136", "lexicalAlias":"http://rdaregistry.info/Elements/w/videoScreenplayBasedOnWork.en", "label":"is video screenplay based on work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10133", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/screenplayBasedOnWork.en", "label":"is screenplay based on work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10133", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/screenplayBasedOnWork.en", "label":"is screenplay based on work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10189","label":{"ar":"هو نص أوبرالي معتمد على عمل","ca":"és llibret basat en una obra","cs":"je libretem založeným na díle","da":"er libretto baseret på værk","de":"ist Libretto basierend auf (Werk)","de":"ist Libretto basierend auf (Werk)","el":"είναι λιμπρέτο βασισμένο στο (έργο)","en":"is libretto based on work","es":"es libreto basado en la obra","et":"libreto aluseks olev teos","fi":"libreton perustana oleva teos","fr":"est un livret basé sur une œuvre","hu":"librettó a következő mű alapján:","it":"è libretto basato su opera","lv":"kā librets adaptētais darbs","nl":"is libretto gebaseerd op werk","no":"er libretto basert på verk","tr":"esere dayalı librettodur","vi":"là lời nhạc kịch dựa trên (tác phẩm)","zh-Hans-CN":"是基于作品的台本"},"definition":{"ar":["يربط عمل بعمل موسيقي، أو راقص مثل الأوبرا، أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو لموسيقى دينية."],"ca":["Relaciona una obra amb una obra que proporciona el text per a una obra musical o coreogràfica com ara una opera, un ballet o qualsevol altra obra escènica musical o un oratori."],"cs":["Vztahuje dílo k dílu, které poskytuje text pro hudební nebo choreografické dílo jako je opera, balet nebo jiné dílo pro hudební scénu, nebo oratorium."],"da":["Relaterer et værk til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das Text für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium enthält.,Ein Werk, das Text für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium enthält."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως το κείμενο μιας όπερας ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο."],"en":["Relates a work to a work that provides text for a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con una obra que proporciona texto para una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio."],"et":["Seostab teose teosega, mis annab teksti muusikalisele või koreograafilisele lavateosele (nt ooper, ballett) või oratooriumile."],"fi":["Liittää teoksen musiikki- tai koreografiseen teokseen, kuten oopperaan, balettiin tai muuhun musiikilliseen näyttämöteokseen tai oratorioon."],"fr":["Met une œuvre en relation avec une œuvre qui fournit du texte pour une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művet egy műhöz, amely szöveget szolgáltat egy zene- vagy koreografikus műhöz, mint amilyen egy opera, vagy egyéb zenés színpadi forrás, vagy egy oratórium."],"it":["Correla un’opera a un’opera musicale o coreografica come un’opera, balletto o altro lavoro per il teatro musicale, o un oratorio."],"lv":["Sasaista darbu ar darbu, pēc kura veidots librets operai, oratorijai vai citam muzikāli dramatiskam darbam."],"nl":["Relateert een werk aan een werk dat tekst levert voor een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til et verk som gir tekst til en musikal eller et koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzik sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eser için metin sağlayan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là văn bản của opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio."],"zh-Hans-CN":["将一种作品与为诸如歌剧、芭蕾、或其他舞台音乐作品或清唱剧提供文本的一种作品关联起来。"]},"ToolkitLabel":{"ar":"نص أوبرالي معتمد على عمل","ca":"llibret basat en una obra","cs":"libreto založené na díle","da":"libretto baseret på værk","de":"Libretto basiert auf (Werk)","de":"Libretto basiert auf (Werk)","el":"λιμπρέτο βασισμένο στο (έργο)","en":"libretto based on work","es":"libreto basado en la obra","et":"libreto aluseks olev teos","fi":"libreton perustana oleva teos","fr":"livret basé sur une œuvre","hu":"librettó-alapmű","it":"libretto basato su opera","lv":"kā librets adaptētais darbs","nl":"libretto gebaseerd op werk","no":"libretto basert på verk","tr":"eserden uyarlanan opera metni","vi":"lời nhạc kịch dựa trên (tác phẩm)","zh-Hans-CN":"基于作品的台本"},"ToolkitDefinition":{"ar":"عمل يقدم نصًا لعمل موسيقي، أو راقص مثل الأوبرا، أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو لموسيقى دينية.","ca":"Obra que proporciona el text per a una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o un oratori.","cs":"Dílo, které poskytuje text pro hudební nebo choreografické dílo jako je opera, balet nebo jiné dílo pro hudební scénu, nebo oratorium.","da":"Værk, som angiver tekst til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Ein Werk, das Text für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium enthält.","de":"Ein Werk, das Text für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium enthält.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως το κείμενο μιας όπερας ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο.","en":"A work that provides text for a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Una obra que proporciona texto para una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.","et":"Teos, mis annab teksti muusikalisele või koreograafilisele lavateosele (nt ooper, ballett) või oratooriumile.","fi":"Teos, johon musiikki- tai korografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion teksti perustuu.","fr":"Œuvre qui fournit du texte pour une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy mű, amely szöveget szolgáltat egy zene- vagy koreografikus műhöz, mint amilyen egy opera, vagy egyéb zenés színpadi forrás, vagy egy oratórium.","it":"Opera che fornisce il testo per un'opera musicale o coreografica come un’opera, balletto o altro lavoro per il teatro musicale, o un oratorio.","lv":"Darbs, pēc kura veidots librets operai, oratorijai vai citam muzikāli dramatiskam darbam.","nl":"Een werk dat tekst levert voor een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"Et verk som gir tekst til en musikal eller et koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene, eller et oratorium.","tr":"Bir opera, bale veya müzikal sahne için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eser için metin sağlayan eser.","vi":"Tác phẩm đã được phỏng theo như là văn bản của opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio.","zh-Hans-CN":"为诸如歌剧、芭蕾、或其他舞台音乐作品或清唱剧提供文本的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/librettoBasedOnWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10189", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettoBasedOnWork.en", "label":"is libretto based on work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10189", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettoBasedOnWork.en", "label":"is libretto based on work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10137","label":{"ar":"هو نص إذاعي مبني على عمل","ca":"és guió radiofònic basat en una obra","cs":"je rozhlasovým scénářem založeným na díle","da":"er radiomanuskript baseret på værk","de":"ist Hörfunkskript basierend auf (Werk)","de":"ist Hörfunkskript basierend auf (Werk)","el":"είναι ραδιοφωνικό σενάριο βασισμένο σε (έργο)","en":"is radio script based on work","es":"es guion de radio basado en obra","et":"raadiostsenaariumi aluseks olev teos","fi":"radiokäsikirjoituksen perustana oleva teos","fr":"est un script radiophonique basé sur une œuvre","hu":"rádiós szövegkönyv a következő műből:","it":"è sceneggiatura radiofonica basata su opera","lv":"kā radio raidījuma scenārijs adaptētais darbs","nl":"is radioscript gebaseerd op werk","no":"er radiomanus basert på verk","tr":"esere dayalı radyo metnidir","vi":"là kịch bản truyền thanh được trên (tác phẩm)","zh-Hans-CN":"是基于作品的广播文稿"},"definition":{"ar":["يربط عمل بعمل تمت معالجته كنص لبرنامج إذاعي."],"ca":["Relaciona una obra amb una obra que s’adapta com un guió d’un programa radiofònic."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako scénář rozhlasového programu."],"da":["Relaterer et værk til et værk, som er bearbejdet til et manuskript til et radioprogram."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Skript für eine Hörfunksendung bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als Skript für eine Hörfunksendung bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως σενάριο για ένα ραδιοφωνικό πρόγραμμα."],"en":["Relates a work to a work that is adapted as a script for a radio program."],"es":["Relaciona una obra con una obra que es adaptada como un guion para un programa de radio."],"et":["Seostab teose teosega, mis on adapteeritud raadiosaate stsenaariumina."],"fi":["Liittää teoksen teokseen, joka on sovitettu radio-ohjelman käsikirjoitukseksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée en script d’émission de radio."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy rádióműsor forgatókönyveként adaptáltak."],"it":["Correla un’opera a un’opera adattata come sceneggiatura per un programma radiofonico."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā radio raidījuma scenārijs."],"nl":["Relateert een werk aan een werk dat is bewerkt als een script voor een radioprogramma."],"no":["Relaterer et verk til et verk som er bearbeidet til et manuskript for et radioprogram."],"tr":["Bir eseri, radyo programı için metin olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là kịch bản của chương trình truyền thanh."],"zh-Hans-CN":["将一种作品与被改编为广播节目文稿的一种作品关联起来。"]},"ToolkitLabel":{"ar":"نص إذاعي مبني على عمل","ca":"guió radiofònic basat en una obra","cs":"rozhlasový scénář založený na díle","da":"radiomanuskript baseret på værk","de":"Hörfunkskript basiert auf (Werk)","de":"Hörfunkskript basiert auf (Werk)","el":"ραδιοφωνικό σενάριο βασισμένο σε (έργο)","en":"radio script based on work","es":"guion de radio basado en obra","et":"raadiostsenaariumi aluseks olev teos","fi":"radiokäsikirjoituksen perustana oleva teos","fr":"script radiophonique basé sur une œuvre","hu":"rádióműsor-szövegkönyvként átdolgozott mű:","it":"sceneggiatura radiofonica basata su opera","lv":"kā radio raidījuma scenārijs adaptētais darbs","nl":"radioscript gebaseerd op werk","no":"radiomanus basert på verk","tr":"esere dayalı radyo senaryosu","vi":"kịch bản truyền thanh được trên (tác phẩm)","zh-Hans-CN":"基于作品的广播文稿"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كنص لبرنامج إذاعي.","ca":"Obra que s’adapta com un guió d’un programa radiofònic.","cs":"Dílo, které je adaptováno jako scénář rozhlasového programu.","da":"Værk, som er bearbejdet til et manuskript til et radioprogram.","de":"Ein Werk, das als Skript für eine Hörfunksendung bearbeitet ist.","de":"Ein Werk, das als Skript für eine Hörfunksendung bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως σενάριο για ένα ραδιοφωνικό πρόγραμμα.","en":"A work that is adapted as a script for a radio program.","es":"Una obra que es adaptada como un guion para un programa de radio.","et":"Teos, mis on adapteeritud raadiosaate stsenaariumina.","fi":"Teos, joka on sovitettu radio-ohjelman käsikirjoitukseksi.","fr":"Œuvre qui est adaptée en script d’émission de radio.","hu":"Egy mű, amelyet egy rádióműsor forgatókönyveként átdolgoztak.","it":"Opera adattata come sceneggiatura per un programma radiofonico.","lv":"Darbs, kas ir adaptēts kā radio raidījuma scenārijs.","nl":"Een werk dat is bewerkt als een script voor een radioprogramma.","no":"Et verk som er bearbeidet til et manuskript for et radioprogram.","tr":"Radyo programı için metin olarak uyarlanan bir eser.","vi":"Tác phẩm đã được phỏng theo như là kịch bản của chương trình truyền thanh.","zh-Hans-CN":"被改编为广播节目文稿的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
