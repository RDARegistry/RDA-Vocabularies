                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10258", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectExpression.en", "label":"has subject expression"},{"@id":"http://rdaregistry.info/Elements/w/P10360", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfRDAEntity.en", "label":"is description of RDA entity"}],"instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10278", "lexicalAlias":"http://rdaregistry.info/Elements/w/analysisOfExpression.en", "label":"is analysis of expression"},{"@id":"http://rdaregistry.info/Elements/w/P10282", "lexicalAlias":"http://rdaregistry.info/Elements/w/commentaryOnExpression.en", "label":"is commentary on expression"},{"@id":"http://rdaregistry.info/Elements/w/P10615", "lexicalAlias":"http://rdaregistry.info/Elements/w/metadataDescriptionOfExpression.en", "label":"is metadata description of expression"},{"@id":"http://rdaregistry.info/Elements/w/object/P10277", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/descriptionOfExpression.en", "label":"is description of expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10277", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/descriptionOfExpression.en", "label":"is description of expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10280","label":{"ar":"هو مراجعة لتعبيرة","ca":"és revisió d’una expressió","cs":"je recenzí vyjádření","da":"er anmeldelse af udtryk","de":"ist Rezension von (Expression)","de":"ist Rezension von (Expression)","el":"είναι εξέταση της (έκφρασης)","en":"is review of expression","es":"es repaso de expresión","et":"ülevaade väljendusest","fi":"arvostelu ekspressiosta","fr":"est une recension d’une expression","hu":"szemlézi a következő kifejezési formát:","it":"è recensione di espressione","lv":"ir recenzija izteiksmei","nl":"is recensie van expressie","no":"er anmeldelse av uttrykk","tr":"Anlatımın incelemesidir","vi":"là tổng quan của (biểu hiện)","zh-Hans-CN":"是内容表达的评论"},"definition":{"ar":["يربط بين عمل وتعبيرة تستخدم كأساس لتقييم موجز."],"ca":["Relaciona una obra amb una expressió que és avaluada breument per una obra."],"cs":["Vztahuje dílo k vyjádření, které je stručně hodnoceno v díle."],"da":["Relaterer et værk til et udtryk, som anvendes som grundlag for en kortfattet evaluering."],"de":["Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine kurze Untersuchung verwendet wird.,Setzt eine Expression in Beziehung zu einer Expression eines Werks, die durch eine erweiternde Expression aktualisiert oder in anderer Weise vervollständigt wird."],"el":["Συνδέει ένα έργο με μια έκφραση που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση."],"en":["Relates a work to an expression that is briefly evaluated by a work."],"es":["Relaciona una obra con una expresión que es brevemente evaluada por una obra."],"et":["Seostab teose väljendusega, mis on lühihinnangu aluseks."],"fi":["Liittää teoksen ekspressioon, jota on käytetty lyhyen arvioinnin perustana."],"fr":["Met une œuvre en relation avec une expression qui est brièvement évaluée par une œuvre."],"hu":["Hozzákapcsol egy művet egy kifejezési formához, amelyet egy mű által röviden kiértékelnek."],"it":["Correla un'opera a un'espressione usata come base per una breve valutazione."],"lv":["Sasaista darbu ar izteiksmi, kas izmantota par pamatu īsam novērtējumam."],"nl":["Relateert een werk aan een expressie die kort geëvalueerd wordt door een werk."],"no":["Relaterer et verk til et uttrykk brukt som utgangspunkt for en kortfattet evaluering."],"tr":["Bir eseri, bir eseri tarafından kısaca değerlendirilen bir anlatımla ilişkilendirir."],"vi":["Liên kết tác phẩm với biểu thị được dùng như là cơ sở cho đánh giá ngắn gọn."],"zh-Hans-CN":["将一种作品与被一种作品简要评价的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"مراجعة لتعبيرة","ca":"revisió d’una expressió","cs":"recenze vyjádření","da":"anmeldelse af udtryk","de":"Rezension von (Expression)","de":"Rezension von (Expression)","el":"εξέταση της (έκφραση)","en":"review of expression","es":"repaso de expresión","et":"ülevaade väljendusest","fi":"arvostelu ekspressiosta","fr":"recension d’une expression","hu":"szemlézett kifejezési forma","it":"recensione di espressione","lv":"recenzija izteiksmei","nl":"recensie van expressie","no":"anmeldelse av uttrykk","tr":"anlatımın incelenmesi","vi":"tổng quan của (biểu hiện)","zh-Hans-CN":"内容表达的评论"},"ToolkitDefinition":{"ar":"تعبيرة تستخدم كأساس لتقييم موجز.","ca":"Expressió que és avaluada breument per una obra.","cs":"Vyjádření, které je stručně hodnoceno v díle.","da":"Udtryk, som anvendes som grundlag for en kortfattet evaluering.","de":"Eine Expression, die als Grundlage für eine kurze Untersuchung verwendet wird.","de":"Eine Expression, die von einem Werk beschrieben wird.","el":"Μια έκφραση που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση.","en":"An expression that is briefly evaluated by a work.","es":"Una expresión que es brevemente evaluada por una obra.","et":"Väljendus, mis on lühihinnangu aluseks.","fi":"Ekspressio, jota on käytetty lyhyen arvioinnin perustana.","fr":"Expression qui est brièvement évaluée par une œuvre.","hu":"Egy kifejezési forma, amelyet egy mű által röviden kiértékelnek.","it":"Espressione usata come base per una breve valutazione.","lv":"Izteiksme, kas izmantota par pamatu īsam novērtējumam.","nl":"Een expressie die kort geëvalueerd wordt door een werk.","no":"Et uttrykk brukt som utgangspunkt for en kortfattet evaluering.","tr":"Bir çalışma tarafından kısaca değerlendirilen bir anlatım.","vi":"Biểu thị được dùng như là cơ sở cho đánh giá ngắn gọn.","zh-Hans-CN":"被一种作品简要评价的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/reviewOfExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"23.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10279", "lexicalAlias":"http://rdaregistry.info/Elements/w/evaluationOfExpression.en", "label":"is evaluation of expression"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10280", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/reviewOfExpression.en", "label":"is review of expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10280", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/reviewOfExpression.en", "label":"is review of expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10282","label":{"ar":"هو تعليق على تعبيرة","ca":"és comentari sobre una expressió","cs":"je komentářem k vyjádření","da":"er kommentar til udtryk","de":"ist Kommentar zu (Expression)","de":"ist Kommentar zu (Expression)","el":"είναι σχόλια στην (έκφραση)","en":"is commentary on expression","es":"es un comentario sobre la expresión","et":"kommenteeritud väljendus","fi":"kommentaari ekspressiosta","fr":"est un commentaire sur une expression","hu":"kommentárja a következő kifejezési formának","it":"è commento su espressione","lv":"ir komentārs izteiksmei","nl":"is commentaar op expressie","no":"er kommentar til uttrykk","tr":"anlatım hakkında yorumdur","vi":"là bình luận về (biểu hiện)","zh-Hans-CN":"是关于内容表达的评注"},"definition":{"ar":["يربط بين عمل وتعبيرة تستخدم كأساس لمجموعة ملاحظات شارحة أو نقدية."],"ca":["Relaciona una obra amb una expressió usada com a base d’un conjunt de notes explicatives o crítiques."],"cs":["Vztahuje dílo k vyjádření, použitému jako základ pro soubor vysvětlujících nebo kritických poznámek."],"da":["Relaterer et værk til et udtryk, som anvendes som grundlag for et sæt af forklarende eller kritiske kommentarer."],"de":["Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine Reihe von erläuternden oder kritischen Anmerkungen verwendet wird.,Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine Reihe von erläuternden oder kritischen Anmerkungen verwendet wird."],"el":["Συνδέει ένα έργο με μια έκφραση που χρησιμοποιείται ως η βάση για ένα σύνολο από επεξηγηματικές ή κριτικές σημειώσεις."],"en":["Relates a work to an expression used as a basis for a set of explanatory or critical notes."],"es":["Relaciona una obra con una expresión utilizada como base para un conjunto de notas explicativas o críticas."],"et":["Seostab teose väljendusega, mis on aluseks selgitavate või kriitiliste märkuste kogumile."],"fi":["Liittää teoksen selittävien tai kriittisten huomautusten joukon perustana käytettyyn ekspressioon."],"fr":["Met une œuvre en relation avec une expression qui sert de base à un ensemble de notes explicatives ou critiques."],"hu":["Hozzákapcsol egy művet egy kifejezési formához, amelyet magyarázó vagy kritikai jegyzetek halmazának alapjaként használnak."],"it":["Correla un’opera a un'espressione utilizzata come base per un insieme di note esplicative o critiche."],"lv":["Sasaista darbu ar izteiksmi, kas izmantota par pamatu virknei paskaidrojošu vai kritisku piezīmju."],"nl":["Relateert een werk aan een expressie gebruikt als een basis voor een verzameling van verklarende of kritische noten."],"no":["Relaterer et verk til et uttrykk brukt som utgangspunkt for et sett med forklarende eller kritiske noter."],"tr":["Bir eseri, bir dizi açıklayıcı veya eleştirel not için temel olarak kullanılan bir anlatımla ilişkilendirir."],"vi":["Liên kết tác phẩm với biểu thị được dùng như là chuỗi các ghi chú giải thích hoặc phê bình."],"zh-Hans-CN":["将一种作品与被用作一个解释性或评论性附注之集合的基础的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعليق على تعبيرة","ca":"comentari sobre una expressió","cs