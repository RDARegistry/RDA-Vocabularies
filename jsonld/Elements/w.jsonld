                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/staticVersion.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10377", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByExtensionPlan.en", "label":"has transformation by extension plan"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10382", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/staticVersion.en", "label":"has static version"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10382", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/staticVersion.en", "label":"has static version"}]},{"@id":"http://rdaregistry.info/Elements/w/P10392","label":{"ar":"هو إصدارة ثابتة لـ","ca":"és versió estàtica de","cs":"je statickou verzí (čeho)","da":"er statisk version af","de":"ist statische Version von","de":"ist statische Version von","en":"is static version of","es":"es la versión estática de","et":"staatiline versioon teosest","fi":"staattinen versio teoksesta","fr":"est une version statique de","hu":"statikus változata a következőnek:","it":"è versione statica di","lv":"ir statiska versija no","nl":"is statische versie van","no":"er statisk versjon av","tr":"Sabit sürümüdür","zh-Hans-CN":"是……的静态版本"},"definition":{"ar":["يربط عمل بعمل يحتوي على خطة توسع تم تغييرها من ثابت إلى متكامل لإنشاء عمل."],"ca":["Relaciona una obra amb una obra que té un pla d’extensió que es canvia d’estàtic a integrant per crear una obra."],"cs":["Vztahuje dílo k dílu, které má plán rozšíření, který je změněn ze statického na integrační za účelem vytvoření díla."],"da":["Relaterer et værk til et værk, som har en udvidelsesplan, som, for at skabe et værk, ændres fra statisk til integrerende."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Erweiterungsplan von statisch auf integrierend geändert wird, um ein Werk zu schaffen.,Setzt ein Werk in Beziehung zu einem Werk, dessen Erweiterungsplan von statisch auf integrierend geändert wird, um ein Werk zu schaffen."],"en":["Relates a work to a work that has an extension plan that is changed from static to integrating to create a work."],"es":["Relaciona una obra con una obra que tiene un plan de extensión que se cambia de estático a integrador para crear una obra."],"et":["Seostab teose teosega, mille jätkamiskava on teose loomiseks muudetud staatilisest täienevaks."],"fi":["Liittää teoksen teokseen, jolla on laajennussuunnitelma, joka on muutettu staattisesta päivittyväksi teoksen luomiseksi."],"fr":["Met une œuvre en relation avec une œuvre dont le plan d’extension statique est modifié en plan intégrateur pour créer une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek a közlési terve statikusról integrálóvá változott egy mű létrejövetele érdekében."],"it":["Correla un'opera a un'opera che ha un piano di estensione cambiato da statico a integrato per creare un'opera."],"lv":["Sasaista darbu ar darbu, kam ir paplašināšanas plāns, kas ticis mainīts no statiskā uz integrēto, lai radītu darbu."],"nl":["Relateert een werk aan een werk dat een extensieplan heeft dat is veranderd van statisch naar geïntegreerd om een nieuw werk te vormen."],"no":["Relaterer et verk til et verk som har en utvidelsesplan som er endret fra statisk til integrerende for å skape et verk."],"tr":["Bir eseri, bir eser oluşturmak için durağandan ardışığa değiştirilen bir genişletme planına sahip bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与有扩充计划并被从静态改变为集成性以创作一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة ثابتة لـ","ca":"versió estàtica de","cs":"statická verze (čeho)","da":"statisk version af","de":"Statische Version von","de":"Statische Version von","en":"static version of","es":"versión estática de","et":"staatiline versioon teosest","fi":"staattinen versio teoksesta",