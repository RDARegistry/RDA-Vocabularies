                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/collectorCollectiveAgent.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10629", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectorAgent.en", "label":"has collector agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10631", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectorCorporateBody.en", "label":"has collector corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10632", "lexicalAlias":"http://rdaregistry.info/Elements/w/collectorFamily.en", "label":"has collector family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10630", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/collectorCollectiveAgent.en", "label":"has collector collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10630", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/collectorCollectiveAgent.en", "label":"has collector collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10631","label":{"ca":"té entitat corporativa col·leccionista","cs":"má sběratele (korporaci)","de":"hat Sammlerin/Sammler (Körperschaft)","en":"has collector corporate body","es":"tiene organismo corporativo coleccionista","fi":"kokoelman muodostaja (yhteisö)","fr":"a pour collectivité collectionneuse","hu":"gyűjtő testülete a következő:","tr":"koleksiyon oluşturucu tüzel kişi ile ilişkilidir","zh-Hans-CN":"有收藏者团体"},"definition":{"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra de col·lecció de recursos d’ítems que exemplifiquen la materialització d’altres obres mitjançant la selecció i arranjament."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za vytvoření díla-sbírky výběrem a uspořádáním jednotek, které exemplifikují ztělesnění dalších děl."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines aggregierenden Werks verantwortlich ist, indem sie Expressionen anderer Werke auswählt und zusammenstellt."],"en":["Relates a work to a corporate body who is responsible for creating a collection work by selecting and arranging items that exemplify the embodiment of other works."],"es":["Relaciona una obra con un organismo corporativo que es responsable de crear una obra de colección al seleccionar y disponer ítems que ejemplifican la materialización de otras obras."],"fi":["Liittää teoksen yhteisöön, joka vastaa kokoelmateoksen luomisesta valitsemalla ja järjestämällä kappaleita, jotka edustavat muiden teosten ilmentymää."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre de collection de ressources par la sélection et l’organisation d’items exemplifiant la matérialisation d’autres œuvres."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy gyűjteményes mű létrehozásáért olyan példányok válogatásással és elredendezéssel való összegyűjtésével, amelyek más művek megtestesüléseinek példányai."],"tr":["Bir eseri, diğer eserlerin somutlaşmasını örnek teşkil eden kopyaları seçip düzenleyerek bir koleksiyon eseri oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过选择和整理作为其他作品的具体化之例证的单件而对创作一种收藏作品负责的一个团体关联起来。"]},"ToolkitLabel":{"ca":"entitat corporativa col·leccionista","cs":"sběratel (korporace)","de":"Sammlerin/Sammler (Körperschaft)","en":"collector corporate body","es":"organismo corporativo coleccionista","fi":"kokoelman muodostaja (yhteisö)","fr":"collectivité collectionneuse","hu":"gyűjtő testület","nl":"collectiespecialist-corporatie ?","tr":"k