                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10592", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistFamily.en", "label":"has artist family"},{"@id":"http://rdaregistry.info/Elements/w/P10475", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistCollectiveAgent.en", "label":"has book artist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10569", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/bookArtistFamily.en", "label":"has book artist family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10569", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/bookArtistFamily.en", "label":"has book artist family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10428","label":{"ar":"له شخص فنان كتب","ca":"té com a persona artista de llibre d’art","cs":"má knižního výtvarníka (osobu)","da":"har person, som er bogkunstner","de":"hat Buchkünstlerin/Buchkünstler (Person)","de":"hat Buchkünstlerin/Buchkünstler (Person)","en":"has book artist person","es":"tiene persona artista de libro","et":"raamatukunstnik (isik)","fi":"kirjataiteilija (henkilö)","fr":"a pour personne artiste du livre","hu":"könyvművész személye a következő:","it":"ha come book artist persona","lv":"grāmatu mākslinieks (persona)","nl":"heeft boekkunstenaar-persoon","no":"har bokkunstner (person)","tr":"kitap sanatçısı ile ilişkilidir","zh-Hans-CN":"有图书美术家个人"},"definition":{"ar":["يربط بين عمل وشخص يكون فنانا مسئولاً عن استغلال شكل الكتاب أو تغيير بنيته المادية."],"ca":["Relaciona una obra amb una persona que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física."],"cs":["Vztahuje dílo k osobě, která je umělcem, odpovědným za zpracování podoby knihy nebo změnu její fyzické struktury."],"da":["Relaterer et værk til en person, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist."],"en":["Relates a work to a person who is an artist who is responsible for exploiting the book form or altering its physical structure."],"es":["Relaciona una obra con una persona que es un artista que se encarga de explotar la forma del libro o alterar su estructura física."],"et":["Seostab teose isikuga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest."],"fi":["Liittää teoksen henkilöön, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta."],"fr":["Met une œuvre en relation avec une personne artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique."],"hu":["Hozzákapcsol egy művet egy művész személyhez, aki felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért."],"it":["Correla un'opera alla persona artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica."],"lv":["Sasaista darbu ar personu, kura atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru."],"nl":["Relateert een werk aan een persoon die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur."],"no":["Relaterer et verk til en person som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur."],"tr":["Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص فنان كتب","ca":"persona artista de llibre d’art","cs":"knižní výtvarník (osoba)","da":"person, som er bogkunstner","de":"Buchkünstlerin/Buchkünstler (Person)","de":"Buchkünstlerin/Buchkünstler (Person)","en":"book artist person","es":"persona artista de libro","et":"raamatukunstnik (isik)","fi":"kirjataiteilija (henkilö)","fr":"personne artiste du livre","hu":"könyvművész személy:","it":"book artist persona","lv":"grāmatu mākslinieks (persona)","nl":"boekkunstenaar-persoon","no":"bokkunstner (person)","tr":"kitap sanatçısı","zh-Hans-CN":"图书美术家个人"},"ToolkitDefinition":{"ar":"شخص يكون فنانا مسئولاً عن استغلال شكل الكتاب أو تغيير بنيته المادية.","ca":"Persona que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.","cs":"Osoba, která je umělcem, odpovědným za zpracování podoby knihy nebo změnu její fyzické struktury.","da":"Person, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.","de":"Eine Künstlerin/Ein Künstler (Person), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Person), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","en":"A person who is an artist who is responsible for exploiting the book form or altering its physical structure.","es":"Una persona que es un artista que se encarga de explotar la forma del libro o alterar su estructura física.","et":"Isik, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.","fi":"Henkilö, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.","fr":"Personne artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.","hu":"Egy művész személy, aki felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.","it":"Persona artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica.","lv":"Persona, kura atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.","nl":"Een persoon die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.","no":"En person som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.","tr":"Kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu sanatçı olan kişi.","zh-Hans-CN":"作为一个艺术家负责开发图书外形或改变其物理结构的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10451", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistPerson.en", "label":"has artist person"},{"@id":"http://rdaregistry.info/Elements/w/P10254", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistAgent.en", "label":"has book artist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10428", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/bookArtistPerson.en", "label":"has book artist person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10428", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/bookArtistPerson.en", "label":"has book artist person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10253","label":{"ar":"له وكيل خطاط","ca":"té com a agent cal·lígraf","cs":"má kaligrafa (agenta)","da":"har agent, som er kalligraf","de":"hat Kalligrafin/Kalligraf (Akteur)","de":"hat Kalligrafin/Kalligraf (Akteur)","el":"έχει καλλιγράφο","en":"has calligrapher agent","es":"tiene agente calígrafo","et":"kalligraaf (tegija)","fi":"kalligrafi (toimija)","fr":"a pour agent calligraphe","hu":"kalligráfus ágense a következő:","it":"ha come calligrafo agente","lv":"kaligrāfs (aģents)","nl":"heeft kalligraaf-actor","no":"har kalligraf (agent)","tr":"kaligraf temsilci ile ilişkilidir","vi":"có người viết chữ đẹp","zh-Hans-CN":"有书法者行为者"},"definition":{"ar":["يربط بين عمل ووكيل هو فنانً مسئول عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عما إذا كان الوكيل نفسه مسئولاً أيضًا عن النص المكتوب."],"ca":["Relaciona una obra amb un agent que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si el mateix agent és també responsable del text inscrit."],"cs":["Vztahuje dílo k agentovi, který je umělcem odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tentýž agent je také odpovědný za napsaný text."],"da":["Relaterer et værk til en agent, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme agent også har forfattet den indskrevne tekst."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Akteur), die/der für die Kalligrafie verantwortlich ist, bei der im Mittelpunkt des Interesses der ästhetische Wert dessen Schreibkunst oder die grafische Kunstfertigkeit liegt, unabhängig davon, ob derselbe Akteur auch für den aufgeschriebenen Text verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Akteur), die/der für die Kalligrafie verantwortlich ist, bei der im Mittelpunkt des Interesses der ästhetische Wert dessen Schreibkunst oder die grafische Kunstfertigkeit liegt, unabhängig davon, ob derselbe Akteur auch für den aufgeschriebenen Text verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν καλλιτέχνη υπεύθυνο για τη δημιουργία ενός καλλιγραφικού έργου, όπου το ενδιαφέρον εστιάζει στην αισθητική αξία της καλλιγραφίας ή της γραφικής δεξιοτεχνίας, ανεξάρτητα από το αν πρόκειται για το ίδιο φυσικό πρόσωπο κ.λπ., επίση υπεύθυνο για το χαραγμένο κείμενο."],"en":["Relates a work to an agent who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same agent is also responsible for the inscribed text."],"es":["Relaciona una obra con un agente que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de que el mismo agente sea también responsable del texto inscrito."],"et":["Seostab teose tegijaga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama tegija on vastutav ka kirjutatud teksti eest."],"fi":["Liittää teoksen toimijaan, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une œuvre en relation avec un agent artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que le même agent soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy művet egy művész ágenshez, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz az ágens a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla un’opera all'agente artista responsabile per la calligrafia quando il centro d’interesse risiede nel valore estetico della scrittura o della grafica, indipendentemente dal fatto che lo stesso agente sia anche responsabile per il testo scritto."],"lv":["Sasaista darbu ar aģentu mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tas pats aģents ir atbildīgs arī par ierakstīto tekstu."],"nl":["Relateert een werk aan een actor die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde actor ook verantwoordelijk is voor de geschreven tekst."],"no":["Relaterer et verk til en agent som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet."],"tr":["Bir eseri, aynı temsilcinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının el yazısının estetik değerinde veya grafik sanatında olduğu kaligrafiden sorumlu sanatçı olan temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với nghệ sỹ có trách nhiệm tạo ra tác phẩm nghệ thuật viết chữ đẹp nơi mà tập trung của sự chú ý nằm ở giá trị thẩm mỹ của phong cách viết hoặc nghệ thuật đồ hình, không phân biệt có cùng cá nhân, v.v... hay không, cũng là tác giả của văn bản được viết."],"zh-Hans-CN":["将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل خطاط","ca":"agent cal·lígraf","cs":"kaligraf (agent)","da":"agent, som er kalligraf","de":"Kalligrafin/Kalligraf (Akteur)","de":"Kalligrafin/Kalligraf (Akteur)","el":"καλλιγράφος","en":"calligrapher agent","es":"agente calígrafo","et":"kalligraaf (tegija)","fi":"kalligrafi (toimija)","fr":"agent calligraphe","hu":"kalligráfus ágens:","it":"calligrafo agente","lv":"kaligrāfs (aģents)","nl":"kalligraaf-actor","no":"kalligraf (agent)","tr":"kaligraf temsilcisi","vi":"người viết chữ đẹp","zh-Hans-CN":"书法者行为者"},"ToolkitDefinition":{"ar":"وكيل يكون فنانا مسئولا عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عما إذا كان الوكيل نفسه مسئولاً أيضًا عن النص المكتوب.","ca":"Agent que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si el mateix agent és també responsable del text inscrit.","cs":"Agent, který je umělcem odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tentýž agent je také odpovědný za napsaný text.","da":"Agent, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme agent også har forfattet den indskrevne tekst.","de":"Eine Künstlerin/Ein Künstler (Akteur), die/der für die Kalligrafie verantwortlich ist, bei der im Mittelpunkt des Interesses der ästhetische Wert dessen Schreibkunst oder die grafische Kunstfertigkeit liegt, unabhängig davon, ob derselbe Akteur auch für den aufgeschriebenen Text verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Akteur), die/der für die Kalligrafie verantwortlich ist, bei der im Mittelpunkt des Interesses der ästhetische Wert dessen Schreibkunst oder die grafische Kunstfertigkeit liegt, unabhängig davon, ob derselbe Akteur auch für den aufgeschriebenen Text verantwortlich ist.","el":"Ένας καλλιτέχνης υπεύθυνος για τη δημιουργία ενός καλλιγραφικού έργου, όπου το ενδιαφέρον εστιάζει στην αισθητική αξία της καλλιγραφίας ή της γραφικής δεξιοτεχνίας, ανεξάρτητα από το αν πρόκειται για το ίδιο φυσικό πρόσωπο κ.λπ., επίση υπεύθυνο για το χαραγμένο κείμενο.","en":"An agent who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same agent is also responsible for the inscribed text.","es":"Un agente que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de que el mismo agente sea también responsable del texto inscrito.","et":"Tegija, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama tegija on vastutav ka kirjutatud teksti eest.","fi":"Toimija, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä.","fr":"Agent artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que le même agent soit aussi responsable du texte calligraphié.","hu":"Egy művész ágens, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafikus művésziség áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz az ágens a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Agente artista che è responsabile per la calligrafia quando il centro d’interesse risiede nel valore estetico della scrittura o della grafica, indipendentemente dal fatto che lo stesso agente sia anche responsabile per il testo scritto.","lv":"Aģents mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tas pats aģents ir atbildīgs arī par ierakstīto tekstu.","nl":"Een actor die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde actor ook verantwoordelijk is voor de geschreven tekst.","no":"En agent som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.","tr":"Aynı temsilcinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının el yazısının estetik değerinde veya grafik sanatında olduğu kaligrafiden sorumlu bir sanatçı olan temsilci.","vi":"Nghệ sỹ có trách nhiệm tạo ra tác phẩm nghệ thuật viết chữ đẹp nơi mà tập trung của sự chú ý nằm ở giá trị thẩm mỹ của phong cách viết hoặc nghệ thuật đồ hình, không phân biệt có cùng cá nhân, v.v... Hay không, cũng là tác giả của văn bản được viết.","zh-Hans-CN":"作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个行为者"},"altLabel":{"ar":["خطاط"],"ca":["cal·lígraf"],"cs":["kaligraf"],"da":["kalligraf"],"de":["Kalligraf,Kalligraf"],"en":["calligrapher"],"es":["calígrafo"],"et":["kalligraaf"],"fi":["kalligrafi"],"fr":["calligraphe"],"hu":["kalligráfus:"],"it":["calligrafo"],"no":["kalligraf"],"tr":["kaligraf"],"zh-Hans-CN":["书法者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10058", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistAgent.en", "label":"has artist agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10473", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCollectiveAgent.en", "label":"has calligrapher collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10426", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherPerson.en", "label":"has calligrapher person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10253", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/calligrapherAgent.en", "label":"has calligrapher agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10253", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/calligrapherAgent.en", "label":"has calligrapher agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10473","label":{"ar":"له وكيل جماعي خطاط","ca":"té com a agent col·lectiu cal·lígraf","cs":"má kaligrafa (kolektivního agenta)","da":"har kollektiv agent, som er kalligraf","de":"hat Kalligrafin/Kalligrafen (Gemeinschaftlicher Akteur)","de":"hat Kalligrafin/Kalligrafen (Gemeinschaftlicher Akteur)","en":"has calligrapher collective agent","es":"tiene agente colectivo calígrafo","et":"kalligraaf (kollektiiv)","fi":"kalligrafi (yhteistoimija)","fr":"a pour agent collectif calligraphe","hu":"kalligráfus kollektív ágense a következő:","it":"ha come calligrafo agente collettivo","lv":"kaligrāfs (grupa)","nl":"heeft kalligraaf-collectieve actor","no":"har kalligraf (kollektiv agent)","tr":"kaligraf kolektif temsilci ile ilişkilidir","zh-Hans-CN":"有书法者集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي يكون فنانا مسئولاً عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الوكيل الجماعي نفسه مسئولاً أيضًا عن النص المدرج."],"ca":["Relaciona una obra amb un agent col·lectiu que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si el mateix agent col·lectiu és també responsable del text inscrit."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je umělcem, který je odpovědný za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tentýž kolektivní agent je též odpovědný za napsaný text."],"da":["Relaterer et værk til en kollektiv agent, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob derselbe gemeinschaftliche Akteur auch für den aufgeschriebenen Text verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob derselbe gemeinschaftliche Akteur auch für den aufgeschriebenen Text verantwortlich ist."],"en":["Relates a work to a collective agent who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same collective agent is also responsible for the inscribed text."],"es":["Relaciona una obra con un agente colectivo que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de que el mismo agente colectivo sea también responsable del texto inscrito."],"et":["Seostab teose kollektiiviga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama kollektiiv on vastutav ka kirjutatud teksti eest."],"fi":["Liittää teoksen yhteistoimijaan, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteistoimija myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une œuvre en relation avec un agent collectif artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que le même agent collectif soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy művet egy művész kollektív ágenshez, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a kollektív ágens a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla un'opera all'agente collettivo che è l'artista responsabile della calligrafia, laddove l'oggetto dell'interesse risiede nel valore estetico della calligrafia o della maestria grafica, a prescindere dal fatto che lo stesso agente collettivo sia anche responsabile del testo inscritto."],"lv":["Sasaista darbu ar grupu mākslinieks, ir atbildīga par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par uzrakstīto tekstu."],"nl":["Relateert een werk aan een collectieve actor die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde collectieve actor ook verantwoordelijk is voor de inscriptie."],"no":["Relaterer et verk til en kollektiv agent som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet."],"tr":["Bir eseri, aynı temsilcinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan kolektif bir temsilci ile ilişkilendirir"],"zh-Hans-CN":["将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي خطاط","ca":"agent col·lectiu cal·lígraf","cs":"kaligraf (kolektivní agent)","da":"kollektiv agent, som er kalligraf","de":"Kalligrafin/Kalligraf (Gemeinschaftlicher Akteur)","de":"Kalligrafin/Kalligraf (Gemeinschaftlicher Akteur)","en":"calligrapher collective agent","es":"agente colectivo calígrafo","et":"kalligraaf (kollektiiv)","fi":"kalligrafi (yhteistoimija)","fr":"agent collectif calligraphe","hu":"kalligráfus kollektív ágens:","it":"calligrafo agente collettivo","lv":"kaligrāfs (grupa)","nl":"kalligraaf-collectieve actor","no":"kalligraf (kollektiv agent)","tr":"kaligraf kolektif temsilcisi","zh-Hans-CN":"书法者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي خطاط يكون فنانا مسئولاً عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الوكيل الجماعي نفسه مسئولاً أيضًا عن النص المدرج.","ca":"Agent col·lectiu que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si el mateix agent col·lectiu és també responsable del text inscrit.","cs":"Kolektivní agent, který je umělcem, který je odpovědný za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tentýž kolektivní agent je též odpovědný za napsaný text.","da":"Kollektiv agent, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.","de":"Eine Künstlerin/Ein Künstler (Gemeinschaftlicher Akteur), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob derselbe gemeinschaftliche Akteur auch für den aufgeschriebenen Text verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Gemeinschaftlicher Akteur), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob derselbe gemeinschaftliche Akteur auch für den aufgeschriebenen Text verantwortlich ist.","en":"A collective agent who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same collective agent is also responsible for the inscribed text.","es":"Un agente colectivo que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de que el mismo agente colectivo sea también responsable del texto inscrito.","et":"Kollektiiv, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama kollektiiv on vastutav ka kirjutatud teksti eest.","fi":"Yhteistoimija, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteistoimija myös vastuussa kirjoitetusta tekstistä.","fr":"Agent collectif artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que le même agent collectif soit aussi responsable du texte calligraphié.","hu":"Egy művész kollektív ágens, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a kollektív ágens a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Agente collettivo che è l'artista responsabile della calligrafia, laddove l'oggetto dell'interesse risiede nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che lo stesso agente collettivo sia anche responsabile del testo inscritto.","lv":"Grupa mākslinieks, ir atbildīga par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par uzrakstīto tekstu.","nl":"Een collectieve actor die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde collectieve actor ook verantwoordelijk is voor de inscriptie.","no":"En kollektiv agent som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.","tr":"Aynı kolektif temsilcinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan bir kolektif temsilci.","zh-Hans-CN":"作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个集体行为者"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10498", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistCollectiveAgent.en", "label":"has artist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10253", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherAgent.en", "label":"has calligrapher agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10520", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCorporateBody.en", "label":"has calligrapher corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10567", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherFamily.en", "label":"has calligrapher family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10473", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/calligrapherCollectiveAgent.en", "label":"has calligrapher collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10473", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/calligrapherCollectiveAgent.en", "label":"has calligrapher collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10520","label":{"ar":"له هيئة خطاطة","ca":"té com a entitat corporativa cal·lígrafa","cs":"má kaligrafa (korporaci)","da":"har korporation, som er kalligraf","de":"hat Kalligrafin/Kalligrafen (Körperschaft)","de":"hat Kalligrafin/Kalligrafen (Körperschaft)","en":"has calligrapher corporate body","es":"tiene cuerpo corporativo calígrafo","et":"kalligraaf (asutus)","fi":"kalligrafi (yhteisö)","fr":"a pour collectivité calligraphe","hu":"kalligráfus testülete a következő:","it":"ha come calligrafo ente","lv":"kaligrāfs (institūcija)","nl":"heeft kalligraaf-corporatie","no":"har kalligraf (korporasjon)","tr":"kaligraf tüzel kişi ile ilişkilidir","zh-Hans-CN":"有书法者团体"},"definition":{"ar":["يربط بين عمل وهيئة تكون فنانة مسئولة عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الهيئة نفسها مسئولة أيضًا عن النص المدرج."],"ca":["Relaciona una obra amb una entitat corporativa que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa entitat corporativa és també responsable del text inscrit."],"cs":["Vztahuje dílo ke korporaci, která je umělcem, odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž korporace je též odpovědná za napsaný text."],"da":["Relaterer et værk til en korporation, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Körperschaft), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Körperschaft auch für den aufgeschriebenen Text verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Körperschaft), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Körperschaft auch für den aufgeschriebenen Text verantwortlich ist."],"en":["Relates a work to a corporate body who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same corporate body is also responsible for the inscribed text."],"es":["Relaciona una obra con un cuerpo corporativo que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de si el mismo cuerpo corporativo también es responsable del texto inscrito."],"et":["Seostab teose asutusega, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama asutus on vastutav ka kirjutatud teksti eest."],"fi":["Liittää teoksen yhteisöön, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteisö myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une œuvre en relation avec une collectivité artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même collectivité soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy művet egy művész testülethez, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a testület a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla un'opera a un ente responsabile della calligrafia, laddove l'oggetto dell'interesse risiede nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che lo stesso ente sia anche responsabile per il testo scritto."],"lv":["Sasaista darbu ar institūciju mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīgs arī par ierakstīto tekstu."],"nl":["Relateert een werk aan een corporatie die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde corporatie ook verantwoordelijk is voor de inscriptie."],"no":["Relaterer et verk til en korporasjon som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet."],"tr":["Bir eseri, aynı tüzel kişinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一团体是否负责题写文字）的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة خطاطة","ca":"entitat corporativa cal·lígrafa","cs":"kaligraf (korporace)","da":"korporation, som er kalligraf","de":"Kalligrafin/Kalligraf (Körperschaft)","de":"Kalligrafin/Kalligraf (Körperschaft)","en":"calligrapher corporate body","es":"cuerpo corporativo calígrafo","et":"kalligraaf (asutus)","fi":"kalligrafi (yhteisö)","fr":"collectivité calligraphe","hu":"kalligráfus testület:","it":"calligrafo ente","lv":"kaligrāfs (institūcija)","nl":"kalligraaf-corporatie","no":"kalligraf (korporasjon)","tr":"kaligraf tüzel kişisi","zh-Hans-CN":"书法者团体"},"ToolkitDefinition":{"ar":"هيئة تكون فنانة مسئولة عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الهيئة نفسها مسئولة أيضًا عن النص المدرج.","ca":"Entitat corporativa que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa entitat corporativa és també responsable del text inscrit.","cs":"Korporace, která je umělcem, odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž korporace je též odpovědná za napsaný text.","da":"Korporation, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.","de":"Eine Künstlerin/Ein Künstler (Körperschaft), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Körperschaft auch für den aufgeschriebenen Text verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Körperschaft), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Körperschaft auch für den aufgeschriebenen Text verantwortlich ist.","en":"A corporate body who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same corporate body is also responsible for the inscribed text.","es":"Un cuerpo corporativo que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de si el mismo cuerpo corporativo también es responsable del texto inscrito.","et":"Asutus, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama asutus on vastutav ka kirjutatud teksti eest.","fi":"Yhteisö, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteisö myös vastuussa kirjoitetusta tekstistä.","fr":"Collectivité artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même collectivité soit aussi responsable du texte calligraphié.","hu":"Egy művész testület, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a testület a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Ente responsabile della calligrafia, laddove l'oggetto dell'interesse risiede nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che lo stesso ente sia anche responsabile per il testo scritto.","lv":"Institūcija mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīgs arī par ierakstīto tekstu.","nl":"Een corporatie die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde corporatie ook verantwoordelijk is voor de inscriptie.","no":"En korporasjon som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.","tr":"Aynı tüzel kişinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlığın veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan bir tüzel kişi.","zh-Hans-CN":"作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一团体是否负责题写文字）的一个团体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10545", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistCorporateBody.en", "label":"has artist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10473", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCollectiveAgent.en", "label":"has calligrapher collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10520", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/calligrapherCorporateBody.en", "label":"has calligrapher corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10520", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/calligrapherCorporateBody.en", "label":"has calligrapher corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10567","label":{"ar":"له عائلة خطاطة","ca":"té com a família cal·lígrafa","cs":"má kaligrafa (rodinu)","da":"har familie, som er kalligraf","de":"hat Kalligrafin/Kalligrafen (Familie)","de":"hat Kalligrafin/Kalligrafen (Familie)","en":"has calligrapher family","es":"tiene familia calígrafa","et":"kalligraaf (perekond)","fi":"kalligrafi (suku)","fr":"a pour famille calligraphe","hu":"kalligráfus családja a következő:","it":"ha come calligrafo famiglia","lv":"kaligrāfs (dzimta/ģimene)","nl":"heeft kalligraaf-familie","no":"har kalligraf (familie)","tr":"kaligraf aile ile ilişkilidir","zh-Hans-CN":"有书法者家族"},"definition":{"ar":["يربط بين عمل وعائلة تكون فنانة مسئولة عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون العائلة نفسها مسئولة أيضًا عن النص المدرج."],"ca":["Relaciona una obra amb una família que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa família és també responsable del text inscrit."],"cs":["Vztahuje dílo k rodině, která je umělcem, odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž rodina je též odpovědná za napsaný text."],"da":["Relaterer et værk til en familie, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist."],"en":["Relates a work to a family who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same family is also responsible for the inscribed text."],"es":["Relaciona una obra con una familia que es una artista quien es responsable de la caligrafía donde el foco de interés yace en el valor estético de la caligrafía o habilidad artística gráfica, sin importar si la misma familia también es responsable del texto inscrito."],"et":["Seostab teose perekonnaga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama perekond on vastutav ka kirjutatud teksti eest."],"fi":["Liittää teoksen sukuun, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama suku myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une œuvre en relation avec une famille artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même famille soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy művet egy művész családhoz, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a család a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla un'opera alla famiglia artista responsabile della calligrafia, laddove l'oggetto dell'interesse risieda nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che la stessa famiglia sia anche responsabile per il testo scritto."],"lv":["Sasaista darbu ar dzimtu/ģimeni mākslinieks, kas ir atbildīga par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par ierakstīto tekstu."],"nl":["Relateert een werk aan een familie die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde familie ook verantwoordelijk is voor de inscriptie."],"no":["Relaterer et verk til en familie som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet."],"tr":["Bir eseri, aynı ailenin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan bir aileyle ilişkilendirir"],"zh-Hans-CN":["将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一家族是否负责题写文字）的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة خطاطة","ca":"família cal·lígrafa","cs":"kaligraf (rodina)","da":"familie, som er kalligraf","de":"Kalligrafin/Kalligrafen (Familie)","de":"Kalligrafin/Kalligrafen (Familie)","en":"calligrapher family","es":"familia calígrafa","et":"kalligraaf (perekond)","fi":"kalligrafi (suku)","fr":"famille calligraphe","hu":"kalligráfus család:","it":"calligrafo famiglia","lv":"kaligrāfs (dzimta/ģimene)","nl":"kalligraaf-familie","no":"kalligraf (familie)","tr":"kaligraf ailesi","zh-Hans-CN":"书法者家族"},"ToolkitDefinition":{"ar":"عائلة تكون فنانة مسئولة عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون العائلة نفسها مسئولة أيضًا عن النص المدرج.","ca":"Família que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa família és també responsable del text inscrit.","cs":"Rodina, která je umělcem, odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž rodina je též odpovědná za napsaný text.","da":"Familie, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.","de":"Eine Künstlerin/Ein Künstler (Familie), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Familie), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.","en":"A family who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same family is also responsible for the inscribed text.","es":"Una familia que es una artista quien es responsable de la caligrafía donde el foco de interés yace en el valor estético de la caligrafía o habilidad artística gráfica, sin importar si la misma familia también es responsable del texto inscrito.","et":"Perekond, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama perekond on vastutav ka kirjutatud teksti eest.","fi":"Suku, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama suku myös vastuussa kirjoitetusta tekstistä.","fr":"Famille artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même famille soit aussi responsable du texte calligraphié.","hu":"Egy család, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a család a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Famiglia artista responsabile della calligrafia, laddove l'oggetto dell'interesse risieda nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che la stessa famiglia sia anche responsabile per il testo scritto.","lv":"Dzimta/ģimene mākslinieks, kas ir atbildīga par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par ierakstīto tekstu.","nl":"Een familie die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde familie ook verantwoordelijk is voor de inscriptie.","no":"En familie som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.","tr":"Estetik değeri kaligrafideki yazı sanatı veya grafik sanatta bulunan ve yazılı metinden bağımsız olarak bu kaligrafiden sorumlu olan bir sanatçı aile.","zh-Hans-CN":"作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一家族是否负责题写文字）的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10592", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistFamily.en", "label":"has artist family"},{"@id":"http://rdaregistry.info/Elements/w/P10473", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherCollectiveAgent.en", "label":"has calligrapher collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10567", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/calligrapherFamily.en", "label":"has calligrapher family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10567", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/calligrapherFamily.en", "label":"has calligrapher family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10426","label":{"ar":"له شخص خطاط","ca":"té com a persona cal·lígrafa","cs":"má kaligrafa (osobu)","da":"har person, som er kalligraf","de":"hat Kalligrafin/Kalligrafen (Person)","de":"hat Kalligrafin/Kalligrafen (Person)","en":"has calligrapher person","es":"tiene persona calígrafa","et":"kalligraaf (isik)","fi":"kalligrafi (henkilö)","fr":"a pour personne calligraphe","hu":"kalligráfus személye a következő:","it":"ha come calligrafo persona","lv":"kaligrāfs (persona)","nl":"heeft kalligraaf-persoon","no":"har kalligraf (person)","tr":"kaligraf ile ilişkilidir","zh-Hans-CN":"有书法者个人"},"definition":{"ar":["يربط بين عمل وشخص يكون فنانا مسئولاً عن فن الخط حيث ينصب تركيز الاهتمام على القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الشخص نفسه مسئولاً أيضًا عن النص المدون."],"ca":["Relaciona una obra amb una persona que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa persona és també responsable del text inscrit."],"cs":["Vztahuje dílo k osobě, která je umělcem odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž osoba je také odpovědná za napsaný text."],"da":["Relaterer et værk til en person, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist."],"en":["Relates a work to a person who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same person is also responsible for the inscribed text."],"es":["Relaciona una obra con una persona que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o del arte gráfico, independientemente de que la misma persona sea también responsable del texto inscrito."],"et":["Seostab teose isikuga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama isik on vastutav ka kirjutatud teksti eest."],"fi":["Liittää teoksen henkilöön, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä."],"fr":["Met une œuvre en relation avec une personne artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même personne soit aussi responsable du texte calligraphié."],"hu":["Hozzákapcsol egy művet egy művész személyhez, aki felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafikus művésziség áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a személy a lejegyzett szöveg szerzője is egyben vagy sem."],"it":["Correla un'opera alla persona artista responsabile della calligrafia, laddove l'oggetto dell'interesse risieda nel valore estetico della calligrafia o maestria grafica, a prescindere che la stessa persona sia anche responsabile del testo inscritto."],"lv":["Sasaista darbu ar personu mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par ierakstīto tekstu."],"nl":["Relateert een werk aan een persoon die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde persoon ook verantwoordelijk is voor de inscriptie."],"no":["Relaterer et verk til en person som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet."],"tr":["Bir eseri aynı kişinin yazılı metinden sorumlu olup olmadığına bakılmaksızın, hattatlığın veya grafik sanatının estetik değerinin ön plana çıktığı, kaligrafiden sorumlu sanatçı olan kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一个人是否负责题写文字）的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص خطاط","ca":"persona cal·lígrafa","cs":"kaligraf (osoba)","da":"person, som er kalligraf","de":"Kalligrafin/Kalligraf (Person)","de":"Kalligrafin/Kalligraf (Person)","en":"calligrapher person","es":"persona calígrafa","et":"kalligraaf (isik)","fi":"kalligrafi (henkilö)","fr":"personne calligraphe","hu":"kalligráfus személy:","it":"calligrafo persona","lv":"kaligrāfs (persona)","nl":"kalligraaf-persoon","no":"kalligraf (person)","tr":"kaligraf","zh-Hans-CN":"书法者个人"},"ToolkitDefinition":{"ar":"شخص يكون فنانا مسئولاً عن فن الخط حيث ينصب تركيز الاهتمام على القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الشخص نفسه مسئولاً أيضًا عن النص المدون.","ca":"Persona que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa persona és també responsable del text inscrit.","cs":"Osoba, která je umělcem odpovědným za kaligrafii, pokud je středem zájmu estetická hodnota rukopisu nebo grafického umění bez ohledu na to, jestli tatáž osoba je také odpovědná za napsaný text.","da":"Person, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.","de":"Eine Künstlerin/Ein Künstler (Person), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Person), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.","en":"A person who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same person is also responsible for the inscribed text.","es":"Una persona que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o del arte gráfico, independientemente de que la misma persona sea también responsable del texto inscrito.","et":"Isik, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama isik on vastutav ka kirjutatud teksti eest.","fi":"Henkilö, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä.","fr":"Personne artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même personne soit aussi responsable du texte calligraphié.","hu":"Egy művész személy, aki felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafikus művésziség áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a személy a lejegyzett szöveg szerzője is egyben vagy sem.","it":"Persona artista,  responsabile della calligrafia, laddove l'oggetto dell'interesse risieda nel valore estetico della calligrafia o maestria grafica, a prescindere che la stessa persona sia anche responsabile del testo inscritto.","lv":"Persona mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par ierakstīto tekstu.","nl":"Een persoon die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde persoon ook verantwoordelijk is voor de inscriptie.","no":"En person som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.","tr":"Aynı kişinin metin sorumluluğuna bakılmaksızın, hattatlığın veya grafik sanatının estetik değerinin ön plana çıktığı, kaligrafiden sorumlu sanatçı olan kişi.","zh-Hans-CN":"作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一个人是否负责题写文字）的一个个人"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10451", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistPerson.en", "label":"has artist person"},{"@id":"http://rdaregistry.info/Elements/w/P10253", "lexicalAlias":"http://rdaregistry.info/Elements/w/calligrapherAgent.en", "label":"has calligrapher agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10426", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/calligrapherPerson.en", "label":"has calligrapher person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10426", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/calligrapherPerson.en", "label":"has calligrapher person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10387","label":{"ar":"له إصدارة ناقل","ca":"té com a versió de suport físic","cs":"má verzi na jiném nosiči","da":"har bærerversion","de":"hat Datenträgerversion","de":"hat Datenträgerversion","en":"has carrier version","es":"tiene soporte de versión","et":"kandjaversioon","fi":"tallenneversio","fr":"a pour version sur support matériel différent","hu":"hordozóváltozata a következő:","it":"ha come versione di supporto","lv":"nesēja variants","nl":"heeft dragerversie","no":"har bærerversjon","tr":"taşıyıcı sürümü ile ilişkilidir","zh-Hans-CN":"有载体版本"},"definition":{"ar":["يربط عمل بعمل يتم إنشاؤه عن طريق تغيير ناقل عمل."],"ca":["Relaciona una obra amb una obra que es crea canviant el suport físic d’una obra."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou nosiče díla."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre et værks bærer."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Datenträgers eines Werks geschaffen wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung des Datenträgers eines Werks geschaffen wird."],"en":["Relates a work to a work that is created by changing the carrier of a work."],"es":["Relaciona una obra con una obra que se crea cambiando el soporte de una obra."],"et":["Seostab teose teosega, mis on loodud, muutes teose kandjat."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen tallennetta."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le support matériel d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű hordozójának megváltozása következtében jött létre."],"it":["Correla un'opera a un'opera creata cambiando il supporto di un'opera."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba nesēju."],"nl":["Relateert een werk aan een werk dat gecreëerd wordt door het wijzigen van de drager van een werk."],"no":["Relaterer et verk til et verk som er skapt ved endring av bæreren for et verk."],"tr":["Bir eseri, bir eserin taşıyıcısı değiştirilerek oluşturulan eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过改变一种作品的载体而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة ناقل","ca":"versió de suport físic","cs":"verze na jiném nosiči","da":"bærerversion","de":"Datenträgerversion","de":"Datenträgerversion","en":"carrier version","es":"soporte de versión","et":"kandjaversioon","fi":"tallenneversio","fr":"version sur support matériel différent","hu":"hordozóváltozata:","it":"versione di supporto","lv":"nesēja variants","nl":"dragerversie","no":"bærerversjon","tr":"taşıyıcı versiyonu","zh-Hans-CN":"载体版本"},"ToolkitDefinition":{"ar":"عمل يتم إنشاؤه عن طريق تغيير ناقل عمل.","ca":"Obra que es crea canviant el suport físic d’una obra.","cs":"Dílo, které je vytvořeno změnou nosiče díla.","da":"Værk, som er skabt ved at ændre et værks bærer.","de":"Ein Werk, das durch eine Änderung des Datenträgers eines Werks erstellt wird.","de":"Ein Werk, das durch eine Änderung des Datenträgers eines Werks erstellt wird.","en":"A work that is created by changing the carrier of a work.","es":"Una obra que se crea cambiando el soporte de una obra.","et":"Teos, mis on loodud, muutes teose kandjat.","fi":"Teos, joka on luotu muuttamalla teoksen tallennetta.","fr":"Œuvre qui est créée en modifiant le support matériel d’une œuvre.","hu":"Egy mű, amely egy mű hordozójának megváltozása következtében jött létre.","it":"Opera creata modificando il supporto di un'opera.","lv":"Darbs, kas radīts, mainot darba nesēju.","nl":"Een werk dat gecreëerd wordt door het wijzigen van de drager van een werk.","no":"Et verk som er skapt ved endring av bæreren for et verk.","tr":"Bir eserin taşıyıcısı değiştirilerek oluşturulan bir eser.","zh-Hans-CN":"通过改变一种作品的载体而被创作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/carrierVersion.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10383", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudience.en", "label":"has transformation by audience"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10387", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/carrierVersion.en", "label":"has carrier version"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10387", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/carrierVersion.en", "label":"has carrier version"}]},{"@id":"http://rdaregistry.info/Elements/w/P10390","label":{"ar":"هو إصدارة ناقل لـ","ca":"és versió de suport físic de","cs":"je verzí na jiném nosiči (čeho)","da":"er bærerversion af","de":"ist Datenträgerversion von","de":"ist Datenträgerversion von","en":"is carrier version of","es":"es el soporte de versión de","et":"kandjaversioon teosest","fi":"tallenneversio teoksesta","fr":"est une version sur support matériel différent de","hu":"hordozóváltozata a következőnek:","it":"è versione di supporto di","lv":"ir nesēja variants no","nl":"is dragerversie van","no":"er bærerversjon av","tr":"taşıyıcı sürümüdür","zh-Hans-CN":"是……的载体版本"},"definition":{"ar":["يربط عمل بعمل له ناقل يتم تغييره لإنشاء عمل."],"ca":["Relaciona una obra amb una obra que té un suport físic que es canvia per crear una obra."],"cs":["Vztahuje dílo k dílu, které má nosič, který je změněn za účelem vytvoření díla."],"da":["Relaterer et værk til et værk, som har en bærer, som ændres for at skabe et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Datenträger geändert wird, um ein Werk zu schaffen.,Setzt ein Werk in Beziehung zu einem Werk, dessen Datenträger geändert wird, um ein Werk zu schaffen."],"en":["Relates a work to a work that has a carrier that is changed to create a work."],"es":["Relaciona una obra con una obra que tiene un soporte que se cambia para crear una obra."],"et":["Seostab teose teosega, mille kandjat on teose loomiseks muudetud."],"fi":["Liittää teoksen teokseen, jolla on tallenne, jota on muutettu teoksen luomiseksi."],"fr":["Met une œuvre en relation avec une œuvre dont le support matériel est modifié pour créer une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek a hordozója megváltozott egy mű létrejövetele érdekében."],"it":["Correla un'opera a un'opera che ha un supporto cambiato per creare un'opera."],"lv":["Sasaista darbu ar darbu, kam nesējs ticis mainīts, lai radītu darbu."],"nl":["Relateert een werk aan een werk dat een drager heeft die gewijzigd wordt om een ander werk te creëren."],"no":["Relaterer et verk til et verk som har en bærer som er endret for å skape et verk."],"tr":["Bir eseri, bir eser oluşturmak için değiştirilen bir taşıyıcıya sahip bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与有载体并被改变以创作一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة ناقل لـ","ca":"versió de suport físic de","cs":"verze na jiném nosiči (čeho)","da":"bærerversion af","de":"Datenträgerversion von","de":"Datenträgerversion von","en":"carrier version of","es":"soporte de versión de","et":"kandjaversioon teosest","fi":"tallenneversio teoksesta","fr":"version sur support matériel différent de","hu":"hordozóváltozata:","it":"versione di supporto di","lv":"nesēja variants no","nl":"dragerversie van","no":"bærerversjon av","tr":"taşıyıcı versiyonu","zh-Hans-CN":"……的载体版本"},"ToolkitDefinition":{"ar":"عمل به ناقل تم تغييره لإنشاء عمل.","ca":"Obra que té un suport físic que es canvia per crear una obra.","cs":"Dílo, které má nosič, který je změněn za účelem vytvoření díla.","da":"Værk, som har en bærer, som ændres for at skabe et værk.","de":"Ein Werk, dessen Datenträger geändert wird, um ein Werk zu schaffen.","de":"Ein Werk, dessen Datenträger geändert wird, um ein Werk zu schaffen.","en":"A work that has a carrier that is changed to create a work.","es":"Una obra que tiene un soporte que se cambia para crear una obra.","et":"Teos, mille kandjat on teose loomiseks muudetud.","fi":"Teos, jolla on tallenne, jota on muutettu teoksen luomiseksi.","fr":"Œuvre dont le support matériel est modifié pour créer une œuvre.","hu":"Egy mű, amelynek a hordozója megváltozott egy mű létrejövetele érdekében.","it":"Opera che ha un supporto cambiato per creare un'opera.","lv":"Darbs, kam nesējs ticis mainīts, lai radītu darbu.","nl":"Een werk dat een drager heeft die gewijzigd wordt om een ander werk te creëren.","no":"Et verk som har en bærer som er endret for å skape et verk.","tr":"Bir eserin, bir taşıyıcıyı değiştirerek oluşturulduğu bir eser.","zh-Hans-CN":"有载体并被改变以创作一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/carrierVersionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10384", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudienceOf.en", "label":"is transformation by audience of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10390", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/carrierVersionOf.en", "label":"is carrier version of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10390", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/carrierVersionOf.en", "label":"is carrier version of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10052","label":{"ar":"له وكيل رسام خرائط لعمل","ca":"té com a agent cartògraf d’una obra","cs":"má kartografa díla (agenta)","da":"har agent, som er kartograf for værk","de":"hat Kartografin/Kartografen eines Werks (Akteur)","de":"hat Kartografin/Kartografen eines Werks (Akteur)","el":"έχει χαρτογράφο","en":"has cartographer agent of work","es":"tiene agente cartógrafo de obra","et":"teose kartograaf (tegija)","fi":"teoksen kartantekijä (toimija)","fr":"a pour agent cartographe d’une œuvre","hu":"mű térképész ágense a következő:","it":"ha come cartografo agente di opera","lv":"darba kartogrāfs (aģents)","nl":"heeft cartograaf-actor van werk","no":"har kartograf for verk (agent)","tr":"eserin kartograf temsilcisi ile ilişkilidir","vi":"có người lập bản đồ","zh-Hans-CN":"有作品的地图绘制者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن إنشاء عمل خرائطي."],"ca":["Relaciona una obra amb un agent que és responsable de la creació d’una obra cartogràfica."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za vytvoření kartografického díla."],"da":["Relaterer et værk til en agent, som er ansvarlig for et kartografisk værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines kartografischen Werks verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines kartografischen Werks verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός χάρτη, ενός άτλαντα, μιας υδρόγειας σφαίρας ή άλλου χαρτογραφικού έργου."],"en":["Relates a work to an agent who is responsible for creating a cartographic work."],"es":["Relaciona una obra con un agente que es responsable de crear una obra cartográfica."],"et":["Seostab teose tegijaga, kes vastutab kartograafilise teose loomise eest."],"fi":["Liittää teoksen toimijaan, joka on vastuussa kartografisen teoksen luomisesta."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre cartographique."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy kartográfiai mű létrehozásáért."],"it":["Correla un'opera a un agente responsabile di un'opera cartografica."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par karti, atlantu, globusu vai citu kartogrāfijas materiālu."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een cartografisch werk."],"no":["Relateter et verk til en agent som er ansvarlig for et kartografisk verk."],"tr":["Bir eseri, kartografik bir eser oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập bản đồ, tập bản đồ, quả địa cầu, hoặc tác phẩm bản đồ khác."],"zh-Hans-CN":["将一种作品与负责创建一种地图作品的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل رسام خرائط لعمل","ca":"agent cartògraf d’una obra","cs":"kartograf díla (agent)","da":"agent, som er kartograf for værk","de":"Kartografin/Kartograf eines Werks (Akteur)","de":"Kartografin/Kartograf eines Werks (Akteur)","el":"χαρτογράφος","en":"cartographer agent of work","es":"agente cartógrafo de obra","et":"teose kartograaf (tegija)