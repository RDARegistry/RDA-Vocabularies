                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerPersonOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"},{"@id":"http://rdaregistry.info/Elements/w/P10057", "lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerAgentOfWork.en", "label":"has interviewer agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10446", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/interviewerPersonOfWork.en", "label":"has interviewer person of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10446", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/interviewerPersonOfWork.en", "label":"has interviewer person of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10054","label":{"ar":"له وكيل مخترع","ca":"té com a agent inventor","cs":"má vynálezce (agenta)","da":"har agent, som er opfinder","de":"hat Erfinderin/Erfinder (Akteur)","de":"hat Erfinderin/Erfinder (Akteur)","el":"έχει εφευρέτη","en":"has inventor agent","es":"tiene agente inventor","et":"leiutaja (tegija)","fi":"keksijä (toimija)","fr":"a pour agent inventeur","hu":"feltaláló ágense a következő:","it":"ha come inventore agente","lv":"izgudrotājs (aģents)","nl":"heeft uitvinder-actor","no":"har oppfinner (agent)","tr":"mucit temsilci ile ilişkilidir","vi":"có người phát minh","zh-Hans-CN":"有发明者行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن إنشاء جهاز أو عملية جديدة."],"ca":["Relaciona una obra amb un agent que és responsable de la creació d’un mecanisme o un procés nou."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za vytvoření nového zařízení nebo procesu."],"da":["Relaterer et værk til en agent, som er ansvarlig for at skabe en ny anordning eller proces."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία μιας νέας συσκευής ή διαδικασίας."],"en":["Relates a work to an agent who is responsible for creating a new device or process."],"es":["Relaciona una obra con un agente que es responsable de crear un nuevo dispositivo o proceso."],"et":["Seostab teose tegijaga, kes vastutab uue seadme või protsessi loomise eest."],"fi":["Liittää teoksen toimijaan, joka on vastuussa uuden välineen tai menetelmän luomisesta."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la création d’un nouveau dispositif ou procédé."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy új eszköz vagy eljárás létrehozásáért."],"it":["Correla un'opera a un agente responsabile della creazione di un nuovo dispositivo o procedimento."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par jaunas ierīces vai procesa radīšanu."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een nieuw apparaat of proces."],"no":["Relaterer et verk til en agent som er ansvarlig for å skape en ny innretning eller prosess."],"tr":["Bir eseri, yeni bir cihaz veya işlem oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập sáng chế hoặc quy trình mới."],"zh-Hans-CN":["将一种作品与负责创建一种新装置或新过程的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مخترع","ca":"agent inventor","cs":"vynálezce (agent)","da":"agent, som er opfinder","de":"Erfinderin/Erfinder (Akteur)","de":"Erfinderin/Erfinder (Akteur)","el":"εφευρέτης","en":"inventor agent","es":"agente inventor","et":"leiutaja (tegija)","fi":"keksijä (toimija)","fr":"agent inventeur","hu":"feltaláló ágens:","it":"inventore agente","lv":"izgudrotājs (aģents)","nl":"uitvinder-actor","no":"oppfinner (agent)","tr":"mucit temsilcisi ile ilişkilidir","vi":"người phát minh","zh-Hans-CN":"发明者行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن إنشاء جهاز أو عملية جديدة.","ca":"Agent que és responsable de la creació d’un mecanisme o un procés nou.","cs":"Agent, který je odpovědný za vytvoření nového zařízení nebo procesu.","da":"Agent, som er ansvarlig for at skabe en ny anordning eller proces.","de":"Ein Akteur, der für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.","de":"Ein Akteur, der für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τη δημιουργία μιας νέας συσκευής ή διαδικασίας.","en":"An agent who is responsible for creating a new device or process.","es":"Un agente que es responsable de crear un nuevo dispositivo o proceso.","et":"Tegija, kes vastutab uue seadme või protsessi loomise eest.","fi":"Toimija, joka on vastuussa uuden välineen tai menetelmän luomisesta.","fr":"Agent qui est responsable de la création d’un nouveau dispositif ou procédé.","hu":"Egy ágens, amely felelős egy új eszköz vagy eljárás létrehozásáért.","it":"Agente responsabile della creazione di un nuovo dispositivo o procedimento.","lv":"Aģents, kas ir atbildīgs par jaunas ierīces vai procesa radīšanu.","nl":"Een actor die verantwoordelijk is voor het creëren van een nieuw apparaat of proces.","no":"En agent som er ansvarlig for å skape en ny innretning eller prosess.","tr":"Yeni bir cihaz veya işlem oluşturulmasından sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm tạo lập sáng chế hoặc quy trình mới.","zh-Hans-CN":"负责创建一种新装置或新过程的一个行为者"},"altLabel":{"ar":["مخترع"],"ca":["inventor"],"cs":["vynálezce"],"da":["opfinder"],"de":["Erfinderin/Erfinder,Erfinderin/Erfinder"],"en":["inventor"],"es":["inventor"],"et":["leiutaja"],"fi":["keksijä"],"fr":["inventeur"],"hu":["feltaláló:"],"it":["inventore"],"nl":["uitvinder"],"no":["oppfinner"],"tr":["mucit temsilcisi ile ilişkilidir"],"zh-Hans-CN":["发明者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
