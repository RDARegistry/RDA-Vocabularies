                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/criminalDefendantPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10286", "lexicalAlias":"http://rdaregistry.info/Elements/w/defendantPerson.en", "label":"has defendant person"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10396", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/criminalDefendantPerson.en", "label":"has criminal defendant person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10396", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/criminalDefendantPerson.en", "label":"has criminal defendant person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10359","label":{"ar":"هو نقد لكيان \"وام\"","ca":"és crítica d’una entitat RDA","cs":"je kritikou entity RDA","da":"er kritik af RDA-entitet","de":"ist Kritik von (RDA-Entität)","de":"ist Kritik von (RDA-Entität)","en":"is critique of RDA entity","es":"es crítica a la entidad RDA","et":"arvustatud RDA olem","fi":"kritiikki RDA-entiteetistä","fr":"est une critique d’une entité RDA","hu":"bírálata a következő RDA-entitásnak:","it":"è critica di entità RDA","lv":"ir kritika RDA entītei","nl":"is kritiek van RDA-entiteit","no":"er kritikk av RDA-entitet","tr":"RDA varlığının eleştirisidir","zh-Hans-CN":"是RDA实体的批评"},"definition":{"ar":["يربط بين عمل وكيان \"وام\" مستخدم كأساس لتقييم نقدي."],"ca":["Relaciona una obra amb una entitat RDA que és avaluada críticament per una obra."],"cs":["Vztahuje dílo k entitě RDA, která je kriticky hodnocena v díle."],"da":["Relaterer et værk til en RDA-entitet, som anvendes som grundlag for en kritisk evaluering."],"de":["Setzt ein Werk in Beziehung zu einer RDA-Entität, die als Grundlage für eine kritische Untersuchung verwendet wird.,Setzt ein Werk in Beziehung zu einer RDA-Entität, die von einem Werk beschrieben wird."],"en":["Relates a work to an RDA entity that is critically evaluated by a work."],"es":["Relaciona una obra con una entidad RDA que es evaluada críticamente por una obra."],"et":["Seostab teose RDA olemiga, mis on aluseks kriitilisele hinnangule."],"fi":["Liittää teoksen RDA-entiteettiin, johon kriittinen arviointi perustuu."],"fr":["Met une œuvre en relation avec une entité RDA qui fait l’objet d’une évaluation critique par une œuvre."],"hu":["Hozzákapcsol egy művet egy RDA-entitáshoz, amelyet egy kritikai kiértékelés alapjaként használnak."],"it":["Correla un’opera a un’entità RDA utilizzata come base per una valutazione critica."],"lv":["Sasaista darbu ar RDA entīti, kura tikusi kritiski novērtēta."],"nl":["Relateert een werk aan een RDA-entiteit die kritisch geëvalueerd wordt door een werk."],"no":["Relaterer et verk til en RDA-entitet brukt som utgangspunkt for en kritisk evaluering."],"tr":["Bir eseri, bir eser tarafından eleştirel olarak değerlendirilen bir RDA varlığıyla ilişkilendirir."],"zh-Hans-CN":["将一种作品与被一种作品批评性评价的一个RDA实体关联起来。"]},"ToolkitLabel":{"ar":"نقد لكيان \"وام\"","ca":"crítica d’una entitat RDA","cs":"kritika entity RDA","da":"kritik af RDA-entitet","de":"Kritik von (RDA-Entität)","de":"Kritik von (RDA-Entität)","en":"critique of RDA entity","es":"crítica a la entidad RDA","et":"arvustatud RDA olem","fi":"kritiikki RDA-entiteetistä","fr":"critique d’une entité RDA","hu":"bírált RDA-entitás","it":"critica di entità RDA","lv":"kritika RDA entītei","nl":"kritiek van RDA-entiteit","no":"kritikk av RDA-entitet","tr":"RDA varlığının eleştirisi","zh-Hans-CN":"RDA实体的批评"},"ToolkitDefinition":{"ar":"كيان \"وام\" مستخدم كأساس لتقييم نقدي.","ca":"Entitat RDA que és avaluada críticament per una obra.","cs":"Entita RDA, která je kriticky hodnocena v díle.","da":"RDA-entitet, som anvendes som grundlag for en kritisk evaluering.","de":"Eine RDA-Entität, die als Grundlage für eine kritische Untersuchung verwendet wird.","de":"Eine RDA-Entität, die von einem Werk beschrieben wird.","en":"An RDA entity that is critically evaluated by a work.","es":"Una entidad RDA que es evaluada críticamente por una obra.","et":"RDA olem, mis on aluseks kriitilisele hinnangule.","fi":"RDA-entiteetti, johon kriittinen arviointi perustuu.","fr":"Entité RDA qui fait l’objet d’une évaluation critique par une œuvre.","hu":"Egy RDA-entitás, amelyet egy kritikai kiértékelés alapjaként használnak.","it":"Entità RDA utilizzata come base per una valutazione critica.","lv":"RDA entīte, kura tikusi kritiski novērtēta.","nl":"Een RDA-entiteit die kritisch geëvalueerd wordt door een werk.","no":"En RDA-entitet brukt som utgangspunkt for en kritisk evaluering.","tr":"Bir çalışma tarafından eleştirel olarak değerlendirilen bir RDA varlığı.","zh-Hans-CN":"被一种作品批评性评价的一个RDA实体"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
