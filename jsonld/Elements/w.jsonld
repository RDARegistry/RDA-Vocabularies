                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/evaluationOfRDAEntity.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10324", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectRDAEntity.en", "label":"has subject RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10359", "lexicalAlias":"http://rdaregistry.info/Elements/w/critiqueOfRDAEntity.en", "label":"is critique of RDA entity"},{"@id":"http://rdaregistry.info/Elements/w/P10362", "lexicalAlias":"http://rdaregistry.info/Elements/w/reviewOfRDAEntity.en", "label":"is review of RDA entity"},{"@id":"http://rdaregistry.info/Elements/w/object/P10361", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/evaluationOfRDAEntity.en", "label":"is evaluation of RDA entity"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10361", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/evaluationOfRDAEntity.en", "label":"is evaluation of RDA entity"}]},{"@id":"http://rdaregistry.info/Elements/w/P10365","label":{"ar":"له خطة توسع","ca":"té com a pla d’extensió","cs":"má plán rozšíření","da":"har udvidelsesplan","de":"hat Erweiterungsplan","de":"hat Erweiterungsplan","en":"has extension plan","es":"tiene plan de extensión","et":"jätkamiskava","fi":"laajennussuunnitelma","fr":"a pour plan d’extension","hu":"közzétételi terve a következő:","it":"ha come piano di ampliamento","lv":"paplašināšanas plāns","nl":"heeft extensieplan","no":"har utvidelsesplan","tr":"genişletme planı ile ilişkilidir","zh-Hans-CN":"有扩充计划"},"definition":{"ar":["يربط بين عمل وتصنيف يعكس توجها نحو توسيع محتوى عمل."],"ca":["Relaciona una obra amb una categorització que reflecteix una intenció d’ampliar el contingut d’una obra."],"cs":["Vztahuje dílo ke kategorizaci, která odráží plán rozšíření obsahu díla."],"da":["Relaterer et værk til en kategorisering, som afspejler en intention om udvidelse af et værks indhold."],"de":["Setzt ein Werk in Beziehung zu einer Kategorisierung, die die Absicht widerspiegelt, den Inhalt eines Werks zu erweitern.,Setzt ein Werk in Beziehung zu einer Kategorisierung, die die Absicht widerspiegelt, den Inhalt eines Werks zu erweitern."],"en":["Relates a work to a categorization that reflects an intention to extend the content of a work."],"es":["Relaciona una obra con una categorización que refleja una intención de ampliar el contenido de una obra."],"et":["Seostab teose kategooriaga, mis väljendab kavatsust laiendada teose sisu."],"fi":["Liittää teoksen luokitukseen, joka kuvastaa aikomusta laajentaa teoksen sisältöä."],"fr":["Met une œuvre en relation avec une catégorisation qui indique une intention d’élargir le contenu d’une œuvre."],"hu":["Hozzákapcsol egy művet egy kategorizáláshoz, amely tükröz egy mű tartalmának közzétételére vonatkozó szándékot."],"it":["Correla un’opera a una categorizzazione che riflette una intenzione di estendere il contenuto di un’opera."],"lv":["Sasaista darbu ar apzīmējumu, kas atspoguļo nodomu paplašināt darba saturu."],"nl":["Relateert een werk aan een categorisatie die een intentie weergeeft om de content van een werk voort te zetten."],"no":["Relaterer et verk til en kategorisering som viser en intensjon om utvidelse av innholdet av et verk."],"tr":["Bir eseri, bir eserin içeriğini genişletme amacını yansıtan bir sınıflandırmayla ilişkilendirir."],"zh-Hans-CN":["将一种作品与反映扩充一种作品之内容的意向的一种类别关联起来。"]},"ToolkitLabel":{"ar":"خطة توسع","ca":"pla d’extensió","cs":"plán rozšíření","da":"udvidelsesplan","de":"Erweiterungsplan","de":"Erweiterungsplan","en":"extension plan","es":"plan de extensión","et":"jätkamiskava","fi":"laajennussuunnitelma","fr":"plan d’extension","hu":"közzétételi terve:","it":"piano di ampliamento","lv":"paplašināšanas plāns","nl":"extensieplan","no":"utvidelsesplan","tr":"genişletme planı","zh-Hans-CN":"扩充计划"},"ToolkitDefinition":{"ar":"تصنيف يعكس توجها نحو توسيع محتوى عمل.","ca":"Categorització que reflecteix una intenció d’ampliar el contingut d’una obra.","cs":"Kategorizace, která odráží plán rozšíření obsahu díla.","da":"Kategorisering, som afspejler en intention om udvidelse af et værks indhold.","de":"Eine Kategorisierung, die die Absicht widerspiegelt, den Inhalt eines Werks zu erweitern.","de":"Eine Kategorisierung, die die Absicht widerspiegelt, den Inhalt eines Werks zu erweitern.","en":"A categorization that reflects an intention to extend the content of a work.","es":"Una categorización que refleja una intención de ampliar el contenido de una obra.","et":"Kategooria, mis väljendab kavatsust laiendada teose sisu.","fi":"Luokitus, joka kuvastaa aikomusta laajentaa teoksen sisältöä.","fr":"Catégorisation qui indique une intention d’élargir le contenu d’une œuvre.","hu":"Egy kategorizálás, amely tükröz egy mű tartalmának közzétételére vonatkozó szándékot.","it":"Categorizzazione che riflette una intenzione di estendere il contenuto di un’opera.","lv":"Apzīmējums, kas atspoguļo nodomu paplašināt darba saturu.","nl":"Een categorisatie die een intentie weergeeft om de content van een werk voort te zetten.","no":"En kategorisering som viser en intensjon om utvidelse av innholdet av et verk.","tr":"Bir eserin içeriğini genişletme niyetini yansıtan bir sınıflandırma.","zh-Hans-CN":"反映扩充一种作品之内容的意向的一种类别"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
