                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/radioProducerPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10454", "lexicalAlias":"http://rdaregistry.info/Elements/w/producerPerson.en", "label":"has producer person"},{"@id":"http://rdaregistry.info/Elements/w/P10074", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioProducerAgent.en", "label":"has radio producer agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10423", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/radioProducerPerson.en", "label":"has radio producer person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10423", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/radioProducerPerson.en", "label":"has radio producer person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10098","label":{"ar":"هو معالج كعمل نص إذاعي","ca":"és adaptat com a obra de guió radiofònic","cs":"je adaptováno jako rozhlasový scénář (dílo)","da":"er bearbejdet til radiomanuskriptværk","de":"ist bearbeitet als Hörfunkskript (Werk)","de":"ist bearbeitet als Hörfunkskript (Werk)","el":"είναι προσαρμοσμένο ως ραδιοφωνικό σενάριο (έργο)","en":"is adapted as radio script work","es":"es adaptada como obra de guion de radio","et":"adapteeritud raadiostsenaariumina (teos)","fi":"sovitettu radiokäsikirjoitukseksi (teos)","fr":"est adapté en script radiophonique (œuvre)","hu":"rádiósszövegkönyv-feldolgozása a következő:","it":"è adattata come opera in forma di sceneggiatura radiofonica","lv":"ir adaptēts kā radio raidījuma scenārijs (darbs)","nl":"is bewerkt als radioscriptwerk","no":"er bearbeidet som manus for radio (verk)","tr":"radyo metni eseri olarak uyarlanmıştır","vi":"được phỏng theo như là kịch bản truyền thanh (tác phẩm)","zh-Hans-CN":"被改编为广播文稿作品"},"definition":{"ar":["يربط عمل بعمل يتكون من نص لبرنامج إذاعي، مبني على عمل آخر ."],"ca":["Relaciona una obra amb una obra que consisteix en un guió d’un programa radiofònic basat en una altra obra."],"cs":["Vztahuje dílo k dílu, které sestává ze scénáře k rozhlasovému programu, založeného na jiném díle."],"da":["Relaterer et værk til et værk, som består af et manuskript til et radioprogram, baseret på et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einem Skript für eine Hörfunksendung besteht, das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Werk, das aus einem Skript für eine Hörfunksendung besteht, das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα έργο που συνίσταται από ένα σενάριο για ένα ραδιοφωνικό πρόγραμμα βασισμένο σε ένα έργο-πηγή."],"en":["Relates a work to a work that consists of a script for a radio program, based on another work."],"es":["Relaciona una obra con una obra que consiste en un guion para un programa de radio basado en otra obra."],"et":["Seostab teose teosega, mis on allikteosel põhinev stsenaarium raadiosaate jaoks."],"fi":["Liittää teoksen teokseen, joka koostuu toiseen teokseen perustuvasta radio-ohjelman käsikirjoituksesta."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un script d’émission de radio basé sur une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik művön alapuló rádióműsor forgatókönyvéből áll."],"it":["Correla un’opera a un’opera che consiste di una sceneggiatura per un programma radiofonico, basata su un’opera di partenza."],"lv":["Sasaista darbu ar darbu - radio raidījuma scenārijs, kas veidots pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat bestaat uit een script voor een radioprogramma, gebaseerd op een ander werk."],"no":["Relaterer et verk til et verk som består av et manuskript for et radioprogram, basert på et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan bir radyo metninden oluşan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa kịch bản của chương trình truyền thanh, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与由基于另一种作品的一种广播节目的文稿组成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل نص إذاعي","ca":"adaptat com a obra de guió radiofònic","cs":"adaptováno jako rozhlasový scénář (dílo)","da":"bearbejdet til radiomanuskriptværk","de":"Bearbeitet als Hörfunkskript (Werk)","de":"Bearbeitet als Hörfunkskript (Werk)","el":"προσαρμοσμένο ως ραδιοφωνικό σενάριο (έργο)","en":"adapted as radio script work","es":"adaptada como obra de guion de radio","et":"adapteeritud raadiostsenaariumina (teos)","fi":"sovitettu radiokäsikirjoitukseksi (teos)","fr":"adapté en script radiophonique (œuvre)","hu":"rádiósszövegkönyv-feldolgozása a következő:","it":"adattata come opera in forma di sceneggiatura radiofonica","lv":"adaptēts kā darbs: radio raidījuma scenārijs","nl":"bewerkt als radioscriptwerk","no":"bearbeidet som manus for radio (verk)","tr":"Radyo metni çalışması olarak uyarlanan","vi":"được phỏng theo như là kịch bản truyền thanh (tác phẩm)","zh-Hans-CN":"被改编为广播文稿作品"},"ToolkitDefinition":{"ar":"عمل يتكون من نص لبرنامج إذاعي، مبني على عمل آخر .","ca":"Obra que consisteix en un guió d’un programa radiofònic basat en una altra obra.","cs":"Dílo, které sestává ze scénáře k rozhlasovému programu, založeného na jiném díle.","da":"Værk, som består af et manuskript til et radioprogram, baseret på et oprindeligt værk.","de":"Ein Werk, das aus einem Skript für eine Hörfunksendung besteht, das auf einem anderen Werk basiert.","de":"Ein Werk, das aus einem Skript für eine Hörfunksendung besteht, das auf einem anderen Werk basiert.","el":"Ένα έργο που συνίσταται από ένα σενάριο για ένα ραδιοφωνικό πρόγραμμα βασισμένο σε ένα έργο-πηγή.","en":"A work that consists of a script for a radio program, based on another work.","es":"Una obra que consiste en un guion para un programa de radio basado en otra obra.","et":"Teos, mis on allikteosel põhinev stsenaarium raadiosaate jaoks.","fi":"Teos, joka koostuu toiseen teokseen perustuvasta radio-ohjelman käsikirjoituksesta.","fr":"Œuvre qui consiste en un script d’émission de radio basé sur une autre œuvre.","hu":"Egy mű, amely egy másik művön alapuló rádióműsor forgatókönyvéből áll.","it":"Opera che consiste di una sceneggiatura per un programma radiofonico, basata su un’opera di partenza.","lv":"Darbs - radio raidījuma scenārijs, kas veidots pēc pamatdarba.","nl":"Een werk dat bestaat uit een script voor een radioprogramma, gebaseerd op een ander werk.","no":"Et verk som består av et manuskript for et radioprogram, basert på et kildeverk.","tr":"Başka bir esere dayalı olarak bir radyo programı için yazılmış bir senaryodan oluşan eser.","vi":"Tác phẩm có chứa kịch bản của chương trình truyền thanh, dựa trên tác phẩm nguồn.","zh-Hans-CN":"由基于另一种作品的一种广播节目的文稿组成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
