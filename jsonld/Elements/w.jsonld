                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/inventorAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10490", "lexicalAlias":"http://rdaregistry.info/Elements/w/inventorCollectiveAgent.en", "label":"has inventor collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10443", "lexicalAlias":"http://rdaregistry.info/Elements/w/inventorPerson.en", "label":"has inventor person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10054", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/inventorAgent.en", "label":"has inventor agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10054", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/inventorAgent.en", "label":"has inventor agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10490","label":{"ar":"له وكيل جماعي مخترع","ca":"té com a agent col·lectiu inventor","cs":"má vynálezce (kolektivního agenta)","da":"har kollektiv agent, som er opfinder","de":"hat Erfinderin/Erfinder (Gemeinschaftlicher Akteur)","de":"hat Erfinderin/Erfinder (Gemeinschaftlicher Akteur)","en":"has inventor collective agent","es":"tiene agente colectivo inventor","et":"leiutaja (kollektiiv)","fi":"keksijä (yhteistoimija)","fr":"a pour agent collectif inventeur","hu":"feltaláló kollektív ágense a következő:","it":"ha come inventore agente collettivo","lv":"izgudrotājs (grupa)","nl":"heeft uitvinder-collectieve actor","no":"har oppfinner (kollektiv agent)","tr":"mucit kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有发明者集体行为者"},"definition":{"ar":["يربط بين عمل ووكي