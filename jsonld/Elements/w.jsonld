                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/degreeCommitteeMember.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10437", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorPersonOfWork.en", "label":"has creator person of work"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10284", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/degreeCommitteeMember.en", "label":"has degree committee member"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10284", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/degreeCommitteeMember.en", "label":"has degree committee member"}]},{"@id":"http://rdaregistry.info/Elements/w/P10215","label":{"ar":"له سنة منح درجة أكاديمية","ca":"té com a any d’obtenció d’un títol acadèmic","cs":"má rok udělení titulu","da":"har årstal for tildeling af grad","de":"hat Jahr, in dem ein akademischer Grad verliehen wird","de":"hat Jahr, in dem ein akademischer Grad verliehen wird","el":"έχει έτος χορήγησης πτυχίου","en":"has year degree granted","es":"tiene un año de título otorgado","et":"kraadi kinnitamise aasta","fi":"oppiarvon myöntämisvuosi","fr":"a pour année d’obtention de grade universitaire","hu":"fokozatszerzési éve a következő:","it":"ha come anno di assegnazione del titolo accademico","lv":"grāda piešķiršanas gads","nl":"heeft jaar graad toegekend","no":"har årstall for tildeling av grad","sv":"har år när examen avlades","tr":"akademik derecenin verildiği yıl ile ilişkilidir","vi":"có năm văn bằng được cấp","zh-Hans-CN":"有学位授予年份"},"definition":{"ar":["يربط بين عمل وفترة زمنية تمنح خلالها مؤسسة مانحة أو هيئة تدريس درجة أكاديمية."],"ca":["Relaciona una obra amb un interval de temps durant el qual una institució o una facultat concedeix un títol acadèmic."],"cs":["Vztahuje dílo k časovému vymezení, během něhož je příslušnou institucí nebo fakultou udělen akademický titul."],"da":["Relaterer et værk til en tidsperiode, hvor en akademisk grad tildeles af en tildelende institution eller fakultet."],"de":["Setzt ein Werk in Beziehung zu einem Zeitraum, in dem ein akademischer Grad, der mit einer Hochschulschrift in Verbindung steht, von einer Institution oder Fakultät verliehen wird.,Setzt ein Werk in Beziehung zu einem Zeitraum, in dem ein akademischer Grad, der mit einer Hochschulschrift in Verbindung steht, von einer Institution oder Fakultät verliehen wird."],"el":["Συνδέει ένα έργο με ένα ημερολογιακό έτος κατά το οποίο ένα ίδρυμα χορήγησης ή διδακτικό προσωπικό απονέμει ένα ανώτερου εκπαιδευτικού επιπέδου πτυχίο σε έναν υποψήφιο."],"en":["Relates a work to a timespan during which an academic degree is conferred by a granting institution or faculty."],"es":["Relaciona una obra con un lapso de tiempo durante el cual un título académico es otorgado por una institución o facultad que lo otorga."],"et":["Seostab teose ajavahemikuga, millal kraadi andev asutus või teaduskond on kinnitanud akadeemilise kraadi."],"fi":["Liittää teoksen ajanjaksoon, jonka aikana laitos tai tiedekunta on myöntänyt akateemisen oppiarvon."],"fr":["Met une œuvre en relation avec un laps de temps pendant lequel un grade universitaire est décerné par une institution ou une faculté conférant un grade universitaire."],"hu":["Hozzákapcsol egy művet egy időtartamhoz, amely során egy adományozó intézmény vagy kar tudományos fokozatot adott egy jelöltnek."],"it":["Correla un’opera a un intervallo di tempo durante il quale un titolo accademico è conferito da una da un’istituzione o facoltà conferente."],"lv":["Sasaista darbu ar laikposmu, kurā zinātnisko/akadēmisko grādu kandidātam piešķir piešķīrēja iestāde vai fakultāte."],"nl":["Relateert een werk aan een tijdspanne gedurende welke een academische graad is toegekend door een verstrekkende instelling of faculteit."],"no":["Relaterer et verk til et tidsrom hvor en tildelende institusjon eller et fakultet tildelte en akademisk grad."],"tr":["Bir eseri, akademik derecenin bir kurum veya fakülte tarafından verildiği bir zaman aralığıyla ilişkilendirir."],"vi":["Liên kết tác phẩm với năm theo lịch mà viện hoặc khoa cấp văn bằng trao văn bằng học thuật cho ứng viên."],"zh-Hans-CN":["将一种作品与一个授予机构或院系在期间授予一个学位的一个时间段关联起来。"]},"ToolkitLabel":{"ar":"سنة منح درجة أكاديمية","ca":"any d’obtenció d’un títol acadèmic","cs":"rok udělení titulu","da":"årstal for tildeling af grad","de":"Jahr, in dem ein akademischer Grad verliehen wird","de":"Jahr, in dem ein akademischer Grad verliehen wird","el":"έτος χορήγησης πτυχίου","en":"year degree granted","es":"año de título otorgado","et":"kraadi kinnitamise aasta","fi":"oppiarvon myöntämisvuosi","fr":"année d’obtention de grade universitaire","hu":"fokozatszerzési éve:","it":"anno di assegnazione del titolo accademico","lv":"grāda piešķiršanas gads","nl":"jaar graad toegekend","no":"årstall for tildeling av grad","sv":"år när examen avlades","tr":"mezuniyet derecesinin verildiği yıl","vi":"năm văn bằng được cấp","zh-Hans-CN":"学位授予年份"},"ToolkitDefinition":{"ar":"فترة زمنية تمنح خلالها مؤسسة مانحة أو هيئة تدريس درجة أكاديمية.","ca":"Interval de temps durant el qual una institució o una facultat concedeix un títol acadèmic.","cs":"Časové vymezení, během něhož je příslušnou institucí nebo fakultou udělen akademický titul.","da":"Tidsperiode, hvor en akademisk grad tildeles af en tildelende institution eller fakultet.","de":"Ein Zeitraum, in dem ein akademischer Grad, der mit einer Hochschulschrift in Verbindung steht, von einer Institution oder Fakultät verliehen wird.","de":"Ein Zeitraum, in dem ein akademischer Grad, der mit einer Hochschulschrift in Verbindung steht, von einer Institution oder Fakultät verliehen wird.","el":"Ένα ημερολογιακό έτος κατά το οποίο ένα ίδρυμα απονομής ή διδακτικό προσωπικό απονέμει ένα ανώτερου εκπαιδευτικού επιπέδου πτυχίο σε έναν υποψήφιο.","en":"A timespan during which an academic degree is conferred by a granting institution or faculty.","es":"Un lapso de tiempo durante el cual un título académico es otorgado por una institución o facultad que lo otorga.","et":"Ajavahemik, millal kraadi andev asutus või teaduskond on kinnitanud akadeemilise kraadi.","fi":"Ajanjakso, jonka aikana laitos tai tiedekunta on myöntänyt akateemisen oppiarvon.","fr":"Laps de temps pendant lequel un grade universitaire est décerné par une institution ou une faculté conférant un grade universitaire.","hu":"Egy időtartam, amely során egy adományozó intézmény vagy kar tudományos fokozatot adott egy jelöltnek.","it":"Intervallo di tempo durante il quale un titolo accademico è conferito da una da un’istituzione o facoltà conferente.","lv":"Laikposms, kurā zinātnisko/akadēmisko grādu kandidātam piešķir piešķīrēja iestāde vai fakultāte.","nl":"Een tijdspanne gedurende welke een academische graad is toegekend door een verstrekkende instelling of faculteit.","no":"Et tidsrom hvor en tildelende institusjon eller et fakultet tildelte en akademisk grad.","tr":"Akademik derecenin bir kurum veya fakülte tarafından verildiği zaman aralığı.","vi":"Năm theo lịch mà viện hoặc khoa cấp văn bằng trao văn bằng học thuật cho ứng viên.","zh-Hans-CN":"一个授予机构或院系在期间授予一个学位的一个时间段"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/yearDegreeGranted.en","instructionNumber":"7.9.4","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10219", "lexicalAlias":"http://rdaregistry.info/Elements/w/dateOfWork.en", "label":"has date of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10215", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/yearDegreeGranted.en", "label":"has year degree granted"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10215", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/yearDegreeGranted.en", "label":"has year degree granted"}]},{"@id":"http://rdaregistry.info/Elements/w/P10066","label":{"ar":"له وكيل مخرج","ca":"té com a agent realitzador","cs":"má režiséra (agenta)","da":"har agent, som er instruktør","de":"hat Regisseurin/Regisseur (Akteur)","de":"hat Regisseurin/Regisseur (Akteur)","el":"έχει σκηνοθέτη","en":"has director agent","es":"tiene agente director","et":"režissöör (tegija)","fi":"ohjaaja (toimija)","fr":"a pour agent réalisateur","hu":"rendező ágense a következő:","it":"ha come regista agente","lv":"režisors (aģents)","nl":"heeft regisseur-actor","no":"har regissør (agent)","tr":"yönetmen temsilcisi ile ilişkilidir","vi":"có đạo diễn","zh-Hans-CN":"有导演行为者"},"definition":{"ar":["يربط بين عمل ووكيل مسئول عن الإدارة العامة والإشراف على أداء فيلمي، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una obra amb un agent que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje dílo k agentovi, který je odpovědný za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer et værk til en agent, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einem Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"el":["Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη γενική διαχείριση και εποπτεία μιας κινηματογραφικής παράστασης, ενός ραδιοφωνικού ή τηλεοπτικού προγράμματος κ.λπ."],"en":["Relates a work to an agent who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona una obra con un agente que es responsable de la gestión y supervisión general de una presentación filmada, un programa de radio o televisión, etc."],"et":["Seostab teose tegijaga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää teoksen toimijaan, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une œuvre en relation avec un agent qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért."],"it":["Correla un'opera a un agente responsabile dell'organizzazione e supervisione generali di una rappresentazione cinematografica, programma radiofonico o televisivo, etc."],"lv":["Sasaista darbu ar aģentu, kas ir atbildīgs par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību."],"nl":["Relateert een werk aan een actor die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc."],"no":["Relaterer et verk til en agent som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc."],"tr":["Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetiminden ve denetiminden sorumlu olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân có trách nhiệm quản lý và giám sát chung về biểu diễm làm phim, chương trình truyền thanh hoặc truyền hình, v.v..."],"zh-Hans-CN":["将一种作品与负责摄制表演、广播或电视节目等的全面管理和监督的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مخرج","ca":"agent realitzador","cs":"režisér (agent)","da":"agent, som er instruktør","de":"Regisseurin/Regisseur (Akteur)","de":"Regisseurin/Regisseur (Akteur)","el":"σκηνοθέτης","en":"director agent","es":"agente director","et":"režissöör (tegija)","fi":"ohjaaja (toimija)","fr":"agent réalisateur","hu":"rendező ágens:","it":"regista agente","lv":"režisors (aģents)","nl":"regisseur-actor","no":"regissør (agent)","tr":"yönetmen temsilcisi","vi":"đạo diễn","zh-Hans-CN":"导演行为者"},"ToolkitDefinition":{"ar":"وكيل مسئول عن الإدارة العامة والإشراف على أداء فيلمي، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Agent que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Agent, který je odpovědný za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Agent, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","el":"Ένας φορέας υπεύθυνος για τη γενική διαχείριση και εποπτεία μιας κινηματογραφικής παράστασης, ενός ραδιοφωνικού ή τηλεοπτικού προγράμματος κ.λπ.","en":"An agent who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Un agente que es responsable de la gestión y supervisión general de una presentación filmada, un programa de radio o televisión, etc.","et":"Tegija, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Toimija, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Agent qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy ágens, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.","it":"Agente responsabile dell'organizzazione e supervisione generali di una rappresentazione cinematografica, programma radiofonico o televisivo, etc.","lv":"Aģents, kas ir atbildīgs par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.","nl":"Een actor die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.","no":"En agent som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetiminden ve denetiminden sorumlu bir temsilci.","vi":"Tác nhân có trách nhiệm quản lý và giám sát chung về biểu diễm làm phim, chương trình truyền thanh hoặc truyền hình, v.v...","zh-Hans-CN":"负责摄制表演、广播或电视节目等的全面管理和监督的一个行为者"},"altLabel":{"ar":["مخرج"],"ca":["realitzador"],"cs":["režisér"],"da":["instruktør"],"de":["Regisseur,Regisseur"],"en":["director"],"es":["director"],"et":["režissöör,lavastaja (tegija)"],"fi":["ohjaaja"],"fr":["réalisateur"],"hu":["rendező:"],"it":["regista"],"nl":["regisseur"],"no":["regissør"],"tr":["yönetmen"],"zh-Hans-CN":["导演"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/directorAgent.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10502", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgent.en", "label":"has director collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10455", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorPerson.en", "label":"has director person"},{"@id":"http://rdaregistry.info/Elements/w/P10013", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmDirectorAgent.en", "label":"has film director agent"},{"@id":"http://rdaregistry.info/Elements/w/P10014", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioDirectorAgent.en", "label":"has radio director agent"},{"@id":"http://rdaregistry.info/Elements/w/P10015", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionDirectorAgent.en", "label":"has television director agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10066", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorAgent.en", "label":"has director agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10066", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorAgent.en", "label":"has director agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10068","label":{"ar":"له وكيل مدير تصوير","ca":"té com a agent director de fotografia","cs":"má hlavního kameramana (agenta)","da":"har agent, som er filmfotograf","de":"hat Kamerafrau/Kameramann (Akteur)","de":"hat Kamerafrau/Kameramann (Akteur)","el":"έχει διευθυντή φωτογραφίας","en":"has director agent of photography","es":"tiene agente director de fotografía","et":"operaator-lavastaja (tegija)","fi":"kuvaaja (toimija)","fr":"a pour agent directeur de la photographie","hu":"operatőr ágense a következő:","it":"ha come direttore della fotografia agente","lv":"kinooperators (aģents)","nl":"heeft cameraregisseur-actor","no":"har filmfotograf (agent)","tr":"görüntü yönetmeni temsilcisi ile ilişkilidir","vi":"có giám đốc hình ảnh","zh-Hans-CN":"有摄影指导行为者"},"definition":{"ar":["يربط بين عمل ووكيل يلتقط الصور، إما إلكترونيا وإما بفيلم أو تسجيلات فيديو، وغالبا ما يختار الإضاءة وينسقها."],"ca":["Relaciona una obra amb un agent que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació."],"cs":["Vztahuje dílo k agentovi, který zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení."],"da":["Relaterer et værk til en agent, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.,Setzt ein Werk in Beziehung zu einem Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert."],"el":["Συνδέει ένα έργο με έναν φορέα ο οποίος συλλαμβάνει τις εικόνες είτε ηλεκτρονικά είτε με φιλμ είτε με βίντεο και συχνά επιλέγει και οργανώνει τον φωτισμό."],"en":["Relates a work to an agent who captures images, either electronically or on film or video stock, and often selects and arranges the lighting."],"es":["Relaciona una obra con un agente que captura imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente elige y organiza la iluminación."],"et":["Seostab teose tegijaga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse."],"fi":["Liittää teoksen toimijaan, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen."],"fr":["Met une œuvre en relation avec un agent qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást."],"it":["Correla un'opera a un agente che cattura le immagini, sia elettronicamente che su pellicola o video, e spesso seleziona e sistema le luci."],"lv":["Sasaista darbu ar aģentu, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu."],"nl":["Relateert een werk aan een actor die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert."],"no":["Relaterer et verk til en agent som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting."],"tr":["Bir eseri, elektronik ortamda veya film ya da video stoğunda görüntü kaydeden ve genellikle ışıklandırmayı seçen ve düzenleyen bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân thu nạp hình ảnh, hoặc là bằng điện tử hoặc trên phim hoặc video, và thường lựa chọn, và bố trí chiếu sáng."],"zh-Hans-CN":["将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个行为者关联起来。"]},"note":{"ar":["مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"el":["Ένας διευθυντής φωτογραφίας σε μια ταινία ονομάζεται επίσης επικεφαλής κινηματογραφιστής."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Un director de fotografía para una película también es llamado un primer cinematógrafo."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"vi":["Giám đố hình ảnh của phim điện ảnh cũng được gọi là nhà điện ảnh chính."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"ToolkitLabel":{"ar":"وكيل مدير تصوير","ca":"agent director de fotografia","cs":"hlavní kameraman (agent)","da":"agent, som er filmfotograf","de":"Kamerafrau/Kameramann (Akteur)","de":"Kamerafrau/Kameramann (Akteur)","el":"διευθυντής φωτογραφίας","en":"director agent of photography","es":"agente director de fotografía","et":"operaator-lavastaja (tegija)","fi":"kuvaaja (toimija)","fr":"agent directeur de la photographie","hu":"operatőr ágens:","it":"agente direttore della fotografia","lv":"kinooperators (aģents)","nl":"cameraregisseur-actor","no":"filmfotograf (agent)","tr":"görüntü yönetmeni temsilcisi","vi":"giám đốc hình ảnh","zh-Hans-CN":"摄影指导行为者"},"ToolkitDefinition":{"ar":"وكيل يلتقط صور، إما إلكترونيا وإما بفيلم أو تسجيلات فيديو، وغالبا ما يختار الإضاءة وينسقها.","ca":"Agent que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.","cs":"Agent, který zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení.","da":"Agent, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.","de":"Ein Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","de":"Ein Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","el":"Ένας φορέας ο οποίος συλλαμβάνει τις εικόνες είτε ηλεκτρονικά είτε με φιλμ είτε με βίντεο και συχνά επιλέγει και οργανώνει τον φωτισμό.","en":"An agent who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.","es":"Un agente que captura imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente elige y organiza la iluminación.","et":"Tegija, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.","fi":"Toimija, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.","fr":"Agent qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy ágens, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.","it":"Agente che cattura le immagini, sia elettronicamente che su pellicola o video, e spesso seleziona e sistema le luci.","lv":"Aģents, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.","nl":"Een actor die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.","no":"En agent som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.","tr":"Elektronik olarak veya film ya da video stoğunda görüntü çeken ve genellikle ışıklandırmayı seçen ve düzenleyen temsilci.","vi":"Tác nhân thu nạp hình ảnh, hoặc là bằng điện tử hoặc trên phim hoặc video, và thường lựa chọn, và bố trí chiếu sáng.","zh-Hans-CN":"通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个行为者"},"altLabel":{"ar":["مدير تصوير"],"ca":["director de fotografia"],"cs":["hlavní kameraman"],"da":["filmfotograf"],"de":["Kameramann,Kameramann"],"en":["director of photography"],"es":["director de fotografía"],"et":["operaator-lavastaja"],"fi":["kuvaaja"],"fr":["directeur de la photographie"],"hu":["operatőr:"],"it":["direttore della forografia"],"nl":["cameraregisseur"],"no":["filmfotograf"],"tr":["görüntü yönetmeni"],"zh-Hans-CN":["摄影指导"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/directorAgentOfPhotography.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10462", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgentOfPhotography.en", "label":"has director collective agent of photography"},{"@id":"http://rdaregistry.info/Elements/w/P10415", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorPersonOfPhotography.en", "label":"has director person of photography"},{"@id":"http://rdaregistry.info/Elements/w/object/P10068", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorAgentOfPhotography.en", "label":"has director agent of photography"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10068", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorAgentOfPhotography.en", "label":"has director agent of photography"}]},{"@id":"http://rdaregistry.info/Elements/w/P10502","label":{"ar":"له وكيل جماعي مخرج","ca":"té com a agent col·lectiu realitzador","cs":"má režiséra (kolektivního agenta)","da":"har kollektiv agent, som er instruktør","de":"hat Regisseurin/Regisseur (Gemeinschaftlicher Akteur)","de":"hat Regisseurin/Regisseur (Gemeinschaftlicher Akteur)","en":"has director collective agent","es":"tiene agente colectivo director","et":"režissöör (kollektiiv)","fi":"ohjaaja (yhteistoimija)","fr":"a pour agent collectif réalisateur","hu":"rendező kollektív ágense a következő:","it":"ha come regista agente collettivo","lv":"režisors (grupa)","nl":"heeft regisseur-collectieve actor","no":"har regissør (kollektiv agent)","tr":"yönetmen kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有导演集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي مسئول عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una obra amb un agent col·lectiu que és responsable de la gestió general i la supervisió d’una actuació filmada, un programa radiofònic o de televisió, etc."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je odpovědný za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer et værk til en kollektiv agent, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a work to a collective agent who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona una obra con un agente colectivo que se encarga de la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc."],"et":["Seostab teose kollektiiviga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää teoksen yhteistoimijaan, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une œuvre en relation avec un agent collectif qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért."],"it":["Correla un'opera all'agente collettivo responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc."],"lv":["Sasaista darbu ar grupu, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību."],"nl":["Relateert een werk aan een corporatie die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc."],"no":["Relaterer et verk til en kollektiv agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc."],"tr":["Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责摄制表演、广播或电视节目等的全面管理和监督的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مخرج","ca":"agent col·lectiu realitzador","cs":"režisér (kolektivní agent)","da":"kollektiv agent, som er instruktør","de":"Regisseurin/Regisseur (Gemeinschaftlicher Akteur)","de":"Regisseurin/Regisseur (Gemeinschaftlicher Akteur)","en":"director collective agent","es":"agente colectivo director","et":"režissöör (kollektiiv)","fi":"ohjaaja (yhteistoimija)","fr":"agent collectif réalisateur","hu":"rendező kollektív ágens:","it":"regista agente collettivo","lv":"režisors (grupa)","nl":"regisseur-collectieve actor","no":"regissør (kollektiv agent)","tr":"yönetmen kolektif temsilcisi","zh-Hans-CN":"导演集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي مسئول عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Agent col·lectiu que és responsable de la gestió general i la supervisió d’una actuació filmada, un programa radiofònic o de televisió, etc.","cs":"Kolektivní agent, který je odpovědný za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Kollektiv agent, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Ein gemeinschaftlicher Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Ein gemeinschaftlicher Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A collective agent who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Un agente colectivo que se encarga de la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc.","et":"Kollektiiv, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Yhteistoimija, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Agent collectif qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy kollektív ágens, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.","it":"Agente collettivo responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc.","lv":"Grupa, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.","nl":"Een corporatie die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.","no":"En kollektiv agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu kolektif bir temsilci.","zh-Hans-CN":"负责摄制表演、广播或电视节目等的全面管理和监督的一个集体行为者"},"altLabel":{"et":["lavastaja (kollektiiv)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgent.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10066", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorAgent.en", "label":"has director agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10549", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCorporateBody.en", "label":"has director corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10596", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorFamily.en", "label":"has director family"},{"@id":"http://rdaregistry.info/Elements/w/P10465", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmDirectorCollectiveAgent.en", "label":"has film director collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10466", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioDirectorCollectiveAgent.en", "label":"has radio director collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10467", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionDirectorCollectiveAgent.en", "label":"has television director collective agent"},{"@id":"http://rdaregistry.info/Elements/w/object/P10502", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorCollectiveAgent.en", "label":"has director collective agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10502", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorCollectiveAgent.en", "label":"has director collective agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10462","label":{"ar":"له وكيل جماعي مدير تصوير","ca":"té com a agent col·lectiu director de fotografia","cs":"má hlavního kameramana (kolektivního agenta)","da":"har kollektiv agent, som er filmfotograf","de":"hat Kamerafrau/Kameramann (Gemeinschaftlicher Akteur)","de":"hat Kamerafrau/Kameramann (Gemeinschaftlicher Akteur)","en":"has director collective agent of photography","es":"tiene director agente colectivo de fotografía","et":"operaator-lavastaja (kollektiiv)","fi":"kuvaaja (yhteistoimija)","fr":"a pour agent collectif directeur de la photographie","hu":"operatőr kollektív ágense a következő:","it":"ha come direttore della fotografia agente collettivo","lv":"kinooperators (grupa)","nl":"heeft cameraregisseur-collectieve actor","no":"har filmfotograf (kollektiv agent)","tr":"görüntü yönetmeni kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有摄影指导集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي يلتقط الصور، إما إلكترونيًا، أو على فيلم، أو مقاطع فيديو، وغالبًا ما يختار الإضاءة ويرتبها."],"ca":["Relaciona una obra amb un agent col·lectiu que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení."],"da":["Relaterer et værk til en kollektiv agent, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning."],"de":["Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.,Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a work to a collective agent who captures images, either electronically or on film or video stock, and often selects and arranges the lighting."],"es":["Relaciona una obra con un agente colectivo que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación."],"et":["Seostab teose kollektiiviga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse."],"fi":["Liittää teoksen yhteistoimijaan, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen."],"fr":["Met une œuvre en relation avec un agent collectif qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást."],"it":["Correla un'opera a un agente collettivo che cattura le immagini sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci."],"lv":["Sasaista darbu ar grupu, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu."],"nl":["Relateert een werk aan een collectieve actor die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert."],"no":["Relaterer et verk til en kollektiv agent som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting."],"tr":["Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü kaydeden ve genellikle ışıklandırmayı seçen ve düzenleyen bir kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مدير تصوير","ca":"agent col·lectiu director de fotografia","cs":"hlavní kameraman (kolektivní agent)","da":"kollektiv agent, som er filmfotograf","de":"Kamerafrau/Kameramann (Gemeinschaftlicher Akteur)","de":"Kamerafrau/Kameramann (Gemeinschaftlicher Akteur)","en":"director collective agent of photography","es":"director agente colectivo de fotografía","et":"operaator-lavastaja (kollektiiv)","fi":"kuvaaja (yhteistoimija)","fr":"agent collectif directeur de la photographie","hu":"operatőr kollektív ágens:","it":"direttore della fotografia agente collettivo","lv":"kinooperators (grupa)","nl":"cameraregisseur-collectieve actor","no":"filmfotograf (kollektiv agent)","tr":"görüntü yönetmeni kolektif temsilcisi","zh-Hans-CN":"摄影指导集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يلتقط الصور، إما إلكترونيًا، أو على فيلم، أو مقاطع فيديو، وغالبًا ما يختار الإضاءة ويرتبها.","ca":"Agent col·lectiu que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.","cs":"Kolektivní agent, který zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení.","da":"Kollektiv agent, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.","de":"Ein gemeinschaftlicher Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","de":"Ein gemeinschaftlicher Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","en":"A collective agent who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.","es":"Un agente colectivo que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación.","et":"Kollektiiv, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.","fi":"Yhteistoimija, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.","fr":"Agent collectif qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy kollektív ágens, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.","it":"Agente collettivo che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci.","lv":"Grupa, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.","nl":"Een collectieve actor die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.","no":"En kollektiv agent som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.","tr":"Görüntüleri elektronik olarak veya film veya video stoğunda yakalayan ve genellikle aydınlatmayı seçen ve düzenleyen kolektif bir temsilci.","zh-Hans-CN":"通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个集体行为者"},"note":{"ar":["مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Al director de fotografía de una película también se le llama jefe de fotografía."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia in un film è detto anche capo operatore."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgentOfPhotography.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10068", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorAgentOfPhotography.en", "label":"has director agent of photography"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10509", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCorporateBodyOfPhotography.en", "label":"has director corporate body of photography"},{"@id":"http://rdaregistry.info/Elements/w/P10556", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorFamilyOfPhotography.en", "label":"has director family of photography"},{"@id":"http://rdaregistry.info/Elements/w/object/P10462", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorCollectiveAgentOfPhotography.en", "label":"has director collective agent of photography"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10462", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorCollectiveAgentOfPhotography.en", "label":"has director collective agent of photography"}]},{"@id":"http://rdaregistry.info/Elements/w/P10549","label":{"ar":"له هيئة مخرجة","ca":"té com a entitat corporativa realitzadora","cs":"má režiséra (korporaci)","da":"har korporation, som er instruktør","de":"hat Regisseurin/Regisseur (Körperschaft)","de":"hat Regisseurin/Regisseur (Körperschaft)","en":"has director corporate body","es":"tiene organismo corporativo director","et":"režissöör (asutus)","fi":"ohjaaja (yhteisö)","fr":"a pour collectivité réalisatrice","hu":"rendező testülete a következő:","it":"ha come regista ente","lv":"režisors (institūcija)","nl":"heeft regisseur-corporatie","no":"har regissør (korporasjon)","tr":"yönetmen tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有导演团体"},"definition":{"ar":["يربط بين عمل وهيئة مسئولة عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una obra amb una entitat corporativa que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje dílo ke korporaci, která je odpovědná za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem atd."],"da":["Relaterer et værk til en korporation, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Körperschaft, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a work to a corporate body who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona una obra con un organismo corporativo que es responsable de la gestión y supervisión general de una presentación filmada, un programa de radio o televisión, etc."],"et":["Seostab teose asutusega, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää teoksen yhteisöön, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une œuvre en relation avec une collectivité qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy művet egy testülethez, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért."],"it":["Correla un'opera a un ente responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc."],"lv":["Sasaista darbu ar institūciju, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību."],"nl":["Relateert een werk aan een familie die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc."],"no":["Relaterer et verk til en korporasjon som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc."],"tr":["Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责摄制表演、广播或电视节目等的全面管理和监督的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مخرجة","ca":"entitat corporativa realitzadora","cs":"režisér (korporace)","da":"korporation, som er instruktør","de":"Regisseurin/Regisseur (Körperschaft)","de":"Regisseurin/Regisseur (Körperschaft)","en":"director corporate body","es":"organismo corporativo director","et":"režissöör (asutus)","fi":"ohjaaja (yhteisö)","fr":"collectivité réalisatrice","hu":"rendező testület:","it":"regista ente","lv":"režisors (institūcija)","nl":"regisseur-corporatie","no":"regissør (korporasjon)","tr":"yönetmen tüzel kişisi","zh-Hans-CN":"导演团体"},"ToolkitDefinition":{"ar":"هيئة مسئولة عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Entitat corporativa que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Korporace, která je odpovědná za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem atd.","da":"Korporation, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Eine Körperschaft, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Eine Körperschaft, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A corporate body who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Un organismo corporativo que es responsable de la gestión y supervisión general de una presentación filmada, un programa de radio o televisión, etc.","et":"Asutus, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Yhteisö, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Collectivité qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy testület, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.","it":"Ente responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc.","lv":"Institūcija, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.","nl":"Een familie die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.","no":"En korporasjon som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetim ve denetiminden sorumlu olan tüzel kişi.","zh-Hans-CN":"负责摄制表演、广播或电视节目等的全面管理和监督的一个团体"},"altLabel":{"et":["lavastaja (asutus)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/directorCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10502", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgent.en", "label":"has director collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10512", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmDirectorCorporateBody.en", "label":"has film director corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10513", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioDirectorCorporateBody.en", "label":"has radio director corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10514", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionDirectorCorporateBody.en", "label":"has television director corporate body"},{"@id":"http://rdaregistry.info/Elements/w/object/P10549", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorCorporateBody.en", "label":"has director corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10549", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorCorporateBody.en", "label":"has director corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10509","label":{"ar":"له هيئة مديرة تصوير","ca":"té com a entitat corporativa directora de fotografia","cs":"má hlavního kameramana (korporaci)","da":"har korporation, som er filmfotograf","de":"hat Kamerafrau/Kameramann (Körperschaft)","de":"hat Kamerafrau/Kameramann (Körperschaft)","en":"has director corporate body of photography","es":"tiene cuerpo corporativo director de fotografía","et":"operaator-lavastaja (asutus)","fi":"kuvaaja (yhteisö)","fr":"a pour collectivité directrice de la photographie","hu":"operatőr testülete a következő:","it":"ha come direttore della fotografia ente","lv":"kinooperators (institūcija)","nl":"heeft cameraregisseur-corporatie","no":"har filmfotograf (korporasjon)","tr":"görüntü yönetmeni tüzel kişisi ile ilişkilidir","zh-Hans-CN":"有摄影指导团体"},"definition":{"ar":["يربط بين عمل وهيئة تلتقط الصور، إما إلكترونيًا أو على فيلم أو مقاطع فيديو، وغالبًا ما تختار الإضاءة وترتبها."],"ca":["Relaciona una obra amb una entitat corporativa que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació."],"cs":["Vztahuje dílo ke korporaci, která zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení."],"da":["Relaterer et værk til en korporation, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning."],"de":["Setzt ein Werk in Beziehung zu einer Körperschaft, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.,Setzt ein Werk in Beziehung zu einer Körperschaft, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a work to a corporate body who captures images, either electronically or on film or video stock, and often selects and arranges the lighting."],"es":["Relaciona una obra con un cuerpo corporativo que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación."],"et":["Seostab teose asutusega, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse."],"fi":["Liittää teoksen yhteisöön, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen."],"fr":["Met une œuvre en relation avec une collectivité qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy művet egy testülethez, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást."],"it":["Correla un'opera a un ente che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci."],"lv":["Sasaista darbu ar institūciju, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu."],"nl":["Relateert een werk aan een corporatie die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert."],"no":["Relaterer et verk til en korporasjon som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting."],"tr":["Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü yakalayan ve genellikle ışıklandırmayı seçen ve düzenleyen tüzel kişi ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个团体关联起来。"]},"ToolkitLabel":{"ar":"هيئة مديرة تصوير","ca":"entitat corporativa directora de fotografia","cs":"hlavní kameraman (korporace)","da":"korporation, som er filmfotograf","de":"Kamerafrau/Kameramann (Körperschaft)","de":"Kamerafrau/Kameramann (Körperschaft)","en":"director corporate body of photography","es":"cuerpo corporativo director de fotografía","et":"operaator-lavastaja (asutus)","fi":"kuvaaja (yhteisö)","fr":"collectivité directrice de la photographie","hu":"operatőr testület:","it":"direttore della fotografia ente","lv":"kinooperators (institūcija)","nl":"cameraregisseur-corporatie","no":"filmfotograf (korporasjon)","tr":"görüntü yönetmeni tüzel kişisi","zh-Hans-CN":"摄影指导团体"},"ToolkitDefinition":{"ar":"هيئة تلتقط الصور، إما إلكترونيًا أو على فيلم أو مقاطع فيديو، وغالبًا ما تختار الإضاءة وترتبها.","ca":"Entitat corporativa que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.","cs":"Korporace, která zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení.","da":"Korporation, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.","de":"Eine Körperschaft, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","de":"Eine Körperschaft, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","en":"A corporate body who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.","es":"Un cuerpo corporativo que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación.","et":"Asutus, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.","fi":"Yhteisö, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.","fr":"Collectivité qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy testület, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.","it":"Ente che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci.","lv":"Institūcija, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.","nl":"Een corporatie die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.","no":"En korporasjon som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.","tr":"Görüntüleri elektronik olarak ya da film ya da video stoğunda yakalayan ve genellikle aydınlatmayı seçip düzenleyen bir şirkettir.","zh-Hans-CN":"通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个团体"},"note":{"ar":["مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Al director de fotografía de una película también se le llama jefe de fotografía."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia in un film è detto anche capo operatore."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/directorCorporateBodyOfPhotography.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10462", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgentOfPhotography.en", "label":"has director collective agent of photography"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10509", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorCorporateBodyOfPhotography.en", "label":"has director corporate body of photography"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10509", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorCorporateBodyOfPhotography.en", "label":"has director corporate body of photography"}]},{"@id":"http://rdaregistry.info/Elements/w/P10596","label":{"ar":"له عائلة مخرجة","ca":"té com a família realitzadora","cs":"má režiséra (rodinu)","da":"har familie, som er instruktør","de":"hat Regisseurin/Regisseur (Familie)","de":"hat Regisseurin/Regisseur (Familie)","en":"has director family","es":"tiene familia directora","et":"režissöör (perekond)","fi":"ohjaaja (suku)","fr":"a pour famille réalisatrice","hu":"rendező családja a következő:","it":"ha come regista famiglia","lv":"režisors (dzimta/ģimene)","nl":"heeft regisseur-familie","no":"har regissør (familie)","tr":"yönetmen ailesi ile ilişkilidir","zh-Hans-CN":"有导演家族"},"definition":{"ar":["يربط بين عمل وعائلة مسئولة عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي، أو تليفزيوني، إلخ."],"ca":["Relaciona una obra amb una família que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc."],"cs":["Vztahuje dílo k rodině, která je odpovědná za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod."],"da":["Relaterer et værk til en familie, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Familie, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a work to a family who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona una obra con una familia que es responsable de la gestión y supervisión general de una presentación grabada, un programa de radio o televisión, etc."],"et":["Seostab teose perekonnaga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää teoksen sukuun, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une œuvre en relation avec une famille qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy művet egy családhoz, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért."],"it":["Correla un'opera alla famiglia responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību."],"nl":["Relateert een werk aan een collectieve actor die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc."],"no":["Relaterer et verk til en familie som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc."],"tr":["Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责摄制表演、广播或电视节目等的全面管理和监督的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مخرجة","ca":"família realitzadora","cs":"režisér (rodina)","da":"familie, som er instruktør","de":"Regisseurin/Regisseur (Familie)","de":"Regisseurin/Regisseur (Familie)","en":"director family","es":"familia directora","et":"režissöör (perekond)","fi":"ohjaaja (suku)","fr":"famille réalisatrice","hu":"rendező család:","it":"regista famiglia","lv":"režisors (dzimta/ģimene)","nl":"regisseur-familie","no":"regissør (familie)","tr":"yönetmen ailesi","zh-Hans-CN":"导演家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي، أو تليفزيوني، إلخ.","ca":"Família que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.","cs":"Rodina, která je odpovědná za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem apod.","da":"Familie, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Eine Familie, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Eine Familie, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A family who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una familia que es responsable de la gestión y supervisión general de una presentación grabada, un programa de radio o televisión, etc.","et":"Perekond, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Suku, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Famille qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy család, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.","it":"Famiglia responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc.","lv":"Dzimta/ģimene, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.","nl":"Een collectieve actor die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.","no":"En familie som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.","tr":"Filme alınmış bir gösterinin, bir radyo veya televizyon programının vb. genel yönetim ve denetiminden sorumlu olan bir aile.","zh-Hans-CN":"负责摄制表演、广播或电视节目等的全面管理和监督的一个家族"},"altLabel":{"et":["lavastaja (perekond)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
