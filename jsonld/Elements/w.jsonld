                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/courtGoverned.en","instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10011", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/courtGoverned.en", "label":"has court governed"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10011", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/courtGoverned.en", "label":"has court governed"}]},{"@id":"http://rdaregistry.info/Elements/w/P10366","label":{"ar":"له ردمد","ca":"té com a ISSN","cs":"má ISSN","de":"hat ISSN einer Reihe","de":"hat ISSN einer Reihe","en":"has ISSN","es":"tiene ISSN","et":"ISSN","fi":"ISSN","fr":"a pour ISSN","hu":"ISSN-je a következő:","it":"ha come ISSN","lv":"ISSN","nl":"heeft ISSN","no":"har ISSN","tr":"ISSN ile ilişkilidir","zh-Hans-CN":"有国际标准连续出版物号"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن معرف لعمل خصصته وكالة تسجيل ردمد."],"ca":["Relaciona una obra amb un nomen que és un identificador d’obra que és assignat per una agència de registre de l’ISSN."],"cs":["Vztahuje dílo k nomen, které je identifikátorem díla, přiřazeným registrační agenturou ISSN."],"de":["Setzt ein Werk in Beziehung zu einem Identifikator für ein Werk, der durch eine ISSN-Registrierungsstelle zugewiesen wird.,Setzt ein Werk in Beziehung zu einem Identifikator für ein Werk, der durch eine ISSN-Registrierungsstelle zugewiesen wird."],"en":["Relates a work to a nomen that is an identifier for work that is assigned by an ISSN registration agency."],"es":["Relaciona una obra con un nomen que es un identificador de obra asignado por una agencia de registro de ISSN."],"et":["Seostab teose teose identifikaatoriga, mille on määranud ISSN registreerimise agentuur."],"fi":["Liittää teoksen nomeniin, joka on teoksen tunniste, jonka on antanut ISSN-rekisteröintitoimisto."],"fr":["Met une œuvre en relation avec un nomen qui est un identifiant d’œuvre attribué par une agence d’enregistrement de l’ISSN."],"hu":["Hozzákapcsol egy művet egy műazonosító nomenhez, amelyet egy ISSN regisztrációs ügynökség jegyez."],"it":["Correla un’opera a un identificatore per l’opera che è assegnato da un’agenzia di registrazione ISSN."],"lv":["Sasaista darbu ar nomenu, kas ir identifikators darbam, ko piešķir ISSN reģistrācijas aģentūra."],"nl":["Relateert een werk aan een nomen dat is een identificatie voor werk dat toegekend is door een ISSN-registratiebureau."],"no":["Relaterer et verk til en identifikator for verk som er tildelt av et ISSN-kontor."],"tr":["Bir eseri, bir ISSN kayıt kuruluşu tarafından atanan eser için tanımlayıcı olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种作品与一个国际标准连续出版物号注册机构分配给一种作品的一个作为标识符的命名关联起来。"]},"altLabel":{"ar":["الرقم المعياري الدولي للدوريات"],"ca":[",,"],"cs":[",ISSN subedice,ISSN edice"],"de":["International Standard Serial Number,ISSN der Unterreihe,ISSN der Reihe"],"en":["International Standard Serial Number,ISSN of subseries,ISSN of series"],"es":["Número Internacional Normalizado de Publicaciones Seriadas (International Standard Serial Number),ISSN de subserie,ISSN de serie"],"et":["rahvusvaheline jadaväljaande standardnumber"],"fi":[",,"],"fr":["ISSN de collection,ISSN de sous-collection"],"hu":[",,"],"it":["International Standard Serial Number"],"nl":[",,"],"no":["International Standard Serial Number"],"tr":["Uluslararası Standart Süreli Yayın Numarası,Alt dizilerin ISSN numarası,Dizilerin ISSN numarası"],"zh-Hans-CN":["国际标准连续出版物号,分丛编的国际标准连续出版物号,丛编的国际标准连续出版物号"],"zh-Hant-TW":[",,"]},"ToolkitLabel":{"ar":"ردمد","ca":"ISSN","cs":"ISSN","de":"ISSN einer Reihe","de":"ISSN einer Reihe","en":"ISSN","es":"ISSN","et":"ISSN","fi":"ISSN","fr":"ISSN","hu":"ISSN-je:","it":"ISSN","lv":"ISSN","nl":"ISSN","no":"ISSN","tr":"ISSN ile ilişkilidir","zh-Hans-CN":"国际标准连续出版物号"},"ToolkitDefinition":{"ar":"تسمية عبارة عن معرف لعمل خصصته وكالة تسجيل ردمد.","ca":"Nomen que és un identificador d’obra que és assignat per una agència de registre de l’ISSN.","cs":"Nomen, které je identifikátorem pro dílo, který byl přidělen registrační agenturou ISSN.","de":"Ein Identifikator für ein Werk, der durch eine ISSN-Registrierungsstelle zugewiesen wird.","de":"Ein Identifikator für ein Werk, der durch eine ISSN-Registrierungsstelle zugewiesen wird.","en":"A nomen that is an identifier for work that is assigned by an ISSN registration agency.","es":"Un nomen que es un identificador de obra asignado por una agencia de registro de ISSN.","et":"Teose identifikaator, mille on määranud ISSN registreerimise agentuur.","fi":"Nomen, joka on teoksen tunniste, jonka on antanut ISSN-rekisteröintitoimisto.","fr":"Nomen qui est un identifiant d’œuvre attribué par une agence d’enregistrement de l’ISSN.","hu":"Egy műazonosító nomen, amelyet egy ISSN regisztrációs ügynökség jegyez.","it":"Identificatore per l’opera che è assegnato da un’agenzia di registrazione ISSN.","lv":"Identifikators darbam, ko piešķir ISSN reģistrācijas aģentūra.","nl":"Een nomen dat is een identificatie voor werk dat toegekend is door een ISSN-registratiebureau.","no":"En identifikator for verk som er tildelt av et ISSN-kontor.","tr":"Bir ISSN kayıt ajansı tarafından atanan eser tanımlayıcısı olan bir isim.","zh-Hans-CN":"一个国际标准连续出版物号注册机构分配给一种作品的一个作为标识符的命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/issn.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10002", "lexicalAlias":"http://rdaregistry.info/Elements/w/identifierForWork.en", "label":"has identifier for work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10366", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/issn.en", "label":"has ISSN"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10366", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/issn.en", "label":"has ISSN"}]},{"@id":"http://rdaregistry.info/Elements/w/P10141","label":{"ar":"له إصدارة","ca":"té com a número","cs":"má číslo","da":"har udgivelse","de":"hat Ausgabe","de":"hat Ausgabe","el":"είναι περιέκτης σειράς του","en":"has issue","es":"tiene ejemplar","et":"number","fi":"numero","fr":"a pour livraison","hu":"száma a következő:","it":"ha come fascicolo","lv":"laidiens","nl":"heeft aflevering","no":"har hefte","tr":"sayı ile ilişkilidir","vi":"là vỏ chứa tùng thư của","zh-Hans-CN":"有期"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل ثابت مستوحى من السياسة التحريرية الشاملة، والمجال، والأسلوب لعمل تجميعي متتالٍ."],"ca":["Relaciona una obra amb una obra que és una obra estàtica que és inspirada per la política editorial general, l’abast i l’estil d’una obra agregadora successiva."],"cs":["Vztahuje dílo k dílu, které je statickým dílem, které je inspirováno celkovou redakční politikou, zaměřením a stylem postupně vydávaného agregačního díla."],"da":["Relaterer et værk til et værk, som er et statisk værk, som er inspireret af den overgribende redaktionelle retningslinje, rækkevidde og stil for et fortløbende aggregerende værk."],"de":["Setzt ein Werk in Beziehung zu einem statischen Werk, das an die allgemeine redaktionelle Vorgehensweise, den Geltungsbereich und den Stil eines sukzessiven, aggregierenden Werks angelehnt ist.,Setzt ein Werk in Beziehung zu einem statischen Werk, das an die allgemeine redaktionelle Vorgehensweise, den Geltungsbereich und den Stil eines sukzessiven, aggregierenden Werks angelehnt ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει εκδοθεί ως μέρος μιας σειράς."],"en":["Relates a work to a work that is a static work that is inspired by the overall editorial policy, scope, and style of a successive aggregating work."],"es":["Relaciona una obra con una obra que es una obra estática que está inspirada en general en la política editorial, alcance y estilo de otra obra agregante sucesiva."],"et":["Seostab teose staatilise teosega, mille toimetamispõhimõtteid, käsitlusala ja stiili suunab liitev järgteos."],"fi":["Liittää teoksen teokseen, joka on staattinen teos, johon on vaikuttanut peräkkäin ilmestyvän aggregoivan teoksen yleinen toimituslinja, toiminta-ala ja tyyli."],"fr":["Met une œuvre en relation avec une œuvre statique qui s’inspire de la politique éditoriale globale, de la portée et du style d’une œuvre agrégatrice successive."],"hu":["Hozzákapcsol egy művet egy statikus műhöz, amelyre egy folyamatos aggregáló mű szerkesztési elve, tárgyköre és stílusa volt hatással."],"it":["Correla un'opera a un'opera statica che è ispirata dalla politica editoriale complessiva, dall’oggetto e dallo stile di un'opera aggregante consecutiva."],"lv":["Sasaista darbu ar darbu, kas ir statisks darbs, ko nosaka vispārējā redakcionālā politika, darbības joma un secīgā apkopojošā darba stils."],"nl":["Relateert een werk aan een werk dat is een statisch werk dat geïnspireerd is door het algehele redactionele beleid, de scope en stijl van een successief aggregaatwerk."],"no":["Relaterer et verk til et verk som er et statisk verk som er inspirert av den samlede redaksjonelle politikken, omfanget og stilen fra et påfølgende aggregert verk."],"tr":["Bir eseri, ardışık toplama eserinin genel yayın politikası, kapsamı ve biçiminden esinlenen durağan bir eser olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được công bố như là phần của tùng thư."],"zh-Hans-CN":["将一种作品与作为一种静态资源并受一种相继合集性作品的编辑政策、编辑范围和编辑风格启发的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة","ca":"número","cs":"číslo","da":"udgivelse","de":"Ausgabe","de":"Ausgabe","el":"περιέκτης σειράς του","en":"issue","es":"ejemplar","et":"number","fi":"numero","fr":"livraison","hu":"száma:","it":"fascicolo","lv":"laidiens","nl":"aflevering","no":"hefte","tr":"sayı","vi":"vỏ chứa tùng thư của","zh-Hans-CN":"期"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل ثابت مستوحى من السياسة التحريرية الشاملة، والمجال، والأسلوب لعمل تجميعي متتالٍ.","ca":"Obra que és una obra estàtica que és inspirada per la política editorial general, l’abast i l’estil d’una obra agregadora successiva.","cs":"Dílo, které je statickým dílem, které je inspirováno celkovou redakční politikou, zaměřením a stylem postupně vydávaného agregačního díla.","da":"Værk, som er et statisk værk, som er inspireret af den overgribende redaktionelle retningslinje, rækkevidde og stil for et fortløbende aggregerende værk.","de":"Ein statisches Werk, das an die allgemeine redaktionelle Vorgehensweise, den Geltungsbereich und den Stil eines sukzessiven, aggregierenden Werks angelehnt ist.","de":"Ein statisches Werk, das an die allgemeine redaktionelle Vorgehensweise, den Geltungsbereich und den Stil eines sukzessiven, aggregierenden Werks angelehnt ist.","el":"Ένα έργο το οποίο έχει εκδοθεί ως μέρος μιας σειράς.","en":"A work that is a static work that is inspired by the overall editorial policy, scope, and style of a successive aggregating work.","es":"Una obra que es una obra estática que está inspirada en general en la política editorial, alcance y estilo de otra obra agregante sucesiva.","et":"Staatiline teos, mille toimetamispõhimõtteid, käsitlusala ja stiili suunab liitev järgteos.","fi":"Teos, joka on staattinen teos, johon on vaikuttanut peräkkäin ilmestyvän aggregoivan teoksen yleinen toimituslinja, toiminta-ala ja tyyli.","fr":"Œuvre statique qui s’inspire de la politique éditoriale globale, de la portée et du style d’une œuvre agrégatrice successive.","hu":"Egy statikus mű, amelyre egy folyamatos aggregáló mű szerkesztési elve, tárgyköre és stílusa volt hatással.","it":"Opera statica che è ispirata dalla politica editoriale complessiva, dall’oggetto e dallo stile di un'opera aggregante consecutiva.","lv":"Darbs, kas ir statisks darbs, ko nosaka vispārējā redakcionālā politika, darbības joma un secīgā apkopojošā darba stils.","nl":"Een werk dat is een statisch werk dat geïnspireerd is door het algehele redactionele beleid, de scope en stijl van een successief aggregaatwerk.","no":"Et verk som er et statisk verk som er inspirert av den samlede redaksjonelle politikken, omfanget og stilen fra et påfølgende aggregert verk.","tr":"Ardışık bir toplama çalışmasının genel yayın politikası, kapsamı ve biçiminden esinlenen sabit çalışma olan bir eser.","vi":"Tác phẩm đã được công bố như là phần của tùng thư.","zh-Hans-CN":"作为一种静态资源并受一种相继合集性作品的编辑政策、编辑范围和编辑风格启发的一种作品"},"altLabel":{"ar":["حاوية سلسلة لـ"],"ca":["col·lecció contenidor de"],"cs":["seriál zahrnující (co)"],"da":["seriecontainer af"],"de":["Reihe enthält,Reihe enthält"],"en":["series container of"],"es":["contenedor de serie de"],"fi":["sarjan osa"],"fr":["conteneur collection de"],"hu":["sorozatbefoglalója:"],"it":["serie contenitore di"],"tr":["seri kapsayıcısı"],"zh-Hans-CN":["……的丛编容纳"]},"note":{"ar":["إصدارة عمل ثابت يمكن أن تكون عملاً منفردًا أو عملًا مجمعًا."],"ca":["Un número d’obra estàtica pot ser una obra sola o una obra agregadora."],"cs":["Číslo jako statické dílo může být samostatné dílo nebo agregované dílo."],"da":["En udgivelse af et statisk værk kan være et enkeltstående værk eller et aggregerende værk."],"de":["Eine Ausgabe eines statischen Werks kann ein Einzelwerk oder ein aggregierendes Werk sein.,Eine Ausgabe eines statischen Werks kann ein Einzelwerk oder ein aggregierendes Werk sein."],"en":["An issue static work can be a single work or an aggregating work."],"es":["Una obra estática ejemplar puede ser una sola obra o una obra agregante."],"et":["Number staatilise teosena võib olla üksikteos või liitev teos."],"fi":["Staattisen teoksen numero voi olla yksittäisteos tai aggregoiva teos."],"fr":["Une livraison peut être une œuvre isolée ou une œuvre agrégatrice."],"hu":["A részegységet alkotó statikus mű önálló vagy aggregáló mű is lehet."],"it":["Un fascicolo di opera statica può essere un'opera singola o un'opera aggregante."],"lv":["Statiska darba laidiens var būt viens darbs vai apkopojošs darbs."],"nl":["Een aflevering-statisch werk kan een enkel werk zijn of een aggregatiewerk."],"tr":["Durağan bir eser, tek bir eser veya birleştirilmiş bir eser olabilir."],"zh-Hans-CN":["一种期静态作品可以是一种单个的作品或一种合集性作品。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
