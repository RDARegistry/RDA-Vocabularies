                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10088", "lexicalAlias":"http://rdaregistry.info/Elements/w/titleOfWork.en", "label":"has title of work"},{"@id":"http://rdaregistry.info/Elements/x/P00021", "lexicalAlias":"http://rdaregistry.info/Elements/x/preferredNameOfRDAEntity.en", "label":"has preferred name of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/preferredTitleOfWork.en","instructionNumber":"6.2.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10223", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/preferredTitleOfWork.en", "label":"has preferred title of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10223", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/preferredTitleOfWork.en", "label":"has preferred title of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10126","label":{"ar":"هو ملخص لعمل","ca":"és resum de","cs":"je abstraktem (čeho)","da":"er sammenfatning af værk","de":"ist Abstract von (Werk)","de":"ist Abstract von","el":"είναι επιτομή του (έργο)","en":"is abstract of","es":"es síntesis de","et":"annotatsioon teosele","fi":"abstrakti teoksesta","fr":"est un résumé analytique de","hu":"absztraktja a következő műnek:","it":"è abstract di opera","lv":"ir anotētais darbs","nl":"is abstract van werk","no":"er abstrakt av verk","tr":"özetidir","vi":"là tóm tắt của (tác phẩm)","zh-Hans-CN":"是……的摘要"},"definition":{"ar":["يربط عمل بعمل يتم اختصاره بطريقة موجزة وموضوعية."],"ca":["Relaciona una obra amb una obra que se sumaritza de manera objectiva."],"cs":["Vztahuje dílo k dílu, které je objektivně shrnuto."],"da":["Relaterer et værk til et værk, som er sammenfattet på en kortfattet, objektiv måde."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das auf eine kurze, sachliche Art gekürzt ist.,Setzt ein Werk in Beziehung zu einem Werk, das auf eine kurze, sachliche Art gekürzt ist."],"el":["Συνδέει ένα έργο με ένα έργο που συνοψίζεται, δηλαδή συμπτύσσεται με σύντομο, αντικειμενικό τρόπο."],"en":["Relates a work to a work that is summarized in an objective manner."],"es":["Relaciona una obra con una obra que es sintetizada de manera objetiva."],"et":["Seostab teose teosega, mille sisu on lühidalt ja objektiivselt kokku võetud."],"fi":["Liittää teoksen teokseen, joka on lyhennetty objektiivisella tavalla."],"fr":["Met une œuvre en relation avec une œuvre qui est résumée de manière objective."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet tárgyilagosan összefoglaltak."],"it":["Correla un’opera a un’opera ridotta in maniera sintetica e obiettiva."],"lv":["Sasaista darbu ar darbu, kuru atreferē saīsinātā, objektīvā veidā."],"nl":["Relateert een werk aan een werk dat verkort is op een korte, objectieve manier."],"no":["Relaterer et verk til et verk som er forkortet i et kortfattet, objektivt sammendrag."],"tr":["Bir eseri, tarafsız biçimde özetlenen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được tóm tắt, nghĩa là, tóm tắt theo cách thức ngắn gọn và khách quan."],"zh-Hans-CN":["将一种作品与被客观提要的一种作品关联起来。"]},"ToolkitLabel":{"ar":"ملخص لعمل","ca":"resum de","cs":"abstrakt (čeho)","da":"sammenfatning af værk","de":"Abstract von (Werk)","de":"ist Abstract von","el":"επιτομή του (έργο)","en":"abstract of","es":"síntesis de","et":"annotatsioon teosele","fi":"abstrakti teoksesta","fr":"résumé analytique de","hu":"absztraktként kivonatolt mű:","it":"abstract di opera","lv":"anotētais darbs","nl":"abstract van werk","no":"abstrakt av verk","tr":"özet","vi":"tóm tắt của (tác phẩm)","zh-Hans-CN":"……的摘要"},"ToolkitDefinition":{"ar":"عمل يتم اختصاره بطريقة موجزة وموضوعية.","ca":"Obra que se sumaritza de manera objectiva.","cs":"Dílo, které je objektivně shrnuto.","da":"Værk, som er sammenfattet på en kortfattet, objektiv måde.","de":"Ein Werk, das auf eine kurze, sachliche Art gekürzt ist.","de":"Ein Werk, das auf eine kurze, sachliche Art gekürzt ist.","el":"Ένα έργο που συνοψίζεται, δηλαδή συμπτύσσεται με σύντομο, αντικειμενικό τρόπο.","en":"A work that is summarized in an objective manner.","es":"Una obra que es sintetizada de manera objetiva.","et":"Teos, mille sisu on lühidalt ja objektiivselt kokku võetud.","fi":"Teos, joka on lyhennetty objektiivisella tavalla.","fr":"Œuvre qui est résumée de manière objective.","hu":"Egy mű, amelyet tárgyilagosan összefoglaltak.","it":"Opera ridotta in maniera sintetica e obiettiva.","lv":"Darbs, kuru atreferē saīsinātā, objektīvā veidā.","nl":"Een werk dat verkort is op een korte, objectieve manier.","no":"Et verk som er forkortet i et kortfattet, objektivt sammendrag.","tr":"Tarafsız biçimde özetlenen çalışma.","vi":"Tác phẩm đã được tóm tắt, nghĩa là, tóm tắt theo cách thức ngắn gọn và khách quan.","zh-Hans-CN":"被客观提要的一种作品"},"altLabel":{"fr":["résumé analytique d’une œuvre"],"hu":["összefoglaló"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10179", "lexicalAlias":"http://rdaregistry.info/Elements/w/summaryOf.en", "label":"is summary of"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/abstractOf.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10126", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/abstractOf.en", "label":"is abstract of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10126", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/abstractOf.en", "label":"is abstract of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10139","label":{"ar":"هو موجز لعمل","ca":"és compendi d’una obra","cs":"je digestem díla","da":"er sammendrag af værk","de":"ist Digest von (Werk)","de":"ist Digest von (Werk)","el":"είναι επιτομή του (έργο)","en":"is digest of work","es":"es compendio de obra","et":"referaat teosest","fi":"mukautettu lyhennelmä teoksesta","fr":"est un condensé d’une œuvre","hu":"kivonata a következő műnek:","it":"è compendio di opera","lv":"ir īssavilkums darbam","nl":"is digest van werk","no":"er resymé av verk","tr":"eserin özetidir","vi":"là vựng tập của (tác phẩm)","zh-Hans-CN":"是作品的文摘"},"definition":{"ar":["يربط عمل بعمل عبارة عن تكثيف منهجي وشامل لعمل ذي صلة."],"ca":["Relaciona una obra amb una obra que és una condensació sistemàtica i exhaustiva d’una obra relacionada."],"cs":["Vztahuje dílo k dílu, které je systematickým a komplexním shrnutím souvisejícího díla."],"da":["Relaterer et værk til et værk, som er en systematisk og gennemgribende komprimering af et relateret værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das eine systematische und umfassende Verdichtung eines in Beziehung stehenden Werks darstellt.,Setzt ein Werk in Beziehung zu einem Werk, das eine systematische und umfassende Verdichtung eines in Beziehung stehenden Werks darstellt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει συντμηθεί, δηλαδή υφίσταται συστηματική και περιεκτική συμπύκνωση."],"en":["Relates a work to a work that is a systematic and comprehensive condensing of a related work."],"es":["Relaciona una obra con una obra que es una condensación sistemática y comprensiva de una obra relacionada."],"et":["Seostab teose teosega, mille süstemaatiline ja igakülgne kokkuvõte teos on."],"fi":["Liittää teoksen teokseen, joka on siihen liittyvän teoksen systemaattinen ja kokonaisvaltainen tiivistelmä."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un abrégement systématique et complet d’une œuvre en relation."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy kapcsolódó mű módszeres és átfogó tömörítése."],"it":["Correla un’opera a un’opera che è un riassunto sistematico ed esaustivo di un’opera correlata."],"lv":["Sasaista darbu ar darbu, kas ir saistīta darba sistemātisks un aptverošs īss apskats."],"nl":["Relateert een werk aan een werk dat een systematische en alomvattende concentratie is van een gerelateerd werk."],"no":["Relaterer et verk til et verk som er systematisk og sterkt forkortet."],"tr":["Bir eseri, ilgili bir eserin sistematik ve kapsamlı bir şekilde derlendiği bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được làm vựng tập, nghĩa là, làm gọn một cách có hệ thống và toàn diện."],"zh-Hans-CN":["将一种作品与作为一种相关作品的系统而全面压缩的一种作品关联起来。"]},"ToolkitLabel":{"ar":"موجز لعمل","ca":"compendi d’una obra","cs":"digest díla","da":"sammendrag af værk","de":"Digest von (Werk)","de":"Digest von (Werk)","el":"επιτομή του (έργο)","en":"digest of work","es":"compendio de obra","et":"referaat teosest","fi":"mukautettu lyhennelmä teoksesta","fr":"condensé d’une œuvre","hu":"kivonatolt mű:","it":"compendio di opera","lv":"īssavilkums darbam","nl":"digest van werk","no":"resymé av verk","tr":"eserin özeti","vi":"vựng tập của (tác phẩm)","zh-Hans-CN":"作品的文摘"},"ToolkitDefinition":{"ar":"عمل عبارة عن تكثيف منهجي وشامل لعمل ذي صلة.","ca":"Obra que és una condensació sistemàtica i exhaustiva d’una obra relacionada.","cs":"Dílo, které je systematickým a komplexním shrnutím souvisejícího díla.","da":"Værk, som er en systematisk og gennemgribende komprimering af et relateret værk.","de":"Ein Werk, das eine systematische und umfassende Verdichtung eines in Beziehung stehenden Werks darstellt.","de":"Ein Werk, das eine systematische und umfassende Verdichtung eines in Beziehung stehenden Werks darstellt.","el":"Ένα έργο το οποίο έχει συντμηθεί, δηλαδή υφίσταται συστηματική και περιεκτική συμπύκνωση.","en":"A work that is a systematic and comprehensive condensing of a related work.","es":"Una obra que es una condensación sistemática y comprensiva de una obra relacionada.","et":"Teos, mille süstemaatiline ja igakülgne kokkuvõte teos on.","fi":"Teos, joka on siihen liittyvän teoksen systemaattinen ja kokonaisvaltainen tiivistelmä.","fr":"Œuvre qui consiste en un abrégement systématique et complet d’une œuvre en relation.","hu":"Egy mű, amely egy kapcsolódó mű módszeres és átfogó tömörítése.","it":"Opera che è un riassunto sistematico ed esaustivo di un’opera correlata.","lv":"Darbs, kas ir saistīta darba sistemātisks un aptverošs īss apskats.","nl":"Een werk dat een systematische en alomvattende concentratie is van een gerelateerd werk.","no":"Et verk som er systematisk og sterkt forkortet.","tr":"İlgili bir çalışmanın sistematik ve kapsamlı bir şekilde özetlendiği bir eser.","vi":"Tác phẩm đã được làm vựng tập, nghĩa là, làm gọn một cách có hệ thống và toàn diện.","zh-Hans-CN":"作为一种相关作品的系统而全面压缩的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10190", "lexicalAlias":"http://rdaregistry.info/Elements/w/sourceWork.en", "label":"has source work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/digestOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10139", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/digestOfWork.en", "label":"is digest of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10139", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/digestOfWork.en", "label":"is digest of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10193","label":{"ar":"هو ملخصات لعمل","ca":"és resums per a una obra","cs":"je abstraktem pro dílo","da":"er sammenfatninger af værk","de":"ist Abstracts für (Werk)","de":"ist Abstracts für (Werk)","el":"είναι επιτομές για (έργο)","en":"is abstracts for work","es":"son resúmenes para la obra","et":"annotatsioonid teosele","fi":"abstraktit teoksesta","fr":"consiste en résumés analytiques pour une œuvre","hu":"absztraktjai a következő műnek:","it":"è abstract per opera","lv":"ir rezumētais darbs","nl":"is abstracts voor werk","no":"er abstrakt for verk","tr":"eseri özetler","vi":"là tóm tắt của (tác phẩm)","zh-Hans-CN":"是作品的摘要"},"definition":{"ar":["يربط عمل بعمل يتم استخلاصه بعمل آخر."],"ca":["Relaciona una obra amb una obra que es resumeix per una altra obra."],"cs":["Vztahuje dílo k dílu, z něhož je pořízen abstrakt v jiném díle."],"da":["Relaterer et værk til et værk, som er sammenfattet af et andet værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch ein anderes Werk zusammengefasst wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch ein anderes Werk zusammengefasst wird."],"el":["Συνδέει ένα έργο με ένα έργο του οποίου τα περιεχόμενα συνοψίζονται από μια υπηρεσία επιτομής και ευρετηρίασης."],"en":["Relates a work to a work that is abstracted by another work."],"es":["Relaciona una obra con una obra que es resumida por otra obra."],"et":["Seostab teose teosega, mis on annoteeritud teises teoses."],"fi":["Liittää teoksen teokseen, jonka toinen teos on abstrahoinut."],"fr":["Met une œuvre en relation avec une œuvre qui est résumée analytiquement par une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy másik mű absztrahált."],"it":["Correla un’opera a un’opera che ha come abstract un’altra opera."],"lv":["Sasaista darbu ar darbu, kuru rezumē cits darbs."],"nl":["Relateert een werk aan een werk dat geabstraheerd is door een ander werk."],"no":["Relaterer et verk til et verk som er i sammendrag i et annet verk."],"tr":["Bir eseri, başka bir eser tarafından soyutlanmış bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mà nội dung của nó được tóm tắt bởi dịch vụ tóm tắt và định chỉ mục."],"zh-Hans-CN":["将一种作品与被另一种作品编制摘要的一种作品关联起来。"]},"ToolkitLabel":{"ar":"ملخصات لعمل","ca":"resums per a una obra","cs":"abstrakt pro dílo","da":"sammenfatninger af værk","de":"Abstracts für (Werk)","de":"Abstracts für (Werk)","el":"επιτομές για (έργο)","en":"abstracts for work","es":"resúmenes para la obra","et":"annotatsioonid teosele","fi":"abstraktit teoksesta","fr":"résumés analytiques pour une œuvre","hu":"absztraktokként kivonatolt mű","it":"abstract per opera","lv":"rezumētais darbs","nl":"abstracts voor werk","no":"abstrakt for verk","tr":"eser için özetler","vi":"tóm tắt của (tác phẩm)","zh-Hans-CN":"作品的摘要"},"ToolkitDefinition":{"ar":"عمل يتم استخلاصه بعمل آخر.","ca":"Obra que es resumeix per una altra obra.","cs":"Dílo, z něhož je pořízen abstrakt v jiném díle.","da":"Værk, som er sammenfattet af et andet værk.","de":"Ein Werk, das durch ein anderes Werk zusammengefasst wird.","de":"Ein Werk, das durch ein anderes Werk zusammengefasst wird.","el":"Ένα έργο του οποίου τα περιεχόμενα συνοψίζονται από μια υπηρεσία επιτομής και ευρετηρίασης.","en":"A work that is abstracted by another work.","es":"Una obra que es resumida por otra obra.","et":"Teos, mis on annoteeritud teises teoses.","fi":"Teos, jonka toinen teos on abstrahoinut.","fr":"Œuvre qui est résumée analytiquement par une autre œuvre.","hu":"Egy mű, amelyet egy másik mű absztrahált.","it":"Opera che ha come abstract un’altra opera.","lv":"Darbs, kuru rezumē cits darbs","nl":"Een werk dat geabstraheerd is door een ander werk.","no":"Et verk som er i sammendrag i et annet verk.","tr":"Başka bir eser tarafından özetlenen bir eser.","vi":"Tác phẩm mà nội dung của nó được tóm tắt bởi dịch vụ tóm tắt và định chỉ mục.","zh-Hans-CN":"被另一种作品编制摘要的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10190", "lexicalAlias":"http://rdaregistry.info/Elements/w/sourceWork.en", "label":"has source work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/abstractsForWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10193", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/abstractsForWork.en", "label":"is abstracts for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10193", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/abstractsForWork.en", "label":"is abstracts for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10181","label":{"ar":"هو كشاف نصوص لعمل","ca":"és concordança d’una obra","da":"er konkordans til værk","de":"ist Konkordanz zu (Werk)","el":"είναι συμφραστικός πίνακας λέξεων στο (έργο)","en":"is concordance to work (Deprecated)","et":"konkordants teosele","fi":"konkordanssihakemisto teokseen","fr":"est une concordance d’une œuvre","hu":"konkordanciája a következő műnek:","it":"è concordanza per opera","lv":"ir konkordance darbam","nl":"is concordantie op werk","no":"er konkordans for verk","vi":"là sách dẫn của (tác phẩm)"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لكشاف لكل الكلمات أو الكلمات المختارة المتحققة في عمل نصي."],"ca":["Relaciona una obra amb una obra usada com a base d’un índex de totes les paraules o de les seleccionades que apareixen en una realització d’una obra textual."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for et indeks over alle ordene i værket."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für einen Index aller oder ausgewählter Wörter verwendet wird, die in einer Realisierung eines textlichen Werks vorkommen."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για έναν συμφραστικό πίνακα λέξεων δηλαδή ένα ευρετήριο όλων των λέξεων σε ένα κύριο έργο."],"en":["Relates a work to a work used as a basis for an index of all or selected words that occur in a realization of a textual work. (Deprecated)"],"et":["Seostab teose teosega, mis on aluseks teose kõigi sõnade registrile."],"fi":["Liittää teoksen tekstiteoksen toteutuksessa esiintyvien kaikkien tai valikoitujen sanojen hakemiston perustana käytettyyn teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui sert de base à un index de la totalité ou d’une partie des mots qui apparaissent dans une réalisation d’une œuvre textuelle."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet alapként használnak egy szöveges mű összes szavának vagy válogatott szavak mutatójához."],"it":["Correla un'opera a un'opera usata come base per un indice di tutte le parole nell’opera."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu konkordancei, t.i., visu lietoto vārdu rādītājam kādā darbā."],"nl":["Relateert een werk aan een werk gebruikt als een basis voor een index van alle of geselecteerde woorden die voorkomen in een realisatie in een tekstwerk."],"no":["Relaterer et verk til et verk som brukes som utgangspunkt for et register over alle ordene i verket."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho sách dẫn, nghĩa là, chỉ mục tất cả các từ trong tác phẩm nổi trội."]},"ToolkitLabel":{"ar":"كشاف نصوص لعمل","ca":"concordança d’una obra","da":"konkordans til værk","de":"Konkordanz zu (Werk)","el":"συμφραστικός πίνακας λέξεων στο (έργο)","en":"concordance to work (Deprecated)","es":"concordancia de (obra)","et":"konkordants teosele","fi":"konkordanssihakemisto teokseen","fr":"concordance d’une œuvre","hu":"konkordanciával ellátott mű","it":"concordanza per opera","lv":"konkordance darbam","nl":"concordantie op werk","no":"konkordans for verk","vi":"sách dẫn của (tác phẩm)"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لكشاف لكل الكلمات أو الكلمات المختارة المتحققة في عمل نصي.","ca":"Obra usada com a base d’un índex de totes les paraules o de les seleccionades que apareixen en una realització d’una obra textual.","da":"Værk, som anvendes som grundlag for et indeks over alle ordene i værket.","de":"Ein Werk, das als Grundlage für einen Index aller oder ausgewählter Wörter verwendet wird, die in einer Realisierung eines textlichen Werks vorkommen.","el":"Ένα έργο το οποίο χρησιμοποιείται ως η βάση για έναν συμφραστικό πίνακα λέξεων δηλαδή ένα ευρετήριο όλων των λέξεων σε ένα κύριο έργο.","en":"A work used as a basis for an index of all or selected words that occur in a realization of a textual work. (Deprecated)","es":"Una obra utilizada como base de una concordancia, i.e., un índice de todas las palabras en la obra principal.","et":"Teos, mis on aluseks teose kõigi sõnade registrile.","fi":"Tekstiteoksen toteutuksessa esiintyvien kaikkien tai valikoitujen sanojen hakemiston perustana käytetty teos.","fr":"Œuvre qui sert de base à un index de la totalité ou d’une partie des mots qui apparaissent dans une réalisation d’une œuvre textuelle.","hu":"Egy mű, amelyet alapként használnak egy szöveges mű összes szavának vagy válogatott szavak mutatójához.","it":"Opera usata come base per un indice di tutte le parole nell’opera.","lv":"Darbs, kas izmantots par pamatu konkordancei, t.i., visu lietoto vārdu rādītājam kādā darbā.","nl":"Een werk gebruikt als een basis voor een index van alle of geselecteerde woorden die voorkomen in een realisatie in een tekstwerk.","no":"Et verk som brukes som utgangspunkt for et register over alle ordene i verket.","vi":"Tác phẩm được sử dụng như là cơ sở cho sách dẫn, nghĩa là, chỉ mục tất cả các từ trong tác phẩm nổi trội."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10192", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentationOfWork.en", "label":"is augmentation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/concordanceToWork.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10181", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/concordanceToWork.en", "label":"is concordance to work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10181", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/concordanceToWork.en", "label":"is concordance to work (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10183","label":{"ar":"هو معالجة راقصة لعمل","ca":"és adaptació coreogràfica d’una obra","cs":"je choreografickou adaptací díla","da":"er koreografisk bearbejdning af værk","de":"ist choreografische Bearbeitung von (Werk)","de":"ist choreografische Bearbeitung von (Werk)","el":"είναι χορογραφική προσαρμογή του (έργο)","en":"is choreographic adaptation of work","es":"es una adaptación coreográfica de la obra","et":"koreograafiline adapteering teosest","fi":"koreografinen sovitus teoksesta","fr":"est une adaptation chorégraphique d’une œuvre","hu":"koreografikus adaptációja a következő műnek:","it":"è un adattamento coreografico di opera","lv":"kā horeogrāfija adaptētais darbs","nl":"is choreografische bewerking van werk","no":"er koreografisk bearbeidelse av verk","tr":"eserin koreografik uyarlamasıdır","vi":"là phỏng theo nghệ thuật bố trí của (tác phẩm)","zh-Hans-CN":"是作品的编舞改编"},"definition":{"ar":["يربط عمل بعمل تمت معالجته كعمل راقص."],"ca":["Relaciona una obra amb una obra que s’adapta com una obra coreogràfica."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako choreografické dílo."],"da":["Relaterer et værk til et værk, som er bearbejdet til et koreografisk værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als choreografisches Werk bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als choreografisches Werk bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως ένα έργο που αποτελείται από κίνηση."],"en":["Relates a work to a work that is adapted as a choreographic work."],"es":["Relaciona una obra con una obra que se adapta como obra coreográfica."],"et":["Seostab teose teosega, mis on adapteeritud koreograafilise teosena."],"fi":["Liittää teoksen teokseen, joka on sovitettu koreografiseksi teokseksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée en œuvre chorégraphique."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet koreografikus műként adaptáltak."],"it":["Correla un'opera a un'opera che è adattata come un’opera coreografica."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā horeogrāfisks darbs."],"nl":["Relateert een werk aan een werk dat is bewerkt als een choreografisch werk."],"no":["Relaterer et verk til et verk som er bearbeidet til et koreografisk verk."],"tr":["Bir eseri, koreografik bir eser olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được cập nhật như là tác phẩm có chứa động thái."],"zh-Hans-CN":["将一种作品与被改编为一种编舞作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالجة راقصة لعمل","ca":"adaptació coreogràfica d’una obra","cs":"choreografická adaptace díla","da":"koreografisk bearbejdning af værk","de":"Choreografische Bearbeitung von (Werk)","de":"Choreografische Bearbeitung von (Werk)","el":"χορογραφική προσαρμογή του (έργο)","en":"choreographic adaptation of work","es":"adaptación coreográfica de la obra","et":"koreograafiline adapteering teosest","fi":"koreografinen sovitus teoksesta","fr":"adaptation chorégraphique d’une œuvre","hu":"mű koreografikus átdolgozása:","it":"adattamento coreografico di opera","lv":"kā horeogrāfija adaptētais darbs","nl":"choreografische bewerking van werk","no":"koreografisk bearbeidelse av verk","tr":"eserin koreografik uyarlaması","vi":"phỏng theo nghệ thuật bố trí của (tác phẩm)","zh-Hans-CN":"作品的编舞改编"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كعمل راقص.","ca":"Obra que s’adapta com una obra coreogràfica.","cs":"Dílo, které je adaptováno jako choreografické dílo.","da":"Værk, som er bearbejdet til et koreografisk værk.","de":"Ein Werk, das als choreografisches Werk bearbeitet ist.","de":"Ein Werk, das als choreografisches Werk bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως ένα έργο που αποτελείται από κίνηση.","en":"A work that is adapted as a choreographic work.","es":"Una obra que se adapta como obra coreográfica.","et":"Teos, mis on adapteeritud koreograafilise teosena.","fi":"Teos, joka on sovitettu koreografiseksi teokseksi.","fr":"Œuvre qui est adaptée en œuvre chorégraphique.","hu":"Egy mű, amelyet koreografikus műként adaptáltak.","it":"Opera che è adattata come un’opera coreografica.","lv":"Darbs, kas ir adaptēts kā horeogrāfisks darbs.","nl":"Een werk dat is bewerkt als een choreografisch werk.","no":"Et verk som er bearbeidet til et koreografisk verk.","tr":"Koreografik bir eser olarak uyarlanan bir eser","vi":"Tác phẩm đã được cập nhật như là tác phẩm có chứa động thái.","zh-Hans-CN":"被改编为一种编舞作品的一种作品"},"altLabel":{"de":["Choreographische Bearbeitung von (Werk)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/choreographicAdaptationOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10183", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/choreographicAdaptationOfWork.en", "label":"is choreographic adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10183", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/choreographicAdaptationOfWork.en", "label":"is choreographic adaptation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10100","label":{"ar":"هو وصف لعمل","ca":"és descripció d’una obra","cs":"je popisem díla","da":"er beskrivelse af værk","de":"ist Beschreibung von (Werk)","de":"ist Beschreibung von (Werk)","el":"είναι περιγραφή του (έργο)","en":"is description of work","es":"es descripción de obra","et":"kirjeldatud teos","fi":"kuvaus teoksesta","fr":"est une description d’une œuvre","hu":"leírása a következő műnek:","it":"è descrizione di opera","lv":"ir apraksts darbam","nl":"is beschrijving van werk","no":"er beskrivelse av verk","tr":"eserin tanımıdır","vi":"là mô tả của tác phẩm","zh-Hans-CN":"是作品的描述"},"definition":{"ar":["يربط عمل بعمل موصوف في عمل."],"ca":["Relaciona una obra amb una obra que és descrita per una obra."],"cs":["Vztahuje dílo k dílu, které je popisováno v díle."],"da":["Relaterer et værk til et værk, som er beskrevet af et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das von einem Werk beschrieben wird.,Setzt ein Werk in Beziehung zu einem Werk, das von einem Werk beschrieben wird."],"el":["Συνδέει ένα έργο με ένα έργο που περιγράφεται από ένα περιγραφικό έργο."],"en":["Relates a work to a work that is described by a work."],"es":["Relaciona una obra con una obra que es descrita por una obra."],"et":["Seostab teose teosega, mida teoses on kirjeldatud."],"fi":["Liittää teoksen teokseen, jota teos kuvaa."],"fr":["Met une œuvre en relation avec une œuvre qui est décrite par une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet egy mű leír."],"it":["Correla un'opera a un'opera che è descritta da un'opera."],"lv":["Sasaista darbu ar darbu, kas aprakstīts darbā."],"nl":["Relateert een werk aan een werk dat beschreven wordt door een werk."],"no":["Relaterer et verk til et verk som beskrives av et verk."],"tr":["Bir eseri, bir eser tarafından tanımlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được mô tả bởi tác phẩm mô tả."],"zh-Hans-CN":["将一种作品与被一种作品描述的一种作品关联起来。"]},"ToolkitLabel":{"ar":"وصف لعمل","ca":"descripció d’una obra","cs":"popis díla","da":"beskrivelse af værk","de":"Beschreibung von (Werk)","de":"Beschreibung von (Werk)","el":"περιγραφή του (έργο)","en":"description of work","es":"descripción de obra","et":"kirjeldatud teos","fi":"kuvaus teoksesta","fr":"description d’une œuvre","hu":"leírt mű:","it":"descrizione di opera","lv":"apraksts darbam","nl":"beschrijving van werk","no":"beskrivelse av verk","tr":"eserinin tanımı","vi":"mô tả của (tác phẩm)","zh-Hans-CN":"作品的描述"},"ToolkitDefinition":{"ar":"عمل موصوف في عمل.","ca":"Obra que és descrita per una obra.","cs":"Dílo, které je popisováno v díle.","da":"Værk, som er beskrevet af et værk.","de":"Ein Werk, das von einem Werk beschrieben wird.","de":"Ein Werk, das von einem Werk beschrieben wird.","el":"Ένα έργο που περιγράφεται από ένα περιγραφικό έργο.","en":"A work that is described by a work.","es":"Una obra que es descrita por una obra.","et":"Teos, mida teoses on kirjeldatud.","fi":"Teos, jota teos kuvaa.","fr":"Œuvre qui est décrite par une œuvre.","hu":"Egy mű, amelyet egy mű leír.","it":"Opera che è descritta da un'opera.","lv":"Darbs, kas aprakstīts darbā","nl":"Een werk dat beschreven wordt door een werk.","no":"Et verk som beskrives av et verk.","tr":"Bir eser tarafından tanımlanan eser.","vi":"Tác phẩm được mô tả bởi tác phẩm mô tả.","zh-Hans-CN":"被一种作品描述的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10257", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectWork.en", "label":"has subject work"},{"@id":"http://rdaregistry.info/Elements/w/P10360", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfRDAEntity.en", "label":"is description of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfWork.en","instructionNumber":"23.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10140", "lexicalAlias":"http://rdaregistry.info/Elements/w/analysisOfWork.en", "label":"is analysis of work"},{"@id":"http://rdaregistry.info/Elements/w/P10187", "lexicalAlias":"http://rdaregistry.info/Elements/w/commentaryOnWork.en", "label":"is commentary on work"},{"@id":"http://rdaregistry.info/Elements/w/P10179", "lexicalAlias":"http://rdaregistry.info/Elements/w/summaryOf.en", "label":"is summary of"},{"@id":"http://rdaregistry.info/Elements/w/P10621", "lexicalAlias":"http://rdaregistry.info/Elements/w/metadataDescriptionOfWork.en", "label":"is metadata description of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10100", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/descriptionOfWork.en", "label":"is description of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10100", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/descriptionOfWork.en", "label":"is description of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10030","label":{"ar":"هو نص أوبرالي لعمل","ca":"és llibret d’una obra","cs":"je libretem pro dílo","da":"er libretto til værk","de":"ist Libretto für (Werk)","de":"ist Libretto für (Werk)","el":"είναι λιμπρέτο για (έργο)","en":"is libretto for work","es":"es libreto para obra","et":"libreto teosele","fi":"libretto teokseen","fr":"est un livret pour une œuvre","hu":"librettó a következő műhöz:","it":"è libretto per opera","lv":"ir librets darbam","nl":"is libretto voor werk","no":"er libretto for verk","tr":"eserin librettosudur","vi":"là lời nhạc kịch cho (tác phẩm)","zh-Hans-CN":"是作品的台本"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل موسيقي أو راقص؛ مثل الأوبرا، أو الباليه، أو عمل آخر للمسرح الموسيقي، أو موسيقى دينية يكملها عمل نصي."],"ca":["Relaciona una obra amb una obra que és una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra per a l’escena musical o un oratori, que es complementa amb una obra que és una obra textual."],"cs":["Vztahuje dílo k dílu, které je hudebním nebo choreografickým dílem jako je opera, balet nebo jiné dílo pro hudební scénu, nebo oratoriem, které je doplněno textovým dílem."],"da":["Relaterer et værk til et værk, som er et musikalsk- eller koreografisk værk, såsom en opera, ballet eller andet værk til en musikalsk scene, eller et oratorium, som er komplementeret af et tekstværk."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk oder einem choreographischen Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder einem Oratorium, das durch ein textliches Werk vervollständigt wird.,Setzt ein Werk in Beziehung zu einem Musikwerk oder einem choreographischen Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder einem Oratorium, das durch ein textliches Werk vervollständigt wird."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο, όπως μια όπερα ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο, το οποίο χρησιμοποιεί το κείμενο ενός σχετικού έργου."],"en":["Relates a work to a work that is a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio, that is complemented by a textual work."],"es":["Relaciona una obra con una obra que es una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio, que es complementada por una obra textual."],"et":["Seostab teose muusikalise või koreograafilise lavateosega (nt ooper, ballett) või oratooriumiga, mille juurde kuulub tekstteos."],"fi":["Liittää teoksen teokseen, joka on musiikki- tai koreografinen teos, kuten ooppera, baletti tai muu musiikillinen näyttämöteos tai oratorio, jota täydentää tekstiteos."],"fr":["Met une œuvre en relation avec une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio, qui est complétée par une œuvre textuelle."],"hu":["Hozzákapcsol egy művet egy olyan zene- vagy koreografikus műhöz, mint egy opera, ballett, vagy egyéb zenés színpadi mű, vagy egy oratórium, amelyet egy szöveges mű egészít ki."],"it":["Correla un’opera a un’opera musicale o coreografica come un’opera, balletto o altra opera per il teatro musicale, o un oratorio, che è completata da un’opera testuale."],"lv":["Sasaista darbu ar darbu, kas ir muzikāls uzvedums, piemēram, opera vai oratorija, kurā izmantots saistītā darba teksts kā librets."],"nl":["Relateert een werk aan een werk dat een muziek- of choreografisch werk is zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium dat is gecomplementeerd met een werk dat een tekstwerk is."],"no":["Relaterer et verk til et musikalsk eller koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene, eller et oriatorium som suppleres av et verk som er et tekstlig verk."],"tr":["Bir eseri, opera, bale veya müzik sahnesi için başka bir eser veya oratoryo türünde müzikal veya koreografik bir eser olan ve metinsel bir eserle tamamlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc như là opera hoặc tác phẩm khác cho âm nhạc sân khấu, hoặc ontario sử dụng văn bản của tác phẩm có liên quan."],"zh-Hans-CN":["将一种作品与被作为一种文字作品的一种作品补充的作为诸如歌剧、芭蕾或其他舞台音乐作品或清唱剧之类的一种音乐或编舞作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"نص أوبرالي لعمل","ca":"llibret d’una obra","cs":"libreto pro dílo","da":"libretto til værk","de":"Libretto für (Werk)","de":"Libretto für (Werk)","el":"λιμπρέτο για (έργο)","en":"libretto for work","es":"libreto para obra","et":"libreto teosele","fi":"libretto teokseen","fr":"livret pour une œuvre","hu":"librettó a következő műhöz:","it":"libretto per opera","lv":"librets darbam","nl":"libretto voor werk","no":"libretto for verk","tr":"eser için opera metni","vi":"lời nhạc kịch cho (tác phẩm)","zh-Hans-CN":"作品的台本"},"ToolkitDefinition":{"ar":"عمل موسيقي أو عمل راقص؛ مثل الأوبرا، أو الباليه، أو عمل آخر للمسرح الموسيقي، أو موسيقى دينية يكملها عمل عبارة عن عمل نصي.","ca":"Obra que és una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra per a l’escena musical o un oratori, que es complementa amb una obra que és una obra textual.","cs":"Dílo, které je hudebním nebo choreografickým dílem jako je opera, balet nebo jiné dílo pro hudební scénu, nebo oratoriem, které je doplněno textovým dílem.","da":"Værk, som er et musikalsk- eller koreografisk værk, såsom en opera, ballet eller andet værk til en musikalsk scene, eller et oratorium, som er komplementeret med et tekstværk.","de":"Ein Musikwerk oder choreografisches Werk, wie zum Beispiel eine Oper, ein Ballett oder ein anderes Musikwerk für die Bühne oder ein Oratorium, die/das durch ein textliches Werk vervollständigt wird.","de":"Ein Musikwerk oder choreografisches Werk, wie zum Beispiel eine Oper, ein Ballett oder ein anderes Musikwerk für die Bühne oder ein Oratorium, die/das durch ein textliches Werk vervollständigt wird.","el":"Ένα μουσικό έργο, όπως μια όπερα ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο, το οποίο χρησιμοποιεί το κείμενο ενός σχετικού έργου.","en":"A work that is a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio, that is complemented by a work that is a textual work.","es":"Una obra que es una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio, que es complementada por una obra textual.","et":"Muusikaline või koreograafiline lavateos (nt ooper, ballett) või oratoorium, mille juurde kuulub tekstteos.","fi":"Teos, joka on musiikki- tai koreografinen teos, kuten ooppera, baletti tai muu musiikillinen näyttämöteos tai oratorio, jota täydentää teos, joka on tekstiteos.","fr":"Œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio, qui est complétée par une œuvre textuelle.","hu":"Egy olyan zene- vagy koreografikus mű, mint egy opera, ballett, vagy egyéb zenés színpadi mű, vagy egy oratórium, amelyet egy szöveges mű egészít ki.","it":"Opera musicale o coreografica come un’opera, balletto o altra opera per il teatro musicale, o un oratorio, che è completata da un’opera testuale.","lv":"Muzikāls uzvedums, piemēram, opera vai oratorija, kurā izmantots saistītā darba teksts kā librets.","nl":"Een werk dat een muziek- of choreografisch werk is zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium dat is gecomplementeerd met een werk dat een tekstwerk is.","no":"Et musikalsk eller koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene, eller et oriatorium som suppleres av et verk som er et tekstlig verk.","tr":"Opera, bale veya müzik sahnesi için başka bir eser veya oratoryo türünde müzikal veya koreografik bir eser olan ve metinsel bir eserle tamamlanan bir eser.","vi":"Tác phẩm âm nhạc như là opera hoặc tác phẩm khác cho âm nhạc sân khấu, hoặc ontario sử dụng văn bản của tác phẩm có liên quan.","zh-Hans-CN":"被作为一种文字作品的一种作品补充的作为诸如歌剧、芭蕾或其他舞台音乐作品或清唱剧之类的一种音乐或编舞作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10372", "lexicalAlias":"http://rdaregistry.info/Elements/w/textForWork.en", "label":"is text for work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/librettoForWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10030", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettoForWork.en", "label":"is libretto for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10030", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettoForWork.en", "label":"is libretto for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10113","label":{"ar":"هو معالج كعمل نص أوبرالي","ca":"és adaptat com a obra de llibret","cs":"je adaptováno jako libreto (dílo)","da":"er bearbejdet til librettoværk","de":"ist bearbeitet als Libretto (Werk)","de":"ist bearbeitet als Libretto (Werk)","el":"είναι προσαρμοσμένο ως λιμπρέτο (έργο)","en":"is adapted as libretto work","es":"es adaptado como obra de libreto","et":"adapteeritud libretona (teos)","fi":"sovitettu libretoksi (ekspressio)","fr":"est adapté en livret (œuvre)","hu":"librettómű-feldolgozása a következő:","it":"è adattato come opera in forma di libretto","lv":"ir adaptēts kā librets (darbs)","nl":"is bewerkt als librettowerk","no":"er bearbeidet som libretto (verk)","tr":"libretto eseri olarak uyarlanmıştır","vi":"được phỏng theo như là lời nhạc kịch (tác phẩm)","zh-Hans-CN":"被改编为台本作品"},"definition":{"ar":["يربط عمل بعمل يتكون من نص عمل موسيقي أو راقص مثل أوبرا، أو باليه، أو عمل آخر للمسرح الموسيقي، أو موسيقى دينية، مبني على عمل آخر."],"ca":["Relaciona una obra amb una obra que consisteix en el text d’una obra musical o coreogràfica com ara una òpera, un ballet o una altra obra escènica musical o d’un oratori basat en una altra obra."],"cs":["Vztahuje dílo k dílu, které sestává z textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium, založeného na jiném díle."],"da":["Relaterer et værk til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus dem Text eines Musikwerks oder eines choreografischen Werks, wie zum Beispiel einer Oper, eines Balletts oder eines anderen Musikwerks für die Bühne, oder eines Oratorium besteht und auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Werk, das aus dem Text eines Musikwerks oder eines choreografischen Werks, wie zum Beispiel einer Oper, eines Balletts oder eines anderen Musikwerks für die Bühne, oder eines Oratorium besteht und auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα έργο, το οποίο συνίσταται από το κείμενο μιας όπερας ή άλλου έργου για τη μουσική σκηνή ή ένα ορατόριο, βασισμένο σε ένα έργο-πηγή."],"en":["Relates a work to a work that consists of the text of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio, based on another work."],"es":["Relaciona una obra con una obra que consiste en el texto de una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio, basada en otra obra."],"et":["Seostab teose teosega, mis sisaldab muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi teksti, mis põhineb allikteosel."],"fi":["Liittää teoksen teokseen, joka koostuu toiseen teokseen perustuvasta musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion tekstistä."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en le texte d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio, basé sur une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely olyan zene- vagy koreografikus mű szövegéből áll, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un’opera a un’opera musicale o coreografica come un’opera, balletto o altra opera per il teatro musicale, o un oratorio."],"lv":["Sasaista darbu ar darbu - operas, oratorijas vai cita muzikāli dramatiskā darba teksts, kas veidots pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat bestaat uit de tekst van een muziek- of choreografisch werk zoals een opera, een ballet of ander werk voor het muzikale podium of een oratorium gebaseerd op een ander werk."],"no":["Relaterer et verk til et verk som består av teksten til en musikal eller et koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene eller et oratorium basert på et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan opera, bale veya müzik sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin metninden oluşan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa văn bản của opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio, dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与基于另一种作品、由诸如歌剧、芭蕾或其他舞台音乐作品或清唱剧之类的一种音乐或编舞作品的文字组成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل نص أوبرالي","ca":"adaptat com a obra de llibret","cs":"adaptováno jako libreto (dílo)","da":"bearbejdet til librettoværk","de":"Bearbeitet als Libretto (Werk)","de":"Bearbeitet als Libretto (Werk)","el":"προσαρμοσμένο ως λιμπρέτο (έργο)","en":"adapted as libretto work","es":"adaptado como obra de libreto","et":"adapteeritud libretona (teos)","fi":"sovitettu libretoksi (ekspressio)","fr":"adapté en livret (œuvre)","hu":"librettómű-átdolgozás:","it":"adattato come opera in forma di libretto","lv":"adaptēts kā darbs: librets","nl":"bewerkt als librettowerk","no":"bearbeidet som libretto (verk)","tr":"Opera metni eseri olarak uyarlanan","vi":"được phỏng theo như là lời nhạc kịch (tác phẩm)","zh-Hans-CN":"被改编为台本作品"},"ToolkitDefinition":{"ar":"عمل يتكون من نص عمل موسيقي أو راقص مثل أوبرا، أو باليه، أو عمل آخر للمسرح الموسيقي، أو موسيقى دينية، مبني على عمل آخر.","ca":"Obra que consisteix en el text d’una obra musical o coreogràfica com ara una òpera, un ballet o una altra obra escènica musical o d’un oratori basat en una altra obra.","cs":"Dílo, které sestává z textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium, založeného na jiném díle.","da":"Værk, som består af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Ein Werk, das aus dem Text eines Musikwerks oder eines choreografischen Werks, wie zum Beispiel einer Oper, eines Balletts oder eines anderen Musikwerks für die Bühne, oder eines Oratorium besteht und auf einem anderen Werk basiert.","de":"Ein Werk, das aus dem Text eines Musikwerks oder eines choreografischen Werks, wie zum Beispiel einer Oper, eines Balletts oder eines anderen Musikwerks für die Bühne, oder eines Oratorium besteht und auf einem anderen Werk basiert.","el":"Ένα έργο, το οποίο συνίσταται από το κείμενο μιας όπερας ή άλλου έργου για τη μουσική σκηνή ή ένα ορατόριο, βασισμένο σε ένα έργο-πηγή.","en":"A work that consists of the text of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio, based on another work.","es":"Una obra que consiste en el texto de una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio, basada en otra obra.","et":"Teos, mis sisaldab muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi teksti, mis põhineb allikteosel.","fi":"Teos, joka koostuu toiseen teokseen perustuvasta musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion tekstistä.","fr":"Œuvre qui consiste en le texte d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio, basé sur une autre œuvre.","hu":"Egy mű, amely olyan zene- vagy koreografikus mű szövegéből áll, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Opera musicale o coreografica come un’opera, balletto o altra opera per il teatro musicale, o un oratorio.","lv":"Darbs - operas, oratorijas vai cita muzikāli dramatiskā darba teksts, kas veidots pēc pamatdarba.","nl":"Een werk dat bestaat uit de tekst van een muziek- of choreografisch werk zoals een opera, een ballet of ander werk voor het muzikale podium of een oratorium gebaseerd op een ander werk.","no":"Et verk som består av teksten til en musikal eller et koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene eller et oratorium basert på et kildeverk.","tr":"Başka bir esere dayanan opera, bale veya müzik sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin metninden oluşan eser.","vi":"Tác phẩm có chứa văn bản của opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio, dựa trên tác phẩm nguồn.","zh-Hans-CN":"基于另一种作品、由诸如歌剧、芭蕾或其他舞台音乐作品或清唱剧之类的一种音乐或编舞作品的文字组成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsLibrettoWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10113", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsLibrettoWork.en", "label":"is adapted as libretto work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10113", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsLibrettoWork.en", "label":"is adapted as libretto work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10072","label":{"ar":"له تجسيدة لعمل","ca":"té com a manifestació d’una obra","cs":"má provedení díla","da":"har manifestation af værk","de":"hat Manifestation eines Werks","de":"hat Manifestation eines Werks","el":"έχει εκδήλωση του έργου","en":"has manifestation of work","es":"tiene manifestación de obra","et":"teose kehastus","fi":"teoksen manifestaatio","fr":"a pour manifestation d’une œuvre","hu":"mű megjelenési formája a következő:","it":"ha come manifestazione di opera","lv":"darba manifestācija","nl":"heeft manifestatie van werk","no":"har manifestasjon av verk","sv":"har manifestation av verk","tr":"eserin gösterimi ile ilişkilidir","vi":"có biểu thị của tác phẩm","zh-Hans-CN":"有作品的载体表现"},"definition":{"ar":["يربط بين عمل وتجسيدة عبارة عن تجسيد مادي لعمل."],"ca":["Relaciona una obra amb una manifestació que és una materialització física d’una obra."],"cs":["Vztahuje dílo k provedení, které je fyzickým ztělesněním díla."],"da":["Relaterer et værk til en fysisk konkretisering af et værk."],"de":["Setzt ein Werk in Beziehung zu einer Manifestation, bei der es sich um eine physische Verkörperung eines Werks handelt.,Setzt ein Werk in Beziehung zu einer Manifestation, bei der es sich um eine physische Verkörperung eines Werks handelt."],"el":["Συνδέει ένα έργο με τη φυσική υλοποίηση ενός έργου."],"en":["Relates a work to a manifestation that is a physical embodiment of a work."],"es":["Relaciona una obra con una manifestación que es una materialización física de una obra."],"et":["Seostab teose teose materiaalse teostusega."],"fi":["Liittää teoksen manifestaatioon, joka on teoksen fyysinen ilmentymä."],"fr":["Met une œuvre en relation avec une manifestation qui consiste en une matérialisation d’une œuvre."],"hu":["Hozzákapcsol egy művet egy megjelenési formához, amely egy mű fizikai megtestesülése."],"it":["Correla un'opera a una materializzazione fisica di un'opera."],"lv":["Sasaista darbu ar manifestāciju, kas ir darba izteiksmes fiziskais iemiesojums."],"nl":["Relateert een werk aan een manifestatie die is een fysieke verwezenlijking van een werk."],"no":["Relaterer et verk til en konkret utforming av et verk."],"tr":["Bir eseri, eserin fiziksel bir temsili olan bir gösterimle ilişkilendirir."],"vi":["Liên kết tác phẩm với hiện thân vật lý của tác phẩm."],"zh-Hans-CN":["将一种作品与作为一种作品的物理具体化的一种载体表现关联起来。"]},"ToolkitLabel":{"ar":"تجسيدة لعمل","ca":"manifestació d’una obra","cs":"provedení díla","da":"manifestation af værk","de":"Manifestation eines Werks","de":"Manifestation eines Werks","el":"εκδήλωση του έργου","en":"manifestation of work","es":"manifestación de obra","et":"teose kehastus","fi":"teoksen manifestaatio","fr":"manifestation d’une œuvre","hu":"műhöz tartozó megjelenési forma:","it":"manifestazione di opera","lv":"darba manifestācija","nl":"manifestatie van werk","no":"manifestasjon av verk","sv":"manifestation av verk","tr":"eserin gösterimi","vi":"biểu thị của tác phẩm","zh-Hans-CN":"作品的载体表现"},"ToolkitDefinition":{"ar":"تجسيدة عبارة عن تجسيد مادي لعمل.","ca":"Manifestació que és una materialització física d’una obra.","cs":"Provedení, které je fyzickým ztělesněním díla.","da":"Fysisk konkretisering af et værk.","de":"Eine Manifestation, bei der es sich um eine physische Verkörperung eines Werks handelt.","de":"Eine Manifestation, bei der es sich um eine physische Verkörperung eines Werks handelt.","el":"Μια φυσική υλοποίηση ενός έργου.","en":"A manifestation that is a physical embodiment of a work.","es":"Una manifestación que es una materialización física de una obra.","et":"Teose materiaalne teostus.","fi":"Manifestaatio, joka on teoksen fyysinen ilmentymä.","fr":"Manifestation qui consiste en une matérialisation d’une œuvre.","hu":"Egy megjelenési forma, amely egy mű fizikai megtestesülése.","it":"Materializzazione fisica di un'opera.","lv":"Darba izteiksmes fiziskais iemiesojums.","nl":"Een manifestatie die is een fysieke verwezenlijking van een werk.","no":"En konkret utforming av et verk.","tr":"Bir eserin fiziksel bir somutlaşması olan bir gösterim.","vi":"Hiện thân vật lý của tác phẩm.","zh-Hans-CN":"作为一种作品的物理具体化的一种载体表现"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/manifestationOfWork.en","instructionNumber":"17.7","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10309", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedManifestationOfWork.en", "label":"has related manifestation of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10072", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/manifestationOfWork.en", "label":"has manifestation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10072", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/manifestationOfWork.en", "label":"has manifestation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10129","label":{"ar":"هو معالجة سينمائية لعمل","ca":"és adaptació cinematogràfica d’una obra","cs":"je filmovou adaptací díla","da":"er bearbejdelse af værk til spillefilm","de":"ist Filmbearbeitung von (Werk)","de":"ist Filmbearbeitung von (Werk)","el":"είναι προσαρμογή κινηματογραφικής ταινίας του (έργο)","en":"is motion picture adaptation of work","es":"es adaptación de película de obra","et":"filmiversioon teosest","fi":"elokuvasovitus teoksesta","fr":"est une adaptation au cinéma d’une œuvre","hu":"mozgóképes adaptációja a következő műnek:","it":"è adattamento cinematografico di opera","lv":"kā kinofilma adaptētais darbs","nl":"is speelfilmbewerking van werk","no":"er bearbeidelse av verk til spillefilm","tr":"eserin sinema filmi uyarlamasıdır","vi":"là phim điện ảnh được phỏng thao của (tác phẩm)","zh-Hans-CN":"是作品的电影改编"},"definition":{"ar":["يربط عمل بعمل تمت معالجته كفيلم سينمائي"],"ca":["Relaciona una obra amb una obra que s’adapta com una pel·lícula cinematogràfica."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako film."],"da":["Relaterer et værk til et værk, som er bearbejdet til en spillefilm."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Film bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als Film bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως κινηματογραφική ταινία."],"en":["Relates a work to a work that is adapted as a motion picture."],"es":["Relaciona una obra con una obra que es adaptada como una película."],"et":["Seostab teose teosega, mis on adapteeritud filmina."],"fi":["Liittää teoksen teokseen, joka on sovitettu elokuvaksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée en film."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet mozgóképként adaptáltak."],"it":["Correla un’opera a un’opera adattata come film."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā kinofilma."],"nl":["Relateert een werk aan een werk dat is bewerkt als een speelfilm."],"no":["Relaterer et verk til et verk som er bearbeidet til spillefilm."],"tr":["Bir eseri, sinema filmi olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là phim điện ảnh"],"zh-Hans-CN":["将一种作品与被改编为电影的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالجة سينمائية لعمل","ca":"adaptació cinematogràfica d’una obra","cs":"filmová adaptace díla","da":"bearbejdelse af værk til spillefilm","de":"Filmbearbeitung von (Werk)","de":"Filmbearbeitung von (Werk)","el":"προσαρμογή κινηματογραφικής ταινίας του (έργο)","en":"motion picture adaptation of work","es":"adaptación de película de obra","et":"filmiversioon teosest","fi":"elokuvasovitus teoksesta","fr":"adaptation au cinéma d’une œuvre","hu":"mozifilmmé átdolgozott mű:","it":"adattamento cinematografico di opera","lv":"kā kinofilma adaptētais darbs","nl":"speelfilmbewerking van werk","no":"bearbeidelse av verk til spillefilm","tr":"eserin sinema filmi uyarlaması","vi":"phim điện ảnh được phỏng thao của (tác phẩm)","zh-Hans-CN":"作品的电影改编"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كفيلم سينمائي.","ca":"Obra que s’adapta com una pel·lícula cinematogràfica.","cs":"Dílo, které je adaptováno jako film.","da":"Værk, som er bearbejdet til en spillefilm.","de":"Ein Werk, das als Film bearbeitet ist.","de":"Ein Werk, das als Film bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως κινηματογραφική ταινία.","en":"A work that is adapted as a motion picture.","es":"Una obra que es adaptada como una película.","et":"Teos, mis on adapteeritud filmina.","fi":"Teos, joka on sovitettu elokuvaksi.","fr":"Œuvre qui est adaptée en film.","hu":"Egy mű, amelyet mozgóképként adaptáltak.","it":"Opera adattata come film.","lv":"Darbs, kas ir adaptēts kā kinofilma.","nl":"Een werk dat is bewerkt als een speelfilm.","no":"Et verk som er bearbeidet til spillefilm.","tr":"Sinema filmi olarak uyarlanan bir eser.","vi":"Tác phẩm đã được phỏng theo như là phim điện ảnh","zh-Hans-CN":"被改编为电影的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/motionPictureAdaptationOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10129", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/motionPictureAdaptationOfWork.en", "label":"is motion picture adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10129", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/motionPictureAdaptationOfWork.en", "label":"is motion picture adaptation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10288","label":{"ar":"هو معالجة موسيقية دينية لعمل","ca":"és adaptació com a oratori d’una obra","cs":"je oratoriem (adaptací díla)","da":"er bearbejdelse af værk til oratorium","de":"ist Oratorienbearbeitung von (Werk)","de":"ist Oratorienbearbeitung von (Werk)","el":"είναι προσαρμογή ορατορίου του (έργο)","en":"is oratorio adaptation of work","es":"es oratorio adaptación de la obra","et":"oratooriumiversioon teosest","fi":"oratoriosovitus teoksesta","fr":"est une adaptation en oratorio d’une œuvre","hu":"oratórium-átdolgozása a következő műnek:","it":"è un adattamento come oratorio di opera","lv":"kā oratorija adaptētais darbs","nl":"is oratoriumbewerking van werk","no":"er bearbeidelse av verk til oratorium","tr":"eserin oratoryo uyarlamasıdır","vi":"là phỏng theo oratorio của (tác phẩm)","zh-Hans-CN":"是作品的清唱剧改编"},"definition":{"ar":["يربط عمل بعمل تمت معالجته كموسيقى دينية."],"ca":["Relaciona una obra amb una obra que s’adapta com un oratori."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako oratorium."],"da":["Relaterer et værk til et værk, som er bearbejdet til et oratorium."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Oratorium bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als Oratorium bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως ορατόριο."],"en":["Relates a work to a work that is adapted as an oratorio."],"es":["Relaciona una obra con una obra que se adapta como oratorio."],"et":["Seostab teose teosega, mis on adapteeritud oratooriumina."],"fi":["Liittää teoksen teokseen, joka on sovitettu oratorioksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée en oratorio."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet oratóriumként adaptáltak."],"it":["Correla un'opera a un'opera che è adattata come oratorio."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā oratorija."],"nl":["Relateert een werk aan een werk dat is bewerkt als een oratorium."],"no":["Relaterer et verk til et verk som er bearbeidet til et oratorium."],"tr":["Bir eseri, oratoryo olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được phỏng thao như là oratorio."],"zh-Hans-CN":["将一种作品与被改编为清唱剧的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالجة موسيقية دينية لعمل","ca":"adaptació com a oratori d’una obra","cs":"oratorium (adaptace díla)","da":"bearbejdelse af værk til oratorium","de":"Oratorienbearbeitung von (Werk)","de":"Oratorienbearbeitung von (Werk)","el":"προσαρμογή ορατορίου του (έργο)","en":"oratorio adaptation of work","es":"oratorio adaptación de la obra","et":"oratooriumiversioon teosest","fi":"oratoriosovitus teoksesta","fr":"adaptation en oratorio d’une œuvre","hu":"oratóriummá átdolgozott mű","it":"adattamento come oratorio di opera","lv":"kā oratorija adaptētais darbs","nl":"oratoriumbewerking van werk","no":"bearbeidelse av verk til oratorium","tr":"eserin oratoryo uyarlaması","vi":"phỏng theo oratorio của (tác phẩm)","zh-Hans-CN":"作品的清唱剧改编"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كموسيقى دينية.","ca":"Obra que s’adapta com un oratori.","cs":"Dílo, které je adaptováno jako oratorium.","da":"Værk, som er bearbejdet til et oratorium.","de":"Ein Werk, das als Oratorium bearbeitet ist.","de":"Ein Werk, das als Oratorium bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως ορατόριο.","en":"A work that is adapted as an oratorio.","es":"Una obra que se adapta como oratorio.","et":"Teos, mis on adapteeritud oratooriumina.","fi":"Teos, joka on sovitettu oratorioksi.","fr":"Œuvre qui est adaptée en oratorio.","hu":"Egy mű, amelyet oratóriumként adaptáltak.","it":"Opera che è adattata come oratorio.","lv":"Darbs, kas ir adaptēts kā oratorija.","nl":"Een werk dat is bewerkt als een oratorium.","no":"Et verk som er bearbeidet til et oratorium.","tr":"Oratoryo olarak uyarlanan bir eser.","vi":"Tác phẩm được phỏng thao như là oratorio.","zh-Hans-CN":"被改编为清唱剧的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/oratorioAdaptationOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10288", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/oratorioAdaptationOfWork.en", "label":"is oratorio adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10288", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/oratorioAdaptationOfWork.en", "label":"is oratorio adaptation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10179","label":{"ar":"هو ملخص لعمل","ca":"és sumari de","cs":"je souhrnem (čeho)","da":"er resumé af værk","de":"ist Zusammenfassung von (Werk)","de":"ist Zusammenfassung von","el":"είναι περίληψη του (έργο)","en":"is summary of","es":"es resumen de","et":"kokkuvõte teosest","fi":"yhteenveto teoksesta","fr":"est un résumé de","hu":"összefoglalója a következőnek:","it":"è riassunto di opera","lv":"ir kopsavilkums darbam","nl":"is samenvatting van werk","no":"er sammendrag av verk","tr":"özetidir","vi":"là tóm lược của (tác phẩm)","zh-Hans-CN":"是……的提要"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لتلخيص موجز لمحتواه."],"ca":["Relaciona una obra amb una obra que és breument descrita per una obra."],"cs":["Vztahuje dílo k dílu, které je stručně popsáno v díle."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for en kortfattet sammenfatning af dets indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine kurze Zusammenfassung seines Inhalts verwendet wird.,Setzt ein Werk in Beziehung zu einem Werk, das von einem Werk beschrieben wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια σύντομη ανακεφαλαίωση του περιεχομένου του."],"en":["Relates a work to a work that is briefly described by a work."],"es":["Relaciona una obra con una obra que se describe brevemente por una obra."],"et":["Seostab teose teosega, mis on lühikese sisukokkuvõtte aluseks."],"fi":["Liittää teoksen teokseen, jota teos kuvaa lyhyesti."],"fr":["Met une œuvre en relation avec une œuvre qui est brièvement décrite par une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet röviden leír egy mű."],"it":["Correla un'opera a un'opera usata come base per una breve ricapitolazione del suo contenuto."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu īsam satura kopsavilkumam."],"nl":["Relateert een werk aan een werk gebruikt als een basis voor een korte herformulering van diens content."],"no":["Relaterer et verk til et verk brukt som utgangspunkt for et kort sammendrag av innholdet."],"tr":["Bir eseri, bir eser tarafından kısaca tanımlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho tóm lại ngắn gọn nôi dung của nó."],"zh-Hans-CN":["将一种作品与被一种作品简要描述的一种作品关联起来。"]},"ToolkitLabel":{"ar":"ملخص لعمل","ca":"sumari de","cs":"souhrn (čeho)","da":"resumé af værk","de":"Zusammenfassung von (Werk)","de":"ist Zusammenfassung von","el":"περίληψη του (έργο)","en":"summary of","es":"resumen de","et":"kokkuvõte teosest","fi":"yhteenveto teoksesta","fr":"résumé de","hu":"összefoglaló:","it":"riassunto di opera","lv":"kopsavilkums darbam","nl":"samenvatting van werk","no":"sammendrag av verk","tr":"özet","vi":"tóm lược của (tác phẩm)","zh-Hans-CN":"……的提要"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لتلخيص موجز لمحتواه.","ca":"Obra que és breument descrita per una obra.","cs":"Dílo, které je stručně popsáno v díle.","da":"Værk, som anvendes som grundlag for en kortfattet sammenfatning af dets indhold.","de":"Ein Werk, das als Grundlage für eine kurze Zusammenfassung seines Inhalts verwendet wird.","de":"Ein Werk, das von einem Werk beschrieben wird.","el":"Ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια σύντομη ανακεφαλαίωση του περιεχομένου του.","en":"A work that is briefly described by a work.","es":"Una obra que se describe brevemente por una obra.","et":"Teos, mis on lühikese sisukokkuvõtte aluseks.","fi":"Teos, jota teos kuvaa lyhyesti.","fr":"Œuvre qui est brièvement décrite par une œuvre.","hu":"Egy mű, amelyet röviden leír egy mű.","it":"Opera usata come base per una breve ricapitolazione del suo contenuto.","lv":"Darbs, kas izmantots par pamatu īsam satura kopsavilkumam.","nl":"Een werk gebruikt als een basis voor een korte herformulering van diens content.","no":"Et verk brukt som utgangspunkt for et kort sammendrag av innholdet.","tr":"Bir çalışma tarafından kısaca tanımlanan bir çalışma","vi":"Tác phẩm được sử dụng như là cơ sở cho tóm lại ngắn gọn nôi dung của nó.","zh-Hans-CN":"被一种作品简要描述的一种作品"},"altLabel":{"ca":["sumari d’obra"],"cs":["souhrn díla"],"de":["Zusammenfassung von (Werk)"],"en":["summary of work"],"es":["resumen de la obra"],"fi":["-"],"fr":["résumé d’une œuvre"],"hu":["mű összefoglalója:"],"tr":["eserin özeti"],"zh-Hans-CN":["作品的提要"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10100", "lexicalAlias":"http://rdaregistry.info/Elements/w/descriptionOfWork.en", "label":"is description of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/summaryOf.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10126", "lexicalAlias":"http://rdaregistry.info/Elements/w/abstractOf.en", "label":"is abstract of"},{"@id":"http://rdaregistry.info/Elements/w/object/P10179", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/summaryOf.en", "label":"is summary of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10179", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/summaryOf.en", "label":"is summary of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10213","label":{"ar":"هو مدمِج لعمل","ca":"és fusió d’una obra","cs":"je sloučením díla","da":"er sammenlægning af værk","de":"ist Vereinigung von (Werk)","de":"ist Vereinigung von (Werk)","el":"είναι συγχώνευση του (έργο)","en":"is merger of work","es":"es fusion de obra","et":"teoseks ühenduja","fi":"teokseen yhdistyjä","fr":"est une fusion d’une œuvre","hu":"egyesítője a következő műnek:","it":"è fusione di opera","lv":"ir sapludinātais darbs","nl":"is samenvoeging van werk","no":"er sammenslåing av verk","tr":"eserin birleşmesidir","vi":"là hợp thành của (tác phẩm)","zh-Hans-CN":"是作品的合并"},"definition":{"ar":["يربط عمل بعمل تم دمجه مع عمل آخر أو أكثر لتكوين عمل جديد."],"ca":["Relaciona una obra amb una obra que s’ha aplegat amb una o més obres per formar una nova obra."],"cs":["Vztahuje dílo k dílu, které vzniklo spojením s jedním nebo více dalšími díly a tvoří nové dílo."],"da":["Relaterer et værk til et værk, som er lagt sammen med et eller flere andre værker, så det danner et nyt værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das mit einem anderen Werk oder mehreren anderen Werken zusammengeführt wird, um ein neues Werk zu bilden.,Setzt ein Werk in Beziehung zu einem Werk, das mit einem anderen Werk oder mehreren anderen Werken zusammengeführt wird, um ein neues Werk zu bilden."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο συνενώθηκε με ένα ή περισσότερα άλλα έργα για να σχηματιστεί ένα νέο έργο."],"en":["Relates a work to a work that came together with one or more other works to form a new work."],"es":["Relaciona una obra con una obra que se unió con una o más obras para formar una nueva obra."],"et":["Seostab teose teosega, mis on uue teose moodustamiseks kokku pandud ühe või mitme teise teosega."],"fi":["Liittää teoksen teokseen, joka on yhdistynyt yhden tai useamman teoksen kanssa ja muodostanut uuden teoksen."],"fr":["Met une œuvre en relation avec une œuvre qui s’est combinée à une ou plusieurs autres œuvres pour former une nouvelle œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy vagy több egyéb művel egyesült egy új mű létrehozása érdekében."],"it":["Correla un’opera a un’opera che fonde una o più opere per formare una nuova opera."],"lv":["Sasaista darbu ar darbu, kas kopā ar vienu vai vairākiem citiem darbiem veido jaunu darbu."],"nl":["Relateert een werk aan een werk dat samengekomen is met een of meer andere werken om een nieuw werk te vormen."],"no":["Relaterer et verk til et verk som er slått sammen med ett eller flere andre verk for å danne et nytt verk."],"tr":["Bir eseri, bir ya da daha fazla farklı eserle bir araya getirerek yeni bir eseri oluşturmuş bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm ghép một hoặc nhiều hơn tác phẩm khác để tạo thành tác phẩm mới."],"zh-Hans-CN":["将一种作品与和一种或者多种其他作品一起形成一种新的作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مدمِج لعمل","ca":"fusió d’una obra","cs":"sloučení díla","da":"sammenlægning af værk","de":"Vereinigung von (Werk)","de":"Vereinigung von (Werk)","el":"συγχώνευση του (έργο)","en":"merger of work","es":"fusion de obra","et":"teoseks ühenduja","fi":"teokseen yhdistyjä","fr":"fusion d’une œuvre","hu":"összeolvadó mű","it":"fusione di opera","lv":"sapludinātais darbs","nl":"fusie van werk","no":"sammenslåing av verk","tr":"çalışmanın birleştirilmesi","vi":"hợp thành của (tác phẩm)","zh-Hans-CN":"作品的合并"},"ToolkitDefinition":{"ar":"عمل تم دمجه مع عمل آخر أو أكثر لتكوين عمل جديد.","ca":"Obra que s’ha aplegat amb una o més obres per formar una nova obra.","cs":"Dílo, které vzniklo spojením s jedním nebo více dalšími díly a tvoří nové dílo.","da":"Værk, som er lagt sammen med et eller flere andre værker, så det danner et nyt værk.","de":"Ein Werk, das mit einem anderen Werk oder mehreren anderen Werken zusammengeführt wird, um ein neues Werk zu bilden.","de":"Ein Werk, das mit einem anderen Werk oder mehreren anderen Werken zusammengeführt wird, um ein neues Werk zu bilden.","el":"Συνδέει ένα έργο με ένα έργο το οποίο συνενώθηκε με ένα ή περισσότερα άλλα έργα για να σχηματιστεί ένα νέο έργο.","en":"A work that came together with one or more other works to form a new work.","es":"Una obra que se unió con una o más obras para formar una nueva obra.","et":"Teos, mis on uue teose moodustamiseks kokku pandud ühe või mitme teise teosega.","fi":"Teos, joka on yhdistynyt yhden tai useamman teoksen kanssa ja muodostanut uuden teoksen.","fr":"Œuvre qui s’est combinée à une ou plusieurs autres œuvres pour former une nouvelle œuvre.","hu":"Egy mű, amely egy vagy több egyéb művel egyesült egy új mű létrehozása érdekében.","it":"Opera che fonde una o più opere per formare una nuova opera.","lv":"Darbs, kas kopā ar vienu vai vairākiem citiem darbiem veido jaunu darbu.","nl":"Een werk dat samengekomen is met een of meer andere werken om een nieuw werk te vormen.","no":"Et verk som er slått sammen med ett eller flere andre verk for å danne et nytt verk.","tr":"Bir veya daha fazla başka eserle birleşerek yeni bir eser oluşturan eser.","vi":"Tác phẩm ghép một hoặc nhiều hơn tác phẩm khác để tạo thành tác phẩm mới.","zh-Hans-CN":"和一种或者多种其他作品一起形成一种新的作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10156", "lexicalAlias":"http://rdaregistry.info/Elements/w/precededByWork.en", "label":"is preceded by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/mergerOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10213", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/mergerOfWork.en", "label":"is merger of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10213", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/mergerOfWork.en", "label":"is merger of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10197","label":{"ar":"هو محاكاة ساخرة لعمل","ca":"és paròdia d’una obra","cs":"je parodií díla","da":"er parodi på værk","de":"ist Parodie von (Werk)","de":"ist Parodie von (Werk)","el":"είναι διακωμώδηση του (έργο)","en":"is parody of work","es":"es una parodia de la obra","et":"parodeeritud teos","fi":"parodia teoksesta","fr":"est une parodie d’une œuvre","hu":"paródiája a következő műnek:","it":"è parodia di opera","lv":"ir parodija darbam","nl":"is parodie van werk","no":"er parodi på verk","tr":"eserin parodisidir","vi":"là văn nhại của (tác phẩm)","zh-Hans-CN":"是作品的戏仿"},"definition":{"ar":["يربط عمل بعمل تم تقليد أسلوبه أو محتواه ليُحدث تأثيرًا هزليًا."],"ca":["Relaciona una obra amb una obra l’estil o el contingut de la qual s’imita per donar un efecte còmic."],"cs":["Vztahuje dílo k dílu, jehož styl nebo obsah je napodobován pro komický efekt."],"da":["Relaterer et værk til et værk, hvis stil eller indhold efterlignes for at opnå en komisk effekt."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Stil oder Inhalt für eine lustige Wirkung nachgeahmt wird.,Setzt ein Werk in Beziehung zu einem Werk, dessen Stil oder Inhalt für eine lustige Wirkung nachgeahmt wird."],"el":["Συνδέει ένα έργο με ένα έργο του οποίου το ύφος ή το περιεχόμενο υποβάλλεται σε μίμηση ως κωμικό εφέ."],"en":["Relates a work to a work whose style or content is imitated for comic effect."],"es":["Relaciona una obra con una obra cuyo estilo o contenido se imita para lograr un efecto cómico."],"et":["Seostab teose teosega, mille stiili või sisu on jäljendatud koomilise efekti saavutamiseks."],"fi":["Liittää teoksen teokseen, jonka tyyliä tai sisältöä jäljitellään humoristisesti."],"fr":["Met une œuvre en relation avec une œuvre dont le style ou le contenu est imité dans le but de produire un effet comique."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek stílusát vagy tartalmát utánozzák a komikus hatás kedvéért."],"it":["Correla un’opera a un’opera il cui stile o contenuto è imitato per produrre un effetto comico."],"lv":["Sasaista darbu ar darbu, kura stils vai saturs tiek atdarināts komiska efekta iegūšanai."],"nl":["Relateert een werk aan een werk waarvan stijl of content is geïmiteerd voor komisch effect."],"no":["Relaterer et verk til et verk hvis stil eller innhold kopieres for en humoristisk effekt."],"tr":["Bir eseri, komik etki yaratmak için biçimi veya içeriği taklit edilen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mà phong cách và nội dung được nhại lại cho hiệu quả hài hước."],"zh-Hans-CN":["将一种作品与其风格和内容被模仿而达到戏剧效果的一种作品关联起来。"]},"ToolkitLabel":{"ar":"محاكاة ساخرة لعمل","ca":"paròdia d’una obra","cs":"parodie díla","da":"parodi på værk","de":"Parodie von (Werk)","de":"Parodie von (Werk)","el":"διακωμώδηση του (έργο)","en":"parody of work","es":"parodia de la obra","et":"parodeeritud teos","fi":"parodia teoksesta","fr":"parodie d’une œuvre","hu":"parodizált mű","it":"parodia di opera","lv":"parodija darbam","nl":"parodie van werk","no":"parodi på verk","tr":"Eserin parodisi","vi":"văn nhại của (tác phẩm)","zh-Hans-CN":"作品的戏仿"},"ToolkitDefinition":{"ar":"عمل تم تقليد أسلوبه أو محتواه ليُحدث تأثيرًا هزليًا.","ca":"Obra l’estil o el contingut de la qual s’imita per donar un efecte còmic.","cs":"Dílo, jehož styl nebo obsah je napodobován pro komický efekt.","da":"Værk, hvis stil eller indhold efterlignes for at opnå en komisk effekt.","de":"Ein Werk, dessen Stil oder Inhalt für eine lustige Wirkung nachgeahmt wird.","de":"Ein Werk, dessen Stil oder Inhalt für eine lustige Wirkung nachgeahmt wird.","el":"Ένα έργο του οποίου το ύφος ή το περιεχόμενο υποβάλλεται σε μίμηση ως κωμικό εφέ.","en":"A work whose style or content is imitated for comic effect.","es":"Una obra cuyo estilo o contenido se imita para lograr un efecto cómico.","et":"Teos, mille stiili või sisu on jäljendatud koomilise efekti saavutamiseks.","fi":"Teos, jonka tyyliä tai sisältöä jäljitellään humoristisesti.","fr":"Œuvre dont le style ou le contenu est imité dans le but de produire un effet comique.","hu":"Egy mű, amelynek stílusát vagy tartalmát utánozzák a komikus hatás kedvéért.","it":"Opera il cui stile o contenuto è imitato per produrre un effetto comico.","lv":"Darbs, kura stils vai saturs tiek atdarināts komiska efekta iegūšanai.","nl":"Een werk waarvan stijl of content is geïmiteerd voor komisch effect.","no":"Et verk hvis stil eller innhold kopieres for en humoristisk effekt.","tr":"Komik etki yaratmak için bir biçimi veya içeriği taklit edilmiş bir çalışma.","vi":"Tác phẩm mà phong cách và nội dung được nhại lại cho hiệu quả hài hước.","zh-Hans-CN":"其风格和内容被模仿而达到戏剧效果的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
