                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/directorFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10578", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorFamilyOfWork.en", "label":"has creator family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10502", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgent.en", "label":"has director collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10559", "lexicalAlias":"http://rdaregistry.info/Elements/w/filmDirectorFamily.en", "label":"has film director family"},{"@id":"http://rdaregistry.info/Elements/w/P10560", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioDirectorFamily.en", "label":"has radio director family"},{"@id":"http://rdaregistry.info/Elements/w/P10561", "lexicalAlias":"http://rdaregistry.info/Elements/w/televisionDirectorFamily.en", "label":"has television director family"},{"@id":"http://rdaregistry.info/Elements/w/object/P10596", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorFamily.en", "label":"has director family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10596", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorFamily.en", "label":"has director family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10556","label":{"ar":"له عائلة مديرة تصوير","ca":"té com a família directora de fotografia","cs":"má hlavního kameramana (rodinu)","da":"har familie, som er filmfotograf","de":"hat Kamerafrau/Kameramann (Familie)","de":"hat Kamerafrau/Kameramann (Familie)","en":"has director family of photography","es":"tiene familia directora de fotografía","et":"operaator-lavastaja (perekond)","fi":"kuvaaja (suku)","fr":"a pour famille directrice de la photographie","hu":"operatőr családja a következő:","it":"ha come direttore famiglia della fotografia","lv":"kinooperators (dzimta/ģimene)","nl":"heeft cameraregisseur-familie","no":"har filmfotograf (familie)","tr":"görüntü yönetmeni ailesi ile ilişkilidir","zh-Hans-CN":"有摄影指导家族"},"definition":{"ar":["يربط بين عمل وعائلة تلتقط الصور، إما إلكترونيًا، أو على فيلم، أو مقاطع فيديو، وغالبًا ما تختار الإضاءة وترتبها."],"ca":["Relaciona una obra amb una família que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació."],"cs":["Vztahuje dílo k rodině, která zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení."],"da":["Relaterer et værk til en familie, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.,Setzt ein Werk in Beziehung zu einer Familie, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert."],"en":["Relates a work to a family who captures images, either electronically or on film or video stock, and often selects and arranges the lighting."],"es":["Relaciona una obra con una familia que captura imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente elige y organiza la iluminación."],"et":["Seostab teose perekonnaga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse."],"fi":["Liittää teoksen sukuun, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen."],"fr":["Met une œuvre en relation avec une famille qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage."],"hu":["Hozzákapcsol egy művet egy családhoz, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást."],"it":["Correla un'opera a una famiglia che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu."],"nl":["Relateert een werk aan een familie die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert."],"no":["Relaterer et verk til en familie som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting."],"tr":["Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü kaydeden ve genellikle ışıklandırmayı seçip düzenleyen bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مديرة تصوير","ca":"família directora de fotografia","cs":"hlavní kameraman (rodina)","da":"familie, som er filmfotograf","de":"Kamerafrau/Kameramann (Familie)","de":"Kamerafrau/Kameramann (Familie)","en":"director family of photography","es":"familia directora de fotografía","et":"operaator-lavastaja (perekond)","fi":"kuvaaja (suku)","fr":"famille directrice de la photographie","hu":"operatőr család:","it":"direttore famiglia della fotografia","lv":"kinooperators (dzimta/ģimene)","nl":"cameraregisseur-familie","no":"filmfotograf (familie)","tr":"görüntü yönetmeni ailesi","zh-Hans-CN":"摄影指导家族"},"ToolkitDefinition":{"ar":"عائلة تلتقط الصور، إما إلكترونيًا، أو على فيلم، أو مقاطع فيديو، وغالبًا ما تختار الإضاءة وترتبها.","ca":"Família que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.","cs":"Rodina, která zaznamenává obrazy, ať už elektronicky nebo na film či video, a často vybírá a upravuje osvětlení.","da":"Familie, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.","de":"Eine Familie, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","de":"Eine Familie, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.","en":"A family who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.","es":"Una familia que captura imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente elige y organiza la iluminación.","et":"Perekond, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.","fi":"Suku, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.","fr":"Famille qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.","hu":"Egy család, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.","it":"Famiglia che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci.","lv":"Dzimta/ģimene, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.","nl":"Een familie die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.","no":"En familie som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.","tr":"Elektronik olarak ya da film ya da video stoğunda görüntü yakalayan ve genellikle aydınlatmayı seçip düzenleyen bir aile.","zh-Hans-CN":"通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个家族"},"note":{"ar":["مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين."],"ca":["Un director de fotografia d’una pel·lícula també s’anomena primer operador."],"da":["Filmfotografen på en film kaldes også for en cheffotograf."],"de":["Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet.,Eine Kamerafrau/Ein Kameramann für einen Film wird auch als \"Bildregisseurin/Bildregisseur\" bezeichnet."],"en":["A director of photography for a movie is also called a chief cinematographer."],"es":["Un director de fotografía para una película también es llamado un primer cinematógrafo."],"et":["Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer."],"fi":["Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi."],"fr":["Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue."],"hu":["Egy film operatőrét vezető operatőrnek is nevezik."],"it":["Un direttore della fotografia in un film è detto anche capo operatore."],"lv":["Kinooperatoru mēdz saukt arī par galveno operatoru."],"nl":["Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd."],"no":["Filmfotografen for en film kalles også sjefsfotograf."],"tr":["Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır."],"zh-Hans-CN":["电影的摄影指导也称总摄影师"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/directorFamilyOfPhotography.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10578", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorFamilyOfWork.en", "label":"has creator family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10462", "lexicalAlias":"http://rdaregistry.info/Elements/w/directorCollectiveAgentOfPhotography.en", "label":"has director collective agent of photography"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10556", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/directorFamilyOfPhotography.en", "label":"has director family of photography"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10556", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/directorFamilyOfPhotography.en", "label":"has director family of photography"}]},{"@id":"http://rdaregistry.info/Elements/w/P10455","label":{"ar":"له شخص مخرج","ca":"té com a persona realitzadora","cs":"má režiséra (osobu)","da":"har person, som er instruktør","de":"hat Regisseurin/Regisseur (Person)","de":"hat Regisseurin/Regisseur (Person)","en":"has director person","es":"tiene persona directora","et":"režissöör (isik)","fi":"ohjaaja (henkilö)","fr":"a pour personne réalisatrice","hu":"rendező személye a következő:","it":"ha come regista persona","lv":"režisors (persona)","nl":"heeft regisseur-person","no":"har regissør (person)","tr":"yönetmen kişisi ile ilişkilidir","zh-Hans-CN":"有导演个人"},"definition":{"ar":["يربط بين عمل وشخص مسئول عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ."],"ca":["Relaciona una obra amb una persona que és responsable de la gestió general i la supervisió d’una actuació filmada, un programa radiofònic o de televisió, etc."],"cs":["Vztahuje dílo k osobě, která je odpovědná za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem atd."],"da":["Relaterer et værk til en person, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc."],"de":["Setzt ein Werk in Beziehung zu einer Person, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Person, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist."],"en":["Relates a work to a person who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc."],"es":["Relaciona una obra con una persona que tiene a su cargo la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc."],"et":["Seostab teose isikuga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest."],"fi":["Liittää teoksen henkilöön, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta."],"fr":["Met une œuvre en relation avec une personne qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc."],"hu":["Hozzákapcsol egy művet egy személyhez, aki felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért."],"it":["Correla un'opera alla persona responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc."],"lv":["Sasaista darbu ar personu, kura ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību."],"nl":["Relateert een werk aan een persoon die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc."],"no":["Relaterer et verk til en person som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc."],"tr":["Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan bir kişiyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与负责摄制表演、广播或电视节目等的全面管理和监督的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مخرج","ca":"persona realitzadora","cs":"režisér (osoba)","da":"person, som er instruktør","de":"Regisseurin/Regisseur (Person)","de":"Regisseurin/Regisseur (Person)","en":"director person","es":"persona directora","et":"režissöör (isik)","fi":"ohjaaja (henkilö)","fr":"personne réalisatrice","hu":"rendező személy:","it":"regista persona","lv":"režisors (persona)","nl":"regisseur-person","no":"regissør (person)","tr":"yönetmen","zh-Hans-CN":"导演个人"},"ToolkitDefinition":{"ar":"شخص يكون مسئولاً عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.","ca":"Persona que és responsable de la gestió general i la supervisió d’una actuació filmada, un programa radiofònic o de televisió, etc.","cs":"Osoba, která je odpovědná za celkové řízení a dohled nad natočeným představením, rozhlasovým nebo televizním programem atd.","da":"Person, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.","de":"Eine Person, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","de":"Eine Person, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.","en":"A person who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.","es":"Una persona que tiene a su cargo la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc.","et":"Isik, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.","fi":"Henkilö, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.","fr":"Personne qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.","hu":"Egy személy, aki felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.","it":"Persona responsabile della gestione generale e della supervisione di un'interpretazione cinematografica, programma radiofonico o televisivo, etc.","lv":"Persona, kura ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.","nl":"Een persoon die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.","no":"En person som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.","tr":"Filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan kişi.","zh-Hans-CN":"负责摄制表演、广播或电视节目等的全面管理和监督的一个个人"},"altLabel":{"et":["lavastaja (isik)"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
