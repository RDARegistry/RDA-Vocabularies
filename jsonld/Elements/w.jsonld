                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsGraphicNovelWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10251", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsGraphicNovelWork.en", "label":"is adapted as graphic novel work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10251", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsGraphicNovelWork.en", "label":"is adapted as graphic novel work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10157","label":{"ar":"له عمل معينات بحث","ca":"té com a obra d’instrument de descripció","da":"har hjælpeværktøjsværk","de":"hat Findmittel (Werk)","el":"είναι εργαλείο έρευνας (έργο)","en":"has finding aid work (Deprecated)","et":"arhiivinimistu (teos)","fi":"arkistokokoelman hakemisto (teos)","fr":"a pour instrument de recherche (œuvre)","hu":"keresési segédlete a következő mű:","it":"ha come aiuto alla ricerca opera","lv":"darbs: meklēšanas palīglīdzeklis","nl":"heeft vind-hulpmiddel-werk","no":"har veiledning (verk)","vi":"là hỗ trợ tìm kiếm (tác phẩm)"},"definition":{"ar":["يربط عمل بعمل يوفر دليلًا إرشاديا لتنظيم مجموعة أرشيفية، وترتيبها، ومحتوياتها."],"ca":["Relaciona una obra amb una obra que proporciona una guia a l’organització, l’arranjament i els continguts d’una col·lecció arxivística."],"da":["Relaterer et værk til et værk, som giver en vejledning til organiseringen, opsætningen og indholdet af en arkivsamling."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das eine Orientierungshilfe zum Aufbau, zur Anordnung und zu den Inhalten einer Archivsammlung enthält."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο παρέχει έναν οδηγό για την οργάνωση, την κατάταξη και τα περιεχόμενα μιας αρχειακής συλλογής."],"en":["Relates a work to a work that provides a guide to the organization, arrangement, and contents of an archival collection. (Deprecated)"],"et":["Seostab teose teosega, mis tutvustab arhiivikogu korrastuspõhimõtteid ja sisu."],"fi":["Liittää teoksen teokseen, joka opastaa arkistokokoelman järjestämisperiaatteisiin ja sisältöön."],"fr":["Met une œuvre en relation avec une œuvre qui fournit un guide de l’organisation, du classement et du contenu d’une collection ou d’un fonds d’archives."],"hu":["Hozzákapcsol egy művet egy műhöz, amely útmutató egy levéltári gyűjtemény szervezetéhez, elrendezéséhez és tartalmához."],"it":["Correla un’opera a un’opera che fornisce una guida all’organizzazione, ordinamento e contenuti di una collezione archivistica."],"lv":["Sasaista darbu ar darbu, kas ir meklēšanas palīglīdzeklis arhīva kolekcijā."],"nl":["Relateert een werk aan een werk dat een gids biedt voor de organisatie, ordening en inhoud van een archiefcollectie."],"no":["Relaterer et verk til et verk som gir veiledning til innholdet i en arkivsamling og hvordan den er organisert."],"vi":["Liên kết tác phẩm với tác phẩm cung cấp chỉ dẫn về tổ chức, sắp xếp, và nội dung của bộ sưu tập lưu trữ."]},"ToolkitLabel":{"ar":"عمل معينات بحث","ca":"obra d’instrument de descripció","da":"hjælpeværktøjsværk","de":"Findmittel (Werk)","el":"εργαλείο έρευνας (έργο)","en":"finding aid work (Deprecated)","es":"guía de búsqueda de (obra)","et":"arhiivinimistu (teos)","fi":"arkistokokoelman hakemisto (teos)","fr":"instrument de recherche (œuvre)","hu":"keresésisegédlet-mű","it":"aiuto alla ricerca opera","lv":"darbs: meklēšanas palīglīdzeklis","nl":"vind-hulpmiddel-werk","no":"veiledning (verk)","vi":"hỗ trợ tìm kiếm (tác phẩm)"},"ToolkitDefinition":{"ar":"عمل يوفر دليلًا إرشاديا لتنظيم مجموعة أرشيفية، وترتيبها، ومحتوياتها.","ca":"Obra que proporciona una guia a l’organització, l’arranjament i els continguts d’una col·lecció arxivística.","da":"Værk, som giver en vejledning til organiseringen, opsætningen og indholdet af en arkivsamling.","de":"Ein Werk, das eine Orientierungshilfe zum Aufbau, zur Anordnung und zu den Inhalten einer Archivsammlung enthält.","el":"Ένα έργο το οποίο παρέχει έναν οδηγό για την οργάνωση, την κατάταξη και τα περιεχόμενα μιας αρχειακής συλλογής.","en":"A work that provides a guide to the organization, arrangement, and contents of an archival collection. (Deprecated)","es":"Una obra que proporciona una guía para la organización, ordenación y contenido de una colección archivística","et":"Teos, mis tutvustab arhiivikogu korrastuspõhimõtteid ja sisu.","fi":"Teos, joka opastaa arkistokokoelman järjestämisperiaatteisiin ja sisältöön.","fr":"Œuvre qui fournit un guide de l’organisation, du classement et du contenu d’une collection ou d’un fonds d’archives.","hu":"Egy mű, amely útmutató egy levéltári gyűjtemény szervezetéhez, elrendezéséhez és tartalmához.","it":"Opera che fornisce una guida all’organizzazione, ordinamento e contenuti di una collezione archivistica.","lv":"Darbs, kas ir meklēšanas palīglīdzeklis arhīva kolekcijā.","nl":"Een werk dat een gids biedt voor de organisatie, ordening en inhoud van een archiefcollectie.","no":"Et verk som gir veiledning til innholdet i en arkivsamling og hvordan den er organisert.","vi":"Tác phẩm cung cấp chỉ dẫn về tổ chức, sắp xếp, và nội dung của bộ sưu tập lưu trữ."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en", "label":"is augmented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/findingAidWork.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
