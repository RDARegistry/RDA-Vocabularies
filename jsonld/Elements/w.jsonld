                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/librettistCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10530", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorCorporateBody.en", "label":"has author corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10478", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistCollectiveAgent.en", "label":"has librettist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10525", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettistCorporateBody.en", "label":"has librettist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10525", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettistCorporateBody.en", "label":"has librettist corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10572","label":{"ar":"له عائلة مؤلفة أوبرالية","ca":"té com a família llibretista","cs":"má libretistu (rodinu)","da":"har familie, som er librettist","de":"hat Librettistin/Librettisten (Familie)","de":"hat Librettistin/Librettisten (Familie)","en":"has librettist family","es":"tiene familia libretista","et":"libretist (perekond)","fi":"libretisti (suku)","fr":"a pour famille librettiste","hu":"librettista családja a következő:","it":"ha come librettista famiglia","lv":"libretists (dzimta/ģimene)","nl":"heeft librettist-familie","no":"har librettist (familie)","tr":"libretto yazarı ailesi ile ilişkilidir","zh-Hans-CN":"有台本作者家族"},"definition":{"ar":["يربط بين عمل وعائلة تكون مؤلفة كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية."],"ca":["Relaciona una obra amb una família que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o una qualsevol altra escènica musical o d’un oratori."],"cs":["Vztahuje dílo k rodině, která je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium."],"da":["Relaterer et værk til en familie, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Familie) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Familie) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium."],"en":["Relates a work to a family who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con una familia que es una autora de las palabras de una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio."],"et":["Seostab teose perekonnaga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor."],"fi":["Liittää teoksen sukuun, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec une famille autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művet egy szerző családhoz, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un'opera a una famiglia autore delle parole di un musical o opera coreografica, come un'opera, balletto, o altra opera per il teatro musicale, o per un oratorio."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai."],"nl":["Relateert een werk aan een familie die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til en famile som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzikal sahne için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة مؤلفة أوبرالية","ca":"família llibretista","cs":"libretista (rodina)","da":"familie, som er librettist","de":"Librettistin/Librettist (Familie)","de":"Librettistin/Librettist (Familie)","en":"librettist family","es":"familia libretista","et":"libretist (perekond)","fi":"libretisti (suku)","fr":"famille librettiste","hu":"librettista család:","it":"librettista famiglia","lv":"libretists (dzimta/ģimene)","nl":"librettist-familie","no":"librettist (familie)","tr":"Opera metni yazar ailesi","zh-Hans-CN":"台本作者家族"},"ToolkitDefinition":{"ar":"عائلة تكون مؤلفة كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.","ca":"Família que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.","cs":"Rodina, která je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium.","da":"Familie, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Eine Verfasserin/Ein Verfasser (Familie) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","de":"Eine Verfasserin/Ein Verfasser (Familie) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","en":"A family who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Una familia que es una autora de las palabras de una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.","et":"Perekond, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.","fi":"Suku, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.","fr":"Famille autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy szerző család, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Famiglia autore delle parole di un musical o opera coreografica, come un'opera, balletto, o altra opera per il teatro musicale, o per un oratorio.","lv":"Dzimta/ģimene, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.","nl":"Een familie die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"En famile som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.","tr":"Opera, bale veya müzik sahnesi için başka bir eser veya oratoryo gibi bir müzikal veya koreografik eserin sözlerinin yazarı olan bir aile.","zh-Hans-CN":"作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个家族"},"note":{"ar":["يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només les paraules de les cançons d’un musical."],"cs":["Autorství textů pouze písní z muzikálu je vyloučeno."],"da":["Forfatter til kun sangteksterne i en musical er ikke omfattet."],"de":["Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.,Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter."],"en":["Authoring of the words of only the songs from a musical is excluded."],"es":["Se excluye ser el autor de solo las canciones de un musical."],"et":["Ei hõlma üksnes muusikali laulusõnade kirjutamist."],"fi":["Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu."],"hu":["Musicaldalok szövegírója nem tartozik ide."],"it":["E' escluso essere autore delle parole delle sole canzoni di un musical."],"lv":["Neietver atsevišķu dziesmu tekstus mūziklos."],"nl":["Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten."],"no":["Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中只是歌曲的词著者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/librettistFamily.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10577", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorFamily.en", "label":"has author family"},{"@id":"http://rdaregistry.info/Elements/w/P10478", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistCollectiveAgent.en", "label":"has librettist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10572", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettistFamily.en", "label":"has librettist family"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10572", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettistFamily.en", "label":"has librettist family"}]},{"@id":"http://rdaregistry.info/Elements/w/P10431","label":{"ar":"له شخص مؤلف أوبرالي","ca":"té com a persona llibretista","cs":"má libretistu (osobu)","da":"har person, som er librettist","de":"hat Librettistin/Librettisten (Person)","de":"hat Librettistin/Librettisten (Person)","en":"has librettist person","es":"tiene persona libretista","et":"libretist (isik)","fi":"libretisti (henkilö)","fr":"a pour personne librettiste","hu":"librettista személye a következő:","it":"ha come librettista persona","lv":"libretists (persona)","nl":"heeft librettist-persoon","no":"har librettist (person)","tr":"libretto yazarı kişisi ile ilişkilidir","zh-Hans-CN":"有台本作者个人"},"definition":{"ar":["يربط بين عمل وشخص يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية."],"ca":["Relaciona una obra amb una persona que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori."],"cs":["Vztahuje dílo k osobě, která je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium."],"da":["Relaterer et værk til en person, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium."],"en":["Relates a work to a person who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con una persona que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio."],"et":["Seostab teose isikuga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor."],"fi":["Liittää teoksen henkilöön, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec une personne autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művet egy szerző személyhez, aki olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un'opera a una persona autore delle parole di un musical o un'opera coreografica, come un'opera, balletto o un'altra opera per il teatro musicale, o per un oratorio."],"lv":["Sasaista darbu ar personu, kura ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai."],"nl":["Relateert een werk aan een persoon die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til en person som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzikal sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan kişiyle ilişkilendirir"],"zh-Hans-CN":["将一种作品与作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个个人关联起来。"]},"ToolkitLabel":{"ar":"شخص مؤلف أوبرالي","ca":"persona llibretista","cs":"libretista (osoba)","da":"person, som er librettist","de":"Librettistin/Librettist (Person)","de":"Librettistin/Librettist (Person)","en":"librettist person","es":"persona libretista","et":"libretist (isik)","fi":"libretisti (henkilö)","fr":"personne librettiste","hu":"librettista személy:","it":"librettista persona","lv":"libretists (persona)","nl":"librettist-persoon","no":"librettist (person)","tr":"Opera metni yazan kişi","zh-Hans-CN":"台本作者个人"},"ToolkitDefinition":{"ar":"شخص يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.","ca":"Persona que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.","cs":"Osoba, která je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium.","da":"Person, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Eine Verfasserin/Ein Verfasser (Person) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","de":"Eine Verfasserin/Ein Verfasser (Person) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","en":"A person who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Una persona que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.","et":"Isik, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.","fi":"Henkilö, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.","fr":"Personne autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy szerző személy, aki olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Persona autore delle parole di un musical o un'opera coreografica, come un'opera, un balletto o un'altra opera per il teatro musicale, o per un oratorio.","lv":"Persona, kura ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.","nl":"Een persoon die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"En person som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.","tr":"Opera, bale veya müzik sahnesi veya oratoryo gibi bir müzikal veya koreografik eserin sözlerinin yazarı olan kişi.","zh-Hans-CN":"作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个个人"},"note":{"ar":["يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només les paraules de les cançons d’un musical."],"cs":["Autorství pouze textů písní z muzikálu je vyloučeno."],"da":["Forfatter til kun sangteksterne i en musical er ikke omfattet."],"de":["Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.,Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter."],"en":["Authoring of the words of only the songs from a musical is excluded."],"es":["Se excluye la autoría de la letra únicamente de las canciones de un musical."],"et":["Ei hõlma üksnes muusikali laulusõnade kirjutamist."],"fi":["Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu."],"hu":["Musicaldalok szövegírója nem tartozik ide."],"it":["E' escluso essere autore delle parole delle sole canzoni di un musical."],"lv":["Neietver atsevišķu dziesmu tekstus mūziklos."],"nl":["Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten."],"no":["Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中只是歌曲的词著者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/librettistPerson.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10436", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorPerson.en", "label":"has author person"},{"@id":"http://rdaregistry.info/Elements/w/P10205", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistAgent.en", "label":"has librettist agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10431", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettistPerson.en", "label":"has librettist person"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10431", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettistPerson.en", "label":"has librettist person"}]},{"@id":"http://rdaregistry.info/Elements/w/P10165","label":{"ar":"له عمل نص أوبرالي","ca":"té com a obra de llibret","cs":"má libreto (dílo)","da":"har librettoværk","de":"hat Libretto (Werk)","de":"has Libretto (Werk)","el":"είναι λιμπρέτο (έργο)","en":"has libretto work","es":"tiene obra de libreto","et":"libreto (teos)","fi":"libretto (teos)","fr":"a pour livret (œuvre)","hu":"librettóműve a következő:","it":"ha libretto opera","lv":"darbs: librets","nl":"heeft librettowerk","no":"har libretto (verk)","tr":"libretto eseri ile ilişkilidir","vi":"là lời nhạc kịch (tác phẩm)","zh-Hans-CN":"有台本作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل نصي يكمل عملاً موسيقيًا أو عملًا راقصًا مثل الأوبرا، أو الباليه، أو أي عمل آخر للمسرح الموسيقي أو لموسيقى دينية."],"ca":["Relaciona una obra amb una obra que és una obra textual que complementa una obra que és una obra musical o coreogràfica com ara una opera, un ballet o qualsevol altra obra escènica musical o un oratori."],"cs":["Vztahuje dílo k dílu, které je textovým dílem, doplňujícím dílo, které je hudebním nebo choreografickým dílem jako je opera, balet nebo jiné dílo pro hudební scénu, nebo oratorium."],"da":["Relaterer et værk til et værk, som er et tekstværk, som komplementerer et værk, som er et musikalsk- eller koreografisk værk, som en opera, ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Musikwerk oder ein choreografisches Werk, wie zum Beispiel eine Oper, ein Ballett oder ein anderes Werk für die Bühne, oder ein Oratorium ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Musikwerk oder ein choreografisches Werk, wie zum Beispiel eine Oper, ein Ballett oder ein anderes Werk für die Bühne, oder ein Oratorium ergänzt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο παρέχει το κείμενο μιας όπερας ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο."],"en":["Relates a work to a work that is a textual work that complements a work that is a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con una obra que es una obra textual que complementa una obra que es una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio, que es complementada por una obra textual."],"et":["Seostab teose tekstteosega, mis täiendab muusikalist või koreograafilist lavateost (nt ooperit, balletti) või oratooriumit."],"fi":["Liittää teoksen teokseen, joka on tekstiteos, joka täydentää teosta, joka on musiikki- tai koreografinen teos, kuten ooppera, baletti tai muu musiikillinen näyttämöteos tai oratorio."],"fr":["Met une œuvre en relation avec une œuvre textuelle qui complète une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művett egy szöveges műhöz, amely kiegészíti egy olyan zene- vagy koreografikus művet, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un’opera a un’opera testuale che completa un’opera musicale o coreografica come un’opera, balletto o altra opera per il teatro musicale, o un oratorio."],"lv":["Sasaista darbu ar darbu, kas ir realizēts kā teksts, kas papildina darbu, kas ir opera vai cits mūzikas darbs skatuvei vai oratorija."],"nl":["Relateert een werk aan een werk dat een tekstwerk is dat een werk complementeert dat een muziek- of choreografisch werk is zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til et verk som er et tekstlig verk som utfyller et verk som er et musikalsk eller koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzik sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eseri tamamlayan metinsel bir eser olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm cung cấp văn bản cho opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio."],"zh-Hans-CN":["将一种作品与补充诸如歌剧、芭蕾或其他舞台音乐作品或清唱剧之类的作为一种音乐或编舞作品的一种作品的作为一种文字作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل نص أوبرالي","ca":"obra de llibret","cs":"libreto (dílo)","da":"librettoværk","de":"Libretto (Werk)","de":"Libretto (Werk)","el":"λιμπρέτο (έργο)","en":"libretto work","es":"obra de libreto","et":"libreto (teos)","fi":"libretto (teos)","fr":"livret (œuvre)","hu":"librettómű:","it":"libretto opera","lv":"darbs: librets","nl":"librettowerk","no":"libretto (verk)","tr":"opera metni çalışması","vi":"lời nhạc kịch (tác phẩm)","zh-Hans-CN":"台本作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل نصي يكمل عملاً موسيقيًا، أو عملًا راقصًا مثل الأوبرا، أو الباليه، أو أي عمل آخر للمسرح الموسيقي أو لموسيقى دينية.","ca":"Obra que és una obra textual que complementa una obra que és una obra musical o coreogràfica com ara una opera, un ballet o qualsevol altra obra escènica musical o un oratori.","cs":"Dílo, které je textovým dílem, doplňujícím dílo, které je hudebním nebo choreografickým dílem jako je opera, balet nebo jiné dílo pro hudební scénu, nebo oratorium.","da":"Relaterer et værk til et værk, som er et tekstværk, som komplementerer et værk, som er et musikalsk- eller koreografisk værk, som en opera, ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Ein Werk, das ein Musikwerk oder ein choreografisches Werk, wie zum Beispiel eine Oper, ein Ballett oder ein anderes Werk für die Bühne, oder ein Oratorium ergänzt.","de":"Ein Werk, das ein Musikwerk oder ein choreografisches Werk, wie zum Beispiel eine Oper, ein Ballett oder ein anderes Werk für die Bühne, oder ein Oratorium ergänzt.","el":"Ένα έργο το οποίο παρέχει το κείμενο μιας όπερας ή άλλο έργο για τη μουσική σκηνή ή ένα ορατόριο.","en":"A work that is a textual work that complements a work that is a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Una obra que es una obra textual que complementa una obra que es una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio, que es complementada por una obra textual.","et":"Tekstteos, mis täiendab muusikalist või koreograafilist lavateost (nt ooperit, balletti) või oratooriumit.","fi":"Teos, joka joka on tekstiteos, joka täydentää teosta, joka on musiikki- tai koreografinen teos, kuten ooppera, baletti tai muu musiikillinen näyttämöteos tai oratorio.","fr":"Œuvre textuelle qui complète une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy szöveges mű, amely kiegészíti egy olyan zene- vagy koreografikus művet, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Opera testuale che completa un’opera musicale o coreografica come un’opera, balletto o altra opera per il teatro musicale, o un oratorio.","lv":"Darbs, kas ir realizēts kā teksts, kas papildina darbu, kas ir opera vai cits mūzikas darbs skatuvei vai oratorija.","nl":"Een werk dat een tekstwerk is dat een werk complementeert dat een muziek- of choreografisch werk is zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"Et verk som er et tekstlig verk som utfyller et verk som er et musikalsk eller koreografisk verk som en opera, en ballett eller et annet verk for en musikalsk scene, eller et oratorium.","tr":"Opera, bale veya müzikal sahne için başka bir eser veya oratoryo gibi müzikal veya koreografik bir çalışmayı tamamlayan metinsel bir eser olan çalışma.","vi":"Tác phẩm cung cấp văn bản cho opera hoặc tác phẩm khác cho sân khấu âm nhạc, hoặc oratorio.","zh-Hans-CN":"补充诸如歌剧、芭蕾或其他舞台音乐作品或清唱剧之类的作为一种音乐或编舞作品的一种作品的作为一种文字作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10371", "lexicalAlias":"http://rdaregistry.info/Elements/w/textWork.en", "label":"has text work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/librettoWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10165", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettoWork.en", "label":"has libretto work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10165", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettoWork.en", "label":"has libretto work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10204","label":{"ar":"له وكيل مؤلف أغاني","ca":"té com a agent lletrista","cs":"má textaře (agenta)","da":"har agent, som er tekstforfatter","de":"hat Textdichterin/Textdichter (Akteur)","de":"hat Textdichterin/Textdichter (Akteur)","el":"έχει στιχουργό","en":"has lyricist agent","es":"tiene agente letrista","et":"sõnade autor (tegija)","fi":"sanoittaja (toimija)","fr":"a pour agent parolier","hu":"dalszövegíró ágense a következő:","it":"ha come paroliere agente","lv":"dziesmas teksta autors (aģents)","nl":"heeft liedtekstschrijver-actor","no":"har sangtekstforfatter (agent)","tr":"söz yazarı temsilcisi ile ilişkilidir","vi":"có nhà thơ trữ tình","zh-Hans-CN":"有作词者行为者"},"definition":{"ar":["يربط بين عمل ووكيل يكون مؤلف كلمات أغنية شعبية، بما في ذلك أغنية من مسرحية موسيقية."],"ca":["Relaciona una obra amb un agent que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical."],"cs":["Vztahuje dílo k agentovi, který je autorem textu populární písně včetně písně z muzikálu."],"da":["Relaterer et værk til en agent, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical."],"el":["Συνδέει ένα έργο με έναν συγγραφέα των στίχων ενός δημοφιλούς τραγουδιού, περιλαμβανομένων του τραγουδιού ή των τραγουδιών ενός μιούζικαλ."],"en":["Relates a work to an agent who is an author of the words of a popular song, including a song from a musical."],"es":["Relaciona una obra con un agente que es autor de la letra de una canción popular, incluida una canción de un musical."],"et":["Seostab teose tegijaga, kes on levilaulu (k.a laul muusikalist) sõnade autor."],"fi":["Liittää teoksen toimijaan, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec un agent auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is."],"it":["Correla un’opera a un agente autore delle parole di una canzone pop, inclusa una canzone di un musical."],"lv":["Sasaista darbu ar dziesmas vārdu autoru, ieskaitot dziesmas no mūzikla."],"nl":["Relateert een werk aan een actor die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical."],"no":["Relaterer et verk til en agent som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal."],"tr":["Bir eseri, bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerinin yazarı olan bir temsilciyile ilişkilendirir."],"vi":["Liên kết tác phẩm với tác giả của lời của bài hát bình dân, bao gồm cả bài hát hoặc các bài hát từ âm nhạc."],"zh-Hans-CN":["将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مؤلف أغاني","ca":"agent lletrista","cs":"textař (agent)","da":"agent, som er tekstforfatter","de":"Textdichterin/Textdichter (Akteur)","de":"Textdichterin/Textdichter (Akteur)","el":"στιχουργός","en":"lyricist agent","es":"agente letrista","et":"sõnade autor (tegija)","fi":"sanoittaja (toimija)","fr":"agent parolier","hu":"dalszövegíró ágens:","it":"paroliere agente","lv":"dziesmas teksta autors (aģents)","nl":"liedtekstschrijver-actor","no":"sangtekstforfatter (agent)","tr":"söz yazarı temsilcisi","vi":"nhà thơ trữ tình","zh-Hans-CN":"作词者行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤلف كلمات أغنية شعبية، بما في ذلك أغنية من مسرحية موسيقية.","ca":"Agent que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.","cs":"Agent, který je autorem textu populární písně včetně písně z muzikálu.","da":"Agent, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.","de":"Eine Verfasserin/Ein Verfasser (Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.","de":"Eine Verfasserin/Ein Verfasser (Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.","el":"Ένας συγγραφέας των στίχων ενός δημοφιλούς τραγουδιού, περιλαμβανομένων του τραγουδιού ή των τραγουδιών ενός μιούζικαλ.","en":"An agent who is an author of the words of a popular song, including a song from a musical.","es":"Un agente que es autor de la letra de una canción popular, incluida una canción de un musical.","et":"Tegija, kes on levilaulu (k.a laul muusikalist) sõnade autor.","fi":"Toimija, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.","fr":"Agent auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.","hu":"Egy ágens, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.","it":"Agente autore delle parole di una canzone pop, inclusa una canzone di un musical.","lv":"Dziesmas vārdu autors, ieskaitot dziesmas no mūzikla.","nl":"Een actor die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.","no":"En agent som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.","tr":"Bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerinin yazarı olan bir temsilci.","vi":"Tác giả của lời của bài hát bình dân, bao gồm cả bài hát hoặc các bài hát từ âm nhạc.","zh-Hans-CN":"作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个行为者"},"note":{"ar":["يُستبعد تأليف الحوار فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només el diàleg d’un musical."],"cs":["Autorství pouze dialogů z muzikálu je vyloučeno."],"da":["Forfatter til kun dialogen i en musical er ikke omfattet."],"de":["Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.,Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter."],"el":["Δεν περιλαμβάνεται η συγγραφή μόνο του διαλόγου ενός musical."],"en":["Authoring of only the dialogue from a musical is excluded."],"es":["Se excluye la autoría únicamente del diálogo de un musical."],"et":["Ei hõlma üksnes muusikali dialoogide kirjutamist."],"fi":["Ei kata pelkän musikaalin dialogin kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu."],"hu":["Musical párbeszédeinek szerzősége nem tartozik ide."],"it":["E' esclusa la creazione dei soli dialoghi in un musical."],"lv":["Neietver mūzikla dialogus."],"nl":["Het schrijven van alleen de dialogen uit een musical is uitgesloten."],"no":["Det å bare skrive dialogen fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca diyaloglarının yazılması hariçtir."],"vi":["Tác giả của chỉ phần hội thoại từ âm nhạc, không được bao gồm."],"zh-Hans-CN":["不包括音乐剧中只是对话的著者。"]},"altLabel":{"ar":["مؤلف أغاني"],"ca":["lletrista"],"cs":["textař"],"da":["tekstforfatter"],"de":["Textdichter,Textdichter"],"en":["lyricist"],"es":["letrista"],"et":["sõnade autor"],"fi":["sanoittaja"],"fr":["parolier"],"hu":["dalszövegíró:"],"it":["paroliere"],"tr":["söz yazarı"],"zh-Hans-CN":["作词者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10061", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorAgent.en", "label":"has author agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/lyricistAgent.en","See Also":[{"@id":"http://rdaregistry.info/Elements/w/P10205", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistAgent.en", "label":"has librettist agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10477", "lexicalAlias":"http://rdaregistry.info/Elements/w/lyricistCollectiveAgent.en", "label":"has lyricist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10430", "lexicalAlias":"http://rdaregistry.info/Elements/w/lyricistPerson.en", "label":"has lyricist person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10204", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/lyricistAgent.en", "label":"has lyricist agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10204", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/lyricistAgent.en", "label":"has lyricist agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10477","label":{"ar":"له وكيل جماعي مؤلف أغاني","ca":"té com a agent col·lectiu lletrista","cs":"má textaře (kolektivního agenta)","da":"har kollektiv agent, som er tekstforfatter","de":"hat Textdichterin/Textdichter (Gemeinschaftlicher Akteur)","de":"hat Textdichterin/Textdichter (Gemeinschaftlicher Akteur)","en":"has lyricist collective agent","es":"tiene agente colectivo letrista","et":"sõnade autor (kollektiiv)","fi":"sanoittaja (yhteistoimija)","fr":"a pour agent collectif parolier","hu":"dalszövegíró kollektív ágense a következő:","it":"ha come paroliere agente collettivo","lv":"dziesmas teksta autors (grupa)","nl":"heeft liedtekstschrijver-collectieve actor","no":"har sangtekstforfatter (kollektiv agent)","tr":"söz yazarı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有作词者集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي يكون مؤلف كلمات أغنية شعبية، بما في ذلك أغنية من مسرحية موسيقية."],"ca":["Relaciona una obra amb un agent col·lectiu que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je autorem textu populární písně včetně písně z muzikálu."],"da":["Relaterer et værk til en kollektiv agent, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical."],"en":["Relates a work to a collective agent who is an author of the words of a popular song, including a song from a musical."],"es":["Relaciona una obra con un agente colectivo que es autor de la letra de una canción popular, incluida una canción de un musical."],"et":["Seostab teose kollektiiviga, kes on levilaulu (k.a laul muusikalist) sõnade autor."],"fi":["Liittää teoksen yhteistoimijaan, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec un agent collectif auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale."],"hu":["Hozzákapcsol egy művet egy kollektív ágenshez, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is."],"it":["Correla un'opera a un agente collettivo autore delle parole di una canzone pop, inclusa una canzone di un musical. "],"lv":["Sasaista darbu ar grupu, kas ir dziesmas vārdu autors, ieskaitot dziesmas no mūzikla."],"nl":["Relateert een werk aan een collectieve actor die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical."],"no":["Relaterer et verk til en kollektiv agent som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal."],"tr":["Bir eseri, bir müzikalin şarkısı da dahil popüler bir şarkının sözlerinin yazarı olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مؤلف أغاني","ca":"agent col·lectiu lletrista","cs":"textař (kolektivní agent)","da":"kollektiv agent, som er tekstforfatter","de":"Textdichterin/Textdichter (Gemeinschaftlicher Akteur)","de":"Textdichterin/Textdichter (Gemeinschaftlicher Akteur)","en":"lyricist collective agent","es":"agente colectivo letrista","et":"sõnade autor (kollektiiv)","fi":"sanoittaja (yhteistoimija)","fr":"agent collectif parolier","hu":"dalszövegíró kollektív ágens:","it":"paroliere agente collettivo","lv":"dziesmas teksta autors (grupa)","nl":"liedtekstschrijver-collectieve actor","no":"sangtekstforfatter (kollektiv agent)","tr":"Söz yazarı kolektif temsilci","zh-Hans-CN":"作词者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤلف كلمات أغنية شعبية، بما في ذلك أغنية من مسرحية موسيقية.","ca":"Agent col·lectiu que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.","cs":"Kolektivní agent, který je autorem textu populární písně včetně písně z muzikálu.","da":"Kollektiv agent, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.","de":"Eine Verfasserin/Ein Verfasser (Gemeinschaftlicher Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.","de":"Eine Verfasserin/Ein Verfasser (Gemeinschaftlicher Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.","en":"A collective agent who is an author of the words of a popular song, including a song from a musical.","es":"Un agente colectivo que es autor de la letra de una canción popular, incluida una canción de un musical.","et":"Kollektiiv, kes on levilaulu (k.a laul muusikalist) sõnade autor.","fi":"Yhteistoimija, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.","fr":"Agent collectif auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.","hu":"Egy kollektív ágens, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.","it":"Agente collettivo autore delle parole di una canzone pop, inclusa una canzone di un musical. ","lv":"Grupa, kas ir dziesmas vārdu autors, ieskaitot dziesmas no mūzikla.","nl":"Een collectieve actor die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.","no":"En kollektiv agent som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.","tr":"Müzikal bir şarkı da içeren popüler bir şarkının sözlerinin yazarı olan bir kolektif temsilci","zh-Hans-CN":"作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个集体行为者"},"note":{"ar":["يُستبعد تأليف الحوار فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només el diàleg d’un musical."],"cs":["Autorství pouze dialogůz muzikálu je vyloučeno."],"da":["Forfatter til kun dialogen i en musical er ikke omfattet."],"de":["Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.,Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter."],"en":["Authoring of only the dialogue from a musical is excluded."],"es":["Se excluye la autoría únicamente del diálogo de un musical."],"et":["Ei hõlma üksnes muusikali dialoogide kirjutamist."],"fi":["Ei kata pelkän musikaalin dialogin kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu."],"hu":["Musical párbeszédeinek szerzősége nem tartozik ide."],"it":["E' escluso essere autore dei soli dialoghi di un musical."