                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/textForWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10369", "lexicalAlias":"http://rdaregistry.info/Elements/w/lyricsForWork.en", "label":"is lyrics for work"},{"@id":"http://rdaregistry.info/Elements/w/P10105", "lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayForWork.en", "label":"is screenplay for work"},{"@id":"http://rdaregistry.info/Elements/w/P10030", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettoForWork.en", "label":"is libretto for work"},{"@id":"http://rdaregistry.info/Elements/w/P10176", "lexicalAlias":"http://rdaregistry.info/Elements/w/scriptForRadioProgramWork.en", "label":"is script for radio program work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10372", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/textForWork.en", "label":"is text for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10372", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/textForWork.en", "label":"is text for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10371","label":{"ar":"له عمل نصي","ca":"té com a obra de text","cs":"má text (dílo)","da":"har tekstværk","de":"hat Text (Werk)","de":"hat Text (Werk)","en":"has text work","es":"tiene texto de obra","et":"tekst (teos)","fi":"tekstiteos","fr":"a pour texte (œuvre)","hu":"szöveges műve a következő:","it":"ha come testo opera","lv":"darbs: teksts","nl":"heeft tekstwerk","no":"har tekstlig verk","tr":"metin eseri ile ilişkilidir","zh-Hans-CN":"有文本作品"},"ToolkitLabel":{"ar":"عمل نصي","ca":"obra de text","cs":"text (dílo)","da":"tekstværk","de":"Text (Werk)","de":"Text (Werk)","en":"text work","es":"texto de obra","et":"tekst (teos)","fi":"tekstiteos","fr":"texte (œuvre)","hu":"szövegmű","it":"testo opera","lv":"darbs: teksts","nl":"tekstwerk","no":"tekstlig verk","tr":"eser metni","zh-Hans-CN":"文本作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل نصي يكمل عملا."],"ca":["Relaciona una obra amb una obra que és una obra textual que complementa una obra."],"cs":["Vztahuje dílo k dílu, které je textovým dílem, doplňujícím dílo."],"da":["Relaterer et værk til et værk, som er et tekstværk, som komplementerer et værk."],"de":["Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Werk ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das ein Werk ergänzt."],"en":["Relates a work to a work that is a textual work that complements a work."],"es":["Relaciona una obra con una obra que es una obra textual que complementa una obra."],"et":["Seostab teose teost täiendava tekstteosega."],"fi":["Liittää teoksen teokseen, joka on tekstiteos, joka täydentää teosta."],"fr":["Met une œuvre en relation avec une œuvre textuelle qui complète une œuvre."],"hu":["Hozzákapcsol egy művet egy szöveges műhöz, amelyet egy mű egészít ki."],"it":["Correla un'opera a un'opera, che è un'opera testuale che completa un'opera."],"lv":["Sasaista darbu ar darbu, kas ir realizēts kā teksts, kas papildina citu darbu."],"nl":["Relateert een werk aan een werk dat een tekstwerk is dat een werk complementeert."],"no":["Relaterer et verk til et verk som er et tekstlig verk som utfyller et verk."],"tr":["Bir eseri, bir eseri tamamlayan metinsel bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一种文字作品并补充一种作品的一种作品关联起来。"]},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل نصي يكمل عملا.","ca":"Obra que és una obra textual que complementa una obra.","cs":"Dílo, které je textovým dílem, doplňujícím dílo.","da":"Værk, som er et tekstværk, som komplementerer et værk.","de":"Ein textliches Werk, das ein Werk ergänzt.","de":"Ein textliches Werk, das ein Werk ergänzt.","en":"A work that is a textual work that complements a work.","es":"Una obra que es una obra textual que complementa una obra.","et":"Teost täiendav tekstteos.","fi":"Teos, joka on tekstiteos, joka täydentää teosta.","fr":"Œuvre textuelle qui complète une œuvre.","hu":"Egy szöveges mű. Amelyet egy mű egészít ki.","it":"Opera testuale che completa un'opera.","lv":"Darbs, kas ir realizēts kā teksts, kas papildina citu darbu.","nl":"Een werk dat een tekstwerk is dat een werk complementeert.","no":"Et verk som er et tekstlig verk som utfyller et verk.","tr":"Bir eseri tamamlayan metinsel bir eser.","zh-Hans-CN":"作为一种文字作品并补充一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/textWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10159", "lexicalAlias":"http://rdaregistry.info/Elements/w/screenplayWork.en", "label":"has screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/P10165", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettoWork.en", "label":"has libretto work"},{"@id":"http://rdaregistry.info/Elements/w/P10370", "lexicalAlias":"http://rdaregistry.info/Elements/w/lyricsWork.en", "label":"has lyrics work"},{"@id":"http://rdaregistry.info/Elements/w/P10162", "lexicalAlias":"http://rdaregistry.info/Elements/w/radioScriptWork.en", "label":"has radio script work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10371", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/textWork.en", "label":"has text work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10371", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/textWork.en", "label":"has text work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10335","label":{"ar":"له رقم كشاف موضوعي","ca":"té com a número d’índex temàtic","cs":"má číslo tematického katalogu","da":"har tematisk indeksnummer","de":"hat Werkverzeichnisnummer","de":"hat Werkverzeichnisnummer","en":"has thematic index number","es":"tiene número de índice temático","et":"temaatilise kataloogi number","fi":"temaattisen teosluettelon numero","fr":"a pour numéro de catalogue thématique","hu":"tematikus indexszáma a következő:","it":"ha come numero di catalogo tematico","lv":"skaņdarbu rādītāja numurs","nl":"heeft thematische index-nummer","no":"har tematisk indeksnummer","tr":"tematik dizin numarası ile ilişkilidir","zh-Hans-CN":"有主题索引号"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن تعيين رقمي لعمل موسيقي محدَد من قائمة أعمال ملحن، عادة مرتبة ترتيبا زمنيا أو حسب الفئة، مع تحديد الموضوع لكل تلحين أو لكل قسم من المقطوعات الكبيرة."],"ca":["Relaciona una obra amb un nomen que és una designació numèrica d’una obra musical que s’assigna a partir d’una llista d’obres d’un compositor, normalment ordenada per ordre cronològic o per categories, amb el tema donat a cada composició o cada secció de composicions llargues."],"cs":["Vztahuje dílo k nomen, které je číselným označením hudebního díla přiřazeným v rámci tematického katalogu děl skladatele, obvykle uspořádaného v chronologickém pořadí nebo podle kategorií, kde každá skladba nebo část delší skladby má vlastní číslo."],"da":["Relaterer et værk til en numerisk betegnelse, tildelt udfra en liste over en komponists værker, sædvanligvis arrangeret i kronologisk rækkefølge eller efter kategorier, med givet tema for hver komposition eller for hver del af store kompositioner."],"de":["Setzt ein Werk in Beziehung zu einer numerischen Bezeichnung eines Musikwerks aus einem Werkverzeichnis einer Komponistin/eines Komponisten, das in einer chronologischen Reihenfolge oder nach Kategorien angeordnet ist. Zusätzlich können darin Notenzitate in Form von Incipits oder thematischem Material für jede Komposition oder für jede Passage längerer Kompositionen aufgeführt sein.,Setzt ein Werk in Beziehung zu einer numerischen Bezeichnung eines Musikwerks aus einem Werkverzeichnis einer Komponistin/eines Komponisten, das in einer chronologischen Reihenfolge oder nach Kategorien angeordnet ist. Zusätzlich können darin Notenzitate in Form von Incipits oder thematischem Material für jede Komposition oder für jede Passage längerer Kompositionen aufgeführt sein."],"en":["Relates a work to a nomen that is a numeric designation of musical work that is assigned from a list of works of a composer, usually arranged in chronological order or by categories, with the theme given for each composition or for each section of large compositions."],"es":["Relaciona una obra con un nomen que es una designación numérica de una obra musical que se asigna a partir de una lista de obras de un compositor, generalmente ordenadas en orden cronológico o por categorías, con el tema dado para cada composición o para cada sección de grandes composiciones."],"et":["Seostab teose muusikateose numbrilise tähistusega, mis on võetud helilooja teoste nimestikust. Nimestik on tavaliselt korrastatud kronoloogiliselt või žanrite kaupa ja sisaldab iga heliteose või suuremate teoste puhul iga osa teemat."],"fi":["Liittää teoksen nomeniin, joka on musiikkiteoksen numerointi, joka on annettu säveltäjän teosluettelossa, joka on yleensä järjestetty aikajärjestykseen tai luokittain ja johon sisältyy teema jokaisesta sävellyksestä tai suurten sävellysten jokaisesta osasta."],"fr":["Met une œuvre en relation avec un nomen qui est une désignation numérique d’une œuvre musicale attribuée à partir d’une liste des œuvres d’un compositeur dans laquelle celles-ci sont ordinairement classées par ordre chronologique ou par catégories, avec le thème de chaque composition ou de chaque section d’une composition dans le cas des compositions d’envergure."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy zenemű számjelzéséhez, amelyet egy zeneszerző műveinek a komponálás kronológiai sorrendje vagy kategóriák szerint rendezett jegyzékéből rendeltek hozzá, amely minden zeneművet vagy a nagyobb zeneművek egyes szakaszait témával látja el."],"it":["Correla un’opera a una designazione numerica di opera musicale assegnata da un elenco di opere di un compositore di solito organizzato in ordine cronologico o per categorie, con il tema assegnato a ogni composizione o a ogni sezione di grandi composizioni."],"lv":["Sasaista darbu ar nomenu, kas ir muzikas darba numerācijas apzīmējums, kuru piešķir saskaņā ar komponista darbu sarakstu, kas parasti ir sakārtots kategorijās vai hronoloģiskā secībā, katrai kompozīcijai vai lielas kompozīcijas katrai daļai piešķirot tematisko apzīmējumu."],"nl":["Relateert een werk aan een nomen dat is een numerieke aanduiding van muziekwerk dat toegekend is uit een lijst van werken van een componist, meestal gerangschikt in chronologische volgorde of per categorie, met het thema gegeven voor elke compositie of voor elke sectie van grote composities."],"no":["Relaterer et verk til en numerisk betegnelse på musikalsk verk som er tildelt fra en fortegnelse over en komponists verk, vanligvis ført opp i kronologisk orden eller etter kategorier, med temaet angitt for hver komposisjon eller hver seksjon av større komposisjoner."],"tr":["Bir eseri, bir bestecinin eserlerinden oluşan bir listeden belirlenen, genellikle kronolojik sıraya veya kategorilere göre düzenlenmiş, her bir beste veya büyük bestelerin her bir bölümü için temanın verildiği müzik eserinin sayısal bir belirteci olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种作品与根据作曲者的作品列表分配、通常按年代顺序或类别排列、并有每个谱曲或更大谱曲每个部分的主题的音乐作品的数字标识关联起来。"]},"ToolkitLabel":{"ar":"رقم كشاف موضوعي","ca":"número d’índex temàtic","cs":"číslo tematického katalogu","da":"tematisk indeksnummer","de":"Werkverzeichnisnummer","de":"Werkverzeichnisnummer","en":"thematic index number","es":"número de índice temático","et":"temaatilise kataloogi number","fi":"temaattisen teosluettelon numero","fr":"numéro de catalogue thématique","hu":"tematikus indexszáma:","it":"numero di catalogo tematico","lv":"skaņdarbu rādītāja numurs","nl":"thematische index-nummer","no":"tematisk indeksnummer","tr":"tematik dizin numarası","zh-Hans-CN":"主题索引号"},"ToolkitDefinition":{"ar":"تسمية عبارة عن تعيين رقمي لعمل موسيقي محدَد من قائمة أعمال ملحن، عادة مرتبة ترتيبا زمنيا أو حسب الفئة، مع تحديد الموضوع لكل تلحين أو لكل قسم من المقطوعات الكبيرة.","ca":"Nomen que és una designació numèrica d’una obra musical que s’assigna a partir d’una llista d’obres d’un compositor, normalment ordenada per ordre cronològic o per categories, amb el tema donat a cada composició o cada secció de composicions llargues.","cs":"Nomen, které je číselným označením hudebního díla přiřazeným v rámci tematického katalogu děl skladatele, obvykle uspořádaného v chronologickém pořadí nebo podle kategorií, kde každá skladba nebo část delší skladby má vlastní číslo.","da":"Numerisk betegnelse, tildelt udfra en liste over en komponists værker, sædvanligvis arrangeret i kronologisk rækkefølge eller efter kategorier, med givet tema for hver komposition eller for hver del af store kompositioner.","de":"Eine numerische Bezeichnung eines Musikwerks aus einem Werkverzeichnis einer Komponistin/eines Komponisten, das in einer chronologischen Reihenfolge oder nach Kategorien angeordnet ist. Zusätzlich können darin Notenzitate in Form von Incipits oder thematischem Material für jede Komposition oder für jede Passage längerer Kompositionen aufgeführt sein.","de":"Eine numerische Bezeichnung eines Musikwerks aus einem Werkverzeichnis einer Komponistin/eines Komponisten, das in einer chronologischen Reihenfolge oder nach Kategorien angeordnet ist. Zusätzlich können darin Notenzitate in Form von Incipits oder thematischem Material für jede Komposition oder für jede Passage längerer Kompositionen aufgeführt sein.","en":"A nomen that is a numeric designation of musical work that is assigned from a list of works of a composer, usually arranged in chronological order or by categories, with the theme given for each composition or for each section of large compositions.","es":"Un nomen que es una designación numérica de una obra musical que se asigna a partir de una lista de obras de un compositor, generalmente ordenadas en orden cronológico o por categorías, con el tema dado para cada composición o para cada sección de grandes composiciones.","et":"Muusikateose numbriline tähistus, mis on võetud helilooja teoste nimestikust. Nimestik on tavaliselt korrastatud kronoloogiliselt või žanrite kaupa ja sisaldab iga heliteose või suuremate teoste puhul iga osa teemat.","fi":"Nomen, joka on musiikkiteoksen numerointi, joka on annettu säveltäjän teosluettelossa, joka on yleensä järjestetty aikajärjestykseen tai luokittain ja johon sisältyy teema jokaisesta sävellyksestä tai suurten sävellysten jokaisesta osasta.","fr":"Nomen qui est une désignation numérique d’une œuvre musicale attribuée à partir d’une liste des œuvres d’un compositeur dans laquelle celles-ci sont ordinairement classées par ordre chronologique ou par catégories, avec le thème de chaque composition ou de chaque section d’une composition dans le cas des compositions d’envergure.","hu":"Egy nomen, egy zenemű számjelzése, amelyet egy zeneszerző műveinek a komponálás kronológiai sorrendje vagy kategóriák szerint rendezett jegyzékéből rendeltek hozzá, amely minden zeneművet vagy a nagyobb zeneművek egyes szakaszait témával látja el.","it":"Designazione numerica di opera musicale assegnata da un elenco di opere di un compositore di solito organizzato in ordine cronologico o per categorie, con il tema assegnato a ogni composizione o a ogni sezione di grandi composizioni.","lv":"Muzikas darba numerācijas apzīmējums, kuru piešķir saskaņā ar komponista darbu sarakstu, kas parasti ir sakārtots kategorijās vai hronoloģiskā secībā, katrai kompozīcijai vai lielas kompozīcijas katrai daļai piešķirot tematisko apzīmējumu.","nl":"Een nomen dat is een numerieke aanduiding van muziekwerk dat toegekend is uit een lijst van werken van een componist, meestal gerangschikt in chronologische volgorde of per categorie, met het thema gegeven voor elke compositie of voor elke sectie van grote composities.","no":"En numerisk betegnelse på musikalsk verk som er tildelt fra en fortegnelse over en komponists verk, vanligvis ført opp i kronologisk orden eller etter kategorier, med temaet angitt for hver komposisjon eller hver seksjon av større komposisjoner.","tr":"Bir bestecinin, genellikle kronolojik sıraya veya kategorilere göre düzenlenmiş, her bir beste veya büyük bestelerin her bir bölümü için temanın verildiği bir eser listesinden atanan müzik eserinin sayısal bir tanımı olan isim.","zh-Hans-CN":"根据作曲者的作品列表分配、通常按年代顺序或类别排列、并有每个谱曲或更大谱曲每个部分的主题的音乐作品的数字标识"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/thematicIndexNumber.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10079", "lexicalAlias":"http://rdaregistry.info/Elements/w/numericDesignationOfMusicalWork.en", "label":"has numeric designation of musical work"}],"instructionNumber":"6.16.1.3.3","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10335", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/thematicIndexNumber.en", "label":"has thematic index number"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10335", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/thematicIndexNumber.en", "label":"has thematic index number"}]},{"@id":"http://rdaregistry.info/Elements/w/P10017","label":{"ar":"له سلطة سن القوانين","ca":"té com a govern promulgador","cs":"má vládu vydávající vládní nařízení (atd.)","da":"har udøvende jurisdiktion","de":"Normerlassende Gebietskörperschaft","de":"Normerlassende Gebietskörperschaft","el":"έχει θεσπισμένη δικαιοδοσία","en":"has enacting government","es":"tiene gobierno promulgante","et":"kehtestav võimkond","fi":"säätävä hallintoelin","fr":"a pour gouvernement promulgateur","hu":"törvényalkotási irányító szerve a következő:","it":"ha come giurisdizione emanante","lv":"ieviesējjurisdikcija","nl":"heeft vaststellende regering","no":"har vedtakende jurisdiksjon","tr":"yasa çıkaran hükümet ile ilişkilidir","vi":"có thẩm quyền thực thi pháp lý","zh-Hans-CN":"有颁布政府"},"definition":{"ar":["يربط بين عمل وهيئة عبارة عن حكومة تسن عملا عبارة عن قانون، أو لائحة، أو دستور، أو حكم قضائي، أو تشريع آخر."],"ca":["Relaciona una obra amb una entitat corporativa que és un govern que promulga una obra que és una llei, un reglament, una constitució, una regla de funcionament d’un tribunal o qualsevol altra legislació."],"cs":["Vztahuje dílo ke korporaci, která je vládou, vydávající dílo, které je zákonem, nařízením, ústavou, soudním předpisem nebo jinou legislativou."],"da":["Relaterer et værk til en korporation, som er en regering, som vedtager et værk, der er en lov, forordning, forfatning, retsplejeregel eller anden lovgivning."],"de":["Setzt ein Werk in Beziehung zu einer Regierung (Körperschaft), die ein Werk erlässt, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt.,Setzt ein Werk in Beziehung zu einer Regierung (Körperschaft), die ein Werk erlässt, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt."],"el":["Συνδέει ένα έργο με μια δικαιοδοσία, που θεσπίζει έναν νόμο, κανονισμό, σύνταγμα, κανόνα δικαστηρίου κ.λπ."],"en":["Relates a work to a corporate body who is a government enacting a work that is a law, regulation, constitution, court rule, or other legislation."],"es":["Relaciona una obra con un organismo corporativo que es gobierno que promulga una obra que es una ley, regulación, constitución, norma judicial, u otra legislación."],"et":["Seostab teose asutusega, kes on seadust, määrust, konstitutsiooni, menetluseeskirja või muud õigusaktina loodud teost kehtestav valitsus."],"fi":["Liittää teoksen yhteisöön, joka on teoksen, joka on laki, asetus, perustuslaki, tuomioistuinta koskeva sääntö tai muu säädös, säätävä hallintoelin."],"fr":["Met une œuvre en relation avec une collectivité qui constitue un gouvernement promulguant une œuvre qui consiste en une loi, un règlement, une constitution, une règle de pratique de tribunal ou une autre mesure législative."],"hu":["Hozzákapcsol egy művet egy testülethez, amely egy irányító szerv, amely kiad egy művet, ami egy törvény, rendelet, alkotmány, törvényszéki szabályzat vagy egyéb jogszabály."],"it":["Correla un’opera a un ente che è un governo che emana un’opera che è una legge, regolamento, costituzione, regolamento della corte o altra legislazione."],"lv":["Sasaista darbu ar institūciju, kas ir valsts pārvaldes iestāde un ir tiesīga ieviest likumus, noteikumus, konstitūciju, tiesas nolēmumus vai citus tiesību aktus."],"nl":["Relateert een werk aan een corporatie die een regering is die een werk vaststelt dat een wet, regeling, grondwet, rechterlijke uitspraak of andere wetgeving is."],"no":["Relaterer et verk til en korporasjon som er en offentlig myndighet som vedtar et verk som er en lov, vedtekt, grunnlov, rettergangsregel eller annen lovgiving."],"tr":["Bir eseri, kanun, yönetmelik, anayasa, mahkeme kuralı veya diğer mevzuat olan bir eseri yürürlüğe koyan hükümet olan tüzel kişi ile ilişkilendirir."],"vi":["Liên kết tác phẩm với khu vực pháp quyền ban hành luật, quyết định, hiến pháp, quy tắc toà án, v.v..."],"zh-Hans-CN":["将一种作品与作为一个政府颁布作为法律、法规、宪法、法院规则或其他立法的一种作品的一个团体关联起来。"]},"ToolkitLabel":{"ar":"سن الولاية القضائية","ca":"govern promulgador","cs":"vláda vydávající vládní nařízení (atd.)","da":"udøvende jurisdiktion","de":"Normerlassende Gebietskörperschaft von","de":"Provisorische Regierung","el":"θεσπισμένη δικαιοδοσία","en":"enacting government","es":"gobierno promulgante","et":"kehtestav võimkond","fi":"säätävä hallintoelin","fr":"gouvernement promulgateur","hu":"törvényalkotási irányító szerve a következő:","it":"giurisdizione emanante","lv":"ieviesējjurisdikcija","nl":"vaststellende regering","no":"vedtakende jurisdiksjon","tr":"yargı yetkisini yürürlüğe koyma","vi":"thẩm quyền thực thi pháp lý","zh-Hans-CN":"颁布政府"},"ToolkitDefinition":{"ar":"هيئة عبارة عن حكومة تسن عملا عبارة عن قانون، أو لائحة، أو دستور، أو حكم قضائي، أو تشريع آخر.","ca":"Entitat corporativa que és un govern que promulga una obra que és una llei, un reglament, una constitució, una regla de funcionament d’un tribunal o qualsevol altra legislació.","cs":"Korporace, která je vládou, vydávající dílo, které je zákonem, nařízením, ústavou, soudním předpisem nebo jinou legislativou.","da":"Korporation, som er en regering, som vedtager et værk, der er en lov, forordning, forfatning, retsplejeregel eller anden lovgivning.","de":"Eine Regierung (Körperschaft), die ein Werk erlässt, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt.","de":"Eine Regierung (Körperschaft), die ein Werk erlässt, bei dem es sich um ein Gesetz, eine Verordnung, eine Verfassung, eine Rechtsverordnung oder eine andere Gesetzgebung handelt.","el":"Mια δικαιοδοσία, που θεσπίζει έναν νόμο, κανονισμό, σύνταγμα, κανόνα δικαστηρίου κ.λπ.","en":"A corporate body who is a government enacting a work that is a law, regulation, constitution, court rule, or other legislation.","es":"Un organismo corporativo que es gobierno que promulga una obra que es una ley, regulación, constitución, norma judicial, u otra legislación.","et":"Asutus, kes on seadust, määrust, konstitutsiooni, menetluseeskirja või muud õigusaktina loodud teost kehtestav valitsus.","fi":"Yhteisö, joka on teoksen, joka on laki, asetus, perustuslaki, tuomioistuinta koskeva sääntö tai muu säädös, säätävä hallintoelin.","fr":"Collectivité qui constitue un gouvernement promulguant une œuvre qui consiste en une loi, un règlement, une constitution, une règle de pratique de tribunal ou une autre mesure législative.","hu":"Egy testület, amely egy irányító szerv, amely kiad egy művet, ami egy törvény, rendelet, alkotmány, törvényszéki szabályzat vagy egyéb jogszabály.","it":"Ente che è un governo che emana un’opera che è una legge, regolamento, costituzione, regolamento della corte o altra legislazione.","lv":"Institūcija, kas ir valsts pārvaldes iestāde un ir tiesīga ieviest likumus, noteikumus, konstitūciju, tiesas nolēmumus vai citus tiesību aktus.","nl":"Een corporatie die een regering is die een werk vaststelt dat een wet, regeling, grondwet, rechterlijke uitspraak of andere wetgeving is.","no":"En korporasjon som er en offentlig myndighet som vedtar et verk som er en lov, vedtekt, grunnlov, rettergangsregel eller annen lovgiving.","tr":"Kanun, yönetmelik, anayasa, mahkeme kuralı veya diğer mevzuat olan bir eseri yürürlüğe koyan bir devlet kurumu olan tüzel bir kişilik.","vi":"Khu vực pháp quyền ban hành luật, quyết định, hiến pháp, quy tắc toà án, v.v...","zh-Hans-CN":"作为一个政府颁布作为法律、法规、宪法、法院规则或其他立法的一种作品的一个团体"},"altLabel":{"fr":["juridiction promulgatrice,gouvernement édicteur"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"18.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/enactingGovernment.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10017", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/enactingGovernment.en", "label":"has enacting government"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10017", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/enactingGovernment.en", "label":"has enacting government"}]},{"@id":"http://rdaregistry.info/Elements/w/P10336","label":{"ar":"له تحول","ca":"té com a transformació","cs":"má transformaci","da":"har transformation","de":"hat Transformation","de":"hat Transformation","en":"has transformation","es":"tiene transformación","et":"ümberkujundus","fi":"muunnos","fr":"a pour transformation","hu":"átalakítása a következő:","it":"ha come trasformazione","lv":"pārveidojums","nl":"heeft transformatie","no":"har transformasjon","tr":"dönüşüm ile ilişkilidir","zh-Hans-CN":"有转换"},"definition":{"ar":["يربط عمل بعمل تم إنشاؤه عن طريق تغيير مجال عمل أو سياسته التحريرية، أو نوعه أو شكله الأدبي، أو جمهوره المستهدف، أو أسلوبه."],"ca":["Relaciona una obra amb una obra que es crea canviant l’abast o la política editorial, el gènere o la forma literària, els destinataris previstos o l’estil d’una obra."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou zaměření nebo redakční politiky, žánru nebo literární formy, cílového publika nebo stylu díla."],"da":["Relaterer et værk til et værk, som er skabt ved ændring af et værks rækkevidde eller redaktionelle retningslinje, genre eller litterære form, målgruppe eller stil."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch eine Änderung des Geltungsbereichs, der redaktionelle Vorgehensweise, des Genres oder der literarischen Form, der Zielgruppe oder des Stils eines Werks erstellt wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch eine Änderung des Geltungsbereichs, der redaktionelle Vorgehensweise, des Genres oder der literarischen Form, der Zielgruppe oder des Stils eines Werks erstellt wird."],"en":["Relates a work to a work that is created by changing the scope or editorial policy, the genre or literary form, the target audience, or the style of a work."],"es":["Relaciona una obra con una obra que se crea cambiando el alcance o la política editorial, el género o forma literaria, el público objetivo o el estilo de una obra."],"et":["Seostab teose teosega, mis on loodud, muutes teose käsitlusala või toimetamispõhimõtteid, žanri või kirjanduslikku vormi, sihtrühma või stiili."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen toiminta-alaa tai toimituslinjaa, genreä tai kirjallista muotoa, kohdeyleisöä tai tyyliä."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant la portée ou la politique éditoriale, le genre ou la forme littéraire, le public cible ou le style d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű alkalmazási területének vagy szerkesztési elveinek, a műfajának vagy műnemének, a célközönségének vagy a stílusának megváltoztatásával jött létre."],"it":["Correla un’opera a un’opera che è creata cambiando l’oggetto o la politica editoriale, il genere o la forma letteraria, il pubblico di riferimento o lo stile di un’opera."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darbības jomu vai izdošanas politiku, žanru vai literāro formu, mērķauditoriju vai darba stilu."],"nl":["Relateert een werk aan een werk dat gecreëerd is door het veranderen van de scope of redactiebeleid, het genre of de literaire vorm, de doelgroep of de stijl van een werk."],"no":["Relaterer et verk til et verk som er skapt ved endring av omfanget eller de redaksjonelle retningslinjene, sjangeren eller den litterære formen, målgruppen eller stilen til et verk."],"tr":["Bir eseri, kapsamını veya yayın politikasını, türünü veya edebi biçimini, hedef kitlesini veya biçimini değiştirerek oluşturulan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过改变一种作品的范围或编辑政策、体裁或文学形式、目标受众或风格而被创建的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تحول","ca":"transformació","cs":"transformace","da":"transformation","de":"Transformation","de":"Transformation","en":"transformation","es":"transformación","et":"ümberkujundus","fi":"muunnos","fr":"transformation","hu":"átalakítás:","it":"trasformazione","lv":"pārveidojums","nl":"transformatie","no":"transformasjon","tr":"dönüşüm","zh-Hans-CN":"转换"},"ToolkitDefinition":{"ar":"عمل تم إنشاؤه عن طريق تغيير مجال عمل أو سياسته التحريرية، أو نوعه أو شكله الأدبي، أو جمهوره المستهدف، أو أسلوبه.","ca":"Obra que es crea canviant l’abast o la política editorial, el gènere o la forma literària, els destinataris previstos o l’estil d’una obra.","cs":"Dílo, které je vytvořeno změnou zaměření nebo redakční politiky, žánru nebo literární formy, cílového publika nebo stylu díla.","da":"Værk, som er skabt ved ændring af et værks rækkevidde eller redaktionelle retningslinje, genre eller litterære form, målgruppe eller stil.","de":"Ein Werk, das durch eine Änderung des Geltungsbereichs, der redaktionelle Vorgehensweise, des Genres oder der literarischen Form, der Zielgruppe oder des Stils eines Werks erstellt wird.","de":"Ein Werk, das durch eine Änderung des Geltungsbereichs, der redaktionelle Vorgehensweise, des Genres oder der literarischen Form, der Zielgruppe oder des Stils eines Werks erstellt wird.","en":"A work that is created by changing the scope or editorial policy, the genre or literary form, the target audience, or the style of a work.","es":"Una obra que se crea cambiando el alcance o la política editorial, el género o forma literaria, el público objetivo o el estilo de una obra.","et":"Teos, mis on loodud, muutes teose käsitlusala või toimetamispõhimõtteid, žanri või kirjanduslikku vormi, sihtrühma või stiili.","fi":"Teos, joka on luotu muuttamalla teoksen toiminta-alaa tai toimituslinjaa, genreä tai kirjallista muotoa, kohdeyleisöä tai tyyliä.","fr":"Œuvre qui est créée en modifiant la portée ou la politique éditoriale, le genre ou la forme littéraire, le public cible ou le style d’une œuvre.","hu":"Egy mű, amely egy mű alkalmazási területének vagy szerkesztési elveinek, a műfajának vagy műnemének, a célközönségének vagy a stílusának megváltoztatásával jött létre.","it":"Opera che è creata cambiando l’oggetto o la politica editoriale, il genere o la forma letteraria, il pubblico di riferimento o lo stile di un’opera.","lv":"Darbs, kas radīts, mainot darbības jomu vai izdošanas politiku, žanru vai literāro formu, mērķauditoriju vai darba stilu.","nl":"Een werk dat gecreëerd is door het veranderen van de scope of redactiebeleid, het genre of de literaire vorm, de doelgroep of de stijl van een werk.","no":"Et verk som er skapt ved endring av omfanget eller de redaksjonelle retningslinjene, sjangeren eller den litterære formen, målgruppen eller stilen til et verk.","tr":"Kapsamı veya yayın politikasının, türü veya edebi biçiminin, hedef kitlesi veya üslubunun değiştirilmesiyle oluşturulan bir eser.","zh-Hans-CN":"通过改变一种作品的范围或编辑政策、体裁或文学形式、目标受众或风格而被创建的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/transformation.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10383", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudience.en", "label":"has transformation by audience"},{"@id":"http://rdaregistry.info/Elements/w/P10342", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByGenre.en", "label":"has transformation by genre"},{"@id":"http://rdaregistry.info/Elements/w/P10344", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByPolicy.en", "label":"has transformation by policy"},{"@id":"http://rdaregistry.info/Elements/w/P10340", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyle.en", "label":"has transformation by style"},{"@id":"http://rdaregistry.info/Elements/w/object/P10336", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/transformation.en", "label":"has transformation"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10336", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/transformation.en", "label":"has transformation"}]},{"@id":"http://rdaregistry.info/Elements/w/P10383","label":{"ar":"له تحول وفق الجمهور","ca":"té com a transformació de destinataris","cs":"má transformaci změnou publika","da":"har transformation ved målgruppe","de":"hat Transformation hinsichtlich der Zielgruppe","de":"hat Transformation hinsichtlich der Zielgruppe","en":"has transformation by audience","es":"tiene transformación por audiencia","et":"ümberkujundus sihtrühma alusel","fi":"muunnos yleisössä","fr":"a pour transformation par changement de public","hu":"közönség miatti átalakítása a következő:","it":"ha come traformazione nei destinatari","lv":"pārveidojums, mainot mērķauditoriju","nl":"heeft transformatie door doelgroep","no":"har transformasjon ved målgruppe","tr":"hedef kitleye göre dönüşüm ile ilişkilidir","zh-Hans-CN":"有按受众的转换"},"definition":{"ar":["يربط عمل بعمل يتم إنشاؤه عن طريق تغيير جمهور عمل."],"ca":["Relaciona una obra amb una obra que es crea canviant els destinataris d’una obra."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou publika díla."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre målgruppen for et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aufgrund einer Änderung der Zielgruppe eines Werks erstellt wird.,Setzt ein Werk in Beziehung zu einem Werk, das aufgrund einer Änderung der Zielgruppe eines Werks erstellt wird."],"en":["Relates a work to a work that is created by changing the audience of a work."],"es":["Relaciona una obra con una obra que se crea cambiando la audiencia de una obra."],"et":["Seostab teose teosega, mis on loodud, muutes teose sihtrühma."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen yleisöä."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le public d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű közönségének megváltozása következtében jött létre."],"it":["Correla un'opera a un'opera creata cambiando i destinatari di un'opera."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba auditoriju."],"nl":["Relateert een werk aan een werk dat is gecreëerd door het wijzigen van de doelgroep van een werk."],"no":["Relaterer et verk til et verk som er skapt ved endring av målgruppen for et verk."],"tr":["Bir eseri, bir eserin hedef kitlesi değiştirilerek oluşturulan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过改变一种作品的受众而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تحول وفق الجمهور","ca":"transformació de destinataris","cs":"transf