                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/languageOfRepresentativeExpression.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10353", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/languageOfRepresentativeExpression.en", "label":"has language of representative expression"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10353", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/languageOfRepresentativeExpression.en", "label":"has language of representative expression"}]},{"@id":"http://rdaregistry.info/Elements/w/P10385","label":{"ar":"له إصدارة لغة","ca":"té com a versió de llengua","cs":"má jazykovou verzi","da":"har sproglig version","de":"hat Sprachversion","de":"hat Sprachversion","en":"has language version","es":"tiene versión de idioma","et":"keeleversioon","fi":"kieliversio","fr":"a pour version linguistique","hu":"nyelvi változata a következő:","it":"ha come versione linguistica","lv":"valodas versija","nl":"heeft taalversie","no":"har språklig versjon","tr":"dil uyarlaması ile ilişkilidir","zh-Hans-CN":"有语言版本"},"definition":{"ar":["يربط عمل بعمل يتم إنشاؤه عن طريق تغيير جمهور لغة عمل."],"ca":["Relaciona una obra amb una obra que es crea canviant la llengua dels destinataris d’una obra."],"cs":["Vztahuje dílo k dílu, které je vytvořeno změnou jazykového publika díla."],"da":["Relaterer et værk til et værk, som er skabt ved at ændre et værks sproglige målgruppe."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung der sprachlichen Zielgruppe eines Werks erstellt wird.,Setzt ein Werk in Beziehung zu einem Werk, das durch Änderung der sprachlichen Zielgruppe eines Werks erstellt wird."],"en":["Relates a work to a work that is created by changing the language audience of a work."],"es":["Relaciona una obra con una obra que se crea cambiando el idioma de audiencia de una obra."],"et":["Seostab teose teosega, mis on loodud, muutes teose keelelist sihtrühma."],"fi":["Liittää teoksen teokseen, joka on luotu muuttamalla teoksen kieliyleisöä."],"fr":["Met une œuvre en relation avec une œuvre qui est créée en modifiant le public linguistique d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy műközönség nyelvének megváltozása következtében jött létre."],"it":["Correla un'opera a un'opera creata cambiando la lingua dei destinatari di un'opera."],"lv":["Sasaista darbu ar darbu, kas radīts, mainot darba valodu citvalodu auditorijas vajadzībām."],"nl":["Relateert een werk aan een werk dat is gecreëerd door het wijzigen van de taaldoelgroep van een werk."],"no":["Relaterer et verk til et verk som er skapt ved endring av den språklige målgruppen for et verk."],"tr":["Bir eseri, bir eserin dil kitlesi değiştirilerek oluşturulmuş bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过改变一种作品的语言受众而被创作的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة لغة","ca":"versió de llengua","cs":"jazyková verze","da":"sproglig version","de":"Sprachversion","de":"Sprachversion","en":"language version","es":"versión de idioma","et":"keeleversioon","fi":"kieliversio","fr":"version linguistique","hu":"nyelvi változata:","it":"versione linguistica","lv":"valodas versija","nl":"taalversie","no":"språklig versjon","tr":"dil versiyonu","zh-Hans-CN":"语言版本"},"ToolkitDefinition":{"ar":"عمل يتم إنشاؤه عن طريق تغيير جمهور لغة عمل.","ca":"Obra que es crea canviant la llengua dels destinataris d’una obra.","cs":"Dílo, které je vytvořeno změnou jazykového publika díla.","da":"Værk, som er skabt ved at ændre et værks sproglige målgruppe.","de":"Ein Werk, das durch Änderung der sprachlichen Zielgruppe eines Werks erstellt wird.","de":"Ein Werk, das durch Änderung der sprachlichen Zielgruppe eines Werks erstellt wird.","en":"A work that is created by changing the language audience of a work.","es":"Una obra que se crea cambiando el idioma de audiencia de una obra.","et":"Teos, mis on loodud, muutes teose keelelist sihtrühma.","fi":"Teos, joka on luotu muuttamalla teoksen kieliyleisöä.","fr":"Œuvre qui est créée en modifiant le public linguistique d’une œuvre.","hu":"Egy mű, amely egy műközönség nyelvének megváltozása következtében jött létre.","it":"Opera creata cambiando la lingua dei destinatari di un'opera.","lv":"Darbs, kas radīts, mainot darba valodu citvalodu auditorijas vajadzībām.","nl":"Een werk dat is gecreëerd door het wijzigen van de taaldoelgroep van een werk.","no":"Et verk som er skapt ved endring av den språklige målgruppen for et verk.","tr":"Bir eserin dil kitlesinin değiştirilmesiyle oluşturulan bir eser.","zh-Hans-CN":"通过改变一种作品的语言受众而被创作的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/languageVersion.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10383", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudience.en", "label":"has transformation by audience"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10385", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/languageVersion.en", "label":"has language version"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10385", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/languageVersion.en", "label":"has language version"}]},{"@id":"http://rdaregistry.info/Elements/w/P10388","label":{"ar":"هو إصدارة لغة لـ","ca":"és versió de llengua de","cs":"je jazykovou verzí (čeho)","da":"er sproglig version af","de":"ist Sprachversion von","de":"ist Sprachversion von","en":"is language version of","es":"es la versión lingüística de","et":"keeleversioon teosest","fi":"kieliversio teoksesta","fr":"est une version linguistique de","hu":"nyelvi változata a következőnek:","it":"è versione linguistica di","lv":"ir valodas versija no","nl":"is taalversie van","no":"er språklig versjon av","tr":"dil uyarlamasıdır","zh-Hans-CN":"是……的语言版本"},"definition":{"ar":["يربط عمل بعمل له جمهور لغة يتم تغييره لإنشاء عمل."],"ca":["Relaciona una obra amb una obra que té uns destinataris d’una llengua que es canvien per crear una obra."],"cs":["Vztahuje dílo k dílu, které má jazykové publikum, které je změněno za účelem vytvoření díla."],"da":["Relaterer et værk til et værk, som har en sproglig målgruppe, som ændres for at skabe et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen sprachlichen Zielgruppe geändert wird, um ein Werk zu schaffen.,Setzt ein Werk in Beziehung zu einem Werk, dessen sprachlichen Zielgruppe geändert wird, um ein Werk zu schaffen."],"en":["Relates a work to a work that has a language audience that is changed to create a work."],"es":["Relaciona una obra con una obra que tiene un público lingüístico que se cambia para crear una obra."],"et":["Seostab teose teosega, mille keelelist sihtrühma on teose loomiseks muudetud."],"fi":["Liittää teoksen teokseen, jolla on kieliyleisö, jota on muutettu teoksen luomiseksi."],"fr":["Met une œuvre en relation avec une œuvre dont le public cible linguistique est modifié pour créer une œuvre."],"hu":["Hozzákapcsol egy művet egy műűhöz, amely közönségének a nyelve megváltozott egy mű létrejövetele érdekében."],"it":["Correla un'opera a un'opera la cui lingua dei destinatari è cambiata per creare un'opera"],"lv":["Sasaista darbu ar darbu, kam valoda tika mainīta, pielāgojot citvalodu auditorijas vajadzībām."],"nl":["Relateert een werk aan een werk dat een taaldoelgroep heeft die gewijzigd wordt om een werk te creëren."],"no":["Relaterer et verk til et verk som har en språklig målgruppe som er endret for å skape et verk."],"tr":["Bir eseri, bir eser oluşturmak için değiştirilen bir dil kitlesine sahip bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与有语言受众并被改变以创作一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة لغة لـ","ca":"versió de llengua de","cs":"jazyková verze (čeho)","da":"sproglig version af","de":"Sprachversion von","de":"Sprachversion von","en":"language version of","es":"versión lingüística de","et":"keeleversioon teosest","fi":"kieliversio teoksesta","fr":"version linguistique de","hu":"nyelvi változata:","it":"versione linguistica di","lv":"valodas versija no","nl":"taalversie van","no":"språklig versjon av","tr":"Dil versiyonu","zh-Hans-CN":"……的语言版本"},"ToolkitDefinition":{"ar":"عمل له جمهور لغة يتم تغييره لإنشاء عمل.","ca":"Obra que té uns destinataris d’una llengua que es canvien per crear una obra.","cs":"Dílo, které má jazykové publikum, které je změněno za účelem vytvoření díla.","da":"Værk, som har en sproglig målgruppe, som ændres for at skabe et værk.","de":"Ein Werk, dessen sprachlichen Zielgruppe geändert wird, um ein Werk zu schaffen.","de":"Ein Werk, dessen sprachlichen Zielgruppe geändert wird, um ein Werk zu schaffen.","en":"A work that has a language audience that is changed to create a work.","es":"Una obra que tiene un público lingüístico que se cambia para crear una obra.","et":"Teos, mille keelelist sihtrühma on teose loomiseks muudetud.","fi":"Teos, jolla on kieliyleisö, jota on muutettu teoksen luomiseksi.","fr":"Œuvre dont le public cible linguistique est modifié pour créer une œuvre.","hu":"Egy mű, amely közönségének a nyelve megváltozott egy mű létrejövetele érdekében.","it":"Opera la cui lingua dei destinatari è cambiata per creare un'opera.","lv":"Darbs, kam valoda tika mainīta, pielāgojot citvalodu auditorijas vajadzībām.","nl":"Een werk dat een taaldoelgroep heeft die gewijzigd wordt om een werk te creëren.","no":"Et verk som har en språklig målgruppe som er endret for å skape et verk.","tr":"Bir eserin, dil hedef kitlesi değiştirilerek oluşturulduğu bir eser.","zh-Hans-CN":"有语言受众并被改变以创作一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/languageVersionOf.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10384", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudienceOf.en", "label":"is transformation by audience of"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10388", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/languageVersionOf.en", "label":"is language version of"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10388", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/languageVersionOf.en", "label":"is language version of"}]},{"@id":"http://rdaregistry.info/Elements/w/P10205","label":{"ar":"له وكيل مؤلف أوبرالي","ca":"té com a agent llibretista","cs":"má libretistu (agenta)","da":"har agent, som er librettist","de":"hat Librettistin/Librettist (Akteur)","de":"hat Librettistin/Librettist (Akteur)","el":"έχει λιμπρετίστα","en":"has librettist agent","es":"tiene agente libretista","et":"libretist (tegija)","fi":"libretisti (toimija)","fr":"a pour agent librettiste","hu":"librettista ágense a következő:","it":"ha come librettista agente","lv":"libretists (aģents)","nl":"heeft librettist-actor","no":"har librettist (agent)","tr":"libretto yazarı temsilcisi ile ilişkilidir","vi":"có người viết lời nhạc kịch","zh-Hans-CN":"有台本作者行为者"},"definition":{"ar":["يربط بين عمل ووكيل يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية."],"ca":["Relaciona una obra amb un agent que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori."],"cs":["Vztahuje dílo k agentovi, který je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium."],"da":["Relaterer et værk til en agent, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) des Texts für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) des Texts für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium."],"el":["Συνδέει ένα έργο με έναν συγγραφέα των στίχων μιας όπερας ή κάποιου άλλου μουσικού σκηνικού έργου ή ενός ορατορίου."],"en":["Relates a work to an agent who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con un agente que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio."],"et":["Seostab teose tegijaga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor."],"fi":["Liittää teoksen toimijaan, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec un agent auteur des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művet egy szerző ágenshez, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un’opera a un agente autore delle parole di un’opera musicale o coreografica come un’opera, balletto o altro tipo di opera per il teatro musicale, o un oratorio."],"lv":["Sasaista darbu ar aģentu, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai."],"nl":["Relateert een werk aan een actor die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til en agent som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzikal sahne için başka bir eser veya bir oratoryo gibi bir müzikal veya koreografik eserin sözlerinin yazarı olan bir temsilciyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác giả của lời của opera hoặc tác phẩm sân khấu âm nhạc khác, hoặc oratorio."],"zh-Hans-CN":["将一种作品与作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل مؤلف أوبرالي","ca":"agent llibretista","cs":"libretista (agent)","da":"agent, som er librettist","de":"Librettistin/Librettist (Akteur)","de":"Librettistin/Librettist (Akteur)","el":"λιμπρετίστας","en":"librettist agent","es":"agente libretista","et":"libretist (tegija)","fi":"libretisti (toimija)","fr":"agent librettiste","hu":"librettista ágens:","it":"librettista agente","lv":"libretists (aģents)","nl":"librettist-actor","no":"librettist (agent)","tr":"opera metin yazarı temsilci","vi":"người viết lời nhạc kịch","zh-Hans-CN":"台本作者行为者"},"ToolkitDefinition":{"ar":"وكيل يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.","ca":"Agent que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.","cs":"Agent, který je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium.","da":"Agent, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Eine Verfasserin/Ein Verfasser (Akteur) des Texts für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","de":"Eine Verfasserin/Ein Verfasser (Akteur) des Texts für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","el":"Ένας συγγραφέας των στίχων μιας όπερας ή κάποιου άλλου μουσικού σκηνικού έργου ή ενός ορατορίου.","en":"An agent who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Un agente que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.","et":"Tegija, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.","fi":"Toimija, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.","fr":"Agent auteur des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy szerző ágens, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Agente autore delle parole di un’opera musicale o coreografica come un’opera, balletto o altro tipo di opera per il teatro musicale, o un oratorio.","lv":"Aģents, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.","nl":"Een actor die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"En agent som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.","tr":"Opera, bale veya müzikal sahne için başka bir eser veya bir oratoryo gibi bir müzikal veya koreografik eserin sözlerinin yazarı olan bir temsilci.","vi":"Tác giả của lời của opera hoặc tác phẩm sân khấu âm nhạc khác, hoặc oratorio.","zh-Hans-CN":"作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个行为者"},"note":{"ar":["يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només les paraules de les cançons d’un musical."],"cs":["Autorství pouze textů písní z muzikálu je vyloučeno."],"da":["Forfatter til kun sangteksterne i en musical er ikke omfattet."],"de":["Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.,Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter."],"el":["Δεν περιλαμβάνεται η συγγραφή των στίχων μόνο των τραγουδιών ενός musical."],"en":["Authoring of the words of only the songs from a musical is excluded."],"es":["Se excluye la autoría de la letra únicamente de las canciones de un musical."],"et":["Ei hõlma üksnes muusikali laulusõnade kirjutamist."],"fi":["Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu."],"hu":["Musicaldalok szövegírója nem tartozik ide."],"it":["E' esclusa la creazione delle parole delle sole canzoni di un musical."],"lv":["Neietver atsevišķu dziesmu tekstus mūziklos."],"nl":["Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten."],"no":["Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir."],"vi":["Tác giả của lời chỉ các bài hát từ âm nhạc, không được bao gồm."],"zh-Hans-CN":["不包括音乐剧中只是歌曲的词著者。"]},"altLabel":{"ar":["مؤلف أوبرالي"],"ca":["llibretista"],"cs":["libretista"],"da":["librettist"],"de":["Librettist,Librettist"],"en":["librettist"],"es":["libretista"],"et":["libretist"],"fi":["libretisti"],"fr":["librettiste"],"hu":["librettista:"],"it":["librettista"],"nl":["librettist"],"tr":["opera metin yazarı"],"zh-Hans-CN":["台本作者"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10061", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorAgent.en", "label":"has author agent"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/librettistAgent.en","See Also":[{"@id":"http://rdaregistry.info/Elements/w/P10204", "lexicalAlias":"http://rdaregistry.info/Elements/w/lyricistAgent.en", "label":"has lyricist agent"}],"instructionNumber":"18.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10478", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistCollectiveAgent.en", "label":"has librettist collective agent"},{"@id":"http://rdaregistry.info/Elements/w/P10431", "lexicalAlias":"http://rdaregistry.info/Elements/w/librettistPerson.en", "label":"has librettist person"},{"@id":"http://rdaregistry.info/Elements/w/object/P10205", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/librettistAgent.en", "label":"has librettist agent"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10205", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/librettistAgent.en", "label":"has librettist agent"}]},{"@id":"http://rdaregistry.info/Elements/w/P10478","label":{"ar":"له وكيل جماعي مؤلف أوبرالي","ca":"té com a agent col·lectiu llibretista","cs":"má libretistu (kolektivního agenta)","da":"har kollektiv agent, som er librettist","de":"hat Librettistin/Librettisten (Gemeinschaftlicher Akteur)","de":"hat Librettistin/Librettisten (Gemeinschaftlicher Akteur)","en":"has librettist collective agent","es":"tiene agente colectivo libretista","et":"libretist (kollektiiv)","fi":"libretisti (yhteistoimija)","fr":"a pour agent collectif librettiste","hu":"librettista kollektív ágense a következő:","it":"ha come librettista agente collettivo","lv":"libretists (grupa)","nl":"heeft librettist-collectieve actor","no":"har librettist (kollektiv agent)","tr":"libretto yazarı kolektif temsilcisi ile ilişkilidir","zh-Hans-CN":"有台本作者集体行为者"},"definition":{"ar":["يربط بين عمل ووكيل جماعي يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية."],"ca":["Relaciona una obra amb un agent que és un autor de les paraules d’un musical o una obra coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori."],"cs":["Vztahuje dílo ke kolektivnímu agentovi, který je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium."],"da":["Relaterer et værk til en kollektiv agent, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium."],"de":["Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.,Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium."],"en":["Relates a work to a collective agent who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio."],"es":["Relaciona una obra con un agente colectivo que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para la escena musical, o un oratorio."],"et":["Seostab teose kollektiiviga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor."],"fi":["Liittää teoksen yhteistoimijaan, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja."],"fr":["Met une œuvre en relation avec un agent collectif auteur des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio."],"hu":["Hozzákapcsol egy művet egy szerző kollektív ágenshez, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű."],"it":["Correla un'opera a un agente collettivo autore delle parole di un musical o opera coreografica, come un'opera, balletto, o altra opera per il teatro musicale, o per un oratorio."],"lv":["Sasaista darbu ar grupu, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai."],"nl":["Relateert een werk aan een collectieve actor die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium."],"no":["Relaterer et verk til en kollektiv agent som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium."],"tr":["Bir eseri, opera, bale veya müzikal sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan kolektif bir temsilci ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个集体行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل جماعي مؤلف أوبرالي","ca":"agent col·lectiu llibretista","cs":"libretista (kolektivní agent)","da":"Kollektiv agent, som er librettist","de":"Librettistin/Librettist (Gemeinschaftlicher Akteur)","de":"Librettistin/Librettist (Gemeinschaftlicher Akteur)","en":"librettist collective agent","es":"agente colectivo libretista","et":"libretist (kollektiiv)","fi":"libretisti (yhteistoimija)","fr":"agent collectif librettiste","hu":"librettista kollektív ágens:","it":"librettista agente collettivo","lv":"libretists (grupa)","nl":"librettist-collectieve actor","no":"librettist (kollektiv agent)","tr":"Opera metni yazarı kolektif temsilci","zh-Hans-CN":"台本作者集体行为者"},"ToolkitDefinition":{"ar":"وكيل جماعي يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.","ca":"Agent que és un autor de les paraules d’un musical o una obra coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.","cs":"Kolektivní agent, který je autorem textu hudebního nebo choreografického díla jako je opera, balet nebo jiné dílo pro hudební scénu nebo oratorium.","da":"Kollektiv agent, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.","de":"Eine Verfasserin/Ein Verfasser (Gemeinschaftlicher Akteur) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","de":"Eine Verfasserin/Ein Verfasser (Gemeinschaftlicher Akteur) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.","en":"A collective agent who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.","es":"Un agente colectivo que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para la escena musical, o un oratorio.","et":"Kollektiiv, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.","fi":"Yhteistoimija, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.","fr":"Agent collectif auteur des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.","hu":"Egy szerző kollektív ágens, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.","it":"Agente collettivo autore delle parole di un musical o opera coreografica, come un'opera, balletto, o altra opera per il teatro musicale, o per un oratorio.","lv":"Grupa, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.","nl":"Een collectieve actor die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.","no":"En kollektiv agent som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.","tr":"Opera, bale veya diğer müzikal sahne eserleri, ya da bir oratoryo gibi, müzikal veya koreografik bir eserin sözlerinin yazarı olan bir kolektif temsilci.","zh-Hans-CN":"作为歌剧、芭蕾或其他舞台音乐作品或者清唱剧等音乐或编舞作品的词的著者的一个集体行为者"},"note":{"ar":["يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية."],"ca":["S’exclou l’autoria de només les paraules de les cançons d’un musical."],"cs":["Autorství pouze textů písní z muzikálu je vyloučeno."],"da":["Forfatter til kun sangteksterne i en musical er ikke omfattet."],"de":["Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.,Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter."],"en":["Authoring of the words of only the songs from a musical is excluded."],"es":["Se excluye la autoría de la letra únicamente de las canciones de un musical."],"et":["Ei hõlma üksnes muusikali laulusõnade kirjutamist."],"fi":["Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa."],"fr":["Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu."],"hu":["Musicaldalok szövegírója nem tartozik ide."],"it":["E' escluso essere autore delle parole delle sole canzoni di un musical."],"lv":["Neietver atsevišķu dziesmu tekstus mūziklos."],"nl":["Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten."],"no":["Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert."],"tr":["Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir."],"zh-Hans-CN":["不包括音乐剧中只是歌曲的词著者。"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
