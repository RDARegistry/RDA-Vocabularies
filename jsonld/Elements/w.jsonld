                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerCorporateBodyOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10493", "lexicalAlias":"http://rdaregistry.info/Elements/w/interviewerCollectiveAgentOfWork.en", "label":"has interviewer collective agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10540", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/interviewerCorporateBodyOfWork.en", "label":"has interviewer corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10540", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/interviewerCorporateBodyOfWork.en", "label":"has interviewer corporate body of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10587","label":{"ar":"له عائلة محاورة لعمل","ca":"té com a família entrevistadora d’una obra","cs":"má tazatele díla (rodinu)","da":"har familie, som er interviewer for værk","de":"hat Interviewerin/Interviewer eines Werks (Familie)","de":"hat Interviewerin/Interviewer eines Werks (Familie)","en":"has interviewer family of work","es":"tiene familia entrevistadora de obra","et":"teose intervjueerija (perekond)","fi":"teoksen haastattelija (suku)","fr":"a pour famille intervieweuse d’une œuvre","hu":"mű interjúkészítő családja a következő:","it":"ha come intervistatore famiglia di opera","lv":"darbā intervējis (dzimta/ģimene)","nl":"heeft interviewer-familie van werk","no":"har intervjuer (familie)","tr":"eserin görüşmeci ailesi ile ilişkilidir","zh-Hans-CN":"有作品的采访者家族"},"definition":{"ar":["يربط بين عمل وعائلة مسئولة عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو مستطلع آراء، أو عائلة من نوع آخر تجمع المعلومات."],"ca":["Relaciona una obra amb una família que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus de família que recull informació."],"cs":["Vztahuje dílo k rodině, která je odpovědná za vytvoření díla tím, že působí jako tazatel, zpravodaj, rodina provádějící průzkum veřejného mínění nebo jiná rodina, která shromažďuje informace."],"da":["Relaterer et værk til en familie, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for korporation, som indsamler information."],"de":["Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Familie Informationen zusammenträgt.,Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Familie Informationen zusammenträgt."],"en":["Relates a work to a family who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of family who gathers information."],"es":["Relaciona una obra con una familia que es responsable de crear una obra al actuar como un entrevistador, reportero, encuestador u otro tipo de agente que recolecta información."],"et":["Seostab teose perekonnaga, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva perekonnana."],"fi":["Liittää teoksen sukuun, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja."],"fr":["Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre famille recueillant de l’information."],"hu":["Hozzákapcsol egy művet egy családhoz, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő családként cselekszik."],"it":["Correla un'opera alla famiglia responsabile della creazione di un'opera che agisce come intervistatore, reporter, sondaggista o altro genere di persona che raccoglie informazioni."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs."],"nl":["Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt."],"no":["Relaterer et verk til en familie som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon."],"tr":["Bir eseri, bir görüşmeci, muhabir, anketör veya bilgi toplayan başka bir tür aile olarak hareket ederek bir eser oluşturmaktan sorumlu olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集家族而对一种作品的创作负责的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة محاورة لعمل","ca":"família entrevistadora d’una obra","cs":"tazatel díla (rodina)","da":"familie, som er interviewer for værk","de":"Interviewerin/Interviewer eines Werks (Familie)","de":"Interviewerin/Interviewer eines Werks (Familie)","en":"interviewer family of work","es":"familia entrevistadora de obra","et":"teose intervjueerija (perekond)","fi":"teoksen haastattelija (suku)","fr":"famille intervieweuse d’une œuvre","hu":"mű interjúkészítő családja:","it":"intervistatore famiglia di opera","lv":"darbā intervējis (dzimta/ģimene)","nl":"interviewer-familie van werk","no":"intervjuer (familie)","tr":"eserin görüşmeci ailesi ile ilişkilidir","zh-Hans-CN":"作品的采访者家族"},"ToolkitDefinition":{"ar":"عائلة مسئولة عن إنشاء عمل من خلال العمل كمحاور أو مراسل أو مستطلع آراء أو عائلة من نوع آخر تجمع المعلومات.","ca":"Família que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus de família que recull informació.","cs":"Rodina, která je odpovědná za vytvoření díla tím, že působí jako tazatel, zpravodaj, rodina provádějící průzkum veřejného mínění nebo jiná rodina, která shromažďuje informace.","da":"Familie, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for korporation, som indsamler information.","de":"Eine Familie, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Familie Informationen zusammenträgt.","de":"Eine Familie, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Familie Informationen zusammenträgt.","en":"A family who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of family who gathers information.","es":"Una familia que es responsable de crear una obra al actuar como un entrevistador, reportero, encuestador u otro tipo de agente que recolecta información.","et":"Perekond, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva perekonnana.","fi":"Suku, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.","fr":"Famille qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre famille recueillant de l’information.","hu":"Egy család, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő családként cselekszik.","it":"Famiglia responsabile della creazione di un'opera che agisce come intervistatore, reporter, sondaggista o altro genere di persona che raccoglie informazioni.","lv":"Dzimta/ģimene, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.","nl":"Een familie die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.","no":"En familie som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.","tr":"Görüşmeci, muhabir, anketör veya bilgi toplayan başka bir aile türü olarak hareket ederek bir eser oluşturmaktan sorumlu olan bir aile.","zh-Hans-CN":"通过担当采访者、记者、民意调查员或其他类型信息搜集家族而对一种作品的创作负责的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
