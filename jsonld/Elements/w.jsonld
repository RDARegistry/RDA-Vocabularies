                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/regionalVersion.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10383", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByAudience.en", "label":"has transformation by audience"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10386", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/regionalVersion.en", "label":"has regional version"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10386", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/regionalVersion.en", "label":"has regional version"}]},{"@id":"http://rdaregistry.info/Elements/w/P10389","label":{"ar":"هو إصدارة إقليمية لـ","ca":"és versió regional de","cs":"je regionální verzí (čeho)","da":"er regional version af","de":"ist Regionalversion von","de":"ist Regionalversion von","en":"is regional version of","es":"es la versión regional de","et":"regionaalversioon teosest","fi":"alueversio teoksesta","fr":"est une version régionale de","hu":"regionális változata a következőnek:","it":"è versione regionale di","lv":"ir reģionālā versija no","nl":"is regionale versie van","no":"er regional versjon av","tr":"bölgesel sürümüdür","zh-Hans-CN":"是……的地区版本"},"definition":{"ar":["يربط عمل بعمل له جمهور إقليمي يتم تغييره لإنشاء عمل."],"ca":["Relaciona una obra amb una obra que té uns destinataris regionals que es canvien per crear una obra."],"cs":["Vztahuje dílo k dílu, které má regionální publikum, které je změněno za účelem vytvoření díla."],"da":["Relaterer et værk til et værk, som har en regional målgruppe, som ændres for at skabe et værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen regionale Zielgruppe geändert wird, um ein Werk zu schaffen.,Setzt ein Werk in Beziehung zu einem Werk, dessen regionale Zielgruppe geändert wird, um ein Werk zu schaffen."],"en":["Relates a work to a work that has a regional audience that is changed to create a work."],"es":["Relaciona una obra con una obra que tiene una audiencia regional que se cambia para crear una obra."],"et":["Seostab teose teosega, mille regionaalset sihtrühma on teose loomiseks muudetud."],"fi":["Liittää teoksen teokseen, jolla on alueyleisö, jota on muutettu teoksen luomiseksi."],"fr":["Met une œuvre en relation avec une œuvre dont le public cible régional est modifié pour créer une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek regionális közönsége megváltozott egy mű létrejövetele érdekében."],"it":["Correla un'opera a un'opera i cui destinatari regionali sono cambiati per creare un'opera."],"lv":["Sasaista darbu ar darbu, kam reģionālā auditorija mainīta, lai radītu šo darbu."],"nl":["Relateert een werk aan een werk dat een regionale doelgroep heeft die gewijzigd wordt om een werk te creëren."],"no":["Relaterer et verk til et verk som har en regional målgruppe som er endret for å skape et verk."],"tr":["Bir eseri, bir eser oluşturmak için değiştirilen bölgesel kitleye sahip bir eser ile ilişkilendirir."],"zh-Hans-CN":["将一种作品与有地区受众并被改变以创作一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إصدارة إقليمية لـ","ca":"versió regional de","cs":"regionální verze (čeho)","da":"regional version af","de":"Regionalversion von","de":"Regionalversion von","en":"regional version of","es":"versión regional de","et":"regionaalversioon teosest","fi":"alueversio teoksesta","fr":"version régionale de","hu":"regionális változata:","it":"versione regionale di","lv":"reģionālā versija no","nl":"regionale versie van","no":"regional versjon av","tr":"bölgesel versiyona sahip (eser)","zh-Hans-CN":"……的地区版本"},"ToolkitDefinition":{"ar":"عمل له جمهور إقليمي يتم تغييره لإنشاء عمل.","ca":"Obra que té uns destinataris regionals que es canvien per crear una obra.","cs":"Dílo, které má regionální pu