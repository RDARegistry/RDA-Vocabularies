                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10315", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedCollectiveAgentOfWork.en", "label":"has related collective agent of work"},{"@id":"http://rdaregistry.info/Elements/x/P00009", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedCorporateBodyOfRDAEntity.en", "label":"has related corporate body of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/relatedCorporateBodyOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10507", "lexicalAlias":"http://rdaregistry.info/Elements/w/addresseeCorporateBody.en", "label":"has addressee corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10533", "lexicalAlias":"http://rdaregistry.info/Elements/w/commissioningCorporateBody.en", "label":"has commissioning corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10531", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCorporateBodyOfWork.en", "label":"has creator corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10506", "lexicalAlias":"http://rdaregistry.info/Elements/w/dedicateeCorporateBodyOfWork.en", "label":"has dedicatee corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10527", "lexicalAlias":"http://rdaregistry.info/Elements/w/honoureeCorporateBodyOfWork.en", "label":"has honouree corporate body of work"},{"@id":"http://rdaregistry.info/Elements/w/P10007", "lexicalAlias":"http://rdaregistry.info/Elements/w/hostingInstitution.en", "label":"has hosting institution"},{"@id":"http://rdaregistry.info/Elements/w/P10550", "lexicalAlias":"http://rdaregistry.info/Elements/w/issuingCorporateBody.en", "label":"has issuing corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10605", "lexi