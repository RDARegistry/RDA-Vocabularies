                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/equinox.en","instructionNumber":"7.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10317", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedTimespanOfWork.en", "label":"has related timespan of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10214", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/equinox.en", "label":"has equinox"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10214", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/equinox.en", "label":"has equinox"}]},{"@id":"http://rdaregistry.info/Elements/w/P10402","label":{"ar":"له تبصرة عن عمل ميتاداتا","ca":"té com a nota sobre una obra de metadades","cs":"má poznámku o metadatech (dílo)","da":"har note om metadataværk","de":"hat Anmerkung zum Metadatenwerk","de":"hat Anmerkung zum Metadatenwerk","en":"has note on metadata work","es":"tiene nota sobre obra de metadatos","et":"märkus metaandmeteose kohta","fi":"huomautus metatietoteoksesta","fr":"a pour note sur une œuvre de métadonnées","hu":"metaadatműről szóló megjegyzése a következő:","it":"ha come nota su opera di metadati","lv":"piezīme par metadatiem","nl":"heeft noot bij metadatawerk","no":"har note om metadataverk","tr":"üstveri eseri hakkında not ile ilişkilidir","zh-Hans-CN":"有关于元数据作品的附注"},"definition":{"ar":["يربط بين عمل ووصف عام غير محدد لخاصية أو أكثر من خصائص عمل الميتاداتا."],"ca":["Relaciona una obra amb una descripció no estructurada àmplia d’un o més atributs d’una obra de metadades."],"cs":["Vztahuje dílo k obecnému nestrukturovanému popisu jednoho nebo více atributů metadatového díla."],"da":["Relaterer et værk til en bred, ustruktureret beskrivelse af en eller flere af et metadataværks attri