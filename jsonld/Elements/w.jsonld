                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsRadioScriptWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10098", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsRadioScriptWork.en", "label":"is adapted as radio script work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10098", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsRadioScriptWork.en", "label":"is adapted as radio script work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10162","label":{"ar":"له عمل نص إذاعي","ca":"té com a obra de guió radiofònic","cs":"má rozhlasový scénář (dílo)","da":"har radiomanuskriptværk","de":"hat Hörfunkskript (Werk)","de":"hat Hörfunkskript (Werk)","el":"είναι ραδιοφωνικό σενάριο (έργο)","en":"has radio script work","es":"tiene obra de guion de radio","et":"raadiostsenaarium (teos)","fi":"radio-ohjelman käsikirjoitus (teos)","fr":"a pour script radiophonique (œuvre)","hu":"rádiószövegkönyv-műve a következő:","it":"ha come sceneggiatura radiofonica opera","lv":"darbs: radio raidījuma scenārijs","nl":"heeft radioscriptwerk","no":"har radiomanus (verk)","tr":"radyo metni eseri ile ilişkilidir","vi":"là kịch bản truyền thanh (tác phẩm)","zh-Hans-CN":"有广播文稿作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل نصي يكمل عملًا عبارة عن برنامج إذاعي."],"ca":["Relaciona una obra amb una obra que és una obra textual que complementa una obra que és un programa radiofònic."],"cs":["Vztahuje dílo k dílu, které je textovým dílem, doplňujícím dílo, které je rozhlasovým programem."],"da":["Relaterer et værk til et værk, som er et tekstværk, som komplementerer et værk, som er et radioprogram."],"de":["Setzt ein Werk in Beziehung zu einem textlichen Werk, das eine Hörfunksendung (Werk) ergänzt.,Setzt ein Werk in Beziehung zu einem textlichen Werk, das eine Hörfunksendung (Werk) ergänzt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο παρέχει κείμενο για ένα ραδιοφωνικό πρόγραμμα."],"en":["Relates a work to a work that is textual work that complements a work that is a radio program."],"es":["Relaciona una obra con una obra que es una obra textual que complementa una obra que es un programa de radio."],"et":["Seostab teose tekstteosega, mis täiendab raadioteost."],"fi":["Liittää teoksen teokseen, joka on tekstiteos, joka täydentää teosta, joka on radio-ohjelma."],"fr":["Met une œuvre en relation avec une œuvre textuelle qui complète une œuvre consistant en une émission de radio."],"hu":["Hozzákapcsol egy művet egy szöveges műhöz, amely kiegészít egy rádióműsor művet."],"it":["Correla un’opera a un’opera testuale che completa un’opera che è un programma radiofonico."],"lv":["Sasaista darbu ar darbu, kas ir realizēts kā teksts, kas papildina darbu, kas ir radio raidījums."],"nl":["Relateert een werk aan een werk dat een tekstwerk is dat een werk complementeert dat een radioprogramma is."],"no":["Relaterer et verk til et verk som er et tekstlig verk som utfyller et verk som er et radioprogram."],"tr":["Bir eseri, radyo programı olan bir eseri tamamlayan metinsel bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm cung cấp văn bản cho chương trình truyền thanh."],"zh-Hans-CN":["将一种作品与补充作为一种广播节目的一种作品的作为一种文字作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل نص إذاعي","ca":"obra de guió radiofònic","cs":"rozhlasový scénář (dílo)","da":"radiomanuskriptværk","de":"Hörfunkskript (Werk)","de":"Hörfunkskript (Werk)","el":"ραδιοφωνικό σενάριο (έργο)","en":"radio script work","es":"obra de guion de radio","et":"raadiostsenaarium (teos)","fi":"radio-ohjelman käsikirjoitu