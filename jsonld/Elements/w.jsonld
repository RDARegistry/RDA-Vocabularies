                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/commemoration.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10294", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/commemoration.en", "label":"has commemoration"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10294", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/commemoration.en", "label":"has commemoration"}]},{"@id":"http://rdaregistry.info/Elements/w/P10295","label":{"ar":"هو إحياء ذكرى أو تكريم لـ","ca":"és commemoració de","cs":"je připomínkou (čeho)","da":"er mindemarkering af","de":"ist Gedenkschrift für","de":"ist Gedenkschrift für","el":"είναι μνεία του","en":"is commemoration of","es":"es la conmemoración de","et":"mälestusteos teosele","fi":"muistoteos teokselle","fr":"est une commémoration de","hu":"megemlékezés a következőről:","it":"è celebrazione di","lv":"ir radīts piemiņai","nl":"is herdenking van","no":"er minneskrift for","tr":"anılmasıdır","vi":"có tưởng niệm của","zh-Hans-CN":"是……的纪念"},"definition":{"ar":["يربط عمل بعمل تم الاحتفاء به في عمل لاحق."],"ca":["Relaciona una obra amb una obra que es commemora en una obra posterior."],"cs":["Vztahuje dílo k dílu, které je připomínáno v pozdějším díle."],"da":["Relaterer et værk til et værk, som mindes i et senere værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dem durch ein späteres Werk gedacht wird.,Setzt ein Werk in Beziehung zu einem Werk, dem durch ein späteres Werk gedacht wird."],"el":["Συνδέει ένα έργο με ένα έργο που μνημονεύεται σε ένα μεταγενέστερο έργο."],"en":["Relates a work to a work that is commemorated in a later work."],"es":["Relaciona una obra con una obra que se conmemora en una obra posterior."],"et":["Seostab teose teosega, mida hilisemas teoses mälestatakse."],"fi":["Liittää teoksen teokseen, jonka muistona myöhempi teos on."],"fr":["Met une œuvre en relation avec une œuvre qui est commémorée dans une œuvre ultérieure."],"hu":["Egy művet hozzákapcsol egy műhöz, amelyről egy későbbi műben megemlékeznek."],"it":["Correla un’opera a un’opera celebrata in un’opera successiva."],"lv":["Sasaista darbu ar darbu, kura piemiņai radīts vēlākais darbs."],"nl":["Relateert een werk aan een werk dat is herdacht in een later werk."],"no":["Relaterer et verk til et verk som et senere verk er skapt til minne om."],"tr":["Bir eseri, daha sonraki bir eserde anılan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được tưởng niệm trong tác phẩm sau này."],"zh-Hans-CN":["将一种作品与被一种较晚作品纪念的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إحياء ذكرى أو تكريم لـ","ca":"commemoració de","cs":"připomínka (čeho)","da":"mindemarkering af","de":"Gedenkschrift für","de":"Gedenkschrift für","el":"μνεία του","en":"commemoration of","es":"conmemoración de","et":"mälestusteos teosele","fi":"muistoteos teokselle","fr":"commémoration de","hu":"megemlékezés a következőről:","it":"celebrazione di","lv":"radīts piemiņai","nl":"herdenking van","no":"minneskrift for","tr":"anılması","vi":"tưởng niệm của","zh-Hans-CN":"……的纪念"},"ToolkitDefinition":{"ar":"عمل تم الاحتفاء به في عمل لاحق.","ca":"Obra que es commemora en una obra posterior.","cs":"Dílo, které je připomínáno v pozdějším díle.","da":"Værk, som mindes i et senere værk.","de":"Ein Werk, dem durch ein späteres Werk gedacht wird.","de":"Ein Werk, dem durch ein späteres Werk gedacht wird.","el":"Ένα έργο που μνημονεύεται σε ένα μεταγενέστερο έργο.","en":"A work that is commemorated in a later work.","es":"Una obra que se conmemora en una obra posterior.","et":"Teos, mida hilisemas teoses mälestatakse.","fi":"Teos, jonka muistona myöhempi teos on.","fr":"Œuvre qui est commémorée dans une œuvre ultérieure.","hu":"Egy mű, amelyről egy későbbi mű megemlékezik.","it":"Opera celebrata in un’opera successiva.","lv":"Darbs, kura piemiņai radīts vēlākais darbs.","nl":"Een werk dat is herdacht in een later werk.","no":"Et verk som et senere verk er skapt til minne om.","tr":"Sonraki bir eserde anılan bir eser","vi":"Tác phẩm được tưởng niệm trong tác phẩm sau này.","zh-Hans-CN":"被一种较晚作品纪念的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
