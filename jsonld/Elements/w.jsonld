                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/spokenWordForWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10375", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/spokenWordForWork.en", "label":"is spoken word for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10375", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/spokenWordForWork.en", "label":"is spoken word for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10373","label":{"ar":"له عمل كلمات منطوقة","ca":"té com a obra de paraula parlada","cs":"má mluvené slovo (dílo)","da":"har taleværk","de":"hat gesprochenes Wort (Werk)","de":"hat gesprochenes Wort (Werk)","en":"has spoken word work","es":"tiene obra de palabra hablada","et":"kõne (teos)","fi":"puheteos","fr":"a pour œuvre orale","hu":"beszédben kifejezett forrása a következő:","it":"ha come parlato opera","lv":"darbs: mutvārdi","nl":"heeft gesproken woord-werk","no":"har tale (verk)","tr":"sözlü eser ile ilişkilidir","zh-Hans-CN":"有口头表述作品"},"ToolkitLabel":{"ar":"عمل كلمات منطوقة","ca":"obra de paraula parlada","cs":"mluvené slovo (dílo)","da":"taleværk","de":"Gesprochenes Wort (Werk)","de":"Gesprochenes Wort (Werk)","en":"spoken word work","es":"obra de palabra hablada","et":"kõne (teos)","fi":"puheteos","fr":"œuvre orale","hu":"élőszavas mű","it":"parlato opera","lv":"darbs: mutvārdi","nl":"gesproken woord-werk","no":"tale (verk)","tr":"sözlü eser","zh-Hans-CN":"口头表述作品"},"definition":{"ar":["يربط عمل بعمل يتم تحقيقه على أنه كلمة منطوقة ويكمل عملا."],"ca":["Relaciona una obra amb una obra que és una obra vocal i que complementa una obra."],"cs":["Vztahuje dílo k dílu, které je hlasovým dílem a které doplňuje dílo."],"da":["Relaterer et værk til et værk, som realiseres som tale, som komplementerer et værk."],"de":["Setzt ein Werk in Beziehung zu einem gesprochenen Werk, das ein Werk ergänzt.,Setzt ein Werk in Beziehung zu einem gesprochenen Werk, das ein Werk ergänzt."],"en":["Relates a work to a work that is a vocal work and that complements a work."],"es":["Relaciona una obra con una obra que es una obra vocal y que complementa una obra."],"et":["Seostab teose teosega, mis on realiseeritud kõnena ja täiendab teost."],"fi":["Liittää teoksen teokseen, joka on puheteos ja joka täydentää teosta."],"fr":["Met une œuvre en relation avec une œuvre vocale qui complète une œuvre."],"hu":["Hozzákapcsol egy művet egy beszédműhöz, amelyet egy mű egészít ki."],"it":["Correla un'opera a un'opera realizzata come parlato che completa un'opera."],"lv":["Sasaista darbu ar darbu, kas ir realizēts kā mutvārdi, kas papildina citu darbu."],"nl":["Relateert een werk aan een werk dat is een vocaal werk en dat een werk complementeert."],"no":["Relaterer et verk til et verk som realiseres som tale som utfyller et verk."],"tr":["Bir eseri, sesli bir eser olan ve bir eseri tamamlayan bir eserle ilişkilendirir."],"zh-Hans-CN":["将一种作品与被作为一种人声作品并补充一种作品的一种作品关联起来。"]},"ToolkitDefinition":{"ar":"عمل يتم تحقيقه على أنه كلمة منطوقة ويكمل عملا.","ca":"Obra que és una obra vocal i que complementa una obra.","cs":"Dílo, které je hlasovým dílem a které doplňuje dílo.","da":"Værk, som realiseres som tale, som komplementerer et værk.","de":"Ein gesprochenes Werk, das ein Werk ergänzt.","de":"Ein gesprochenes Werk, das ein Werk ergänzt.","en":"A work that is a vocal work and that complements a work.","es":"Una obra que es una obra vocal y que complementa una obra.","et":"Teos, mis on realiseeritud kõnena ja täiendab teost.","fi":"Teos, joka on puheteos ja joka täydentää teosta.","fr":"Œuvre vocale qui complète une œuvre.","hu":"Egy beszédmű, amelyet egy mű egészít ki.","it":"Opera realizzata come parlato che completa un'opera.","lv":"Darbs, kas ir realizēts kā mutvārdi, kas papildina citu darbu.","nl":"Een werk dat is een vocaal werk en dat een werk complementeert.","no":"Et verk som realiseres som tale som utfyller et verk.","tr":"Sesli bir eser olan ve bir eseri tamamlayan bir çalışma.","zh-Hans-CN":"作为一种人声作品并补充一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
