                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistCorporateBody.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10545", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistCorporateBody.en", "label":"has artist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/P10475", "lexicalAlias":"http://rdaregistry.info/Elements/w/bookArtistCollectiveAgent.en", "label":"has book artist collective agent"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10522", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/bookArtistCorporateBody.en", "label":"has book artist corporate body"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10522", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/bookArtistCorporateBody.en", "label":"has book artist corporate body"}]},{"@id":"http://rdaregistry.info/Elements/w/P10569","label":{"ar":"له عائلة فنانة كتب","ca":"té com a família artista de llibre d’art","cs":"má knižního výtvarníka (rodinu)","da":"har familie, som er bogkunstner","de":"hat Buchkünstlerin/Buchkünstler (Familie)","de":"hat Buchkünstlerin/Buchkünstler (Familie)","en":"has book artist family","es":"tiene familia artista de libros","et":"raamatukunstnik (perekond)","fi":"kirjataiteilija (suku)","fr":"a pour famille artiste du livre","hu":"könyvművész családja a következő:","it":"ha come book artist famiglia","lv":"grāmatu mākslinieks (dzimta/ģimene)","nl":"heeft boekkunstenaar-familie","no":"har bokkunstner (familie)","tr":"kitap sanatçısı ailesi ile ilişkilidir","zh-Hans-CN":"有图书美术家家族"},"definition":{"ar":["يربط بين عمل وعائلة تكون فنانة مسئولة عن استغلال شكل الكتاب أو تغيير بنيته المادية."],"ca":["Relaciona una obra amb una família que és un artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física."],"cs":["Vztahuje dílo k rodině, která je umělcem, odpovědným za zpracování podoby knihy nebo změnu její fyzické struktury."],"da":["Relaterer et værk til en familie, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur."],"de":["Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.,Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist."],"en":["Relates a work to a family who is an artist who is responsible for exploiting the book form or altering its physical structure."],"es":["Relaciona una obra con una familia que es una artista quien es responsable de explotar la forma del libro o alterar su estructura física."],"et":["Seostab teose perekonnaga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest."],"fi":["Liittää teoksen sukuun, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta."],"fr":["Met une œuvre en relation avec une famille artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique."],"hu":["Hozzákapcsol egy művet egy művész családhoz, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért."],"it":["Correla un'opera alla famiglia artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica."],"lv":["Sasaista darbu ar dzimtu/ģimeni, kas atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru."],"nl":["Relateert een werk aan een familie die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur."],"no":["Relaterer et verk til en familie som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur."],"tr":["Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu sanatçı olan bir aileyle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个家族关联起来。"]},"ToolkitLabel":{"ar":"عائلة فنانة كتب","ca":"família artista de llibre d’art","cs":"knižní výtvarník (rodina)","da":"familie, som er bogkunstner","de":"Buchkünstlerin/Buchkünstler (Familie)","de":"Buchkünstlerin/Buchkünstler (Familie)","en":"book artist family","es":"familia artista de libros","et":"raamatukunstnik (perekond)","fi":"kirjataiteilija (suku)","fr":"famille artiste du livre","hu":"könyvművész család:","it":"book artist famiglia","lv":"grāmatu mākslinieks (dzimta/ģimene)","nl":"boekkunstenaar-familie","no":"bokkunstner (familie)","tr":"kitap sanatçısı ailesi","zh-Hans-CN":"图书美术家家族"},"ToolkitDefinition":{"ar":"عائلة تكون فنانة مسئولة عن استغلال شكل الكتاب أو تغيير بنيته المادية.","ca":"Família que és un artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.","cs":"Rodina, která je umělcem, odpovědným za zpracování podoby knihy nebo změnu její fyzické struktury.","da":"Familie, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.","de":"Eine Künstlerin/Ein Künstler (Familie), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","de":"Eine Künstlerin/Ein Künstler (Familie), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.","en":"A family who is an artist who is responsible for exploiting the book form or altering its physical structure.","es":"Una familia que es una artista quien es responsable de explotar la forma del libro o alterar su estructura física.","et":"Perekond, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.","fi":"Suku, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.","fr":"Famille artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.","hu":"Egy művész család, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.","it":" Famiglia artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica.","lv":"Dzimta/ģimene, kas atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.","nl":"Een familie die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.","no":"En familie som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.","tr":"Kitap formunu kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu sanatçı olan bir aile.","zh-Hans-CN":"作为一个艺术家负责开发图书外形或改变其物理结构的一个家族"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
