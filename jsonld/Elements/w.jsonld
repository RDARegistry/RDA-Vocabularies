                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10307", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedRDAEntityOfWork.en", "label":"has related RDA entity of work"},{"@id":"http://rdaregistry.info/Elements/x/P00002", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedWorkOfRDAEntity.en", "label":"has related work of RDA entity"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10228", "lexicalAlias":"http://rdaregistry.info/Elements/w/accompanyingWorkRelationship.en", "label":"has accompanying work relationship with (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10229", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWorkRelationship.en", "label":""},{"@id":"http://rdaregistry.info/Elements/w/P10232", "lexicalAlias":"http://rdaregistry.info/Elements/w/wholePartWorkRelationship.en", "label":"has whole-part work relationship with (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10291", "lexicalAlias":"http://rdaregistry.info/Elements/w/inspirationFor.en", "label":"is inspiration for"},{"@id":"http://rdaregistry.info/Elements/w/P10290", "lexicalAlias":"http://rdaregistry.info/Elements/w/inspiredBy.en", "label":"is inspired by"},{"@id":"http://rdaregistry.info/Elements/w/P10294", "lexicalAlias":"http://rdaregistry.info/Elements/w/commemoration.en", "label":"has commemoration"},{"@id":"http://rdaregistry.info/Elements/w/P10295", "lexicalAlias":"http://rdaregistry.info/Elements/w/commemorationOf.en", "label":"is commemoration of"},{"@id":"http://rdaregistry.info/Elements/w/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en", "label":"is augmented by work"},{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"},{"@id":"http://rdaregistry.info/Elements/w/P10192", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentationOfWork.en", "label":"is augmentation of work"},{"@id":"http://rdaregistry.info/Elements/w/P10264", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectWorkOf.en", "label":"is subject work of"},{"@id":"http://rdaregistry.info/Elements/w/P10019", "lexicalAlias":"http://rdaregistry.info/Elements/w/partOfWork.en", "label":"is part of work"},{"@id":"http://rdaregistry.info/Elements/w/P10147", "lexicalAlias":"http://rdaregistry.info/Elements/w/partWork.en", "label":"has part work"},{"@id":"http://rdaregistry.info/Elements/w/P10122", "lexicalAlias":"http://rdaregistry.info/Elements/w/prequelWork.en", "label":"has prequel work"},{"@id":"http://rdaregistry.info/Elements/w/P10296", "lexicalAlias":"http://rdaregistry.info/Elements/w/referentialWorkRelationship.en", "label":""},{"@id":"http://rdaregistry.info/Elements/w/P10020", "lexicalAlias":"http://rdaregistry.info/Elements/w/sequelWork.en", "label":"has sequel work"},{"@id":"http://rdaregistry.info/Elements/w/P10231", "lexicalAlias":"http://rdaregistry.info/Elements/w/sequentialWorkRelationship.en", "label":""},{"@id":"http://rdaregistry.info/Elements/w/P10257", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectWork.en", "label":"has subject work"},{"@id":"http://rdaregistry.info/Elements/w/P10336", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformation.en", "label":"has transformation"},{"@id":"http://rdaregistry.info/Elements/w/P10337", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationOf.en", "label":"is transformation of"},{"@id":"http://rdaregistry.info/Elements/w/object/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/relatedWorkOfWork.en", "label":"has related work of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/relatedWorkOfWork.en", "label":"has related work of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10180","label":{"ar":"هو فهرس لعمل","ca":"és catàleg d’una obra","da":"er katalog over værk","de":"ist Katalog von (Werk)","el":"είναι κατάλογος του (έργο)","en":"is catalogue of work (Deprecated)","et":"kataloog teosele","fi":"luettelo teoksesta","fr":"est un catalogue d’une œuvre","hu":"katalógusa a következő műnek:","it":"è catalogo di opera","lv":"ir katalogs darbam","nl":"is catalogus van werk","no":"er katalog over verk","vi":"là mục lục của (tác phẩm)"},"definition":{"ar":["يربط عمل بعمل يُستخدم كأساس لحصر كامل للمفردات المرتبة منهجيا."],"ca":["Relaciona una obra amb una obra usada com a base d’una enumeració completa d’ítems arranjats sistemàticament."],"da":["Relaterer et værk til et værk, som anvendes som grundlag for en komplet fortegnelse over eksemplarer, som er arrangeret systematisk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine vollständige Aufzählung von systematisch angeordneten Elementen verwendet wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για έναν κατάλογο, μια πλήρη δηλαδή απαρίθμηση των αντιτύπων συστηματικά οργανωμένων."],"en":["Relates a work to a work used as a basis for a complete enumeration of items arranged systematically. (Deprecated)"],"et":["Seostab teose teosega, mis on aluseks süstematiseeritud sissekannete terviklikule loetelule."],"fi":["Liittää teoksen systemaattisesti järjestetyn kohteiden täydellisen listauksen perustana käytettyyn teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui sert de base à une énumération complète d’items classés systématiquement."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet alapként használnak szisztematikusan elrendezett példányok teljes felsorolásához."],"it":["Correla un'opera a un'opera usata come base per una completa enumerazione di item collocati sistematicamente."],"lv":["Sasaista darbu ar darbu, kas izmantots par pamatu katalogam, t.i., sistemātiski sakārtotu vienību pilnīgam uzskaitījumam."],"nl":["Relateert een werk aan een werk gebruikt als een basis voor een complete opsomming van systematisch geordende items."],"no":["Relaterer et verk til et verk som brukt som utgangspunkt for en fullstendig og systematisk ordnet liste over eksemplarer."],"vi":["Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho mục lục, nghĩa là, bảng kê hoàn chỉnh các bản được sắp xếp có hệ thống."]},"ToolkitLabel":{"ar":"فهرس لعمل","ca":"catàleg d’una obra","da":"katalog over værk","de":"Katalog von (Werk)","el":"κατάλογος του (έργο)","en":"catalogue of work (Deprecated)","es":"catálogo de (obra)","et":"kataloog teosele","fi":"luettelo teoksesta","fr":"catalogue d’une œuvre","hu":"katalogizált mű","it":"catalogo di opera","lv":"katalogs darbam","nl":"catalogus van werk","no":"katalog over verk","vi":"mục lục của (tác phẩm)"},"ToolkitDefinition":{"ar":"عمل يُستخدم كأساس لحصر كامل للمفردات المرتبة منهجيا.","ca":"Obra usada com a base d’una enumeració completa d’ítems arranjats sistemàticament.","da":"Værk, som anvendes som grundlag for en komplet fortegnelse over eksemplarer, som er arrangeret systematisk.","de":"Ein Werk, das als Grundlage für eine vollständige Aufzählung von systematisch angeordneten Elementen verwendet wird.","el":"Ένα έργο το οποίο χρησιμοποιείται ως η βάση για έναν κατάλογο, μια πλήρη δηλαδή απαρίθμηση των αντιτύπων συστηματικά οργανωμένων.","en":"A work used as a basis for a complete enumeration of items arranged systematically. (Deprecated)","es":"Una obra utilizada como base de un catálogo, i.e., una enumeración total de ítems ordenados sistemáticamente.","et":"Teos, mis on aluseks süstematiseeritud sissekannete terviklikule loetelule.","fi":"Systemaattisesti järjestetyn kohteiden täydellisen listauksen perustana käytetty teos.","fr":"Œuvre qui sert de base à une énumération complète d’items classés systématiquement.","hu":"Egy mű, amelyet alapként használnak szisztematikusan elrendezett példányok teljes felsorolásához.","it":"Opera usata come base per una completa enumerazione di item collocati sistematicamente.","lv":"Darbs, kas izmantots par pamatu katalogam, t.i., sistemātiski sakārtotu vienību pilnīgam uzskaitījumam.","nl":"Een werk gebruikt als een basis voor een complete opsomming van systematisch geordende items.","no":"Et verk som brukt som utgangspunkt for en fullstendig og systematisk ordnet liste over eksemplarer.","vi":"Tác phẩm được sử dụng như là cơ sở cho mục lục, nghĩa là, bảng kê hoàn chỉnh các bản được sắp xếp có hệ thống."},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10192", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentationOfWork.en", "label":"is augmentation of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/catalogueOfWork.en","instructionNumber":"24.5","status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1008",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Deprecated.en",
                                                                                    "label": "Deprecated"
                                                                                },"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10180", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/catalogueOfWork.en", "label":"is catalogue of work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10180", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/catalogueOfWork.en", "label":"is catalogue of work (Deprecated)"}]},{"@id":"http://rdaregistry.info/Elements/w/P10155","label":{"ar":"هو معالج كعمل","ca":"és adaptat com a obra","cs":"je adaptováno jako dílo","da":"er bearbejdet til værk","de":"ist bearbeitet als (Werk)","de":"ist bearbeitet als (Werk)","el":"είναι προσαρμοσμένο ως (έργο)","en":"is adapted as work","es":"es adaptado como obra","et":"adapteeritud teosena","fi":"mukaelma (teos)","fr":"est adapté comme une œuvre","hu":"műfeldolgozása a következő:","it":"è adattata come opera","lv":"ir adaptēts kā darbs","nl":"is bewerkt als werk","no":"er bearbeidet som verk","tr":"eser olarak uyarlanmıştır","vi":"được phỏng theo như là (tác phẩm)","zh-Hans-CN":"被改编为作品"},"definition":{"ar":["يربط عمل بعمل يقوم بتعديل عمل آخر لغرض، أو استخدام، أو وسيط غير ما كان معنيًّا في الأصل."],"ca":["Relaciona una obra amb una obra que modifica una altra obra per a un objectiu, un ús o un suport diferent d’aquell per al qual es va concebre originalment."],"cs":["Vztahuje dílo k dílu, které modifikuje jiné dílo pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno."],"da":["Relaterer et værk til et værk, som modificerer et oprindeligt værk til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet als den/die/das, wofür es ursprünglich konzipiert war.,Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet als den/die/das, wofür es ursprünglich konzipiert war."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο τροποποιεί ένα έργο-πηγή για έναν σκοπό, χρήση ή μέσο άλλο από εκείνο για το οποίο αρχικά προοριζόταν."],"en":["Relates a work to a work that modifies another work for a purpose, use, or medium other than that for which it was originally intended."],"es":["Relaciona una obra con una obra que modificada una obra para un propósito, uso o medio diferente a aquel para el cual estaba originalmente destinada."],"et":["Seostab teose teosega, mis muudab allikteost algupärasest erineva otstarbe, kasutusviisi või meediumi jaoks."],"fi":["Liittää teoksen teokseen, joka muokkaa toista teosta jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten."],"fr":["Met une œuvre en relation avec une œuvre qui modifie une autre œuvre pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik művet olyan célra, használatra vagy médiumra módosít, amely más, mint amit eredetileg terveztek."],"it":["Correla un’opera a un’opera modificata per uno scopo, utilizzo o mezzo diversi da quelli per cui era stata pensata in origine."],"lv":["Sasaista darbu ar darbu, kurā ir mainīts pamatdarba nolūks, lietojums vai medijs."],"nl":["Relateert een werk aan een werk dat een ander werk aangepast voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was."],"no":["Relaterer et verk til et verk som bearbeider et kildeverk til et annet formål, bruksområde eller medium enn det opprinnelig var ment for."],"tr":["Bir eseri, orijinal olarak amaçlanandan farklı bir amaç, kullanım veya ortam için başka bir eseri değiştiren bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sửa đổi tác phẩm nguồn cho mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc."],"zh-Hans-CN":["将一种作品与以不同于起初意图的目的、使用或媒介修改另一种作品的一种作品关联起来。"]},"note":{"ar":["هذا العنصر ينطبق على التغييرات في الشكل أو في الأعمال المعاد كتابتها بالكامل بنفس الشكل."],"ca":["Aquest element s’aplica a canvis en la forma o a obres que han estat reescrites completament en la mateixa forma."],"cs":["Tento prvek se vztahuje na změny formy nebo na díla kompletně přepsaná ve stejné formě."],"da":["Dette element gælder for ændringer i form eller for værker, som er omskrevet fuldstændigt i samme form."],"de":["Dies Element bezieht sich auf Änderungen der Form oder auf Werke, die in derselben Form vollständig neu geschrieben sind.,Dies Element bezieht sich auf Änderungen der Form oder auf Werke, die in derselben Form vollständig neu geschrieben sind."],"el":["Αυτή η σχέση βρίσκει εφαρμογή στις αλλαγές στη μορφή ή στα έργα που έχουν ξαναγραφτεί ολοκληρωτικά στην ίδια μορφή."],"en":["This element applies to changes in form or to works completely rewritten in the same form."],"es":["Este elemento aplica a cambios en la forma o a obras completamente reescritas en la misma forma."],"et":["Elementi rakendatakse muutuste puhul vormis või teoste puhul, mis on täielikult ümber kirjutatud samas vormis."],"fi":["Tämä elementti soveltuu muutoksiin muodossa tai samassa muodossa kokonaan uudelleenmuokattuihin teoksiin."],"fr":["Cet élément s’applique aux changements dans la forme ou aux œuvres complètement réécrites dans la même forme."],"hu":["Ez az elem érvényes a formai változásokra, vagy az ugyanabban a formában teljesen újraírt művekre."],"it":["Questo elemento si applica ai cambiamenti di forma o a opere completamente riscritte nella stessa forma."],"lv":["Elements attiecas uz izmaiņām darba formā un darbiem, kas pilnīgi pārrakstīti tajā pašā formā."],"nl":["Dit element is over het algemeen van toepassing op veranderingen in vorm of op werken die compleet herschreven zijn in dezelfde vorm."],"no":["Dette elementet gjelder endring av form eller verk som er fullstendig omskrevet i samme form."],"tr":["Bu öğe, biçim değişiklikleri veya aynı biçimde tamamen yeniden yazılan eserler için geçerlidir."],"vi":["Nối quan hệ này áp dụng đối với thay đổi về hình thái hoặc đối cới tác phẩm được viết lại toàn bộ dưới cùng hình thái."],"zh-Hans-CN":["该元素适用于形式的改变或者以同样形式完全被改写的作品。"]},"ToolkitLabel":{"ar":"معالج كعمل","ca":"adaptat com a obra","cs":"adaptováno jako dílo","da":"bearbejdet til værk","de":"Bearbeitet als (Werk)","de":"Bearbeitet als (Werk)","el":"προσαρμοσμένο ως (έργο)","en":"adapted as work","es":"adaptado como obra","et":"adapteeritud teosena","fi":"mukaelma (teos)","fr":"adapté comme une œuvre","hu":"műként átdolgozva:","it":"adattata come opera","lv":"adaptēts kā darbs","nl":"bewerkt als werk","no":"bearbeidet som verk","tr":"Eser olarak uyarlanan","vi":"được phỏng theo như là (tác phẩm)","zh-Hans-CN":"被改编为作品"},"ToolkitDefinition":{"ar":"عمل يعدل عمل آخر لغرض، أو استخدام، أو وسيط غير ذلك ما كان معنيَّا في الأصل.","ca":"Obra que modifica una altra obra per a un objectiu, un ús o un suport diferent d’aquell per al qual es va concebre originalment.","cs":"Dílo, které modifikuje jiné dílo pro jiný účel, použití nebo médium, než pro které bylo původně zamýšleno.","da":"Værk, som modificerer et oprindeligt værk til et andet formål, en anden brug eller et andet medium end det, det oprindeligt var beregnet til.","de":"Ein Werk, das ein anderes Werk für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet als den/die/das, wofür es ursprünglich konzipiert war.","de":"Ein Werk, das ein anderes Werk für einen anderen Zweck, eine andere Nutzung oder ein anderes Medium bearbeitet als den/die/das, wofür es ursprünglich konzipiert war.","el":"Ένα έργο το οποίο τροποποιεί ένα έργο-πηγή για έναν σκοπό, χρήση ή μέσο άλλο από εκείνο για το οποίο αρχικά προοριζόταν.","en":"A work that modifies another work for a purpose, use, or medium other than that for which it was originally intended.","es":"Una obra que modificada una obra para un propósito, uso o medio diferente a aquel para el cual estaba originalmente destinada.","et":"Teos, mis muudab allikteost algupärasest erineva otstarbe, kasutusviisi või meediumi jaoks.","fi":"Teos, joka muokkaa toista teosta jotain muuta kuin alkuperäistä tarkoitusta, käyttöä tai esitysmuotoa varten.","fr":"Œuvre qui modifie une autre œuvre pour une fin, une utilisation ou un mode d’expression autre que celui auquel elle était destinée à l’origine.","hu":"Egy mű, amely egy másik művet olyan célra, használatra vagy médiumra módosít, amely más, mint amit eredetileg terveztek.","it":"Opera modificata per uno scopo, utilizzo o diversi da quelli per cui era stata pensata in origine.","lv":"Darbs, kurā ir mainīts pamatdarba nolūks, lietojums vai medijs.","nl":"Een werk dat een ander werk aangepast voor een doel, gebruik, of medium anders dan dat waarvoor het oorspronkelijk bedoeld was.","no":"Et verk som bearbeider et kildeverk til et annet formål, bruksområde eller medium enn det opprinnelig var ment for.","tr":"Başka bir eseri, orijinal olarak tasarlandığından farklı bir amaç, kullanım veya ortam için değiştiren bir eser.","vi":"Tác phẩm sửa đổi tác phẩm nguồn cho mục đích, sử dụng, hoặc phương tiện khác với ý định nguyên gốc.","zh-Hans-CN":"以不同于起初意图的目的、使用或媒介修改另一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10148", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWork.en", "label":"has derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10095", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsScreenplayWork.en", "label":"is adapted as screenplay work"},{"@id":"http://rdaregistry.info/Elements/w/P10251", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsGraphicNovelWork.en", "label":"is adapted as graphic novel work"},{"@id":"http://rdaregistry.info/Elements/w/P10091", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsChoreographyWork.en", "label":"is adapted as choreography work"},{"@id":"http://rdaregistry.info/Elements/w/P10025", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsMotionPictureWork.en", "label":"is adapted as motion picture work"},{"@id":"http://rdaregistry.info/Elements/w/P10016", "lexicalAlias":"http://rdaregistry.info/Elements/w/dramatizedAsWork.en", "label":"is dramatized as work"},{"@id":"http://rdaregistry.info/Elements/w/P10113", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsLibrettoWork.en", "label":"is adapted as libretto work"},{"@id":"http://rdaregistry.info/Elements/w/P10236", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsOperaWork.en", "label":"is adapted as opera work"},{"@id":"http://rdaregistry.info/Elements/w/P10289", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsOratorioWork.en", "label":"is adapted as oratorio work"},{"@id":"http://rdaregistry.info/Elements/w/P10076", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsRadioProgramWork.en", "label":"is adapted as radio program work"},{"@id":"http://rdaregistry.info/Elements/w/P10098", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsRadioScriptWork.en", "label":"is adapted as radio script work"},{"@id":"http://rdaregistry.info/Elements/w/P10034", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsNovelWork.en", "label":"is adapted as novel work"},{"@id":"http://rdaregistry.info/Elements/w/P10085", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsTelevisionProgramWork.en", "label":"is adapted as television program work"},{"@id":"http://rdaregistry.info/Elements/w/P10023", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedInVerseAsWork.en", "label":"is adapted in verse as work"},{"@id":"http://rdaregistry.info/Elements/w/P10249", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsVideoGameWork.en", "label":"is adapted as video game work"},{"@id":"http://rdaregistry.info/Elements/w/P10087", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsVideoWork.en", "label":"is adapted as video work"},{"@id":"http://rdaregistry.info/Elements/w/P10235", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsMusicalTheatreWork.en", "label":"is adapted as musical theatre work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsWork.en", "label":"is adapted as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsWork.en", "label":"is adapted as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10166","label":{"ar":"هو معاد صياغته كعمل","ca":"és parafrasejat com a obra","cs":"je parafrázováno jako dílo","da":"er parafraseret som værk","de":"ist paraphrasiert als (Werk)","de":"ist paraphrasiert als (Werk)","el":"είναι παραφρασμένο ως (έργο)","en":"is paraphrased as work","es":"es parafraseado como obra","et":"parafraseeritud teosena","fi":"parafraasi (teos)","fr":"est paraphrasé comme une œuvre","hu":"parafrazeálja a következő mű:","it":"è parafrasata come opera","lv":"darba parafrāze","nl":"is parafrase als werk","no":"er omskrevet som verk","tr":"eser olarak yeniden yorumlanmıştır","vi":"được diễn giải như là (tác phẩm)","zh-Hans-CN":"被演绎为作品"},"definition":{"ar":["يربط عمل بعمل يعيد صياغة محتوى عمل آخر في شكل مختلف."],"ca":["Relaciona una obra amb una obra que replanteja el contingut d’una altra obra en una forma diferent."],"cs":["Vztahuje dílo k dílu, které přetváří obsah jiného díla v odlišné formě."],"da":["Relaterer et værk til et værk, som gentager et oprindeligt værks indhold i en anden form."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Inhalt eines anderen Werks in einer anderen Form neu darstellt.,Setzt ein Werk in Beziehung zu einem Werk, das den Inhalt eines anderen Werks in einer anderen Form neu darstellt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο αναδιατυπώνει το περιεχόμενο ενός έργου-πηγής σε μια διαφορετική μορφή."],"en":["Relates a work to a work that restates the content of another work in a different form."],"es":["Relaciona una obra con una obra que replantea el contenido de una obra de una forma distinta."],"et":["Seostab teose teosega, mis väljendab allikteose sisu teises vormis."],"fi":["Liittää teoksen teokseen, joka toisintaa toisen teoksen sisällön eri muodossa."],"fr":["Met une œuvre en relation avec une œuvre qui reprend le contenu d’une autre œuvre sous une formulation différente."],"hu":["Hozzákapcsol egy művet egy műhöz, amely eltérő formában fogalmazza újra egy másik mű tartalmát."],"it":["Correla un’opera a un’opera che riformula il contenuto di un’opera di partenza in una forma differente."],"lv":["Sasaista darbu ar darbu, kas izsaka pamatdarba saturu citā formā."],"nl":["Relateert een werk aan een werk dat de content van een ander werk in een andere vorm formuleert."],"no":["Relaterer et verk til et verk som gjentar et kildeverks innhold i en annen form."],"tr":["Bir eseri, başka bir eserin içeriğini farklı bir biçimde yeniden ifade eden bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm trình bày lại nội dung của tác phẩm nguồn dưới hình thái khác."],"zh-Hans-CN":["将一种作品与用不同形式重述另一种作品之内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معاد صياغته كعمل","ca":"parafrasejat com a obra","cs":"parafrázováno jako dílo","da":"parafraseret som værk","de":"Paraphrasiert als (Werk)","de":"Paraphrasiert als (Werk)","el":"παραφρασμένο ως (έργο)","en":"paraphrased as work","es":"parafraseado como obra","et":"parafraseeritud teosena","fi":"parafraasi (teos)","fr":"paraphrasé comme une œuvre","hu":"parafrazeáló mű:","it":"parafrasata come opera","lv":"darbs: parafrāze","nl":"parafrase als werk","no":"omskrevet som verk","tr":"Eser olarak yorumlanmıştır","vi":"được diễn giải như là (tác phẩm)","zh-Hans-CN":"被演绎为作品"},"ToolkitDefinition":{"ar":"عمل يعيد صياغة محتوى عمل آخر في شكل مختلف.","ca":"Obra que replanteja el contingut d’una altra obra en una forma diferent.","cs":"Dílo, které přetváří obsah jiného díla v odlišné formě.","da":"Værk, som gentager et oprindeligt værks indhold i en anden form.","de":"Ein Werk, das den Inhalt eines anderen Werks in einer anderen Form neu darstellt.","de":"Ein Werk, das den Inhalt eines anderen Werks in einer anderen Form neu darstellt.","el":"Ένα έργο το οποίο αναδιατυπώνει το περιεχόμενο ενός έργου-πηγής σε μια διαφορετική μορφή.","en":"A work that restates the content of another work in a different form.","es":"Una obra que replantea el contenido de una obra de una forma distinta.","et":"Teos, mis väljendab allikteose sisu teises vormis.","fi":"Teos, joka toisintaa toisen teoksen sisällön eri muodossa.","fr":"Œuvre qui reprend le contenu d’une autre œuvre sous une formulation différente.","hu":"Egy mű, amely eltérő formában fogalmazza újra egy másik mű tartalmát.","it":"Opera che riformula il contenuto di un’opera di partenza in una forma differente.","lv":"Darbs, kas izsaka pamatdarba saturu citā formā","nl":"Een werk dat de content van een ander werk in een andere vorm formuleert.","no":"Et verk som gjentar et kildeverks innhold i en annen form.","tr":"Başka bir çalışmanın içeriğini farklı bir biçimde yeniden ifade eden bir çalışma.","vi":"Tác phẩm trình bày lại nội dung của tác phẩm nguồn dưới hình thái khác.","zh-Hans-CN":"用不同形式重述另一种作品之内容的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10340", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyle.en", "label":"has transformation by style"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/paraphrasedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10166", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/paraphrasedAsWork.en", "label":"is paraphrased as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10166", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/paraphrasedAsWork.en", "label":"is paraphrased as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10119","label":{"ar":"هو موسع كعمل","ca":"és ampliat com a obra","cs":"je rozšířeno jako dílo","da":"er udvidet som værk","de":"ist erweitert als (Werk)","de":"ist erweitert als (Werk)","el":"είναι επεκτεινόμενο ως (έργο)","en":"is expanded as work","es":"es ampliado como obra","et":"laiendatud teosena","fi":"laajennelma (teos)","fr":"est augmenté comme une œuvre","hu":"tágítva a következő műben:","it":"è ampliata come opera","lv":"ir paplašinājums (darbs)","nl":"is uitgebreid als werk","no":"er utvidet som verk","tr":"eser olarak genişletilmiştir","vi":"được mở rộng như là (tác phẩm)","zh-Hans-CN":"被扩充为作品"},"definition":{"ar":["يربط عمل بعمل يتوسع في محتوى عمل آخر."],"ca":["Relaciona una obra amb una obra que amplia el contingut d’una altra obra."],"cs":["Vztahuje dílo k dílu, které je rozšířením obsahu jiného díla."],"da":["Relaterer et værk til et værk, som uddyber et oprindeligt værks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Inhalt eines anderen Werks erweitert.,Setzt ein Werk in Beziehung zu einem Werk, das den Inhalt eines anderen Werks erweitert."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο επεκτείνει το περιεχόμενο ενός έργου-πηγής."],"en":["Relates a work to a work that enlarges upon the content of another work."],"es":["Relaciona una obra con una obra que amplía el contenido de otra obra."],"et":["Seostab teose teosega, milles on avardatud allikteose sisu."],"fi":["Liittää teoksen teokseen, joka laajentaa toisen teoksen sisältöä."],"fr":["Met une œuvre en relation avec une œuvre qui accroît le contenu d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik mű tartalmát tágítja."],"it":["Correla un’opera a un’opera che amplia il contenuto di un’opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir saturiski paplašināts pamatdarbs."],"nl":["Relateert een werk aan een werk dat de content van een ander werk uitbreidt."],"no":["Relaterer et verk til et verk som utvider innholdet fra et kildeverk."],"tr":["Bir eseri, başka bir eserin içeriğini genişleten bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mở rộng nội dung của tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与在另一种作品的内容上扩充的一种作品关联起来。"]},"ToolkitLabel":{"ar":"موسع كعمل","ca":"ampliat com a obra","cs":"rozšířeno jako dílo","da":"udvidet som værk","de":"Erweitert als (Werk)","de":"Erweitert als (Werk)","el":"επεκτεινόμενο ως (έργο)","en":"expanded as work","es":"ampliado como obra","et":"laiendatud teosena","fi":"laajennelma (teos)","fr":"augmenté comme une œuvre","hu":"bővítő mű:","it":"ampliata come opera","lv":"paplašinājums (darbs)","nl":"uitgebreid als werk","no":"utvidet som verk","tr":"eser olarak genişletilmiş","vi":"được mở rộng như là (tác phẩm)","zh-Hans-CN":"被扩充为作品"},"ToolkitDefinition":{"ar":"عمل يتوسع في محتوى عمل آخر.","ca":"Obra que amplia el contingut d’una altra obra.","cs":"Dílo, které je rozšířením obsahu jiného díla.","da":"Værk, som uddyber et oprindeligt værks indhold.","de":"Ein Werk, das den Inhalt eines anderen Werks erweitert.","de":"Ein Werk, das den Inhalt eines anderen Werks erweitert.","el":"Ένα έργο το οποίο επεκτείνει το περιεχόμενο ενός έργου-πηγής.","en":"A work that enlarges upon the content of another work.","es":"Una obra que amplía el contenido de otra obra.","et":"Teos, milles on avardatud allikteose sisu.","fi":"Teos, joka laajentaa toisen teoksen sisältöä.","fr":"Œuvre qui accroît le contenu d’une autre œuvre.","hu":"Egy mű, amely egy másik mű tartalmát tágítja.","it":"Opera che amplia il contenuto di un’opera di partenza.","lv":"Saturiski paplašināts pamatdarbs.","nl":"Een werk dat de content van een ander werk uitbreidt.","no":"Et verk som utvider innholdet fra et kildeverk.","tr":"Başka bir eserin içeriğini genişleten bir eser.","vi":"Tác phẩm mở rộng nội dung của tác phẩm nguồn.","zh-Hans-CN":"在另一种作品的内容上扩充的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10148", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWork.en", "label":"has derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/expandedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10119", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/expandedAsWork.en", "label":"is expanded as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10119", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/expandedAsWork.en", "label":"is expanded as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10016","label":{"ar":"هو معدل دراميًا كعمل","ca":"és dramatitzat com a obra","cs":"je dramatizováno jako dílo","da":"er dramatiseret som værk","de":"ist Bühnenbearbeitung als (Werk)","de":"ist Bühnenbearbeitung als (Werk)","el":"είναι δραματοποιημένο ως (έργο)","en":"is dramatized as work","es":"es dramatizada como obra","et":"dramatiseeritud teosena","fi":"dramatisointi (teos)","fr":"est adapté au théâtre comme une œuvre","hu":"dramatizált változata a következő mű:","it":"è drammatizzata come opera","lv":"ir dramatizējums (darbs)","nl":"is gedramatiseerd als werk","no":"er dramatisert som verk","tr":"eser olarak dramatize edilmiştir","vi":"được kịch hoá như là (tác phẩm)","zh-Hans-CN":"被戏剧化为作品"},"definition":{"ar":["يربط عمل بعمل درامي مقتبس من عمل آخر."],"ca":["Relaciona una obra amb una obra que és una obra dramàtica que s’adapta d’una altra obra."],"cs":["Vztahuje dílo k dílu, které je dramatickým dílem, adaptovaným z jiného díla."],"da":["Relaterer et værk til et dramatisk værk, som er bearbejdet ud fra et andet værk."],"de":["Setzt ein Werk in Beziehung zu einem Theaterstück (Werk), das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Theaterstück (Werk), das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα θεατρικό έργο προσαρμοσμένο από ένα έργο-πηγή."],"en":["Relates a work to a work that is a dramatic work that is adapted from another work."],"es":["Relaciona una obra con una obra que es una obra dramática que es adaptada de otra obra."],"et":["Seostab teose draamateosega, mis on adapteeritud teisest teosest."],"fi":["Liittää teoksen teokseen, joka on draamateos, joka on sovitettu toisesta teoksesta."],"fr":["Met une œuvre en relation avec une œuvre dramatique qui est adaptée d’une autre œuvre."],"hu":["Egy művet hozzákapcsol egy drámai műhöz, amelyet egy másik műből dolgoztak át."],"it":["Correla un’opera a un’opera teatrale adattata da un’altra opera."],"lv":["Sasaista darbu ar darbu, kas ir dramatizējums (darbs), kas veidots no pamatdarba."],"nl":["Relateert een werk aan een werk dat is een theaterwerk dat is een bewerking van een ander werk."],"no":["Relaterer et verk til et dramatisk verk som er bearbeidet fra et annet verk."],"tr":["Bir eseri, başka bir eserden uyarlanan dramatik eser olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm kịch được phỏng theo tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为一种戏剧作品并改编自另一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معدل دراميًا كعمل","ca":"dramatitzat com a obra","cs":"dramatizováno jako dílo","da":"dramatiseret som værk","de":"Bühnenbearbeitung als (Werk)","de":"Bühnenbearbeitung als (Werk)","el":"δραματοποιημένο ως (έργο)","en":"dramatized as work","es":"dramatizada como obra","et":"dramatiseeritud teosena","fi":"dramatisointi (teos)","fr":"adapté au théâtre comme une œuvre","hu":"dramatizált mű:","it":"drammatizzata come opera","lv":"dramatizējums (darbs)","nl":"gedramatiseerd als werk","no":"dramatisert som verk","tr":"eser olarak dramatize edilmiş","vi":"được kịch hoá như là (tác phẩm)","zh-Hans-CN":"被戏剧化为作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن عمل درامي مقتبس من عمل آخر.","ca":"Obra que és una obra dramàtica que s’adapta d’una altra obra.","cs":"Dílo, které je dramatickým dílem, adaptovaným z jiného díla.","da":"Dramatisk værk, som er bearbejdet ud fra et andet værk.","de":"Ein Theaterstück (Werk), das auf einem anderen Werk basiert.","de":"Ein Theaterstück (Werk), das auf einem anderen Werk basiert.","el":"Ένα θεατρικό έργο προσαρμοσμένο από ένα έργο-πηγή.","en":"A work that is a dramatic work that is adapted from another work.","es":"Una obra que es una obra dramática que es adaptada de otra obra.","et":"Draamateos, mis on adapteeritud teisest teosest.","fi":"Teos, joka on draamateos, joka on sovitettu toisesta teoksesta.","fr":"Œuvre dramatique qui est adaptée d’une autre œuvre.","hu":"Egy drámai mű, amelyet egy másik műből dolgoztak át.","it":"Opera teatrale adattata da un’altra opera.","lv":"Dramatizējums (darbs), kas veidots no pamatdarba.","nl":"Een werk dat is een theaterwerk dat is een bewerking van een ander werk.","no":"Et dramatisk verk som er bearbeidet fra et annet verk.","tr":"Başka bir eserden uyarlanmış bir dramatik eser.","vi":"Tác phẩm kịch được phỏng theo tác phẩm nguồn.","zh-Hans-CN":"作为一种戏剧作品并改编自另一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/dramatizedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10016", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/dramatizedAsWork.en", "label":"is dramatized as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10016", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/dramatizedAsWork.en", "label":"is dramatized as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10107","label":{"ar":"هو مستخلص كعمل","ca":"té resum","cs":"má abstrakt","da":"er sammenfattet som værk","de":"ist Abstract als (Werk)","de":"British abstracts.","el":"είναι επιτομή ως (έργο)","en":"has abstract","es":"tiene síntesis","et":"annoteeritud teosena","fi":"abstrakti","fr":"a pour résumé analytique","hu":"absztraktja a következő mű:","it":"è riassunta come opera","lv":"ir darba anotācija","nl":"heeft abstract","no":"er abstrahert som verk","tr":"özet ile ilişkilidir","vi":"được tóm tắt như là (tác phẩm)","zh-Hans-CN":"有摘要"},"definition":{"ar":["يربط عمل بعمل يختصر عملاً آخر بطريقة موجزة وموضوعية."],"ca":["Relaciona una obra amb una obra que és un sumari objectiu d’un recurs."],"cs":["Vztahuje dílo k dílu, které je objektivním shrnutím díla."],"da":["Relaterer et værk til et værk, som forkorter et andet værk på en kortfattet, objektiv måde."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk auf eine kurze, sachliche Art verkürzt.,Setzt einen Akteur in Beziehung zu einem Werk, das als Zeichen der Anerkennung oder Unterstützung einem in Beziehung stehenden Akteur gewidmet ist."],"el":["Συνδέει ένα έργο με ένα έργο, το οποίο συμπτύσσει ένα έργο-πηγή με έναν σύντομο, αντικειμενικό τρόπο."],"en":["Relates a work to a work that is an objective summary of a work."],"es":["Relaciona una obra con una obra que es una síntesis objetiva de una obra."],"et":["Seostab teose teosega, milles on lühidalt ja objektiivselt kokku võetud teise teose sisu."],"fi":["Liittää teoksen teokseen, joka on teoksen objektiivinen yhteenveto."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un résumé objectif d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű tárgyilagos összefoglalása."],"it":["Correla a un’opera che riassume un’altra opera in maniera sintetica e obiettiva."],"lv":["Sasaista darbu ar darbu, kas ir no darba izveidota anotācija."],"nl":["Relateert een werk aan een werk dat een ander werk inkort op een korte, objectieve wijze."],"no":["Relaterer et verk til et verk som gir et kortfattet, objektivt sammendrag av et annet verk."],"tr":["Bir eseri, bir eserin tarafsız bir özeti olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm tóm tắt tác phẩm nguồn bằng phương thức ngắn gọn, khách quan."],"zh-Hans-CN":["将一种作品与作为一种作品之客观提要的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مستخلص كعمل","ca":"resum","cs":"abstrakt","da":"sammenfattet som værk","de":"Abstract als (Werk)","el":"επιτομή ως (έργο)","en":"abstract","es":"Una obra que es una síntesis objetiva de una obra.","et":"annoteeritud teosena","fi":"abstrakti","fr":"résumé analytique","hu":"absztraktmű:","it":"riassunta come opera","lv":"darba anotācija","nl":"abstract","no":"abstrahert som verk","tr":"özet","vi":"được tóm tắt như là (tác phẩm)","zh-Hans-CN":"摘要"},"ToolkitDefinition":{"ar":"عمل يختصر عملاً آخر بطريقة موجزة وموضوعية.","ca":"Obra que és un sumari objectiu d’un recurs.","cs":"Dílo, které je objektivním shrnutím díla.","da":"Værk, som forkorter et andet værk på en kortfattet, objektiv måde.","de":"Ein Werk, das ein anderes Werk auf eine kurze, sachliche Art verkürzt.","de":"Eine Expressione, die eine Verschmelzung, die des Spielens oder der Vorführung eines Musikwerks oder eines Theaterstücks darstellt.","el":"Ένα έργο το οποίο συμπτύσσει ένα έργο-πηγή με έναν σύντομο, αντικειμενικό τρόπο.","en":"A work that is an objective summary of a work.","es":"Una obra que es una síntesis objetiva de una obra.","et":"Teos, milles on lühidalt ja objektiivselt kokku võetud teise teose sisu.","fi":"Teos, joka on teoksen objektiivinen yhteenveto.","fr":"Œuvre qui consiste en un résumé objectif d’une œuvre.","hu":"Egy mű, amely egy mű tárgyilagos összefoglalása.","it":"Opera che riassume un’altra opera in maniera sintetica e obiettiva.","lv":"No darba izveidota anotācija.","nl":"Een werk dat een ander werk inkort op een korte, objectieve wijze.","no":"Et verk som gir et kortfattet, objektivt sammendrag av et annet verk.","tr":"Bir eserin nesnel bir özeti olan çalışma.","vi":"Tác phẩm tóm tắt tác phẩm nguồn bằng phương thức ngắn gọn, khách quan.","zh-Hans-CN":"作为一种作品之客观提要的一种作品"},"altLabel":{"ca":["resumit com a obra"],"cs":["abstrahováno jako dílo"],"de":["Abstract als (Werk)"],"en":["abstracted as work"],"es":["sintetizado como obra"],"fi":["abstrakti (teos)"],"fr":["résumé analytiquement comme une œuvre"],"nl":["geabstraheerd als werk"],"tr":["eser olarak özetlenen"],"zh-Hans-CN":["被摘要为作品"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10109", "lexicalAlias":"http://rdaregistry.info/Elements/w/summary.en", "label":"has summary"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/abstract.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10107", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/abstract.en", "label":"has abstract"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10107", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/abstract.en", "label":"has abstract"}]},{"@id":"http://rdaregistry.info/Elements/w/P10171","label":{"ar":"هو موجز كعمل","ca":"és compendiat com a obra","cs":"má digest (dílo)","da":"er sammenfattet som værk","de":"ist Digest (Werk)","de":"ist Digest (Werk)","el":"είναι αφομοιωμένο ως (έργο)","en":"is digested as work","es":"es compendiada como obra","et":"refereeritud teosena","fi":"mukautettu lyhennelmä (teos)","fr":"est condensé comme une œuvre","hu":"kivonatolja a következő mű:","it":"è compendiata come opera","lv":"ir īssavilkums (darbs)","nl":"is digest als werk","no":"er forkortet som verk","tr":"eser olarak özetlenmiştir","vi":"được sắp đặt như là (tác phẩm)","zh-Hans-CN":"被编制文摘为作品"},"definition":{"ar":["يربط عمل بعمل يكثف عملًا ذا صلة تكثيفا منهجيا وشاملا."],"ca":["Relaciona una obra amb una obra que condensa sistemàticament i exhaustiva una obra relacionada."],"cs":["Vztahuje dílo k dílu, které systematicky a komplexně shrnuje související dílo."],"da":["Relaterer et værk til et værk, som systematisk og gennemgribende komprimerer et relateret værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das ein in Beziehung stehendes Werk systematisch und umfassend verdichtet.,Setzt ein Werk in Beziehung zu einem Werk, das ein in Beziehung stehendes Werk systematisch und umfassend verdichtet."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο συστηματικά και περιεκτικά συμπυκνώνει ένα έργο-πηγή."],"en":["Relates a work to a work that systematically and comprehensively condenses a related work."],"es":["Relaciona una obra con una obra que sistemática y comprensivamente condensa una obra relacionada."],"et":["Seostab teose teosega, milles seotud teos on süstemaatiliselt ja igakülgselt kokku võetud."],"fi":["Liittää teoksen teokseen, joka systemaattisesti, kokonaisuudessaan ja mukaillen tiivistää siihen liittyvän teoksen."],"fr":["Met une œuvre en relation avec une œuvre qui abrège une œuvre en relation de manière systématique et complète."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy kapcsolódó művet módszeresen és átfogóan tömörít."],"it":["Correla un’opera a un’opera che riassume in maniera sistematica e dettagliata un’opera correlata."],"lv":["Sasaista darbu ar darbu, kas sistemātiski un aptveroši īsi apskata saistīto darbu."],"nl":["Relateert een werk aan een werk dat een gerelateerd werk systematisch en alomvattend concentreert."],"no":["Relaterer et verk til et verk som systematisk forkorter et relatert verk."],"tr":["Bir eseri, ilgili bir eseri sistematik ve kapsamlı bir şekilde özetleyen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm cô gọn một cách có hệ thống và toàn diện tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与系统而全面压缩一种相关作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"موجز كعمل","ca":"compendiat com a obra","cs":"digest (dílo)","da":"sammenfattet som værk","de":"Digest (Werk)","de":"Digest (Werk)","el":"αφομοιωμένο ως (έργο)","en":"digested as work","es":"compendiada como obra","et":"refereeritud teosena","fi":"mukautettu lyhennelmä (teos)","fr":"condensé comme une œuvre","hu":"kivonatmű:","it":"compendiata come opera","lv":"īssavilkums (darbs)","nl":"digest als werk","no":"forkortet som verk","tr":"eser olarak özetlenmiş","vi":"được sắp đặt như là (tác phẩm)","zh-Hans-CN":"被编制文摘为作品"},"ToolkitDefinition":{"ar":"عمل يكثف عملًا ذا صلة تكثيفا منهجيا وشاملا.","ca":"Obra que condensa sistemàticament i exhaustiva una obra relacionada.","cs":"Dílo, které systematicky a komplexně shrnuje související dílo.","da":"Værk, som systematisk og gennemgribende komprimerer et relateret værk.","de":"Ein Werk, das ein in Beziehung stehendes Werk systematisch und umfassend verdichtet.","de":"Ein Werk, das ein in Beziehung stehendes Werk systematisch und umfassend verdichtet.","el":"Ένα έργο το οποίο συστηματικά και περιεκτικά συμπυκνώνει ένα έργο-πηγή.","en":"A work that systematically and comprehensively condenses a related work.","es":"Una obra que sistemática y comprensivamente condensa una obra relacionada.","et":"Teos, milles seotud teos on süstemaatiliselt ja igakülgselt kokku võetud.","fi":"Teos, joka systemaattisesti, kokonaisuudessaan ja mukaillen tiivistää siihen liittyvän teoksen.","fr":"Œuvre qui abrège une œuvre en relation de manière systématique et complète.","hu":"Egy mű, amely egy kapcsolódó művet módszeresen és átfogóan tömörít.","it":"Opera che riassume in maniera sistematica e dettagliata un’opera correlata.","lv":"Darbs, kas sistemātiski un aptveroši īsi apskata saistīto darbu.","nl":"Een werk dat een gerelateerd werk systematisch en alomvattend concentreert.","no":"Et verk som systematisk forkorter et relatert verk.","tr":"İlgili bir eseri sistematik ve kapsamlı bir şekilde özetleyen bir çalışma.","vi":"Tác phẩm cô gọn một cách có hệ thống và toàn diện tác phẩm nguồn.","zh-Hans-CN":"系统而全面压缩一种相关作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10148", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWork.en", "label":"has derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/digestedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10171", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/digestedAsWork.en", "label":"is digested as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10171", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/digestedAsWork.en", "label":"is digested as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10167","label":{"ar":"هو مختصر كعمل","ca":"és abreujat com a obra","cs":"je zkráceno jako dílo","da":"er forkortet som værk","de":"ist gekürzt als (Werk)","de":"ist gekürzt als (Werk)","el":"είναι συντμημένο ως (έργο)","en":"is abridged as work","es":"es abreviado como obra","et":"lühendatud teosena","fi":"lyhennelmä (teos)","fr":"est abrégé comme une œuvre","hu":"rövidítése a következő mű:","it":"è ridotta come opera","lv":"ir saīsināts darbs","nl":"is ingekort als werk","no":"er forkortet som verk","tr":"eser olarak özetlenmiştir","vi":"được rút gọn như là (tác phẩm)","zh-Hans-CN":"被缩编为作品"},"definition":{"ar":["يربط عمل بعمل يختصر عملاً ذا صلة دون تغيير المعنى العام أو طريقة العرض."],"ca":["Relaciona una obra amb una obra que escurça una obra relacionada sense canviar-ne el significat general o la forma de presentació."],"cs":["Vztahuje dílo k dílu, které zkracuje související dílo, aniž by se změnil celkový význam nebo způsob prezentace."],"da":["Relaterer et værk til et værk, som forkorter et relateret værk uden at ændre den overordnede betydning eller præsentationsmåde."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das ein in Beziehung stehendes Werk ohne Änderung der allgemeinen Bedeutung oder Darstellungsweise kürzt.,Setzt ein Werk in Beziehung zu einem Werk, das ein in Beziehung stehendes Werk ohne Änderung der allgemeinen Bedeutung oder Darstellungsweise kürzt."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο περιορίζει [την έκταση] ενός έργου-πηγής χωρίς να μεταβάλλει το γενικό νόημα ή τον τρόπο της παρουσίασης."],"en":["Relates a work to a work that shortens a related work without changing the general meaning or manner of presentation."],"es":["Relaciona una obra con una obra que abrevia una obra relacionada sin cambiar el significado general o la manera de presentación."],"et":["Seostab teose teosega, milles on lühendatud seotud teost, muutmata selle üldist tähendust ja esitusviisi."],"fi":["Liittää teoksen teokseen, joka lyhentää siihen liittyvää teosta muuttamatta sen merkityssisältöä tai esitystyyliä."],"fr":["Met une œuvre en relation avec une œuvre qui raccourcit une œuvre en relation sans en changer le sens général ou le mode de présentation."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy kapcsolódó művet tömörít, azaz lerövidít anélkül, hogy általános jelentését vagy előadásmódját megváltoztatná."],"it":["Correla un’opera a un’opera che abbrevia un’opera correlata senza cambiarne il significato generale o la modalità di presentazione."],"lv":["Sasaista darbu ar darbu, kas ir darba saīsinājums, nemainot tā nozīmi vai pasniegšanas veidu."],"nl":["Relateert een werk aan een werk dat een gerelateerd werk verkort zonder de algehele betekenis te veranderen of de manier van presentatie."],"no":["Relaterer et verk til et verk som forkorter et relatert verk uten å endre den generelle meningen eller presentasjonsformen."],"tr":["Bir eseri, genel anlamını veya sunum şeklini değiştirmeden ilgili bir eseri kısaltan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm làm ngắn tác phẩm nguồn mà không thay đổi ý nghĩa hoặc phương cách trình bày."],"zh-Hans-CN":["将一种作品与缩短一种相关作品而不改变其总体意义或呈现方式的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مختصر كعمل","ca":"abreujat com a obra","cs":"zkráceno jako dílo","da":"forkortet som værk","de":"Gekürzt als (Werk)","de":"Gekürzt als (Werk)","el":"συντμημένο ως (έργο)","en":"abridged as work","es":"abreviado como obra","et":"lühendatud teosena","fi":"lyhennelmä (teos)","fr":"abrégé comme une œuvre","hu":"rövidítő mű:","it":"ridotta come opera","lv":"saīsināts darbs","nl":"ingekort als werk","no":"forkortet som verk","tr":"eser olarak özetlenmiş","vi":"được rút gọn như là (tác phẩm)","zh-Hans-CN":"被缩编为作品"},"ToolkitDefinition":{"ar":"عمل يختصر عملاً ذا صلة دون تغيير المعنى العام أو طريقة العرض.","ca":"Obra que escurça una obra relacionada sense canviar-ne el significat general o la forma de presentació.","cs":"Dílo, které zkracuje související dílo, aniž by se změnil celkový význam nebo způsob prezentace.","da":"Værk, som forkorter et relateret værk uden at ændre den overordnede betydning eller præsentationsmåde.","de":"Ein Werk, das ein in Beziehung stehendes Werk ohne Änderung der allgemeinen Bedeutung oder Darstellungsweise kürzt.","de":"Ein Werk, das ein in Beziehung stehendes Werk ohne Änderung der allgemeinen Bedeutung oder Darstellungsweise kürzt.","el":"Ένα έργο το οποίο περιορίζει [την έκταση] ενός έργου-πηγής χωρίς να μεταβάλλει το γενικό νόημα ή τον τρόπο της παρουσίασης.","en":"A work that shortens a related work without changing the general meaning or manner of presentation.","es":"Una obra que abrevia una obra relacionada sin cambiar el significado general o la manera de presentación.","et":"Teos, milles on lühendatud seotud teost, muutmata selle üldist tähendust ja esitusviisi.","fi":"Teos, joka lyhentää siihen liittyvää teosta muuttamatta sen merkityssisältöä tai esitystyyliä.","fr":"Œuvre qui raccourcit une œuvre en relation sans en changer le sens général ou le mode de présentation.","hu":"Egy mű, amely egy kapcsolódó művet tömörít, azaz lerövidít anélkül, hogy általános jelentését vagy előadásmódját megváltoztatná.","it":"Opera che abbrevia un’opera correlata senza cambiarne il significato generale o la modalità di presentazione.","lv":"Darba saīsinājums, nemainot tā nozīmi vai pasniegšanas veidu.","nl":"Een werk dat een gerelateerd werk verkort zonder de algehele betekenis te veranderen of de manier van presentatie.","no":"Et verk som forkorter et relatert verk uten å endre den generelle meningen eller presentasjonsformen.","tr":"Genel anlamını veya sunum şeklini değiştirmeden ilgili bir çalışmayı kısaltan bir çalışma.","vi":"Tác phẩm làm ngắn tác phẩm nguồn mà không thay đổi ý nghĩa hoặc phương cách trình bày.","zh-Hans-CN":"缩短一种相关作品而不改变其总体意义或呈现方式的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10148", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWork.en", "label":"has derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/abridgedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10167", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/abridgedAsWork.en", "label":"is abridged as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10167", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/abridgedAsWork.en", "label":"is abridged as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10033","label":{"ar":"هو معد لتصاحبه موسيقى كعمل","ca":"és musicat com a obra","cs":"je zhudebněno jako dílo","da":"er sat til musik som værk","de":"ist vertont als (Werk)","de":"ist vertont als (Werk)","el":"είναι μελοποιημένο ως (έργο)","en":"is set to music as work","es":"está musicalizado como obra","et":"viisistatud teosena","fi":"tekstiin perustuva musiikki (teos)","fr":"est mis en musique comme une œuvre","hu":"megzenésítése a következő mű:","it":"è posta in musica come opera","lv":"darba tekstam komponētā mūzika","nl":"is op muziek gezet als werk","no":"er satt til musikk som verk","tr":"eser olarak müziğe göre düzenlenmiştir","vi":"được đặt nhạc như là (tác phẩm)","zh-Hans-CN":"是配乐为作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن عمل موسيقي غير درامي، بخلاف الموسيقى الدينية، التي تستخدم نص عمل آخر."],"ca":["Relaciona una obra amb una obra que és una obra musical no teatral, diferent d’un oratori, que usa el text d’una altra obra."],"cs":["Vztahuje dílo k dílu, které je nedramatickým hudebním dílem jiným než oratorium a které využívá text jiného díla."],"da":["Relaterer et værk til et ikke-dramatisk musikværk, bortset fra et oratorium, som anvender et oprindeligt værks tekst."],"de":["Setzt ein Werk in Beziehung zu einem nicht dramatischen Musikwerk, bei dem es sich nicht um ein Oratorium handelt, das den Text eines anderen Werks verwendet.,Setzt ein Werk in Beziehung zu einem nicht dramatischen Musikwerk, bei dem es sich nicht um ein Oratorium handelt, das den Text eines anderen Werks verwendet."],"el":["Συνδέει ένα έργο με ένα μη δραματικό μουσικό έργο, άλλο από ορατόριο, το οποίο χρησιμοποιεί το κείμενο ενός έργου-πηγής."],"en":["Relates a work to a work that is a non-dramatic musical work, other than an oratorio, that uses the text of another work."],"es":["Relaciona una obra con una obra que es una obra musical no dramática, diferente a un oratorio, que utiliza el texto de otra obra."],"et":["Seostab teose mittedramaatilise muusikateosega (v.a oratoorium), milles kasutatakse allikteose teksti."],"fi":["Liittää teoksen teokseen, joka on ei-näytelmällinen musiikkiteos (muu kuin oratorio), jonka teksti on peräisin toisesta teoksesta."],"fr":["Met une œuvre en relation avec une œuvre musicale non dramatique, autre qu’un oratorio, qui utilise le texte d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy nem-drámai zeneműhöz, amely nem oratórium, és amely egy másik mű szövegét használja."],"it":["Correla un’opera a un’opera musicale non drammatica, diversa dall’oratorio, che utilizza il testo di un'opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir ne-dramatisks mūzikas darbs, kas nav oratorija, kurā izmantots pamatdarba teksts."],"nl":["Relateert een werk aan een werk dat is een niet-dramatisch muziekwerk, anders dan een oratorium, dat de tekst van een ander werk gebruikt."],"no":["Relaterer et verk til et ikke-dramatisk musikalsk verk, bortsett fra et oratorium, som bruker teksten fra et kildeverk."],"tr":["Bir eseri, başka bir eserin metnini kullanan oratoryo dışındaki dramatik olmayan bir müzik eseriyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc phi kịch, khác với ontario, sử dụng văn bản của tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为不同于清唱剧、使用另一种作品的文本的一种非戏剧音乐作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معد لتصاحبه موسيقى كعمل","ca":"musicat com a obra","cs":"zhudebněno jako dílo","da":"sat til musik som værk","de":"Vertont als (Werk)","de":"Vertont als (Werk)","el":"μελοποιημένο ως (έργο)","en":"set to music as work","es":"musicalizado como obra","et":"viisistatud teosena","fi":"tekstiin perustuva musiikki (teos)","fr":"mis en musique comme une œuvre","hu":"szöveggel ellátott zenemű:","it":"posta in musica come opera","lv":"darbs: tekstam komponētā mūzika","nl":"op muziek gezet als werk","no":"satt til musikk som verk","tr":"eser olarak müziğe ayarlanmış","vi":"được đặt nhạc như là (tác phẩm)","zh-Hans-CN":"配乐为作品"},"ToolkitDefinition":{"ar":"عمل موسيقي غير درامي، بخلاف الموسيقى الدينية، التي تستخدم نص عمل آخر.","ca":"Obra que és una obra musical no teatral, diferent d’un oratori, que usa el text d’una altra obra.","cs":"Dílo, které je nedramatickým hudebním dílem jiným než oratorium a které využívá text jiného díla.","da":"Ikke-dramatisk musikværk, bortset fra et oratorium, som anvender et oprindeligt værks tekst.","de":"Eine nicht dramatisches Musikwerk, bei dem es sich nicht um ein Oratorium handelt, das den Text eines anderen Werks verwendet.","de":"Eine nicht dramatisches Musikwerk, bei dem es sich nicht um ein Oratorium handelt, das den Text eines anderen Werks verwendet.","el":"Ένα μη δραματικό μουσικό έργο, άλλο από ορατόριο, το οποίο χρησιμοποιεί το κείμενο ενός έργου-πηγής.","en":"A work that is a non-dramatic musical work, other than an oratorio, that uses the text of another work.","es":"Una obra que es una obra musical no dramática, diferente a un oratorio, que utiliza el texto de otra obra.","et":"Mittedramaatiline muusikateos (v.a oratoorium), milles kasutatakse allikteose teksti.","fi":"Teos, joka on ei-näytelmällinen musiikkiteos (muu kuin oratorio), jonka teksti on peräisin toisesta teoksesta.","fr":"Œuvre musicale non dramatique, autre qu’un oratorio, qui utilise le texte d’une autre œuvre.","hu":"Egy nem-drámai zenemű, amely nem oratórium, amely egy másik mű szövegét használja.","it":"Opera musicale non drammatica, diversa dall’oratorio, che utilizza il testo di un'opera di partenza.","lv":"Ne-dramatisks mūzikas darbs, kas nav oratorija, kurā izmantots pamatdarba teksts.","nl":"Een werk dat is een niet-dramatisch muziekwerk, anders dan een oratorium, dat de tekst van een ander werk gebruikt.","no":"Et ikke-dramatisk musikalsk verk, bortsett fra et oratorium, som bruker teksten fra et kildeverk.","tr":"Oratoryo dışında, başka bir eserin metnini kullanan dramatik olmayan bir müzik eseridir.","vi":"Tác phẩm âm nhạc phi kịch, khác với ontario, sử dụng văn bản của tác phẩm nguồn.","zh-Hans-CN":"作为不同于清唱剧、使用另一种作品的文本的一种非戏剧音乐作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10148", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWork.en", "label":"has derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/setToMusicAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10033", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/setToMusicAsWork.en", "label":"is set to music as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10033", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/setToMusicAsWork.en", "label":"is set to music as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10028","label":{"ar":"هو معدل بتنويع كعمل","ca":"és modificat per una variació com a obra","cs":"je modifikováno variací jako dílo","da":"er variation tilpasset som værk","de":"ist durch Variation modifiziert als (Werk)","de":"ist durch Variation modifiziert als (Werk)","el":"τροποποιήθηκε από την παραλλαγή ως (έργο)","en":"is modified by variation as work","es":"es modificada por variación como obra","et":"teema variatsioonidega (teos)","fi":"muuntelun tuloksena muodostunut teos","fr":"est modifié par variation comme une œuvre","hu":"változatként módosította a következő mű:","it":"è modificata da variazione come opera","lv":"darba variācija","nl":"is aangepast door variatie als werk","no":"er modifisert gjennom variasjoner som verk","tr":"eser olarak varyasyonla değiştirilmiştir","vi":"được thay đổi bởi biến tấu như là (tác phẩm)","zh-Hans-CN":"通过变奏被修改为作品"},"definition":{"ar":["يربط عمل بعمل موسيقي حيث تؤخذ المواد اللحنية، أو الموضوعية، أو التناغمية من عمل آخر لتشكل مقطوعة متميزة، تتكرر مرة واحدة أو أكثر مع تعديلات لاحقة."],"ca":["Relaciona una obra amb una obra que és una obra musical en la qual el material melòdic, temàtic o harmònic obtingut d’una altra obra forma un tema discret, que es repeteix una o més vegades amb modificacions subsegüents."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, v němž je melodický, tematický nebo harmonický obsah převzatý z jiného díla a tvoří samostatné téma, které je následně jednou nebo vícekrát zopakováno s následnými úpravami."],"da":["Relaterer et værk til et musikværk, hvori melodisk, tematisk eller harmonisk materiale taget fra et andet værk danner et separat tema, der gentages en eller flere gange med efterfølgende tilpasninger."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, in dem melodisches, thematisches oder harmonisches Material aus einem anderen Werk ein einzelnes Thema bildet, das ein- oder mehrmals mit nachfolgenden Modifikationen wiederholt wird.,Setzt ein Werk in Beziehung zu einem Musikwerk, in dem melodisches, thematisches oder harmonisches Material aus einem anderen Werk ein einzelnes Thema bildet, das ein- oder mehrmals mit nachfolgenden Modifikationen wiederholt wird."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο στο οποίο το μελωδικό, θεματικό ή αρμονικό υλικό που έχει αντληθεί από ένα έργο-πηγή διαμορφώνει ένα διακριτό θέμα, το οποίο επαναλαμβάνεται μία ή περισσότερες φορές με διαδοχικές τροποποιήσεις."],"en":["Relates a work to a work that is a musical work in which melodic, thematic, or harmonic material taken from another work forms a discrete theme, which is repeated one or more times with subsequent modifications."],"es":["Relaciona una obra con una obra que es una obra musical en la cual material melódico, temático o armónico tomado de otra obra forma un tema discreto, el cual se repite una o más veces con modificaciones subsecuentes."],"et":["Seostab teose muusikateosega, milles teise teose meloodilisest, temaatilisest või harmoonilisest materjalist on loodud eraldi teema, mida korratakse muudetuna üks või mitu korda."],"fi":["Liittää teoksen musiikkiteokseen, jonka melodinen, temaattinen tai harmoninen aines on otettu toisesta teoksesta erillisen, toistettavan ja muunneltavan teeman muodostamiseksi."],"fr":["Met une œuvre en relation avec une œuvre musicale dans laquelle de la matière mélodique, thématique ou harmonique tirée d’une autre œuvre forme un thème distinct qui est répété une ou plusieurs fois avec des modifications subséquentes."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amelyben egy másik műformából átvett dallami, tematikus vagy harmonikus anyag egy különálló témát képez, amely egyszer vagy többször ismétlődik egymás utáni módosulásokkal."],"it":["Correla un’opera a un’opera musicale in cui il materiale melodico, tematico o armonico tratto da un’altra opera compone un tema distinto, che si ripete una o più volte con modifiche successive."],"lv":["Sasaista darbu ar mūzikas darbu, kurā melodisks, tematisks vai harmonisks materiāls ir ņemts no pamatdarba, izveidojot atsevišķu tēmu, ko atkārto vienu vai vairākas reizes ar secīgām izmaiņām."],"nl":["Relateert een werk aan een werk dat is een muziekwerk waarvan melodisch, thematisch of harmonisch materiaal genomen uit een ander werk een apart thema vormt, dat één of meer keer herhaald wordt met volgende aanpassingen."],"no":["Relaterer et verk til et musikalsk verk der melodisk, tematisk eller harmonisk materiale hentet fra et annet verk danner et avgrenset tema, som gjentas én eller flere ganger med påfølgende modifikasjoner."],"tr":["Bir eseri, başka bir eserden alınan melodik, tematik veya armonik materyalin, sonraki değişikliklerle bir veya daha fazla kez tekrarlanan ayrı bir tema oluşturduğu bir müzik eseri ile ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc mà trong đó tài liệu du dương, theo đề tài, hoặc hoà âm được lấy ra để tạo thành đề tài riêng biệt, được nhắc lại một hoặc nhiều lần với các sửa đổi liên tiếp."],"zh-Hans-CN":["将一种作品与其旋律、主题或和声材料被取自另一种作品以形成一个独立的主题、而这个主题又经过后续变化而反复一次或多次的作为一种音乐作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معدل بتنويع كعمل","ca":"modificat per una variació com a obra","cs":"modifikováno variací jako dílo","da":"variation tilpasset som værk","de":"Durch Variation modifiziert als (Werk)","de":"Durch Variation modifiziert als (Werk)","el":"τροποποιήθηκε από την παραλλαγή ως (έργο)","en":"modified by variation as work","es":"modificada por variación como obra","et":"teema variatsioonidega (teos)","fi":"muuntelun tuloksena muodostunut teos","fr":"modifié par variation comme une œuvre","hu":"változatként módosító mű:","it":"modificata da variazione come opera","lv":"darbs: variācija","nl":"aangepast door variatie als werk","no":"modifisert gjennom variasjoner som verk","tr":"eser olarak varyasyonla değiştirilirdi","vi":"được thay đổi bởi biến tấu như là (tác phẩm)","zh-Hans-CN":"通过变奏被修改为作品"},"ToolkitDefinition":{"ar":"عمل موسيقي حيث تؤخذ المواد اللحنية، أو الموضوعية، أو التناغمية من عمل آخر لتشكل مقطوعة متميزة، تتكرر مرة واحدة أو أكثر مع تعديلات لاحقة.","ca":"Obra que és una obra musical en la qual el material melòdic, temàtic o harmònic obtingut d’una altra obra forma un tema discret, que es repeteix una o més vegades amb modificacions subsegüents.","cs":"Dílo, které je hudebním dílem, v němž je melodický, tematický nebo harmonický obsah převzatý z jiného díla a tvoří samostatné téma, které je následně jednou nebo vícekrát zopakováno s následnými úpravami.","da":"Musikværk, hvori melodisk, tematisk eller harmonisk materiale taget fra et andet værk danner et separat tema, der gentages en eller flere gange med efterfølgende tilpasninger.","de":"Ein Musikwerk, in dem melodisches, thematisches oder harmonisches Material aus einem anderen Werk ein einzelnes Thema bildet, das ein- oder mehrmals mit nachfolgenden Modifikationen wiederholt wird.","de":"Ein Musikwerk, in dem melodisches, thematisches oder harmonisches Material aus einem anderen Werk ein einzelnes Thema bildet, das ein- oder mehrmals mit nachfolgenden Modifikationen wiederholt wird.","el":"Ένα μουσικό έργο στο οποίο το μελωδικό, θεματικό ή αρμονικό υλικό που έχει αντληθεί από ένα έργο-πηγή διαμορφώνει ένα διακριτό θέμα, το οποίο επαναλαμβάνεται μία ή περισσότερες φορές με διαδοχικές τροποποιήσεις.","en":"A work that is a musical work in which melodic, thematic, or harmonic material taken from another work forms a discrete theme, which is repeated one or more times with subsequent modifications.","es":"Una obra que es una obra musical en la cual material melódico, temático o armónico tomado de otra obra forma un tema discreto, el cual se repite una o más veces con modificaciones subsecuentes.","et":"Muusikateos, milles teise teose meloodilisest, temaatilisest või harmoonilisest materjalist on loodud eraldi teema, mida korratakse muudetuna üks või mitu korda.","fi":"Musiikkiteos, jonka melodinen, temaattinen tai harmoninen aines on otettu toisesta teoksesta erillisen, toistettavan ja muunneltavan teeman muodostamiseksi.","fr":"Œuvre musicale dans laquelle de la matière mélodique, thématique ou harmonique tirée d’une autre œuvre forme un thème distinct qui est répété une ou plusieurs fois avec des modifications subséquentes.","hu":"Egy mű, amely egy zenemű, amelyben egy másik műformából átvett dallami, tematikus vagy harmonikus anyag egy különálló témát képez, amely egyszer vagy többször ismétlődik egymás utáni módosulásokkal.","it":"Opera musicale in cui il materiale melodico, tematico o armonico tratto da un’altra opera compone un tema distinto, che si ripete una o più volte con modifiche successive.","lv":"Mūzikas darbs, kurā melodisks, tematisks vai harmonisks materiāls ir ņemts no pamatdarba, izveidojot atsevišķu tēmu, ko atkārto vienu vai vairākas reizes ar secīgām izmaiņām.","nl":"Een werk dat is een muziekwerk waarvan melodisch, thematisch of harmonisch materiaal genomen uit een ander werk een apart thema vormt, dat één of meer keer herhaald wordt met volgende aanpassingen.","no":"Et musikalsk verk der melodisk, tematisk eller harmonisk materiale hentet fra et annet verk danner et avgrenset tema, som gjentas én eller flere ganger med påfølgende modifikasjoner.","tr":"Başka bir eserden alınan melodik, tematik veya armonik materyalin, sonraki değişikliklerle bir veya daha fazla kez tekrarlanan ayrı bir tema oluşturduğu bir müzik eseri.","vi":"Tác phẩm âm nhạc mà trong đó tài liệu du dương, theo đề tài, hoặc hoà âm được lấy ra để tạo thành đề tài riêng biệt, được nhắc lại một hoặc nhiều lần với các sửa đổi liên tiếp.","zh-Hans-CN":"其旋律、主题或和声材料被取自另一种作品以形成一个独立的主题、而这个主题又经过后续变化而反复一次或多次的作为一种音乐作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10148", "lexicalAlias":"http://rdaregistry.info/Elements/w/derivativeWork.en", "label":"has derivative work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/modifiedByVariationAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10028", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/modifiedByVariationAsWork.en", "label":"is modified by variation as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10028", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/modifiedByVariationAsWork.en", "label":"is modified by variation as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10109","label":{"ar":"هو ملخص كعمل","ca":"té sumari","cs":"má souhrn","da":"er opsummeret som værk","de":"ist zusammengefasst als (Werk)","de":"Executive summary","el":"είναι περίληψη ως (έργο)","en":"has summary","es":"tiene resumen","et":"kokkuvõte teosena","fi":"yhteenveto","fr":"a pour résumé","hu":"összefoglalja a következő mű:","it":"è riassunta come opera","lv":"darba kopsavilkums","nl":"heeft samenvatting","no":"er sammendrag som verk","tr":"özet ile ilişkilidir","vi":"được tóm lược như là (tác phẩm)","zh-Hans-CN":"有提要"},"definition":{"ar":["يربط عمل بعمل يتكون من تلخيص موجز لمحتوى عمل آخر."],"ca":["Relaciona una obra amb una obra que és una descripció breu d’una obra."],"cs":["Vztahuje dílo k dílu, které je stručným popisem díla."],"da":["Relaterer et værk til et værk, som består af en kortfattet gengivelse af et oprindeligt værks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das aus einer kurzen Wiederholung des Inhalts eines anderen Werks besteht.,Setzt ein Werk in Beziehung zu einem Werk, bei dem es sich um eine kurze Untersuchung eines Werks handelt."],"el":["Συνδέει ένα έργο με ένα έργο, το οποίο συνιστά μια σύντομη ανακεφαλαίωση του περιεχομένου ενός έργου-πηγής."],"en":["Relates a work to a work that is a brief description of a work."],"es":["Relaciona una obra con una obra que es una descripción breve de una obra."],"et":["Seostab teose teosega, milles on lühidalt kokku võetud allikteose sisu."],"fi":["Liittää teoksen teokseen, joka on teoksen lyhyt kuvaus."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en une brève description d’une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy mű rövid leírása."],"it":["Correla un’opera a un’opera che consiste di una breve ricapitolazione del contenuto di un’opera di partenza."],"lv":["Sasaista darbu ar darbu - pamatdarba īss satura izklāsts."],"nl":["Relateert een werk aan een werk dat bestaat uit een korte herformulering van de content van een ander werk."],"no":["Relaterer et verk til et verk som består av et kort sammendrag av innholdet fra et kildeverk."],"tr":["Bir eseri, bir eserin kısa bir açıklaması olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm có chứa bản tóm tắt ngắn gọn của nội dung của tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为一种作品简要描述的一种作品关联起来。"]},"ToolkitLabel":{"ar":"ملخص كعمل","ca":"sumari","cs":"souhrn","da":"opsummeret som værk","de":"Zusammengefasst als (Werk)","el":"περίληψη ως (έργο)","en":"summary","es":"resumen","et":"kokkuvõte teosena","fi":"yhteenveto","fr":"résumé","hu":"összefoglaló mű:","it":"riassunta come opera","lv":"darbs: kopsavilkums","nl":"samenvatting","no":"sammendrag som verk","tr":"özet","vi":"được tóm lược như là (tác phẩm)","zh-Hans-CN":"提要"},"ToolkitDefinition":{"ar":"عمل يتكون من تلخيص موجز لمحتوى عمل آخر.","ca":"Obra que és una descripció breu d’una obra.","cs":"Dílo, které je stručným popisem díla.","da":"Værk, som består af en kortfattet gengivelse af et oprindeligt værks indhold.","de":"Ein Werk, das aus einer kurzen Wiederholung des Inhalts eines anderen Werks besteht.","de":"Ein Werk, bei dem es sich um eine kurze Untersuchung eines Werks handelt.","el":"Ένα έργο το οποίο συνιστά μια σύντομη ανακεφαλαίωση του περιεχομένου ενός έργου-πηγής.","en":"A work that is a brief description of a work.","es":"Una obra que es una descripción breve de una obra.","et":"Teos, milles on lühidalt kokku võetud allikteose sisu.","fi":"Teos, joka on teoksen lyhyt kuvaus.","fr":"Œuvre qui consiste en une brève description d’une œuvre.","hu":"Egy mű, amely egy mű rövid leírása.","it":"Opera che consiste di una breve ricapitolazione del contenuto di un’opera di partenza.","lv":"Darbs - pamatdarba īss satura izklāsts.","nl":"Een werk dat bestaat uit een korte herformulering van de content van een ander werk.","no":"Et verk som består av et kort sammendrag av innholdet fra et kildeverk.","tr":"Bir eserin kısa açıklaması olan bir eser.","vi":"Tác phẩm có chứa bản tóm tắt ngắn gọn của nội dung của tác phẩm nguồn.","zh-Hans-CN":"作为一种作品简要描述的一种作品"},"altLabel":{"ca":["sumaritzat com a obra"],"cs":["shrnuto jako dílo"],"de":["Zusammengefasst als (Werk)"],"en":["summarized as work"],"es":["resumido como obra"],"fi":["yhteenveto (teos)"],"fr":["résumé comme une œuvre"],"hu":["műként összefoglalva"],"nl":["samengevat als werk"],"tr":["eser olarak özetleme"],"zh-Hans-CN":["被提要为作品"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"24.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10118", "lexicalAlias":"http://rdaregistry.info/Elements/w/workDescribedBy.en", "label":"is work described by"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/summary.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10107", "lexicalAlias":"http://rdaregistry.info/Elements/w/abstract.en", "label":"has abstract"},{"@id":"http://rdaregistry.info/Elements/w/object/P10109", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/summary.en", "label":"has summary"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10109", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/summary.en", "label":"has summary"}]},{"@id":"http://rdaregistry.info/Elements/w/P10144","label":{"ar":"هو محاكى على سبيل السخرية كعمل","ca":"és parodiat com a obra","cs":"je parodováno jako dílo","da":"er parodieret som værk","de":"ist parodiert als (Werk)","de":"ist parodiert als (Werk)","el":"είναι διακωμωδημένο ως (έργο)","en":"is parodied as work","es":"es parodiada como obra","et":"parodeeritud teosena","fi":"parodia (teos)","fr":"est parodié comme une œuvre","hu":"parodizálja a következő mű:","it":"è parodiata come opera","lv":"darba parodija","nl":"is parodie als werk","no":"er parodiert som verk","tr":"eser olarak parodileştirilmiştir","vi":"là được nhại như là (tác phẩm)","zh-Hans-CN":"被戏仿为作品"},"definition":{"ar":["يربط عمل بعمل يقلد أسلوب عمل آخر أو محتواه ليُحدث تأثيرًا هزليًا."],"ca":["Relaciona una obra amb una obra que imita l’estil o el contingut d’una altra obra per donar un efecte còmic."],"cs":["Vztahuje dílo k dílu, které napodobuje styl nebo obsah jiného díla pro komický účinek."],"da":["Relaterer et værk til et værk, som efterligner et oprindeligt værks stil eller indhold for at opnå en komisk effekt."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Stil oder Inhalt eines anderen Werks imitiert, um einen lustigen Effekt zu erzielen.,Setzt ein Werk in Beziehung zu einem Werk, das den Stil oder Inhalt eines anderen Werks imitiert, um einen lustigen Effekt zu erzielen."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο μιμείται το ύφος ή το περιεχόμενο ενός έργου-πηγής για κωμικό εφέ."],"en":["Relates a work to a work that imitates the style or content of another work for comic effect."],"es":["Relaciona una obra con una obra que imita el estilo o contenido de otra obra para efectos cómicos."],"et":["Seostab teose teosega, mis jäljendab allikteose stiili või sisu koomilise efekti saavutamiseks."],"fi":["Liittää teoksen teokseen, joka jäljittelee toisen teoksen tyyliä tai sisältöä humoristisesti."],"fr":["Met une œuvre en relation avec une œuvre qui imite le style ou le contenu d’une autre œuvre dans le but de produire un effet comique."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik mű stílusát vagy tartalmát utánozza a komikus hatás kedvéért."],"it":["Correla un'opera a un'opera che imita lo stile o il contenuto di un’opera di partenza per ottenere un effetto comico."],"lv":["Sasaista darbu ar darbu, kas atdarina pamatdarba stilu vai saturu komiska efekta iegūšanai."],"nl":["Relateert een werk aan een werk dat de stijl of content van een ander werk imiteert voor komisch effect."],"no":["Relaterer et verk til et verk som etterligner et kildeverks stil eller innhold for en humoristisk effekt."],"tr":["Bir eseri, komik etki yaratmak için başka bir eserin biçimini veya içeriğini taklit eden bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm nhại lại phong cách và nội dung của tác phẩm nguồn cho hiệu quả hài hước."],"zh-Hans-CN":["将一种作品与带喜剧效果模仿另一种作品的风格和内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"محاكى على سبيل السخرية كعمل","ca":"parodiat com a obra","cs":"parodováno jako dílo","da":"parodieret som værk","de":"Parodiert als (Werk)","de":"Parodiert als (Werk)","el":"διακωμωδημένο ως (έργο)","en":"parodied as work","es":"parodiada como obra","et":"parodeeritud teosena","fi":"parodia (teos)","fr":"parodié comme une œuvre","hu":"parodizáló mű:","it":"parodiata come opera","lv":"darbs: parodija","nl":"parodie als werk","no":"parodiert som verk","tr":"eser olarak taklit edilmiştir","vi":"được nhại như là (tác phẩm)","zh-Hans-CN":"被戏仿为作品"},"ToolkitDefinition":{"ar":"عمل يقلد أسلوب عمل آخر أو محتواه ليُحدث تأثيرًا هزليًا.","ca":"Obra que imita l’estil o el contingut d’una altra obra per donar un efecte còmic.","cs":"Dílo, které napodobuje styl nebo obsah jiného díla pro komický účinek.","da":"Værk, som efterligner et oprindeligt værks stil eller indhold for at opnå en komisk effekt.","de":"Ein Werk, das den Stil oder Inhalt eines anderen Werks imitiert, um einen lustigen Effekt zu erzielen.","de":"Ein Werk, das den Stil oder Inhalt eines anderen Werks imitiert, um einen lustigen Effekt zu erzielen.","el":"Ένα έργο το οποίο μιμείται το ύφος ή το περιεχόμενο ενός έργου-πηγής για κωμικό εφέ.","en":"A work that imitates the style or content of another work for comic effect.","es":"Una obra que imita el estilo o contenido de otra obra para efectos cómicos.","et":"Teos, mis jäljendab allikteose stiili või sisu koomilise efekti saavutamiseks.","fi":"Teos, joka jäljittelee toisen teoksen tyyliä tai sisältöä humoristisesti.","fr":"Œuvre qui imite le style ou le contenu d’une autre œuvre dans le but de produire un effet comique.","hu":"Egy mű, amely egy másik mű stílusát vagy tartalmát utánozza a komikus hatás kedvéért.","it":"Opera che imita lo stile o il contenuto di un’opera di partenza per ottenere un effetto comico.","lv":"Darbs, kas atdarina pamatdarba stilu vai saturu komiska efekta iegūšanai.","nl":"Een werk dat de stijl of content van een ander werk imiteert voor komisch effect.","no":"Et verk som etterligner et kildeverks stil eller innhold for en humoristisk effekt.","tr":"Komik etki yaratmak için başka bir eserin biçimini veya içeriğini taklit eden eser.","vi":"Tác phẩm nhại lại phong cách và nội dung của tác phẩm nguồn cho hiệu quả hài hước.","zh-Hans-CN":"带喜剧效果模仿另一种作品的风格和内容的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10117", "lexicalAlias":"http://rdaregistry.info/Elements/w/imitatedAsWork.en", "label":"is imitated as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/parodiedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10144", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/parodiedAsWork.en", "label":"is parodied as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10144", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/parodiedAsWork.en", "label":"is parodied as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10099","label":{"ar":"هو مترجم بتصرف كعمل","ca":"és traduït lliurement com a obra","cs":"je volně přeloženo jako dílo","da":"er frit oversat som værk","de":"ist frei übersetzt als (Werk)","de":"ist frei übersetzt als (Werk)","el":"είναι ελεύθερη μετάφραση ως (έργο)","en":"is freely translated as work","es":"es traducida libremente como obra","et":"vabalt tõlgitud teosena","fi":"vapaamuotoinen käännös (teos)","fr":"est librement traduit comme une œuvre","hu":"szabadon fordítva a következő műben:","it":"è liberamente tradotta come opera","lv":"ir brīvs tulkojums (darbs)","nl":"is vrij vertaald als werk","no":"er fritt oversatt som verk","tr":"eser olarak serbestçe çevrilmiştir","vi":"được dịch tự do (tác phẩm)","zh-Hans-CN":"被自由翻译为作品"},"definition":{"ar":["يربط عمل بعمل يعد اقتباسًا وترجمة إلى لغة أخرى لعمل آخر."],"ca":["Relaciona una obra amb una obra que és alhora una adaptació i una traducció a una altra llengua d’una altra obra."],"cs":["Vztahuje dílo k dílu, které je současně adaptací jiného díla a jeho překladem do jiného jazyka."],"da":["Relaterer et værk til et værk, som både er en bearbejdelse af et oprindeligt værk og en oversættelse til et andet sprog."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das sowohl eine Bearbeitung als auch eine Übersetzung eines anderen Werks in eine andere Sprache ist.,Setzt ein Werk in Beziehung zu einem Werk, das sowohl eine Bearbeitung als auch eine Übersetzung eines anderen Werks in eine andere Sprache ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο είναι ταυτόχρονα προσαρμογή και μετάφραση ενός έργου-πηγής σε μια άλλη γλώσσα."],"en":["Relates a work to a work that is both an adaptation and a translation into another language of another work."],"es":["Relaciona una obra con una obra que es tanto una adaptación como una traducción en otro idioma de otra obra."],"et":["Seostab teose teosega, mis on nii allikteose adapteering kui ka tõlge teise keelde."],"fi":["Liittää teoksen teokseen, joka on sekä toisen teoksen muokkaus että käännös toiselle kielelle."],"fr":["Met une œuvre en relation avec une œuvre qui consiste à la fois en une adaptation et en une traduction dans une autre langue d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik mű adaptációja és egy másik nyelvre való fordítása egyszerre."],"it":["Correla un’opera a un’opera che è sia un adattamento sia una traduzione in un'altra lingua di un’opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir gan darba avota adaptācija, gan tulkojums citā valodā."],"nl":["Relateert een werk aan een werk dat zowel een bewerking is als een vertaling in een andere taal van een ander werk."],"no":["Relaterer et verk til et verk som er både en bearbeidelse av et kildeverk og en oversettelse til et annet språk."],"tr":["Bir eseri, başka bir eserin hem uyarlaması hem de başka bir dile çevirisi olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm vừa phỏng theo vừa dịch sang ngôn ngữ khác của tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为另一种作品的用另一种语言改编和翻译同时进行而成的一种作品关联起来。"]},"ToolkitLabel":{"ar":"مترجم بتصرف كعمل","ca":"traduït lliurement com a obra","cs":"volně přeloženo jako dílo","da":"frit oversat som værk","de":"Frei übersetzt als (Werk)","de":"Frei übersetzt als (Werk)","el":"ελεύθερη μετάφραση ως (έργο)","en":"freely translated as work","es":"traducida libremente como obra","et":"vabalt tõlgitud teosena","fi":"vapaamuotoinen käännös (teos)","fr":"librement traduit comme une œuvre","hu":"szabad fordítása a következő mű:","it":"liberamente tradotta come opera","lv":"brīvs tulkojums (darbs)","nl":"vrij vertaald als werk","no":"fritt oversatt som verk","tr":"eser olarak serbestçe çevrilmiş","vi":"dịch tự do như là (tác phẩm)","zh-Hans-CN":"被自由翻译为作品"},"ToolkitDefinition":{"ar":"عمل يعد اقتباسًا وترجمة إلى لغة أخرى لعمل آخر.","ca":"Obra que és alhora una adaptació i una traducció a una altra llengua d’una altra obra.","cs":"Dílo, které je současně adaptací jiného díla a jeho překladem do jiného jazyka.","da":"Værk, som både er en bearbejdelse af et oprindeligt værk og en oversættelse til et andet sprog.","de":"Ein Werk, das sowohl eine Bearbeitung als auch eine Übersetzung eines anderen Werks in eine andere Sprache ist.","de":"Ein Werk, das sowohl eine Bearbeitung als auch eine Übersetzung eines anderen Werks in eine andere Sprache ist.","el":"Ένα έργο το οποίο είναι ταυτόχρονα προσαρμογή και μετάφραση ενός έργου-πηγής σε μια άλλη γλώσσα.","en":"A work that is both an adaptation and a translation into another language of another work.","es":"Una obra que es tanto una adaptación como una traducción en otro idioma de otra obra.","et":"Teos, mis on nii allikteose adapteering kui ka tõlge teise keelde.","fi":"Teos, joka on sekä toisen teoksen muokkaus että käännös toiselle kielelle.","fr":"Œuvre qui consiste à la fois en une adaptation et en une traduction dans une autre langue d’une autre œuvre.","hu":"Egy mű, amely egy másik mű adaptációja és egy másik nyelvre való fordítása egyszerre.","it":"Opera che è sia un adattamento sia una traduzione in un'altra lingua di un’opera di partenza.","lv":"Darbs, kas ir gan darba avota adaptācija, gan tulkojums citā valodā.","nl":"Een werk dat zowel een bewerking is als een vertaling in een andere taal van een ander werk.","no":"Et verk som er både en bearbeidelse av et kildeverk og en oversettelse til et annet språk.","tr":"Başka bir eserin hem uyarlaması hem de başka bir dile çevirisi olan bir eser.","vi":"Tác phẩm vừa phỏng theo vừa dịch sang ngôn ngữ khác của tác phẩm nguồn.","zh-Hans-CN":"作为另一种作品的用另一种语言改编和翻译同时进行而成的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10340", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyle.en", "label":"has transformation by style"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/freelyTranslatedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10099", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/freelyTranslatedAsWork.en", "label":"is freely translated as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10099", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/freelyTranslatedAsWork.en", "label":"is freely translated as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10032","label":{"ar":"هو معاد صنعه كعمل","ca":"és nova versió com a obra","cs":"je přepracováno jako dílo","da":"er genindspillet som værk","de":"ist Remake als (Werk)","de":"ist Remake als (Werk)","el":"είναι ανακατασκευασμένο ως (έργο)","en":"is remade as work","es":"es vuelto a hacer como obra","et":"uusproduktsioon (teos)","fi":"uusintaproduktio (teos)","fr":"est repris comme une œuvre","hu":"átdolgozása a következő műnek:","it":"è rifatta come opera","lv":"darba jauna versija","nl":"is opnieuw gemaakt als werk","no":"er nyinnspilt som verk","tr":"eser olarak yeniden yapılmıştır","vi":"được làm lại như là (tác phẩm)","zh-Hans-CN":"被重新制作为作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن فيلم سينمائي، أو برنامج إذاعي، أو برنامج تليفزيوني، أو فيديو يعتمد على عمل سابق."],"ca":["Relaciona una obra amb una obra que és una pel·lícula cinematogràfica, un programa radiofònic, un programa de televisió o un vídeo que es basa en una obra anterior."],"cs":["Vztahuje dílo k dílu, které je novým filmovým dílem, rozhlasovým programem, televizním programem nebo videem založeným na dřívějším díle."],"da":["Relaterer et værk til en spillefilm, radio- eller tv-program eller video, som er baseret på et tidligere værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, bei dem es sich um einen Film, eine Radiosendung, eine Fernsehsendung oder ein Video handelt, der/die/das auf einem früheren Werk basiert.,Setzt ein Werk in Beziehung zu einem Werk, bei dem es sich um einen Film, eine Radiosendung, eine Fernsehsendung oder ein Video handelt, der/die/das auf einem früheren Werk basiert."],"el":["Συνδέει ένα έργο με μια κινηματογραφική ταινία, ένα ραδιοφωνικό πρόγραμμα, ένα τηλεοπτικό πρόγράμμα ή ένα βίντεο, βασισμένα σε προηγούμενο έργο."],"en":["Relates a work to a work that is a motion picture, radio program, television program, or video that is based on an earlier work."],"es":["Relaciona una obra con una obra que es una película, programa de radio, programa de televisión o video que está basado en una obra anterior."],"et":["Seostab teose filmi, raadiosaate, telesaate või videofilmiga, mis põhineb varasemal teosel."],"fi":["Liittää teoksen teokseen, joka on elokuva, radio-ohjelma, televisio-ohjelma tai video, joka perustuu aiempaan teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un nouveau film, une nouvelle émission de radio, une nouvelle émission de télévision ou une nouvelle vidéo basée sur une œuvre antérieure."],"hu":["Hozzákapcsol egy művet egy korábbi művön alapuló mozgóképhez, rádióműsorhoz, televízióműsorhoz, vagy videóhoz."],"it":["Correla un'opera a un film, programma radiofonico, programma televisivo o video, basato su un'opera precedente."],"lv":["Sasaista darbu ar darbu, kas ir jauna kinofilma, radio, televīzijas raidījums vai video, kas veidoti pēc agrāka darba. Rīmeiks."],"nl":["Relateert een werk aan een werk dat is een speelfilm, radioprogramma, televisieprogramma of video dat gebaseerd is op een eerder werk."],"no":["Relaterer et verk til en spillefilm, et radioprogram, et fjernsynsprogram eller en video som er basert på et tidligere verk."],"tr":["Bir eseri, eski bir esere dayanan sinema filmi, radyo programı, televizyon programı veya video olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với phim điện ảnh, chương trình truyền thanh, chương trình truyền hình, hoặc video dựa trên tác phẩm trước đây."],"zh-Hans-CN":["将一种作品与基于一种先前作品的一种新电影、广播节目、电视节目或视频的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معاد صنعه كعمل","ca":"nova versió com a obra","cs":"přepracováno jako dílo","da":"genindspillet som værk","de":"Remake als (Werk)","de":"Remake als (Werk)","el":"ανακατασκευασμένο ως (έργο)","en":"remade as work","es":"vuelto a hacer como obra","et":"uusproduktsioon (teos)","fi":"uusintaproduktio (teos)","fr":"repris comme une œuvre","hu":"újraalkotó mű:","it":"rifatta come opera","lv":"darbs: jauna versija","nl":"opnieuw gemaakt als werk","no":"nyinnspilt som verk","tr":"eser olarak yeniden yapılmış","vi":"được làm lại như là (tác phẩm)","zh-Hans-CN":"被重新制作为作品"},"ToolkitDefinition":{"ar":"فيلم سينمائي جديد، أو برنامج إذاعي، أو برنامج تلفزيوني، أو فيديو يعتمد على عمل سابق.","ca":"Obra que és una pel·lícula cinematogràfica, un programa radiofònic, un programa de televisió o un vídeo que es basa en una obra anterior.","cs":"Dílo, které je novým filmovým dílem, rozhlasovým programem, televizním programem nebo videem založeným na dřívějším díle.","da":"Spillefilm, radio- eller tv-program eller video, som er baseret på et tidligere værk.","de":"Ein Werk, bei dem es sich um einen Film, eine Radiosendung, eine Fernsehsendung oder ein Video handelt, der/die/das auf einem früheren Werk basiert.","de":"Ein Werk, bei dem es sich um einen Film, eine Radiosendung, eine Fernsehsendung oder ein Video handelt, der/die/das auf einem früheren Werk basiert.","el":"Μια νέα κινηματογραφική ταινία, ένα ραδιοφωνικό πρόγραμμα, ένα τηλεοπτικό πρόγράμμα ή ένα βίντεο, βασισμένα σε ένα προηγούμενο έργο.","en":"A work that is a new motion picture, radio program, television program, or video that is based on an earlier work.","es":"Una obra que es una película, programa de radio, programa de televisión o video que está basado en una obra anterior.","et":"Uus film, raadiosaade, telesaade või videofilm, mis põhineb varasemal teosel.","fi":"Teos, joka on uusi elokuva, radio-ohjelma, televisio-ohjelma tai video, joka perustuu aiempaan teokseen.","fr":"Œuvre qui consiste en un nouveau film, une nouvelle émission de radio, une nouvelle émission de télévision ou une nouvelle vidéo basée sur une œuvre antérieure.","hu":"Egy korábbi művön alapuló mozgókép, rádióműsor, televízióműsor, vagy videó kifejezési forma.","it":"Nuovo film, programma radiofonico, programma televisivo o video, basato su un'opera precedente.","lv":"Jauna kinofilma, radio, televīzijas raidījums vai video, kas veidoti pēc agrāka darba. Rīmeiks.","nl":"Een werk dat is een nieuwe speelfilm, radioprogramma, televisieprogramma of video dat gebaseerd is op een eerder werk.","no":"En spillefilm, et radioprogram, et fjernsynsprogram eller en video som er basert på et tidligere verk.","tr":"Eski bir esere dayanan yeni bir sinema filmi, radyo programı, televizyon programı veya video olan bir eser.","vi":"Phim điện ảnh, chương trình truyền thanh, chương trình truyền hình, hoặc video dựa trên tác phẩm trước đây.","zh-Hans-CN":"基于一种先前作品的一种新电影、广播节目、电视节目或视频的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10340", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyle.en", "label":"has transformation by style"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/remadeAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10032", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/remadeAsWork.en", "label":"is remade as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10032", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/remadeAsWork.en", "label":"is remade as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10117","label":{"ar":"هو محاكى كعمل","ca":"és imitat com a obra","cs":"je imitováno jako dílo","da":"er efterlignet som værk","de":"ist imitiert als (Werk)","de":"ist imitiert als (Werk)","el":"είναι αντίγραφο ως (έργο)","en":"is imitated as work","es":"es imitado como obra","et":"jäljendatud teosena","fi":"jäljitelmä (teos)","fr":"est imité comme une œuvre","hu":"utánzó műve a következő:","it":"è imitata come opera","lv":"darba imitācija","nl":"is geïmiteerd als werk","no":"er imitert som verk","tr":"eser olarak taklit edilmiştir","vi":"được mô phỏng như là (tác phẩm)","zh-Hans-CN":"被模仿成为作品"},"definition":{"ar":["يربط عمل بعمل ينسخ نمط عمل آخر أو محتواه."],"ca":["Relaciona una obra amb una obra que copia l’estil o el contingut d’una altra obra."],"cs":["Vztahuje dílo k dílu, které kopíruje styl nebo obsah jiného díla."],"da":["Relaterer et værk til et værk, som kopierer et oprindeligt værks stil eller indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das den Stil oder Inhalt eines anderen Werks kopiert.,Setzt ein Werk in Beziehung zu einem Werk, das den Stil oder Inhalt eines anderen Werks kopiert."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο αντιγράφει το ύφος ή το περιεχόμενο ενός έργου-πηγής."],"en":["Relates a work to a work that copies the style or content of another work."],"es":["Relaciona una obra con una obra que copia el estilo o contenido de otra obra."],"et":["Seostab teose teosega, milles jäljendatakse allikteose stiili või sisu."],"fi":["Liittää teoksen teokseen, joka jäljittelee toisen teoksen tyyliä tai sisältöä."],"fr":["Met une œuvre en relation avec une œuvre qui copie le style ou le contenu d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy másik mű stílusát vagy tartalmát másolja."],"it":["Correla un’opera a un’opera che copia lo stile o il contenuto di un’opera di partenza."],"lv":["Sasaista darbu ar darbu, kas atdarina pamatdarba stilu vai saturu."],"nl":["Relateert een werk aan een werk dat de stijl of content van een ander werk kopieert."],"no":["Relaterer et verk til et verk som kopierer stilen eller innholdet fra et kildeverk."],"tr":["Bir eseri, başka bir eserin biçimini veya içeriğini kopyalayan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sao lại phong cách hoặc nội dung của tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与复制另一种作品的风格和内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"محاكى كعمل","ca":"imitat com a obra","cs":"imitováno jako dílo","da":"efterlignet som værk","de":"Imitiert als (Werk)","de":"Imitiert als (Werk)","el":"αντίγραφο ως (έργο)","en":"imitated as work","es":"imitado como obra","et":"jäljendatud teosena","fi":"jäljitelmä (teos)","fr":"imité comme une œuvre","hu":"utánzó műve a következő:","it":"imitata come opera","lv":"darbs: imitācija","nl":"geïmiteerd als werk","no":"imitert som verk","tr":"eser olarak taklit edilmiştir","vi":"được mô phỏng như là (tác phẩm)","zh-Hans-CN":"被模仿成为作品"},"ToolkitDefinition":{"ar":"عمل ينسخ أسلوب عمل آخر أو محتواه.","ca":"Obra que copia l’estil o el contingut d’una altra obra.","cs":"Dílo, které kopíruje styl nebo obsah jiného díla.","da":"Værk, som kopierer et oprindeligt værks stil eller indhold.","de":"Ein Werk, das den Stil oder Inhalt eines anderen Werks kopiert.","de":"Ein Werk, das den Stil oder Inhalt eines anderen Werks kopiert.","el":"Ένα έργο το οποίο αντιγράφει το ύφος ή το περιεχόμενο ενός έργου-πηγής.","en":"A work that copies the style or content of another work.","es":"Una obra que copia el estilo o contenido de otra obra.","et":"Teos, milles jäljendatakse allikteose stiili või sisu.","fi":"Teos, joka jäljittelee toisen teoksen tyyliä tai sisältöä.","fr":"Œuvre qui copie le style ou le contenu d’une autre œuvre.","hu":"Egy mű, amely egy másik mű stílusát vagy tartalmát másolja.","it":"Opera che copia lo stile o il contenuto di un’opera di partenza.","lv":"Darbs, kas atdarina pamatdarba stilu vai saturu.","nl":"Een werk dat de stijl of content van een ander werk kopieert.","no":"Et verk som kopierer stilen eller innholdet fra et kildeverk.","tr":"Başka bir eserin biçimini veya içeriğini kopyalayan eser.","vi":"Tác phẩm sao lại phong cách hoặc nội dung của tác phẩm nguồn.","zh-Hans-CN":"复制另一种作品的风格和内容的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10340", "lexicalAlias":"http://rdaregistry.info/Elements/w/transformationByStyle.en", "label":"has transformation by style"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/imitatedAsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10144", "lexicalAlias":"http://rdaregistry.info/Elements/w/parodiedAsWork.en", "label":"is parodied as work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10117", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/imitatedAsWork.en", "label":"is imitated as work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10117", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/imitatedAsWork.en", "label":"is imitated as work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10252","label":{"ar":"هو تحويل روائي مصور لعمل","ca":"és novel·lització gràfica d’una obra","cs":"je adaptací ve formě grafického románu díla","da":"er omskrivning af værk til graphic novel","de":"ist Bearbeitung als Graphic Novel von (Werk)","de":"ist Bearbeitung als Graphic Novel von (Werk)","el":"είναι μυθιστοριογράφηση σε μορφή κόμικ του (έργο)","en":"is graphic novelization of work","es":"es una novelización gráfica de la obra","et":"graafilise romaani versioon teosest","fi":"sarjakuvasovitus teoksesta","fr":"est une adaptation en roman graphique d’une œuvre","hu":"képregény-feldolgozása a következőnek:","it":"è adattatamento in forma di graphic novel di opera","lv":"kā grafisks romāns adaptētais darbs","nl":"is stripboekbewerking van werk","no":"er tegneserieroman basert på verk","tr":"eserin çizgi romanlaştırılmasıdır","vi":"là tiểu thuyết hoá đồ hoạ của (tác phẩm)","zh-Hans-CN":"是作品的图解小说化"},"definition":{"ar":["يربط عمل بعمل معالج كرواية مصورة."],"ca":["Relaciona una obra amb una obra que s’adapta com una novel·la gràfica."],"cs":["Vztahuje dílo k dílu, které je adaptováno jako grafický román."],"da":["Relaterer et værk til et værk, som er bearbejdet til en graphic novel."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das als Graphic Novel bearbeitet ist.,Setzt ein Werk in Beziehung zu einem Werk, das als Graphic Novel bearbeitet ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει προσαρμοστεί ως μυθιστόρημα σε μορφή κόμικ."],"en":["Relates a work to a work that is adapted as a graphic novel."],"es":["Relaciona una obra con una obra que está adaptada como novela gráfica."],"et":["Seostab teose teosega, mis on adapteeritud graafilise romaanina."],"fi":["Liittää teoksen teokseen, joka on sovitettu sarjakuvaromaaniksi."],"fr":["Met une œuvre en relation avec une œuvre qui est adaptée en roman graphique."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet képregényként adaptáltak."],"it":["Correla un'opera a un'opera adattata come graphic novel."],"lv":["Sasaista darbu ar darbu, kas ir adaptēts kā grafisks romāns."],"nl":["Relateert een werk aan een werk dat is bewerkt als een stripboek."],"no":["Relaterer et verk til et verk som er bearbeidet til en tegneserieroman."],"tr":["Bir eseri, çizgi roman olarak uyarlanan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được phỏng theo như là tiểu thuyết đồ hình."],"zh-Hans-CN":["将一种作品与被改编为图解小说的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تحويل روائي مصور لعمل","ca":"novel·lització gràfica d’una obra","cs":"adaptace ve formě grafického románu díla","da":"omskrivning af værk til graphic novel","de":"Bearbeitung als Graphic Novel von (Werk)","de":"Bearbeitung als Graphic Novel von (Werk)","el":"μυθιστοριογράφηση σε μορφή κόμικ του (έργο)","en":"graphic novelization of work","es":"novelización gráfica de la obra","et":"graafilise romaani versioon teosest","fi":"sarjakuvasovitus teoksesta","fr":"adaptation en roman graphique d’une œuvre","hu":"képregényesített mű","it":"adattatamento in forma di graphic novel di opera","lv":"kā grafisks romāns adaptētais darbs","nl":"stripboekbewerking van werk","no":"tegneserieroman basert på verk","tr":"eserin çizgi romanlaştırılması","vi":"tiểu thuyết hoá đồ hoạ của (tác phẩm)","zh-Hans-CN":"作品的图解小说化"},"ToolkitDefinition":{"ar":"عمل تمت معالجته كرواية مصورة.","ca":"Obra que s’adapta com una novel·la gràfica.","cs":"Dílo, které je adaptováno jako grafický román.","da":"Værk, som er bearbejdet til en graphic novel.","de":"Ein Werk, das als Graphic Novel bearbeitet ist.","de":"Ein Werk, das als Graphic Novel bearbeitet ist.","el":"Ένα έργο το οποίο έχει προσαρμοστεί ως μυθιστόρημα σε μορφή κόμικ.","en":"A work that is adapted as a graphic novel.","es":"Una obra que está adaptada como novela gráfica.","et":"Teos, mis on adapteeritud graafilise romaanina.","fi":"Teos, joka on sovitettu sarjakuvaromaaniksi.","fr":"Œuvre qui est adaptée en roman graphique.","hu":"Egy mű, amelyet képregényként átdolgoztak.","it":"Opera adattata come graphic novel.","lv":"Darbs, kas ir adaptēts kā grafisks romāns.","nl":"Een werk dat is bewerkt als een stripboek.","no":"Et verk som er bearbeidet til en tegneserieroman.","tr":"Bir çizgi roman olarak uyarlanan bir çalışma.","vi":"Tác phẩm đã được phỏng theo như là tiểu thuyết đồ hình.","zh-Hans-CN":"被改编为图解小说的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/graphicNovelizationOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10252", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/graphicNovelizationOfWork.en", "label":"is graphic novelization of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10252", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/graphicNovelizationOfWork.en", "label":"is graphic novelization of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10192","label":{"ar":"هو إضافة لعمل","ca":"és augmentació d’una obra","cs":"je rozšířením díla","da":"er berigelse af værk","de":"ist Erweiterung von (Werk)","de":"ist Erweiterung von (Werk)","el":"είναι αύξηση του (έργο)","en":"is augmentation of work","es":"es aumento de obra","et":"laiendus teosele","fi":"laajennus teokseen","fr":"est une augmentation d’une œuvre","hu":"bővítése a következő műnek:","it":"è ampliamento di opera","lv":"ir papildina darbu","nl":"is aanvulling van werk","no":"er utvidelse av verk","tr":"eserin arttırılmasıdır","vi":"là gia tăng của (tác phẩm)","zh-Hans-CN":"是作品的附增"},"definition":{"ar":["يربط عمل بعمل تمت إضافة محتواه بواسطة عمل ذي صلة."],"ca":["Relaciona una obra amb una obra el contingut de la qual és augmentat per una obra relacionada."],"cs":["Vztahuje dílo k dílu, jehož obsah byl doplněn souvisejícím dílem."],"da":["Relaterer et værk til et værk, hvis indhold udbygges af et relateret værk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalt durch ein in Beziehung stehendes Werk ergänzt wird.,Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalt durch ein in Beziehung stehendes Werk ergänzt wird."],"el":["Συνδέει ενα έργο με ένα έργο του οποίου το περιεχόμενο αυξάνεται από ένα άλλο έργο."],"en":["Relates a work to a work whose content is added to by a related work."],"es":["Relaciona una obra con una obra cuyo contenido se adiciona a una obra relacionada."],"et":["Seostab teose teosega, mille sisusse on tehtud seotud teosega lisandusi."],"fi":["Liittää teoksen teokseen, jonka sisältöä siihen liittyvä teos täydentää."],"fr":["Met une œuvre en relation avec une œuvre dont le contenu est augmenté par le contenu d’une œuvre en relation."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek tartalmát egy kapcsolódó mű adja hozzá."],"it":["Correla un’opera a un’opera il cui contenuto è ampliato da un’opera correlata."],"lv":["Sasaista darbu ar darbu, kura saturu papildina saistītais darbs."],"nl":["Relateert een werk aan een werk waar content aan toegevoegd wordt door een gerelateerd werk."],"no":["Relaterer et verk til et verk hvis innhold har blitt utvidet av et relatert verk."],"tr":["Bir eseri, içeriği ilgili bir eser tarafından eklenen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm mà nội dung của nó được thêm vào bởi tác phẩm khác."],"zh-Hans-CN":["将一种作品与其内容被一种相关作品增加的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إضافة لعمل","ca":"augmentació d’una obra","cs":"rozšíření díla","da":"berigelse af værk","de":"Erweiterung von (Werk)","de":"Erweiterung von (Werk)","el":"αύξηση του (έργο)","en":"augmentation of work","es":"aumento de obra","et":"laiendus teosele","fi":"laajennus teokseen","fr":"augmentation d’une œuvre","hu":"bővített mű","it":"ampliamento di opera","lv":"papildina darbu","nl":"aanvulling van werk","no":"utvidelse av verk","tr":"eserin artırılması","vi":"gia tăng của (tác phẩm)","zh-Hans-CN":"作品的附增"},"ToolkitDefinition":{"ar":"عمل تمت إضافة محتواه بواسطة عمل ذي صلة.","ca":"Obra el contingut de la qual és augmentat per una obra relacionada.","cs":"Dílo, jehož obsah byl doplněn souvisejícím dílem.","da":"Værk, hvis indhold udbygges af et relateret værk.","de":"Ein Werk, dessen Inhalt durch ein in Beziehung stehendes Werk ergänzt wird.","de":"Ein Werk, dessen Inhalt durch ein in Beziehung stehendes Werk ergänzt wird.","el":"Ένα έργο του οποίου το περιεχόμενο αυξάνεται από ένα άλλο έργο.","en":"A work whose content is added to by a related work.","es":"Una obra cuyo contenido se adiciona a una obra relacionada.","et":"Teos, mille sisusse on tehtud seotud teosega lisandusi.","fi":"Teos, jonka sisältöä siihen liittyvä teos täydentää.","fr":"Œuvre dont le contenu est augmenté par le contenu d’une œuvre en relation.","hu":"Egy mű, amelynek tartalmát egy kapcsolódó mű adja hozzá.","it":"Opera il cui contenuto è ampliato da un’opera correlata.","lv":"Darbs, kura saturu papildina saistītais darbs","nl":"Een werk waar content aan toegevoegd wordt door een gerelateerd werk.","no":"Et verk hvis innhold har blitt utvidet av et relatert verk.","tr":"İçeriği ilgili bir çalışma tarafından eklenen eser.","vi":"Tác phẩm mà nội dung của nó được thêm vào bởi tác phẩm khác.","zh-Hans-CN":"其内容被一种相关作品增加的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10198", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedWorkOfWork.en", "label":"has related work of work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/augmentationOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10029", "lexicalAlias":"http://rdaregistry.info/Elements/w/cadenzaComposedForWork.en", "label":"is cadenza composed for work"},{"@id":"http://rdaregistry.info/Elements/w/P10201", "lexicalAlias":"http://rdaregistry.info/Elements/w/findingAidForWork.en", "label":"is finding aid for work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10151", "lexicalAlias":"http://rdaregistry.info/Elements/w/appendixToWork.en", "label":"is appendix to work"},{"@id":"http://rdaregistry.info/Elements/w/P10149", "lexicalAlias":"http://rdaregistry.info/Elements/w/errataToWork.en", "label":"is errata to work"},{"@id":"http://rdaregistry.info/Elements/w/P10150", "lexicalAlias":"http://rdaregistry.info/Elements/w/guideToWork.en", "label":"is guide to work"},{"@id":"http://rdaregistry.info/Elements/w/P10188", "lexicalAlias":"http://rdaregistry.info/Elements/w/indexToWork.en", "label":"is index to work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10154", "lexicalAlias":"http://rdaregistry.info/Elements/w/supplementToWork.en", "label":"is supplement to work"},{"@id":"http://rdaregistry.info/Elements/w/P10177", "lexicalAlias":"http://rdaregistry.info/Elements/w/addendaToWork.en", "label":"is addenda to work"},{"@id":"http://rdaregistry.info/Elements/w/P10152", "lexicalAlias":"http://rdaregistry.info/Elements/w/illustrationsForWork.en", "label":"is illustrations for work"},{"@id":"http://rdaregistry.info/Elements/w/P10180", "lexicalAlias":"http://rdaregistry.info/Elements/w/catalogueOfWork.en", "label":"is catalogue of work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10181", "lexicalAlias":"http://rdaregistry.info/Elements/w/concordanceToWork.en", "label":"is concordance to work (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/object/P10192", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/augmentationOfWork.en", "label":"is augmentation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10192", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/augmentationOfWork.en", "label":"is augmentation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10153","label":{"ar":"هو تقييم لعمل","ca":"és avaluació d’una obra","cs":"je hodnocením díla","da":"er evaluering af værk","de":"ist Evaluierung von (Werk)","de":"ist Evaluierung von (Werk)","el":"είναι αξιολόγηση του (έργο)","en":"is evaluation of work","es":"es evaluación de obra","et":"hinnang teosele","fi":"arviointi teoksesta","fr":"est une évaluation d’une œuvre","hu":"értékelése a következő műnek:","it":"è valutazione di opera","lv":"ir novērtējums darbam","nl":"is beschouwing van werk","no":"er evaluering av verk","tr":"eserin değerlendirmesidir","vi":"là đánh giá (tác phẩm)","zh-Hans-CN":"是作品的评价"},"definition":{"ar":["يربط عمل بعمل فُحِص أو حُكِم عليه."],"ca":["Relaciona una obra amb una obra que és examinada o jutjada per una obra."],"cs":["Vztahuje dílo k dílu, které je zkoumáno nebo hodnoceno dílem."],"da":["Relaterer et værk til et værk, som er undersøgt eller vurderet."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das geprüft oder beurteilt wird.,Setzt ein Werk in Beziehung zu einem Werk, das geprüft oder beurteilt wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο υποβάλλεται σε εξέταση ή κριτική."],"en":["Relates a work to a work that is examined or judged by a work."],"es":["Relaciona una obra con una obra que es examinada o juzgada por una obra."],"et":["Seostab teose teosega, mida on kontrollitud või hinnatud."],"fi":["Liittää teoksen teokseen, jota on tutkittu tai arvioitu."],"fr":["Met une œuvre en relation avec une œuvre qui est examinée ou jugée par une œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet elemeznek és megítélnek."],"it":["Correla un’opera a un’opera che è esaminata o giudicata."],"lv":["Sasaista darbu ar darbu, kas tiek pārbaudīts vai vērtēts."],"nl":["Relateert een werk aan een werk dat onderzocht of beoordeeld wordt."],"no":["Relaterer et verk til et verk som utforskes eller vurderes."],"tr":["Bir eseri, bir eser tarafından incelenen veya değerlendirilen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được kiểm tra hoặc đánh giá."],"zh-Hans-CN":["将一种作品与被一种作品检查或评判的一种作品关联起来。"]},"ToolkitLabel":{"ar":"تقييم لعمل","ca":"avaluació d’una obra","cs":"hodnocení díla","da":"evaluering af værk","de":"Evaluierung von (Werk)","de":"Evaluierung von (Werk)","el":"αξιολόγηση του (έργο)","en":"evaluation of work","es":"evaluación de obra","et":"hinnang teosele","fi":"arviointi teoksesta","fr":"évaluation d’une œuvre","hu":"értékelt mű:","it":"valutazione di opera","lv":"novērtējums darbam","nl":"beschouwing van werk","no":"evaluering av verk","tr":"eserin değerlendirilmesi","vi":"đánh giá của (tác phẩm)","zh-Hans-CN":"作品的评价"},"ToolkitDefinition":{"ar":"عمل فُحِص أو حُكِم عليه.","ca":"Obra que és examinada o jutjada per una obra.","cs":"Dílo, které je zkoumáno nebo hodnoceno dílem.","da":"Værk, som er undersøgt eller vurderet.","de":"Ein Werk, das geprüft oder beurteilt wird.","de":"Ein Werk, das geprüft oder beurteilt wird.","el":"Ένα έργο το οποίο υποβάλλεται εξετάζεται ή κρίνεται.","en":"A work that is examined or judged by a work.","es":"Una obra que es examinada o juzgada por una obra.","et":"Teos, mida on kontrollitud või hinnatud.","fi":"Teos, jota on tutkittu tai arvioitu.","fr":"Œuvre qui est examinée ou jugée par une œuvre.","hu":"Egy mű, amelyet elemeznek és megítélnek.","it":"Opera che è esaminata o giudicata.","lv":"Darbs, kas tiek pārbaudīts vai vērtēts.","nl":"Een werk dat onderzocht of beoordeeld wordt door een werk.","no":"Et verk som utforskes eller vurderes.","tr":"Bir çalışma tarafından incelenen veya değerlendirilen bir çalışma.","vi":"Tác phẩm được kiểm tra hoặc đánh giá.","zh-Hans-CN":"被一种作品检查或评判的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/evaluationOfWork.en","instructionNumber":"23.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10257", "lexicalAlias":"http://rdaregistry.info/Elements/w/subjectWork.en", "label":"has subject work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10182", "lexicalAlias":"http://rdaregistry.info/Elements/w/critiqueOfWork.en", "label":"is critique of work"},{"@id":"http://rdaregistry.info/Elements/w/P10178", "lexicalAlias":"http://rdaregistry.info/Elements/w/reviewOfWork.en", "label":"is review of work"},{"@id":"http://rdaregistry.info/Elements/w/object/P10153", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/evaluationOfWork.en", "label":"is evaluation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10153", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/evaluationOfWork.en", "label":"is evaluation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10078","label":{"ar":"له تعبيرة لعمل","ca":"té com a expressió d’una obra","cs":"má vyjádření díla","da":"har udtryk af værk","de":"hat Expression eines Werks","de":"hat Expression eines Werks","el":"έχει έκφραση του έργου","en":"has expression of work","es":"tiene expresión de obra","et":"teose väljendus","fi":"teoksen ekspressio","fr":"a pour expression d’une œuvre","hu":"mű kifejezési formája a következő:","it":"ha come espressione di opera","lv":"darba izteiksme","nl":"heeft expressie van werk","no":"har uttrykk av verk","sv":"har uttryck för verk","tr":"eserin anlatımı ile ilişkilidir","vi":"có biểu hiện của tác phẩm","zh-Hans-CN":"有作品的内容表达"},"definition":{"ar":["يربط بين عمل وتعبيرة عبارة عن تحقيق لعمل في شكل تدوين هجائي-رقمي، أو موسيقي أو راقص، أو صوت، أو صورة، أو كائن، أو حركة، إلخ.، أو أي مزيج من مثل هذه الأشكال."],"ca":["Relaciona una obra amb una expressió que és una realització d’una obra en la forma de notació alfanumèrica, musical o coreogràfica, de so, d’imatge, d’objecte, de moviment, etc., o de qualsevol combinació d’aquestes formes."],"cs":["Vztahuje dílo k vyjádření, které je realizací díla ve formě alfanumerického, hudebního nebo choreografického zápisu, zvuku, obrazu, objektu, pohybu apod. nebo jakékoli kombinace těchto forem."],"da":["Relaterer et værk til en virkeliggørelse af et værk i form af alfanumerisk, musik- eller koreografinotation, en lyd, et billede, en genstand, en bevægelse etc., eller en kombination af sådanne former."],"de":["Setzt ein Werk in Beziehung zu einer Expression, bei der es sich um die Realisierung eines Werks in Form einer alphanumerischen, musikalischen oder choreografischen Notation, in Form von Ton, Bild, Gegenstand, Bewegung und so weiter oder einer Kombination solcher Formen handelt.,Setzt ein Werk in Beziehung zu einer Expression, bei der es sich um die Realisierung eines Werks in Form einer alphanumerischen, musikalischen oder choreografischen Notation, in Form von Ton, Bild, Gegenstand, Bewegung und so weiter oder einer Kombination solcher Formen handelt."],"el":["Συνδέει ένα έργο με μια υλοποίηση ενός έργου στη μορφή αλφαριθμητικής, μουσικής ή χορογραφικής σημειογραφίας, ήχου, εικόνας, κίνησης κ.λπ. ή οποιοσδήποτε συνδυασμός τέτοιων μορφών."],"en":["Relates a work to an expression that is a realization of a work in the form of alpha-numeric, musical or choreographic notation, sound, image, object, movement, etc., or any combination of such forms."],"es":["Relaciona una obra con una expresión que es una realización de una obra en forma de notación alfanumérica, musical o coreográfica, sonido, imagen, objeto, movimiento, etc., o cualquier combinación de tales formas."],"et":["Seostab teose teose realisatsiooniga teksti, muusika või koreograafilise notatsiooni, heli, pildi, eseme, liikumise vms vormis või nende kombinatsioonina."],"fi":["Liittää teoksen ekspressioon, joka on teoksen toteutus, joka voi olla muodoltaan aakkosnumeerinen, musiikkinuotinnos, tanssinotaatio, ääntä, kuva, esine, liikettä tms. tai mikä tahansa tällaisten muotojen yhdistelmä."],"fr":["Met une œuvre en relation avec une expression qui consiste en une réalisation d’une œuvre sous forme de notation alphanumérique, musicale ou chorégraphique, de son, d’image, d’objet, de mouvement, etc. ou de toute combinaison de ces formes."],"hu":["Egy művet hozzákapcsol egy mű megvalósításához alfanumerikus, zenei vagy koreográfiai jelölési rendszer, hang, kép, tárgy, mozgás stb. formájában, vagy ilyen formák valamely kombinációjában."],"it":["Correla un'opera a una realizzazione di un'opera in forma di notazione alfanumerica, musicale o coreografica, suono, immagine, oggetto, movimento, etc. o in una qualsiasi combinazione di queste forme."],"lv":["Sasaista darbu ar izteiksmi, kas ir darba realizācija burtu-ciparu veidā, mūzikas vai horeogrāfijas, skaņu, attēlu, priekšmetu, kustību u.tml., pierakstu formā vai jebkurā šo formu kombinācijā. (FRBR)."],"nl":["Relateert een werk aan een expressie die is een realisatie van een werk in de vorm van alfanumerieke, muziek- of choreografische notatie, geluid, beeld, object, beweging etc., of elke combinatie van zulke vormen."],"no":["Relaterer et verk til en realisering av et verk i form av alfanumerisk, musikalsk eller koreografisk notasjon, lyd, bilde, gjenstand, bevegelse etc., eller enhver kombinasjon av slike former."],"tr":["Bir eseri, alfanümerik, müzikal veya koreografik notasyon, ses, görüntü, nesne, hareket vb. veya bu tür biçimlerin herhangi bir kombinasyonu biçiminde gerçekleştirilmiş bir eserin anlatımıyla ilişkilendirir."],"vi":["Liên kết tác phẩm với sự thể hiện của tác phẩm dưới hình thái chữ-số, ký hiệu âm nhạc hoặc nghệ thuật bố trí, âm thanh, hình ảnh, vật thể, động thái, v.v..., hoặc tổ hợp các hình thái đó."],"zh-Hans-CN":["将一种作品与作为一种作品的实现、以字母数字形式、乐谱或舞谱形式、声音、图像、物体、运动等形式、或者此类形式的任何组合的一种内容表达关联起来。"]},"ToolkitLabel":{"ar":"تعبيرة لعمل","ca":"expressió d’una obra","cs":"vyjádření díla","da":"udtryk af værk","de":"Expression eines Werks","de":"Expression eines Werks","el":"έκφραση του έργου","en":"expression of work","es":"expresión de obra","et":"teose väljendus","fi":"teoksen ekspressio","fr":"expression d’une œuvre","hu":"műhöz tartozó kifejezési forma:","it":"espressione di opera","lv":"darba izteiksme","nl":"expressie van werk","no":"uttrykk av verk","sv":"uttryck för verk","tr":"eserin anlatımı","vi":"biểu hiện của tác phẩm","zh-Hans-CN":"作品的内容表达"},"ToolkitDefinition":{"ar":"تعبيرة عبارة عن تحقيق لعمل في شكل تدوين هجائي-رقمي، أو موسيقي أو راقص، أو صوت، أو صورة، أو كائن، أو حركة، إلخ.، أو أي مزيج من مثل هذه الأشكال.","ca":"Expressió que és una realització d’una obra en la forma de notació alfanumèrica, musical o coreogràfica, de so, d’imatge, d’objecte, de moviment, etc., o de qualsevol combinació d’aquestes formes.","cs":"Vyjádření, které je realizací díla ve formě alfanumerického, hudebního nebo choreografického zápisu, zvuku, obrazu, objektu, pohybu apod. nebo jakékoli kombinace těchto forem.","da":"Virkeliggørelse af et værk i form af alfanumerisk, musik- eller koreografinotation, en lyd, et billede, en genstand, en bevægelse etc., eller en kombination af sådanne former.","de":"Eine Expression, bei der es sich um die Realisierung eines Werks in Form einer alphanumerischen, musikalischen oder choreografischen Notation, in Form von Ton, Bild, Gegenstand, Bewegung und so weiter oder einer Kombination solcher Formen handelt.","de":"Eine Expression, bei der es sich um die Realisierung eines Werks in Form einer alphanumerischen, musikalischen oder choreografischen Notation, in Form von Ton, Bild, Gegenstand, Bewegung und so weiter oder einer Kombination solcher Formen handelt.","el":"Μια υλοποίηση ενός έργου στη μορφή αλφαριθμητικής, μουσικής ή χορογραφικής σημειογραφίας, ήχου, εικόνας, κίνησης κ.λπ. ή οποιοσδήποτε συνδυασμός τέτοιων μορφών.","en":"An expression that is a realization of a work in the form of alpha-numeric, musical or choreographic notation, sound, image, object, movement, etc., or any combination of such forms.","es":"Una expresión que es una realización de una obra en forma de notación alfanumérica, musical o coreográfica, sonido, imagen, objeto, movimiento, etc., o cualquier combinación de tales formas.","et":"Teose realisatsioon teksti, muusika- või koreograafilise notatsiooni, heli, pildi, eseme, liikumise vms vormis või nende kombinatsioonina.","fi":"Ekspressio, joka on teoksen toteutus, joka voi olla muodoltaan aakkosnumeerinen, musiikkinuotinnos, tanssinotaatio, ääntä, kuva, esine, liikettä tms. tai mikä tahansa tällaisten muotojen yhdistelmä.","fr":"Expression qui consiste en une réalisation d’une œuvre sous forme de notation alphanumérique, musicale ou chorégraphique, de son, d’image, d’objet, de mouvement, etc. ou de toute combinaison de ces formes.","hu":"Egy mű megvalósítása alfanumerikus, zenei vagy koreográfiai jelölésrendszer, hang, kép, objektum, mozgás stb. formájában, vagy ilyen formák valamely kombinációjában.","it":"Realizzazione di un'opera in forma di notazione alfanumerica, musicale o coreografica, suono, immagine, oggetto, movimento, etc. o in una qualsiasi combinazione di queste forme.","lv":"Darba realizācija burtu-ciparu veidā, mūzikas vai horeogrāfijas, skaņu, attēlu, priekšmetu, kustību u.tml., pierakstu formā vai jebkurā šo formu kombinācijā. (FRBR)","nl":"Een expressie die is een realisatie van een werk in de vorm van alfanumerieke, muziek- of choreografische notatie, geluid, beeld, object, beweging etc., of elke combinatie van zulke vormen.","no":"En realisering av et verk i form av alfanumerisk, musikalsk eller koreografisk notasjon, lyd, bilde, gjenstand, bevegelse etc., eller enhver kombinasjon av slike former.","tr":"Bir eserin, alfanumerik, müzikal veya koreografik notasyon, ses, görüntü, nesne, hareket vb. biçiminde veya bu biçimlerin herhangi bir bileşiminde gerçekleştirilmiş bir anlatım.","vi":"Sự thể hiện của tác phẩm dưới hình thái chữ-số, ký hiệu âm nhạc hoặc nghệ thuật bố trí, âm thanh, hình ảnh, vật thể, động thái, v.v..., hoặc tổ hợp các hình thái đó.","zh-Hans-CN":"作为一种作品的实现、以字母数字形式、乐谱或舞谱形式、声音、图像、物体、运动等形式、或者此类形式的任何组合的一种内容表达"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/expressionOfWork.en","instructionNumber":"17.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10308", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedExpressionOfWork.en", "label":"has related expression of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10346", "lexicalAlias":"http://rdaregistry.info/Elements/w/representativeExpression.en", "label":"has representative expression"},{"@id":"http://rdaregistry.info/Elements/w/object/P10078", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/expressionOfWork.en", "label":"has expression of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10078", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/expressionOfWork.en", "label":"has expression of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10106","label":{"ar":"هو موسيقى تصويرية لعمل","ca":"és música incidental per a una obra","cs":"je scénickou hudbou pro dílo","da":"er ledsagemusik til værk","de":"ist Bühnenmusik für (Werk)","de":"ist Bühnenmusik für (Werk)","el":"είναι μουσική του τυχαίου για (έργο)","en":"is incidental music for work","es":"es música incidental para obra","et":"näidendimuusika teosele","fi":"näytelmämusiikki teokseen","fr":"est une musique de scène pour une œuvre","hu":"kísérőzenéje a következő műnek:","it":"è musica di scena per opera","lv":"ir uzveduma fona mūzika darbam","nl":"is toneelmuziek voor werk","no":"er bakgrunnsmusikk for verk","tr":"eser için fon müziğidir","vi":"là âm nhạc nền của (tác phẩm)","zh-Hans-CN":"是作品的配乐"},"definition":{"ar":["يربط عمل بعمل مسرحي أو عمل آخر للمسرح يتحقق على أنه كلام منطوق ويكمله عمل موسيقي."],"ca":["Relaciona una obra amb una obra que és una obra de teatre o qualsevol altra obra escènica que es realitza com a obra de paraula parlada i que es complementa amb una obra musical."],"cs":["Vztahuje dílo k dílu, které je divadelní hrou nebo jiným jevištním dílem, které je realizováno jako mluvené slovo a které je doplněno hudebním dílem."],"da":["Relaterer et værk til et værk, som er et skuespil eller andet sceneværk, som realiseres som tale, som er komplementeret af et musikværk."],"de":["Setzt ein Werk in Beziehung zu einem Werk, bei dem es sich um ein Drama oder ein anderes, gesprochenes Bühnenwerk handelt, das durch ein Musikwerk vervollständigt wird.,Setzt ein Werk in Beziehung zu einem Werk, bei dem es sich um ein Drama oder ein anderes, gesprochenes Bühnenwerk handelt, das durch ein Musikwerk vervollständigt wird."],"el":["Συνδέει ένα έργο με ένα έργο, όπως ένα θεατρικό έργο ή άλλο έργο με προφορικό λόγο για τη σκηνή, το οποίο χρησιμοποιεί ένα μουσικό έργο ως μουσική του τυχαίου."],"en":["Relates a work to a work that is a play or other work for the stage that is realized as spoken word and that is complemented by a musical work."],"es":["Relaciona una obra con una obra que es una obra de teatro u otra obra para el escenario que es realizada como palabra hablada y que es complementada por una obra musical."],"et":["Seostab teose näidendi või muu lavateosega, mis on realiseeritud kõnena ja täiendatud muusikateosega."],"fi":["Liittää teoksen teokseen, joka on näytelmä tai muu näyttämöteos, joka toteutuu puheena ja jota on täydennetty musiikkiteoksella."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en une pièce de théâtre ou une autre œuvre pour la scène qui est réalisée sous forme de parole énoncée et est complétée par une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy színdarabhoz vagy más beszélt színpadi műhöz, amelyet egy zenemű egészít ki."],"it":["Correla un’opera a un’opera che è un dramma o altra opera destinata al teatro realizzata con il parlato che è completata da un’opera musicale."],"lv":["Sasaista darbu ar darbu, kas ir teātra izrāde vai cits skatuves darbs, kurā mūzikas darbs izmantots kā fona mūzika."],"nl":["Relateert een werk aan een werk dat is een toneelstuk of ander podiumwerk dat gerealiseerd is als gesproken woord, en dat gecomplementeerd wordt door een muziekwerk."],"no":["Relaterer et verk til et verk som er et skuespill eller annet sceneverk som realiseres som tale supplert av et musikalsk verk."],"tr":["Bir eseri, sözlü olarak gerçekleştirilen ve bir müzik eseriyle tamamlanan bir oyun veya sahne için başka bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm như là kịch hoặc tác phẩm lời nói khác cho sân khấu sử dụng tác phẩm âm nhạc như là âm nhạc nền."],"zh-Hans-CN":["将一种作品与被一种音乐作品补充的作为一种被口头表述实现的戏剧或其他舞台作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"موسيقى تصويرية لعمل","ca":"música incidental per a una obra","cs":"scénická hudba pro dílo","da":"ledsagemusik til værk","de":"Bühnenmusik für (Werk)","de":"Bühnenmusik für (Werk)","el":"μουσική του τυχαίου για (έργο)","en":"incidental music for work","es":"música incidental para obra","et":"näidendimuusika teosele","fi":"näytelmämusiikki teokseen","fr":"musique de scène pour une œuvre","hu":"zenével kísért mű:","it":"musica di scena per opera","lv":"uzveduma fona mūzika darbam","nl":"toneelmuziek voor werk","no":"bakgrunnsmusikk for verk","tr":"eserin fon müziğidir","vi":"âm nhạc nền của(tác phẩm)","zh-Hans-CN":"作品的配乐"},"ToolkitDefinition":{"ar":"عمل مسرحي أو عمل آخر للمسرح الذي يتحقق على أنه كلمة منطوقة ويكملها عمل موسيقي.","ca":"Obra que és una obra de teatre o qualsevol altra obra escènica que es realitza com a obra de paraula parlada i que es complementa amb una obra musical.","cs":"Dílo, které je divadelní hrou nebo jiným jevištním dílem, které je realizováno jako mluvené slovo a které je doplněno hudebním dílem.","da":"Værk, som er et skuespil eller andet sceneværk, som realiseres som tale, som er komplementeret af et musikværk.","de":"Ein Werk, bei dem es sich um ein Drama oder ein anderes, gesprochenes Bühnenwerk handelt, das durch ein Musikwerk vervollständigt wird.","de":"Ein Werk, bei dem es sich um ein Drama oder ein anderes, gesprochenes Bühnenwerk handelt, das durch ein Musikwerk vervollständigt wird.","el":"Ένα έργο, όπως ένα θεατρικό έργο ή άλλο έργο με προφορικό λόγο για τη σκηνή, το οποίο χρησιμοποιεί ένα μουσικό έργο ως μουσική του τυχαίου.","en":"A work that is a play or other work for the stage that is realized as spoken word and that is complemented by a musical work.","es":"Una obra que es una obra de teatro u otra obra para el escenario que es realizada como palabra hablada y que es complementada por una obra musical.","et":"Näidend või muu lavateos, mis on realiseeritud kõnena ja täiendatud muusikateosega.","fi":"Teos, joka on näytelmä tai muu näyttämöteos, joka toteutuu puheena ja jota on täydennetty musiikkiteoksella.","fr":"Œuvre qui consiste en une pièce de théâtre ou une autre œuvre pour la scène qui est réalisée sous forme de parole énoncée et est complétée par une œuvre musicale.","hu":"Egy színdarab vagy más beszélt színpadi mű, amelyet egy zenemű egészít ki.","it":"Opera che è un dramma o altra opera destinata al teatro realizzata con il parlato che è completata da un’opera musicale.","lv":"Darbs, kas ir teātra izrāde vai cits skatuves darbs, kurā mūzikas darbs izmantots kā fona mūzika.","nl":"Een werk dat is een toneelstuk of ander podiumwerk dat gerealiseerd is als gesproken woord, en dat gecomplementeerd wordt door een muziekwerk.","no":"Et verk som er et skuespill eller annet sceneverk som realiseres som tale supplert av et musikalsk verk.","tr":"Bir oyun ya da diğer sahne eseri olup, sözlü olarak gerçekleştirilen ve bir müzik eseriyle tamamlanan bir eser.","vi":"Tác phẩm như là kịch hoặc tác phẩm lời nói khác cho sân khấu sử dụng tác phẩm âm nhạc như là âm nhạc nền.","zh-Hans-CN":"被一种音乐作品补充的作为一种被口头表述实现的戏剧或其他舞台作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/incidentalMusicForWork.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10238", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForWork.en", "label":"is music for work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10106", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/incidentalMusicForWork.en", "label":"is incidental music for work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10106", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/incidentalMusicForWork.en", "label":"is incidental music for work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10031","label":{"ar":"له عمل موسيقي تصويري","ca":"té com a obra de música incidental","cs":"má scénickou hudbu (dílo)","da":"har ledsagemusikværk","de":"hat Bühnenmusik (Werk)","de":"hat Bühnenmusik (Werk)","el":"είναι μουσική του τυχαίου (έργο)","en":"has incidental music work","es":"tiene obra de música incidental","et":"näidendimuusika (teos)","fi":"näytelmämusiikki (teos)","fr":"a pour musique de scène (œuvre)","hu":"kísérőzenéje a következő műnek:","it":"ha come musica di scena opera","lv":"darbs: uzveduma fona mūzika","nl":"heeft toneelmuziekwerk","no":"har bakgrunnsmusikk (verk)","tr":"fon müziği eseri ile ilişkilidir","vi":"là âm nhạc nền (tác phẩm)","zh-Hans-CN":"有配乐作品"},"definition":{"ar":["يربط عمل بعمل موسيقي يكمل عملا متمثلا في مسرحية أو عملا آخر للمسرح يدرك ككلمة منطوقة."],"ca":["Relaciona una obra amb una obra que és una obra musical que complementa una obra que és una obra de teatre o una altra obra escènica que es realitza com a paraula parlada."],"cs":["Vztahuje dílo k dílu, které je hudebním dílem, doplňujícím dílo, které je divadelní hrou nebo jiným jevištním dílem, realizovaným jako mluvené slovo."],"da":["Relaterer et værk til et musikværk, som komplementerer et værk, som er et skuespil eller andet sceneværk, som realiseres som tale."],"de":["Setzt ein Werk in Beziehung zu einem Musikwerk, das ein Drama oder ein anderes, gesprochenes Bühnenwerk ergänzt.,Setzt ein Werk in Beziehung zu einem Musikwerk, das ein Drama oder ein anderes, gesprochenes Bühnenwerk ergänzt."],"el":["Συνδέει ένα έργο με ένα μουσικό έργο που παρέχει μουσική του τυχαίου για ένα θεατρικό έργο ή άλλο έργο με προφορικό λόγο για τη σκηνή."],"en":["Relates a work to a work that is a musical work that complements a work that is a play or other work for the stage that is realized as spoken word."],"es":["Relaciona una obra con una obra que es una obra musical que complementa una obra que es una obra de teatro u otra obra para el escenario que es realizada como palabra hablada."],"et":["Seostab teose muusikateosega, mis täiendab näidendit või muud kõnel põhinevat lavateost."],"fi":["Liittää teoksen musiikkiteokseen, joka täydentää teosta, joka on näytelmä tai muu näyttämöteos, joka toteutuu puheena."],"fr":["Met une œuvre en relation avec une œuvre musicale qui complète une œuvre qui est une pièce de théâtre ou une autre œuvre pour la scène réalisée sous forme de parole énoncée."],"hu":["Hozzákapcsol egy művet egy műhöz, amely egy zenemű, amely kísérőzenét szolgáltat egy színdarabhoz vagy a színpad másik beszélt művéhez."],"it":["Correla un’opera a un’opera musicale che accompagna un’opera che è un dramma o altra opera destinata al teatro realizzata con il parlato."],"lv":["Sasaista darbu ar mūzikas darbu, kas papildina darbu, kas ir luga vai cits skatuves darbs, kas realizēts kā mutvārdi."],"nl":["Relateert een werk aan een muziekwerk dat een werk complementeert dat een toneelstuk is of een ander werk voor podium dat gerealiseerd is als gesproken woord."],"no":["Relaterer et verk til et musikalsk verk som supplerer et verk som er et skuespill eller annet sceneverk for muntlig framføring."],"tr":["Bir eseri, bir oyun veya sahne için sözlü olarak gerçekleştirilen başka bir eser olan bir eseri tamamlayan bir müzik eseri olan eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm âm nhạc cung cấp âm nhạc nền cho kịch hoặc tác phẩm lời nói khác đối với sân khấu."],"zh-Hans-CN":["将一种作品与作为一种音乐作品并补充作为被口头表述实现的戏剧或其他舞台作品的一种作品的一种作品关联起来。"]},"ToolkitLabel":{"ar":"عمل موسيقي تصويري","ca":"obra de música incidental","cs":"scénická hudba (dílo)","da":"ledsagemusikværk","de":"Bühnenmusik (Werk)","de":"Bühnenmusik (Werk)","el":"μουσική του τυχαίου (έργο)","en":"incidental music work","es":"obra de música incidental","et":"näidendimuusika (teos)","fi":"näytelmämusiikki (teos)","fr":"musique de scène (œuvre)","hu":"kísérőzenemű:","it":"musica di scena opera","lv":"darbs: uzveduma fona mūzika","nl":"toneelmuziekwerk","no":"bakgrunnsmusikk (verk)","tr":"fon müziği eseri ile ilişkilidir","vi":"tác phẩm âm nhạc nền","zh-Hans-CN":"配乐作品"},"ToolkitDefinition":{"ar":"عمل موسيقي يكمل عملاً متمثلا في مسرحية أو عملًا آخر للمسرح يدرك ككلمة منطوقة.","ca":"Obra que és una obra musical que complementa una obra que és una obra de teatre o una altra obra escènica que es realitza com a paraula parlada.","cs":"Dílo, které je hudebním dílem, doplňujícím dílo, které je divadelní hrou nebo jiným jevištním dílem, realizovaným jako mluvené slovo.","da":"Musikværk, som komplementerer et værk, som er et skuespil eller andet sceneværk, som realiseres som tale.","de":"Ein Musikwerk, das ein Drama oder ein anderes, gesprochenes Bühnenwerk ergänzt.","de":"Ein Musikwerk, das ein Drama oder ein anderes, gesprochenes Bühnenwerk ergänzt.","el":"Ένα μουσικό έργο που παρέχει μουσική του τυχαίου για ένα θεατρικό έργο ή άλλο έργο με προφορικό λόγο για τη σκηνή.","en":"A work that is a musical work that complements a work that is a play or other work for the stage that is realized as spoken word.","es":"Una obra que es una obra musical que complementa una obra que es una obra de teatro u otra obra para el escenario que es realizada como palabra hablada.","et":"Muusikateos, mis täiendab näidendit või muud kõnel põhinevat lavateost.","fi":"Liittää teoksen musiikkiteokseen, joka täydentää teosta, joka on näytelmä tai muu näyttämöteos, joka toteutuu puheena.","fr":"Œuvre musicale qui complète une œuvre qui est une pièce de théâtre ou une autre œuvre pour la scène réalisée sous forme de parole énoncée.","hu":"Egy mű, amely egy zenemű, amely kísérőzenét szolgáltat egy színdarabhoz vagy a színpad másik beszélt művéhez.","it":"Opera musicale che accompagna un’opera che è un dramma o altra opera destinata al teatro realizzata con il parlato.","lv":"Mūzikas darbs, kas papildina darbu, kas ir luga vai cits skatuves darbs, kas realizēts kā mutvārdi.","nl":"Een muziekwerk dat een werk complementeert dat een toneelstuk is of een ander werk voor podium dat gerealiseerd is als gesproken woord.","no":"Et musikalsk verk som supplerer et verk som er et skuespill eller annet sceneverk for muntlig framføring.","tr":"Bir oyun veya sahne için sözlü olarak gerçekleştirilen başka bir eseri tamamlayan bir müzik eseri olan eser.","vi":"Tác phẩm âm nhạc cung cấp âm nhạc nền cho kịch hoặc tác phẩm lời nói khác đối với sân khấu.","zh-Hans-CN":"作为一种音乐作品并补充作为被口头表述实现的戏剧或其他舞台作品的一种作品的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/incidentalMusicWork.en","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10237", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicWork.en", "label":"has music work"}],"instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10031", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/incidentalMusicWork.en", "label":"has incidental music work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10031", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/incidentalMusicWork.en", "label":"has incidental music work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10223","label":{"ar":"له عنوان مفضل لعمل","ca":"té com a títol preferit d’obra","cs":"má preferovaný název díla","da":"har foretrukken titel på værk","de":"hat bevorzugten Titel eines Werks","de":"hat bevorzugten Titel eines Werks","el":"έχει προτιμώμενο τίτλο για έργο","en":"has preferred title of work","es":"tiene título preferido la obra","et":"teose eelispealkiri","fi":"teoksen ensisijainen nimeke","fr":"a pour titre privilégié d’une œuvre","hu":"műhöz tartozó előnyben részesített címe a következő:","it":"ha come titolo preferito dell'opera","lv":"darba prioritārais nosaukums","nl":"heeft geprefereerde titel van werk","no":"har foretrukket tittel på verk","sv":"har föredragen titel för verket","tr":"tercih edilen eser başlığı ile ilişkilidir","vi":"có nhan đề ưu tiên của tác phẩm","zh-Hans-CN":"有作品的首选题名"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن عنوان عمل تم اختياره بتفضيل استخدامه في تطبيق أو سياق محدد."],"ca":["Relaciona una obra amb un nomen que és un títol d’obra que se selecciona com a preferent en una aplicació o un context específic."],"cs":["Vztahuje dílo k nomen, které je názvem díla, který byl zvolen jako preferovaný pro určité použití nebo kontext."],"da":["Relaterer et værk til en titel på værk, som er valgt som præference i en specifik anvendelse eller kontekst."],"de":["Setzt ein Werk in Beziehung zu einem Titel eines Werks, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.,Setzt ein Werk in Beziehung zu einem Titel eines Werks, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird."],"el":["Συνδέει ένα έργο με έναν τίτλο ή μορφή του τίτλου που επιλέγεται για την ταύτιση ενός έργου."],"en":["Relates a work to a nomen that is a title of work that is selected for preference in a specific application or context."],"es":["Relaciona una obra con un nomen que es un título de obra que se selecciona de preferencia en una aplicación o contexto específico."],"et":["Seostab teose teose pealkirjaga, mis kindlas rakenduses või kontekstis on valitud eelistatuks."],"fi":["Liittää teoksen nomeniin, joka on teoksen nimeke, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa."],"fr":["Met une œuvre en relation avec un nomen qui est un titre d’œuvre faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques."],"hu":["Hozzákapcsol egy művet egy nomenhez, amely egy olyan műcím, amelyet egy adott alkalmazásban vagy kontextusban előnyben részesítenek."],"it":["Correla un’opera a un titolo dell’opera scelto come preferito in un ambito di utilizzo o contesto specifici."],"lv":["Sasaista darbu ar nomenu, kas ir darba nosaukums, kas ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā."],"nl":["Relateert een werk aan een nomen dat is een titel van werk die bij voorkeur geselecteerd is in een specifieke applicatie of context."],"no":["Relaterer et verk til en tittel på verk som er valgt som preferanse i en spesifikk applikasjon eller sammenheng."],"tr":["Bir eseri, belirli bir uygulama veya bağlamda tercih için seçilen bir eser başlığı olan bir isimle ilişkilendirir."],"vi":["Liên kết tác phẩm với nhan đề hoặc hình thái của nhan đề được chọn để nhận dạng tác phẩm."],"zh-Hans-CN":["将一种作品与作为作品的一个题名并在一个特定的应用或语境下被优先选用的一个命名关联起来。"]},"ToolkitLabel":{"ar":"عنوان مفضل لعمل","ca":"títol preferit d’obra","cs":"preferovaný název díla","da":"foretrukken titel på værk","de":"Bevorzugter Titel eines Werks","de":"Bevorzugter Titel eines Werks","el":"προτιμώμενος τίτλος για έργο","en":"preferred title of work","es":"título preferido de la obra","et":"teose eelispealkiri","fi":"teoksen ensisijainen nimeke","fr":"titre privilégié d’une œuvre","hu":"mű kitüntetett címe:","it":"titolo preferito dell'opera","lv":"darba prioritārais nosaukums","nl":"geprefereerde titel van werk","no":"foretrukket tittel på verk","sv":"föredragen titel för verket","tr":"Eserin tercih edilen başlığı","vi":"nhan đề ưu tiên của tác phẩm","zh-Hans-CN":"作品的首选题名"},"ToolkitDefinition":{"ar":"تسمية عبارة عن عنوان عمل تم اختياره بتفضيل استخدامه في تطبيق أو سياق محدد.","ca":"Nomen que és un títol d’obra que se selecciona com a preferent en una aplicació o un context específic.","cs":"Nomen, které je názvem díla, který byl zvolen jako preferovaný pro určité použití nebo kontext.","da":"Titel på værk, som er valgt som præference i en specifik anvendelse eller kontekst.","de":"Ein Titel eines Werks, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.","de":"Ein Titel eines Werks, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.","el":"Ένας τίτλος ή μορφή του τίτλου που επιλέγεται για την ταύτιση ενός έργου.","en":"A nomen that is a title of work that is selected for preference in a specific application or context.","es":"Un nomen que es un título de obra que se selecciona de preferencia en una aplicación o contexto específico.","et":"Teose pealkiri, mis kindlas rakenduses või kontekstis on valitud eelistatuks.","fi":"Nomen, joka on teoksen nimeke, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.","fr":"Nomen qui est un titre d’œuvre faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques.","hu":"Egy nomen, amely egy olyan műcím, amelyet egy adott alkalmazásban vagy kontextusban előnyben részesítenek.","it":"Ttolo dell’opera che è scelto come preferito in un ambito di utilizzo o contesto specifici.","lv":"Darba nosaukums, kas ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā.","nl":"Een nomen dat is een titel van werk die bij voorkeur geselecteerd is in een specifieke applicatie of context.","no":"En tittel på verk som er valgt som preferanse i en spesifikk applikasjon eller sammenheng.","tr":"Belirli bir uygulama veya bağlamda tercih için seçilen bir eser başlığı olan bir isim.","vi":"Nhan đề hoặc hình thái của nhan đề được chọn để nhận dạng tác phẩm.","zh-Hans-CN":"作为作品的一个题名并在一个特定的应用或语境下被优先选用的一个命名"},"note":{"ca":["El títol preferit és també la base d’un punt d’accés autoritzat que representa l’obra."],"da":["Den foretrukne titel er også grundlag for en autoriseret søgeindgang der repræsenterer værket."],"de":["Der bevorzugte Titel ist auch die Grundlage für den normierten Sucheinstieg, der dieses Werk repräsentiert."],"el":["Ο προτιμώμενος τίτλος είναι επίσης η βάση για το καθιερωμένο σημείο πρόσβασης που αναπαριστά αυτό το έργο."],"fr":["Le titre privilégié constitue aussi l’élément de base d’un point d’accès autorisé représentant cette œuvre."],"hu":["A kitűntetett vagy preferált cím alapja a művet képviselő meghatalmazott hozzáférési pontnak is."],"vi":["Nhan đề ưu tiên cũng là cơ sở cho điểm truy cập được phép trình bày tác phẩm đó."]},"altLabel":{"ar":["عنوان مفضل لعمل"],"cs":["preferovaný název díla"],"de":["dem bevorzugter Titel des Werks"],"en":["preferred title for work"],"es":["título preferido para la obra"],"fi":["ensisijainen nimeke teokselle"],"hu":["műhöz tartozó előnyben részesített cím:"],"nl":["geprefereerde titel voor werk"],"tr":["Eserin tercih edilen başlığı"],"zh-Hans-CN":["作品的首选题名"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
