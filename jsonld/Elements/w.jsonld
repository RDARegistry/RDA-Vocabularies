                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10307", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedRDAEntityOfWork.en", "label":"has related RDA entity of work"},{"@id":"http://rdaregistry.info/Elements/x/P00006", "lexicalAlias":"http://rdaregistry.info/Elements/x/relatedAgentOfRDAEntity.en", "label":"has related agent of RDA entity"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/relatedAgentOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10070", "lexicalAlias":"http://rdaregistry.info/Elements/w/addresseeAgent.en", "label":"has addressee agent"},{"@id":"http://rdaregistry.info/Elements/w/P10208", "lexicalAlias":"http://rdaregistry.info/Elements/w/grantingInstitutionOrFaculty.en", "label":"has granting institution or faculty (Deprecated)"},{"@id":"http://rdaregistry.info/Elements/w/P10287", "lexicalAlias":"http://rdaregistry.info/Elements/w/commissioningAgent.en", "label":"has commissioning agent"},{"@id":"http://rdaregistry.info/Elements/w/P10065", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorAgentOfWork.en", "label":"has creator agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10069", "lexicalAlias":"http://rdaregistry.info/Elements/w/dedicateeAgentOfWork.en", "label":"has dedicatee agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10049", "lexicalAlias":"http://rdaregistry.info/Elements/w/honoureeAgentOfWork.en", "label":"has honouree agent of work"},{"@id":"http://rdaregistry.info/Elements/w/P10046", "lexicalAlias":"http://rdaregistry.info/Elements/w/issuingAgent.en", "label":"has issuing agent"},{"@id":"http://rdaregistry.info/Elements/w/P10315", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedCollectiveAgentOfWork.en", "label":"has related col