                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10238", "lexicalAlias":"http://rdaregistry.info/Elements/w/musicForWork.en", "label":"is music for work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/musicForTelevisionProgramWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10242", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/musicForTelevisionProgramWork.en", "label":"is music for television program work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10242", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/musicForTelevisionProgramWork.en", "label":"is music for television program work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10240","label":{"ar":"هو موسيقى لعمل فيديوي","ca":"és música per a una obra de vídeo","cs":"je hudbou pro video (dílem)","da":"er musik til videoværk","de":"ist Musik für Video (Werk)","de":"ist Musik für Video (Werk)","el":"είναι μουσική για βίντεο (έργο)","en":"is music for video work","es":"es musica para obra de video","et":"muusika videofilmile (teos)","fi":"musiikki videoon (teos)","fr":"est une musique pour une vidéo (œuvre)","hu":"videózenéje a következőnek:","it":"è musica per video opera","lv":"ir mūzika video darbam","nl":"is muziek voor videowerk","no":"er videomusikk for verk","tr":"video eseri müziğidir","vi":"là âm nhạc cho video (tác phẩm)","zh-Hans-CN":"是用于视频作品的音乐"},"definition":{"ar":["يربط عمل بعمل فيديوي مكمل بعمل موسيقي."],"ca":["Relaciona una obra amb una obra que és un vídeo que es complementa amb una obra musical."],"cs":["Vztahuje dílo k dílu, které je videem které je doplněno hudebním dílem."],"da":["Relaterer et værk til et værk, som er en video, som komplementeres af et musikværk."],"de":["Setzt ein Werk in Beziehung zu einem Video (Werk), das durch ein Musikwerk vervollständigt wird.,Setzt ein Werk in Beziehung zu einem Video (Werk), das durch ein Musikwerk vervollständigt wird."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιεί ένα μουσικό έργο σε ένα βίντεο."],"en":["Relates a work to a work that is a video that is complemented by a musical work."],"es":["Relaciona una obra con una obra que es un vídeo que se complementa con una obra musical."],"et":["Seostab teose teosega, mis on muusikateosega täiendatud videofilm."],"fi":["Liittää teoksen teokseen, joka on video, jota musiikkiteos täydentää."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en une vidéo qui est complétée par une œuvre musicale."],"hu":["Hozzákapcsol egy művet egy videóműhöz, amelyet egy zenemű egészít ki."],"it":["Correla un’opera a un’opera che è un video che è completato da un’opera musicale."],"lv":["Sasaista darbu ar darbu, kas ir video, kurā izmantots muzikāls darbs."],"nl":["Relateert een werk aan een werk dat een video is dat is gecomplementeerd door een muziekwerk."],"no":["Relaterer et verk til et verk som utfylles av et musikalsk verk i en video."],"tr":["Bir eseri, bir müzik eseriyle tamamlanan bir video olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm sử dụng tác phẩm âm nhạc trong video."],"zh-Hans-CN":["将一种作品与作为一种视频并被一种音乐作品补充的一种作品关联起来。"]},"ToolkitLabel":{"ar":"موسيقى لعمل فيديوي","ca":"música per a una obra de vídeo","cs":"hudba pro video (dílo)","da":"musik til videoværk","de":"Musik für Video (Werk)","de":"Musik für Video (Werk)","el":"μουσική για βίντεο (έργο)","en":"music for video work","es":"musica para obra de video","et":"muusika videofilmile (teos)","fi":"musiikki videoon (teos)","fr":"musique pour une vidéo (œuvre)","hu":"zenével ellátott videómű","it":"musica per video opera","lv":"mūzika video darbam","nl":"muziek voor videowerk","no":"videomusikk for verk","tr":"video çalışması müziği","vi":"âm nhạc cho vid