                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/creatorFamilyOfWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10313", "lexicalAlias":"http://rdaregistry.info/Elements/w/relatedFamilyOfWork.en", "label":"has related family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10484", "lexicalAlias":"http://rdaregistry.info/Elements/w/creatorCollectiveAgentOfWork.en", "label":"has creator collective agent of work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/P10589", "lexicalAlias":"http://rdaregistry.info/Elements/w/aggregatorFamily.en", "label":"has aggregator family"},{"@id":"http://rdaregistry.info/Elements/w/P10579", "lexicalAlias":"http://rdaregistry.info/Elements/w/architectFamily.en", "label":"has architect family"},{"@id":"http://rdaregistry.info/Elements/w/P10592", "lexicalAlias":"http://rdaregistry.info/Elements/w/artistFamily.en", "label":"has artist family"},{"@id":"http://rdaregistry.info/Elements/w/P10577", "lexicalAlias":"http://rdaregistry.info/Elements/w/authorFamily.en", "label":"has author family"},{"@id":"http://rdaregistry.info/Elements/w/P10576", "lexicalAlias":"http://rdaregistry.info/Elements/w/cartographerFamilyOfWork.en", "label":"has cartographer family of work"},{"@id":"http://rdaregistry.info/Elements/w/P10594", "lexicalAlias":"http://rdaregistry.info/Elements/w/castingDirectorFamily.en", "label":"has casting director family"},{"@id":"http://rdaregistry.info/Elements/w/P10575", "lexicalAlias":"http://rdaregistry.info/Elements/w/choreographerFamily.en", "label":"has choreographer family"},{"@id":"http://rdaregistry.info/Elements/w/P10583", "lexicalAlias":"http://rdaregistry.info/Elements/w/composerFamilyOfWork.en", "label":"has composer family of work"},{"@id":"http://rdaregistry.