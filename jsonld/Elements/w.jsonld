                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"instructionNumber":"23.5","subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10120", "lexicalAlias":"http://rdaregistry.info/Elements/w/workEvaluatedBy.en", "label":"is work evaluated by"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/workReviewedBy.en","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10114", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/workReviewedBy.en", "label":"is work reviewed by"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10114", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/workReviewedBy.en", "label":"is work reviewed by"}]},{"@id":"http://rdaregistry.info/Elements/w/P10224","label":{"ar":"هو احتواء لعمل","ca":"és absorció d’una obra","cs":"je absorbcí díla","da":"er indlemmelse af værk","de":"ist darin aufgegangen (Werk)","de":"ist darin aufgegangen (Werk)","el":"είναι απορρόφηση του (έργο)","en":"is absorption of work","es":"es absorción de la obra","et":"sulandunud teos","fi":"sulautunut teos","fr":"est une absorption d’une œuvre","hu":"beolvasztja a következő művet:","it":"è assorbimento di opera","lv":"ir iekļautais darbs","nl":"is opname van werk","no":"er innlemmelse av verk","tr":"eserin kapsanmasıdır","vi":"là hấp thụ của (tác phẩm)","zh-Hans-CN":"是作品的吸收"},"definition":{"ar":["يربط عمل بعمل يكون محتواه مدمجًا في محتوى عمل آخر."],"ca":["Relaciona una obra amb una obra el contingut de la qual s’incorpora en el contingut d’una altra obra."],"cs":["Vztahuje dílo k dílu, jehož obsah je začleněn do obsahu jiného díla."],"da":["Relaterer et værk til et værk, hvis indhold er inkorporeret i et andet værks indhold."],"de":["Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalt in den Inhalt eines anderen Werks eingeflossen ist.,Setzt ein Werk in Beziehung zu einem Werk, dessen Inhalt in den Inhalt eines anderen Werks eingeflossen ist."],"el":["Συνδέει ένα έργο με ένα έργο το οποίο έχει ενσωματωθεί σε ένα άλλο έργο."],"en":["Relates a work to a work whose content is incorporated in the content of another work."],"es":["Relaciona una obra con una obra cuyo contenido se incorpora al contenido de otra obra."],"et":["Seostab teose teosega, mille sisu on haaratud teise teose sisusse."],"fi":["Liittää teoksen teokseen, jonka sisältö on yhdistynyt toisen teoksen sisältöön."],"fr":["Met une œuvre en relation avec une œuvre dont le contenu est intégré dans celui d’une autre œuvre."],"hu":["Hozzákapcsol egy művet egy műhöz, amelynek tartalma beolvad egy másik mű tartalmába."],"it":["Correla un’opera a un'opera il cui contenuto è incorporato nel contenuto di un’altra opera."],"lv":["Sasaista darbu ar darbu, kas iekļauts saistītajā darbā."],"nl":["Relateert een werk aan een werk waarvan de content opgenomen is in de content van een ander werk."],"no":["Relaterer et verk til et verk hvis innhold er innlemmet i innholdet i et annet verk."],"tr":["Bir eseri, içeriği başka bir eserin içeriğine dahil edilen bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm đã được kết hợp vào tác phẩm khác."],"zh-Hans-CN":["将一种作品与其内容被纳入另一种作品之内容的一种作品关联起来。"]},"ToolkitLabel":{"ar":"احتواء لعمل","ca":"absorció d’una obra","cs":"absorbce díla","da":"indlemmelse af værk","de":"Darin aufgegangen (Werk)","de":"Darin aufgegangen (Werk)","el":"απορρόφηση του (έργο)","en":"absorption of work","es":"absorción de la obra","et":"sulandunud teos","fi":"sulautunut teos","fr":"absorption d’une œuvre","hu":"beolvasztott mű","it":"assorbimento di opera","lv":"iekļautais darbs","nl":"opname van werk","no":"innlemmelse av verk","tr":"eserin kapsaması","vi":"hấp thụ của (tác phẩm)","zh-Hans-CN":"作品的吸收"},"ToolkitDefinition":{"ar":"عمل يكون محتواه مدمجًا في محتوى عمل آخر.","ca":"Obra el contingut de la qual s’incorpora en el contingut d’una altra obra.","cs":"Dílo, jehož obsah je začleněn do obsahu jiného díla.","da":"Værk, hvis indhold er inkorporeret i et andet værks indhold.","de":"Ein Werk, dessen Inhalt in den Inhalt eines anderen Werks eingeflossen ist.","de":"Ein Werk, dessen Inhalt in den Inhalt eines anderen Werks eingeflossen ist.","el":"Ένα έργο το οποίο έχει ενσωματωθεί σε ένα άλλο έργο.","en":"A work whose content is incorporated in the content of another work.","es":"Una obra cuyo contenido se incorpora al contenido de otra obra.","et":"Teos, mille sisu on haaratud teise teose sisusse.","fi":"Teos, jonka sisältö on yhdistynyt toisen teoksen sisältöön.","fr":"Œuvre dont le contenu est intégré dans celui d’une autre œuvre.","hu":"Egy mű, amelynek tartalma beolvad egy másik mű tartalmába.","it":"Opera il cui contenuto è incorporato nel contenuto di un’altra opera.","lv":"Darbs, kas iekļauts saistītajā darbā.","nl":"Een werk waarvan de content opgenomen is in de content van een ander werk.","no":"Et verk hvis innhold er innlemmet i innholdet i et annet verk.","tr":"Bir içeriği başka bir eserin içeriğine dahil edilen çalışma.","vi":"Tác phẩm đã được kết hợp vào tác phẩm khác.","zh-Hans-CN":"其内容被纳入另一种作品之内容的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
