                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10108", "lexicalAlias":"http://rdaregistry.info/Elements/w/augmentedByWork.en", "label":"is augmented by work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/illustrationsWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10093", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/illustrationsWork.en", "label":"has illustrations work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10093", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/illustrationsWork.en", "label":"has illustrations work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10152","label":{"ar":"هو إيضاحيات لعمل","ca":"és il·lustracions per a una obra","cs":"je ilustrací k dílu","da":"er illustrationer til værk","de":"ist Illustrationen für (Werk)","de":"ist Illustrationen für (Werk)","el":"είναι εικονογραφήσεις για (έργο)","en":"is illustrations for work","es":"es ilustraciones para obra","et":"illustratsioonid teosele","fi":"kuvitus teokseen","fr":"consiste en illustrations pour une œuvre","hu":"illusztráció a következő műhöz:","it":"è opera in forma di illustrazioni per opera","lv":"ir ilustrācijas darbam","nl":"is illustraties voor werk","no":"er illustrasjoner for verk","tr":"eser için resimlemedir","vi":"là minh hoạ cho (tác phẩm)","zh-Hans-CN":"是作品的插图"},"definition":{"ar":["يربط عمل بعمل مزيد بمحتوى تصويري مصمم لشرحه أو تزيينه."],"ca":["Relaciona una obra amb una obra que és augmentada amb contingut pictòric dissenyat per explicar-la o decorar-la."],"cs":["Vztahuje dílo k dílu, které je rozšířené obrazovým obsahem určeným k jeho vysvětlení nebo vyzdobení."],"da":["Relaterer et værk til et værk, som er beriget med billedindhold, som er skabt til at forklare eller udsmykke det."],"de":["Setzt ein Werk in Beziehung zu einem Werk, das durch Bildinhalte ergänzt wird, die das Werk erklären oder ausschmücken sollen.,Setzt ein Werk in Beziehung zu einem Werk, das durch Bildinhalte ergänzt wird, die das Werk erklären oder ausschmücken sollen."],"el":["Συνδέει ένα έργο με ένα έργο που έχει αυξηθεί από εικονογραφημένο περιεχόμενο για να το εξηγήσει ή να το διακοσμήσει."],"en":["Relates a work to a work that is augmented by pictorial content designed to explain or decorate it."],"es":["Relaciona una obra con una obra que es expandida por contenido pictórico diseñado para explicarla o decorarla."],"et":["Seostab teose teosega, mida on laiendatud selle selgitamiseks või kaunistamiseks mõeldud piltsisuga."],"fi":["Liittää teoksen teokseen, jota on laajennettu sitä selittämään tai koristamaan suunnitellulla kuvasisällöllä."],"fr":["Met une œuvre en relation avec une œuvre qui est augmentée par du contenu visuel destiné à l’expliquer ou à la décorer."],"hu":["Hozzákapcsol egy művet egy műhöz, amelyet képi tartalommal bővítenek, amelyet annak magyarázatára vagy díszítésére terveztek."],"it":["Correla un’opera a un’opera aumentata da contenuto pittorico ideato per esplicarla o decorarla."],"lv":["Sasaista darbu ar darbu, kuru papildina ilustrēts saturs, kas paredzēts, lai to izskaidrotu vai izgreznotu."],"nl":["Relateert een werk aan een werk dat aangevuld is met picturale content ontworpen om het te verklaren of te versieren."],"no":["Relaterer et verk til et verk som har et tillegg i form av bildeinnhold laget for å forklare eller dekorere det."],"tr":["Bir eseri, onu açıklamak veya süslemek için tasarlanmış resimsel içerikle çoğaltılmış bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác phẩm được gia tăng bởi nội dung tranh ảnh được thiết kế để giải thích hoặc trang trí."],"zh-Hans-CN":["将一种作品与由被设计用来解释或装饰它的图画内容附增的一种作品关联起来。"]},"ToolkitLabel":{"ar":"إيضاحيات لعمل","ca":"il·lustracions per a una obra","cs":"ilustrace k dílu","da":"illustrationer til værk","de":"Illustrationen für (Werk)","de":"Illustrationen für (Werk)","el":"εικονογραφήσεις για (έργο)","en":"illustrations for work","es":"ilustraciones para obra","et":"illustratsioonid teosele","fi":"kuvitus teokseen","fr":"illustrations pour une œuvre","hu":"illusztrált mű:","it":"opera in forma di illustrazioni","lv":"ilustrācijas darbam","nl":"illustraties voor werk","no":"illustrasjoner for verk","tr":"eser için resimlemedir","vi":"minh hoạ cho (tác phẩm)","zh-Hans-CN":"作品的插图"},"ToolkitDefinition":{"ar":"عمل مزيد بمحتوى تصويري مصمم لشرحه أو تزيينه.","ca":"Obra que és augmentada amb contingut pictòric dissenyat per explicar-la o decorar-la.","cs":"Dílo, které je rozšířené obrazovým obsahem určeným k jeho vysvětlení nebo vyzdobení.","da":"Værk, som er beriget med billedindhold, som er skabt til at forklare eller udsmykke det.","de":"Ein Werk, das durch Bildinhalte ergänzt wird, die das Werk erklären oder ausschmücken sollen.","de":"Ein Werk, das durch Bildinhalte ergänzt wird, die das Werk erklären oder ausschmücken sollen.","el":"Ένα έργο που έχει αυξηθεί από εικονογραφημένο περιεχόμενο για να το εξηγήσει ή να το διακοσμήσει.","en":"A work that is augmented by pictorial content designed to explain or decorate it.","es":"Una obra que es expandida por contenido pictórico diseñado para explicarla o decorarla.","et":"Teos, mida on laiendatud selle selgitamiseks või kaunistamiseks mõeldud piltsisuga.","fi":"Teos, jota on laajennettu sitä selittämään tai koristamaan suunnitellulla kuvasisällöllä.","fr":"Œuvre qui est augmentée par du contenu visuel destiné à l’expliquer ou à la décorer.","hu":"Egy mű, amelyet képi tartalommal bővítenek, amelyet annak magyarázatára vagy díszítésére terveztek.","it":"Opera aumentata da contenuto pittorico ideato per esplicarla o decorarla.","lv":"Darbs, kuru papildina ilustrēts saturs, kas paredzēts, lai to izskaidrotu vai izgreznotu.","nl":"Een werk dat aangevuld is met picturale content ontworpen om het te verklaren of te versieren.","no":"Et verk som har et tillegg i form av bildeinnhold laget for å forklare eller dekorere det.","tr":"Açıklanması veya süslenmesi amacıyla tasarlanmış görsel içerikle zenginleştirilmiş bir eser.","vi":"Tác phẩm được gia tăng bởi nội dung tranh ảnh được thiết kế để giải thích hoặc trang trí.","zh-Hans-CN":"由被设计用来解释或装饰它的图画内容附增的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
