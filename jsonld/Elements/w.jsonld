                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/spokenWordWork.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10103", "lexicalAlias":"http://rdaregistry.info/Elements/w/complementedByWork.en", "label":"is complemented by work"}],"hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10373", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/spokenWordWork.en", "label":"has spoken word work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10373", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/spokenWordWork.en", "label":"has spoken word work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10067","label":{"ar":"له وكيل راعٍ لعمل","ca":"té com a agent patrocinador d’una obra","cs":"má sponzora díla (agenta)","da":"har agent, som er sponsor af værk","de":"hat Trägerin/Träger eines Werks (Akteur)","de":"hat Trägerin/Träger eines Werks (Akteur)","el":"έχει φορέα επιχορήγησης","en":"has sponsoring agent of work","es":"tiene agente patrocinador de obra","et":"teose toetaja (tegija)","fi":"teoksen sponsori (toimija)","fr":"a pour agent parraineur d’une œuvre","hu":"mű szponzoráló ágense a következő:","it":"ha come sponsor agente di opera","lv":"darba sponsors (aģents)","nl":"heeft sponsor van werk-actor","no":"har sponsor for verk (agent)","tr":"eserin sponsoru olan temsilci ile ilişkilidir","vi":"có tập thể tài trợ","zh-Hans-CN":"有作品的赞助行为者"},"definition":{"ar":["يربط بين عمل ووكيل يرعى بعض جوانب عمل."],"ca":["Relaciona una obra amb un agent que patrocina algun aspecte d’una obra."],"cs":["Vztahuje dílo k agentovi, který sponzoruje některý aspekt díla."],"da":["Relaterer et værk til en agent, som sponsorerer et aspekt af et værk."],"de":["Setzt ein Werk in Beziehung zu einem Akteur, der einzelne Aspekte eines Werks finanziell unterstützt.,Setzt ein Werk in Beziehung zu einem Akteur, der einzelne Aspekte eines Werks finanziell unterstützt."],"el":["Συνδέει ένα έργο με έναν φορέα που χρηματοδοτεί κάποια πτυχή ενός έργου, όπως μια επιδοτούμενη έρευνα ή χρηματοδότηση ενός συμβάντος."],"en":["Relates a work to an agent who sponsors some aspect of a work."],"es":["Relaciona una obra con un agente que patrocina algún aspecto de una obra."],"et":["Seostab teose tegijaga, kes mingil viisil majanduslikult toetab teose loomist."],"fi":["Liittää teoksen toimijaan, joka sponsoroi teosta."],"fr":["Met une œuvre en relation avec un agent qui parraine un aspect quelconque d’une œuvre."],"hu":["Hozzákapcsol egy művet egy ágenshez, amely egy művet valamilyen tekintetben szponzorál."],"it":["Correla un'opera a un agente che sponsorizza alcuni aspetti di un'opera."],"lv":["Sasaista darbu ar aģentu, kas sponsorē dažus darba aspektus."],"nl":["Relateert een werk aan een actor die enige aspecten van een werk sponsort."],"no":["Relaterer et verk til en agent som er sponsor for et aspekt ved et verk."],"tr":["Bir eseri, eserin bazı bölümlerine sponsorluk yapan bir temsilcyle ilişkilendirir."],"vi":["Liên kết tác phẩm với tác nhân tài trợ khía cạnh nào đó của tác phẩm như là hỗ trợ nghiên cứu hoặc tài trợ sự kiện."],"zh-Hans-CN":["将一种作品与赞助一种作品某方面的一个行为者关联起来。"]},"ToolkitLabel":{"ar":"وكيل راعٍ لعمل","ca":"agent patrocinador d’una obra","cs":"sponzor díla (agent)","da":"agent, som er sponsor af værk","de":"Trägerin/Träger eines Werks (Akteur)","de":"Trägerin/Träger eines Werks (Akteur)","el":"φορέας επιχορήγησης","en":"sponsoring agent of work","es":"agente patrocinador de obra","et":"teose toetaja (tegija)","fi":"teoksen sponsori (toimija)","fr":"agent parraineur d’une œuvre","hu":"mű szponzoráló ágense:","it":"sponsor agente di opera","lv":"darba sponsors (aģents)","nl":"sponsor van werk-actor","no":"sponsor for verk (agent)","tr":"eserin sponsoru temsilci","vi":"tập thể tài trợ","zh-Hans-CN":"作品的赞助行为者"},"ToolkitDefinition":{"ar":"وكيل يرعى بعض جوانب عمل.","ca":"Agent que patrocina algun aspecte d’una obra.","cs":"Agent, který sponzoruje některý aspekt díla.","da":"Agent, som sponsorerer et aspekt af et værk.","de":"Ein Akteur, der einzelne Aspekte eines Werks finanziell unterstützt.","de":"Ein Akteur, der einzelne Aspekte eines Werks finanziell unterstützt.","el":"Ένας φορέας που χρηματοδοτεί κάποια πτυχή ενός έργου, όπως επιδοτούμενη έρευνα ή χρηματοδότηση ενός συμβάντος.","en":"An agent who sponsors some aspect of a work.","es":"Un agente que patrocina algún aspecto de una obra.","et":"Tegija, kes mingil viisil majanduslikult toetab teose loomist.","fi":"Toimija, joka sponsoroi teosta.","fr":"Agent qui parraine un aspect quelconque d’une œuvre.","hu":"Egy ágens, amely egy művet valamilyen tekintetben szponzorál.","it":"Agente che sponsorizza alcuni aspetti di un'opera.","lv":"Aģents, kas sponsorē dažus darba aspektus.","nl":"Een actor die enige aspecten van een werk sponsort.","no":"En agent som er sponsor for et aspekt ved et verk.","tr":"Çalışmanın bazı bölümlerine sponsorluk yapan bir temsilci.","vi":"Tác nhân tài trợ khía cạnh nào đó của tác phẩm như là hỗ trợ nghiên cứu hoặc tài trợ sự kiện.","zh-Hans-CN":"赞助一种作品某方面的一个行为者"},"note":{"ar":["يشمل تمويل البحث ورعاية حدث يمثل أساس عمل."],"ca":["Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra."],"cs":["Zahrnuje financování výzkumu a sponzorování akce, která je základem díla."],"da":["Omfatter finansiering af forskning og sponsorering af et arrangement, som er grundlag for et værk."],"de":["Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.,Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden."],"en":["Includes funding research and sponsoring an event that is the basis of a work."],"es":["Incluye financiar investigación y patrocinar un evento que es la base de una obra."],"et":["Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist."],"fi":["Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin."],"fr":["Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre."],"hu":["Egy mű alapját képező kutatás finanszírozása és esemény szponzorálása is idetartozik."],"it":["Include la ricerca di fondi e la sponsorizzazione di un evento che è la base di un'opera"],"lv":["Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā."],"nl":["Omvat het financieren van onderzoek en het sponsoren van een evenement dat de basis vormt van een werk."],"no":["Inkluderer finansiering av forskning og økonomisk støtte til et arrangement som er grunnlaget for et verk."],"tr":["eserin sponsoru olan temsilci ile ilişkilidir"],"zh-Hans-CN":["包括资助作为一种作品之基础的研究以及赞助作为一种作品之基础的一项活动。"]},"altLabel":{"ar":["هيئة راعية"],"ca":["entitat patrocinadora"],"cs":["sponzor"],"da":["sponsorerende institution"],"de":["Sponsor,Sponsor"],"en":["sponsoring body"],"es":["organismo patrocinador"],"et":["teose toetaja"],"fi":["sponsori"],"fr":["parraineur"],"hu":["szponzoráló testület:"],"it":["ente sponsor"],"no":["sponsor"],"tr":["sponsor olan kuruluş"],"zh-Hans-CN":["赞助单位"]},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
