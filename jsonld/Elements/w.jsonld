                                                                                    "label": "Published"
                                                                                },"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10142", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptationOfWork.en", "label":"is adaptation of work"}],"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"lexicalAlias":"http://rdaregistry.info/Elements/w/operaAdaptationOfWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10234", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/operaAdaptationOfWork.en", "label":"is opera adaptation of work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10234", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/operaAdaptationOfWork.en", "label":"is opera adaptation of work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10236","label":{"ar":"هو معالج كعمل أوبرالي","ca":"és adaptat com a obra d’òpera","cs":"je adaptováno jako opera (dílo)","da":"er bearbejdet til operaværk","de":"ist bearbeitet als Oper (Werk)","de":"ist bearbeitet als Oper (Werk)","el":"είναι προσαρμοσμένο ως όπερα (έργο)","en":"is adapted as opera work","es":"está adaptado como obra de ópera","et":"adapteeritud ooperina (teos)","fi":"oopperasovitus (teos)","fr":"est adapté en opéra (œuvre)","hu":"operamű-feldolgozása a következő:","it":"è adattata in forma di opera","lv":"ir adaptēts kā opera (darbs)","nl":"is bewerkt als operawerk","no":"er bearbeidet som opera (verk)","tr":"opera eseri olarak uyarlanmıştır","vi":"được phỏng theo như là opera (tác phẩm)","zh-Hans-CN":"被改编为歌剧作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن أوبرا اعتمدت على عمل آخر."],"ca":["Relaciona una obra amb una obra que és una òpera que es basa en una altra obra."],"cs":["Vztahuje dílo k dílu, které je operou, založenou na jiném díle."],"da":["Relaterer et værk til en opera, baseret på et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einer Oper (Werk), die auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einer Oper (Werk), die auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με μια όπερα βασισμένη σε ένα έργο-πηγή."],"en":["Relates a work to a work that is an opera that is based on another work."],"es":["Relaciona una obra con una obra que es una ópera que está basada en otra obra."],"et":["Seostab teose allikteosel põhineva ooperiga."],"fi":["Liittää teoksen teokseen, joka on ooppera, joka perustuu toiseen teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un opéra basé sur une autre œuvre."],"hu":["Egy művet hozzákapcsol egy forrásművön alapuló operához."],"it":["Correla un’opera a un’opera musicale basata su un’opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir opera veidota pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat is een opera dat is gebaseerd op een ander werk."],"no":["Relaterer et verk til en opera basert på et kildeverk."],"tr":["Bir eseri, başka bir eserden uyarlanan opera eseri olan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với opera dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为基于另一种作品的一种歌剧的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل أوبرالي","ca":"adaptat com a obra d’òpera","cs":"adaptováno jako opera (dílo)","da":"bearbejdet til operaværk","de":"Bearbeitet als Oper (Werk)","de":"Bearbeitet als Oper (Werk)","el":"προσαρμοσμένο ως όπερα (έργο)","en":"adapted as opera work","es":"adaptado como obra de ópera","et":"adapteeritud ooperina (teos)","fi":"oopperasovitus (teos)","fr":"adapté en opéra (œuvre)","hu":"operamű-átdolgozás","it":"è adattata in forma di opera","lv":"adaptēts kā darbs: opera","nl":"bewerkt als operawerk","no":"bearbeidet som opera (verk)","tr":"Opera eseri olarak uyarlanan","vi":"được phỏng theo như là opera (tác phẩm)","zh-Hans-CN":"被改编为歌剧作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن أوبرا اعتمدت على عمل آخر.","ca":"Obra que és una òpera que es basa en una obra font.","cs":"Dílo, které je operou, založenou na jiném díle.","da":"Opera, baseret på et oprindeligt værk.","de":"Eine Oper (Werk), die auf einem anderen Werk basiert.","de":"Eine Oper (Werk), die auf einem anderen Werk basiert.","el":"Μια όπερα βασισμένη σε ένα έργο-πηγή.","en":"A work that is an opera that is based on another work.","es":"Una obra que es una ópera que está basada en otra obra.","et":"Allikteosel põhinev ooper.","fi":"Teos, joka on ooppera, joka perustuu toiseen teokseen.","fr":"Œuvre qui consiste en un opéra basé sur une autre œuvre.","hu":"Egy forrásművön alapuló opera.","it":"Opera musicale basata su un’opera di partenza.","lv":"Opera veidota pēc pamatdarba.","nl":"Een werk dat is een opera dat is gebaseerd op een ander werk.","no":"En opera basert på et kildeverk.","tr":"Başka bir esere dayanan opera eseri olan eser.","vi":"Opera dựa trên tác phẩm nguồn.","zh-Hans-CN":"作为基于另一种作品的一种歌剧的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10155", "lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsWork.en", "label":"is adapted as work"}],"lexicalAlias":"http://rdaregistry.info/Elements/w/adaptedAsOperaWork.en","instructionNumber":"24.5","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10236", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/adaptedAsOperaWork.en", "label":"is adapted as opera work"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10236", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/adaptedAsOperaWork.en", "label":"is adapted as opera work"}]},{"@id":"http://rdaregistry.info/Elements/w/P10333","label":{"ar":"له رقم قطعة موسيقية","ca":"té com a número d’opus","cs":"má opusové číslo","da":"har opusnummer","de":"hat Opus-Nummer","de":"hat Opus-Nummer","en":"has opus number","es":"tiene número de opus","et":"oopuse number","fi":"opusnumero","fr":"a pour numéro d’opus","hu":"opusszáma a következő:","it":"ha come numero di opera","lv":"opusa numurs","nl":"heeft opusnummer","no":"har opusnummer","tr":"opus numarası ile ilişkilidir","zh-Hans-CN":"有作品编号"},"definition":{"ar":["يربط بين عمل وتسمية عبارة عن تعيين رقمي لعمل موسيقي محدَد من قائمة أعمال ملحن يشير إلى الترتيب الزمني للتلحين."],"ca":["Relaciona una obra amb un nomen que és una designació numèrica d’una obra musical que s’assigna a partir d’una llista d’obres d’un compositor que indica l’ordre cronològic de composició."],"cs":["Vztahuje dílo k nomen, které je číselným označením hudebního díla přiřazeným podle seznamu děl skladatele, označujícím chronologické pořadí skladby."],"da":["Relaterer et værk til en numerisk betegnelse på musikværk, tildelt udfra en liste over en komponists værker, som angiver den kronologiske rækkefølge for kompositionen."],"de":["Setzt ein Werk in Beziehung zu einer numerische Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten oder einem Verlag vergeben wird oder gemäß einem Nachschlagewerk oder Werkverzeichnis verwendet wird. Sie gibt meist Aufschluss über die chronologische Reihenfolge der Komposition innerhalb eines Gesamtwerks.,Setzt ein Werk in Beziehung zu einer numerische Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten oder einem Verlag vergeben wird oder gemäß einem Nachschlagewerk oder Werkverzeichnis verwendet wird. Sie gibt meist Aufschluss über die chronologische Reihenfolge der Komposition innerhalb eines Gesamtwerks."],"en":["Relates a work to a nomen that is a numeric designation of musical work that is assigned from a list of works of a composer indicating the chronological order of composition."],"es":["Relaciona una obra con un nomen que es una designación numérica de una obra musical que se asigna a partir de una lista de obras de un compositor indicando el orden cronológico de composición."],"et":["Seostab teose muusikateose numbrilise tähistusega, mis on võetud helilooja teoste nimestikust ja näitab heliteose kronoloogilist järjestust."],"fi":["Liittää teoksen nomeniin, joka on musiikkiteoksen numerointi, joka on annettu säveltäjän teosluettelossa osoittaen sävellyksen aikajärjestyksen."],"fr":["Met une œuvre en relation avec un nomen qui est une désignation numérique d’une œuvre musicale attribuée à partir d’une liste des œuvres d’un compositeur indiquant l’ordre chronologique de composition."],"hu":["Hozzákapcsol egy művet egy nomenhez, egy zenemű számjelzéséhez, amelyet egy zeneszerző műveinek a komponálás kronológiai sorrendjét jelölő jegyzékéből rendeltek hozzá."],"it":["Correla un’opera a una designazione numerica di opera musicale assegnata da un elenco di opere di un compositore ordinato secondo l’ordine cronologico di composizione."],"lv":["Sasaista darbu ar nomenu, kas ir mūzikas darbu numerācijas apzīmējums, ko piešķir komponista darbu sacerēšanas hronoloģiskās secības apzīmēšanai."],"nl":["Relateert een werk aan een nomen dat is een numerieke aanduiding van muziekwerk dat is toegekend uit een lijst van werken van een componist waarmee de chronologische volgorde van compositie wordt aangegeven."],"no":["Relaterer et verk til en numerisk betegnelse på musikalsk verk som er tildelt utfra en liste av verk av en komponist som viser den kronologiske rekkefølgen av komposisjonene."],"tr":["Bir eseri, bir bestecinin eserlerinin kronolojik sırasını gösteren bir listeden atanan müzik eserinin sayısal belirteci olan bir isimle ilişkilendirir."],"zh-Hans-CN":["将一种作品与作为根据作曲者作品列表分配、表示作曲时间顺序的音乐作品的一个数字标识的一个命名关联起来。"]},"ToolkitLabel":{"ar":"رقم قطعة موسيقية","ca":"número d’opus","cs":"opusové číslo","da":"opusnummer","de":"Opus-Nummer","de":"Opus-Nummer","en":"opus number","es":"número de opus","et":"oopuse number","fi":"opusnumero","fr":"numéro d’opus","hu":"opusszáma:","it":"numero di opera","lv":"opusa numurs","nl":"opusnummer","no":"opusnummer","tr":"Beste numarası","zh-Hans-CN":"作品编号"},"ToolkitDefinition":{"ar":"تسمية عبارة عن تعيين رقمي لعمل موسيقي محدَد من قائمة أعمال ملحن يشير إلى الترتيب الزمني للتلحين.","ca":"Nomen que és una designació numèrica d’una obra musical que s’assigna a partir d’una llista d’obres d’un compositor que indica l’ordre cronològic de composició.","cs":"Nomen, které je číselným označením hudebního díla přiřazeným podle seznamu děl skladatele, označujícím chronologické pořadí skladby.","da":"Numerisk betegnelse på musikværk, tildelt udfra en liste over en komponists værker, som angiver den kronologiske rækkefølge for kompositionen.","de":"Eine numerische Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten oder einem Verlag vergeben wird oder gemäß einem Nachschlagewerk oder Werkverzeichnis verwendet wird. Sie gibt meist Aufschluss über die chronologische Reihenfolge der Komposition innerhalb eines Gesamtwerks.","de":"Eine numerische Bezeichnung eines Musikwerks, die von einer Komponistin/einem Komponisten oder einem Verlag vergeben wird oder gemäß einem Nachschlagewerk oder Werkverzeichnis verwendet wird. Sie gibt meist Aufschluss über die chronologische Reihenfolge der Komposition innerhalb eines Gesamtwerks.","en":"A nomen that is a numeric designation of musical work that is assigned from a list of works of a composer indicating the chronological order of composition.","es":"Un nomen que es una designación numérica de una obra musical que se asigna a partir de una lista de obras de un compositor indicando el orden cronológico de composición.","et":"Muusikateose numbriline tähistus, mis on võetud helilooja teoste nimestikust ja näitab heliteose kronoloogilist järjestust.","fi":"Nomen, joka on musiikkiteoksen numerointi, joka on annettu säveltäjän teosluettelossa osoittaen sävellyksen aikajärjestyksen.","fr":"Nomen qui est une désignation numérique d’une œuvre musicale attribuée à partir d’une liste des œuvres d’un compositeur indiquant l’ordre chronologique de composition.","hu":"Egy nomen, egy zenemű számjelzése, amelyet egy zeneszerző műveinek a komponálás kronológiai sorrendjét jelölő jegyzékéből rendeltek hozzá.","it":"Designazione numerica di opera musicale assegnata da un elenco di opere di un compositore ordinato secondo l’ordine cronologico di composizione.","lv":"Mūzikas darbu numerācijas apzīmējums, ko piešķir komponista darbu sacerēšanas hronoloģiskās secības apzīmēšanai.","nl":"Een nomen dat is een numerieke aanduiding van muziekwerk dat is toegekend uit een lijst van werken van een componist waarmee de chronologische volgorde van compositie wordt aangegeven.","no":"En numerisk betegnelse på musikalsk verk som er tildelt utfra en liste av verk av en komponist som viser den kronologiske rekkefølgen av komposisjonene.","tr":"Bir bestecinin eserlerinin kronolojik sırasını gösteren bir listeden atanan müzik eserinin sayısal bir tanımı olan bir isim.","zh-Hans-CN":"作为根据作曲者作品列表分配、表示作曲时间顺序的音乐作品的一个数字标识的一个命名"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
                                                                                    "@id": "http://metadataregistry.org/uri/RegStatus/1001",
                                                                                    "lexicalAlias": "http://metadataregistry.org/uri/RegStatus/Published.en",
                                                                                    "label": "Published"
                                                                                },"lexicalAlias":"http://rdaregistry.info/Elements/w/opusNumber.en","domain":{"@id":"http://rdaregistry.info/Elements/c/C10001", "lexicalAlias":"http://rdaregistry.info/Elements/c/Work.en", "label":"work"},"subPropertyOf":[{"@id":"http://rdaregistry.info/Elements/w/P10079", "lexicalAlias":"http://rdaregistry.info/Elements/w/numericDesignationOfMusicalWork.en", "label":"has numeric designation of musical work"}],"instructionNumber":"6.16.1.3.2","hasSubproperty":[{"@id":"http://rdaregistry.info/Elements/w/object/P10333", "lexicalAlias":"http://rdaregistry.info/Elements/w/object/opusNumber.en", "label":"has opus number"},{"@id":"http://rdaregistry.info/Elements/w/datatype/P10333", "lexicalAlias":"http://rdaregistry.info/Elements/w/datatype/opusNumber.en", "label":"has opus number"}]},{"@id":"http://rdaregistry.info/Elements/w/P10289","label":{"ar":"هو معالج كعمل موسيقى دينية","ca":"és adaptat com a obra d’oratori","cs":"je adaptováno jako oratorium (dílo)","da":"er værk, som er bearbejdet til oratorium","de":"ist bearbeitet als Oratorium (Werk)","de":"ist bearbeitet als Oratorium (Werk)","el":"είναι προσαρμοσμένο ως ορατόριο (έργο)","en":"is adapted as oratorio work","es":"está adaptado como obra de oratorio","et":"adapteeritud oratooriumina (teos)","fi":"oratoriosovitus (teos)","fr":"est adapté en oratorio (œuvre)","hu":"oratóriummű-átdolgozása a következő:","it":"è adattata come opera in forma di oratorio","lv":"ir adaptēts kā oratorija (darbs)","nl":"is bewerkt als oratoriumwerk","no":"er bearbeidet som oratorium (verk)","tr":"oratoryo eseri olarak uyarlanmıştır","vi":"được phỏng theo như là oratorio (tác phẩm)","zh-Hans-CN":"被改编为清唱剧作品"},"definition":{"ar":["يربط عمل بعمل عبارة عن موسيقى دينية مبنية على عمل آخر."],"ca":["Relaciona una obra amb una obra que es un oratori que es basa en una altra obra."],"cs":["Vztahuje dílo k dílu, které je oratoriem, založeným na jiném díle."],"da":["Relaterer et værk til et oratorium, baseret på et oprindeligt værk."],"de":["Setzt ein Werk in Beziehung zu einem Oratorium (Werk), das auf einem anderen Werk basiert.,Setzt ein Werk in Beziehung zu einem Oratorium (Werk), das auf einem anderen Werk basiert."],"el":["Συνδέει ένα έργο με ένα ορατόριο βασισμένο σε ένα έργο-πηγή."],"en":["Relates a work to a work that is an oratorio that is based on another work."],"es":["Relaciona una obra con una obra que es un oratorio que está basado en otra obra."],"et":["Seostab teose oratooriumiga, mis põhineb allikteosel."],"fi":["Liittää teoksen teokseen, joka on oratorio, joka perustuu toiseen teokseen."],"fr":["Met une œuvre en relation avec une œuvre qui consiste en un oratorio basé sur une autre œuvre."],"hu":["Egy művet hozzákapcsol egy forrásművön alapuló oratóriumhoz."],"it":["Correla un'opera a un oratorio basato su un'opera di partenza."],"lv":["Sasaista darbu ar darbu, kas ir oratorija veidota pēc pamatdarba."],"nl":["Relateert een werk aan een werk dat is een oratorium dat gebaseerd is op een ander werk."],"no":["Relaterer et verk til et oratorium basert på et kildeverk."],"tr":["Bir eseri, başka bir esereden uyarlanan bir oratoryoolan bir eserle ilişkilendirir."],"vi":["Liên kết tác phẩm với oratorio dựa trên tác phẩm nguồn."],"zh-Hans-CN":["将一种作品与作为基于另一种作品的一种清唱剧的一种作品关联起来。"]},"ToolkitLabel":{"ar":"معالج كعمل موسيقى دينية","ca":"adaptat com a obra d’oratori","cs":"adaptováno jako oratorium (dílo)","da":"værk, som er bearbejdet til oratorium","de":"Bearbeitet als Oratorium (Werk)","de":"Bearbeitet als Oratorium (Werk)","el":"προσαρμοσμένο ως ορατόριο (έργο)","en":"adapted as oratorio work","es":"adaptado como obra de oratorio","et":"adapteeritud oratooriumina (teos)","fi":"oratoriosovitus (teos)","fr":"adapté en oratorio (œuvre)","hu":"oratóriummű-átdolgozás","it":"adattato come opera in forma di oratorio","lv":"adaptēts kā darbs: oratorija","nl":"bewerkt als oratoriumwerk","no":"bearbeidet som oratorium (verk)","tr":"Oratoryo eseri olarak uyarlanan","vi":"được phỏng theo như là oratorio (tác phẩm)","zh-Hans-CN":"被改编为清唱剧作品"},"ToolkitDefinition":{"ar":"عمل عبارة عن موسيقى دينية مبنية على عمل آخر.","ca":"Obra que es un oratori que es basa en una altra obra.","cs":"Dílo, které je oratoriem, založeným na jiném díle.","da":"Oratorium, baseret på et oprindeligt værk.","de":"Ein Oratorium (Werk), das auf einem anderen Werk basiert.","de":"Ein Oratorium (Werk), das auf einem anderen Werk basiert.","el":"Ένα ορατόριο βασισμένο σε ένα έργο-πηγή.","en":"A work that is an oratorio that is based on another work.","es":"Una obra que es un oratorio que está basado en otra obra.","et":"Oratoorium, mis põhineb allikteosel.","fi":"Teos, joka on oratorio, joka perustuu toiseen teokseen.","fr":"Œuvre qui consiste en un oratorio basé sur une autre œuvre.","hu":"Egy forrásművön alapuló oratórium.","it":"Oratorio basato su un'opera di partenza.","lv":"Oratorija veidota pēc pamatdarba.","nl":"Een werk dat is een oratorium dat gebaseerd is op een ander werk.","no":"Et oratorium basert på et kildeverk.","tr":"Başka bir esere dayanan bir oratoryo eser.","vi":"Oratorio dựa trên tác phẩm nguồn.","zh-Hans-CN":"作为基于另一种作品的一种清唱剧的一种作品"},"isDefinedBy":{"@id":"http://rdaregistry.info/Elements/w/", "label":"Work properties"},"status": {
